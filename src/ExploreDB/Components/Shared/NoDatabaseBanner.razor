<div class="d-flex flex-column justify-content-center align-items-center w-100" style="height: @Height; background: rgba(10, 10, 12, 0.6); backdrop-filter: blur(8px);">
    <div class="text-center p-5 rounded-4 border border-secondary shadow-lg" style="background: linear-gradient(145deg, rgba(30, 32, 35, 0.8), rgba(15, 17, 20, 0.9)); max-width: 500px; transform: translateY(-20px);">
        <div class="mb-4 d-inline-flex justify-content-center align-items-center rounded-circle" style="width: 80px; height: 80px; background: rgba(13, 110, 253, 0.15); border: 1px solid rgba(13, 110, 253, 0.3);">
            <i class="bi bi-database-exclamation text-primary" style="font-size: 2.5rem;"></i>
        </div>
        <h3 class="fw-bold text-white mb-3" style="letter-spacing: -0.5px;">No Database Selected</h3>
        <p class="text-muted fs-6 mb-4" style="line-height: 1.6;">
            You are currently connected to a server, but no specific database has been selected. 
            Please select a database from the dropdown menu in the sidebar to begin exploring.
        </p>

    </div>
</div>

@code {
    [Parameter]
    public string Height { get; set; } = "calc(100vh - 100px)";
}
