<div class="d-flex flex-column justify-content-center align-items-center w-100" style="height: @Height; background: rgba(20, 20, 20, 0.5);">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem; border-width: 0.3rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="mt-3 text-muted fs-5">@Message</div>
</div>

@code {
    [Parameter]
    public string Height { get; set; } = "calc(100vh - 100px)";

    [Parameter]
    public string Message { get; set; } = "Loading...";
}
