@page "/view/{FullName}"
@using ExploreDB.Services
@using BlazorMonaco.Editor
@using BlazorMonaco
@inject SchemaService SchemaService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
<div class="container-fluid">
    @if (IsLoading)
    {
        <LoadingSpinner />
    }
    else if (View == null)
    {
        <div class="alert alert-warning">View not found: @FullName</div>
    }
    else
    {
        <!-- Header -->
        <div class="row mb-4 align-items-center">
            <div class="col">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex flex-column overflow-hidden justify-content-center" style="min-width: 0;">
                        <h5 class="text-white mb-0 fw-bold text-wrap d-flex align-items-center gap-2" style="letter-spacing: 0.5px; word-break: break-word;">
                            @View.Name
                            <span class="badge bg-info text-dark fw-normal align-middle" style="font-size: 0.45em; padding: 0.35em 0.6em;">VIEW</span>
                        </h5>
                        <small class="text-muted fw-bold" style="font-size: 0.7em; letter-spacing: 1px; margin-top: 2px;">SCHEMA: <span class="text-lowercase">@View.Schema</span></small>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <a href="javascript:void(0)" @onclick="NavigateBack" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 hover-scale transition-transform fw-medium rounded-pill px-3 py-1 shadow-sm border-secondary text-light">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>

        </div>

        <style>
            .schema-accordion .accordion-item {
                border-radius: 0.375rem !important;
                overflow: hidden;
                border-top: 1px solid #495057 !important;
            }
            .schema-accordion .accordion-button {
                background-color: transparent !important;
                color: #adb5bd !important;
                border: none !important;
                box-shadow: none !important;
            }
            .schema-accordion .accordion-button:not(.collapsed) {
                background-color: rgba(255,255,255,0.05) !important;
                color: #fff !important;
                border-bottom: 1px solid #495057 !important;
            }
            .schema-accordion .accordion-button::after {
                filter: invert(1) grayscale(100%) brightness(200%);
            }
        </style>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs border-secondary mb-4">
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Columns" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Columns")' style="cursor:pointer">
                    Columns
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Dependencies" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Dependencies")' style="cursor:pointer">
                    Dependencies
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Queries" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Queries")' style="cursor:pointer">
                    Query
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Definition" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Definition")' style="cursor:pointer">
                    Definition
                </a>
            </li>
        </ul>

        <div class="tab-content pb-5">
            @if (ActiveTab == "Columns")
            {
                <!-- Columns Tab -->
                <div class="card glass-card text-white">
                    <div class="card-body">
                        <div class="mb-4">
                            <div class="input-group shadow-sm w-100 flex-nowrap">
                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary shadow-none" style="min-width: 200px;"
                                       placeholder="Search columns..."
                                       @bind="ColumnSearchTerm"
                                       @bind:event="oninput" />
                                <button class="btn @(ColumnSearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => ColumnSearchCaseSensitive = !ColumnSearchCaseSensitive">
                                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                </button>
                                <button class="btn @(ColumnSearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { ColumnSearchMatchWholeWord = !ColumnSearchMatchWholeWord; if (ColumnSearchMatchWholeWord) ColumnSearchExactMatch = false; }">
                                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                </button>
                                <button class="btn @(ColumnSearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { ColumnSearchExactMatch = !ColumnSearchExactMatch; if (ColumnSearchExactMatch) ColumnSearchMatchWholeWord = false; }">
                                    <i class="bi bi-bullseye fs-6"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="table-responsive custom-scrollbar-light">
                            <table class="table table-dark table-hover align-middle border-secondary mb-0">
                                <thead>
                                    <tr>
                                        <th class="border-secondary text-muted fw-normal">Column Name</th>
                                        <th class="border-secondary text-muted fw-normal text-end">Data Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (VisibleColumns.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="2" class="text-center py-4 text-muted">No matching columns found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var col in VisibleColumns)
                                        {
                                            <tr>
                                                <td class="border-secondary fw-medium">
                                                    @col.Name
                                                    @if (!string.IsNullOrEmpty(col.SourceTable))
                                                    {
                                                        var sourceFullName = $"[{col.SourceSchema}].[{col.SourceTable}]";
                                                        <a href="@BuildObjectLink(sourceFullName)" class="badge bg-dark border border-secondary text-decoration-none text-light ms-2 hover-scale transition-transform" title="Source: @sourceFullName">
                                                            <i class="bi bi-link-45deg text-muted"></i> @col.SourceSchema<span class="text-secondary">.</span>@col.SourceTable
                                                        </a>
                                                    }
                                                </td>
                                                <td class="border-secondary text-end">
                                                    @{ var _typeLink = SchemaService.Types.FirstOrDefault(t => t.Name.Equals(col.DataType, StringComparison.OrdinalIgnoreCase)); }
                                                    @if (_typeLink != null)
                                                    {
                                                        <a href="/type/@Uri.EscapeDataString(_typeLink.FullName)" class="badge bg-dark text-info border border-info font-monospace text-decoration-none" style="font-size: 0.85em;" title="Custom type: @_typeLink.FullName">@col.DataType</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark text-muted border border-secondary font-monospace" style="font-size: 0.85em;">@col.DataType</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "Dependencies")
            {
                <!-- Dependencies Tab -->
                <div class="text-white mt-1">
                    <div class="mb-4 d-flex flex-wrap align-items-center gap-3">
                        <div class="flex-grow-1" style="min-width: 300px; max-width: 500px;">
                            <div class="input-group shadow-sm flex-nowrap">
                            <input type="text"
                                   class="form-control bg-dark text-white border-secondary shadow-none" style="min-width: 200px;"
                                   placeholder="Search dependencies..."
                                   @bind="DependencySearchTerm"
                                   @bind:event="oninput" />
                            <button class="btn @(DependencySearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => DependencySearchCaseSensitive = !DependencySearchCaseSensitive">
                                <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                            </button>
                            <button class="btn @(DependencySearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { DependencySearchMatchWholeWord = !DependencySearchMatchWholeWord; if (DependencySearchMatchWholeWord) DependencySearchExactMatch = false; }">
                                <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                            </button>
                            <button class="btn @(DependencySearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { DependencySearchExactMatch = !DependencySearchExactMatch; if (DependencySearchExactMatch) DependencySearchMatchWholeWord = false; }">
                                <i class="bi bi-bullseye fs-6"></i>
                            </button>
                        </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-4 text-light ms-auto mt-2 mt-md-0">
                            <div class="form-check m-0">
                                <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowTables" @bind="DependencyShowTables">
                                <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowTables">
                                    Table
                                </label>
                            </div>
                            <div class="form-check m-0">
                                <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowSPs" @bind="DependencyShowSPs">
                                <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowSPs">
                                    SP
                                </label>
                            </div>
                            <div class="form-check m-0">
                                <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowViews" @bind="DependencyShowViews">
                                <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowViews">
                                    View
                                </label>
                            </div>
                            <div class="form-check m-0">
                                <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowFuncs" @bind="DependencyShowFuncs">
                                <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowFuncs">
                                    Function
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="accordion schema-accordion" id="dependenciesAccordion">
                        <div class="accordion-item glass-card mb-3 border-secondary">
                            <h2 class="accordion-header" id="headingDependsOn">
                                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDependsOn" aria-expanded="true" aria-controls="collapseDependsOn">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span>Depends On</span>
                                        <i class="bi bi-info-circle text-muted" data-bs-tooltip="true" data-bs-title="tables, views, and functions queried by this view" data-bs-placement="top" style="font-size: 0.85em;"></i>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapseDependsOn" class="accordion-collapse collapse show" aria-labelledby="headingDependsOn" data-bs-parent="#dependenciesAccordion">
                                <div class="accordion-body text-white">
                                    @if (View.Parents.Count == 0)
                                    {
                                        <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                            <div class="text-muted">This view does not depend on any other objects.</div>
                                        </div>
                                    }
                                    else if (!FilteredDependsOn.Any())
                                    {
                                        <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                            <div class="text-muted">No matching upstream dependencies found.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var dep in FilteredDependsOn)
                                            {
                                                var isProc = dep.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) || dep.Type == "SP";
                                                var isFunc = dep.Type == "Function";
                                                var iconClass = isProc ? "text-warning font-monospace" : (isFunc ? "text-primary" : (dep.Type == "Table" ? "text-primary" : "text-success"));
                                                <div class="col-md-6 col-12">
                                                    <a href="@BuildDependencyLink(dep)" class="card text-decoration-none h-100 hover-scale transition-transform" style="background-color: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1);"
                                                       data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> @(dep.Type)<br/><b>Name:</b> @dep.Name<br/><b>Schema:</b> @dep.Schema.ToLower()" data-bs-placement="bottom">
                                                        <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                                                            <div class="@iconClass fw-bold fs-4 flex-shrink-0">
                                                                @if (isProc)
                                                                {
                                                                    @("{}")
                                                                }
                                                                else if (isFunc)
                                                                {
                                                                    <i class="bi bi-code"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi @(dep.Type == "Table" ? "bi-table" : "bi-layout-text-window")"></i>
                                                                }
                                                            </div>
                                                            <div class="overflow-hidden" style="min-width: 0;">
                                                                <div class="text-white fw-bold text-truncate" style="font-size: 0.95em;">@GetShortName(dep.Name)</div>
                                                                <div class="text-muted mt-1 text-truncate" style="font-size: 0.7em; letter-spacing: 0.5px;">SCHEMA: <span class="text-lowercase">@dep.Schema</span></div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item glass-card mb-3 border-secondary">
                            <h2 class="accordion-header" id="headingUsedBy">
                                <button class="accordion-button fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsedBy" aria-expanded="false" aria-controls="collapseUsedBy">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span>Used By</span>
                                        <i class="bi bi-info-circle text-muted" data-bs-tooltip="true" data-bs-title="views, procedures, and functions that query this view" data-bs-placement="top" style="font-size: 0.85em;"></i>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapseUsedBy" class="accordion-collapse collapse" aria-labelledby="headingUsedBy" data-bs-parent="#dependenciesAccordion">
                                <div class="accordion-body text-white">
                                    @if ((View.Children.Count + View.ReferencedBySPs.Count) == 0)
                                    {
                                        <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                            <div class="text-muted">This view is not used by any other objects.</div>
                                        </div>
                                    }
                                    else if (!FilteredUsedBy.Any())
                                    {
                                        <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                            <div class="text-muted">No matching downstream dependencies found.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            @foreach (var dep in FilteredUsedBy)
                                            {
                                                var isProc = dep.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) || dep.Type == "SP";
                                                var isFunc = dep.Type == "Function";
                                                var iconClass = isProc ? "text-warning font-monospace" : (isFunc ? "text-primary" : (dep.Type == "Table" ? "text-primary" : "text-success"));
                                                <div class="col-md-6 col-12">
                                                    <a href="@BuildDependencyLink(dep)" class="card text-decoration-none h-100 hover-scale transition-transform" style="background-color: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1);"
                                                       data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> @(dep.Type)<br/><b>Name:</b> @dep.Name<br/><b>Schema:</b> @dep.Schema.ToLower()" data-bs-placement="bottom">
                                                        <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                                                            <div class="@iconClass fw-bold fs-4 flex-shrink-0">
                                                                @if (isProc)
                                                                {
                                                                    @("{}")
                                                                }
                                                                else if (isFunc)
                                                                {
                                                                    <i class="bi bi-code"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi @(dep.Type == "Table" ? "bi-table" : "bi-layout-text-window")"></i>
                                                                }
                                                            </div>
                                                            <div class="overflow-hidden" style="min-width: 0;">
                                                                <div class="text-white fw-bold text-truncate" style="font-size: 0.95em;">@GetShortName(dep.Name)</div>
                                                                <div class="text-muted mt-1 text-truncate" style="font-size: 0.7em; letter-spacing: 0.5px;">SCHEMA: <span class="text-lowercase">@dep.Schema</span></div>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "Queries")
            {
                <!-- Query Tab -->
                <div class="row">
                    <div class="col-12">
                        <div class="card glass-card text-white mb-4">
                            <div class="card-header border-secondary fw-bold d-flex justify-content-between align-items-center py-3">
                                <div>
                                    SELECT Query
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-light d-flex align-items-center gap-2" @onclick="CopySelectQuery">
                                        @if (SelectCopied)
                                        {
                                            <i class="bi bi-check2 text-success"></i> <span>Copied!</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-clipboard"></i> <span>Copy</span>
                                        }
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-2" @onclick="@(() => LoadAndRunQuery(SelectQuery, $"Select_{View.Name}.sql"))">
                                        <i class="bi bi-play-fill"></i> Run
                                    </button>
                                </div>
                            </div>
                            <div class="card-body">
                                <pre class="query-preview mb-0">@SelectQuery</pre>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "Definition")
            {
                <div class="card glass-card text-white">
                    <div class="card-body p-0 position-relative">
                        <div class="p-3 d-flex justify-content-between align-items-center border-bottom border-secondary bg-dark bg-opacity-50">
                            <span class="fw-bold">View Definition</span>
                            @if (!IsDefinitionLoading && !string.IsNullOrEmpty(View?.Definition))
                            {
                                <button class="btn btn-sm @(DefinitionCopied ? "btn-success" : "btn-outline-light")"
                                        @onclick="CopyDefinition" title="Copy to clipboard">
                                    <i class="bi @(DefinitionCopied ? "bi-check2" : "bi-clipboard")"></i> @(DefinitionCopied ? "Copied" : "Copy")
                                </button>
                            }
                        </div>
                        @if (IsDefinitionLoading)
                        {
                            <div class="d-flex justify-content-center align-items-center" style="padding: 4rem 1rem;">
                                <div class="spinner-border text-secondary" role="status" style="width: 1.5rem; height: 1.5rem;">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span class="ms-3 text-muted small">Loading definition...</span>
                            </div>
                        }
                        else if (string.IsNullOrEmpty(View?.Definition))
                        {
                            <div class="d-flex justify-content-center align-items-center" style="padding: 4rem 1rem;">
                                <span class="text-muted">Definition not available. You may not have VIEW DEFINITION permission.</span>
                            </div>
                        }
                        else
                        {
                            <div style="height: 500px; min-height: 300px; resize: vertical; overflow: hidden;">
                                <StandaloneCodeEditor @ref="_definitionEditor" Id="view-definition-editor" CssClass="w-100 h-100" ConstructionOptions="DefinitionEditorOptions" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string FullName { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool ShowLimitAlert = false;
    private bool IsLoading = true;
    private ViewInfo? View;
    private bool IsDefinitionLoading = false;
    private bool DefinitionCopied = false;
    private StandaloneCodeEditor? _definitionEditor;
    private string ActiveTab = "Columns";

    private string ColumnSearchTerm = string.Empty;
    private bool ColumnSearchCaseSensitive = false;
    private bool ColumnSearchMatchWholeWord = false;
    private bool ColumnSearchExactMatch = false;

    private string DependencySearchTerm = string.Empty;
    private bool DependencySearchCaseSensitive = false;
    private bool DependencyShowTables = true;
    private bool DependencyShowSPs = true;
    private bool DependencyShowViews = true;
    private bool DependencyShowFuncs = true;
    private bool DependencySearchMatchWholeWord = false;
    private bool DependencySearchExactMatch = false;

    private bool SelectCopied;

    private IEnumerable<Dependency> FilteredDependsOn
    {
        get
        {
            if (View == null) return Array.Empty<Dependency>();
            
            var allDependsOn = Enumerable.Empty<Dependency>();
            var tables = View.Parents.Where(p => !p.Type.Contains("View", StringComparison.OrdinalIgnoreCase) && p.Type != "V" && !p.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) && p.Type != "SP" && p.Type != "Function" && p.Type != "Type");
            var views = View.Parents.Where(p => p.Type.Contains("View", StringComparison.OrdinalIgnoreCase) || p.Type == "V");
            var sps = View.Parents.Where(p => p.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) || p.Type == "SP");
            var funcs = View.Parents.Where(p => p.Type == "Function");
            
            if (DependencyShowTables) allDependsOn = allDependsOn.Concat(tables);
            if (DependencyShowViews) allDependsOn = allDependsOn.Concat(views);
            if (DependencyShowSPs) allDependsOn = allDependsOn.Concat(sps);
            if (DependencyShowFuncs) allDependsOn = allDependsOn.Concat(funcs);
            
            if (string.IsNullOrWhiteSpace(DependencySearchTerm)) return allDependsOn;
            
            var searchStr = DependencySearchCaseSensitive ? DependencySearchTerm : DependencySearchTerm.ToLowerInvariant();
            
            return allDependsOn.Where(d => 
            {
                var nameVal = DependencySearchCaseSensitive ? d.Name : d.Name.ToLowerInvariant();
                var schemaVal = DependencySearchCaseSensitive ? d.Schema : d.Schema.ToLowerInvariant();
                
                if (DependencySearchExactMatch) 
                    return nameVal == searchStr || schemaVal == searchStr;
                if (DependencySearchMatchWholeWord) 
                    return nameVal.Split('_', '-', '.').Contains(searchStr) || schemaVal.Split('_', '-', '.').Contains(searchStr);
                    
                return nameVal.Contains(searchStr) || schemaVal.Contains(searchStr);
            });
        }
    }

    private IEnumerable<Dependency> FilteredUsedBy
    {
        get
        {
            if (View == null) return Array.Empty<Dependency>();
            
            var allUsedBy = Enumerable.Empty<Dependency>();
            if (DependencyShowViews) allUsedBy = allUsedBy.Concat(View.Children);
            if (DependencyShowSPs) allUsedBy = allUsedBy.Concat(View.ReferencedBySPs);
            
            if (string.IsNullOrWhiteSpace(DependencySearchTerm)) return allUsedBy;
            
            var searchStr = DependencySearchCaseSensitive ? DependencySearchTerm : DependencySearchTerm.ToLowerInvariant();
            
            return allUsedBy.Where(d => 
            {
                var nameVal = DependencySearchCaseSensitive ? d.Name : d.Name.ToLowerInvariant();
                var schemaVal = DependencySearchCaseSensitive ? d.Schema : d.Schema.ToLowerInvariant();
                
                if (DependencySearchExactMatch) 
                    return nameVal == searchStr || schemaVal == searchStr;
                if (DependencySearchMatchWholeWord) 
                    return nameVal.Split('_', '-', '.').Contains(searchStr) || schemaVal.Split('_', '-', '.').Contains(searchStr);
                    
                return nameVal.Contains(searchStr) || schemaVal.Contains(searchStr);
            });
        }
    }

    private List<ColumnInfo> VisibleColumns => FilterColumns(ColumnSearchTerm, ColumnSearchCaseSensitive, ColumnSearchMatchWholeWord, ColumnSearchExactMatch);
    private string SelectQuery => $"SELECT TOP 100 * FROM {QuotedViewName(View!)};";

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        await Task.Yield();
        
        if (!SchemaService.AreTypesLoaded)
        {
            await SchemaService.LoadTypesAsync();
        }
        
        var decoded = Uri.UnescapeDataString(FullName);
        View = SchemaService.Views.FirstOrDefault(t => t.FullName == decoded);
        
        if (View != null && !View.AreDependenciesLoaded)
        {
            await SchemaService.LoadViewLineageAndDependenciesAsync(View.FullName);
        }

        ColumnSearchTerm = string.Empty;
        
        IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("scrollToMainTop"); } catch { }
        }
    }

    private async Task SetActiveTab(string tab)
    {
        ActiveTab = tab;
        if (tab == "Definition" && View != null && !View.IsDefinitionLoaded && !IsDefinitionLoading)
        {
            IsDefinitionLoading = true;
            await SchemaService.LoadDefinitionAsync(View.FullName);
            IsDefinitionLoading = false;
        }
        if (tab == "Definition" && _definitionEditor != null && View?.Definition != null)
        {
            await _definitionEditor.SetValue(View.Definition);
        }
    }

    private StandaloneEditorConstructionOptions DefinitionEditorOptions(StandaloneCodeEditor editor)
