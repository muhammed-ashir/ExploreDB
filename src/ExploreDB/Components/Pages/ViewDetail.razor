    private async Task CopyDefinition()
    {
        if (string.IsNullOrEmpty(View?.Definition)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", View.Definition);
        DefinitionCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        DefinitionCopied = false;
    }

    private async Task LoadAndRunQuery(string queryText, string tabName)
    {
        if (QueryStateService.Tabs.Count >= Config.GetValue<int>("MaxOpenTabs", 20))
        {
            ShowLimitAlert = true;
            return;
        }

        var newCount = QueryStateService.Tabs.Count + 1;
        var newTab = new ExploreDB.Services.QueryTab 
        { 
            Name = tabName,
            Content = queryText
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        await QueryStateService.SaveTabsAsync();
        
        Navigation.NavigateTo("/runner");
    }

    private void NavigateBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/views");
    }

    private string BuildDependencyLink(Dependency dependency)
    {
        var isProc = dependency.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) || dependency.Type == "SP";
        var isFunc = dependency.Type == "Function";
        var prefix = isProc ? "/proc" : (isFunc ? "/function" : (dependency.Type == "View" ? "/view" : "/table"));
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(dependency.FullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string GetShortName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return string.Empty;
        var parts = fullName.Split('.');
        if (parts.Length == 2)
        {
            return parts[1].Trim('[', ']');
        }
        return fullName.Trim('[', ']');
    }

    private string BuildObjectLink(string fullName)
    {
        var prefix = IsView(fullName) ? "/view" : "/table";
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(fullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private bool IsView(string fullName)
    {
        return SchemaService.Views.Any(v => v.FullName.Equals(fullName, StringComparison.OrdinalIgnoreCase));
    }

    private string QuotedViewName(ViewInfo view)
    {
        return $"[{view.Schema}].[{view.Name}]";
    }

    private List<ColumnInfo> FilterColumns(string searchTerm, bool caseSensitive, bool matchWholeWord, bool exactMatch)
    {
        if (View == null) return new List<ColumnInfo>();
        if (string.IsNullOrWhiteSpace(searchTerm)) return View.Columns.ToList();

        var searchStr = caseSensitive ? searchTerm : searchTerm.ToLower();

        return View.Columns.Where(c =>
        {
            var colName = caseSensitive ? c.Name : c.Name.ToLower();
            var dataType = caseSensitive ? c.DataType : c.DataType.ToLower();

            if (exactMatch)
            {
                return colName == searchStr || dataType == searchStr;
            }
            if (matchWholeWord)
            {
                return colName.Split(' ', '.', '_').Contains(searchStr) || 
                       dataType.Split(' ', '.', '_').Contains(searchStr);
            }
            
            return colName.Contains(searchStr) || dataType.Contains(searchStr);
        }).ToList();
    }

    private async Task CopySelectQuery()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", SelectQuery);
        SelectCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        SelectCopied = false;
        StateHasChanged();
    }
