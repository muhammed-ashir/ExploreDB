    private async Task OnDatabaseSelectedAsync(string db)
    {
        _isDatabaseDropdownOpen = false;
        if (!string.Equals(_selectedDatabase, db, StringComparison.OrdinalIgnoreCase))
        {
            await ClearProcedureAsync();
            _selectedDatabase = db;
            _databaseSearch = db;
            await LoadProceduresForTargetAsync();
        }
        else
        {
            _databaseSearch = db;
        }
    }

    private async Task LoadDatabasesForSelectedServerAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedConnectionString))
        {
            _availableDatabases.Clear();
            return;
        }

        _isLoadingDatabases = true;
        await InvokeAsync(StateHasChanged);

        var dbs = new List<string>();
        string targetConn = _selectedConnectionString;

        try
        {
            await Task.Run(async () =>
            {
                bool fetched = false;
                try
                {
                    var masterBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(targetConn)
                    {
                        InitialCatalog = "master",
                        ConnectTimeout = 4
                    };
                    using var conn = new Microsoft.Data.SqlClient.SqlConnection(masterBuilder.ConnectionString);
                    await conn.OpenAsync();
                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                    using var reader = await cmd.ExecuteReaderAsync();
                    while (await reader.ReadAsync())
                    {
                        dbs.Add(reader.GetString(0));
                    }
                    fetched = true;
                }
                catch { }

                if (!fetched)
                {
                    try
                    {
                        using var conn = new Microsoft.Data.SqlClient.SqlConnection(targetConn);
                        await conn.OpenAsync();
                        using var cmd = conn.CreateCommand();
                        cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                        using var reader = await cmd.ExecuteReaderAsync();
                        while (await reader.ReadAsync())
                        {
                            dbs.Add(reader.GetString(0));
                        }
                    }
                    catch { }
                }
            });
        }
        catch { }
        finally
        {
            _availableDatabases = dbs;
            _isLoadingDatabases = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadProceduresForTargetAsync()
    {
        _spList.Clear();
        var targetConn = GetTargetConnectionString();
        if (string.IsNullOrWhiteSpace(targetConn) || string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            return;
        }

        _isLoadingProcedures = true;
        await InvokeAsync(StateHasChanged);

        var newSps = new List<SpInfo>();
        try
        {
            await Task.Run(async () =>
            {
                using var conn = new Microsoft.Data.SqlClient.SqlConnection(targetConn);
                await conn.OpenAsync();

                var batchSql = @"
                    SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

                    SELECT 
                        s.name AS SchemaName, p.name AS ProcName, p.create_date AS CreatedDate, p.modify_date AS ModifiedDate
                    FROM sys.procedures p
                    JOIN sys.schemas s ON p.schema_id = s.schema_id
                    WHERE p.is_ms_shipped = 0
                    ORDER BY s.name, p.name;

                    SELECT 
                        s.name AS SchemaName, p.name AS ProcName, pm.name AS ParamName, t.name AS DataType,
                        pm.is_output AS IsOutput, pm.has_default_value AS HasDefault,
                        CAST(pm.default_value AS NVARCHAR(256)) AS DefaultValue,
                        pm.max_length AS MaxLength, pm.precision AS Precision, pm.scale AS Scale
                    FROM sys.procedures p
                    JOIN sys.schemas s ON p.schema_id = s.schema_id
                    JOIN sys.parameters pm ON pm.object_id = p.object_id
                    JOIN sys.types t ON pm.user_type_id = t.user_type_id
                    WHERE p.is_ms_shipped = 0
                    ORDER BY s.name, p.name, pm.parameter_id;
                ";

                using var cmd = conn.CreateCommand();
                cmd.CommandText = batchSql;
                cmd.CommandTimeout = 30;

                using var reader = await cmd.ExecuteReaderAsync();

                while (await reader.ReadAsync())
                {
                    newSps.Add(new SpInfo
                    {
                        Schema = reader.GetString(0),
                        Name = reader.GetString(1),
                        CreatedDate = await reader.IsDBNullAsync(2) ? null : reader.GetDateTime(2),
                        ModifiedDate = await reader.IsDBNullAsync(3) ? null : reader.GetDateTime(3)
                    });
                }

                var spDict = newSps.ToDictionary(sp => sp.FullName, StringComparer.OrdinalIgnoreCase);

                if (await reader.NextResultAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        var schema = reader.GetString(0);
                        var procName = reader.GetString(1);
                        var paramName = reader.GetString(2);
                        var dataType = reader.GetString(3);
                        var isOutput = reader.GetBoolean(4);
                        var hasDefault = reader.GetBoolean(5);
                        var defaultValue = await reader.IsDBNullAsync(6) ? null : reader.GetString(6);
                        var maxLen = reader.GetInt16(7);
                        var prec = reader.GetByte(8);
                        var scale = reader.GetByte(9);

                        var fullName = $"[{schema}].[{procName}]";
                        if (spDict.TryGetValue(fullName, out var sp))
                        {
                            sp.Parameters.Add(new SpParameter
                            {
                                Name = paramName,
                                DataType = dataType,
                                IsOutput = isOutput,
                                HasDefault = hasDefault,
                                DefaultValue = defaultValue,
                                MaxLength = maxLen,
                                Precision = prec,
                                Scale = scale
                            });
                        }
                    }
                }
            });
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Error loading stored procedures for target database {Database}", _selectedDatabase);
        }
        finally
        {
            _spList = newSps;
            _isLoadingProcedures = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<string?> LoadSpDefinitionAsync(SpInfo sp)
    {
        var targetConn = GetTargetConnectionString();
        if (string.IsNullOrWhiteSpace(targetConn)) return null;

        try
        {
            using var conn = new Microsoft.Data.SqlClient.SqlConnection(targetConn);
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "SELECT OBJECT_DEFINITION(OBJECT_ID(@FullName))";
            cmd.Parameters.AddWithValue("@FullName", sp.FullName);
            var result = await cmd.ExecuteScalarAsync() as string;
            if (!string.IsNullOrEmpty(result))
            {
                sp.Definition = result;
                sp.IsDefinitionLoaded = true;
                return result;
            }
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Error fetching definition for SP {FullName}", sp.FullName);
        }
        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!ToolService.IsToolAvailable("sp-debugger"))
        {
            Nav.NavigateTo("tools");
            return;
        }

        ConnectionService.OnConnectionChanged += HandleConnectionChanged;
        ConnectionService.OnDatabaseSwitched += OnDatabaseSwitchedHandler;

        RefreshAvailableConnections();

        if (string.IsNullOrEmpty(_selectedConnectionString))
        {
            _selectedConnectionString = ConnectionService.ConnectionString;
        }
        if (string.IsNullOrEmpty(_selectedDatabase))
        {
            _selectedDatabase = SchemaService.ActiveDatabase;
        }

        _serverSearch = GetSelectedServerDisplayName();
        _databaseSearch = GetSelectedDatabaseDisplayName();

        _session = DebuggerService.ActiveSession;
        if (_session != null)
        {
            _selectedSpName = _session.FullName;
            if (!string.IsNullOrEmpty(_session.Database))
            {
                _selectedDatabase = _session.Database;
                _databaseSearch = _selectedDatabase;
            }
            _showSafetyAlert = false;
        }

        await LoadDatabasesForSelectedServerAsync();
        await LoadProceduresForTargetAsync();
    }

    private void OnSpFilterInput(ChangeEventArgs e)
    {
        _spFilter = e.Value?.ToString() ?? string.Empty;
        _showSpDropdown = true;
