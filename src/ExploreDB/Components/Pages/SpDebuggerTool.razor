@code {
    [CascadingParameter(Name = "IsPopout")]
    public bool IsPopout { get; set; }

    private SpDebugSessionState? _session;
    private StandaloneCodeEditor? _editor;
    private DotNetObjectReference<SpDebuggerTool>? _dotNetHelper;
    private string[] _stepDecorationIds = Array.Empty<string>();
    private string[] _breakpointDecorationIds = Array.Empty<string>();
    private HashSet<int> _breakpointLines = new();

    private string _selectedSpName = string.Empty;
    private string _spFilter = string.Empty;
    private bool _showSpDropdown = false;
    private bool _showSafetyAlert = true;
    private bool _showParametersModal = false;
    private bool _showWarningsBanner = true;
    private bool _isLoadingDef = false;
    private bool _isRecording = false;

    private List<ConnectionService.SavedConnection> _availableConnections = new();
    private string _selectedConnectionString = string.Empty;
    private string _selectedDatabase = string.Empty;
    private List<string> _availableDatabases = new();
    private bool _isLoadingDatabases = false;
    private bool _isServerDropdownOpen = false;
    private string _serverSearch = string.Empty;
    private bool _isDatabaseDropdownOpen = false;
    private string _databaseSearch = string.Empty;

    private List<SpInfo> _spList = new();
    private bool _isLoadingProcedures = false;

    private bool IsDebuggerLocked => _isRecording || (_session != null && _session.IsRecorded);

    private string _activeInspectorTab = "Variables";
    private string _varFilter = string.Empty;
    private string _ttFilter = string.Empty;
    private string _rsFilter = string.Empty;
    private HashSet<int> _collapsedResultSets = new();
    private HashSet<string> _collapsedTempTables = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<int, int> _rsPages = new();
    private Dictionary<string, int> _tablePages = new(StringComparer.OrdinalIgnoreCase);
    private const int _gridPageSize = 50;

    private int GetRsPage(int rsIndex) => _rsPages.TryGetValue(rsIndex, out var p) ? p : 1;
    private void SetRsPage(int rsIndex, int page)
    {
        _rsPages[rsIndex] = page;
        StateHasChanged();
    }

    private int GetTablePage(string tableName) => _tablePages.TryGetValue(tableName, out var p) ? p : 1;
    private void SetTablePage(string tableName, int page)
    {
        _tablePages[tableName] = page;
        StateHasChanged();
    }

    private enum SpWorkspaceLayout
    {
        Split,
        MaximizeCode,
        MaximizeInspector
    }

    private SpWorkspaceLayout _workspaceLayout = SpWorkspaceLayout.Split;

    private string CodeColumnClass => _workspaceLayout switch
    {
        SpWorkspaceLayout.MaximizeCode => "col-12 d-flex flex-column h-100",
        SpWorkspaceLayout.MaximizeInspector => "d-none",
        _ => "col-12 col-lg-7 d-flex flex-column h-100"
    };

    private string InspectorColumnClass => _workspaceLayout switch
    {
        SpWorkspaceLayout.MaximizeInspector => "col-12 d-flex flex-column h-100",
        SpWorkspaceLayout.MaximizeCode => "d-none",
        _ => "col-12 col-lg-5 d-flex flex-column h-100"
    };

    private async Task ToggleMaximizeCodeAsync()
    {
        _workspaceLayout = _workspaceLayout == SpWorkspaceLayout.MaximizeCode
            ? SpWorkspaceLayout.Split
            : SpWorkspaceLayout.MaximizeCode;

        StateHasChanged();
        await Task.Delay(50);
        if (_editor != null)
        {
            try { await _editor.Layout(); } catch { }
        }
    }

    private async Task ToggleMaximizeInspectorAsync()
    {
        _workspaceLayout = _workspaceLayout == SpWorkspaceLayout.MaximizeInspector
            ? SpWorkspaceLayout.Split
            : SpWorkspaceLayout.MaximizeInspector;

        StateHasChanged();
        await Task.Delay(50);
        if (_editor != null)
        {
            try { await _editor.Layout(); } catch { }
        }
    }

    private void ToggleResultSet(int index)
    {
        if (!_collapsedResultSets.Add(index))
        {
            _collapsedResultSets.Remove(index);
        }
    }

    private void CollapseAllResultSets()
    {
        for (int i = 1; i <= CurrentSnapshotResults.Count; i++)
        {
            _collapsedResultSets.Add(i);
        }
    }

    private void ExpandAllResultSets()
    {
        _collapsedResultSets.Clear();
    }

    private void ToggleTempTable(string tableName)
    {
        if (!_collapsedTempTables.Add(tableName))
        {
            _collapsedTempTables.Remove(tableName);
        }
    }

    private void CollapseAllTempTables()
    {
        foreach (var tt in CurrentSnapshotTempTables)
        {
            _collapsedTempTables.Add(tt.Name);
        }
    }

    private void ExpandAllTempTables()
    {
        _collapsedTempTables.Clear();
    }

    private async Task CopyMessagesToClipboard()
    {
        try
        {
            var text = string.Join("\n", CurrentSnapshotMessages);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch { }
    }

    private IEnumerable<SpInfo> FilteredProcedures => _spList.Where(p =>
    {
        if (string.IsNullOrWhiteSpace(_spFilter)) return true;
        return p.FullName.Contains(_spFilter, StringComparison.OrdinalIgnoreCase) ||
               p.Name.Contains(_spFilter, StringComparison.OrdinalIgnoreCase);
    });

    private Dictionary<string, SpVariableInfo> CurrentSnapshotVariables =>
        _session?.CurrentSnapshot?.Variables ?? new Dictionary<string, SpVariableInfo>(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<SpVariableInfo> FilteredVariables =>
        CurrentSnapshotVariables.Values.Where(v =>
            string.IsNullOrWhiteSpace(_varFilter) ||
            v.Name.Contains(_varFilter, StringComparison.OrdinalIgnoreCase) ||
            v.DataType.Contains(_varFilter, StringComparison.OrdinalIgnoreCase));

    private List<SpTempTableInfo> CurrentSnapshotTempTables =>
        _session?.CurrentSnapshot?.TempTables ?? new List<SpTempTableInfo>();

    private IEnumerable<SpTempTableInfo> FilteredTempTables =>
        CurrentSnapshotTempTables.Where(tt =>
            string.IsNullOrWhiteSpace(_ttFilter) ||
            tt.Name.Contains(_ttFilter, StringComparison.OrdinalIgnoreCase) ||
            tt.Columns.Any(c => c.Contains(_ttFilter, StringComparison.OrdinalIgnoreCase)) ||
            tt.Rows.Any(r => r.Values.Any(v => v?.ToString()?.Contains(_ttFilter, StringComparison.OrdinalIgnoreCase) == true)));

    private List<SpResultSetInfo> CurrentSnapshotResults =>
        _session?.CurrentSnapshot?.ResultSets ?? new List<SpResultSetInfo>();

    private record FilteredResultSetItem(int OriginalIndex, SpResultSetInfo ResultSet);

    private IEnumerable<FilteredResultSetItem> FilteredResults
    {
        get
        {
            for (int i = 0; i < CurrentSnapshotResults.Count; i++)
            {
                var rs = CurrentSnapshotResults[i];
                int originalIndex = i + 1;
                bool matches = string.IsNullOrWhiteSpace(_rsFilter) ||
                    $"Result Set #{originalIndex}".Contains(_rsFilter, StringComparison.OrdinalIgnoreCase) ||
                    (rs.LineNumber > 0 && $"Line {rs.LineNumber}".Contains(_rsFilter, StringComparison.OrdinalIgnoreCase)) ||
                    rs.Columns.Any(c => c.Contains(_rsFilter, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(rs.StatementSummary) && rs.StatementSummary.Contains(_rsFilter, StringComparison.OrdinalIgnoreCase)) ||
                    rs.Rows.Any(r => r.Values.Any(v => v?.ToString()?.Contains(_rsFilter, StringComparison.OrdinalIgnoreCase) == true));

                if (matches)
                {
                    yield return new FilteredResultSetItem(originalIndex, rs);
                }
            }
        }
    }

    private List<string> CurrentSnapshotMessages =>
        _session?.CurrentSnapshot?.Messages ?? new List<string>();

    private List<string> AllRecordedMessages
    {
        get
        {
            if (_session == null) return new List<string>();
            if (_session.ExecutionMessages.Count > 0) return _session.ExecutionMessages;
            var list = new List<string>();
            foreach (var step in _session.RecordedSteps)
            {
                foreach (var m in step.Messages)
                {
                    if (!list.Contains(m)) list.Add(m);
                }
            }
            return list;
        }
    }

    private string GetTargetConnectionString()
    {
        if (string.IsNullOrWhiteSpace(_selectedConnectionString)) return string.Empty;
        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(_selectedConnectionString);
            if (!string.IsNullOrWhiteSpace(_selectedDatabase))
            {
                builder.InitialCatalog = _selectedDatabase;
            }
            return builder.ConnectionString;
        }
        catch
        {
            return _selectedConnectionString;
        }
    }

    private void RefreshAvailableConnections()
    {
        var list = new List<ConnectionService.SavedConnection>();

        void AddIfNotPresent(ConnectionService.SavedConnection conn)
        {
            if (string.IsNullOrWhiteSpace(conn.ConnectionString)) return;
            var existing = list.FirstOrDefault(x => IsSameServerConnection(x, conn));
            if (existing == null)
            {
                list.Add(conn);
            }
            else
            {
                if ((string.IsNullOrWhiteSpace(existing.Name) || string.Equals(existing.Name, existing.Server, StringComparison.OrdinalIgnoreCase))
                    && !string.IsNullOrWhiteSpace(conn.Name) && !string.Equals(conn.Name, conn.Server, StringComparison.OrdinalIgnoreCase))
                {
                    existing.Name = conn.Name;
                }
            }
        }

        if (ConnectionService.ActiveSessionConnections != null)
        {
            foreach (var c in ConnectionService.ActiveSessionConnections)
            {
                AddIfNotPresent(c);
            }
        }

        if (ConnectionService.SavedConnections != null)
        {
            foreach (var c in ConnectionService.SavedConnections)
            {
                AddIfNotPresent(c);
            }
        }

        if (!string.IsNullOrWhiteSpace(ConnectionService.ConnectionString))
        {
            string srv = "Active Connection";
            string db = "";
            try
            {
                var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
                srv = b.DataSource;
                db = b.InitialCatalog;
            }
            catch { }

            var activeConn = new ConnectionService.SavedConnection
            {
                Id = "current_active",
                Name = srv,
                Server = srv,
                Database = db,
                ConnectionString = ConnectionService.ConnectionString
            };

            if (!list.Any(x => IsSameServerConnection(x, activeConn)))
            {
                list.Insert(0, activeConn);
            }
        }

        _availableConnections = list;

        if (string.IsNullOrEmpty(_selectedConnectionString) && _availableConnections.Count > 0)
        {
            _selectedConnectionString = _availableConnections[0].ConnectionString;
            if (string.IsNullOrEmpty(_selectedDatabase))
            {
                _selectedDatabase = _availableConnections[0].Database ?? "";
            }
        }
    }

    private static bool IsSameServerConnection(ConnectionService.SavedConnection a, ConnectionService.SavedConnection b)
    {
        if (ReferenceEquals(a, b)) return true;
        if (a == null || b == null) return false;

        if (!string.IsNullOrEmpty(a.Id) && !string.IsNullOrEmpty(b.Id) &&
            !string.Equals(a.Id, "current_active", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(b.Id, "current_active", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(a.Id, b.Id, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(a.ConnectionString) && !string.IsNullOrWhiteSpace(b.ConnectionString) &&
            string.Equals(a.ConnectionString, b.ConnectionString, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        string normA = NormalizeServerConnectionString(a.ConnectionString);
        string normB = NormalizeServerConnectionString(b.ConnectionString);
        if (!string.IsNullOrEmpty(normA) && !string.IsNullOrEmpty(normB) &&
            string.Equals(normA, normB, StringComparison.OrdinalIgnoreCase))
        {
            if (string.IsNullOrEmpty(a.Name) || string.IsNullOrEmpty(b.Name) ||
                string.Equals(a.Name, b.Name, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        if (!string.IsNullOrWhiteSpace(a.Server) && !string.IsNullOrWhiteSpace(b.Server) &&
            string.Equals(a.Server, b.Server, StringComparison.OrdinalIgnoreCase))
        {
            if (string.Equals(a.Name ?? "", b.Name ?? "", StringComparison.OrdinalIgnoreCase) &&
                string.Equals(a.Username ?? "", b.Username ?? "", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string NormalizeServerConnectionString(string? connStr)
    {
        if (string.IsNullOrWhiteSpace(connStr)) return string.Empty;
        try
        {
            var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connStr);
            b.InitialCatalog = "";
            b.Remove("Initial Catalog");
            b.Remove("Database");
            return b.ConnectionString;
        }
        catch
        {
            return connStr.Trim();
        }
    }

    private static string GetConnectionOptionLabel(ConnectionService.SavedConnection conn)
    {
        if (string.IsNullOrWhiteSpace(conn.Name) || string.Equals(conn.Name, conn.Server, StringComparison.OrdinalIgnoreCase))
        {
            return conn.Server ?? "Unknown Server";
        }
        return $"{conn.Server} ({conn.Name})";
    }

    private static string GetServerDisplayName(string? connStr)
    {
        if (string.IsNullOrWhiteSpace(connStr)) return "None";
        try
        {
            var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connStr);
            return b.DataSource;
        }
        catch
        {
            return "Server";
        }
    }

    private string GetSelectedServerDisplayName()
    {
        var conn = _availableConnections.FirstOrDefault(c => 
            string.Equals(c.ConnectionString, _selectedConnectionString, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(NormalizeServerConnectionString(c.ConnectionString), NormalizeServerConnectionString(_selectedConnectionString), StringComparison.OrdinalIgnoreCase));
        if (conn != null)
        {
            return GetConnectionOptionLabel(conn);
        }
        return GetServerDisplayName(_selectedConnectionString);
    }

    private string GetSelectedDatabaseDisplayName() => _selectedDatabase ?? string.Empty;

    private void OpenServerDropdown()
    {
        if (IsDebuggerLocked) return;
        _isServerDropdownOpen = true;
        _isDatabaseDropdownOpen = false;
        _showSpDropdown = false;
        _serverSearch = "";
    }

    private void CloseServerDropdown()
    {
        _isServerDropdownOpen = false;
        _serverSearch = GetSelectedServerDisplayName();
    }

    private async Task OnServerSelectedAsync(string connString)
    {
        _isServerDropdownOpen = false;
        if (!string.Equals(_selectedConnectionString, connString, StringComparison.OrdinalIgnoreCase))
        {
            await ClearProcedureAsync();
            _selectedConnectionString = connString;
            _selectedDatabase = string.Empty;
            _serverSearch = GetSelectedServerDisplayName();
            await LoadDatabasesForSelectedServerAsync();
            if (string.IsNullOrEmpty(_selectedDatabase) && _availableDatabases.Count > 0)
            {
                string initCatalog = "";
                try
                {
                    var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connString);
                    initCatalog = b.InitialCatalog;
                }
                catch { }

                _selectedDatabase = _availableDatabases.FirstOrDefault(d => string.Equals(d, initCatalog, StringComparison.OrdinalIgnoreCase))
                                    ?? _availableDatabases[0];
                _databaseSearch = _selectedDatabase;
                await LoadProceduresForTargetAsync();
            }
            else
            {
                _databaseSearch = GetSelectedDatabaseDisplayName();
            }
        }
        else
        {
            _serverSearch = GetSelectedServerDisplayName();
        }
    }

    private void OpenDatabaseDropdown()
    {
        if (IsDebuggerLocked) return;
        _isDatabaseDropdownOpen = true;
        _isServerDropdownOpen = false;
        _showSpDropdown = false;
        _databaseSearch = "";
        if (_availableDatabases.Count == 0 && !_isLoadingDatabases)
        {
            _ = LoadDatabasesForSelectedServerAsync();
        }
    }

    private void CloseDatabaseDropdown()
