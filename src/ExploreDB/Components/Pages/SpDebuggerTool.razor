@code {
    [CascadingParameter(Name = "IsPopout")]
    public bool IsPopout { get; set; }

    private SpDebugSessionState? _session;
    private StandaloneCodeEditor? _editor;
    private DotNetObjectReference<SpDebuggerTool>? _dotNetHelper;
    private string[] _stepDecorationIds = Array.Empty<string>();
    private string[] _breakpointDecorationIds = Array.Empty<string>();
    private HashSet<int> _breakpointLines = new();

    private string _selectedSpName = string.Empty;
    private string _spFilter = string.Empty;
    private bool _showSpDropdown = false;
    private bool _showSafetyAlert = true;
    private bool _showParametersModal = false;
    private bool _showWarningsBanner = true;
    private bool _isLoadingDef = false;
    private bool _isRecording = false;

    private string _activeInspectorTab = "Variables";
    private string _varFilter = string.Empty;
    private HashSet<int> _collapsedResultSets = new();
    private HashSet<string> _collapsedTempTables = new(StringComparer.OrdinalIgnoreCase);

    private enum SpWorkspaceLayout
    {
        Split,
        MaximizeCode,
        MaximizeInspector
    }

    private SpWorkspaceLayout _workspaceLayout = SpWorkspaceLayout.Split;

    private string CodeColumnClass => _workspaceLayout switch
    {
        SpWorkspaceLayout.MaximizeCode => "col-12 d-flex flex-column h-100",
        SpWorkspaceLayout.MaximizeInspector => "d-none",
        _ => "col-12 col-lg-7 d-flex flex-column h-100"
    };

    private string InspectorColumnClass => _workspaceLayout switch
    {
        SpWorkspaceLayout.MaximizeInspector => "col-12 d-flex flex-column h-100",
        SpWorkspaceLayout.MaximizeCode => "d-none",
        _ => "col-12 col-lg-5 d-flex flex-column h-100"
    };

    private async Task ToggleMaximizeCodeAsync()
    {
        _workspaceLayout = _workspaceLayout == SpWorkspaceLayout.MaximizeCode
            ? SpWorkspaceLayout.Split
            : SpWorkspaceLayout.MaximizeCode;

        StateHasChanged();
        await Task.Delay(50);
        if (_editor != null)
        {
            try { await _editor.Layout(); } catch { }
        }
    }

    private async Task ToggleMaximizeInspectorAsync()
    {
        _workspaceLayout = _workspaceLayout == SpWorkspaceLayout.MaximizeInspector
            ? SpWorkspaceLayout.Split
            : SpWorkspaceLayout.MaximizeInspector;

        StateHasChanged();
        await Task.Delay(50);
        if (_editor != null)
        {
            try { await _editor.Layout(); } catch { }
        }
    }

    private void ToggleResultSet(int index)
    {
        if (!_collapsedResultSets.Add(index))
        {
            _collapsedResultSets.Remove(index);
        }
    }

    private void CollapseAllResultSets()
    {
        for (int i = 1; i <= CurrentSnapshotResults.Count; i++)
        {
            _collapsedResultSets.Add(i);
        }
    }

    private void ExpandAllResultSets()
    {
        _collapsedResultSets.Clear();
    }

    private void ToggleTempTable(string tableName)
    {
        if (!_collapsedTempTables.Add(tableName))
        {
            _collapsedTempTables.Remove(tableName);
        }
    }

    private void CollapseAllTempTables()
    {
        foreach (var tt in CurrentSnapshotTempTables)
        {
            _collapsedTempTables.Add(tt.Name);
        }
    }

    private void ExpandAllTempTables()
    {
        _collapsedTempTables.Clear();
    }

    private async Task CopyMessagesToClipboard()
    {
        try
        {
            var text = string.Join("\n", CurrentSnapshotMessages);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch { }
    }

    private IEnumerable<SpInfo> FilteredProcedures => SchemaService.StoredProcedures.Where(p =>
    {
        if (string.IsNullOrWhiteSpace(_spFilter)) return true;
        return p.FullName.Contains(_spFilter, StringComparison.OrdinalIgnoreCase) ||
               p.Name.Contains(_spFilter, StringComparison.OrdinalIgnoreCase);
    });

    private Dictionary<string, SpVariableInfo> CurrentSnapshotVariables =>
        _session?.CurrentSnapshot?.Variables ?? new Dictionary<string, SpVariableInfo>(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<SpVariableInfo> FilteredVariables =>
        CurrentSnapshotVariables.Values.Where(v =>
            string.IsNullOrWhiteSpace(_varFilter) ||
            v.Name.Contains(_varFilter, StringComparison.OrdinalIgnoreCase) ||
            v.DataType.Contains(_varFilter, StringComparison.OrdinalIgnoreCase));

    private List<SpTempTableInfo> CurrentSnapshotTempTables =>
        _session?.CurrentSnapshot?.TempTables ?? new List<SpTempTableInfo>();

    private List<SpResultSetInfo> CurrentSnapshotResults =>
        _session?.CurrentSnapshot?.ResultSets ?? new List<SpResultSetInfo>();

    private List<string> CurrentSnapshotMessages =>
        _session?.CurrentSnapshot?.Messages ?? new List<string>();

    private List<string> AllRecordedMessages
    {
        get
        {
            if (_session == null) return new List<string>();
            if (_session.ExecutionMessages.Count > 0) return _session.ExecutionMessages;
            var list = new List<string>();
            foreach (var step in _session.RecordedSteps)
            {
                foreach (var m in step.Messages)
                {
                    if (!list.Contains(m)) list.Add(m);
                }
            }
            return list;
        }
    }

    private string GetDatabaseTooltip()
    {
        var db = !string.IsNullOrEmpty(SchemaService.ActiveDatabase) ? SchemaService.ActiveDatabase : "None";
        var server = ConnectionService.ActiveServer;
        if (!string.IsNullOrEmpty(server))
        {
            return $"Server: {server}\nDatabase: {db}";
        }
        return $"Database: {db}";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!ToolService.IsToolAvailable("sp-debugger"))
        {
            Nav.NavigateTo("tools");
            return;
        }

        ConnectionService.OnDatabaseSwitched += OnDatabaseSwitchedHandler;

        _session = DebuggerService.ActiveSession;
        if (_session != null)
        {
            _selectedSpName = _session.FullName;
            _showSafetyAlert = false;
        }
    }

    private void OnSpFilterInput(ChangeEventArgs e)
    {
        _spFilter = e.Value?.ToString() ?? string.Empty;
        _showSpDropdown = true;
    }

    private void ClearSpFilter()
    {
        _spFilter = string.Empty;
        _showSpDropdown = true;
    }

    private async Task SelectProcedureAsync(SpInfo sp)
    {
        _showSpDropdown = false;
        _showSafetyAlert = false;
        _selectedSpName = sp.FullName;
        _spFilter = sp.FullName;

        ClearSession();

        _isLoadingDef = true;
        StateHasChanged();

        try
        {
            if (!sp.IsDefinitionLoaded)
            {
                await SchemaService.LoadDefinitionAsync(sp.FullName);
            }

            var definition = sp.Definition ?? string.Empty;
            _session = DebuggerService.CreateSession(SchemaService.ActiveDatabase, sp.Schema, sp.Name, definition);

            if (_editor != null && !string.IsNullOrEmpty(definition))
            {
                await _editor.SetValue(definition);
            }

            // Prompt parameter input if required parameters exist
            if (_session.Parameters.Any(p => !p.HasDefault))
            {
                _showParametersModal = true;
            }
        }
        catch (Exception ex)
        {
            if (_session != null)
            {
                _session.ErrorMessage = $"Failed to load procedure: {ex.Message}";
            }
        }
        finally
        {
            _isLoadingDef = false;
            StateHasChanged();
        }
    }

    private async Task EditorOnDidInit()
    {
        try
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initSpDebuggerGutter", "sp-debugger-editor", _dotNetHelper);
            if (_breakpointLines.Count > 0)
            {
                await UpdateBreakpointDecorationsAsync();
            }
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnGutterBreakpointClick(int lineNumber)
    {
        await ToggleBreakpointAsync(lineNumber);
    }

    private async Task ToggleBreakpointAsync(int lineNumber)
    {
        if (_editor == null) return;

        int targetLine = lineNumber;

        // If statements are parsed, snap to the statement's starting line
        if (_session?.Statements.Count > 0)
        {
            var stmt = _session.Statements.FirstOrDefault(s => lineNumber >= s.LineNumber && lineNumber <= (s.EndLineNumber >= s.LineNumber ? s.EndLineNumber : s.LineNumber))
                       ?? _session.Statements.FirstOrDefault(s => s.LineNumber >= lineNumber);
            if (stmt != null)
            {
                targetLine = stmt.LineNumber;
            }
        }

        if (_breakpointLines.Contains(targetLine))
        {
            _breakpointLines.Remove(targetLine);
        }
        else
        {
            _breakpointLines.Add(targetLine);
        }

        await UpdateBreakpointDecorationsAsync();
        StateHasChanged();
    }

    private async Task UpdateBreakpointDecorationsAsync()
    {
        if (_editor == null) return;

        var newDecorations = _breakpointLines.Select(line => new ModelDeltaDecoration
        {
            Range = new BlazorMonaco.Range(line, 1, line, 1),
            Options = new ModelDecorationOptions
            {
                IsWholeLine = false,
                GlyphMarginClassName = "breakpoint-glyph",
                GlyphMarginHoverMessage = new[] { new MarkdownString { Value = $"Breakpoint on Line {line}" } }
            }
        }).ToArray();

        _breakpointDecorationIds = await _editor.DeltaDecorations(_breakpointDecorationIds, newDecorations);
    }

    private async Task ClearAllBreakpointsAsync()
    {
        _breakpointLines.Clear();
        if (_editor != null)
        {
            _breakpointDecorationIds = await _editor.DeltaDecorations(_breakpointDecorationIds, Array.Empty<ModelDeltaDecoration>());
        }
        StateHasChanged();
    }

    private async Task RunOrContinueAsync()
    {
        if (_session == null || _isRecording) return;

        if (!_session.IsRecorded)
        {
            var connStr = ConnectionService.ConnectionString;
            if (string.IsNullOrEmpty(connStr))
            {
                _session.ErrorMessage = "No active database connection string found.";
                return;
            }

            _isRecording = true;
            StateHasChanged();

            try
            {
                var success = await DebuggerService.RecordDebugSessionAsync(connStr, _session);
                if (success)
                {
                    int initialStep = 0;
                    if (_breakpointLines.Count > 0)
                    {
                        int bpStep = FindNextBreakpointStep(-1);
                        if (bpStep != -1)
                        {
                            initialStep = bpStep;
                        }
                    }

                    _session.CurrentStepIndex = initialStep;
                    await HighlightCurrentStepAsync();
                }
            }
            finally
            {
                _isRecording = false;
                StateHasChanged();
            }
        }
        else
        {
            await ContinueToNextBreakpointAsync();
        }
    }

    private int FindNextBreakpointStep(int fromStepIndex)
    {
        if (_session == null || _session.RecordedSteps.Count == 0 || _breakpointLines.Count == 0)
            return -1;

        int startIndex = Math.Max(1, fromStepIndex + 1);
        for (int i = startIndex; i < _session.RecordedSteps.Count; i++)
        {
            var snap = _session.RecordedSteps[i];
            if (snap.StatementType == "COMPLETED") continue;
            int end = snap.EndLineNumber >= snap.LineNumber ? snap.EndLineNumber : snap.LineNumber;
            if (_breakpointLines.Any(b => b >= snap.LineNumber && b <= end))
            {
                return i;
            }
        }
        return -1;
    }

    private async Task ContinueToNextBreakpointAsync()
    {
        if (_session == null || !_session.IsRecorded || _session.IsAtCompletion) return;

        var nextStep = FindNextBreakpointStep(_session.CurrentStepIndex);
        if (nextStep != -1)
        {
            _session.CurrentStepIndex = nextStep;
        }
        else
        {
            _session.CurrentStepIndex = _session.RecordedSteps.Count > 0
                ? _session.RecordedSteps.Count - 1
                : _session.Statements.Count;
        }

        await HighlightCurrentStepAsync();
        StateHasChanged();
    }

    private async Task StepForwardAsync()
    {
        if (_session == null || !_session.IsRecorded) return;

        if (_session.IsAtCompletion)
        {
            if (_session.CallStack.Count > 0)
            {
                await StepOutAsync();
            }
            return;
        }

        _session.CurrentStepIndex++;
        await HighlightCurrentStepAsync();
        StateHasChanged();
    }

    private bool CanStepIntoCurrentStatement
    {
        get
        {
            if (_session == null || !_session.IsRecorded || _session.IsAtCompletion) return false;
            var stmt = _session.CurrentStatement;
            if (stmt == null || !stmt.IsExecCall) return false;

            return SchemaService.StoredProcedures.Any(p =>
                p.Name.Equals(stmt.ExecChildProcedureName, StringComparison.OrdinalIgnoreCase) &&
                (string.IsNullOrEmpty(stmt.ExecChildSchema) || p.Schema.Equals(stmt.ExecChildSchema, StringComparison.OrdinalIgnoreCase)));
        }
    }

    private async Task StepIntoAsync()
    {
        if (_session == null || !CanStepIntoCurrentStatement || _isRecording) return;
        var stmt = _session.CurrentStatement;
        if (stmt == null || !stmt.IsExecCall) return;

        var childSp = SchemaService.StoredProcedures.FirstOrDefault(p =>
            p.Name.Equals(stmt.ExecChildProcedureName, StringComparison.OrdinalIgnoreCase) &&
            (string.IsNullOrEmpty(stmt.ExecChildSchema) || p.Schema.Equals(stmt.ExecChildSchema, StringComparison.OrdinalIgnoreCase)));

        if (childSp == null) return;

        var connStr = ConnectionService.ConnectionString;
        if (string.IsNullOrEmpty(connStr)) return;

        _isRecording = true;
        StateHasChanged();

        try
        {
            if (!childSp.IsDefinitionLoaded)
            {
                await SchemaService.LoadDefinitionAsync(childSp.FullName);
            }

            var childDef = childSp.Definition ?? string.Empty;
            if (string.IsNullOrWhiteSpace(childDef)) return;

            // 1. Save parent frame onto CallStack
            var parentFrame = new SpDebugCallFrame
            {
                ProcedureName = _session.ProcedureName,
                Schema = _session.Schema,
                ProcedureDefinition = _session.ProcedureDefinition,
                Statements = new List<SpStatementStep>(_session.Statements),
                RecordedSteps = new List<SpDebugStepSnapshot>(_session.RecordedSteps),
                StepSnapshots = new Dictionary<int, SpDebugStepSnapshot>(_session.StepSnapshots),
                Parameters = _session.Parameters.Select(p => new SpParameterInput
                {
                    Name = p.Name,
                    DataType = p.DataType,
                    Value = p.Value,
                    IsOutput = p.IsOutput,
                    HasDefault = p.HasDefault,
                    DefaultValue = p.DefaultValue
                }).ToList(),
                BreakpointLines = new HashSet<int>(_breakpointLines),
                CurrentStepIndex = _session.CurrentStepIndex,
                CallingLineNumber = stmt.LineNumber,
                CallingStatementText = stmt.StatementText,
                CallingStatement = stmt
            };
            _session.CallStack.Push(parentFrame);

            // 2. Map parent runtime snapshot variables to child input parameters
            var currentParentVars = _session.CurrentSnapshot?.Variables ?? new Dictionary<string, SpVariableInfo>(StringComparer.OrdinalIgnoreCase);

            // Prepare child session
            _session.ProcedureName = childSp.Name;
            _session.Schema = childSp.Schema;
            _session.ProcedureDefinition = childDef;
            _selectedSpName = childSp.FullName;
            _spFilter = childSp.FullName;
            _session.Statements.Clear();
            _session.RecordedSteps.Clear();
            _session.StepSnapshots.Clear();
            _session.ExecutionMessages.Clear();
            _session.Warnings.Clear();
            _breakpointLines.Clear();

            DebuggerService.ParseAndPrepareSession(_session);

            // Map passed arguments to child parameters
            for (int i = 0; i < _session.Parameters.Count; i++)
            {
                var p = _session.Parameters[i];
                var matchingArg = stmt.ExecChildArgs.FirstOrDefault(a =>
                    !string.IsNullOrEmpty(a.ParameterName) &&
                    a.ParameterName.TrimStart('@').Equals(p.Name.TrimStart('@'), StringComparison.OrdinalIgnoreCase));

                if (matchingArg == null && i < stmt.ExecChildArgs.Count && string.IsNullOrEmpty(stmt.ExecChildArgs[i].ParameterName))
                {
                    matchingArg = stmt.ExecChildArgs[i];
                }

                if (matchingArg != null)
                {
                    var rawExpr = matchingArg.ExpressionText?.Trim() ?? "";
                    if (rawExpr.StartsWith("@") && currentParentVars.TryGetValue(rawExpr, out var parentVar))
                    {
                        p.Value = parentVar.Value;
                    }
                    else if (!string.IsNullOrEmpty(rawExpr))
                    {
                        p.Value = rawExpr.Trim('\'');
                    }
                }
            }

            // 3. Record debug session for child SP
            var success = await DebuggerService.RecordDebugSessionAsync(connStr, _session);
            if (success && _editor != null)
            {
                await _editor.SetValue(childDef);
                _stepDecorationIds = await _editor.DeltaDecorations(_stepDecorationIds, Array.Empty<ModelDeltaDecoration>());
                _breakpointDecorationIds = await _editor.DeltaDecorations(_breakpointDecorationIds, Array.Empty<ModelDeltaDecoration>());
                _session.CurrentStepIndex = Math.Min(1, _session.RecordedSteps.Count - 1);
                await HighlightCurrentStepAsync();
            }
        }
        catch (Exception ex)
        {
            _session.ErrorMessage = $"Failed to step into procedure: {ex.Message}";
        }
        finally
        {
            _isRecording = false;
            StateHasChanged();
        }
    }

    private async Task StepOutToFrameAsync(SpDebugCallFrame targetFrame)
    {
        while (_session?.CallStack.Count > 0)
        {
            var topFrame = _session.CallStack.Peek();
            await StepOutAsync();
            if (topFrame == targetFrame)
            {
                break;
            }
        }
    }

    private async Task StepOutAsync()
    {
        if (_session == null || _session.CallStack.Count == 0 || _isRecording) return;

        _isRecording = true;
        StateHasChanged();

        try
        {
            // 1. Sync child output parameters back to parent
            var childFinalSnapshot = _session.RecordedSteps.Count > 0 ? _session.RecordedSteps[^1] : null;
            var childParams = _session.Parameters.ToList();
            var parentFrame = _session.CallStack.Pop();

            if (childFinalSnapshot != null && parentFrame.CallingStatement != null)
            {
                for (int argIdx = 0; argIdx < parentFrame.CallingStatement.ExecChildArgs.Count; argIdx++)
                {
                    var arg = parentFrame.CallingStatement.ExecChildArgs[argIdx];
                    if (!arg.IsOutput) continue;

                    string? childVarName = arg.ParameterName;
                    if (string.IsNullOrEmpty(childVarName) && argIdx < childParams.Count)
                    {
                        childVarName = childParams[argIdx].Name;
                    }

                    if (!string.IsNullOrEmpty(childVarName))
                    {
                        if (!childVarName.StartsWith("@")) childVarName = "@" + childVarName;

                        if (childFinalSnapshot.Variables.TryGetValue(childVarName, out var childOutputVar))
                        {
                            var parentTargetVar = arg.ExpressionText?.Trim() ?? "";
                            for (int stepIdx = Math.Max(0, parentFrame.CurrentStepIndex); stepIdx < parentFrame.RecordedSteps.Count; stepIdx++)
                            {
                                if (parentFrame.RecordedSteps[stepIdx].Variables.TryGetValue(parentTargetVar, out var parentVar))
                                {
                                    parentVar.Value = childOutputVar.Value;
                                }
                            }
                        }
                    }
                }
            }

            // 2. Restore parent state
            _session.ProcedureName = parentFrame.ProcedureName;
            _session.Schema = parentFrame.Schema;
            _session.ProcedureDefinition = parentFrame.ProcedureDefinition;
            _session.Statements = parentFrame.Statements;
            _session.RecordedSteps = parentFrame.RecordedSteps;
            _session.StepSnapshots = parentFrame.StepSnapshots;
            _session.Parameters = parentFrame.Parameters;
            _breakpointLines = parentFrame.BreakpointLines;
            _selectedSpName = parentFrame.FullName;
            _spFilter = parentFrame.FullName;

            // Advance to the step right after the EXEC call in the parent
            _session.CurrentStepIndex = Math.Min(parentFrame.CurrentStepIndex + 1, _session.RecordedSteps.Count - 1);

            // 3. Update editor
            if (_editor != null)
            {
                await _editor.SetValue(parentFrame.ProcedureDefinition);
                await UpdateBreakpointDecorationsAsync();
                await HighlightCurrentStepAsync();
            }
        }
        catch (Exception ex)
        {
            _session.ErrorMessage = $"Failed to step out: {ex.Message}";
        }
        finally
        {
            _isRecording = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "F10")
        {
            await StepForwardAsync();
        }
        else if (e.Key == "F11")
        {
            if (e.ShiftKey)
            {
                await StepOutAsync();
            }
            else if (CanStepIntoCurrentStatement)
            {
                await StepIntoAsync();
            }
        }
        else if (e.Key == "F9")
        {
            await StepBack();
        }
        else if (e.Key == "F5")
        {
            if (e.ShiftKey)
            {
                await StopDebuggingAsync();
            }
            else
            {
                await RunOrContinueAsync();
            }
        }
        else if (e.Key == "Escape" && _workspaceLayout != SpWorkspaceLayout.Split)
        {
            _workspaceLayout = SpWorkspaceLayout.Split;
            StateHasChanged();
            await Task.Delay(50);
            if (_editor != null)
            {
                try { await _editor.Layout(); } catch { }
            }
        }
    }

    private async Task StopDebuggingAsync()
    {
        if (_session == null) return;

        // If stopped while inside a nested procedure, restore the root parent frame
        while (_session.CallStack.Count > 0)
        {
            var rootFrame = _session.CallStack.Pop();
            _session.ProcedureName = rootFrame.ProcedureName;
            _session.Schema = rootFrame.Schema;
            _session.ProcedureDefinition = rootFrame.ProcedureDefinition;
            _session.Statements = rootFrame.Statements;
            _session.Parameters = rootFrame.Parameters;
            _breakpointLines = rootFrame.BreakpointLines;
            _selectedSpName = rootFrame.FullName;
            _spFilter = rootFrame.FullName;
        }

        _session.IsRecorded = false;
        _session.RecordedSteps.Clear();
        _session.StepSnapshots.Clear();
        _session.ExecutionMessages.Clear();
        _session.CurrentStepIndex = -1;
        _session.TotalServerExecutionMs = 0;

        if (_editor != null)
        {
            await _editor.SetValue(_session.ProcedureDefinition);
            _stepDecorationIds = await _editor.DeltaDecorations(_stepDecorationIds, Array.Empty<ModelDeltaDecoration>());
            await UpdateBreakpointDecorationsAsync();
        }

        _collapsedResultSets.Clear();
        _collapsedTempTables.Clear();
        _activeInspectorTab = "Variables";
        StateHasChanged();
    }

    private async Task ClearProcedureAsync()
    {
        ClearSession();
        _selectedSpName = string.Empty;
        _spFilter = string.Empty;
        if (_editor != null)
        {
            _stepDecorationIds = await _editor.DeltaDecorations(_stepDecorationIds, Array.Empty<ModelDeltaDecoration>());
            _breakpointDecorationIds = await _editor.DeltaDecorations(_breakpointDecorationIds, Array.Empty<ModelDeltaDecoration>());
            await _editor.SetValue(string.Empty);
        }
        StateHasChanged();
    }

    private async Task StepBack()
    {
        if (_session == null || !_session.IsRecorded || _session.CurrentStepIndex <= 0) return;

        _session.CurrentStepIndex--;
        await HighlightCurrentStepAsync();
        StateHasChanged();
    }

    private async Task ResetToFirstStepAsync()
    {
        if (_session == null || !_session.IsRecorded) return;

        _session.CurrentStepIndex = 0;
        await HighlightCurrentStepAsync();
        StateHasChanged();
    }

    private void ClearSession()
    {
        _session?.ClearMemory();
        DebuggerService.DisposeActiveSession();
        _session = null;
        _stepDecorationIds = Array.Empty<string>();
        _breakpointDecorationIds = Array.Empty<string>();
        _breakpointLines.Clear();
        _collapsedResultSets.Clear();
        _collapsedTempTables.Clear();
        _showWarningsBanner = true;
        _workspaceLayout = SpWorkspaceLayout.Split;
        StateHasChanged();
    }

    private async Task HighlightCurrentStepAsync()
    {
        if (_editor == null || _session == null) return;

        var stmt = _session.CurrentStatement;
        if (stmt == null)
        {
            _stepDecorationIds = await _editor.DeltaDecorations(_stepDecorationIds, Array.Empty<ModelDeltaDecoration>());
            return;
        }

        var startLine = stmt.LineNumber > 0 ? stmt.LineNumber : 1;
        var endLine = stmt.EndLineNumber >= startLine ? stmt.EndLineNumber : startLine;

        var newDecorations = new[]
        {
            new ModelDeltaDecoration
            {
                Range = new BlazorMonaco.Range(startLine, 1, endLine, 1),
                Options = new ModelDecorationOptions
                {
                    IsWholeLine = true,
                    ClassName = "active-statement-highlight",
                    MarginClassName = "active-statement-gutter",
                    GlyphMarginClassName = "active-statement-glyph"
                }
            }
        };

        _stepDecorationIds = await _editor.DeltaDecorations(_stepDecorationIds, newDecorations);
        await _editor.RevealLineInCenter(startLine);
    }

    private void OpenParametersModal()
    {
        _showParametersModal = true;
    }

    private void ResetParamDefaults()
    {
        if (_session == null) return;
        foreach (var p in _session.Parameters)
        {
            p.Value = p.DefaultValue;
        }
    }

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "sql",
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            Value = _session?.ProcedureDefinition ?? "",
            AutomaticLayout = true,
            ReadOnly = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            FontSize = 13,
            GlyphMargin = true
        };
    }

    private void OnDatabaseSwitchedHandler()
    {
        InvokeAsync(() =>
        {
            ClearSession();
            _selectedSpName = string.Empty;
            _spFilter = string.Empty;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ConnectionService.OnDatabaseSwitched -= OnDatabaseSwitchedHandler;

        _dotNetHelper?.Dispose();
        _dotNetHelper = null;

        // Guaranteed memory cleanup to ensure 0 MB memory leak
        _session?.ClearMemory();
        DebuggerService.DisposeActiveSession();
        _session = null;
        _editor?.Dispose();
        GC.Collect();
    }
}