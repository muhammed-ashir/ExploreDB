@page "/tools/sp-debugger"
@using ExploreDB.Services
@using ExploreDB.Services.SpDebugger
@using BlazorMonaco
@using BlazorMonaco.Editor
@inject SpDebuggerService DebuggerService
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject ToolRegistryService ToolService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ThemeService ThemeService
@implements IDisposable

<div class="container-fluid d-flex flex-column h-100 pb-3 sp-debugger-container" style="color: var(--app-text); min-height: 0; outline: none;" tabindex="0" @onkeydown="HandleKeyDown">
    <!-- TOP TOOLBAR -->
    <div class="d-flex align-items-center justify-content-between py-2 flex-wrap gap-2 border-bottom" style="border-color: var(--app-border) !important;">
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0" style="font-size: 1.15rem; line-height: 1.2;">SP Debugger</h4>
        </div>

        <!-- Action & Navigation Controls (Visual Studio Style Hybrid) -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (_session != null && _session.Statements.Count > 0)
            {
                <!-- Run / Continue / Re-run (F5) -->
                <button class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 shadow-sm px-2.5"
                        @onclick="RunOrContinueAsync"
                        disabled="@(_isRecording || _isLoadingDef)"
                        title="@(_session.IsRecorded ? (_session.IsAtCompletion && _session.CallStack.Count == 0 ? "Re-run procedure from start (F5)" : "Continue to next breakpoint (F5)") : "Run / Start Debugging (F5)")">
                    @if (_isRecording)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Running...</span>
                    }
                    else if (_session.IsRecorded)
                    {
                        if (_session.IsAtCompletion && _session.CallStack.Count == 0)
                        {
                            <i class="bi bi-arrow-repeat fs-6"></i>
                            <span>Re-run</span>
                        }
                        else
                        {
                            <i class="bi bi-play-fill fs-6"></i>
                            <span>Continue</span>
                        }
                    }
                    else
                    {
                        <i class="bi bi-play-fill fs-6"></i>
                        <span>Run</span>
                    }
                </button>

                @if (_session.IsRecorded && !(_session.IsAtCompletion && _session.CallStack.Count == 0))
                {
                    <!-- Stepping Controls (F10 Step, F11 Step Into, F9 Back, Restart) -->
                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                        <button class="btn btn-outline-primary d-inline-flex align-items-center gap-1"
                                @onclick="StepForwardAsync"
                                disabled="@((_session.IsAtCompletion && _session.CallStack.Count == 0) || _isRecording)"
                                title="@(_session.CallStack.Count > 0 && _session.IsAtCompletion ? "Step Out to Caller (F10 / Shift+F11)" : "Step Over / Next statement (F10)")">
                            <i class="bi bi-arrow-right"></i>
                            <span>Step (F10)</span>
                        </button>
                        <button class="btn btn-outline-primary d-inline-flex align-items-center gap-1"
                                @onclick="StepIntoAsync"
                                disabled="@(!CanStepIntoCurrentStatement || _isRecording)"
                                title="@(CanStepIntoCurrentStatement ? $"Step Into {_session.CurrentStatement?.ExecChildProcedureName} (F11)" : "Step Into (F11) - Available when paused on an EXEC statement")">
                            <i class="bi bi-box-arrow-in-down-right"></i>
                            <span>Step Into (F11)</span>
                        </button>
                        <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1"
                                @onclick="StepBack"
                                disabled="@(_session.CurrentStepIndex <= 0 || _isRecording)"
                                title="Step Back / Previous statement (F9)">
                            <i class="bi bi-arrow-left"></i>
                            <span>Back (F9)</span>
                        </button>
                        <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-1"
                                @onclick="ResetToFirstStepAsync"
                                disabled="@(_session.CurrentStepIndex == 0 || _isRecording)"
                                title="Restart Debugging / Rewind to Statement 1">
                            <i class="bi bi-arrow-clockwise"></i>
                            <span>Restart</span>
                        </button>
                    </div>

                    <!-- Stop Debugging (Shift+F5) -->
                    <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm px-2.5"
                            @onclick="StopDebuggingAsync"
                            title="Stop Debugging (Shift+F5)">
                        <i class="bi bi-stop-fill"></i>
                        <span>Stop</span>
                    </button>
                }

                <!-- Clear Procedure -->
                <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm px-2.5"
                        @onclick="ClearProcedureAsync"
                        disabled="@_isRecording"
                        title="Clear selected procedure and reset workspace">
                    <span>Clear</span>
                </button>
            }

            @if (!IsPopout)
            {
                <a href="tools" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm ms-2">
                    <i class="bi bi-arrow-left"></i>
                    <span>Tools Hub</span>
                </a>
            }
        </div>
    </div>

    <!-- SELECTION BAR: Target Database & Stored Procedure Picker -->
    <div class="row g-2 align-items-center py-2 px-1">
        <!-- Server Dropdown -->
        <div class="col-auto">
            <div class="position-relative" style="width: 195px;">
                <input class="form-control form-control-sm pe-4 text-truncate"
                       value="@(IsDebuggerLocked ? GetSelectedServerDisplayName() : (_isServerDropdownOpen ? _serverSearch : GetSelectedServerDisplayName()))"
                       @oninput="@((ChangeEventArgs e) => _serverSearch = e.Value?.ToString() ?? "")"
                       placeholder="Search connection..."
                       @onfocus="OpenServerDropdown"
                       disabled="@IsDebuggerLocked"
                       data-bs-tooltip="true"
                       data-bs-placement="bottom"
                       data-bs-title="@GetSelectedServerDisplayName()"
                       style="cursor: @(IsDebuggerLocked ? "not-allowed" : "pointer"); font-size: 0.82rem; height: 30px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />

                @if (_isServerDropdownOpen && !IsDebuggerLocked)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseServerDropdown"></div>
                    <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 220px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                        @{
                            var filteredConns = _availableConnections.Where(c =>
                                string.IsNullOrWhiteSpace(_serverSearch) ||
                                (c.Name ?? "").Contains(_serverSearch, StringComparison.OrdinalIgnoreCase) ||
                                (c.Server ?? "").Contains(_serverSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                            if (filteredConns.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var c in filteredConns)
                                    {
                                        string displayName = GetConnectionOptionLabel(c);
                                        <button type="button" class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate"
                                                style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.82rem; background-color: transparent; color: var(--app-text);"
                                                data-bs-tooltip="true"
                                                data-bs-placement="right"
                                                data-bs-title="@displayName"
                                                @onclick="() => OnServerSelectedAsync(c.ConnectionString)">
                                            @displayName
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-2 text-muted small text-center" style="font-size: 0.8rem;">No connections found</div>
                            }
                        }
                    </div>
                }

                <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                    @if (IsDebuggerLocked)
                    {
                        <i class="bi bi-lock-fill text-muted" style="font-size: 0.75rem;"></i>
                    }
                    else
                    {
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                    }
                </div>
            </div>
        </div>

        <!-- Database Dropdown -->
        <div class="col-auto">
            <div class="position-relative" style="width: 185px;">
                <input class="form-control form-control-sm pe-4 text-truncate"
                       value="@(IsDebuggerLocked ? GetSelectedDatabaseDisplayName() : (_isDatabaseDropdownOpen ? _databaseSearch : GetSelectedDatabaseDisplayName()))"
                       @oninput="@((ChangeEventArgs e) => _databaseSearch = e.Value?.ToString() ?? "")"
                       placeholder="Search database..."
                       @onfocus="OpenDatabaseDropdown"
                       disabled="@IsDebuggerLocked"
                       data-bs-tooltip="true"
                       data-bs-placement="bottom"
                       data-bs-title="@(string.IsNullOrEmpty(GetSelectedDatabaseDisplayName()) ? "Search database..." : GetSelectedDatabaseDisplayName())"
                       style="cursor: @(IsDebuggerLocked ? "not-allowed" : "pointer"); font-size: 0.82rem; height: 30px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />

                @if (_isDatabaseDropdownOpen && !IsDebuggerLocked)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseDatabaseDropdown"></div>
                    <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 220px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                        @if (_isLoadingDatabases)
                        {
                            <div class="p-3 text-center text-info">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <small>Loading databases...</small>
                            </div>
                        }
                        else if (_availableDatabases.Any())
                        {
                            var filteredDbs = _availableDatabases.Where(d =>
                                string.IsNullOrWhiteSpace(_databaseSearch) ||
                                d.Contains(_databaseSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                            if (filteredDbs.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var db in filteredDbs)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate"
                                                style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.82rem; background-color: transparent; color: var(--app-text);"
                                                data-bs-tooltip="true"
                                                data-bs-placement="right"
                                                data-bs-title="@db"
                                                @onclick="() => OnDatabaseSelectedAsync(db)">
                                            @db
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-2 text-muted small text-center" style="font-size: 0.8rem;">No databases found</div>
                            }
                        }
                        else
                        {
                            <div class="p-2 text-muted small text-center" style="font-size: 0.8rem;">No databases available</div>
                        }
                    </div>
                }

                <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                    @if (IsDebuggerLocked)
                    {
                        <i class="bi bi-lock-fill text-muted" style="font-size: 0.75rem;"></i>
                    }
                    else if (_isLoadingDatabases)
                    {
                        <span class="spinner-border spinner-border-sm text-info" style="width: 0.75rem; height: 0.75rem;"></span>
                    }
                    else
                    {
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                    }
                </div>
            </div>
        </div>

        <!-- Procedure Filter / Autocomplete Dropdown -->
        <div class="col-12 col-sm-6 col-md-5 col-lg-4 position-relative">
            <div class="input-group input-group-sm">
                <span class="input-group-text border-end-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);">
                    @if (_isLoadingProcedures)
                    {
                        <span class="spinner-border spinner-border-sm text-primary" style="width: 0.85rem; height: 0.85rem;"></span>
                    }
                    else
                    {
                        <i class="bi bi-gear-wide-connected"></i>
                    }
                </span>
                <input type="text"
                       class="form-control form-control-sm shadow-none border-start-0 @(!string.IsNullOrEmpty(_spFilter) ? "border-end-0" : "")"
                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border); cursor: @(IsDebuggerLocked ? "not-allowed" : "text");"
                       placeholder="@(_isLoadingProcedures ? "Loading stored procedures..." : "Select or filter stored procedure...")"
                       value="@_spFilter"
                       disabled="@IsDebuggerLocked"
                       @oninput="OnSpFilterInput"
                       @onfocus="() => { if (!IsDebuggerLocked) _showSpDropdown = true; }" />
                @if (!string.IsNullOrEmpty(_spFilter) && !IsDebuggerLocked)
                {
                    <button class="btn btn-outline-secondary border-start-0"
                            style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);"
                            @onclick="ClearSpFilter">
                        <i class="bi bi-x"></i>
                    </button>
                }
                <button class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split"
                        disabled="@IsDebuggerLocked"
                        style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);"
                        @onclick="() => { if (!IsDebuggerLocked) _showSpDropdown = !_showSpDropdown; }">
                </button>
            </div>

            <!-- SP Dropdown Menu -->
            @if (_showSpDropdown && !IsDebuggerLocked)
            {
                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => _showSpDropdown = false"></div>
                <div class="dropdown-menu show shadow-lg w-100 mt-1 py-1"
                     style="position: absolute; top: 100%; left: 0; max-height: 320px; overflow-y: auto; background-color: var(--app-dropdown-bg); border: 1px solid var(--app-border); z-index: 1050;">
                    @if (_isLoadingProcedures)
                    {
                        <div class="p-3 text-center text-info">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <small>Loading stored procedures...</small>
                        </div>
                    }
                    else if (FilteredProcedures.Any())
                    {
                        @foreach (var sp in FilteredProcedures)
                        {
                            <button type="button"
                                    class="dropdown-item py-1 px-3 text-truncate @(sp.FullName.Equals(_selectedSpName, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                    style="font-size: 0.85rem; color: var(--app-text);"
                                    @onclick="() => SelectProcedureAsync(sp)">
                                <strong class="text-muted">@sp.Schema.</strong>@sp.Name
                            </button>
                        }
                    }
                    else
                    {
                        <div class="px-3 py-2 text-muted small">No procedures found matching "@_spFilter"</div>
                    }
                </div>
            }
        </div>

        <!-- Parameters & Clear Buttons (beside SP selector) -->
        @if (_session != null && _session.Statements.Count > 0)
        {
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm"
                        @onclick="OpenParametersModal"
                        title="Configure input parameters for this stored procedure">
                    <i class="bi bi-sliders"></i>
                    <span>Parameters @(_session.Parameters.Count > 0 ? $"({_session.Parameters.Count})" : "")</span>
                </button>
            </div>

            <!-- Right-Aligned Actions: Breakpoints -->
            @if (_breakpointLines.Count > 0)
            {
                <div class="col-auto ms-auto d-flex align-items-center gap-2">
                    <div class="d-inline-flex align-items-center rounded shadow-sm"
                         style="background-color: var(--app-input-bg); border: 1px solid var(--app-border); height: 31px; font-size: 0.82rem; padding: 0 9px; gap: 6px;">
                        <span class="rounded-circle flex-shrink-0"
                              style="width: 8px; height: 8px; background-color: #ef4444; box-shadow: 0 0 4px rgba(239, 68, 68, 0.5); display: inline-block;"></span>
                        <span class="fw-medium user-select-none" style="color: var(--app-text); cursor: default;">
                            @(_breakpointLines.Count) Breakpoint@(_breakpointLines.Count > 1 ? "s" : "")
                        </span>
                        <button type="button"
                                class="btn btn-link p-0 text-muted d-inline-flex align-items-center justify-content-center"
                                style="width: 18px; height: 18px; text-decoration: none; border-radius: 3px;"
                                onmouseover="this.style.color='#ef4444'; this.style.backgroundColor='rgba(220, 53, 69, 0.15)';"
                                onmouseout="this.style.color=''; this.style.backgroundColor='transparent';"
                                @onclick="ClearAllBreakpointsAsync"
                                title="Clear all breakpoints">
                            <i class="bi bi-x" style="font-size: 1.1rem; line-height: 1;"></i>
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    <!-- SAFETY & HOW-IT-WORKS NOTICE BANNER -->
    @if (_showSafetyAlert)
    {
        <div class="alert py-2 px-3 my-2 mb-1 shadow-sm border"
             role="alert"
             style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important; color: var(--app-text); font-size: 0.85rem;">
            <!-- First Line: Safety Icon + Heading + Close Icon -->
            <div class="d-flex align-items-center justify-content-between mb-1">
                <div class="d-flex align-items-center gap-2 fw-semibold" style="color: var(--app-text);">
                    <i class="bi bi-shield-check text-success fs-6"></i>
                    <span>Safe Dry-Run Debugging (Zero Database Locks)</span>
                </div>
                <button type="button"
                        class="btn-close shadow-none"
                        style="font-size: 0.68rem; padding: 0.2rem; margin: 0;"
                        @onclick="() => _showSafetyAlert = false"
                        aria-label="Close"></button>
            </div>
            <!-- Second Line: Details Description -->
            <div class="text-muted small ps-4" style="line-height: 1.45;">
                Runs the procedure in an isolated transaction that is <strong>always rolled back</strong> in milliseconds—your tables are <strong>never modified</strong> and all database locks are <strong>immediately released</strong>. All step-by-step debugging, variable diffs, temp tables, and result sets then operate entirely offline on the captured local memory snapshot with zero connection or lock overhead.
            </div>
        </div>
    }

    <!-- ERROR BANNER -->
    @if (!string.IsNullOrEmpty(_session?.ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between py-2 px-3 my-2 mb-0 shadow-sm" role="alert" style="font-size: 0.85rem;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Debug Notice:</strong> @_session.ErrorMessage
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => _session.ErrorMessage = null"></button>
        </div>
    }

    <!-- PRE-FLIGHT WARNINGS BANNER -->
    @if (_session != null && _session.Warnings.Count > 0 && _showWarningsBanner)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between py-2 px-3 my-2 mb-0 shadow-sm" role="alert" style="font-size: 0.85rem;">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-shield-exclamation fs-5 text-warning"></i>
                <div>
                    <strong>Pre-flight Safety Notice:</strong>
                    @foreach (var w in _session.Warnings)
                    {
                        <div class="small">
                            • Line @w.LineNumber: @w.Message
                        </div>
                    }
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => _showWarningsBanner = false"></button>
        </div>
    }

    <!-- MAIN DEBUGGER WORKSPACE (SPLIT LAYOUT) -->
    <div class="row g-2 flex-grow-1 mt-1 overflow-hidden" style="min-height: 400px;">
        <!-- LEFT COLUMN: MONACO CODE VIEWER -->
        <div class="@CodeColumnClass">
            <div class="card h-100 d-flex flex-column shadow-sm overflow-hidden"
                 style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                <!-- Code Header & Call Stack Breadcrumb -->
                <div class="card-header py-2 px-3 d-flex align-items-center justify-content-between"
                     style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border);">
                    <div class="d-flex align-items-center gap-1.5 text-truncate flex-grow-1 me-2">
                        @if (_session?.CallStack.Count > 0)
                        {
                            <span class="text-muted small d-inline-flex align-items-center gap-1 me-1" title="Active Call Stack">
                                <i class="bi bi-layers text-primary"></i>
                            </span>
                            @foreach (var frame in _session.CallStack.Reverse())
                            {
                                <button type="button"
                                        class="btn btn-sm btn-link p-0 text-decoration-none badge border py-1 px-2 font-monospace"
                                        style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-border) !important; font-size: 0.76rem;"
                                        @onclick="() => StepOutToFrameAsync(frame)"
                                        title="Step Out to @frame.FullName (Line @frame.CallingLineNumber)">
                                    @frame.FullName (@frame.CallingLineNumber)
                                </button>
                                <i class="bi bi-chevron-right text-muted" style="font-size: 0.65rem;"></i>
                            }
                        }
                        <span class="fw-semibold small text-truncate" style="color: var(--app-text);" title="@(!string.IsNullOrEmpty(_session?.FullName) ? _session.FullName : (!string.IsNullOrEmpty(_selectedSpName) ? _selectedSpName : "Procedure"))">
                            <i class="bi bi-code-slash me-1 text-primary"></i>@(!string.IsNullOrEmpty(_session?.FullName) ? _session.FullName : (!string.IsNullOrEmpty(_selectedSpName) ? _selectedSpName : "Procedure"))
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (_session?.CallStack.Count > 0)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary py-0 px-2 d-inline-flex align-items-center gap-1 shadow-sm"
                                    style="font-size: 0.75rem; height: 26px;"
                                    @onclick="StepOutAsync"
                                    title="Step Out to caller procedure (Shift+F11)">
                                <i class="bi bi-box-arrow-up-left"></i>
                                <span>Step Out (Shift+F11)</span>
                            </button>
                        }

                        <button type="button"
                                class="btn btn-sm btn-link text-muted p-0 d-inline-flex align-items-center justify-content-center"
                                style="width: 26px; height: 26px; text-decoration: none; border-radius: 4px;"
                                @onclick="ToggleMaximizeCodeAsync"
                                title="@(_workspaceLayout == SpWorkspaceLayout.MaximizeCode ? "Restore Split View (Esc)" : "Maximize Code View")">
                            <i class="bi @(_workspaceLayout == SpWorkspaceLayout.MaximizeCode ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")" style="font-size: 0.85rem;"></i>
                        </button>
                    </div>
                </div>

                <!-- Monaco Editor Body -->
                <div class="card-body p-0 flex-grow-1 position-relative" style="min-height: 350px;">
                    @if (_isLoadingDef)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5">
                            <div class="spinner-border text-primary mb-2" role="status"></div>
                            <span class="text-muted small">Loading procedure definition and parsing AST...</span>
                        </div>
                    }
                    else if (string.IsNullOrEmpty(_selectedSpName))
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 p-5 text-center">
                            <i class="bi bi-bug text-muted" style="font-size: 3rem; opacity: 0.5;"></i>
                            <h5 class="fw-bold text-muted mt-3 mb-1">Select a Stored Procedure</h5>
                            <p class="text-muted small mb-0" style="max-width: 420px;">
                                Pick a procedure from the dropdown above to inspect statements, examine variables, and trace temp tables safely with automated rollback.
                            </p>
                        </div>
                    }
                    else
                    {
                        <StandaloneCodeEditor @ref="_editor"
                                              Id="sp-debugger-editor"
                                              CssClass="w-100 h-100"
                                              ConstructionOptions="EditorOptions"
                                              OnDidInit="EditorOnDidInit" />
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: STATE INSPECTOR (TABS) -->
        <div class="@InspectorColumnClass">
            <div class="card h-100 d-flex flex-column shadow-sm overflow-hidden"
                 style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                <!-- Inspector Tab Header -->
                <div class="card-header p-0 d-flex align-items-center justify-content-between" style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border);">
                    <ul class="nav nav-tabs border-0 px-2 pt-1 flex-grow-1" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeInspectorTab == "Variables" ? "active fw-semibold" : "text-muted")"
                                    style="padding: 0.28rem 0.65rem; font-size: 0.8rem; @(_activeInspectorTab == "Variables" ? "background-color: var(--app-surface); border-color: var(--app-border) var(--app-border) var(--app-surface); color: var(--app-text);" : "")"
                                    @onclick='() => _activeInspectorTab = "Variables"'>
                                Variables
                                @if (CurrentSnapshotVariables.Count > 0)
                                {
                                    <span class="badge bg-secondary-subtle text-muted ms-1" style="font-size: 0.65rem; padding: 0.15em 0.4em;">
                                        @CurrentSnapshotVariables.Count
                                    </span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeInspectorTab == "TempTables" ? "active fw-semibold" : "text-muted")"
                                    style="padding: 0.28rem 0.65rem; font-size: 0.8rem; @(_activeInspectorTab == "TempTables" ? "background-color: var(--app-surface); border-color: var(--app-border) var(--app-border) var(--app-surface); color: var(--app-text);" : "")"
                                    @onclick='() => _activeInspectorTab = "TempTables"'>
                                Tables (# / @@)
                                @if (CurrentSnapshotTempTables.Count > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning ms-1" style="font-size: 0.65rem; padding: 0.15em 0.4em;">
                                        @CurrentSnapshotTempTables.Count
                                    </span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeInspectorTab == "Results" ? "active fw-semibold" : "text-muted")"
                                    style="padding: 0.28rem 0.65rem; font-size: 0.8rem; @(_activeInspectorTab == "Results" ? "background-color: var(--app-surface); border-color: var(--app-border) var(--app-border) var(--app-surface); color: var(--app-text);" : "")"
                                    @onclick='() => _activeInspectorTab = "Results"'>
                                Results
                                @if (CurrentSnapshotResults.Count > 0)
                                {
                                    <span class="badge bg-success-subtle text-success ms-1" style="font-size: 0.65rem; padding: 0.15em 0.4em;">
                                        @CurrentSnapshotResults.Count
                                    </span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(_activeInspectorTab == "Messages" ? "active fw-semibold" : "text-muted")"
                                    style="padding: 0.28rem 0.65rem; font-size: 0.8rem; @(_activeInspectorTab == "Messages" ? "background-color: var(--app-surface); border-color: var(--app-border) var(--app-border) var(--app-surface); color: var(--app-text);" : "")"
                                    @onclick='() => _activeInspectorTab = "Messages"'>
                                Messages
                                @if (CurrentSnapshotMessages.Count > 0)
                                {
                                    <span class="badge bg-info-subtle text-info ms-1" style="font-size: 0.65rem; padding: 0.15em 0.4em;">
                                        @CurrentSnapshotMessages.Count
                                    </span>
                                }
                            </button>
                        </li>
                    </ul>
                    <div class="pe-2 py-1">
                        <button type="button"
                                class="btn btn-sm btn-link text-muted p-0 d-inline-flex align-items-center justify-content-center"
                                style="width: 26px; height: 26px; text-decoration: none; border-radius: 4px;"
                                @onclick="ToggleMaximizeInspectorAsync"
                                title="@(_workspaceLayout == SpWorkspaceLayout.MaximizeInspector ? "Restore Split View (Esc)" : "Maximize Inspector View")">
                            <i class="bi @(_workspaceLayout == SpWorkspaceLayout.MaximizeInspector ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")" style="font-size: 0.85rem;"></i>
                        </button>
                    </div>
                </div>

                <!-- Inspector Tab Content Body -->
                <div class="card-body p-0 flex-grow-1 overflow-auto position-relative" style="background-color: var(--app-surface);">
                    @if (_session == null || !_session.IsRecorded)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4 text-center">
                            <i class="bi bi-play-circle text-muted" style="font-size: 2.2rem; opacity: 0.6;"></i>
                            <h6 class="fw-bold text-muted mt-3 mb-1">Click [Run] to Start</h6>
                            <p class="text-muted small mb-0" style="max-width: 320px;">
                                ExploreDB will run the procedure in a rollback transaction (under 500ms) and capture all variable states and temp tables for instant stepping.
                            </p>
                        </div>
                    }
                    else if (_activeInspectorTab == "Variables")
                    {
                        <!-- VARIABLES TAB -->
                        <div class="d-flex flex-column h-100">
                            <!-- Variables Search Filter -->
                            <div class="p-2 border-bottom" style="border-color: var(--app-border) !important; background-color: var(--app-surface-secondary);">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text border-end-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control form-control-sm shadow-none border-start-0"
                                           style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                           placeholder="Filter variables..."
                                           @bind="_varFilter"
                                           @bind:event="oninput" />
                                </div>
                            </div>

                            <!-- Variables Table -->
                            <div class="table-responsive flex-grow-1 m-0">
                                <table class="table table-sm table-hover mb-0" style="font-size: 0.82rem; color: var(--app-text);">
                                    <thead class="sticky-top" style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border);">
                                        <tr>
                                            <th class="ps-3 py-2" style="width: 38%;">Variable</th>
                                            <th class="py-2" style="width: 24%;">Type</th>
                                            <th class="pe-3 py-2" style="width: 38%;">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (FilteredVariables.Any())
                                        {
                                            @foreach (var v in FilteredVariables)
                                            {
                                                <tr class="@(v.HasChanged ? "var-changed-row" : "")">
                                                    <td class="ps-3 py-2 font-monospace fw-semibold" style="@(v.HasChanged ? "color: #f59e0b !important;" : "color: var(--app-text);")">
                                                        @v.Name
                                                        @if (v.IsParameter)
                                                        {
                                                            if (v.IsOutput)
                                                            {
                                                                <span class="badge bg-info-subtle text-info ms-1" style="font-size: 0.65rem;">OUTPUT</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary-subtle text-muted ms-1" style="font-size: 0.65rem;">PARAM</span>
                                                            }
                                                        }
                                                    </td>
                                                    <td class="py-2 text-muted font-monospace">@v.DataType</td>
                                                    <td class="pe-3 py-2 font-monospace @(v.HasChanged ? "fw-bold text-warning" : "")" style="word-break: break-all;">
                                                        @(v.Value ?? "NULL")
                                                        @if (v.HasChanged && v.PreviousValue != null)
                                                        {
                                                            <div class="text-muted small font-monospace" style="font-size: 0.72rem; opacity: 0.85;">
                                                                was: <span class="text-decoration-line-through">@v.PreviousValue</span>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center py-4 text-muted small">
                                                    No variables match filter "@_varFilter"
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else if (_activeInspectorTab == "TempTables")
                    {
                        <!-- TEMP TABLES TAB -->
                        <div class="d-flex flex-column h-100 p-2 overflow-auto">
                            @if (CurrentSnapshotTempTables.Count == 0)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4 text-center">
                                    <i class="bi bi-table text-muted mb-2" style="font-size: 1.8rem; opacity: 0.4;"></i>
                                    <span class="text-muted small">No active tables</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 px-1 gap-2">
                                    <div class="input-group input-group-sm flex-grow-1" style="max-width: 220px;">
                                        <span class="input-group-text border-end-0 py-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border); height: 26px;">
                                            <i class="bi bi-search" style="font-size: 0.72rem;"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control form-control-sm shadow-none border-start-0 py-0"
                                               style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border); font-size: 0.76rem; height: 26px;"
                                               placeholder="Filter tables..."
                                               @bind="_ttFilter"
                                               @bind:event="oninput" />
                                        @if (!string.IsNullOrEmpty(_ttFilter))
                                        {
                                            <button class="btn btn-outline-secondary border-start-0 py-0 px-1"
                                                    style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border); height: 26px;"
                                                    @onclick="() => _ttFilter = string.Empty">
                                                <i class="bi bi-x" style="font-size: 0.85rem;"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (CurrentSnapshotTempTables.Count > 1)
                                    {
                                        <div class="d-flex gap-2 align-items-center flex-shrink-0">
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" @onclick="ExpandAllTempTables" title="Expand all tables">
                                                <i class="bi bi-arrows-expand me-1"></i>Expand All
                                            </button>
                                            <span class="text-muted small">|</span>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" @onclick="CollapseAllTempTables" title="Collapse all tables">
                                                <i class="bi bi-arrows-collapse me-1"></i>Collapse All
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (!FilteredTempTables.Any())
                                {
                                    <div class="text-center py-4 text-muted small">
                                        No tables match filter "@_ttFilter"
                                    </div>
                                }
                                else
                                {
                                    int ttIndex = 1;
                                    @foreach (var tt in FilteredTempTables)
                                    {
                                        var currentTtKey = tt.Name;
                                        var isCollapsed = _collapsedTempTables.Contains(currentTtKey);
                                        <div class="card mb-2 shadow-sm" style="background-color: var(--app-surface); border: 1px solid var(--app-border); overflow: hidden;">
                                            <div class="card-header py-1 px-3 d-flex align-items-center justify-content-between"
                                                 style="background-color: var(--app-surface-secondary); font-size: 0.8rem; cursor: pointer; user-select: none; @(isCollapsed ? "border-bottom: 0;" : "")"
                                                 @onclick="() => ToggleTempTable(currentTtKey)"
                                                 title="@(isCollapsed ? "Click to expand" : "Click to collapse")">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi @(isCollapsed ? "bi-chevron-right" : "bi-chevron-down") text-muted" style="font-size: 0.75rem;"></i>
                                                    <span class="font-monospace fw-bold" style="color: var(--app-text);">@tt.Name</span>
                                                    @if (tt.Name.StartsWith("@"))
                                                    {
                                                        <span class="badge bg-info-subtle text-info" style="font-size: 0.65rem;">VAR</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning" style="font-size: 0.65rem;">TEMP</span>
                                                    }
                                                </div>
                                                <span class="badge @(tt.TotalRowCount > 0 ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-muted")">
                                                    @(tt.TotalRowCount == tt.Rows.Count
                                                        ? (tt.TotalRowCount == 1 ? "1 row" : $"{tt.TotalRowCount:N0} rows")
                                                        : $"{tt.Rows.Count} of {tt.TotalRowCount:N0} rows")
                                                </span>
                                            </div>
                                            @if (!isCollapsed)
                                            {
                                                var ttPage = GetTablePage(currentTtKey);
                                                var totalTtPages = Math.Max(1, (int)Math.Ceiling(tt.Rows.Count / (double)_gridPageSize));
                                                if (ttPage > totalTtPages) { ttPage = totalTtPages; }
                                                var displayTtRows = tt.Rows.Skip((ttPage - 1) * _gridPageSize).Take(_gridPageSize).ToList();
                                                int rNum = (ttPage - 1) * _gridPageSize + 1;
                                                <div class="card-body p-0 table-responsive" style="min-height: 80px; max-height: 280px;">
                                                    <table class="table table-sm table-hover mb-0" style="font-size: 0.78rem; color: var(--app-text);">
                                                        <thead class="sticky-top" style="background-color: var(--app-surface-secondary);">
                                                            <tr>
                                                                <th class="py-1.5 px-2 text-center text-muted" style="width: 42px;">#</th>
                                                                @foreach (var col in tt.Columns)
                                                                {
                                                                    <th class="py-1.5 px-2 font-monospace">@col</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (tt.Rows.Count == 0)
                                                            {
                                                                <tr>
                                                                    <td colspan="@(tt.Columns.Count + 1)" class="text-center py-3 text-muted small">
                                                                        <i class="bi bi-info-circle me-1"></i>Temp table is empty (0 rows)
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var r in displayTtRows)
                                                                {
                                                                    <tr>
                                                                        <td class="py-1.5 px-2 text-center text-muted small">@rNum</td>
                                                                        @foreach (var col in tt.Columns)
                                                                        {
                                                                            var cellVal = r.TryGetValue(col, out var raw) ? raw?.ToString() : null;
                                                                            <td class="py-1.5 px-2 font-monospace text-truncate" style="max-width: 220px;" title="@cellVal">
                                                                                @(cellVal ?? "NULL")
                                                                            </td>
                                                                        }
                                                                    </tr>
                                                                    rNum++;
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                @if (tt.Rows.Count > _gridPageSize || tt.TotalRowCount > tt.Rows.Count)
                                                {
                                                    <div class="card-footer py-1 px-3 d-flex justify-content-between align-items-center"
                                                         style="background-color: var(--app-surface-secondary); font-size: 0.74rem; border-top: 1px solid var(--app-border);">
                                                        <div class="text-muted d-flex align-items-center gap-1">
                                                            @if (tt.TotalRowCount > tt.Rows.Count)
                                                            {
                                                                <span title="To protect debugger speed and memory, ExploreDB captures the first @tt.Rows.Count rows for preview.">
                                                                    <i class="bi bi-info-circle text-info me-1"></i>Showing preview of @tt.Rows.Count of @tt.TotalRowCount.ToString("N0") rows
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>Showing @(((ttPage - 1) * _gridPageSize) + 1)–@(Math.Min(ttPage * _gridPageSize, tt.Rows.Count)) of @tt.Rows.Count rows</span>
                                                            }
                                                        </div>
                                                        @if (totalTtPages > 1)
                                                        {
                                                            <div class="d-flex align-items-center gap-1">
                                                                <button type="button"
                                                                        class="btn btn-sm btn-link p-0 text-muted d-inline-flex align-items-center justify-content-center"
                                                                        style="width: 22px; height: 22px; text-decoration: none;"
                                                                        disabled="@(ttPage <= 1)"
                                                                        @onclick="() => SetTablePage(currentTtKey, ttPage - 1)"
                                                                        title="Previous page">
                                                                    <i class="bi bi-chevron-left" style="font-size: 0.75rem;"></i>
                                                                </button>
                                                                <span class="text-muted px-1">Page @ttPage of @totalTtPages</span>
                                                                <button type="button"
                                                                        class="btn btn-sm btn-link p-0 text-muted d-inline-flex align-items-center justify-content-center"
                                                                        style="width: 22px; height: 22px; text-decoration: none;"
                                                                        disabled="@(ttPage >= totalTtPages)"
                                                                        @onclick="() => SetTablePage(currentTtKey, ttPage + 1)"
                                                                        title="Next page">
                                                                    <i class="bi bi-chevron-right" style="font-size: 0.75rem;"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                        ttIndex++;
                                    }
                                }
                            }
                        </div>
                    }
                    else if (_activeInspectorTab == "Results")
                    {
                        <!-- RESULT SETS TAB (Option A: Cumulative) -->
                        <div class="d-flex flex-column h-100 p-2 overflow-auto">
                            @if (CurrentSnapshotResults.Count == 0)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4 text-center">
                                    <i class="bi bi-grid-3x3 text-muted mb-2" style="font-size: 1.8rem; opacity: 0.4;"></i>
                                    <span class="text-muted small">No result sets</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 px-1 gap-2">
                                    <div class="input-group input-group-sm flex-grow-1" style="max-width: 220px;">
                                        <span class="input-group-text border-end-0 py-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border); height: 26px;">
                                            <i class="bi bi-search" style="font-size: 0.72rem;"></i>
                                        </span>
                                        <input type="text"
                                               class="form-control form-control-sm shadow-none border-start-0 py-0"
                                               style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border); font-size: 0.76rem; height: 26px;"
                                               placeholder="Filter results..."
                                               @bind="_rsFilter"
                                               @bind:event="oninput" />
                                        @if (!string.IsNullOrEmpty(_rsFilter))
                                        {
                                            <button class="btn btn-outline-secondary border-start-0 py-0 px-1"
                                                    style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border); height: 26px;"
                                                    @onclick="() => _rsFilter = string.Empty">
                                                <i class="bi bi-x" style="font-size: 0.85rem;"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (CurrentSnapshotResults.Count > 1)
                                    {
                                        <div class="d-flex gap-2 align-items-center flex-shrink-0">
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" @onclick="ExpandAllResultSets" title="Expand all result sets">
                                                <i class="bi bi-arrows-expand me-1"></i>Expand All
                                            </button>
                                            <span class="text-muted small">|</span>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" style="font-size: 0.75rem;" @onclick="CollapseAllResultSets" title="Collapse all result sets">
                                                <i class="bi bi-arrows-collapse me-1"></i>Collapse All
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (!FilteredResults.Any())
                                {
                                    <div class="text-center py-4 text-muted small">
                                        No result sets match filter "@_rsFilter"
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in FilteredResults)
                                    {
                                        var currentRsIndex = item.OriginalIndex;
                                        var rs = item.ResultSet;
                                        var isCollapsed = _collapsedResultSets.Contains(currentRsIndex);
                                        <div class="card mb-2 shadow-sm" style="background-color: var(--app-surface); border: 1px solid var(--app-border); overflow: hidden;">
                                            <div class="card-header py-1 px-3 d-flex align-items-center justify-content-between"
                                                 style="background-color: var(--app-surface-secondary); font-size: 0.8rem; cursor: pointer; user-select: none; @(isCollapsed ? "border-bottom: 0;" : "")"
                                                 @onclick="() => ToggleResultSet(currentRsIndex)"
                                                 title="@(isCollapsed ? "Click to expand" : "Click to collapse")">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi @(isCollapsed ? "bi-chevron-right" : "bi-chevron-down") text-muted" style="font-size: 0.75rem;"></i>
                                                    <strong>Result Set #@currentRsIndex</strong>
                                                    @if (rs.LineNumber > 0)
                                                    {
                                                        <span class="text-muted small">(Line @rs.LineNumber)</span>
                                                    }
                                                </div>
                                                <span class="badge @(rs.TotalRowCount > 0 ? "bg-success-subtle text-success" : "bg-secondary-subtle text-muted")">
                                                    @(rs.TotalRowCount == rs.Rows.Count
                                                        ? (rs.TotalRowCount == 1 ? "1 row" : $"{rs.TotalRowCount:N0} rows")
                                                        : $"{rs.Rows.Count} of {rs.TotalRowCount:N0} rows")
                                                </span>
                                            </div>
                                            @if (!isCollapsed)
                                            {
                                                var rsPage = GetRsPage(currentRsIndex);
                                                var totalRsPages = Math.Max(1, (int)Math.Ceiling(rs.Rows.Count / (double)_gridPageSize));
                                                if (rsPage > totalRsPages) { rsPage = totalRsPages; }
                                                var displayRows = rs.Rows.Skip((rsPage - 1) * _gridPageSize).Take(_gridPageSize).ToList();
                                                int rNum = (rsPage - 1) * _gridPageSize + 1;
                                                <div class="card-body p-0 table-responsive" style="min-height: 80px; max-height: 280px;">
                                                    <table class="table table-sm table-hover mb-0" style="font-size: 0.78rem; color: var(--app-text);">
                                                        <thead class="sticky-top" style="background-color: var(--app-surface-secondary);">
                                                            <tr>
                                                                <th class="py-1.5 px-2 text-center text-muted" style="width: 42px;">#</th>
                                                                @foreach (var col in rs.Columns)
                                                                {
                                                                    <th class="py-1.5 px-2 font-monospace">@col</th>
                                                                }
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (rs.Rows.Count == 0)
                                                            {
                                                                <tr>
                                                                    <td colspan="@(rs.Columns.Count + 1)" class="text-center py-3 text-muted small">
                                                                        <i class="bi bi-info-circle me-1"></i>0 rows returned
                                                                    </td>
                                                                </tr>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var r in displayRows)
                                                                {
                                                                    <tr>
                                                                        <td class="py-1.5 px-2 text-center text-muted small">@rNum</td>
                                                                        @foreach (var col in rs.Columns)
                                                                        {
                                                                            var cellVal = r.TryGetValue(col, out var raw) ? raw?.ToString() : null;
                                                                            <td class="py-1.5 px-2 font-monospace text-truncate" style="max-width: 220px;" title="@cellVal">
                                                                                @(cellVal ?? "NULL")
                                                                            </td>
                                                                        }
                                                                    </tr>
                                                                    rNum++;
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                                @if (rs.Rows.Count > _gridPageSize || rs.TotalRowCount > rs.Rows.Count)
                                                {
                                                    <div class="card-footer py-1 px-3 d-flex justify-content-between align-items-center"
                                                         style="background-color: var(--app-surface-secondary); font-size: 0.74rem; border-top: 1px solid var(--app-border);">
                                                        <div class="text-muted d-flex align-items-center gap-1">
                                                            @if (rs.TotalRowCount > rs.Rows.Count)
                                                            {
                                                                <span title="To protect debugger speed and memory, ExploreDB captures the first @rs.Rows.Count rows for preview.">
                                                                    <i class="bi bi-info-circle text-info me-1"></i>Showing preview of @rs.Rows.Count of @rs.TotalRowCount.ToString("N0") rows
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>Showing @(((rsPage - 1) * _gridPageSize) + 1)–@(Math.Min(rsPage * _gridPageSize, rs.Rows.Count)) of @rs.Rows.Count rows</span>
                                                            }
                                                        </div>
                                                        @if (totalRsPages > 1)
                                                        {
                                                            <div class="d-flex align-items-center gap-1">
                                                                <button type="button"
                                                                        class="btn btn-sm btn-link p-0 text-muted d-inline-flex align-items-center justify-content-center"
                                                                        style="width: 22px; height: 22px; text-decoration: none;"
                                                                        disabled="@(rsPage <= 1)"
                                                                        @onclick="() => SetRsPage(currentRsIndex, rsPage - 1)"
                                                                        title="Previous page">
                                                                    <i class="bi bi-chevron-left" style="font-size: 0.75rem;"></i>
                                                                </button>
                                                                <span class="text-muted px-1">Page @rsPage of @totalRsPages</span>
                                                                <button type="button"
                                                                        class="btn btn-sm btn-link p-0 text-muted d-inline-flex align-items-center justify-content-center"
                                                                        style="width: 22px; height: 22px; text-decoration: none;"
                                                                        disabled="@(rsPage >= totalRsPages)"
                                                                        @onclick="() => SetRsPage(currentRsIndex, rsPage + 1)"
                                                                        title="Next page">
                                                                    <i class="bi bi-chevron-right" style="font-size: 0.75rem;"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    }
                    else if (_activeInspectorTab == "Messages")
                    {
                        <!-- MESSAGES TAB (SSMS / DataGrip Style) -->
                        <div class="d-flex flex-column h-100 p-2 overflow-auto">
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <span class="text-muted small fw-semibold" style="font-size: 0.75rem;">
                                    @CurrentSnapshotMessages.Count message@(CurrentSnapshotMessages.Count == 1 ? "" : "s")
                                </span>
                                @if (CurrentSnapshotMessages.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;" @onclick="CopyMessagesToClipboard" title="Copy messages to clipboard">
                                        <i class="bi bi-clipboard"></i>
                                        <span>Copy</span>
                                    </button>
                                }
                            </div>

                            <div class="card shadow-sm flex-grow-1 d-flex flex-column" style="background-color: var(--app-surface); border: 1px solid var(--app-border); overflow: hidden; min-height: 0;">
                                <div class="card-body p-2.5 font-monospace small overflow-auto flex-grow-1 @(CurrentSnapshotMessages.Count == 0 ? "d-flex flex-column align-items-center justify-content-center text-center" : "d-flex flex-column gap-2")" style="font-size: 0.82rem; user-select: text;">
                                    @if (CurrentSnapshotMessages.Count == 0)
                                    {
                                        <i class="bi bi-chat-left-text text-muted mb-2" style="font-size: 1.8rem; opacity: 0.4;"></i>
                                        <span class="text-muted small">No messages recorded for current step</span>
                                    }
                                    else
                                    {
                                        @for (int mIdx = 0; mIdx < CurrentSnapshotMessages.Count; mIdx++)
                                        {
                                            var msg = CurrentSnapshotMessages[mIdx];
                                            var isErr = msg.StartsWith("Error:", StringComparison.OrdinalIgnoreCase) || msg.StartsWith("Msg ", StringComparison.OrdinalIgnoreCase);
                                            <div class="p-2 rounded border shadow-sm d-flex align-items-start gap-2"
                                                 style="background-color: var(--app-surface-secondary); border-color: @(isErr ? "rgba(239, 68, 68, 0.4)" : "var(--app-border)") !important; border-left: 3px solid @(isErr ? "#ef4444" : "#3b82f6") !important;">
                                                <span class="text-muted small user-select-none mt-0.5 font-monospace fw-semibold" style="font-size: 0.72rem; min-width: 22px;">#@(mIdx + 1)</span>
                                                <span class="@(isErr ? "text-danger fw-semibold" : "") flex-grow-1" style="white-space: pre-wrap; word-break: break-word; line-height: 1.5; color: @(isErr ? "" : "var(--app-text)");">@msg</span>
                                            </div>
                                        }
                                    }
                                </div>

                                @if (_session?.IsRecorded == true)
                                {
                                    <div class="card-footer py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2 text-muted" style="background-color: var(--app-surface-secondary); border-top: 1px solid var(--app-border); font-size: 0.75rem;">
                                        <div class="d-flex align-items-center gap-1">
                                            <i class="bi bi-stopwatch text-muted"></i>
                                            <span>Server Time:</span>
                                            <strong class="font-monospace" style="color: var(--app-text);">@(_session?.TotalServerExecutionMs ?? 0) ms</strong>
                                        </div>
                                        <div class="d-flex align-items-center gap-1 text-success fw-semibold">
                                            <i class="bi bi-shield-check"></i>
                                            <span>Transaction Rolled Back (0 locks)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PARAMETERS MODAL -->
@if (_showParametersModal && _session != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg" style="background: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-header py-2 px-3" style="border-bottom: 1px solid var(--app-border);">
                    <h5 class="modal-title fs-6 fw-bold">
                        <i class="bi bi-sliders me-2 text-primary"></i>Configure Procedure Parameters
                    </h5>
                    <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "")" @onclick="() => _showParametersModal = false"></button>
                </div>
                <div class="modal-body py-3 px-4">
                    @if (_session.Parameters.Count == 0)
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-info-circle fs-4 mb-2 d-block"></i>
                            This stored procedure has no input parameters. You can proceed directly to debug recording.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">
                            Provide parameter values to test execution branches and debug conditional logic.
                        </p>
                        <div class="table-responsive">
