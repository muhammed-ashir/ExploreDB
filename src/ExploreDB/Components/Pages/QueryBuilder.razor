@page "/builder"
@using ExploreDB.Services
@inject SchemaService SchemaService
@inject PathfinderService PathfinderService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@implements IDisposable

<style>
    .compact-accordion .accordion-button::after {
        background-size: 0.85rem;
        width: 0.85rem;
        height: 0.85rem;
    }

</style>

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@if (IsLoading)
{
    <LoadingSpinner />
}
else
{
<div class="container-fluid">
    <div class="row">
        <!-- Column Picker -->
        <!-- Builder Panel -->
        <div class="col-md-4 d-flex flex-column gap-3" style="position: sticky; top: 20px; height: calc(100vh - 60px);">
            <div class="btn-group shadow-sm w-100 flex-shrink-0">
                <button class="btn @(CurrentMode == QueryMode.Select ? "btn-primary" : "btn-dark border-secondary text-light")" @onclick="() => SetMode(QueryMode.Select)">SELECT</button>
                <button class="btn @(CurrentMode == QueryMode.Update ? "btn-primary" : "btn-dark border-secondary text-light")" @onclick="() => SetMode(QueryMode.Update)">UPDATE</button>
                <button class="btn @(CurrentMode == QueryMode.Delete ? "btn-primary" : "btn-dark border-secondary text-light")" @onclick="() => SetMode(QueryMode.Delete)">DELETE</button>
            </div>
            <div class="card bg-dark border-secondary shadow-sm d-flex flex-column" style="flex: 1; min-height: 0;">
                <!-- Tab Header -->
                <div class="card-header border-secondary p-0" style="position: sticky; top: 0; z-index: 30; background: #1a1d20; border-bottom: 1px solid #343a40 !important;">
                    <div class="d-flex w-100">
                        <button class="btn flex-grow-1 rounded-0 py-2 text-uppercase d-flex justify-content-center align-items-center" 
                                style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.5px; transition: all 0.2s ease-in-out; border: none; border-bottom: 3px solid @(ActiveBuilderTab == "Available" ? "#0d6efd" : "transparent"); color: @(ActiveBuilderTab == "Available" ? "#fff" : "#6c757d"); background: @(ActiveBuilderTab == "Available" ? "rgba(13, 110, 253, 0.05)" : "transparent"); box-shadow: none;"
                                @onclick='() => ActiveBuilderTab = "Available"'>
                            Available
                        </button>
                        <button class="btn flex-grow-1 rounded-0 py-2 text-uppercase d-flex justify-content-center align-items-center" 
                                style="font-size: 0.85rem; font-weight: 700; letter-spacing: 0.5px; transition: all 0.2s ease-in-out; border: none; border-bottom: 3px solid @(ActiveBuilderTab == "Selected" ? "#0d6efd" : "transparent"); color: @(ActiveBuilderTab == "Selected" ? "#fff" : "#6c757d"); background: @(ActiveBuilderTab == "Selected" ? "rgba(13, 110, 253, 0.05)" : "transparent"); box-shadow: none;"
                                @onclick='() => ActiveBuilderTab = "Selected"'>
                            Selected 
                            @if (SelectedColumns.Count > 0)
                            {
                                var tableCount = SelectedColumns.Select(k => k.Substring(0, k.LastIndexOf('.'))).Distinct().Count();
                                <span class="badge bg-primary ms-2 rounded-pill" style="font-size: 0.6rem; padding: 0.15rem 0.35rem; line-height: 1;">@tableCount</span>
                            }
                        </button>
                    </div>
                </div>
                
                <div class="d-flex flex-column" style="flex: 1; min-height: 0;">
                    @if (ActiveBuilderTab == "Available")
                    {
                        <!-- Search header -->
                        <div class="p-2 pt-3 border-bottom border-secondary" style="background: #1a1d20; z-index: 25; flex-shrink: 0;">
                            <div class="row g-2">
                                @if (CurrentMode != QueryMode.Select)
                                {
                                    <div class="col-12 mb-2">
                                        <label class="small text-warning fw-bold mb-1">Target Table (To @CurrentMode)</label>
                                        <div class="position-relative w-100">
                                            <div class="form-control form-control-sm bg-black text-white border-warning position-relative cursor-pointer" @onclick="() => IsTargetTableDropdownOpen = !IsTargetTableDropdownOpen">
                                                @{
                                                    var targetTableNameOnly = string.IsNullOrEmpty(TargetTable) ? "Select Target Table..." : TargetTable.Replace("[", "").Replace("]", "").Split('.').LastOrDefault();
                                                    var targetTooltipHtml = string.IsNullOrEmpty(TargetTable) ? null : GetTooltipHtml(TargetTable);
                                                }
                                                <div class="text-truncate" style="padding-right: 20px;"
                                                     data-bs-tooltip="@(!string.IsNullOrEmpty(TargetTable) ? "true" : null)" 
                                                     data-bs-html="@(!string.IsNullOrEmpty(TargetTable) ? "true" : null)" 
                                                     data-bs-title="@targetTooltipHtml" 
                                                     data-bs-placement="bottom">
                                                    @targetTableNameOnly
                                                </div>
                                                <div class="position-absolute h-100 d-flex align-items-center" style="right: 12px; top: 0; pointer-events: none;">
                                                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.85rem;"></i>
                                                </div>
                                            </div>
                                            @if (IsTargetTableDropdownOpen)
                                            {
                                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsTargetTableDropdownOpen = false"></div>
                                                <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-1 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 250px; overflow-y: auto; overflow-x: hidden;">
                                                    <div class="p-1 mb-1">
                                                        <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="Search tables..." @bind="TargetTableSearch" @bind:event="oninput" @onclick:stopPropagation />
                                                    </div>
                                                    @foreach (var table in SchemaService.Tables.Where(t => string.IsNullOrEmpty(TargetTableSearch) || t.Name.Contains(TargetTableSearch, StringComparison.OrdinalIgnoreCase)))
                                                    {
                                                        <button class="dropdown-item text-white py-1 text-truncate @(TargetTable == table.FullName ? "bg-primary bg-opacity-25 rounded-1" : "rounded-1")" type="button" 
                                                                data-bs-tooltip="true" data-bs-html="true" data-bs-title="@GetTooltipHtml(table.FullName)" data-bs-placement="right" 
                                                                @onclick="() => SelectTargetTable(table.FullName)">
                                                            @table.Name
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <hr class="border-secondary mt-1 mb-2 opacity-50"/>
                                    <label class="small text-info fw-bold mb-1">Filter Tables (To JOIN)</label>
                                }
                                <div class="col-12 d-flex flex-column gap-2 position-relative">
                                    <div class="input-group input-group-sm shadow-sm">
                                        <input type="text" class="form-control bg-black text-white border-secondary" 
                                               placeholder="Search... (Enter to filter)" 
                                               @bind="_searchColInput" 
                                               @bind:event="oninput"
                                               @onkeydown="OnSearchKeyDown"
                                               @onblur="(_ => ApplySearch())" />
                                        <button class="btn @(CaseSensitive ? "btn-primary" : "btn-outline-secondary bg-black text-muted") border-secondary px-2" style="z-index: 0;" title="Match Case" @onclick="() => CaseSensitive = !CaseSensitive">
                                            <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                        </button>
                                        <button class="btn @(MatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-black text-muted") border-secondary px-2" style="z-index: 0;" title="Match Whole Word" @onclick="() => { MatchWholeWord = !MatchWholeWord; if (MatchWholeWord) ExactMatch = false; }">
                                            <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                        </button>
                                        <button class="btn @(ExactMatch ? "btn-primary" : "btn-outline-secondary bg-black text-muted") border-secondary px-2" style="z-index: 0;" title="Exact Match" @onclick="() => { ExactMatch = !ExactMatch; if (ExactMatch) MatchWholeWord = false; }">
                                            <i class="bi bi-bullseye"></i>
                                        </button>
                                    </div>
                                    
                                    <div class="d-flex align-items-center px-1">
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="searchTable" 
                                                   checked="@(SearchFilter == "All" || SearchFilter == "Table")" 
                                                   @onchange='(e) => { 
                                                       bool isChecked = (bool)(e.Value ?? false);
                                                       bool isColumnChecked = SearchFilter == "All" || SearchFilter == "Column";
                                                       if (isChecked && isColumnChecked) SearchFilter = "All";
                                                       else if (isChecked) SearchFilter = "Table";
                                                       else if (isColumnChecked) SearchFilter = "Column";
                                                       else SearchFilter = "None";
                                                   }'>
                                            <label class="form-check-label text-light small cursor-pointer user-select-none" for="searchTable">Table</label>
                                        </div>
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="searchColumn" 
                                                   checked="@(SearchFilter == "All" || SearchFilter == "Column")" 
                                                   @onchange='(e) => { 
                                                       bool isChecked = (bool)(e.Value ?? false);
                                                       bool isTableChecked = SearchFilter == "All" || SearchFilter == "Table";
                                                       if (isChecked && isTableChecked) SearchFilter = "All";
                                                       else if (isChecked) SearchFilter = "Column";
                                                       else if (isTableChecked) SearchFilter = "Table";
                                                       else SearchFilter = "None";
                                                   }'>
                                            <label class="form-check-label text-light small cursor-pointer user-select-none" for="searchColumn">Column</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Available Tables list -->
                        <div style="overflow-y: auto; overflow-x: hidden; flex: 1; min-height: 0;">
                            <div class="accordion accordion-flush compact-accordion" id="availableTablesAccordion">
                            @if (SchemaService.Tables.Count == 0)
                            {
                                <div class="p-3 text-center text-muted">Connect to a database to start.</div>
                            }
                            else
                            {
                                bool hasResults = false;
                                bool hasSearch = !string.IsNullOrWhiteSpace(SearchCol);
                                string searchTerm = hasSearch ? SearchCol : "";
                                bool tableFilter = SearchFilter == "All" || SearchFilter == "Table";
                                bool colFilter = SearchFilter == "All" || SearchFilter == "Column";
                                StringComparison comp = CaseSensitive ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;

                                foreach (var table in FilteredTables)
                                {
                                    List<ColumnInfo> matchingColumns;
                                    
                                    if (!hasSearch)
                                    {
                                        matchingColumns = table.Columns;
                                    }
                                    else
                                    {
                                        bool tableMatches = false;
                                        if (tableFilter)
                                        {
                                            if (ExactMatch) tableMatches = string.Equals(table.Name, searchTerm, comp);
                                            else if (MatchWholeWord) tableMatches = table.Name.Split(' ', '.', '_').Any(p => string.Equals(p, searchTerm, comp));
                                            else tableMatches = table.Name.Contains(searchTerm, comp);
                                        }

                                        if (tableMatches)
                                        {
                                            matchingColumns = table.Columns; // If table matches, show all columns
                                        }
                                        else if (colFilter)
                                        {
                                            matchingColumns = new List<ColumnInfo>();
                                            foreach (var c in table.Columns)
                                            {
                                                bool colMatches = false;
                                                if (ExactMatch) colMatches = string.Equals(c.Name, searchTerm, comp);
                                                else if (MatchWholeWord) colMatches = c.Name.Split(' ', '.', '_').Any(p => string.Equals(p, searchTerm, comp));
                                                else colMatches = c.Name.Contains(searchTerm, comp);
                                                
                                                if (colMatches) matchingColumns.Add(c);
                                            }
                                        }
                                        else
                                        {
                                            matchingColumns = new List<ColumnInfo>();
                                        }
                                    }

                                    if (matchingColumns.Count > 0)
                                    {
                                        hasResults = true;
                                        var tableId = "table_" + table.FullName.Replace(".", "_").Replace("\"", "");
                                        <div class="accordion-item bg-transparent border-bottom border-secondary">
                                            <h2 class="accordion-header" id="heading_@tableId">
                                                <div class="d-flex align-items-center bg-dark">
                                                    <div class="ps-3 pe-1 py-0 d-flex align-items-center gap-2">
                                                        <input class="form-check-input m-0"
                                                               type="checkbox"
                                                               id="@GetTableCheckboxId(table)"
                                                               checked="@AreAllColumnsSelected(table)"
                                                               @onchange="(e) => ToggleTableColumns(table, e.Value is true)" 
                                                               @onclick:stopPropagation 
                                                               style="width: 0.85rem; height: 0.85rem; cursor: pointer; margin-top: 2px !important;" />
                                                    </div>
                                                    <button class="accordion-button collapsed bg-transparent text-light shadow-none fw-bold text-uppercase px-2" 
                                                            type="button" 
                                                            data-bs-toggle="collapse" 
                                                            data-bs-target="#collapse_@tableId" 
                                                            aria-expanded="false" 
                                                            aria-controls="collapse_@tableId"
                                                            style="color: #6ea8fe !important; font-size: 0.75rem; min-height: 28px; padding-top: 0.35rem !important; padding-bottom: 0.35rem !important; flex: 1; min-width: 0;"
                                                            data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @table.Name<br/><b>Schema:</b> @table.Schema.ToLower()" data-bs-placement="bottom">
                                                        <span class="text-truncate text-start flex-grow-1 pe-2" style="min-width: 0;">@table.Name</span>
                                                    </button>
                                                </div>
                                            </h2>
                                            <div id="collapse_@tableId" class="accordion-collapse collapse" aria-labelledby="heading_@tableId" data-bs-parent="#availableTablesAccordion">
                                                <div class="accordion-body py-2 px-0 bg-black">
                                                    <div class="list-group list-group-flush">
                                                        @foreach(var col in matchingColumns)
                                                        {
                                                            var key = GetColumnKey(table, col.Name);
                                                            var isSelected = SelectedColumns.Contains(key);
                                                            <div class="list-group-item bg-transparent border-0 py-1 ps-4 pe-2 text-light d-flex align-items-center" style="min-height: 28px;">
                                                                <input class="form-check-input me-2 mt-0" type="checkbox" id="@key" 
                                                                       checked="@isSelected" 
                                                                       @onchange="(e) => ToggleColumn(key, table.FullName, e.Value is true)" 
                                                                       style="width: 0.8rem; height: 0.8rem; cursor: pointer;" />
                                                                <label class="form-check-label text-truncate cursor-pointer flex-grow-1" for="@key" style="font-size: 0.75rem; margin-top: 1px; min-width: 0;" title="@col.Name">
                                                                    @col.Name
                                                                </label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                if (!hasResults && !string.IsNullOrWhiteSpace(SearchCol))
                                {
                                    <div class="p-4 text-center">
                                        <div class="text-muted mb-2"><i class="bi bi-search fs-3"></i></div>
                                        <div class="text-light fw-bold">No results found</div>
                                        <div class="text-muted small mt-1">Try adjusting your search criteria</div>
                                    </div>
                                }
                            }
                            </div>
                        </div>
                    }
                    else if (ActiveBuilderTab == "Selected")
                    {
                        <!-- Selected Columns Content -->
                        <div class="p-0 bg-black" style="overflow-y: auto; flex: 1; min-height: 0;">
                            @if (SelectedColumns.Count == 0)
                            {
                                <div class="p-4 text-center text-muted mt-3 mb-3">Select columns from the Available tab to start building your query.</div>
                            }
                            else
                            {
                                <div class="p-3 d-flex flex-column gap-3">
                                    @{ var uniqueTables = SelectedColumns.Select(k => k.Substring(0, k.LastIndexOf('.'))).Distinct().ToList(); }
                                    @foreach (var group in SelectedColumns.GroupBy(k => k.Substring(0, k.LastIndexOf('.'))))
                                    {
                                        var table = group.Key;
                                        var isFirst = table == uniqueTables.First();
                                        var isLast = table == uniqueTables.Last();
                                        
                                        var cleanTable = table.Replace("[", "").Replace("]", "");
                                        var parts = cleanTable.Split('.');
                                        var schemaName = parts.Length > 1 ? parts[0] : "dbo";
                                        var tableName = parts.Length > 1 ? parts[1] : cleanTable;
                                        
                                        <div class="p-2 mb-2 border border-secondary rounded" style="background-color: rgba(255,255,255,0.03);">
                                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: rgba(255,255,255,0.1) !important;">
                                                <div class="text-light fw-bold text-truncate cursor-pointer" style="font-size: 0.85rem;" 
                                                     data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @tableName<br/><b>Schema:</b> @schemaName.ToLower()" data-bs-placement="bottom"
                                                     @onclick="() => NavigateToDetails(table)">
                                                    @tableName
                                                </div>
                                                <div class="d-flex gap-1 flex-shrink-0 align-items-center">
                                                    <button class="btn btn-sm btn-link text-secondary p-0" style="text-decoration: none; @(isFirst ? "cursor: not-allowed; pointer-events: auto;" : "")" title="@(isFirst ? "Cannot move up - already at the top" : "Move Up")" disabled="@isFirst" @onclick="() => MoveTable(table, -1)"><i class="bi bi-arrow-up-short fs-5"></i></button>
                                                    <button class="btn btn-sm btn-link text-secondary p-0" style="text-decoration: none; @(isLast ? "cursor: not-allowed; pointer-events: auto;" : "")" title="@(isLast ? "Cannot move down - already at the bottom" : "Move Down")" disabled="@isLast" @onclick="() => MoveTable(table, 1)"><i class="bi bi-arrow-down-short fs-5"></i></button>
                                                    <button class="btn btn-sm btn-link text-danger p-0 ms-1 opacity-75" style="text-decoration: none;" title="Remove Table" @onclick="() => RemoveTable(table)"><i class="bi bi-trash fs-6"></i></button>
                                                </div>
                                            </div>
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var key in group)
                                                {
                                                    var col = key.Substring(key.LastIndexOf('.') + 1);
                                                    <div class="d-flex align-items-center rounded-pill ps-2 pe-1" style="background-color: rgba(13, 110, 253, 0.1); border: 1px solid rgba(13, 110, 253, 0.2); font-size: 0.7rem; color: #8bb9fe; padding-top: 0.15rem; padding-bottom: 0.15rem;">
                                                        <span class="text-truncate d-inline-block" style="max-width: 120px; vertical-align: middle;" title="@col">@col</span>
                                                        <i class="bi bi-x fs-6 ms-1" style="cursor: pointer; line-height: 0.5; opacity: 0.7;" title="Remove" @onclick="() => ToggleColumn(key, table, false)" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'"></i>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Result Area -->
        <div class="col-md-8 d-flex flex-column gap-4">
                @if (CurrentMode == QueryMode.Update && !string.IsNullOrEmpty(TargetTable))
                {
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-header border-secondary fw-bold text-warning d-flex justify-content-between align-items-center cursor-pointer" @onclick="() => IsColumnMappingOpen = !IsColumnMappingOpen">
                            <span><i class="bi @(IsColumnMappingOpen ? "bi-chevron-down" : "bi-chevron-right") pe-1"></i> Update Column Mapping</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowResetModal = true" @onclick:stopPropagation="true">Reset</button>
                        </div>
                        @if (IsColumnMappingOpen)
                        {
                            <div class="card-body p-0">
                            <div class="table-responsive custom-scrollbar-light" style="max-height: 65vh; overflow-y: auto; overflow-x: visible;">
                                <table class="table table-dark table-hover mb-0 align-middle">
                                    <colgroup>
                                        <col style="width: 40%;">
                                        <col style="width: 60%;">
                                    </colgroup>
                                    <tbody>
                                        @foreach (var col in SchemaService.Tables.FirstOrDefault(t => t.FullName == TargetTable)?.Columns ?? new List<ColumnInfo>())
                                        {
                                            var targetColName = col.Name;
                                            UpdateMappings.TryGetValue(targetColName, out var mappedValue);
                                            <tr>
                                                <td class="border-secondary font-monospace small">
                                                    <div class="form-check form-check-inline mb-0 d-flex align-items-center">
                                                        <input class="form-check-input bg-dark border-secondary cursor-pointer mt-0" type="checkbox" id="chk_@targetColName"
                                                               checked="@(!string.IsNullOrEmpty(mappedValue))" 
                                                               @onchange="(e) => ToggleColumnMapping(targetColName, (bool)(e.Value ?? false))" />
                                                        <label class="form-check-label text-white cursor-pointer ms-2" for="chk_@targetColName">
                                                            @targetColName
                                                        </label>
                                                    </div>
                                                </td>
                                                <td class="border-secondary">
                                                    <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" 
                                                           value="@(mappedValue == $"@set_{targetColName}" ? "" : mappedValue)" 
                                                           placeholder="@($"@set_{targetColName}")"
                                                           @oninput="(e) => UpdateColumnMappingText(targetColName, e.Value?.ToString())" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        }
                    </div>
                }

             <!-- Generated SQL Box -->
             <div class="card bg-dark border-secondary shadow-sm" style="flex: 1;">
                 <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                     <span class="fw-bold">Generated SQL</span>
                     <div class="d-flex gap-2">
                         <button class="btn btn-sm btn-outline-warning" @onclick="() => ShowClearConfirmation = true" title="Clear all selections">
                             <i class="bi bi-eraser-fill"></i> Clear
                         </button>
                         <button class="btn btn-sm @(CopyLabel == "Copied! ✓" ? "btn-success" : "btn-outline-secondary")" @onclick="CopySql" title="Copy to clipboard">
                             @if (CopyLabel == "Copy")
                             {
                                 <i class="bi bi-clipboard me-1"></i>
                             }
                             @CopyLabel
                         </button>
                         <button class="btn btn-sm btn-primary" @onclick="RunInRunner" disabled="@(SelectedColumns.Count == 0)">
                             <i class="bi bi-play-fill"></i> Run
                         </button>
                     </div>
                 </div>
                 <div class="card-body p-0 position-relative d-flex flex-column">
                     @if (HasOneToMany)
                     {
                         <button class="btn btn-sm btn-dark text-warning border-warning position-absolute top-0 end-0 m-3 shadow" style="z-index: 10;" @onclick="() => ShowWarningModal = true" title="View Join Warning">
                             <i class="bi bi-exclamation-triangle-fill"></i>
                         </button>
                     }
                     <textarea class="form-control bg-black text-success border-0 font-monospace p-3 d-block flex-grow-1" 
                               style="resize: vertical; min-height: 150px;" readonly>@GeneratedSql</textarea>
                 </div>
                 @if ((LastJoinPlan != null && LastJoinPlan.Steps.Count > 0) || IgnoredRoutingTables.Count > 0 || IgnoredRoutingEdges.Count > 0)
                 {
                     <div class="card-footer bg-dark border-secondary p-3 border-top-0 border-top mt-2">
                         @if (LastJoinPlan != null && LastJoinPlan.Steps.Count > 0)
                         {
                             <div class="d-flex align-items-center mb-3">
                                 <h6 class="text-info fw-bold mb-0">Join Path Routing</h6>
                                 <i class="bi bi-info-circle ms-2 text-muted" style="font-size: 0.9rem; cursor: help;" data-bs-tooltip="true" data-bs-placement="right" title="Visualizes the automatic JOIN path between tables. Use the orange alternative route button to explore other paths, where you can block specific routes or mark them as required waypoints to fully customize the generated query."></i>
                             </div>
                             <div class="d-flex flex-wrap gap-2 align-items-center small mb-3">
                                 <div class="btn-group btn-group-sm shadow-sm">
                                     <span class="btn btn-dark border-secondary py-1 text-light fw-bold cursor-pointer text-truncate d-inline-block align-middle" style="max-width: 300px;" data-bs-tooltip="true" data-bs-html="true" data-bs-title="@GetTooltipHtml(LastJoinPlan.RootTable)" data-bs-placement="bottom" @onclick="() => NavigateToDetails(LastJoinPlan.RootTable)">
                                         @LastJoinPlan.RootTable.Split('.').Last().Replace("[", "").Replace("]", "")
                                     </span>
                                 </div>
                                 @foreach (var step in LastJoinPlan.Steps)
                                 {
                                     <span class="text-secondary fw-bold fs-5">➔</span>
                                     var isIgnored = IgnoredRoutingTables.Contains(step.FullName);
                                     <div class="btn-group btn-group-sm shadow-sm @(!step.IsSelectedTable ? "dropdown" : "")">
                                         <span class="btn btn-dark border-secondary py-1 text-light fw-bold cursor-pointer text-truncate d-inline-block align-middle" style="max-width: 300px;" data-bs-tooltip="true" data-bs-html="true" data-bs-title="@GetTooltipHtml(step.FullName)" data-bs-placement="bottom" @onclick="() => NavigateToDetails(step.FullName)">
                                             @step.FullName.Split('.').Last().Replace("[", "").Replace("]", "")
                                         </span>
                                         @if (!step.IsSelectedTable)
                                         {
                                             <button type="button" class="btn py-1 btn-warning border-warning text-dark" style="background-color: #ffc107;" data-bs-tooltip="true" data-bs-title="View alternative routes" @onclick="() => ActiveOffcanvasTable = step.FullName" @onclick:stopPropagation>
                                                 <i class="bi bi-diagram-3"></i>
                                             </button>
                                         }
                                     </div>
                                 }
                             </div>
                         }

                         @if (IgnoredRoutingTables.Count > 0 || IgnoredRoutingEdges.Count > 0)
                         {
                             <div class="@(LastJoinPlan != null && LastJoinPlan.Steps.Count > 0 ? "mt-3" : "") d-flex flex-column gap-3">
                                 @if (IgnoredRoutingTables.Count > 0)
                                 {
                                     <div>
                                         <div class="text-danger small fw-bold mb-2">Blocked Hubs:</div>
                                         <div class="d-flex flex-wrap gap-2">
                                             @foreach(var ignored in IgnoredRoutingTables)
                                             {
                                                 var parts = ignored.Replace("[", "").Replace("]", "").Split('.');
                                                 var schemaName = parts.Length > 1 ? parts[0] : "dbo";
                                                 var cleanName = parts.Length > 1 ? parts[1] : parts[0];
                                                 <span class="badge d-flex align-items-center gap-2 px-2 py-1 text-wrap text-start cursor-pointer" style="background-color: rgba(220, 53, 69, 0.15); border: 1px solid rgba(220, 53, 69, 0.4); color: #ff98a3; font-size: 0.85rem; max-width: 100%;" 
                                                       data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @cleanName<br/><b>Schema:</b> @schemaName.ToLower()" data-bs-placement="bottom">
                                                     <span class="flex-grow-1 text-truncate d-inline-block align-middle" style="max-width: 300px;" @onclick="() => NavigateToDetails(ignored)">@cleanName</span>
                                                     <i class="bi bi-x-lg" style="cursor: pointer; font-size: 0.75rem; padding-left: 0.25rem; color: #ff98a3; opacity: 0.8;" aria-label="Remove" @onclick="() => ToggleIgnoreRoutingTable(ignored)" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"></i>
                                                 </span>
                                             }
                                         </div>
                                     </div>
                                 }
                                 @if (IgnoredRoutingEdges.Count > 0)
                                 {
                                     <div>
                                         <div class="text-danger small fw-bold mb-2">Blocked Paths:</div>
                                         <div class="d-flex flex-wrap gap-2">
                                             @foreach(var edgeKey in IgnoredRoutingEdges)
                                             {
                                                 var parts = edgeKey.Split('|');
                                                 if (parts.Length == 4)
                                                 {
                                                     var sourceTable = parts[0].Split('.').Last().Replace("[", "").Replace("]", "");
                                                     var targetTable = parts[1].Split('.').Last().Replace("[", "").Replace("]", "");
                                                     <span class="badge d-flex align-items-center gap-2 px-2 py-1 text-wrap text-start" style="background-color: rgba(220, 53, 69, 0.15); border: 1px solid rgba(220, 53, 69, 0.4); color: #ff98a3; font-size: 0.85rem; max-width: 100%;">
                                                         <span class="flex-grow-1 text-truncate d-inline-block align-middle" style="max-width: 300px;">@sourceTable ➔ @targetTable</span>
                                                         <i class="bi bi-x-lg" style="cursor: pointer; font-size: 0.75rem; padding-left: 0.25rem; color: #ff98a3; opacity: 0.8;" aria-label="Remove" @onclick="() => ToggleIgnoreRoutingEdge(edgeKey)" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.8'"></i>
                                                     </span>
                                                 }
                                             }
                                         </div>
                                     </div>
                                 }
                             </div>
                         }
                     </div>
                 }
             </div>
        </div>
    </div>
</div>

@if (ShowWarningModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-header border-secondary border-opacity-50">
                    <h5 class="modal-title fw-bold text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i> Duplication Warning</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowWarningModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (OptimalTableOrder != null)
                    {
                        <!-- Main Warning Header -->
                        <div class="mb-4">
                            <h5 class="fw-bold text-white mb-2">One-to-Many Join Detected</h5>
                            <p class="text-light text-opacity-75 mb-0" style="font-size: 0.95rem;">
                                Rows may multiply because multiple matching child rows exist for a single parent row. <br/>
                                A <code class="text-warning bg-black bg-opacity-50 px-2 py-1 rounded border border-warning border-opacity-25 shadow-sm">SELECT DISTINCT</code> has been applied automatically to suppress exact duplicates.
                            </p>
                        </div>
                        
                        <!-- Optimal Order Card -->
                        <div class="card bg-black border-success border-opacity-25 shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h6 class="fw-bold text-success mb-2">Optimal Join Order Available</h6>
                                        <p class="text-light text-opacity-75 mb-0 small">
                                            Start from the most granular table to avoid row duplication entirely:
                                        </p>
                                        <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                                            @for (int i = 0; i < OptimalTableOrder.Count; i++)
                                            {
                                                var table = OptimalTableOrder[i];
                                                var parts = table.Replace("[", "").Replace("]", "").Split('.');
                                                var schemaName = parts.Length > 1 ? parts[0] : "dbo";
                                                var cleanName = parts.Length > 1 ? parts[1] : parts[0];
                                                <span class="badge bg-dark border border-secondary px-2 py-1 fs-6 text-light cursor-pointer text-truncate d-inline-block align-middle" style="max-width: 300px;" 
                                                      data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @cleanName<br/><b>Schema:</b> @schemaName.ToLower()" data-bs-placement="bottom" 
                                                      @onclick="() => NavigateToDetails(table)">@cleanName</span>
                                                
                                                @if (i < OptimalTableOrder.Count - 1)
                                                {
                                                    <span class="text-secondary fw-bold fs-5">➔</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <button class="btn btn-success px-4 py-2 fw-bold shadow-sm flex-shrink-0" style="border-radius: 6px;" @onclick="() => { ApplyOptimalOrder(); ShowWarningModal = false; }">Apply Fix</button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Integrated Cartesian Product Warning -->
                        <div class="mt-2">

                            <p class="text-light text-opacity-75 mb-3" style="font-size: 0.95rem; line-height: 1.6;">
                                Rows may multiply because multiple matching child rows exist for a single parent row (e.g., parallel sibling paths). Reordering the tables cannot mathematically prevent duplication here.
                            </p>
                            <p class="text-light text-opacity-75 mb-0" style="font-size: 0.95rem;">
                                A <code class="text-warning bg-black bg-opacity-50 px-2 py-1 rounded border border-warning border-opacity-25 shadow-sm">SELECT DISTINCT</code> has been applied automatically to suppress exact duplicates.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

