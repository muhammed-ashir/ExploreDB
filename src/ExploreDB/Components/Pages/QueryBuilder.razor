@code {
    private string? ActiveOffcanvasTable = null;
    private string GetTooltipHtml(string fullName)
    {
        var tableInfo = SchemaService.Tables.FirstOrDefault(t => t.FullName == fullName);
        var schema = tableInfo?.Schema.ToLower() ?? fullName.Split('.').First().Replace("[", "").Replace("]", "").ToLower();
        var name = tableInfo?.Name ?? fullName.Split('.').Last().Replace("[", "").Replace("]", "");
        return $"<b>Type:</b> Table<br/><b>Name:</b> {name}<br/><b>Schema:</b> {schema}";
    }

    private void NavigateToDetails(string fullName)
    {
        if (SchemaService.Tables.Any(t => t.FullName == fullName))
        {
            Navigation.NavigateTo($"/table/{Uri.EscapeDataString(fullName)}?returnUrl=%2Fbuilder");
        }
        else if (SchemaService.Views.Any(v => v.FullName == fullName))
        {
            Navigation.NavigateTo($"/view/{Uri.EscapeDataString(fullName)}?returnUrl=%2Fbuilder");
        }
    }

    private bool ShowDeleteModal = false;
    private bool ShowClearConfirmation = false;
    private bool ShowResetModal = false;
    private string TableToDelete = "";
    private bool ShowWarningModal { get; set; } = false;
    private string ActiveBuilderTab { get => QueryStateService.ActiveBuilderTab; set => QueryStateService.ActiveBuilderTab = value; }
    private string SearchCol = "";
    private string _searchColInput = "";

    private string SearchColInput
    {
        get => _searchColInput;
        set => _searchColInput = value;
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            ApplySearch();
        else if (e.Key == "Escape")
        {
            _searchColInput = "";
            ApplySearch();
        }
    }

    private void ApplySearch()
    {
        SearchCol = _searchColInput;
    }


    private bool ShowLimitAlert = false;
    private string SearchFilter = "All";
    private bool ExactMatch = false;
    private bool MatchWholeWord = false;
    private bool CaseSensitive = false;
    private ExploreDB.Services.QueryMode CurrentMode { get => QueryStateService.CurrentMode; set => QueryStateService.CurrentMode = value; }
    private string? TargetTable { get => QueryStateService.TargetTable; set => QueryStateService.TargetTable = value ?? ""; }
    private Dictionary<string, string?> UpdateMappings => QueryStateService.UpdateMappings;
    private bool IsTargetTableDropdownOpen = false;
    private string TargetTableSearch = "";
    private bool IsColumnMappingOpen = true;
    
    
    // List (not HashSet) preserves insertion order — first selected table becomes the JOIN root
    private List<string> SelectedColumns { get => QueryStateService.SelectedColumns; set => QueryStateService.SelectedColumns = value; }
    private string GeneratedSql = "-- Select columns on the left to generate a query.";
    private bool HasOneToMany = false;
    private List<string>? OptimalTableOrder = null;
    private HashSet<string> IgnoredRoutingTables => QueryStateService.IgnoredRoutingTables;
    private HashSet<string> IgnoredRoutingEdges => QueryStateService.IgnoredRoutingEdges;

    private Dictionary<string, List<AlternativeRoute>> AlternativeRoutes = new(StringComparer.OrdinalIgnoreCase);
    private bool IsCalculatingRoutes = false;
    private int _routeCalcId = 0;

    public class AlternativeRoute
    {
        public string TargetHub { get; set; } = "";
        public List<string> NewTables { get; set; } = new();
        public List<ExploreDB.Services.PathfinderJoinStep> NewSteps { get; set; } = new();
    }
    private PathfinderJoinPlan? LastJoinPlan;

    private IEnumerable<TableInfo> FilteredTables => SchemaService.Tables; // We filter columns inside

    private bool IsLoading = true;
    
    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        
        _searchColInput = SearchCol; // Sync initial value

        await Task.Yield();

        SchemaService.OnSchemaLoaded += Refresh;
        
        if (SelectedColumns.Count > 0 || !string.IsNullOrEmpty(TargetTable))
        {
            Generate();
        }
        
        IsLoading = false;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }



    private void ToggleColumn(string key, string tableName, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedColumns.Contains(key))
                SelectedColumns.Add(key);
        }
        else
        {
            SelectedColumns.Remove(key);
        }

        Generate();
    }

    private void ToggleTableColumns(TableInfo table, bool shouldSelect)
    {
        var keys = table.Columns
            .Select(col => GetColumnKey(table, col.Name))
            .ToList();

        if (shouldSelect)
        {
            foreach (var key in keys)
            {
                if (!SelectedColumns.Contains(key))
                    SelectedColumns.Add(key);
            }
        }
        else
        {
            var keySet = keys.ToHashSet();
            SelectedColumns.RemoveAll(keySet.Contains);
        }

        Generate();
    }

    private bool AreAllColumnsSelected(TableInfo table)
    {
        return table.Columns.Count > 0 &&
               table.Columns.All(col => SelectedColumns.Contains(GetColumnKey(table, col.Name)));
    }

    private string GetColumnKey(TableInfo table, string columnName)
    {
        return $"{table.FullName}.{columnName}";
    }

    private string GetTableCheckboxId(TableInfo table)
    {
        return $"table-{table.Schema}-{table.Name}"
            .Replace("[", "")
            .Replace("]", "")
            .Replace(".", "-")
            .Replace(" ", "-");
    }

    private void Generate()
    {
        OptimalTableOrder = null;

        if (CurrentMode == QueryMode.Select && SelectedColumns.Count == 0)
        {
            GeneratedSql = "-- Select columns on the left to generate a query.";
            HasOneToMany = false;
            LastJoinPlan = null;
            return;
        }
        else if (CurrentMode != QueryMode.Select && string.IsNullOrEmpty(TargetTable))
        {
            GeneratedSql = $"-- Select a Target Table to generate an {CurrentMode.ToString().ToUpper()} query.";
            HasOneToMany = false;
            LastJoinPlan = null;
            return;
        }

        var tables = SelectedColumns
            .Select(k => k.Substring(0, k.LastIndexOf('.')))
            .Distinct()
            .ToList();



        if (CurrentMode != QueryMode.Select && !string.IsNullOrEmpty(TargetTable))
        {
            if (!tables.Contains(TargetTable))
            {
                tables.Insert(0, TargetTable);
            }
            else
            {
                tables.Remove(TargetTable);
                tables.Insert(0, TargetTable);
            }
        }

        if (CurrentMode == QueryMode.Select)
        {
            var result = PathfinderService.GenerateQuery(tables, SelectedColumns.ToList(), IgnoredRoutingTables, IgnoredRoutingEdges);
            GeneratedSql = result.Sql;
            HasOneToMany = result.HasOneToMany;
            LastJoinPlan = result.JoinPlan;

            if (HasOneToMany && tables.Count > 1)
            {
                foreach (var candidate in tables.Skip(1))
                {
                    var testOrder = new List<string> { candidate };
                    testOrder.AddRange(tables.Where(t => t != candidate));

                    var plan = PathfinderService.GenerateJoinPlan(testOrder, ignoredRoutingTables: IgnoredRoutingTables, ignoredRoutingEdges: IgnoredRoutingEdges);
                    if (plan != null && string.IsNullOrEmpty(plan.ErrorMessage) && !plan.HasOneToMany && plan.UnreachableTables.Count == 0)
                    {
                        OptimalTableOrder = plan.Steps.Select(s => s.FullName).ToList();
                        OptimalTableOrder.Insert(0, plan.RootTable);
                        break;
                    }
                }
            }
        }
        else if (CurrentMode == QueryMode.Update)
        {
            var plan = PathfinderService.GenerateJoinPlan(tables, TargetTable, "t", "j", ignoredRoutingTables: IgnoredRoutingTables, ignoredRoutingEdges: IgnoredRoutingEdges);
            var result = PathfinderService.GenerateJoinedUpdateQuery(plan, UpdateMappings);
            GeneratedSql = result.Sql;
            HasOneToMany = result.HasOneToMany;
            LastJoinPlan = plan;
        }
        else if (CurrentMode == QueryMode.Delete)
        {
            var plan = PathfinderService.GenerateJoinPlan(tables, TargetTable, "t", "j");
            var result = PathfinderService.GenerateJoinedDeleteQuery(plan);
            GeneratedSql = result.Sql;
            HasOneToMany = result.HasOneToMany;
            LastJoinPlan = plan;
        }
        
        _ = CalculateAlternativeRoutesAsync();
    }

    private void SetMode(QueryMode mode)
    {
        CurrentMode = mode;
        Generate();
    }

    private void SelectTargetTable(string table)
    {
        TargetTable = table;
        IsTargetTableDropdownOpen = false;
        UpdateMappings.Clear();
        Generate();
    }

    private void ClearMappings()
    {
        UpdateMappings.Clear();
        Generate();
    }

    private void ConfirmResetMappings()
    {
        ClearMappings();
        ShowResetModal = false;
    }

    private void ToggleColumnMapping(string targetCol, bool isChecked)
    {
        if (isChecked)
        {
            MapColumn(targetCol, $"@set_{targetCol}");
        }
        else
        {
            MapColumn(targetCol, string.Empty);
        }
    }

    private void UpdateColumnMappingText(string targetCol, string? text)
    {
        if (string.IsNullOrEmpty(text))
        {
            MapColumn(targetCol, $"@set_{targetCol}");
        }
        else
        {
            MapColumn(targetCol, text);
        }
    }

    private void MapColumn(string targetCol, string? sourceCol)
    {
        if (string.IsNullOrEmpty(sourceCol))
        {
            UpdateMappings.Remove(targetCol);
        }
        else
        {
            UpdateMappings[targetCol] = sourceCol;
        }
        Generate();
    }

    private void ApplyOptimalOrder()
    {
        if (OptimalTableOrder == null) return;

        var newSelectedColumns = new List<string>();
        foreach (var table in OptimalTableOrder)
        {
            newSelectedColumns.AddRange(SelectedColumns.Where(c => c.StartsWith(table + ".")));
        }
        
        newSelectedColumns.AddRange(SelectedColumns.Where(c => !newSelectedColumns.Contains(c)));

        SelectedColumns = newSelectedColumns;
        Generate();
    }

    private void RemoveTable(string tableName)
    {
        TableToDelete = tableName;
        ShowDeleteModal = true;
    }

    private void ConfirmDelete()
    {
        if (!string.IsNullOrEmpty(TableToDelete))
        {
            SelectedColumns.RemoveAll(c => c.StartsWith(TableToDelete + "."));
            Generate();
        }
        ShowDeleteModal = false;
        TableToDelete = "";
    }

    private void ClearAll()
    {
        SelectedColumns.Clear();

        IgnoredRoutingTables.Clear();
        IgnoredRoutingEdges.Clear();
        AlternativeRoutes.Clear();
        UpdateMappings.Clear();
        TargetTable = "";
        GeneratedSql = "-- Select columns on the left to generate a query.";
        HasOneToMany = false;
        LastJoinPlan = null;
        ShowClearConfirmation = false;
        StateHasChanged();
    }

    private void ToggleIgnoreRoutingTable(string tableName)
    {
        if (!IgnoredRoutingTables.Add(tableName))
        {
            IgnoredRoutingTables.Remove(tableName);
        }
        Generate();
    }
    
    private void ToggleIgnoreRoutingEdge(string edgeKey)
    {
        if (!IgnoredRoutingEdges.Add(edgeKey))
        {
            IgnoredRoutingEdges.Remove(edgeKey);
        }
        Generate();
    }



    private void SelectAlternativeRoute(AlternativeRoute chosenRoute, string hubToBlock)
    {
        if (LastJoinPlan != null)
        {
            var hubSteps = LastJoinPlan.Steps.Where(s => 
                string.Equals(s.FullName, hubToBlock, StringComparison.OrdinalIgnoreCase) || 
                string.Equals(s.ConnectedFromTable, hubToBlock, StringComparison.OrdinalIgnoreCase));
                
            foreach (var step in hubSteps)
            {
                IgnoredRoutingEdges.Add(step.Key);
            }
        }
        
        
        if (AlternativeRoutes.TryGetValue(hubToBlock, out var routes))
        {
            foreach (var route in routes.Where(r => r != chosenRoute))
            {
                foreach (var step in route.NewSteps)
                {
                    IgnoredRoutingEdges.Add(step.Key);
                }
            }
        }
        
        Generate();
    }

    private async Task CalculateAlternativeRoutesAsync()
    {
        var calcId = ++_routeCalcId;
        AlternativeRoutes.Clear();
        if (LastJoinPlan == null) return;
        
        IsCalculatingRoutes = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(10); // yield for UI spinner
        
        var newRoutes = new Dictionary<string, List<AlternativeRoute>>(StringComparer.OrdinalIgnoreCase);
        
        await Task.Run(() => 
        {
            var currentSelected = SelectedColumns.Select(c => c.Substring(0, c.LastIndexOf('.'))).Distinct().ToList();

            
            if (CurrentMode != QueryMode.Select && !string.IsNullOrEmpty(TargetTable) && !currentSelected.Contains(TargetTable))
            {
                currentSelected.Add(TargetTable);
            }

            foreach (var step in LastJoinPlan.Steps.Where(s => !s.IsSelectedTable))
            {
                if (calcId != _routeCalcId) return; // Cancelled by newer request
                
                var tempIgnored = IgnoredRoutingTables.ToHashSet(StringComparer.OrdinalIgnoreCase);
                tempIgnored.Add(step.FullName);
                
                bool foundNewRoute = true;
                while (foundNewRoute)
                {
                    if (calcId != _routeCalcId) return; // Cancelled by newer request
                    foundNewRoute = false;
                    
                    var altPlan = PathfinderService.GenerateJoinPlan(currentSelected, CurrentMode != QueryMode.Select ? TargetTable : null, ignoredRoutingTables: tempIgnored, ignoredRoutingEdges: IgnoredRoutingEdges);
                    
                    if (altPlan != null && string.IsNullOrEmpty(altPlan.ErrorMessage) && altPlan.UnreachableTables.Count == 0)
                    {
                        var newSteps = altPlan.Steps.Where(s => !LastJoinPlan.Steps.Any(ls => ls.Key == s.Key)).ToList();
                        var newTables = altPlan.Steps.Select(s => s.FullName).Except(LastJoinPlan.Steps.Select(s => s.FullName)).Except(new[] { altPlan.RootTable }).ToList();
                        
                        if (newTables.Count > 0)
                        {
                            if (!newRoutes.ContainsKey(step.FullName)) newRoutes[step.FullName] = new();
                            
                            var isDuplicate = newRoutes[step.FullName].Any(r => r.NewTables.SequenceEqual(newTables));
                            if (!isDuplicate)
                            {
                                newRoutes[step.FullName].Add(new AlternativeRoute { TargetHub = step.FullName, NewTables = newTables, NewSteps = newSteps });
                                foundNewRoute = true;
                                foreach (var nt in newTables) tempIgnored.Add(nt);
                            }
                        }
                    }
                }
            }
        });
        
        if (calcId == _routeCalcId)
        {
            AlternativeRoutes = newRoutes;
            IsCalculatingRoutes = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string CopyLabel = "Copy";

    private void RunInRunner()
    {
        if (QueryStateService.Tabs.Count >= Config.GetValue<int>("MaxOpenTabs", 20))
        {
            ShowLimitAlert = true;
            return;
        }

        var newTab = new ExploreDB.Services.QueryTab 
        { 
            Name = "Generated_Query.sql",
            Content = GeneratedSql
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        Navigation.NavigateTo("/runner");
    }

    private async Task CopySql()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", GeneratedSql);
        CopyLabel = "Copied! ✓";
        StateHasChanged();
        await Task.Delay(1500);
        CopyLabel = "Copy";
        StateHasChanged();
    }

    public void Dispose()
    {
        SchemaService.OnSchemaLoaded -= Refresh;
    }

    private void MoveTable(string table, int direction)
    {
        var tables = SelectedColumns
            .Select(k => k.Substring(0, k.LastIndexOf('.')))
            .Distinct()
            .ToList();
            
        int index = tables.IndexOf(table);
        if (index < 0) return;
        
        int newIndex = index + direction;
        if (newIndex < 0 || newIndex >= tables.Count) return;
        
        tables.RemoveAt(index);
        tables.Insert(newIndex, table);
        
        var newSelectedColumns = new List<string>();
        foreach (var t in tables)
        {
            newSelectedColumns.AddRange(SelectedColumns.Where(c => c.StartsWith(t + ".")));
        }
        
        SelectedColumns = newSelectedColumns;
        Generate();
    }
