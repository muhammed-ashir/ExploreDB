    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        await Task.Yield();
        
        var decoded = Uri.UnescapeDataString(FullName);
        Fn = SchemaService.Functions.FirstOrDefault(s => s.FullName.Equals(decoded, StringComparison.OrdinalIgnoreCase));
        
        if (Fn != null && !Fn.AreDependenciesLoaded)
        {
            await SchemaService.LoadFunctionDependenciesAsync(Fn.FullName);
        }

        DependencySearchTerm = string.Empty;
        


        IsLoading = false;
        
        ActiveTab = "Parameters";

        if (Fn != null)
        {
            FilterParams();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("scrollToMainTop"); } catch { }
        }
    }

    private void FilterParams()
    {
        if (Fn == null) return;
        
        if (string.IsNullOrWhiteSpace(ParamSearchTerm))
        {
            VisibleParams = Fn.Parameters.ToList();
            return;
        }

        var comparison = ParamCaseSensitive ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
        var query = ParamSearchTerm.Trim();

        VisibleParams = Fn.Parameters.Where(p =>
        {
            if (ParamExactMatch)
            {
                return p.Name.Equals(query, comparison);
            }
            if (ParamMatchWholeWord)
            {
                var regexOpts = ParamCaseSensitive ? RegexOptions.None : RegexOptions.IgnoreCase;
                return Regex.IsMatch(p.Name, $@"\b{Regex.Escape(query)}\b", regexOpts);
            }

            return p.Name.Contains(query, comparison);
        }).ToList();
    }

    private async Task SetActiveTab(string tab)
    {
        ActiveTab = tab;
        if (tab == "Definition" && Fn != null && !Fn.IsDefinitionLoaded && !IsDefinitionLoading)
        {
            IsDefinitionLoading = true;
            await SchemaService.LoadDefinitionAsync(Fn.FullName);
            IsDefinitionLoading = false;
        }
        if (tab == "Definition" && _definitionEditor != null && Fn?.Definition != null)
        {
            await _definitionEditor.SetValue(Fn.Definition);
        }
    }

