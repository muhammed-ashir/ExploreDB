    private async Task CopyDefinition()
    {
        if (string.IsNullOrEmpty(Fn?.Definition)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Fn.Definition);
        DefinitionCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        DefinitionCopied = false;
    }

    private async Task LoadAndRunQuery(string queryText, string tabName)
    {
        if (QueryStateService.Tabs.Count >= Config.GetValue<int>("MaxOpenTabs", 20))
        {
            ShowLimitAlert = true;
            return;
        }

        var newCount = QueryStateService.Tabs.Count + 1;
        var newTab = new ExploreDB.Services.QueryTab 
        { 
            Name = tabName,
            Content = queryText
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        await QueryStateService.SaveTabsAsync();
        
        Navigation.NavigateTo("/runner");
    }

    private void NavigateBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/functions");
    }

    private string BuildDependencyLink(Dependency dependency)
    {
        var isProc = dependency.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) || dependency.Type == "SP";
        var isFunc = dependency.Type == "Function";
        var isType = dependency.Type == "Type";
        var prefix = isProc ? "/proc" : (isFunc ? "/function" : (isType ? "/type" : (dependency.Type == "View" ? "/view" : "/table")));
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(dependency.FullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private async Task CopyExecStatement()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ExecStatement);
            Copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            Copied = false;
            StateHasChanged();
        }
        catch { }
    }

    private string ExecStatement
    {
        get
        {
            if (Fn == null) return string.Empty;

            var isScalar = Fn.FunctionType.Contains("Scalar", StringComparison.OrdinalIgnoreCase);
            var sb = new System.Text.StringBuilder();

            if (isScalar)
            {
                sb.Append($"SELECT {Fn.FullName}(");
            }
            else
            {
                sb.Append($"SELECT * FROM {Fn.FullName}(");
            }

            var allParams = Fn.Parameters.ToList();
            for (int i = 0; i < allParams.Count; i++)
            {
                var p = allParams[i];
                var isLast = i == allParams.Count - 1;
                var comma = isLast ? "" : ", ";

                string placeholder = $"/* {p.Name} ({p.DisplayType}) */";
                sb.Append($"{placeholder}{comma}");
            }
            
            sb.Append(");");
            return sb.ToString();
        }
    }
