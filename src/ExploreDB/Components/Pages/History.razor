@page "/history"
@using ExploreDB.Services
@using BlazorMonaco.Editor
@using BlazorMonaco
@using Microsoft.JSInterop
@using Microsoft.Extensions.Configuration
@inject HistoryService HistoryService
@inject NavigationManager Nav
@inject QueryStateService QueryStateService
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject ThemeService ThemeService
@implements IDisposable

<div class="container-fluid d-flex flex-column" style="height: calc(100vh - 140px); padding-bottom: 20px;">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h4 class="m-0" style="color: var(--app-text);">Query History</h4>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary shadow-sm" style="color: var(--app-text); border-color: var(--app-border);" @onclick='() => Nav.NavigateTo("/runner")'>
                <i class="bi bi-arrow-left me-1"></i> Back
            </button>
        </div>
    </div>

    <div class="row flex-grow-1 overflow-hidden" style="min-height: 500px;">
        <!-- Left Pane: Tabs List -->
        <div class="col-md-4 d-flex flex-column h-100">
            <div class="card shadow-sm h-100" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="card-header py-2" style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border); color: var(--app-text);">
                    <h6 class="m-0 mb-2" style="color: var(--app-text);">Past Tabs</h6>
                    <div class="d-flex align-items-center w-100">
                        <CustomDatePicker @bind-Value="_filterDate" />
                    </div>
                </div>
                <div class="card-body p-0 overflow-auto">
                    <div class="list-group list-group-flush">
                        @if (FilteredHistoryItems == null)
                        {
                            <div class="p-4 text-center text-muted">
                                <div class="spinner-border spinner-border-sm text-primary mb-2"></div><br/>
                                Loading...
                            </div>
                        }
                        else if (!FilteredHistoryItems.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-clock-history fs-2 mb-2 d-block text-secondary opacity-50"></i>
                                @if (_filterDate.HasValue) { <span>No history for this date.</span> } else { <span>No history found.</span> }
                            </div>
                        }
                        else
                        {
                            foreach (var item in FilteredHistoryItems)
                            {
                                bool isSelected = _selectedItem?.Id == item.Id;
                                <button type="button" 
                                        class="list-group-item list-group-item-action py-3 history-item @(isSelected ? "history-item-selected" : "")" 
                                        style="border-bottom: 1px solid var(--app-border) !important;" 
                                        @onclick="() => SelectItem(item)">
                                    <div class="fw-bold history-item-title text-truncate mb-1" style="font-size: 0.95rem;">
                                        @(string.IsNullOrWhiteSpace(item.TabName) ? "SQLQuery.sql" : item.TabName)
                                    </div>
                                    <div class="history-item-subtitle text-truncate text-muted" style="font-size: 0.85rem;" title="@($"{item.ExecutedAt:h:mm tt} - {GetRelativeTime(item.ExecutedAt)}")">
                                        @item.ExecutedAt.ToString("h:mm tt") - @GetRelativeTime(item.ExecutedAt)
                                    </div>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Pane: Script Viewer -->
        <div class="@(IsFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-4 p-md-5 d-flex flex-column" : "col-md-8 h-100 d-flex flex-column")" style="@(IsFullScreen ? "z-index: 1050; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px);" : "")">
            <div class="card shadow-sm flex-grow-1 d-flex flex-column overflow-hidden @(IsFullScreen ? "shadow-lg border-2" : "")" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="card-header py-2 d-flex justify-content-between align-items-center" style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border); color: var(--app-text);">
                    <h6 class="m-0 text-truncate" style="color: var(--app-text);">
                        @(_selectedItem != null ? (!string.IsNullOrWhiteSpace(_selectedItem.TabName) ? _selectedItem.TabName : "Tab Details") : "Tab Details")
                    </h6>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" style="color: var(--app-text); border-color: var(--app-border);" disabled="@(_selectedItem == null)" @onclick="CopyQueryAsync" title="Copy script to clipboard">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                        <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" disabled="@(_selectedItem == null)" @onclick="LoadAndRunQuery" title="Open this tab in Query Runner">
                            <i class="bi bi-play-fill"></i> Load
                        </button>
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center" style="color: var(--app-text); border-color: var(--app-border);" @onclick="() => IsFullScreen = !IsFullScreen" title="@(IsFullScreen ? "Restore Down" : "Expand to Full Screen")">
                            <i class="bi @(IsFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0 flex-grow-1 d-flex flex-column position-relative" style="min-height: 0;">
                    @if (_selectedItem == null)
                    {
                        <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                            <div class="text-center">
                                Select a tab from the history list to view its script.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex-grow-1 w-100 h-100" style="min-height: 0;">
                            <StandaloneCodeEditor @ref="_editor" Id="history-editor" CssClass="w-100 h-100" ConstructionOptions="EditorConstructionOptions" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-header" style="border-bottom: 1px solid var(--app-border);">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "")" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--app-border);">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TabHistoryItem>? _historyItems;
    private TabHistoryItem? _selectedItem;
    private StandaloneCodeEditor _editor = default!;
    private bool IsFullScreen = false;
    private bool ShowLimitAlert = false;
    private DateTime? _filterDate = null;
    private IEnumerable<TabHistoryItem>? FilteredHistoryItems => 
        _filterDate.HasValue && _historyItems != null
            ? _historyItems.Where(x => x.ExecutedAt.Date == _filterDate.Value.Date)
            : _historyItems;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        _historyItems = await HistoryService.GetHistoryAsync();
        if (_historyItems != null && _historyItems.Count > 0)
        {
            _selectedItem = _historyItems[0];
        }
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "sql",
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            Value = _selectedItem?.ScriptText ?? "",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "on",
            ReadOnly = true,
            ScrollBeyondLastLine = false,
            FontSize = 14,
            OverviewRulerBorder = false,
            HideCursorInOverviewRuler = true,
            FixedOverflowWidgets = true,
            Scrollbar = new EditorScrollbarOptions { UseShadows = false }
        };
    }

    private async Task SelectItem(TabHistoryItem item)
    {
        _selectedItem = item;
        if (_editor != null)
        {
            await _editor.SetValue(item.ScriptText);
        }
    }

    private async Task LoadAndRunQuery()
    {
        if (QueryStateService.Tabs.Count >= Config.GetValue<int>("MaxOpenTabs", 20))
        {
            ShowLimitAlert = true;
            return;
        }

        if (_selectedItem != null && !string.IsNullOrWhiteSpace(_selectedItem.ScriptText))
        {
            string baseName = !string.IsNullOrWhiteSpace(_selectedItem.TabName) ? _selectedItem.TabName : "SQLQuery1.sql";
            string uniqueName = baseName;
            int copyIndex = 1;
            while (QueryStateService.Tabs.Any(t => t.Name.Equals(uniqueName, StringComparison.OrdinalIgnoreCase)))
            {
                var dot = baseName.LastIndexOf('.');
                if (dot > 0)
                {
                    uniqueName = $"{baseName[..dot]} ({copyIndex}){baseName[dot..]}";
                }
                else
                {
                    uniqueName = $"{baseName} ({copyIndex})";
                }
                copyIndex++;
            }
            
            var newTab = new ExploreDB.Services.QueryTab 
            { 
                Name = uniqueName,
                Content = _selectedItem.ScriptText,
                ConnectionString = _selectedItem.ConnectionString,
                ConnectionName = _selectedItem.ConnectionName
            };
            QueryStateService.Tabs.Add(newTab);
            QueryStateService.ActiveTabId = newTab.Id;
            await QueryStateService.SaveTabsAsync();
            
            Nav.NavigateTo("/runner");
        }
    }

    private async Task CopyQueryAsync()
    {
        if (_selectedItem != null && !string.IsNullOrEmpty(_selectedItem.ScriptText))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _selectedItem.ScriptText);
        }
    }

    private string GetRelativeTime(DateTime executedAt)
    {
        var ts = DateTime.Now - executedAt;
        if (ts.TotalSeconds < 60) return "Just now";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m ago";
        if (ts.TotalHours < 24) return $"{(int)ts.TotalHours}h ago";
        if (ts.TotalDays < 30) return $"{(int)ts.TotalDays}d ago";
        return executedAt.ToString("MMM dd");
    }

    private async void HandleThemeChanged()
    {
        try
        {
            await JS.InvokeVoidAsync("setAppTheme", ThemeService.CurrentTheme);
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
