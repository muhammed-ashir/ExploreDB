    private async Task StartComparisonAsync()
    {
        _errorMessage = "";

        // Validate endpoints
        if (_source.Type == EndpointType.LiveDatabase && string.IsNullOrWhiteSpace(_source.Database))
        {
            _errorMessage = "Please specify a Source database name.";
            return;
        }
        if (_source.Type == EndpointType.DacpacFile && (string.IsNullOrWhiteSpace(_source.DacpacPath) || !File.Exists(_source.DacpacPath)))
        {
            _errorMessage = "The Source .dacpac file was not found.";
            return;
        }
        if (_target.Type == EndpointType.LiveDatabase && string.IsNullOrWhiteSpace(_target.Database))
        {
            _errorMessage = "Please specify a Target database name.";
            return;
        }
        if (_target.Type == EndpointType.DacpacFile && (string.IsNullOrWhiteSpace(_target.DacpacPath) || !File.Exists(_target.DacpacPath)))
        {
            _errorMessage = "The Target .dacpac file was not found.";
            return;
        }

        _isComparing = true;
        _elapsedTimeFormatted = "00:00";
        _comparisonProgressPercent = 0;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        // Calculate pre-flight duration estimate
        try
        {
            _estimate = await ComparisonService.EstimateDurationAsync(_source, _target, _cts.Token);
        }
        catch
        {
            _estimate = new ComparisonEstimate { EstimatedSeconds = ComparisonService.IsEngineWarm ? 35 : 65 };
        }
        StateHasChanged();

        using var timerCts = new CancellationTokenSource();
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        var estimatedSec = Math.Max(10.0, (double)(_estimate?.EstimatedSeconds ?? 35));

        _ = Task.Run(async () =>
        {
            while (!timerCts.Token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(200, timerCts.Token);
                    var ts = stopwatch.Elapsed;
                    _elapsedTimeFormatted = $"{(int)ts.TotalMinutes:D2}:{ts.Seconds:D2}";

                    // Smooth Ease-Out Continuous Curve:
                    // Progresses continuously from 0% toward ~85% by estimated time,
                    // smoothly decelerating toward 95% if taking longer.
                    double ratio = ts.TotalSeconds / estimatedSec;
                    double curve = 1.0 - Math.Exp(-2.0 * ratio);
                    int calculatedPercent = Math.Clamp((int)Math.Round(curve * 94.0), 0, 95);
                    if (calculatedPercent > _comparisonProgressPercent)
                    {
                        _comparisonProgressPercent = calculatedPercent;
                    }

                    await InvokeAsync(StateHasChanged);
                }
                catch { break; }
            }
        }, timerCts.Token);

        try
        {
            var result = await ComparisonService.CompareAsync(_source, _target, _options, null, _cts.Token);

            if (_cts?.IsCancellationRequested == true || result == null || result.IsCancelled)
            {
                _errorMessage = "";
                _result = null;
                if (_cts?.IsCancellationRequested == true || result?.IsCancelled == true)
                {
                    ShowToast("Comparison was cancelled.", "info", "bi-info-circle-fill");
                }
                return;
            }

            _comparisonProgressPercent = 100;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(250);

            _result = result;

            // Populate category filter list
            _availableCategories = new List<string> { "All" };
            var cats = _result.Differences.Select(d => d.CategoryDisplayName).Distinct().OrderBy(c => c);
            _availableCategories.AddRange(cats);

            // Pre-select first difference item if any
            _selectedItem = _result.Differences.FirstOrDefault(d => d.HasDifference) ?? _result.Differences.FirstOrDefault();
            await UpdateDiffContentAsync();
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "";
            _result = null;
            ShowToast("Comparison was cancelled.", "info", "bi-info-circle-fill");
        }
        catch (Exception ex)
        {
            if (_cts?.IsCancellationRequested == true)
            {
                _errorMessage = "";
                _result = null;
                ShowToast("Comparison was cancelled.", "info", "bi-info-circle-fill");
            }
            else
            {
                _errorMessage = $"Comparison failed: {ex.Message}";
                _result = null;
            }
        }
        finally
        {
            timerCts.Cancel();
            stopwatch.Stop();
            _isComparing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelComparison()
    {
