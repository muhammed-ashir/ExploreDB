    private async Task NavigateToObjectDeltaAsync(int delta)
    {
        var list = FilteredDifferences.ToList();
        if (list.Count == 0) return;

        int currentIndex = _selectedItem != null ? list.FindIndex(d => d.Id == _selectedItem.Id) : -1;
        var hasDiffs = list.Any(d => d.HasDifference);
        int targetIndex = currentIndex;

        for (int step = 1; step <= list.Count; step++)
        {
            int candidate = (currentIndex + (delta * step)) % list.Count;
            if (candidate < 0) candidate += list.Count;

            if (!hasDiffs || list[candidate].HasDifference)
            {
                targetIndex = candidate;
                break;
            }
        }

        if (targetIndex >= 0 && targetIndex < list.Count && targetIndex != currentIndex)
        {
            await SelectDiffItem(list[targetIndex]);
            await InvokeAsync(StateHasChanged);
        }
        else if (currentIndex < 0 && list.Count > 0)
        {
            var first = list.FirstOrDefault(d => d.HasDifference) ?? list[0];
            await SelectDiffItem(first);
            await InvokeAsync(StateHasChanged);
        }
    }

