    private async Task UpdateDiffContentAsync()
    {
        if (!_isDiffEditorReady || _diffEditor == null) return;

        var sourceScript = _selectedItem != null && !string.IsNullOrWhiteSpace(_selectedItem.SourceScript)
            ? _selectedItem.SourceScript
            : (_selectedItem != null ? "-- Object does not exist in source database." : "");

        var targetScript = _selectedItem != null && !string.IsNullOrWhiteSpace(_selectedItem.TargetScript)
            ? _selectedItem.TargetScript
            : (_selectedItem != null ? "-- Object does not exist in target database." : "");

        try
        {
            if (_originalModel == null || _modifiedModel == null)
            {
                _originalModel = await Global.CreateModel(JS, sourceScript, "sql");
                _modifiedModel = await Global.CreateModel(JS, targetScript, "sql");
                await _diffEditor.SetModel(new DiffEditorModel
                {
                    Original = _originalModel,
                    Modified = _modifiedModel
                });
            }
            else
            {
                await _originalModel.SetValue(sourceScript);
                await _modifiedModel.SetValue(targetScript);
            }

            await JS.InvokeVoidAsync("initSqlDiffNavigator", "sql-diff-editor");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[SqlCompare] Error updating diff editor: {ex.Message}");
        }
    }

