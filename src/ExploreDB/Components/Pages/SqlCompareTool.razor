@page "/tools/sql-compare"
@using ExploreDB.Services
@using ExploreDB.Services.SqlCompare
@using ExploreDB.Services.SqlCompare.Models
@using BlazorMonaco.Editor
@using BlazorMonaco
@using System.IO
@using System.Threading
@inject ISchemaComparisonService ComparisonService
@inject IHtmlReportGenerator HtmlGenerator
@inject SchemaService SchemaService
@inject ConnectionService ConnectionService
@inject QueryStateService QueryStateService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject ToolRegistryService ToolService
@inject WindowManagerService WindowManager
@implements IDisposable

<div class="container-fluid h-100 d-flex flex-column pb-4">
    <!-- Header (Hidden during comparison loading screen) -->
    @if (!_isComparing)
    {
        <!-- Title Row: SQL Compare (Left) + New Comparison / Back to Tools (Right) -->
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h3 class="fw-bold mb-0" style="color: var(--app-text);">SQL Compare</h3>
            @if (_result != null)
            {
                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm"
                        style="color: var(--app-text); border-color: var(--app-border);"
                        @onclick="ResetComparison"
                        title="Configure a new comparison">
                    <i class="bi bi-arrow-left"></i>
                    <span>New Comparison</span>
                </button>
            }
            else if (!IsPopout)
            {
                <a href="tools" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" style="color: var(--app-text); border-color: var(--app-border);">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Tools</span>
                </a>
            }
        </div>

        @if (_result != null)
        {
            <!-- Subtitle / Action Row: Source & Target Endpoints (Left) + Action Buttons (Right) -->
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                <span class="text-muted small d-inline-flex align-items-center flex-wrap gap-1">
                    <span>Source:</span>
                    <strong style="color: var(--app-text); cursor: pointer;"
                            data-bs-tooltip="true"
                            data-bs-placement="bottom"
                            data-bs-html="true"
                            data-bs-title="@GetEndpointTooltipHtml(_result.SourceEndpoint)">
                        @GetEndpointDisplayName(_result.SourceEndpoint)
                    </strong>

                    <i class="bi bi-arrow-right mx-1 text-primary"></i>

                    <span>Target:</span>
                    <strong style="color: var(--app-text); cursor: pointer;"
                            data-bs-tooltip="true"
                            data-bs-placement="bottom"
                            data-bs-html="true"
                            data-bs-title="@GetEndpointTooltipHtml(_result.TargetEndpoint)">
                        @GetEndpointDisplayName(_result.TargetEndpoint)
                    </strong>
                </span>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm"
                            @onclick="CopySyncScriptAsync"
                            title="Copy generated synchronization script">
                        <i class="bi @(_isScriptCopied ? "bi-check-lg text-success" : "bi-clipboard")"></i>
                        <span>@(_isScriptCopied ? "Script Copied!" : "Copy Script")</span>
                    </button>

                    <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm"
                            @onclick="ExportHtmlReportAsync"
                            title="Export standalone offline HTML diff report">
                        <i class="bi bi-filetype-html"></i>
                        <span>Export HTML</span>
                    </button>

                    <button class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 shadow-sm px-3"
                            @onclick="OpenInQueryRunnerAsync"
                            title="Open synchronization script in Query Runner">
                        <i class="bi bi-play-circle"></i>
                        <span>Open in Query Runner</span>
                    </button>
                </div>
            </div>
        }
    }

    @if (_isComparing)
    {
        <!-- Comparison Progress Screen -->
        <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center p-4">
            <div class="card p-4 rounded-3 shadow text-center" style="background-color: var(--app-surface); border: 1px solid var(--app-border); max-width: 520px; width: 100%;">
                <h5 class="fw-bold mb-4" style="color: var(--app-text);">Comparing Database Schemas</h5>

                <!-- Animated Progress Bar -->
                <div class="progress mb-3" style="height: 8px; background-color: var(--app-surface-secondary); border-radius: 4px; overflow: hidden;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                         role="progressbar"
                         style="width: @(_comparisonProgressPercent)%; transition: width 0.3s ease-out;">
                    </div>
                </div>

                <!-- Timer & Estimation Row -->
                <div class="d-flex align-items-center justify-content-between text-muted small mb-4 px-1" style="font-size: 0.82rem;">
                    <span>
                        Elapsed: <strong style="color: var(--app-text);">@_elapsedTimeFormatted</strong>
                    </span>
                    @if (_estimate != null)
                    {
                        <span>
                            Est: <strong style="color: var(--app-text);">~@_estimate.FormattedEstimate</strong>
                        </span>
                    }
                </div>

                <button class="btn btn-sm btn-outline-danger align-self-center px-4" @onclick="CancelComparison">
                    Cancel
                </button>
            </div>
        </div>
    }
    else if (_result == null)
    {
        <!-- Setup & Connection Screen -->
        <div class="row g-4 align-content-start">
            <!-- Left: Source Endpoint -->
            <div class="col-12 col-lg-6">
                <div class="card p-4 rounded-3 shadow-sm h-100" style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                    <div class="mb-3 border-bottom pb-2" style="border-color: var(--app-border) !important;">
                        <h6 class="fw-bold mb-0 text-primary">Source</h6>
                    </div>

                    <div class="mb-3">
                        <div class="btn-group btn-group-sm shadow-sm">
                            <button type="button" class="btn @(_source.Type == EndpointType.LiveDatabase ? "btn-primary" : "btn-outline-secondary") btn-sm"
                                    @onclick="() => _source.Type = EndpointType.LiveDatabase">
                                Database
                            </button>
                            <button type="button" class="btn @(_source.Type == EndpointType.DacpacFile ? "btn-primary" : "btn-outline-secondary") btn-sm"
                                    @onclick="() => _source.Type = EndpointType.DacpacFile">
                                .dacpac File
                            </button>
                        </div>
                    </div>

                    @if (_source.Type == EndpointType.LiveDatabase)
                    {
                        <div class="position-relative mb-3">
                            <label class="form-label small fw-bold mb-1" style="color: var(--app-text);">Connection Profile</label>
                            <div class="form-control form-control-sm d-flex align-items-center justify-content-between cursor-pointer shadow-sm"
                                 style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border); cursor: pointer;"
                                 @onclick="ToggleSourceDropdown">
                                <span class="text-truncate me-2">@GetSelectedProfileDisplayName(_sourceProfileId, _source)</span>
                                <i class="bi @(_isSourceProfileDropdownOpen ? "bi-chevron-up" : "bi-chevron-down") flex-shrink-0 text-muted" style="font-size: 0.75rem;"></i>
                            </div>

                            @if (_isSourceProfileDropdownOpen)
                            {
                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseSourceDropdown"></div>
                                <div class="dropdown-menu show shadow-lg p-2 mt-1 rounded-3"
                                     style="position: absolute; top: 100%; left: 0; z-index: 1050; width: 100%; min-width: 320px; background-color: var(--app-dropdown-bg); color: var(--app-text); border: 1px solid var(--app-border);">
                                    <div class="mb-2">
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                               placeholder="Search connections..."
                                               @bind="_sourceSearchTerm"
                                               @bind:event="oninput"
                                               @onclick:stopPropagation />
                                    </div>
                                    <div class="custom-scrollbar-light custom-scrollbar-solid-track" style="max-height: 250px; overflow-y: auto;">
                                        @if (string.IsNullOrEmpty(_sourceSearchTerm) || "active session".Contains(_sourceSearchTerm, StringComparison.OrdinalIgnoreCase) || GetActiveServerDisplayName().Contains(_sourceSearchTerm, StringComparison.OrdinalIgnoreCase))
                                        {
                                            var isActiveSelected = _sourceProfileId == "active";
                                            <div class="dropdown-item p-2 mb-1 rounded-2 @(isActiveSelected ? "bg-primary text-white" : "") @(!SchemaService.IsDatabaseConnected ? "opacity-50" : "")"
                                                 style="cursor: @(!SchemaService.IsDatabaseConnected ? "not-allowed" : "pointer");"
                                                 @onclick='async () => { if (SchemaService.IsDatabaseConnected) await SelectSourceProfile("active"); }'>
                                                <div class="d-flex flex-column text-truncate" style="min-width: 0;">
                                                    <span class="fw-semibold text-truncate" style="font-size: 0.85rem;">Active Session</span>
                                                    <span class="small @(isActiveSelected ? "text-white-50" : "text-muted") text-truncate" style="font-size: 0.72rem;">@GetActiveServerDisplayName()</span>
                                                </div>
                                            </div>
                                        }

                                        @{
                                            var filteredSourceSaved = ConnectionService.SavedConnections
                                                .Where(c => string.IsNullOrEmpty(_sourceSearchTerm) ||
                                                            (!string.IsNullOrEmpty(c.Name) && c.Name.Contains(_sourceSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                                            (!string.IsNullOrEmpty(c.Server) && c.Server.Contains(_sourceSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                                            (!string.IsNullOrEmpty(c.Database) && c.Database.Contains(_sourceSearchTerm, StringComparison.OrdinalIgnoreCase)))
                                                .ToList();
                                        }

                                        @if (filteredSourceSaved.Any())
                                        {
                                            <div class="px-2 py-1 small fw-bold text-muted text-uppercase mt-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                                Saved Connections
                                            </div>

                                            @foreach (var c in filteredSourceSaved)
                                            {
                                                var isSelected = _sourceProfileId == c.Id;
                                                var capturedId = c.Id;
                                                <div class="dropdown-item p-2 mb-1 rounded-2 @(isSelected ? "bg-primary text-white" : "")"
                                                     style="cursor: pointer;"
                                                     @onclick="async () => await SelectSourceProfile(capturedId)">
                                                    <div class="d-flex flex-column text-truncate" style="min-width: 0;">
                                                        <span class="fw-semibold text-truncate" style="font-size: 0.85rem;">@(string.IsNullOrWhiteSpace(c.Name) ? c.Server : c.Name)</span>
                                                        <span class="small @(isSelected ? "text-white-50" : "text-muted") text-truncate" style="font-size: 0.72rem;">@c.Server</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <hr class="dropdown-divider border-secondary my-2">
                                    <button type="button" class="dropdown-item text-info text-center py-2 rounded-2 fw-medium"
                                            style="border: 1px dashed var(--bs-info); width: calc(100% - 8px); margin: 0 4px;"
                                            @onclick='async () => await SelectSourceProfile("custom")'>
                                        <i class="bi bi-plus-lg me-1"></i> New Connection
                                    </button>
                                </div>
                            }
                        </div>

                        @if (_sourceProfileId == "custom")
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold" style="color: var(--app-text);">Server</label>
                                <input type="text" class="form-control form-control-sm"
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_source.Server" placeholder="localhost or server\instance" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold" style="color: var(--app-text);">Authentication</label>
                                <select class="form-select form-select-sm"
                                        style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                        @bind="_source.AuthType">
                                    <option value="Windows">Windows Authentication</option>
                                    <option value="SqlServer">SQL Server Authentication</option>
                                    <option value="EntraMfa">Microsoft Entra MFA</option>
                                </select>
                            </div>

                            @if (_source.AuthType != "Windows")
                            {
                                <div class="row g-2 mb-3">
                                    <div class="@(_source.AuthType == "SqlServer" ? "col-6" : "col-12")">
                                        <label class="form-label small fw-bold" style="color: var(--app-text);">@(_source.AuthType == "EntraMfa" ? "Username / Email" : "Username")</label>
                                        <input type="text" class="form-control form-control-sm"
                                               style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                               placeholder="@(_source.AuthType == "EntraMfa" ? "user@domain.com" : "sa")"
                                               @bind="_source.Username" />
                                    </div>
                                    @if (_source.AuthType == "SqlServer")
                                    {
                                        <div class="col-6">
                                            <label class="form-label small fw-bold" style="color: var(--app-text);">Password</label>
                                            <input type="password" class="form-control form-control-sm"
                                                   style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                                   @bind="_source.Password" />
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="mb-3 p-2 px-3 rounded-2" style="background-color: var(--app-input-bg); border: 1px solid var(--app-border);">
                                <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                                    <div class="d-flex align-items-center gap-2 overflow-hidden text-truncate me-3" style="min-width: 0;">
                                        <i class="bi bi-hdd-network text-primary flex-shrink-0" style="width: 16px; text-align: center;"></i>
                                        <span class="fw-semibold text-truncate" style="font-size: 0.85rem; color: var(--app-text);" title="@_source.Server">@_source.Server</span>
                                    </div>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none flex-shrink-0 text-nowrap d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;" @onclick='() => _sourceProfileId = "custom"'>
                                        <i class="bi bi-pencil"></i><span>Edit</span>
                                    </button>
                                </div>
                                <div class="text-muted small" style="font-size: 0.75rem; line-height: 1.4;">
                                    <div class="d-flex align-items-center gap-2 text-truncate me-3" style="min-width: 0;">
                                        <i class="bi bi-shield-check opacity-75 flex-shrink-0" style="width: 16px; text-align: center;"></i>
                                        <span class="text-truncate">@GetAuthDisplayName(_source.AuthType)</span>
                                    </div>
                                    @if (_source.AuthType != "Windows" && !string.IsNullOrWhiteSpace(_source.Username))
                                    {
                                        <div class="d-flex align-items-center gap-2 mt-1 text-truncate me-3" style="min-width: 0;">
                                            <i class="bi bi-person opacity-75 flex-shrink-0" style="width: 16px; text-align: center;"></i>
                                            <span class="text-truncate" title="@_source.Username">@_source.Username</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mb-3 position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0" style="color: var(--app-text);">Database</label>
                                <button class="btn btn-link btn-sm p-0 text-decoration-none" style="font-size: 0.75rem;" @onclick="LoadSourceDatabasesAsync" disabled="@_isSourceDbLoading">
                                    <i class="bi @(_isSourceDbLoading ? "bi-arrow-clockwise spinner-border spinner-border-sm border-0" : "bi-arrow-clockwise")"></i> Refresh DBs
                                </button>
                            </div>
                            @if (_sourceDatabases.Count > 0)
                            {
                                <div class="position-relative">
                                    <input class="form-control form-control-sm pe-4 text-truncate"
                                           @bind="_sourceDbSearch"
                                           @bind:event="oninput"
                                           placeholder="@(!string.IsNullOrWhiteSpace(_source.Database) ? _source.Database : "Search database...")"
                                           @onfocus="OpenSourceDbDropdown"
                                           @onclick="OpenSourceDbDropdown"
                                           @onkeydown="OnSourceDbSearchKeyDown"
                                           style="cursor: pointer; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />

                                    @if (_isSourceDbDropdownOpen)
                                    {
                                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseSourceDbDropdown"></div>
                                        <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track"
                                             style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 220px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                                            @if (_isSourceDbLoading)
                                            {
                                                <div class="p-3 text-center text-info">
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                    <small>Loading databases...</small>
                                                </div>
                                            }
                                            else
                                            {
                                                var filtered = _sourceDatabases.Where(d => string.IsNullOrWhiteSpace(_sourceDbSearch) || d.Contains(_sourceDbSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                                                if (filtered.Any())
                                                {
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var db in filtered)
                                                        {
                                                            var isSelected = string.Equals(_source.Database, db, StringComparison.OrdinalIgnoreCase);
                                                            <button type="button"
                                                                    class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate d-flex align-items-center justify-content-between @(isSelected ? "bg-primary-subtle text-primary fw-semibold" : "")"
                                                                    style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.85rem; @(isSelected ? "" : "background-color: transparent; color: var(--app-text);")"
                                                                    title="@db"
                                                                    @onclick="() => SelectSourceDatabase(db)">
                                                                <span class="text-truncate">@db</span>
                                                                @if (isSelected)
                                                                {
                                                                    <i class="bi bi-check2 text-primary flex-shrink-0 ms-2"></i>
                                                                }
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="p-3 text-muted small text-center">No matches found.</div>
                                                }
                                            }
                                        </div>
                                    }

                                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                                        <i class="bi @(_isSourceDbDropdownOpen ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="font-size: 0.8rem;"></i>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm"
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_source.Database" placeholder="e.g. AdventureWorks" />
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Dacpac File Picker -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: var(--app-text);">Data-Tier Application Package (.dacpac)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm"
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_source.DacpacPath" placeholder="Path to source .dacpac..." />
                                <button class="btn btn-outline-secondary" type="button" @onclick="BrowseSourceDacpac">
                                    <i class="bi bi-folder2-open"></i> Browse...
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Target Endpoint -->
            <div class="col-12 col-lg-6">
                <div class="card p-4 rounded-3 shadow-sm h-100" style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                    <div class="mb-3 border-bottom pb-2" style="border-color: var(--app-border) !important;">
                        <h6 class="fw-bold mb-0 text-success">Target</h6>
                    </div>

                    <div class="mb-3">
                        <div class="btn-group btn-group-sm shadow-sm">
                            <button type="button" class="btn @(_target.Type == EndpointType.LiveDatabase ? "btn-success" : "btn-outline-secondary") btn-sm"
                                    @onclick="() => _target.Type = EndpointType.LiveDatabase">
                                Database
                            </button>
                            <button type="button" class="btn @(_target.Type == EndpointType.DacpacFile ? "btn-success" : "btn-outline-secondary") btn-sm"
                                    @onclick="() => _target.Type = EndpointType.DacpacFile">
                                .dacpac File
                            </button>
                        </div>
                    </div>

                    @if (_target.Type == EndpointType.LiveDatabase)
                    {
                        <div class="position-relative mb-3">
                            <label class="form-label small fw-bold mb-1" style="color: var(--app-text);">Connection Profile</label>
                            <div class="form-control form-control-sm d-flex align-items-center justify-content-between cursor-pointer shadow-sm"
                                 style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border); cursor: pointer;"
                                 @onclick="ToggleTargetDropdown">
                                <span class="text-truncate me-2">@GetSelectedProfileDisplayName(_targetProfileId, _target)</span>
                                <i class="bi @(_isTargetProfileDropdownOpen ? "bi-chevron-up" : "bi-chevron-down") flex-shrink-0 text-muted" style="font-size: 0.75rem;"></i>
                            </div>

                            @if (_isTargetProfileDropdownOpen)
                            {
                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseTargetDropdown"></div>
                                <div class="dropdown-menu show shadow-lg p-2 mt-1 rounded-3"
                                     style="position: absolute; top: 100%; left: 0; z-index: 1050; width: 100%; min-width: 320px; background-color: var(--app-dropdown-bg); color: var(--app-text); border: 1px solid var(--app-border);">
                                    <div class="mb-2">
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                               placeholder="Search connections..."
                                               @bind="_targetSearchTerm"
                                               @bind:event="oninput"
                                               @onclick:stopPropagation />
                                    </div>
                                    <div class="custom-scrollbar-light custom-scrollbar-solid-track" style="max-height: 250px; overflow-y: auto;">
                                        @if (string.IsNullOrEmpty(_targetSearchTerm) || "active session".Contains(_targetSearchTerm, StringComparison.OrdinalIgnoreCase) || GetActiveServerDisplayName().Contains(_targetSearchTerm, StringComparison.OrdinalIgnoreCase))
                                        {
                                            var isActiveSelected = _targetProfileId == "active";
                                            <div class="dropdown-item p-2 mb-1 rounded-2 @(isActiveSelected ? "bg-primary text-white" : "") @(!SchemaService.IsDatabaseConnected ? "opacity-50" : "")"
                                                 style="cursor: @(!SchemaService.IsDatabaseConnected ? "not-allowed" : "pointer");"
                                                 @onclick='async () => { if (SchemaService.IsDatabaseConnected) await SelectTargetProfile("active"); }'>
                                                <div class="d-flex flex-column text-truncate" style="min-width: 0;">
                                                    <span class="fw-semibold text-truncate" style="font-size: 0.85rem;">Active Session</span>
                                                    <span class="small @(isActiveSelected ? "text-white-50" : "text-muted") text-truncate" style="font-size: 0.72rem;">@GetActiveServerDisplayName()</span>
                                                </div>
                                            </div>
                                        }

                                        @{
                                            var filteredTargetSaved = ConnectionService.SavedConnections
                                                .Where(c => string.IsNullOrEmpty(_targetSearchTerm) ||
                                                            (!string.IsNullOrEmpty(c.Name) && c.Name.Contains(_targetSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                                            (!string.IsNullOrEmpty(c.Server) && c.Server.Contains(_targetSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                                                            (!string.IsNullOrEmpty(c.Database) && c.Database.Contains(_targetSearchTerm, StringComparison.OrdinalIgnoreCase)))
                                                .ToList();
                                        }

                                        @if (filteredTargetSaved.Any())
                                        {
                                            <div class="px-2 py-1 small fw-bold text-muted text-uppercase mt-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                                                Saved Connections
                                            </div>

                                            @foreach (var c in filteredTargetSaved)
                                            {
                                                var isSelected = _targetProfileId == c.Id;
                                                var capturedId = c.Id;
                                                <div class="dropdown-item p-2 mb-1 rounded-2 @(isSelected ? "bg-primary text-white" : "")"
                                                     style="cursor: pointer;"
                                                     @onclick="async () => await SelectTargetProfile(capturedId)">
                                                    <div class="d-flex flex-column text-truncate" style="min-width: 0;">
                                                        <span class="fw-semibold text-truncate" style="font-size: 0.85rem;">@(string.IsNullOrWhiteSpace(c.Name) ? c.Server : c.Name)</span>
                                                        <span class="small @(isSelected ? "text-white-50" : "text-muted") text-truncate" style="font-size: 0.72rem;">@c.Server</span>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    <hr class="dropdown-divider border-secondary my-2">
                                    <button type="button" class="dropdown-item text-info text-center py-2 rounded-2 fw-medium"
                                            style="border: 1px dashed var(--bs-info); width: calc(100% - 8px); margin: 0 4px;"
                                            @onclick='async () => await SelectTargetProfile("custom")'>
                                        <i class="bi bi-plus-lg me-1"></i> New Connection
                                    </button>
                                </div>
                            }
                        </div>

                        @if (_targetProfileId == "custom")
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-bold" style="color: var(--app-text);">Server</label>
                                <input type="text" class="form-control form-control-sm"
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_target.Server" placeholder="localhost or server\instance" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold" style="color: var(--app-text);">Authentication</label>
                                <select class="form-select form-select-sm"
                                        style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                        @bind="_target.AuthType">
                                    <option value="Windows">Windows Authentication</option>
                                    <option value="SqlServer">SQL Server Authentication</option>
                                    <option value="EntraMfa">Microsoft Entra MFA</option>
                                </select>
                            </div>

                            @if (_target.AuthType != "Windows")
                            {
                                <div class="row g-2 mb-3">
                                    <div class="@(_target.AuthType == "SqlServer" ? "col-6" : "col-12")">
                                        <label class="form-label small fw-bold" style="color: var(--app-text);">@(_target.AuthType == "EntraMfa" ? "Username / Email" : "Username")</label>
                                        <input type="text" class="form-control form-control-sm"
                                               style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                               placeholder="@(_target.AuthType == "EntraMfa" ? "user@domain.com" : "sa")"
                                               @bind="_target.Username" />
                                    </div>
                                    @if (_target.AuthType == "SqlServer")
                                    {
                                        <div class="col-6">
                                            <label class="form-label small fw-bold" style="color: var(--app-text);">Password</label>
                                            <input type="password" class="form-control form-control-sm"
                                                   style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                                   @bind="_target.Password" />
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="mb-3 p-2 px-3 rounded-2" style="background-color: var(--app-input-bg); border: 1px solid var(--app-border);">
                                <div class="d-flex align-items-center justify-content-between gap-3 mb-1">
                                    <div class="d-flex align-items-center gap-2 overflow-hidden text-truncate me-3" style="min-width: 0;">
                                        <i class="bi bi-hdd-network text-success flex-shrink-0" style="width: 16px; text-align: center;"></i>
                                        <span class="fw-semibold text-truncate" style="font-size: 0.85rem; color: var(--app-text);" title="@_target.Server">@_target.Server</span>
                                    </div>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none flex-shrink-0 text-nowrap d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;" @onclick='() => _targetProfileId = "custom"'>
                                        <i class="bi bi-pencil"></i><span>Edit</span>
                                    </button>
                                </div>
                                <div class="text-muted small" style="font-size: 0.75rem; line-height: 1.4;">
                                    <div class="d-flex align-items-center gap-2 text-truncate me-3" style="min-width: 0;">
                                        <i class="bi bi-shield-check opacity-75 flex-shrink-0" style="width: 16px; text-align: center;"></i>
                                        <span class="text-truncate">@GetAuthDisplayName(_target.AuthType)</span>
                                    </div>
                                    @if (_target.AuthType != "Windows" && !string.IsNullOrWhiteSpace(_target.Username))
                                    {
                                        <div class="d-flex align-items-center gap-2 mt-1 text-truncate me-3" style="min-width: 0;">
                                            <i class="bi bi-person opacity-75 flex-shrink-0" style="width: 16px; text-align: center;"></i>
                                            <span class="text-truncate" title="@_target.Username">@_target.Username</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mb-3 position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0" style="color: var(--app-text);">Database</label>
                                <button class="btn btn-link btn-sm p-0 text-decoration-none" style="font-size: 0.75rem;" @onclick="LoadTargetDatabasesAsync" disabled="@_isTargetDbLoading">
                                    <i class="bi @(_isTargetDbLoading ? "bi-arrow-clockwise spinner-border spinner-border-sm border-0" : "bi-arrow-clockwise")"></i> Refresh DBs
                                </button>
                            </div>
                            @if (_targetDatabases.Count > 0)
                            {
                                <div class="position-relative">
                                    <input class="form-control form-control-sm pe-4 text-truncate"
                                           @bind="_targetDbSearch"
                                           @bind:event="oninput"
                                           placeholder="@(!string.IsNullOrWhiteSpace(_target.Database) ? _target.Database : "Search database...")"
                                           @onfocus="OpenTargetDbDropdown"
                                           @onclick="OpenTargetDbDropdown"
                                           @onkeydown="OnTargetDbSearchKeyDown"
                                           style="cursor: pointer; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />

                                    @if (_isTargetDbDropdownOpen)
                                    {
                                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseTargetDbDropdown"></div>
                                        <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track"
                                             style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 220px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                                            @if (_isTargetDbLoading)
                                            {
                                                <div class="p-3 text-center text-info">
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                    <small>Loading databases...</small>
                                                </div>
                                            }
                                            else
                                            {
                                                var filtered = _targetDatabases.Where(d => string.IsNullOrWhiteSpace(_targetDbSearch) || d.Contains(_targetDbSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                                                if (filtered.Any())
                                                {
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var db in filtered)
                                                        {
                                                            var isSelected = string.Equals(_target.Database, db, StringComparison.OrdinalIgnoreCase);
                                                            <button type="button"
                                                                    class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate d-flex align-items-center justify-content-between @(isSelected ? "bg-primary-subtle text-primary fw-semibold" : "")"
                                                                    style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.85rem; @(isSelected ? "" : "background-color: transparent; color: var(--app-text);")"
                                                                    title="@db"
                                                                    @onclick="() => SelectTargetDatabase(db)">
                                                                <span class="text-truncate">@db</span>
                                                                @if (isSelected)
                                                                {
                                                                    <i class="bi bi-check2 text-primary flex-shrink-0 ms-2"></i>
                                                                }
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="p-3 text-muted small text-center">No matches found.</div>
                                                }
                                            }
                                        </div>
                                    }

                                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                                        <i class="bi @(_isTargetDbDropdownOpen ? "bi-chevron-up" : "bi-chevron-down") text-muted" style="font-size: 0.8rem;"></i>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm"
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_target.Database" placeholder="e.g. AdventureWorks_Prod" />
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Dacpac File Picker -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold" style="color: var(--app-text);">Data-Tier Application Package (.dacpac)</label>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm"
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_target.DacpacPath" placeholder="Path to target .dacpac..." />
                                <button class="btn btn-outline-secondary" type="button" @onclick="BrowseTargetDacpac">
                                    <i class="bi bi-folder2-open"></i> Browse...
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Comparison Options Panel (Collapsible) -->
            <div class="col-12">
                <div class="card p-3 rounded-3 shadow-sm" style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                    <div class="d-flex align-items-center justify-content-between cursor-pointer" @onclick="() => _optionsExpanded = !_optionsExpanded" style="cursor: pointer;">
                        <h6 class="fw-bold mb-0" style="color: var(--app-text); font-size: 0.95rem;">
                            <i class="bi bi-sliders text-primary me-2"></i>Comparison Options
                        </h6>
                        <i class="bi @(_optionsExpanded ? "bi-chevron-up" : "bi-chevron-down") text-muted"></i>
                    </div>

                    @if (_optionsExpanded)
                    {
                        <div class="row g-3 pt-3 mt-1 border-top" style="border-color: var(--app-border) !important;">
                            <div class="col-12 col-md-4">
                                <div class="form-check"
                                     data-bs-tooltip="true"
                                     data-bs-html="true"
                                     data-bs-placement="top"
                                     data-bs-title="<b>Ignore Whitespace</b><br/>Ignores differences in spaces, tabs, line breaks, and indentation within object definitions.">
                                    <input class="form-check-input" type="checkbox" id="optWhitespace" @bind="_options.IgnoreWhitespace" />
                                    <label class="form-check-label small" for="optWhitespace" style="color: var(--app-text); cursor: pointer;">
                                        Ignore Whitespace
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check"
                                     data-bs-tooltip="true"
                                     data-bs-html="true"
                                     data-bs-placement="top"
                                     data-bs-title="<b>Ignore System Constraint Names</b><br/>Ignores system-generated constraint names (e.g. <code>DF__tbl__col__12345</code>) to avoid false differences when constraints lack explicit names.">
                                    <input class="form-check-input" type="checkbox" id="optConstraintNames" @bind="_options.IgnoreSystemConstraintNames" />
                                    <label class="form-check-label small" for="optConstraintNames" style="color: var(--app-text); cursor: pointer;">
                                        Ignore System Constraint Names
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check"
                                     data-bs-tooltip="true"
                                     data-bs-html="true"
                                     data-bs-placement="top"
                                     data-bs-title="<b>Ignore Comments</b><br/>Ignores SQL comment blocks (<code>/* ... */</code>) and single-line comments (<code>--</code>) within object definitions.">
                                    <input class="form-check-input" type="checkbox" id="optComments" @bind="_options.IgnoreComments" />
                                    <label class="form-check-label small" for="optComments" style="color: var(--app-text); cursor: pointer;">
                                        Ignore Comments
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check"
                                     data-bs-tooltip="true"
                                     data-bs-html="true"
                                     data-bs-placement="top"
                                     data-bs-title="<b>Ignore Collation Differences</b><br/>Ignores differences in database, table, and column collations (e.g. <code>Latin1_General_CI_AS</code> vs <code>SQL_Latin1_General_CP1_CI_AS</code>).">
                                    <input class="form-check-input" type="checkbox" id="optCollation" @bind="_options.IgnoreCollation" />
                                    <label class="form-check-label small" for="optCollation" style="color: var(--app-text); cursor: pointer;">
                                        Ignore Collation Differences
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check"
                                     data-bs-tooltip="true"
                                     data-bs-html="true"
                                     data-bs-placement="top"
                                     data-bs-title="<b>Ignore Identity (Seed &amp; Increment)</b><br/>Ignores differences in identity column starting seed and step increment values (e.g. <code>IDENTITY(1,1)</code> vs <code>IDENTITY(1000,10)</code>). Structural identity column mismatches are still compared.">
                                    <input class="form-check-input" type="checkbox" id="optIdentity" @bind="_options.IgnoreIdentitySeed" />
                                    <label class="form-check-label small" for="optIdentity" style="color: var(--app-text); cursor: pointer;">
                                        Ignore Identity (Seed &amp; Increment)
                                    </label>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="form-check"
                                     data-bs-tooltip="true"
                                     data-bs-html="true"
                                     data-bs-placement="top"
                                     data-bs-title="<b>Ignore Permissions &amp; Roles</b><br/>Ignores user permissions (<code>GRANT</code>, <code>DENY</code>, <code>REVOKE</code>), database roles, and role membership assignments.">
                                    <input class="form-check-input" type="checkbox" id="optPermissions" @bind="_options.IgnorePermissions" />
                                    <label class="form-check-label small" for="optPermissions" style="color: var(--app-text); cursor: pointer;">
                                        Ignore Permissions &amp; Roles
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Start Comparison Button -->
            <div class="col-12 text-center pt-2">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger py-2 mb-3 d-inline-block text-start" style="font-size: 0.85rem;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@_errorMessage
                    </div>
                    <br />
                }
                <button class="btn btn-primary btn-lg px-5 shadow-sm fw-bold" @onclick="StartComparisonAsync">
                    <i class="bi bi-arrow-left-right me-2"></i> Compare Schemas
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Comparison Results View (Redgate Style) -->
        <div class="d-flex flex-column flex-grow-1 gap-3" style="min-height: 0;">
            <!-- Summary KPI Cards -->
            <div class="row g-2">
                <div class="col-6 col-md-3">
                    <div class="card p-2 text-center rounded-3 shadow-sm cursor-pointer @(_selectedChangeFilter == "Different" ? "border-primary" : "")"
                         style="background-color: var(--app-surface); border: 1px solid var(--app-border); cursor: pointer;"
                         @onclick='() => _selectedChangeFilter = "Different"'>
                        <span class="text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">ALL DIFFERENCES</span>
                        <span class="fs-4 fw-bold text-primary">@_result.Summary.TotalDifferences</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card p-2 text-center rounded-3 shadow-sm cursor-pointer @(_selectedChangeFilter == "Added" ? "border-success" : "")"
                         style="background-color: var(--app-surface); border: 1px solid var(--app-border); cursor: pointer;"
                         @onclick='() => _selectedChangeFilter = "Added"'>
                        <span class="text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">ONLY IN SOURCE</span>
                        <span class="fs-4 fw-bold text-success">@_result.Summary.AddedCount</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card p-2 text-center rounded-3 shadow-sm cursor-pointer @(_selectedChangeFilter == "Modified" ? "border-warning" : "")"
                         style="background-color: var(--app-surface); border: 1px solid var(--app-border); cursor: pointer;"
                         @onclick='() => _selectedChangeFilter = "Modified"'>
                        <span class="text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">DIFFERENT</span>
                        <span class="fs-4 fw-bold text-warning">@_result.Summary.ModifiedCount</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card p-2 text-center rounded-3 shadow-sm cursor-pointer @(_selectedChangeFilter == "Deleted" ? "border-danger" : "")"
                         style="background-color: var(--app-surface); border: 1px solid var(--app-border); cursor: pointer;"
                         @onclick='() => _selectedChangeFilter = "Deleted"'>
                        <span class="text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">ONLY IN TARGET</span>
                        <span class="fs-4 fw-bold text-danger">@_result.Summary.DeletedCount</span>
                    </div>
                </div>
            </div>

            <!-- Redgate Top/Bottom Layout: Differences Table (Top) + Visual Diff Viewer (Bottom) -->
            <div id="sql-compare-results-container"
                 class="@(_isFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-3 d-flex flex-column gap-2 overflow-auto" : "d-flex flex-column gap-2")"
                 style="@(_isFullScreen ? "background-color: var(--app-bg); z-index: 9999; overflow-y: auto;" : "min-height: 0;")">
                <!-- Top Panel: Differences Grid (Full Width) -->
                <div id="sql-compare-top-panel"
                     class="card rounded-3 shadow-sm d-flex flex-column overflow-hidden flex-shrink-0"
                     style="background-color: var(--app-surface); border: 1px solid var(--app-border); @(_isGridCollapsed ? "height: 48px;" : $"height: {_topPanelHeight}px; min-height: 120px;") transition: height 0.15s ease;">
                    
                    <!-- Filter & Action Bar (100% width) -->
                    <div class="p-2 px-3 @(!_isGridCollapsed ? "border-bottom" : "") d-flex flex-column gap-2" style="border-color: var(--app-border) !important; background-color: var(--app-surface);">
                        <!-- Row 1: Search Box (if expanded) or Object List Title (if collapsed) + Right Controls -->
                        <div class="d-flex align-items-center justify-content-between gap-3">
                            @if (!_isGridCollapsed)
                            {
                                <!-- Left: Search Box (with Match Case, Whole Word & Exact Match) -->
                                <div class="input-group input-group-sm" style="width: 50%; max-width: 520px; min-width: 280px;">
                                    <span class="input-group-text border-end-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" class="form-control form-control-sm border-start-0 ps-0 @(!string.IsNullOrEmpty(_filterQuery) ? "border-end-0" : "")"
                                           style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                           placeholder="Filter objects..."
                                           @bind="_filterQuery"
                                           @bind:event="oninput" />
                                    @if (!string.IsNullOrEmpty(_filterQuery))
                                    {
                                        <button class="btn btn-outline-secondary border-start-0"
                                                style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);"
                                                title="Clear filter"
                                                @onclick="() => _filterQuery = string.Empty">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn @(_filterCaseSensitive ? "btn-primary text-white" : "btn-outline-secondary") px-2"
                                            style="z-index: 0; border-color: var(--app-input-border); @(_filterCaseSensitive ? "" : "background-color: var(--app-input-bg); color: var(--app-text-muted);")"
                                            title="Match Case"
                                            @onclick="() => _filterCaseSensitive = !_filterCaseSensitive">
                                        <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.85em; letter-spacing: 0.5px;">Aa</span>
                                    </button>
                                    <button type="button" class="btn @(_filterMatchWholeWord ? "btn-primary text-white" : "btn-outline-secondary") px-2"
                                            style="z-index: 0; border-color: var(--app-input-border); @(_filterMatchWholeWord ? "" : "background-color: var(--app-input-bg); color: var(--app-text-muted);")"
                                            title="Match Whole Word"
                                            @onclick="() => { _filterMatchWholeWord = !_filterMatchWholeWord; if (_filterMatchWholeWord) _filterExactMatch = false; }">
                                        <span style="font-family: monospace; font-weight: bold; font-size: 0.85em;">[ab]</span>
                                    </button>
                                    <button type="button" class="btn @(_filterExactMatch ? "btn-primary text-white" : "btn-outline-secondary") px-2"
                                            style="z-index: 0; border-color: var(--app-input-border); @(_filterExactMatch ? "" : "background-color: var(--app-input-bg); color: var(--app-text-muted);")"
                                            title="Exact Match"
                                            @onclick="() => { _filterExactMatch = !_filterExactMatch; if (_filterExactMatch) _filterMatchWholeWord = false; }">
                                        <i class="bi bi-bullseye" style="font-size: 0.85rem;"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold small" style="color: var(--app-text);">Object List</span>
                                </div>
                            }

                            <!-- Right: Diff Navigation, Collapse/Expand & Full Screen Toggles -->
                            <div class="d-flex align-items-center gap-2 flex-shrink-0 ms-auto">
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-0 d-inline-flex align-items-center gap-1"
                                        style="font-size: 0.72rem; border-color: var(--app-border); height: 26px;"
                                        title="Jump to previous difference in object list"
                                        @onclick="GoToPrevDiffAsync"
                                        disabled="@(_selectedItem == null || !FilteredDifferences.Any())">
                                    <i class="bi bi-arrow-up"></i>
                                    <span>Prev Diff</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-0 d-inline-flex align-items-center gap-1"
                                        style="font-size: 0.72rem; border-color: var(--app-border); height: 26px;"
                                        title="Jump to next difference in object list"
                                        @onclick="GoToNextDiffAsync"
                                        disabled="@(_selectedItem == null || !FilteredDifferences.Any())">
                                    <i class="bi bi-arrow-down"></i>
                                    <span>Next Diff</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-0 d-inline-flex align-items-center gap-1"
                                        style="font-size: 0.72rem; border-color: var(--app-border); height: 26px;"
                                        title="@(_isGridCollapsed ? "Expand object list" : "Collapse object list for larger diff view")"
                                        @onclick="() => _isGridCollapsed = !_isGridCollapsed">
                                    <i class="bi @(_isGridCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
                                    <span>@(_isGridCollapsed ? "Expand" : "Collapse")</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-0 d-inline-flex align-items-center gap-1"
                                        style="font-size: 0.72rem; border-color: var(--app-border); height: 26px;"
                                        title="@(_isFullScreen ? "Restore Down" : "Expand to Full Screen")"
                                        @onclick="ToggleFullScreen">
                                    <i class="bi @(_isFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                                </button>
