                    </div>

                    <!-- Diff Endpoints Sub-Header (50/50 Full Width Split) -->
                    <div class="row g-0 border-bottom text-muted" style="border-color: var(--app-border) !important; background-color: var(--app-surface-secondary, rgba(0,0,0,0.03)); font-size: 0.75rem;">
                        <!-- Source Header (Left) -->
                        <div class="col-6 px-3 py-1 border-end d-flex align-items-center justify-content-between overflow-hidden" style="border-color: var(--app-border) !important;">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
