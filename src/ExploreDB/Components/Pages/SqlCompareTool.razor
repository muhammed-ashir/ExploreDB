                            <button type="button" class="btn btn-link btn-sm p-0 text-muted ms-2 flex-shrink-0"
                                    style="font-size: 0.75rem; text-decoration: none;"
                                    title="Copy Source DDL script"
                                    @onclick="CopySourceDdlAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(_selectedItem?.SourceScript))">
                                <i class="bi @(_isSourceCopied ? "bi-check-lg text-success" : "bi-clipboard") me-1"></i>
                                <span class="small">@(_isSourceCopied ? "Copied" : "Copy")</span>
                            </button>
                        </div>

                        <!-- Target Header (Right) -->
                        <div class="col-6 px-3 py-1 d-flex align-items-center justify-content-between overflow-hidden">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.68rem; padding: 2px 7px;">
                                    TARGET
                                </span>
                                @if (_result?.TargetEndpoint != null)
                                {
                                    <span class="text-truncate fw-semibold"
                                          style="color: var(--app-text); cursor: pointer;"
                                          data-bs-tooltip="true"
                                          data-bs-placement="bottom"
                                          data-bs-html="true"
                                          data-bs-title="@GetEndpointTooltipHtml(_result.TargetEndpoint)">
                                        @GetEndpointDisplayName(_result.TargetEndpoint)
                                    </span>
                                }
                            </div>
                            <button type="button" class="btn btn-link btn-sm p-0 text-muted ms-2 flex-shrink-0"
                                    style="font-size: 0.75rem; text-decoration: none;"
                                    title="Copy Target DDL script"
                                    @onclick="CopyTargetDdlAsync"
                                    disabled="@(string.IsNullOrWhiteSpace(_selectedItem?.TargetScript))">
                                <i class="bi @(_isTargetCopied ? "bi-check-lg text-success" : "bi-clipboard") me-1"></i>
                                <span class="small">@(_isTargetCopied ? "Copied" : "Copy")</span>
                            </button>
                        </div>
                    </div>

                    <!-- Diff Monaco Editor Container -->
                    <div class="flex-grow-1 position-relative" style="min-height: 250px; height: 100%;">
                        @if (_selectedItem == null)
                        {
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                 style="background-color: var(--app-surface-secondary); z-index: 10;">
                                <i class="bi bi-file-earmark-diff fs-1 mb-2 opacity-50 text-secondary"></i>
                                <div class="fw-semibold text-secondary">No Object Selected</div>
                                <div class="small opacity-75 text-secondary">Select an object from the list above to view its side-by-side DDL diff</div>
                            </div>
                        }
                        <StandaloneDiffEditor @ref="_diffEditor"
                                              Id="sql-diff-editor"
                                              ConstructionOptions="DiffEditorConstructionOptions"
                                              OnDidInit="DiffEditorOnDidInit"
                                              CssClass="w-100 h-100" />
                    </div>
                </div>

                <!-- Splitter Bar: Bottom of Diff Viewer (Drag to Resize Diff Viewer) -->
                <div id="sql-compare-diff-resizer"
                     class="sql-compare-splitter"
                     title="Drag up or down to resize diff viewer">
                    <div class="sql-compare-splitter-handle"></div>
                </div>
            </div>
        </div>
    }

    <!-- Toast Notification -->
    @if (!string.IsNullOrEmpty(_toastMessage))
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
            <div class="toast show align-items-center border-0 shadow-lg" role="alert" 
                 style="animation: slideInUp 0.3s ease; background-color: var(--app-surface-secondary); color: var(--app-text); border-left: 4px solid var(--bs-@_toastThemeClass) !important;">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center flex-grow-1 overflow-hidden" title="@_toastMessage">
                        <i class="bi @_toastIconClass me-3 fs-5 text-@_toastThemeClass flex-shrink-0"></i>
                        <span class="text-truncate">@_toastMessage</span>
                    </div>
                    <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "") me-3 m-auto flex-shrink-0" @onclick="() => _toastMessage = null"></button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter(Name = "IsPopout")]
    public bool IsPopout { get; set; }

    private DatabaseEndpoint _source = new();
    private DatabaseEndpoint _target = new();
    private ComparisonOptions _options = new();
    private bool _optionsExpanded = false;
    private bool _isComparing = false;
    private string _elapsedTimeFormatted = "00:00";
    private ComparisonEstimate? _estimate;
    private int _comparisonProgressPercent = 0;
    private string _errorMessage = "";
    private CancellationTokenSource? _cts;
    private string? _toastMessage = null;
    private string _toastThemeClass = "info";
    private string _toastIconClass = "bi-info-circle-fill";
    private CancellationTokenSource? _toastCts;

    private SchemaComparisonResultModel? _result;
    private SchemaDifferenceItem? _selectedItem;

    // Monaco Diff Editor State
    private StandaloneDiffEditor? _diffEditor;
    private TextModel? _originalModel;
    private TextModel? _modifiedModel;
    private bool _isSideBySide = true;
    private bool _isDiffEditorReady = false;
    private bool _isTargetCopied = false;
    private bool _isSourceCopied = false;
    private bool _isGridCollapsed = false;
    private bool _isFullScreen = false;
    private int _topPanelHeight = 260;
    private int _diffPanelHeight = 440;
    private DotNetObjectReference<SqlCompareTool>? _dotNetRef;

    [JSInvokable]
    public void SetTopPanelHeight(int height)
    {
        _topPanelHeight = height;
    }

    [JSInvokable]
    public void SetDiffPanelHeight(int height)
    {
        _diffPanelHeight = height;
    }

    private string _sourceProfileId = "active";
    private string _targetProfileId = "active";
    private bool _isSourceProfileDropdownOpen = false;
    private bool _isTargetProfileDropdownOpen = false;
    private string _sourceSearchTerm = "";
    private string _targetSearchTerm = "";

    private string _filterQuery = "";
    private bool _filterCaseSensitive = false;
    private bool _filterMatchWholeWord = false;
    private bool _filterExactMatch = false;
    private string _selectedCategoryFilter = "All";
    private string _selectedChangeFilter = "Different";
    private bool _isScriptCopied = false;

    private List<string> _sourceDatabases = new();
    private List<string> _targetDatabases = new();
    private string _sourceDbSearch = "";
    private string _targetDbSearch = "";
    private bool _isSourceDbDropdownOpen = false;
    private bool _isTargetDbDropdownOpen = false;
    private bool _isSourceDbLoading = false;
    private bool _isTargetDbLoading = false;
    private List<string> _availableCategories = new() { "All" };

    private bool IsAllSelected => FilteredDifferences.Any() && FilteredDifferences.All(d => d.IsSelected);

    private IEnumerable<SchemaDifferenceItem> FilteredDifferences
    {
        get
        {
            if (_result == null) return Enumerable.Empty<SchemaDifferenceItem>();

            return _result.Differences.Where(d =>
            {
                // Filter by change type
                bool matchesChange = _selectedChangeFilter switch
                {
                    "Different" => d.HasDifference,
                    "Added" => d.ChangeType == ChangeType.Added,
                    "Modified" => d.ChangeType == ChangeType.Modified,
                    "Deleted" => d.ChangeType == ChangeType.Deleted,
                    "Identical" => d.ChangeType == ChangeType.Identical,
                    _ => true
                };
                if (!matchesChange) return false;

                // Filter by category
                if (_selectedCategoryFilter != "All" && !string.Equals(d.CategoryDisplayName, _selectedCategoryFilter, StringComparison.OrdinalIgnoreCase))
                {
                    return false;
                }

                // Filter by search text
                if (!string.IsNullOrWhiteSpace(_filterQuery))
                {
                    var searchTerm = _filterCaseSensitive ? _filterQuery.Trim() : _filterQuery.Trim().ToLowerInvariant();
                    var objName = _filterCaseSensitive ? (d.ObjectName ?? "") : (d.ObjectName ?? "").ToLowerInvariant();
                    var schemaName = _filterCaseSensitive ? (d.Schema ?? "") : (d.Schema ?? "").ToLowerInvariant();
                    var fullName = _filterCaseSensitive ? (d.Name ?? "") : (d.Name ?? "").ToLowerInvariant();
                    var plainFullName = _filterCaseSensitive ? $"{d.Schema}.{d.ObjectName}" : $"{d.Schema}.{d.ObjectName}".ToLowerInvariant();

                    if (_filterExactMatch)
                    {
                        if (!(objName == searchTerm ||
                              schemaName == searchTerm ||
                              fullName == searchTerm ||
                              plainFullName == searchTerm ||
                              $"[{objName}]" == searchTerm))
                        {
                            return false;
                        }
                    }
                    else if (_filterMatchWholeWord)
                    {
                        bool matched = objName.Split(' ', '.', '_', '[', ']').Contains(searchTerm) ||
                                       schemaName.Split(' ', '.', '_', '[', ']').Contains(searchTerm) ||
                                       fullName.Split(' ', '.', '_', '[', ']').Contains(searchTerm);

                        if (!matched)
                        {
                            try
                            {
                                string pattern = $@"(^|[\s._\[\]]){System.Text.RegularExpressions.Regex.Escape(searchTerm)}($|[\s._\[\]])";
                                var regexOpt = _filterCaseSensitive ? System.Text.RegularExpressions.RegexOptions.None : System.Text.RegularExpressions.RegexOptions.IgnoreCase;
                                matched = System.Text.RegularExpressions.Regex.IsMatch(plainFullName, pattern, regexOpt) ||
                                          System.Text.RegularExpressions.Regex.IsMatch(fullName, pattern, regexOpt);
                            }
                            catch
                            {
                                matched = false;
                            }
                        }

                        if (!matched) return false;
                    }
                    else
                    {
                        if (!(objName.Contains(searchTerm) ||
                              schemaName.Contains(searchTerm) ||
                              fullName.Contains(searchTerm)))
                        {
                            return false;
                        }
                    }
                }

                return true;
            });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!ToolService.IsToolAvailable("sql-compare"))
        {
            Nav.NavigateTo("tools");
            return;
        }

        // Pre-warm DacFx engine in the background while the user selects databases
        _ = ComparisonService.PreWarmEngineAsync();

        ThemeService.OnThemeChanged += HandleThemeChanged;
        InitializeEndpointsFromActiveConnection();
        await LoadSourceDatabasesAsync();
        await LoadTargetDatabasesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_result != null && !_isComparing)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initSqlCompareSplitter", _dotNetRef);
        }
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(async () =>
        {
            await BlazorMonaco.Editor.Global.SetTheme(JS, ThemeService.IsDark ? "vs-dark" : "vs");
            StateHasChanged();
        });
    }

    private string GetActiveServerDisplayName()
    {
        if (!SchemaService.IsDatabaseConnected || string.IsNullOrEmpty(ConnectionService.ConnectionString))
        {
            return "Not Connected";
        }

        var active = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == ConnectionService.ConnectionString);
        if (active != null && !string.IsNullOrWhiteSpace(active.Name))
            return $"{active.Name} ({active.Server})";
        if (!string.IsNullOrEmpty(_source.Server))
            return _source.Server;
        return "Connected Server";
    }

    private string GetAuthDisplayName(string authType)
    {
        return authType switch
        {
            "Windows" => "Windows Authentication",
            "SqlServer" => "SQL Server Authentication",
            "EntraMfa" => "Microsoft Entra MFA",
            _ => string.IsNullOrWhiteSpace(authType) ? "Windows Authentication" : authType
        };
    }

    private void ToggleSourceDropdown()
    {
        _isSourceProfileDropdownOpen = !_isSourceProfileDropdownOpen;
        if (_isSourceProfileDropdownOpen)
        {
            _isTargetProfileDropdownOpen = false;
            _sourceSearchTerm = "";
        }
    }

    private void CloseSourceDropdown()
    {
        _isSourceProfileDropdownOpen = false;
        _sourceSearchTerm = "";
    }

    private void ToggleTargetDropdown()
    {
        _isTargetProfileDropdownOpen = !_isTargetProfileDropdownOpen;
        if (_isTargetProfileDropdownOpen)
        {
            _isSourceProfileDropdownOpen = false;
            _targetSearchTerm = "";
        }
    }

    private void CloseTargetDropdown()
    {
        _isTargetProfileDropdownOpen = false;
        _targetSearchTerm = "";
    }

    private static string GetEndpointDisplayName(DatabaseEndpoint endpoint)
    {
        if (endpoint.Type == EndpointType.DacpacFile)
        {
            return !string.IsNullOrWhiteSpace(endpoint.DacpacPath)
                ? Path.GetFileName(endpoint.DacpacPath)
                : "Dacpac Package";
        }

        return !string.IsNullOrWhiteSpace(endpoint.Database)
            ? endpoint.Database
            : (string.IsNullOrWhiteSpace(endpoint.Server) ? "Database" : endpoint.Server);
    }

    private static string GetEndpointTooltipHtml(DatabaseEndpoint endpoint)
    {
        if (endpoint.Type == EndpointType.DacpacFile)
        {
            var fileName = !string.IsNullOrWhiteSpace(endpoint.DacpacPath)
                ? Path.GetFileName(endpoint.DacpacPath)
                : "Dacpac Package";
            return $"<b>DACPAC:</b> {System.Net.WebUtility.HtmlEncode(fileName)}<br/><b>File Path:</b> {System.Net.WebUtility.HtmlEncode(endpoint.DacpacPath)}";
        }

        var db = !string.IsNullOrWhiteSpace(endpoint.Database) ? endpoint.Database : "Database";
        var server = !string.IsNullOrWhiteSpace(endpoint.Server) ? endpoint.Server : "localhost";
        return $"<b>Database:</b> {System.Net.WebUtility.HtmlEncode(db)}<br/><b>Server:</b> {System.Net.WebUtility.HtmlEncode(server)}";
    }

    private string GetSelectedProfileDisplayName(string profileId, DatabaseEndpoint endpoint)
    {
        if (profileId == "active")
        {
            return $"Active Session ({GetActiveServerDisplayName()})";
        }
        if (profileId == "custom")
        {
            return string.IsNullOrWhiteSpace(endpoint.Server) ? "New Connection" : $"New Connection ({endpoint.Server})";
        }
        var saved = ConnectionService.SavedConnections.FirstOrDefault(c => c.Id == profileId);
        if (saved != null)
        {
            return string.IsNullOrWhiteSpace(saved.Name) ? saved.Server : $"{saved.Name} ({saved.Server})";
        }
        return "Select Connection...";
    }

    private async Task SelectSourceProfile(string profileId)
    {
        _sourceProfileId = profileId;
        _isSourceProfileDropdownOpen = false;
        _sourceSearchTerm = "";

        if (profileId == "active")
        {
            InitializeEndpointFromActiveConnection(_source);
        }
        else if (profileId != "custom")
        {
            var saved = ConnectionService.SavedConnections.FirstOrDefault(c => c.Id == profileId);
            if (saved != null)
            {
                ApplySavedConnectionToEndpoint(_source, saved);
            }
        }
        await LoadSourceDatabasesAsync();
    }

    private async Task SelectTargetProfile(string profileId)
    {
        _targetProfileId = profileId;
        _isTargetProfileDropdownOpen = false;
        _targetSearchTerm = "";

        if (profileId == "active")
        {
            InitializeEndpointFromActiveConnection(_target);
        }
        else if (profileId != "custom")
        {
            var saved = ConnectionService.SavedConnections.FirstOrDefault(c => c.Id == profileId);
            if (saved != null)
            {
                ApplySavedConnectionToEndpoint(_target, saved);
            }
        }
        await LoadTargetDatabasesAsync();
    }

    private void ApplySavedConnectionToEndpoint(DatabaseEndpoint endpoint, ConnectionService.SavedConnection saved)
    {
        endpoint.Server = saved.Server;
        endpoint.AuthType = saved.AuthType;
        endpoint.Username = saved.Username;
        endpoint.Password = saved.Password;
        if (!string.IsNullOrEmpty(saved.Database))
        {
            endpoint.Database = saved.Database;
        }
    }

    private void InitializeEndpointFromActiveConnection(DatabaseEndpoint endpoint)
    {
        if (SchemaService.IsDatabaseConnected && !string.IsNullOrEmpty(ConnectionService.ConnectionString))
        {
            try
            {
                var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
                endpoint.Server = builder.DataSource;
                endpoint.AuthType = builder.IntegratedSecurity ? "Windows" : (builder.Authentication == Microsoft.Data.SqlClient.SqlAuthenticationMethod.ActiveDirectoryInteractive ? "EntraMfa" : "SqlServer");
                endpoint.Username = builder.UserID ?? "";
                endpoint.Password = builder.Password ?? "";
                if (endpoint == _source && !string.IsNullOrEmpty(SchemaService.ActiveDatabase))
                {
                    endpoint.Database = SchemaService.ActiveDatabase;
                }
            }
            catch { }
        }
    }

    private void InitializeEndpointsFromActiveConnection()
    {
        if (SchemaService.IsDatabaseConnected && !string.IsNullOrEmpty(ConnectionService.ConnectionString))
        {
            _sourceProfileId = "active";
            _targetProfileId = "active";
            InitializeEndpointFromActiveConnection(_source);
            InitializeEndpointFromActiveConnection(_target);
        }
        else if (ConnectionService.SavedConnections.Any())
        {
            var firstSaved = ConnectionService.SavedConnections.First();
            _sourceProfileId = firstSaved.Id;
            _targetProfileId = firstSaved.Id;
            ApplySavedConnectionToEndpoint(_source, firstSaved);
            ApplySavedConnectionToEndpoint(_target, firstSaved);
        }
        else
        {
            _sourceProfileId = "custom";
            _targetProfileId = "custom";
        }
    }

