                    <!-- Row 2: Category Filter Pills (Left) + Showing Count (Right) -->
                    @if (!_isGridCollapsed)
                    {
                        <div class="d-flex align-items-center justify-content-between gap-2" style="font-size: 0.75rem; white-space: nowrap;">
