    private async Task ExportHtmlReportAsync()
    {
        if (_result == null) return;

        try
        {
            var html = HtmlGenerator.GenerateReportHtml(_result);
            var htmlBytes = System.Text.Encoding.UTF8.GetBytes(html);
            var targetName = string.IsNullOrWhiteSpace(_result.TargetEndpoint.Database) ? "Target" : _result.TargetEndpoint.Database.Replace(" ", "_");
            var fileName = $"SchemaCompare_{targetName}_{DateTime.Now:yyyyMMdd_HHmmss}.html";

            using var stream = new MemoryStream(htmlBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting HTML report: {ex.Message}");
        }
    }

    private string GetChangeBadgeClass(ChangeType type) => type switch
    {
        ChangeType.Added => "bg-success-subtle text-success border border-success-subtle",
        ChangeType.Modified => "bg-warning-subtle text-warning border border-warning-subtle",
        ChangeType.Deleted => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-secondary-subtle text-muted border border-secondary-subtle"
    };

    private string GetChangeBadgeText(ChangeType type) => type switch
    {
        ChangeType.Added => "Only in Source",
        ChangeType.Deleted => "Only in Target",
        ChangeType.Modified => "Different",
        _ => "Identical"
    };

    private string GetChangeTooltip(ChangeType type)
    {
        var sourceDb = !string.IsNullOrWhiteSpace(_result?.SourceEndpoint.Database) ? _result.SourceEndpoint.Database : "Source";
        var targetDb = !string.IsNullOrWhiteSpace(_result?.TargetEndpoint.Database) ? _result.TargetEndpoint.Database : "Target";

        return type switch
        {
            ChangeType.Added => $"Only in Source: Exists in Source ({sourceDb}), but missing in Target ({targetDb}). Synchronization will CREATE it in Target.",
            ChangeType.Deleted => $"Only in Target: Exists in Target ({targetDb}), but missing in Source ({sourceDb}). Synchronization will DROP it from Target.",
            ChangeType.Modified => $"Different: Exists in both databases, but schemas differ. Synchronization will ALTER Target to match Source.",
            ChangeType.Identical => $"Identical: Schema matches exactly in both databases ({sourceDb} and {targetDb}). No action needed.",
            _ => "Schema difference status relative to Target"
        };
    }

    private void ShowToast(string message, string themeClass = "info", string iconClass = "bi-info-circle-fill", int delayMs = 3000)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toastMessage = message;
        _toastThemeClass = themeClass;
        _toastIconClass = iconClass;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delayMs, token);
                _toastMessage = null;
                await InvokeAsync(StateHasChanged);
            }
            catch (TaskCanceledException) { }
        }, token);
    }

