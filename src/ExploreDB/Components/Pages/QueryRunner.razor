@page "/"
@page "/runner"
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@using Dapper
@using Microsoft.Data.SqlClient
@using System.Data
@using Microsoft.Extensions.Configuration
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HistoryService HistoryService
@implements IDisposable

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col d-flex justify-content-between align-items-center flex-nowrap">
            <div class="position-relative me-5" style="min-width: 0;">
                <div class="d-flex align-items-center cursor-pointer text-white w-100" @onclick="() => IsTabDropdownOpen = !IsTabDropdownOpen">
                    <span class="me-2 fs-6 text-truncate" title="@ActiveTabName">@ActiveTabName</span>
                    <i class="bi bi-chevron-down flex-shrink-0" style="font-size: 0.85rem;"></i>
                </div>
                @if (IsTabDropdownOpen)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsTabDropdownOpen = false"></div>
                    <div class="dropdown-menu show bg-dark border-secondary shadow-lg p-1 mt-2" style="position: absolute; top: 100%; left: 0; z-index: 1050; min-width: 250px; max-width: 350px; overflow-x: hidden;">
                        <div class="p-1 mb-1">
                            <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="Search tabs..." @bind="TabSearchTerm" @bind:event="oninput" @onclick:stopPropagation />
                        </div>
                        <div class="custom-scrollbar-light custom-scrollbar-solid-track" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var tab in QueryStateService.Tabs.Where(t => string.IsNullOrEmpty(TabSearchTerm) || t.Name.Contains(TabSearchTerm, StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="dropdown-item d-flex justify-content-between align-items-center text-white @(tab.Id == QueryStateService.ActiveTabId ? "bg-primary bg-opacity-25 rounded-1" : "rounded-1")" style="cursor: pointer; min-width: 0;" @onclick="async () => { await SwitchTabAsync(tab.Id); IsTabDropdownOpen = false; }">
                                <span class="text-truncate me-3" title="@tab.Name" style="flex: 1; min-width: 0;">@tab.Name</span>
                                @if (QueryStateService.Tabs.Count > 1)
                                {
                                    <button class="btn btn-sm btn-outline-danger border-0 flex-shrink-0 px-1 py-0 rounded" @onclick="async () => { await CloseTabAsync(tab.Id); IsTabDropdownOpen = false; }" @onclick:stopPropagation>
                                        <i class="bi bi-x fs-5"></i>
                                    </button>
                                }
                            </div>
                        }
                        </div>
                        <hr class="dropdown-divider border-secondary my-2">
                        <button class="dropdown-item text-info text-center py-1 mb-2 mt-1 rounded-2" style="border: 1px dashed var(--bs-info); margin-left: 10px; margin-right: 10px; width: calc(100% - 20px);" @onclick="async () => { await NewTabAsync(); IsTabDropdownOpen = false; }">
                            <i class="bi bi-plus-lg me-1"></i> New Query
                        </button>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <button class="btn btn-sm btn-outline-light shadow-sm" data-bs-tooltip="true" data-bs-title="Open File" data-bs-placement="bottom" @onclick="OpenFileAsync">
                    <i class="bi bi-folder2-open"></i>
                </button>
                <button class="btn btn-sm btn-outline-light shadow-sm" data-bs-tooltip="true" data-bs-title="Save Query" data-bs-placement="bottom" @onclick="SaveQueryAsync">
                    <i class="bi bi-floppy"></i>
                </button>
                <button class="btn btn-sm btn-outline-light shadow-sm" data-bs-tooltip="true" data-bs-title="Save As..." data-bs-placement="bottom" @onclick="SaveAsQueryAsync">
                    <i class="bi bi-file-earmark-plus"></i>
                </button>
                <button class="btn btn-sm btn-outline-info shadow-sm" data-bs-tooltip="true" data-bs-title="Format SQL" data-bs-placement="bottom" @onclick="FormatSqlAsync">
                    <i class="bi bi-magic"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary shadow-sm" data-bs-tooltip="true" data-bs-title="View History" data-bs-placement="bottom" @onclick='() => Nav.NavigateTo("/history")'>
                    <i class="bi bi-clock-history"></i>
                </button>
                <button class="btn btn-sm btn-primary shadow-sm" data-bs-tooltip="true" data-bs-title="Execute Query" data-bs-placement="bottom" @onclick="ExecuteAsync" disabled="@IsExecuting">
                    @if (IsExecuting) { <span class="spinner-border spinner-border-sm me-2"></span><span>Executing...</span> }
                    else { <i class="bi bi-play-fill me-1"></i><span>Execute</span> }
                </button>
            </div>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(FormatError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Format Error:</strong> @FormatError
            <button type="button" class="btn-close" @onclick="() => FormatError = null" aria-label="Close"></button>
        </div>
    }

    <!-- Execution Harness Area -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card bg-dark text-white shadow-sm border-secondary">
                <div class="card-body p-0">
                    <div style="height: 350px; width: 100%; display: block; resize: vertical; overflow: hidden; min-height: 150px; padding-bottom: 2px;">
                        <StandaloneCodeEditor @ref="_editor" Id="query-editor" CssClass="w-100 h-100" ConstructionOptions="EditorConstructionOptions" OnDidInit="EditorOnDidInit" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Area --> 
    <div class="@(IsFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-4" : "row")" style="@(IsFullScreen ? "background-color: rgba(15, 15, 20, 0.95); z-index: 9999; padding-top: 60px !important;" : "")">
        <div class="@(IsFullScreen ? "w-100 h-100" : "col-12")">
            <div class="card glass-card text-white d-flex flex-column" style="@(IsFullScreen ? "height: 100%;" : "min-height: 400px;")">
                <div class="card-header border-secondary p-0 d-flex justify-content-between align-items-center">
                    <ul class="nav nav-tabs border-secondary flex-grow-1 border-bottom-0">
                        <li class="nav-item">
                            <a class="nav-link @(ResultTab == "Results" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")"
                               @onclick='() => ResultTab = "Results"' style="cursor:pointer">Results</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ResultTab == "Messages" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")"
                               @onclick='() => ResultTab = "Messages"' style="cursor:pointer">
                                Messages
                                @if (Messages.Count > 0) { <span class="badge bg-secondary ms-1">@Messages.Count</span> }
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center pe-2">
                        @if (HasExecuted && LastExecutionTimeMs > 0 && !IsExecuting)
                        {
                            <span class="text-muted small me-3"><i class="bi bi-stopwatch me-1"></i>@GetFormattedExecutionTimeMs(LastExecutionTimeMs)</span>
                        }
                        <button class="btn btn-sm btn-outline-secondary border-0 text-white" @onclick="() => IsFullScreen = !IsFullScreen" title="@(IsFullScreen ? "Restore Down" : "Expand to Full Screen")">
                            <i class="bi @(IsFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body overflow-auto flex-grow-1">
                    @if (ResultTab == "Results")
                    {
                        if (IsExecuting)
                        {
                            <div class="text-center mt-5">
                                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem; border-width: 0.25em;"></div>
                                <div class="mt-3 text-muted fs-5">Executing... (@GetFormattedExecutionTime(_execElapsedSeconds))</div>
                            </div>
                        }
                        else if (ResultSets.Count == 0 && !HasExecuted)
                        {
                            <div class="text-muted text-center mt-5">
                                Enter a custom query and click Execute to see results.
                            </div>
                        }
                        else if (ResultSets.Count == 0 && HasExecuted)
                        {
                            <div class="text-muted text-center mt-5">Command completed successfully. No data tables returned.</div>
                        }
                        else
                        {
                            int rsIndex = 1;
                            foreach (var rs in ResultSets)
                            {
                                @if (ResultSets.Count > 1) { <div class="fw-bold mb-2 mt-3 text-info">Result Set @rsIndex</div> }
                                <ResultSetGrid Data="rs" />
                                rsIndex++;
                            }
                        }
                    }
                    else if (ResultTab == "Messages")
                    {
                        <pre class="m-0 text-light" style="font-size: 0.85em; white-space: pre-wrap;">
@if (Messages.Count == 0) { <span class="text-muted fst-italic">No messages.</span> }
@foreach (var msg in Messages) { @msg<br/> }
                        </pre>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (_execElapsedSeconds >= 10 && _isCurrentQuerySelect)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 10000; animation: fadeIn 0.5s;">
        <div class="toast show bg-dark text-white shadow-lg" style="border: 1px solid rgba(255,193,7,0.5);" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-dark text-warning border-secondary border-opacity-50">
                <i class="bi bi-hourglass-split me-2"></i>
                <strong class="me-auto" style="letter-spacing: 0.5px;">Long Execution</strong>
                <button type="button" class="btn-close btn-close-white" onclick="this.closest('.toast-container').style.display='none'" aria-label="Close"></button>
            </div>
            <div class="toast-body text-start" style="font-size: 0.9rem; color: #ccc;">
                Execution is taking longer than usual. If you are querying a massive dataset, consider adding a <code class="text-warning bg-black px-1 rounded border border-secondary border-opacity-50">TOP</code> or <code class="text-warning bg-black px-1 rounded border border-secondary border-opacity-50">WHERE</code> clause to narrow down your results. Otherwise, please hold tight while we finish fetching your data!
            </div>
        </div>
    </div>
}

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowRestoreSessionPrompt)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Restore Session?</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Do you want to restore your previous query tabs?</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => HandleRestoreSessionAsync(true)">Yes</button>
                    <button type="button" class="btn btn-outline-secondary px-4 text-white" @onclick="() => HandleRestoreSessionAsync(false)">No, clear them</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? ObjectType { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    public string? ObjectName { get; set; }

    [SupplyParameterFromQuery(Name = "query")]
    public string? InitialQuery { get; set; }

    private string ResultTab = "Results";
    private bool IsExecuting = false;
    private bool HasExecuted = false;
    private bool IsFullScreen = false;
    private long LastExecutionTimeMs = 0;
    private int _execElapsedSeconds = 0;
    private bool _isCurrentQuerySelect = false;
    
    private List<IEnumerable<dynamic>> ResultSets = new();
    private List<string> Messages = new();
    private string? FormatError = null;
    private StandaloneCodeEditor _editor = default!;
    private DotNetObjectReference<QueryRunner>? _objRef;
    
    private bool IsTabDropdownOpen = false;
    private string TabSearchTerm = "";
    private bool ShowLimitAlert = false;
    private bool ShowRestoreSessionPrompt = false;

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    private string ActiveTabName => QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId)?.Name ?? "Query Runner";

    protected override async Task OnInitializedAsync()
    {
        if (!QueryStateService.Initialized)
        {
            if (QueryStateService.HasSavedTabs())
            {
                ShowRestoreSessionPrompt = true;
                return;
            }
            else
            {
                await QueryStateService.LoadTabsAsync();
            }
            QueryStateService.Initialized = true;
        }
    }

    private async Task HandleRestoreSessionAsync(bool restore)
    {
        ShowRestoreSessionPrompt = false;
        if (restore)
        {
            await QueryStateService.LoadTabsAsync();
        }
        else
        {
            QueryStateService.ClearSavedState();
            await QueryStateService.LoadTabsAsync();
        }
        QueryStateService.Initialized = true;
        
        var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
        if (currentTab != null && _editor != null)
        {
            await _editor.SetValue(currentTab.Content);
        }
        
        StateHasChanged();
    }

    private async Task SwitchTabAsync(Guid tabId)
    {
        if (QueryStateService.ActiveTabId == tabId) return;
        
        var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
        if (currentTab != null && _editor != null)
        {
            currentTab.Content = await _editor.GetValue();
        }

        QueryStateService.ActiveTabId = tabId;
        var newTab = QueryStateService.Tabs.First(t => t.Id == tabId);
        
        if (_editor != null)
        {
            await _editor.SetValue(newTab.Content);
        }
        await QueryStateService.SaveTabsAsync();
    }

    private async Task NewTabAsync()
    {
        var maxTabs = Config.GetValue<int>("MaxOpenTabs", 20);
        if (QueryStateService.Tabs.Count >= maxTabs)
        {
            ShowLimitAlert = true;
            return;
        }

        var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
        if (currentTab != null && _editor != null)
        {
            currentTab.Content = await _editor.GetValue();
        }

        var newCount = QueryStateService.Tabs.Count + 1;
        var newTab = new ExploreDB.Services.QueryTab { Name = $"SQLQuery{newCount}.sql" };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;

        if (_editor != null)
        {
            await _editor.SetValue(newTab.Content);
        }
        await QueryStateService.SaveTabsAsync();
    }

    private async Task OpenFileAsync()
    {
        try
        {
            var result = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync(new Microsoft.Maui.Storage.PickOptions
            {
                PickerTitle = "Select a SQL file",
            });

            if (result != null)
            {
                var maxTabs = Config.GetValue<int>("MaxOpenTabs", 20);
                if (QueryStateService.Tabs.Count >= maxTabs)
                {
                    ShowLimitAlert = true;
                    return;
                }

                var text = await File.ReadAllTextAsync(result.FullPath);
                
                var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
                if (currentTab != null && _editor != null)
                {
                    currentTab.Content = await _editor.GetValue();
                }

                var newTab = new ExploreDB.Services.QueryTab
                {
                    Name = result.FileName,
                    Content = text
                };
                QueryStateService.Tabs.Add(newTab);
                QueryStateService.ActiveTabId = newTab.Id;
                await QueryStateService.SaveTabsAsync();
                
                if (_editor != null)
                {
                    await _editor.SetValue(text);
                }
            }
        }
        catch { }
    }

    private async Task CloseTabAsync(Guid tabId)
    {
        if (QueryStateService.Tabs.Count <= 1) return;
        
        var tabToRemove = QueryStateService.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tabToRemove == null) return;

        QueryStateService.Tabs.Remove(tabToRemove);

        if (QueryStateService.ActiveTabId == tabId)
        {
            QueryStateService.ActiveTabId = QueryStateService.Tabs.First().Id;
            var newTab = QueryStateService.Tabs.First();
            if (_editor != null)
            {
                await _editor.SetValue(newTab.Content);
            }
        }
        await QueryStateService.SaveTabsAsync();
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "sql",
            Theme = "vs-dark",
            Value = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId)?.Content ?? "",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "on",
            OverviewRulerBorder = false,
            HideCursorInOverviewRuler = true,
            ScrollBeyondLastLine = false,
            FontSize = 14,
            FixedOverflowWidgets = true,
            Scrollbar = new EditorScrollbarOptions { UseShadows = false }
        };
    }

    private async Task EditorOnDidInit()
    {
        _objRef = DotNetObjectReference.Create(this);
        var tables = SchemaService.Tables.Select(t => new { name = t.Name, fullName = t.FullName }).ToList();
        var views = SchemaService.Views.Select(v => new { name = v.Name, fullName = v.FullName }).ToList();
        await JS.InvokeVoidAsync("registerSqlAutocomplete", tables, views, _objRef);
    }

    private async Task FormatSqlAsync()
    {
        FormatError = null;
        var currentQuery = await _editor.GetValue();
        if (!string.IsNullOrWhiteSpace(currentQuery))
        {
            try
            {
                var formatted = await JS.InvokeAsync<string>("formatSql", currentQuery);
                await _editor.SetValue(formatted);
            }
            catch (Exception ex)
            {
                // The JS interop throws a detailed JS exception string which can be a bit noisy.
                // We extract just the relevant message if possible, or show a friendly message.
                FormatError = "Syntax error near: " + ex.Message.Split('\n').FirstOrDefault()?.Replace("Error:", "").Trim();
            }
        }
    }

    private async Task SaveQueryAsync()
    {
        try
        {
            var queryText = await _editor.GetValue();
            var activeTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
            if (activeTab == null) return;
            activeTab.Content = queryText;

            if (!string.IsNullOrEmpty(activeTab.FilePath))
            {
                await Windows.Storage.FileIO.WriteTextAsync(await Windows.Storage.StorageFile.GetFileFromPathAsync(activeTab.FilePath), queryText);
                await QueryStateService.SaveTabsAsync();
                return;
            }

            var savePicker = new Windows.Storage.Pickers.FileSavePicker();
            savePicker.SuggestedStartLocation = Windows.Storage.Pickers.PickerLocationId.DocumentsLibrary;
            savePicker.FileTypeChoices.Add("SQL Script", new List<string>() { ".sql" });
            savePicker.FileTypeChoices.Add("Plain Text", new List<string>() { ".txt" });
            savePicker.SuggestedFileName = activeTab.Name;

            var mauiWindow = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault();
            if (mauiWindow?.Handler?.PlatformView is Microsoft.UI.Xaml.Window winuiWindow)
            {
                var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(winuiWindow);
                WinRT.Interop.InitializeWithWindow.Initialize(savePicker, hwnd);
            }

            var file = await savePicker.PickSaveFileAsync();
            if (file != null)
            {
                await Windows.Storage.FileIO.WriteTextAsync(file, queryText);
                activeTab.FilePath = file.Path;
                activeTab.Name = file.Name;
                await QueryStateService.SaveTabsAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task SaveAsQueryAsync()
    {
        try
        {
            var queryText = await _editor.GetValue();
            var activeTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
            if (activeTab == null) return;
            activeTab.Content = queryText;

            var savePicker = new Windows.Storage.Pickers.FileSavePicker();
            savePicker.SuggestedStartLocation = Windows.Storage.Pickers.PickerLocationId.DocumentsLibrary;
            savePicker.FileTypeChoices.Add("SQL Script", new List<string>() { ".sql" });
            savePicker.FileTypeChoices.Add("Plain Text", new List<string>() { ".txt" });
            savePicker.SuggestedFileName = activeTab.Name;

            var mauiWindow = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault();
            if (mauiWindow?.Handler?.PlatformView is Microsoft.UI.Xaml.Window winuiWindow)
            {
                var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(winuiWindow);
                WinRT.Interop.InitializeWithWindow.Initialize(savePicker, hwnd);
            }

            var file = await savePicker.PickSaveFileAsync();
            if (file != null)
            {
                await Windows.Storage.FileIO.WriteTextAsync(file, queryText);
                activeTab.FilePath = file.Path;
                activeTab.Name = file.Name;
                await QueryStateService.SaveTabsAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    [JSInvokable]
    public string? GetSchemaDocumentation(string objectName)
    {
        var table = SchemaService.Tables.FirstOrDefault(t => string.Equals(t.Name, objectName, StringComparison.OrdinalIgnoreCase) || string.Equals(t.FullName, objectName, StringComparison.OrdinalIgnoreCase));
        if (table != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**Table:** `{table.FullName}`\n");
            sb.AppendLine("| Column | Data Type |");
            sb.AppendLine("|---|---|");
            foreach(var col in table.Columns)
            {
                sb.AppendLine($"| {col.Name} | {col.DataType} |");
            }
            return sb.ToString();
        }

        var view = SchemaService.Views.FirstOrDefault(v => string.Equals(v.Name, objectName, StringComparison.OrdinalIgnoreCase) || string.Equals(v.FullName, objectName, StringComparison.OrdinalIgnoreCase));
        if (view != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**View:** `{view.FullName}`\n");
            sb.AppendLine("| Column | Data Type |");
            sb.AppendLine("|---|---|");
            foreach(var col in view.Columns)
            {
                sb.AppendLine($"| {col.Name} | {col.DataType} |");
            }
            return sb.ToString();
        }

        return null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialQuery))
        {
            QueryStateService.CustomQuery = InitialQuery;
            if (_editor != null)
            {
                await _editor.SetValue(InitialQuery);
            }
        }
    }

    private string GetFormattedExecutionTimeMs(long totalMs)
    {
        if (totalMs < 1000) return $"{totalMs}ms";
        var ts = TimeSpan.FromMilliseconds(totalMs);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        if (ts.TotalMinutes >= 1) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{Math.Round(ts.TotalSeconds, 1)}s";
    }

    private string GetFormattedExecutionTime(int totalSeconds)
    {
        if (totalSeconds < 60) return $"{totalSeconds}s";
        var ts = TimeSpan.FromSeconds(totalSeconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Minutes}m {ts.Seconds}s";
    }

    private async Task UpdateTimerAsync()
    {
        var start = DateTime.UtcNow;
        while (IsExecuting)
        {
            await Task.Delay(500);
            if (IsExecuting)
            {
                _execElapsedSeconds = (int)(DateTime.UtcNow - start).TotalSeconds;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ExecuteAsync()
    {
        if (IsExecuting) return;

        var queryText = await _editor.GetValue();
        if (string.IsNullOrWhiteSpace(queryText))
        {
            Messages.Add("Error: Query is empty.");
            ResultTab = "Messages";
            return;
        }

        var q = queryText.TrimStart();
        _isCurrentQuerySelect = q.StartsWith("select", StringComparison.OrdinalIgnoreCase) || 
                                q.StartsWith("with", StringComparison.OrdinalIgnoreCase);

        IsExecuting = true;
        HasExecuted = true;
        _execElapsedSeconds = 0;
        
        _ = UpdateTimerAsync();

        ResultSets.Clear();
        Messages.Clear();
        ResultTab = "Results";
        StateHasChanged();

        var watch = System.Diagnostics.Stopwatch.StartNew();
        bool isSuccess = false;
        string? errorMessage = null;
        string dbName = "";
        string serverName = "";

        try
        {
            QueryStateService.CustomQuery = queryText;
            using var conn = new SqlConnection(ConnectionService.ConnectionString);
            dbName = conn.Database;
            serverName = conn.DataSource;
            conn.InfoMessage += (sender, args) =>
            {
                Messages.Add(args.Message);
                InvokeAsync(StateHasChanged);
            };
            await conn.OpenAsync();

            if (!_isCurrentQuerySelect)
            {
                bool allowNonSelect = Config.GetValue<bool>("AllowNonSelectQueries", false);
                if (!allowNonSelect)
                {
                    Messages.Add("Error: Execution of non-SELECT statements is disabled.");
                    ResultTab = "Messages";
                    return;
                }

                bool confirm = await JS.InvokeAsync<bool>("confirm", "⚠️ WARNING: This query may modify data or schema.\n\nAre you sure you want to execute it?");
                if (!confirm)
                {
                    Messages.Add("Execution cancelled by user.");
                    ResultTab = "Messages";
                    return;
                }
            }

            var rs = await conn.QueryAsync<dynamic>(QueryStateService.CustomQuery, commandTimeout: 0);
            ResultSets.Add(rs);
            Messages.Add("Executed custom query.");
            Messages.Add($"Rows returned: {rs.Count()}");
            isSuccess = true;
        }
        catch (Exception ex)
        {
            Messages.Add($"ERROR: {ex.Message}");
            ResultTab = "Messages";
            errorMessage = ex.Message;
        }
        finally
        {
            watch.Stop();
            LastExecutionTimeMs = watch.ElapsedMilliseconds;
            IsExecuting = false;
            if (!string.IsNullOrWhiteSpace(QueryStateService.CustomQuery))
            {
                await HistoryService.AddHistoryItemAsync(QueryStateService.CustomQuery, serverName, dbName, watch.ElapsedMilliseconds, isSuccess, errorMessage);
            }
        }
    }
}
