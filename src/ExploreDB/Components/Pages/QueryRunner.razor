}

@if (ShowClearConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="background: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-body p-4 pb-2">
                    <p class="mb-0" style="font-size: 0.95rem; color: var(--app-text);">
                        Are you sure you want to <strong class="text-warning">clear the editor</strong>? This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-secondary" @onclick="() => ShowClearConfirmation = false">Cancel</button>
                    <button type="button" class="btn btn-warning px-4 fw-bold shadow-sm text-dark" @onclick="ClearQueryAsync">Clear</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDangerousQueryWarning)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="background: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-body p-4 pb-2">
                    <div class="fw-bold mb-2" style="font-size: 1rem; color: var(--app-text);">Confirm Execution</div>
                    <p class="mb-0" style="font-size: 0.9rem; color: var(--app-text);">
                        This query may modify the database. Are you sure you want to execute it?
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-secondary" @onclick="() => ResolveDangerousQueryWarning(false)">Cancel</button>
                    <button type="button" class="btn btn-danger px-4 fw-bold shadow-sm" @onclick="() => ResolveDangerousQueryWarning(true)">
                        <i class="bi bi-play-fill me-1"></i>Execute
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showTabContextMenu)
{
    <div class="modal-backdrop fade show" style="opacity: 0; z-index: 1055;" @onclick="CloseTabContextMenu" @oncontextmenu="CloseTabContextMenu" @oncontextmenu:preventDefault="true"></div>
    <div class="tab-context-menu" style="left: @(_tabContextMenuX)px; top: @(_tabContextMenuY)px;">
        @{
            var ctxTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == _contextMenuTabId);
        }
        @if (ctxTab != null)
        {
            <div class="dropdown-item" @onclick="async () => { await TogglePinTabAsync(ctxTab.Id); CloseTabContextMenu(); }">
                <i class="bi @(ctxTab.IsPinned ? "bi-pin-angle text-warning" : "bi-pin-angle-fill text-warning")"></i>
                <span>@(ctxTab.IsPinned ? "Unpin Tab" : "Pin Tab")</span>
            </div>
            <div class="dropdown-divider"></div>
            @if (!ctxTab.IsPinned)
            {
                <div class="dropdown-item text-danger" @onclick="async () => { await CloseTabAsync(ctxTab.Id); CloseTabContextMenu(); }">
                    <i class="bi bi-x-lg"></i>
                    <span>Close Tab</span>
                </div>
            }
            <div class="dropdown-item" @onclick="async () => { await CloseOtherTabsAsync(ctxTab.Id); CloseTabContextMenu(); }">
                <i class="bi bi-x-circle"></i>
                <span>Close Other Tabs</span>
            </div>
            <div class="dropdown-item" @onclick="async () => { await CloseTabsToTheRightAsync(ctxTab.Id); CloseTabContextMenu(); }">
                <i class="bi bi-arrow-right-circle"></i>
                <span>Close Tabs to the Right</span>
            </div>
            <div class="dropdown-divider"></div>
            <div class="dropdown-item" @onclick="async () => { await PopoutTabAsync(ctxTab.Id); CloseTabContextMenu(); }">
                <i class="bi bi-box-arrow-up-right text-info"></i>
                <span>Pop Out Tab</span>
            </div>
            <div class="dropdown-item" @onclick="async () => { await DuplicateTabAsync(ctxTab.Id); CloseTabContextMenu(); }">
                <i class="bi bi-files text-primary"></i>
                <span>Duplicate Tab</span>
            </div>
        }
    </div>
}

@if (ShowCloseTabConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="background: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
