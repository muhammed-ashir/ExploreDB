    private async Task<bool> SaveQueryAsync(Guid? targetTabId = null)
    {
        try
        {
            var tabIdToSave = targetTabId ?? QueryStateService.ActiveTabId;
            var tabToSave = QueryStateService.Tabs.FirstOrDefault(t => t.Id == tabIdToSave);
            if (tabToSave == null) return false;

            string queryText;
            if (tabIdToSave == QueryStateService.ActiveTabId && _editor != null)
            {
                queryText = await _editor.GetValue();
                tabToSave.Content = queryText;
            }
            else
            {
                queryText = tabToSave.Content;
            }

                        if (!string.IsNullOrEmpty(tabToSave.FilePath))
            {
                await File.WriteAllTextAsync(tabToSave.FilePath, queryText);
                tabToSave.OriginalContent = queryText;
                await QueryStateService.SaveTabsAsync();
                return true;
            }

            var chosenPath = await WindowManager.ShowSaveFileDialogAsync(tabToSave.Name);
            if (!string.IsNullOrEmpty(chosenPath))
            {
                await File.WriteAllTextAsync(chosenPath, queryText);
                tabToSave.FilePath = chosenPath;
                tabToSave.Name = Path.GetFileName(chosenPath);
                tabToSave.OriginalContent = queryText;
                await QueryStateService.SaveTabsAsync();
                StateHasChanged();
                return true;
            }
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            return false;
        }
    }

    private async Task SaveAsQueryAsync()
    {
        try
        {
            var queryText = await _editor.GetValue();
            var activeTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
            if (activeTab == null) return;
            activeTab.Content = queryText;

                        var chosenPath = await WindowManager.ShowSaveFileDialogAsync(activeTab.Name);
            if (!string.IsNullOrEmpty(chosenPath))
            {
                await File.WriteAllTextAsync(chosenPath, queryText);
                activeTab.FilePath = chosenPath;
                activeTab.Name = Path.GetFileName(chosenPath);
                activeTab.OriginalContent = queryText;
                await QueryStateService.SaveTabsAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    [JSInvokable]
    public string? GetSchemaDocumentation(string objectName)
    {
        string unbracketed = objectName.Replace("[", "").Replace("]", "");
        var parts = unbracketed.Split('.');
        string? schema = parts.Length > 1 ? parts[0] : null;
        string name = parts.Length > 1 ? parts[1] : parts[0];

        var table = SchemaService.Tables.FirstOrDefault(t => 
            (schema == null || string.Equals(t.Schema, schema, StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase));
            
        if (table != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**Table:** `{table.FullName}`\n");
            sb.AppendLine("| Column | Data Type |");
            sb.AppendLine("|---|---|");
            foreach(var col in table.Columns)
            {
                sb.AppendLine($"| {col.Name} | {col.DataType} |");
            }
            return sb.ToString();
        }

        var view = SchemaService.Views.FirstOrDefault(v => 
            (schema == null || string.Equals(v.Schema, schema, StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(v.Name, name, StringComparison.OrdinalIgnoreCase));
            
        if (view != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**View:** `{view.FullName}`\n");
            sb.AppendLine("| Column | Data Type |");
            sb.AppendLine("|---|---|");
            foreach(var col in view.Columns)
            {
                sb.AppendLine($"| {col.Name} | {col.DataType} |");
            }
            return sb.ToString();
        }

        var sp = SchemaService.StoredProcedures.FirstOrDefault(s =>
            (schema == null || string.Equals(s.Schema, schema, StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(s.Name, name, StringComparison.OrdinalIgnoreCase));

        if (sp != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**Stored Procedure:** `{sp.FullName}`\n");
            if (sp.Parameters.Any())
            {
                sb.AppendLine("| Parameter | Type | Mode |");
                sb.AppendLine("|---|---|---|");
                foreach (var p in sp.Parameters)
                {
                    sb.AppendLine($"| {p.Name} | {p.DisplayType} | {(p.IsOutput ? "OUTPUT" : "INPUT")} |");
                }
            }
            else
            {
                sb.AppendLine("*No parameters*");
            }
            return sb.ToString();
        }

        var fn = SchemaService.Functions.FirstOrDefault(f =>
            (schema == null || string.Equals(f.Schema, schema, StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(f.Name, name, StringComparison.OrdinalIgnoreCase));

        if (fn != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**Function:** `{fn.FullName}` ({fn.FunctionType})\n");
            if (fn.Parameters.Any())
            {
                sb.AppendLine("| Parameter | Type |");
                sb.AppendLine("|---|---|");
                foreach (var p in fn.Parameters)
                {
                    sb.AppendLine($"| {p.Name} | {p.DisplayType} |");
                }
            }
            else
            {
                sb.AppendLine("*No parameters*");
            }
            return sb.ToString();
        }

        return null;
    }

