    private string GetFormattedExecutionTimeMs(long totalMs)
    {
        if (totalMs < 1000) return $"{totalMs}ms";
        var ts = TimeSpan.FromMilliseconds(totalMs);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        if (ts.TotalMinutes >= 1) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{Math.Round(ts.TotalSeconds, 1)}s";
    }

    private string GetFormattedExecutionTime(int totalSeconds)
    {
        if (totalSeconds < 60) return $"{totalSeconds}s";
        var ts = TimeSpan.FromSeconds(totalSeconds);
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Minutes}m {ts.Seconds}s";
    }

    private async Task UpdateTimerAsync(ExploreDB.Services.QueryTab tab)
    {
        var start = DateTime.UtcNow;
        while (tab.IsExecuting)
        {
            await Task.Delay(500);
            if (tab.IsExecuting)
            {
                tab.ExecElapsedSeconds = (int)(DateTime.UtcNow - start).TotalSeconds;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CancelExecution()
    {
        if (ActiveTab.QueryCts != null && !ActiveTab.QueryCts.IsCancellationRequested)
        {
            ActiveTab.QueryCts.Cancel();
        }
    }

    [JSInvokable]
    public async Task SaveQueryFromShortcut()
    {
        await SaveActiveQueryAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task NewTabFromShortcut()
    {
        await NewTabAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task ExecuteQueryFromShortcut()
    {
        await ExecuteAsync();
        StateHasChanged();
    }

    private async Task ExecuteAsync()
    {
        if (ActiveTab.IsExecuting) return;

        var queryText = "";
        try
        {
            var selection = await _editor.GetSelection();
            if (selection != null && (selection.StartLineNumber != selection.EndLineNumber || selection.StartColumn != selection.EndColumn))
            {
                var model = await _editor.GetModel();
                queryText = await model.GetValueInRange(selection, EndOfLinePreference.TextDefined);
            }
        }
        catch { }

        if (string.IsNullOrWhiteSpace(queryText))
        {
            queryText = await _editor.GetValue();
        }

        if (string.IsNullOrWhiteSpace(queryText))
        {
            ActiveTab.Messages.Add("Error: Query is empty.");
            ResultTab = "Messages";
            return;
        }

        var q = StripLeadingComments(queryText);
        ActiveTab.IsCurrentQuerySelect = q.StartsWith("select", StringComparison.OrdinalIgnoreCase) || 
                                q.StartsWith("with", StringComparison.OrdinalIgnoreCase);

        ActiveTab.IsExecuting = true;
        ActiveTab.HasExecuted = true;
        ActiveTab.ExecElapsedSeconds = 0;
        
        ActiveTab.QueryCts = new CancellationTokenSource();
        _ = UpdateTimerAsync(ActiveTab);

        ActiveTab.ResultSets.Clear();
        ActiveTab.Messages.Clear();
        ResultTab = "Results";
        StateHasChanged();

        var watch = System.Diagnostics.Stopwatch.StartNew();
        bool isSuccess = false;
        string? errorMessage = null;
        string dbName = "";
        string serverName = "";

        try
        {
            if (string.IsNullOrEmpty(ActiveTab.ConnectionString))
            {
                ActiveTab.Messages.Add("Error: Tab is disconnected. Please select a database from the sidebar.");
                ResultTab = "Messages";
                return;
            }

            var connStrBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ActiveTab.ConnectionString);
            if (string.IsNullOrEmpty(connStrBuilder.InitialCatalog))
            {
                ActiveTab.Messages.Add("Error: No database selected. Please select a database from the sidebar before executing.");
                ResultTab = "Messages";
                return;
            }

            QueryStateService.CustomQuery = queryText;
            using var conn = new SqlConnection(ActiveTab.ConnectionString);
            dbName = conn.Database;
            serverName = conn.DataSource;
            conn.InfoMessage += (sender, args) =>
            {
                ActiveTab.Messages.Add(args.Message);
                InvokeAsync(StateHasChanged);
            };
            await conn.OpenAsync();

            if (!ActiveTab.IsCurrentQuerySelect)
            {
                bool allowNonSelect = Config.GetValue<bool>("AllowNonSelectQueries", false);
                if (!allowNonSelect)
                {
                    ActiveTab.Messages.Add("Error: Execution of non-SELECT statements is disabled.");
                    ResultTab = "Messages";
                    return;
                }

                bool confirm = await ConfirmDangerousQueryAsync();
                if (!confirm)
                {
                    ActiveTab.Messages.Add("Execution cancelled by user.");
                    ResultTab = "Messages";
                    return;
                }
            }

            using var cmd = conn.CreateCommand();
            cmd.CommandText = QueryStateService.CustomQuery;
            cmd.CommandTimeout = 0;
            
            using var reader = await cmd.ExecuteReaderAsync(ActiveTab.QueryCts.Token);
            int totalRows = 0;
            
            do
            {
                try
                {
                    var rs = new List<dynamic>();
                    int fieldCount = reader.FieldCount;
                    
                    if (fieldCount > 0)
                    {
                        var columnNames = new string[fieldCount];
                        for (int i = 0; i < fieldCount; i++)
                        {
                            columnNames[i] = reader.GetName(i);
                            if (string.IsNullOrEmpty(columnNames[i])) columnNames[i] = $"Column{i}";
                        }

                        int yieldCount = 0;
                        while (await reader.ReadAsync(ActiveTab.QueryCts.Token))
                        {
                            var row = new System.Dynamic.ExpandoObject() as IDictionary<string, object>;
                            for (int i = 0; i < fieldCount; i++)
                            {
                                row[columnNames[i]] = await reader.IsDBNullAsync(i, ActiveTab.QueryCts.Token) ? null! : reader.GetValue(i);
                            }
                            rs.Add(row);
                            
                            if (++yieldCount % 5000 == 0) await Task.Delay(1);
                        }
                        
                        ActiveTab.ResultSets.Add(rs);
                        totalRows += rs.Count;
                    }
                    else
                    {
                        if (reader.RecordsAffected >= 0)
                        {
                            ActiveTab.Messages.Add($"({reader.RecordsAffected} row(s) affected)");
                        }
                    }
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // If a specific result set fails (e.g. invalid column in the second query), 
                    // we log it as a message and break out.
                    ActiveTab.Messages.Add($"Error reading result set: {ex.Message}");
                    break;
                }
            }
            while (await reader.NextResultAsync(ActiveTab.QueryCts.Token));
            
            ActiveTab.Messages.Add("Executed custom query.");
            ActiveTab.Messages.Add($"Result Sets: {ActiveTab.ResultSets.Count}, Total Rows: {totalRows}");
            isSuccess = true;
        }
        catch (Exception ex)
        {
            if (ActiveTab.QueryCts != null && ActiveTab.QueryCts.IsCancellationRequested)
            {
                ActiveTab.Messages.Add("Execution cancelled by user.");
                ResultTab = "Messages";
                errorMessage = "Cancelled";
            }
            else
            {
                ActiveTab.Messages.Add($"ERROR: {ex.Message}");
                ResultTab = "Messages";
                errorMessage = ex.Message;
            }
        }
        finally
        {
            watch.Stop();
            ActiveTab.LastExecutionTimeMs = watch.ElapsedMilliseconds;
            ActiveTab.IsExecuting = false;
            if (!string.IsNullOrWhiteSpace(QueryStateService.CustomQuery))
            {
                await HistoryService.AddHistoryItemAsync(QueryStateService.CustomQuery, serverName, dbName, watch.ElapsedMilliseconds, isSuccess, errorMessage);
            }
            ActiveTab.QueryCts?.Dispose();
            ActiveTab.QueryCts = null;
        }
    }
}


