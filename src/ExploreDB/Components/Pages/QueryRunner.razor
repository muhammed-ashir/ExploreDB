            savePicker.SuggestedStartLocation = Windows.Storage.Pickers.PickerLocationId.DocumentsLibrary;
            savePicker.FileTypeChoices.Add("SQL Script", new List<string>() { ".sql" });
            savePicker.FileTypeChoices.Add("Plain Text", new List<string>() { ".txt" });
            savePicker.SuggestedFileName = activeTab.Name;

            var mauiWindow = Microsoft.Maui.Controls.Application.Current?.Windows.FirstOrDefault();
            if (mauiWindow?.Handler?.PlatformView is Microsoft.UI.Xaml.Window winuiWindow)
            {
                var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(winuiWindow);
                WinRT.Interop.InitializeWithWindow.Initialize(savePicker, hwnd);
            }

            var file = await savePicker.PickSaveFileAsync();
            if (file != null)
            {
                await Windows.Storage.FileIO.WriteTextAsync(file, queryText);
                activeTab.FilePath = file.Path;
                activeTab.Name = file.Name;
                activeTab.OriginalContent = queryText;
                await QueryStateService.SaveTabsAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    [JSInvokable]
    public string? GetSchemaDocumentation(string objectName)
    {
        var table = SchemaService.Tables.FirstOrDefault(t => string.Equals(t.Name, objectName, StringComparison.OrdinalIgnoreCase) || string.Equals(t.FullName, objectName, StringComparison.OrdinalIgnoreCase));
        if (table != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**Table:** `{table.FullName}`\n");
            sb.AppendLine("| Column | Data Type |");
            sb.AppendLine("|---|---|");
            foreach(var col in table.Columns)
            {
                sb.AppendLine($"| {col.Name} | {col.DataType} |");
            }
            return sb.ToString();
        }

        var view = SchemaService.Views.FirstOrDefault(v => string.Equals(v.Name, objectName, StringComparison.OrdinalIgnoreCase) || string.Equals(v.FullName, objectName, StringComparison.OrdinalIgnoreCase));
        if (view != null)
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"**View:** `{view.FullName}`\n");
            sb.AppendLine("| Column | Data Type |");
            sb.AppendLine("|---|---|");
            foreach(var col in view.Columns)
            {
                sb.AppendLine($"| {col.Name} | {col.DataType} |");
            }
            return sb.ToString();
        }

        return null;
    }

