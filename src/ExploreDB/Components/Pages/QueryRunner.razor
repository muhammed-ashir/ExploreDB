@page "/"
@page "/runner"
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@using Microsoft.Data.SqlClient
@using System.Data
@using Microsoft.Extensions.Configuration
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HistoryService HistoryService
@implements IDisposable

<div class="container-fluid d-flex flex-column h-100">
    <div class="row mb-3">
        <div class="col d-flex justify-content-between align-items-center flex-nowrap">
            <div class="position-relative me-5" style="min-width: 0;">
                <div class="d-flex align-items-center cursor-pointer text-white w-100" data-bs-tooltip="true" data-bs-title="@GetTabTooltip(ActiveTab)" data-bs-html="true" data-bs-placement="bottom" @onclick="() => IsTabDropdownOpen = !IsTabDropdownOpen">
                    <span class="me-2 fs-6 text-truncate">@GetTabDisplayName(ActiveTab)</span>
                    <i class="bi bi-chevron-down flex-shrink-0" style="font-size: 0.85rem;"></i>
                </div>
                @if (IsTabDropdownOpen)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsTabDropdownOpen = false"></div>
                    <div class="dropdown-menu show bg-dark border-secondary shadow-lg p-1 mt-2" style="position: absolute; top: 100%; left: 0; z-index: 1050; min-width: 450px; max-width: 600px; overflow-x: hidden;">
                        <div class="p-1 mb-1 d-flex align-items-center">
                            <input type="text" class="form-control form-control-sm bg-black text-white border-secondary flex-grow-1 @(QueryStateService.Tabs.Count > 1 ? "me-2" : "")" placeholder="Search tabs..." @bind="TabSearchTerm" @bind:event="oninput" @onclick:stopPropagation />
                            @if (QueryStateService.Tabs.Count > 1)
                            {
                                <button class="btn btn-sm btn-outline-danger border-0 d-flex align-items-center justify-content-center flex-shrink-0 rounded-1" style="width: 30px; height: 30px;" @onclick="ClearAllTabsAsync" @onclick:stopPropagation data-bs-tooltip="true" data-bs-title="Clear All Tabs" data-bs-placement="bottom">
                                    <i class="bi bi-trash" style="font-size: 1.1rem;"></i>
                                </button>
                            }
                        </div>
                        <div class="custom-scrollbar-light custom-scrollbar-solid-track" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var tab in QueryStateService.Tabs.Where(t => !t.IsPoppedOut && (string.IsNullOrEmpty(TabSearchTerm) || t.Name.Contains(TabSearchTerm, StringComparison.OrdinalIgnoreCase))))
                        {
                            <div class="dropdown-item d-flex justify-content-between align-items-center text-white @(tab.Id == QueryStateService.ActiveTabId ? "bg-primary bg-opacity-25 rounded-1" : "rounded-1")" style="cursor: pointer; min-width: 0;" data-bs-tooltip="true" data-bs-title="@GetTabTooltip(tab)" data-bs-html="true" data-bs-placement="right" @onclick="async () => { await SwitchTabAsync(tab.Id); IsTabDropdownOpen = false; }">
                                <div class="d-flex flex-column text-truncate me-3" style="flex: 1; min-width: 0;">
                                    <span class="text-truncate">@GetTabDisplayName(tab)</span>
                                    @if (!string.IsNullOrEmpty(GetTabConnectionSummary(tab)))
                                    {
                                        <span class="text-secondary text-truncate" style="font-size: 0.7rem;">@GetTabConnectionSummary(tab)</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center flex-shrink-0">
                                    @if (QueryStateService.Tabs.Count(t => !t.IsPoppedOut) > 1)
                                    {
                                        <button class="btn btn-sm btn-outline-info border-0 p-0 rounded me-1 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" @onclick="async () => { await PopoutTabAsync(tab.Id); IsTabDropdownOpen = false; }" @onclick:stopPropagation title="Pop Out">
                                            <i class="bi bi-box-arrow-up-right" style="font-size: 0.9rem;"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger border-0 p-0 rounded d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" @onclick="async () => { await CloseTabAsync(tab.Id); IsTabDropdownOpen = false; }" @onclick:stopPropagation title="Close">
                                            <i class="bi bi-x" style="font-size: 1.3rem;"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        </div>
                        <hr class="dropdown-divider border-secondary my-2">
                        <button class="dropdown-item text-info text-center py-1 mb-2 mt-1 rounded-2" style="border: 1px dashed var(--bs-info); margin-left: 10px; margin-right: 10px; width: calc(100% - 20px);" @onclick="async () => { await NewTabAsync(); IsTabDropdownOpen = false; }">
                            <i class="bi bi-plus-lg me-1"></i> New Query
                        </button>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
                <button class="btn btn-sm btn-outline-light shadow-sm" data-bs-tooltip="true" data-bs-title="Open File" data-bs-placement="bottom" @onclick="OpenFileAsync">
                    <i class="bi bi-folder2-open"></i>
                </button>
                <button class="btn btn-sm btn-outline-light shadow-sm" data-bs-tooltip="true" data-bs-title="Save Query" data-bs-placement="bottom" @onclick="SaveActiveQueryAsync">
                    <i class="bi bi-floppy"></i>
                </button>
                <button class="btn btn-sm btn-outline-light shadow-sm" data-bs-tooltip="true" data-bs-title="Save As..." data-bs-placement="bottom" @onclick="SaveAsQueryAsync">
                    <i class="bi bi-file-earmark-plus"></i>
                </button>
                <button class="btn btn-sm btn-outline-warning shadow-sm" data-bs-tooltip="true" data-bs-title="Clear Editor" data-bs-placement="bottom" @onclick="() => ShowClearConfirmation = true">
                    <i class="bi bi-eraser-fill"></i>
                </button>
                <button class="btn btn-sm btn-outline-info shadow-sm" data-bs-tooltip="true" data-bs-title="Format SQL" data-bs-placement="bottom" @onclick="FormatSqlAsync">
                    <i class="bi bi-magic"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary shadow-sm" data-bs-tooltip="true" data-bs-title="View History" data-bs-placement="bottom" @onclick='() => Nav.NavigateTo("/history")'>
                    <i class="bi bi-clock-history"></i>
                </button>
                @if (ActiveTab.IsExecuting)
                {
                    <button class="btn btn-sm btn-danger shadow-sm" data-bs-tooltip="true" data-bs-title="Stop Execution" data-bs-placement="bottom" @onclick="CancelExecution">
                        <i class="bi bi-stop-fill me-1"></i><span>Stop</span>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-primary shadow-sm" data-bs-tooltip="true" data-bs-title="Execute Query" data-bs-placement="bottom" @onclick="ExecuteAsync">
                        <i class="bi bi-play-fill me-1"></i><span>Execute</span>
                    </button>
                }
            </div>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(FormatError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Format Error:</strong> @FormatError
            <button type="button" class="btn-close" @onclick="() => FormatError = null" aria-label="Close"></button>
        </div>
    }

    <!-- Execution Harness Area -->
    <div class="row g-4 mb-4 @(!ActiveTab.HasExecuted || IsMinimized ? "flex-grow-1" : "")">
        <div class="col-12 @(!ActiveTab.HasExecuted || IsMinimized ? "d-flex flex-column" : "")">
            <div class="card bg-dark text-white shadow-sm border-secondary @(!ActiveTab.HasExecuted || IsMinimized ? "flex-grow-1 d-flex flex-column" : "")">
                <div class="card-body p-0 @(!ActiveTab.HasExecuted || IsMinimized ? "d-flex flex-column flex-grow-1" : "")">
                    <div class="@(!ActiveTab.HasExecuted || IsMinimized ? "flex-grow-1" : "")" style="@(ActiveTab.HasExecuted && !IsMinimized ? "height: 350px;" : "") width: 100%; display: block; resize: vertical; overflow: hidden; min-height: 150px; padding-bottom: 2px;">
                        <StandaloneCodeEditor @ref="_editor" Id="query-editor" CssClass="w-100 h-100" ConstructionOptions="EditorConstructionOptions" OnDidInit="EditorOnDidInit" OnDidChangeModelContent="EditorOnDidChangeModelContent" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Area --> 
    @if (ActiveTab.HasExecuted)
    {
        <div class="@(IsFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-4" : IsMinimized ? "position-sticky bottom-0 w-100 p-0 mt-auto" : "row")" 
             style="@(IsFullScreen ? "background-color: rgba(15, 15, 20, 0.95); z-index: 9999; padding-top: 60px !important;" : IsMinimized ? "z-index: 1030;" : "")">
            <div class="@(IsFullScreen || IsMinimized ? "w-100 h-100" : "col-12")">
                <div class="card glass-card text-white d-flex flex-column" style="@(IsFullScreen ? "height: 100%;" : IsMinimized ? "border-bottom-left-radius: 0; border-bottom-right-radius: 0;" : "min-height: 400px;")">
                    <div class="card-header border-secondary p-0 d-flex justify-content-between align-items-center">
                        <ul class="nav nav-tabs border-secondary flex-grow-1 border-bottom-0">
                            <li class="nav-item">
                                <a class="nav-link @(ResultTab == "Results" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")"
                                   @onclick='() => { ResultTab = "Results"; IsMinimized = false; }' style="cursor:pointer">Results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ResultTab == "Messages" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")"
                                   @onclick='() => { ResultTab = "Messages"; IsMinimized = false; }' style="cursor:pointer">
                                    Messages
                                    @if (ActiveTab.Messages.Count > 0) { <span class="badge bg-secondary ms-1">@ActiveTab.Messages.Count</span> }
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center pe-2">
                            @if (ActiveTab.HasExecuted && ActiveTab.LastExecutionTimeMs > 0 && !ActiveTab.IsExecuting)
                            {
                                <span class="text-muted small me-3"><i class="bi bi-stopwatch me-1"></i>@GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)</span>
                            }
                            @if (!IsFullScreen)
                            {
                                <button class="btn btn-sm btn-outline-secondary border-0 text-white me-1" @onclick="ToggleMinimize" title="@(IsMinimized ? "Restore Up" : "Minimize")">
                                    <i class="bi @(IsMinimized ? "bi-chevron-up" : "bi-chevron-down")"></i>
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-secondary border-0 text-white @(!IsFullScreen ? "me-1" : "")" @onclick="ToggleFullScreen" title="@(IsFullScreen ? "Restore Down" : "Expand to Full Screen")">
                                <i class="bi @(IsFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                            </button>
                            
                            @if (!IsFullScreen)
                            {
                                <button class="btn btn-sm btn-outline-secondary border-0 text-white" @onclick="() => ActiveTab.HasExecuted = false" title="Close Results">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </div>
                    </div>
                    @if (!IsMinimized)
                    {
                        <div class="card-body overflow-auto flex-grow-1">
                            @if (ResultTab == "Results")
                            {
                                if (ActiveTab.IsExecuting)
                                {
                                    <div class="text-center mt-5">
                                        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem; border-width: 0.25em;"></div>
                                        <div class="mt-3 text-muted fs-5">Executing... (@GetFormattedExecutionTime(ActiveTab.ExecElapsedSeconds))</div>
                                    </div>
                                }
                                else if (ActiveTab.ResultSets.Count == 0 && !ActiveTab.HasExecuted)
                                {
                                    <div class="text-muted text-center mt-5">
                                        Enter a custom query and click Execute to see results.
                                    </div>
                                }
                                else if (ActiveTab.ResultSets.Count == 0 && ActiveTab.HasExecuted)
                                {
                                    <div class="text-muted text-center mt-5">Command completed successfully. No data tables returned.</div>
                                }
                                else
                                {
                                    int rsIndex = 1;
                                    foreach (var rs in ActiveTab.ResultSets)
                                    {
                                        @if (ActiveTab.ResultSets.Count > 1) 
                                        { 
                                            <div class="d-flex align-items-center mb-3 mt-4">
                                                <hr class="flex-grow-1 border-secondary m-0" style="opacity: 0.3;">
                                                <span class="px-3 fw-bold text-info" style="letter-spacing: 1px; font-size: 0.95rem;">Result Set @rsIndex</span>
                                                <hr class="flex-grow-1 border-secondary m-0" style="opacity: 0.3;">
                                            </div>
                                        }
                                        <ResultSetGrid Data="rs" OnExportStateChanged="HandleExportStateChanged" />
                                        rsIndex++;
                                    }
                                }
                            }
                            else if (ResultTab == "Messages")
                            {
                                <pre class="m-0 text-light" style="font-size: 0.85em; white-space: pre-wrap;">
@if (ActiveTab.Messages.Count == 0) { <span class="text-muted fst-italic">No Messages.</span> }
@foreach (var msg in ActiveTab.Messages) { @msg<br/> }
                                </pre>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (ActiveTab.ExecElapsedSeconds >= 10 && ActiveTab.IsCurrentQuerySelect)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 10000; animation: fadeIn 0.5s;">
        <div class="toast show bg-dark text-white shadow-lg" style="border: 1px solid rgba(255,193,7,0.5);" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-dark text-warning border-secondary border-opacity-50">
                <i class="bi bi-hourglass-split me-2"></i>
                <strong class="me-auto" style="letter-spacing: 0.5px;">Long Execution</strong>
                <button type="button" class="btn-close btn-close-white" onclick="this.closest('.toast-container').style.display='none'" aria-label="Close"></button>
            </div>
            <div class="toast-body text-start" style="font-size: 0.9rem; color: #ccc;">
                Execution is taking longer than usual. If you are querying a massive dataset, consider adding a <code class="text-warning bg-black px-1 rounded border border-secondary border-opacity-50">TOP</code> or <code class="text-warning bg-black px-1 rounded border border-secondary border-opacity-50">WHERE</code> clause to narrow down your results. Otherwise, please hold tight while we finish fetching your data!
            </div>
        </div>
    </div>
}

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowClearConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-body p-4 pb-2">
                    <p class="text-light text-opacity-75 mb-0" style="font-size: 0.95rem;">
                        Are you sure you want to <strong class="text-warning">clear the editor</strong>? This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-dark border-secondary" @onclick="() => ShowClearConfirmation = false">Cancel</button>
                    <button type="button" class="btn btn-warning px-4 fw-bold shadow-sm text-dark" @onclick="ClearQueryAsync">Clear</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDangerousQueryWarning)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-body p-4 pb-2">
                    <div class="fw-bold text-white mb-2" style="font-size: 1rem;">Confirm Execution</div>
                    <p class="text-light text-opacity-75 mb-0" style="font-size: 0.9rem;">
                        This query may modify the database. Are you sure you want to execute it?
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-dark border-secondary" @onclick="() => ResolveDangerousQueryWarning(false)">Cancel</button>
                    <button type="button" class="btn btn-danger px-4 fw-bold shadow-sm" @onclick="() => ResolveDangerousQueryWarning(true)">
                        <i class="bi bi-play-fill me-1"></i>Execute
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowCloseTabConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-body p-4 pb-2">
                    <p class="text-light text-opacity-75 mb-0" style="font-size: 0.95rem;">
                        This tab has <strong class="text-warning">unsaved code</strong>. Do you want to save it before closing?
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-dark border-secondary" @onclick="() => ShowCloseTabConfirmation = false">Cancel</button>
                    <button type="button" class="btn btn-danger text-white shadow-sm" @onclick="() => ConfirmCloseTabAsync()">Don't Save</button>
                    <button type="button" class="btn btn-warning px-4 fw-bold shadow-sm text-dark" @onclick="SaveAndCloseTabAsync">Save & Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowClearAllTabsConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-body p-4 pb-2">
                    <p class="text-light text-opacity-75 mb-0" style="font-size: 0.95rem;">
                        You have <strong class="text-warning">unsaved queries</strong>. Are you sure you want to close all tabs? Unsaved changes will be lost.
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-dark border-secondary" @onclick="() => ShowClearAllTabsConfirmation = false">Cancel</button>
                    <button type="button" class="btn btn-danger text-white px-4 shadow-sm" @onclick="() => ConfirmClearAllTabsAsync()">Clear All</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowRestoreSessionPrompt)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Restore Session?</h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Do you want to restore your previous query tabs?</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => HandleRestoreSessionAsync(true)">Yes</button>
                    <button type="button" class="btn btn-outline-secondary px-4 text-white" @onclick="() => HandleRestoreSessionAsync(false)">No, clear them</button>
                </div>
            </div>
        </div>
    </div>
}

@if (IsExportingToExcel)
{
    <div class="position-fixed d-flex justify-content-end pe-none" style="bottom: 20px; right: 20px; z-index: 10000;">
        <div class="bg-dark border-success d-flex align-items-center justify-content-between shadow-lg rounded-1 p-3 pe-auto" style="border-style: solid; border-width: 1px 1px 1px 4px !important; min-width: 350px;">
            <div class="d-flex align-items-center gap-3 pe-4">
                <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                <div>
                    <strong class="text-white d-block mb-1" style="font-size: 0.9rem;">Exporting to Excel...</strong>
                    <span class="text-light opacity-75" style="font-size: 0.75rem;">Preparing your data for download...</span>
                </div>
            </div>
            @if (CancelExportAction != null)
            {
                <button class="btn btn-sm btn-outline-danger px-3 rounded-pill flex-shrink-0" @onclick="() => CancelExportAction?.Invoke()">Cancel</button>
            }
        </div>
    </div>
}

@if (ShowExportSuccess)
{
    <div class="position-fixed d-flex justify-content-end pe-none" style="bottom: 20px; right: 20px; z-index: 10000;">
        <div class="bg-dark border-primary d-flex align-items-center justify-content-between shadow-lg rounded-1 p-3 pe-auto" style="border-style: solid; border-width: 1px 1px 1px 4px !important; min-width: 350px;">
            <div class="d-flex align-items-center gap-3 pe-4">
                <i class="bi bi-check-circle-fill text-primary fs-4"></i>
                <div>
                    <strong class="text-white d-block mb-1" style="font-size: 0.9rem;">Export Complete</strong>
                    <span class="text-light opacity-75" style="font-size: 0.75rem;">Check your download folder.</span>
                </div>
            </div>
            <button class="btn btn-sm text-muted flex-shrink-0" @onclick="() => ShowExportSuccess = false"><i class="bi bi-x-lg"></i></button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? ObjectType { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    public string? ObjectName { get; set; }

    [SupplyParameterFromQuery(Name = "query")]
    public string? InitialQuery { get; set; }

    private string ResultTab = "Results";
    private ExploreDB.Services.QueryTab _fallbackTab = new ExploreDB.Services.QueryTab();
    private ExploreDB.Services.QueryTab ActiveTab => QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId) ?? _fallbackTab;
    
    // Global Export State
    private bool IsExportingToExcel = false;
    private bool ShowExportSuccess = false;
    private Action? CancelExportAction;

    private void HandleExportStateChanged(ExploreDB.Components.Pages.ResultSetGrid.ExportStatus status)
    {
        if (status.IsExporting)
        {
            IsExportingToExcel = true;
            ShowExportSuccess = false;
            CancelExportAction = status.CancelAction;
        }
        else if (status.IsSuccess)
        {
            IsExportingToExcel = false;
            ShowExportSuccess = true;
            CancelExportAction = null;
        }
        else
        {
            IsExportingToExcel = false;
            CancelExportAction = null;
        }
        StateHasChanged();
    }
    private bool IsFullScreen = false;
    private bool IsMinimized = false;

    private void ToggleMinimize()
    {
        IsMinimized = !IsMinimized;
        if (IsMinimized) IsFullScreen = false;
    }

    private void ToggleFullScreen()
    {
        IsFullScreen = !IsFullScreen;
        if (IsFullScreen) IsMinimized = false;
    }
    private string? FormatError = null;
    private StandaloneCodeEditor _editor = default!;
