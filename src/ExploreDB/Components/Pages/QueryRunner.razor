    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("window.globalShortcuts.unregisterQueryRunner"); } catch { }
        _objRef?.Dispose();
        _saveDebounceTimer?.Dispose();
        ConnectionService.OnConnectionChanged -= OnConnectionChangedHandler;
        ConnectionService.OnDatabaseSwitching -= OnDatabaseSwitchingHandler;
        SchemaService.OnTablesLoaded -= OnSchemaLoadedHandler;
        SchemaService.OnViewsLoaded -= OnSchemaLoadedHandler;
        SchemaService.OnStoredProceduresLoaded -= OnSchemaLoadedHandler;
        QueryStateService.OnTabUpdated -= HandleTabUpdated;
    }

    private async void HandleTabUpdated(Guid tabId)
    {
        if (QueryStateService.ActiveTabId == tabId && _editor != null)
        {
            var tab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == tabId);
            if (tab != null)
            {
                var currentEditorContent = await _editor.GetValue();
                if (currentEditorContent != tab.Content)
                {
                    await _editor.SetValue(tab.Content);
                }
            }
        }
        await InvokeAsync(StateHasChanged);
    }

