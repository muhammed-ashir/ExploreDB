    [JSInvokable]
    public async Task ExecuteQueryFromShortcut()
    {
        try
        {
            await ExecuteAsync();
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Shortcut query execution error handled in QueryRunner");
        }
        StateHasChanged();
    }

    private async Task ExecuteAsync()
    {
        var targetTab = ActiveTab;
        if (targetTab.IsExecuting) return;

        Func<Task<string>>? fallback = _editor != null ? () => _editor.GetValue() : null;
        var (queryText, fullScript, lineOffset) = await QueryExecutionService.ResolveEditorInputAsync(
            JS, "query-editor", fallback, targetTab);

        await QueryExecutionService.ExecuteAsync(new QueryExecutionRequest
        {
            Tab = targetTab,
            QueryText = queryText,
            FullScript = fullScript,
            LineOffset = lineOffset,
            InvokeOnUiAsync = InvokeAsync,
            SetActiveResultTab = tabName =>
            {
                if (targetTab == ActiveTab)
                {
                    ResultTab = tabName;
                }
            },
            NotifyUi = StateHasChanged,
            ConfirmDangerousQueryAsync = ConfirmDangerousQueryAsync,
            SaveHistory = true,
            IsPopout = false
        });
    }
}
