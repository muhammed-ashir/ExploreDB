@page "/"
@page "/runner"
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@using Dapper
@using Microsoft.Data.SqlClient
@using System.Data
@using Microsoft.Extensions.Configuration
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IJSRuntime JS

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <h2 class="text-white mb-0 fw-bold">Query Runner</h2>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-info fw-bold shadow" @onclick="FormatSqlAsync">
                    <i class="bi bi-magic me-1"></i> Format
                </button>
                <button class="btn btn-primary fw-bold shadow" @onclick="ExecuteAsync" disabled="@IsExecuting">
                    @if (IsExecuting) { <span class="spinner-border spinner-border-sm me-2"></span><span>Executing...</span> }
                    else { <i class="bi bi-play-fill me-1"></i><span>Execute</span> }
                </button>
            </div>
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(FormatError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Format Error:</strong> @FormatError
            <button type="button" class="btn-close" @onclick="() => FormatError = null" aria-label="Close"></button>
        </div>
    }

    <!-- Execution Harness Area -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card glass-card text-white shadow-sm border-secondary">
                <div class="card-body p-0">
                    <div style="height: 350px; width: 100%; display: block; resize: vertical; overflow: hidden; min-height: 150px; padding-bottom: 2px;">
                        <StandaloneCodeEditor @ref="_editor" Id="query-editor" CssClass="w-100 h-100" ConstructionOptions="EditorConstructionOptions" OnDidInit="EditorOnDidInit" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Area --> 
    <div class="@(IsFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-4" : "row")" style="@(IsFullScreen ? "background-color: rgba(15, 15, 20, 0.95); z-index: 9999; padding-top: 60px !important;" : "")">
        <div class="@(IsFullScreen ? "w-100 h-100" : "col-12")">
            <div class="card glass-card text-white d-flex flex-column" style="@(IsFullScreen ? "height: 100%;" : "min-height: 400px;")">
                <div class="card-header border-secondary p-0 d-flex justify-content-between align-items-center">
                    <ul class="nav nav-tabs border-secondary flex-grow-1 border-bottom-0">
                        <li class="nav-item">
                            <a class="nav-link @(ResultTab == "Results" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")"
                               @onclick='() => ResultTab = "Results"' style="cursor:pointer">Results</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ResultTab == "Messages" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")"
                               @onclick='() => ResultTab = "Messages"' style="cursor:pointer">
                                Messages
                                @if (Messages.Count > 0) { <span class="badge bg-secondary ms-1">@Messages.Count</span> }
                            </a>
                        </li>
                    </ul>
                    <div class="pe-2">
                        <button class="btn btn-sm btn-outline-secondary border-0 text-white" @onclick="() => IsFullScreen = !IsFullScreen" title="@(IsFullScreen ? "Restore Down" : "Expand to Full Screen")">
                            <i class="bi @(IsFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body overflow-auto flex-grow-1">
                    @if (ResultTab == "Results")
                    {
                        if (IsExecuting)
                        {
                            <div class="text-center mt-5"><div class="spinner-border text-primary"></div><div class="mt-2 text-muted">Executing...</div></div>
                        }
                        else if (ResultSets.Count == 0 && !HasExecuted)
                        {
                            <div class="text-muted text-center mt-5">
                                Enter a custom query and click Execute to see results.
                            </div>
                        }
                        else if (ResultSets.Count == 0 && HasExecuted)
                        {
                            <div class="text-muted text-center mt-5">Command completed successfully. No data tables returned.</div>
                        }
                        else
                        {
                            int rsIndex = 1;
                            foreach (var rs in ResultSets)
                            {
                                @if (ResultSets.Count > 1) { <div class="fw-bold mb-2 mt-3 text-info">Result Set @rsIndex</div> }
                                <ResultSetGrid Data="rs" />
                                rsIndex++;
                            }
                        }
                    }
                    else if (ResultTab == "Messages")
                    {
                        <pre class="m-0 text-light" style="font-size: 0.85em; white-space: pre-wrap;">
@if (Messages.Count == 0) { <span class="text-muted fst-italic">No messages.</span> }
@foreach (var msg in Messages) { @msg<br/> }
                        </pre>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? ObjectType { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    public string? ObjectName { get; set; }

    [SupplyParameterFromQuery(Name = "query")]
    public string? InitialQuery { get; set; }

    private string ResultTab = "Results";
    private bool IsExecuting = false;
    private bool HasExecuted = false;
    private bool IsFullScreen = false;
    
    private List<IEnumerable<dynamic>> ResultSets = new();
    private List<string> Messages = new();
    private string? FormatError = null;
    private StandaloneCodeEditor _editor = default!;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            Language = "sql",
            Theme = "vs-dark",
            Value = QueryStateService.CustomQuery ?? "",
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "on",
            OverviewRulerBorder = false,
            HideCursorInOverviewRuler = true,
            ScrollBeyondLastLine = false,
            FontSize = 14,
            Scrollbar = new EditorScrollbarOptions { UseShadows = false }
        };
    }

    private async Task EditorOnDidInit()
    {
        var tables = SchemaService.Tables.Select(t => t.Name).ToList();
        var views = SchemaService.Views.Select(v => v.Name).ToList();
        await JS.InvokeVoidAsync("registerSqlAutocomplete", tables, views);
    }

    private async Task FormatSqlAsync()
    {
        FormatError = null;
        var currentQuery = await _editor.GetValue();
        if (!string.IsNullOrWhiteSpace(currentQuery))
        {
            try
            {
                var formatted = await JS.InvokeAsync<string>("formatSql", currentQuery);
                await _editor.SetValue(formatted);
            }
            catch (Exception ex)
            {
                // The JS interop throws a detailed JS exception string which can be a bit noisy.
                // We extract just the relevant message if possible, or show a friendly message.
                FormatError = "Syntax error near: " + ex.Message.Split('\n').FirstOrDefault()?.Replace("Error:", "").Trim();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialQuery))
        {
            QueryStateService.CustomQuery = InitialQuery;
            if (_editor != null)
            {
                await _editor.SetValue(InitialQuery);
            }
        }
    }

    private async Task ExecuteAsync()
    {
        if (IsExecuting) return;

        IsExecuting = true;
        HasExecuted = true;
        ResultSets.Clear();
        Messages.Clear();
        ResultTab = "Results";
        StateHasChanged();

        try
        {
            QueryStateService.CustomQuery = await _editor.GetValue();
            using var conn = new SqlConnection(ConnectionService.ConnectionString);
            conn.InfoMessage += (sender, args) =>
            {
                Messages.Add(args.Message);
                InvokeAsync(StateHasChanged);
            };
            await conn.OpenAsync();

            if (string.IsNullOrWhiteSpace(QueryStateService.CustomQuery))
            {
                Messages.Add("Error: Query is empty.");
                ResultTab = "Messages";
                return;
            }

            var q = QueryStateService.CustomQuery.TrimStart();
            bool isSelectOrWith = q.StartsWith("select", StringComparison.OrdinalIgnoreCase) || 
                                  q.StartsWith("with", StringComparison.OrdinalIgnoreCase);

            if (!isSelectOrWith)
            {
                bool allowNonSelect = Config.GetValue<bool>("AllowNonSelectQueries", false);
                if (!allowNonSelect)
                {
                    Messages.Add("Error: Execution of non-SELECT statements is disabled.");
                    ResultTab = "Messages";
                    return;
                }

                bool confirm = await JS.InvokeAsync<bool>("confirm", "⚠️ WARNING: This query may modify data or schema.\n\nAre you sure you want to execute it?");
                if (!confirm)
                {
                    Messages.Add("Execution cancelled by user.");
                    ResultTab = "Messages";
                    return;
                }
            }

            var rs = await conn.QueryAsync<dynamic>(QueryStateService.CustomQuery, commandTimeout: 0);
            ResultSets.Add(rs);
            Messages.Add("Executed custom query.");
            Messages.Add($"Rows returned: {rs.Count()}");
        }
        catch (Exception ex)
        {
            Messages.Add($"ERROR: {ex.Message}");
            ResultTab = "Messages";
        }
        finally
        {
            IsExecuting = false;
        }
    }
}
