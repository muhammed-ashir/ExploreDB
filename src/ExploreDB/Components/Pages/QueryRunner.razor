    {
        if (string.IsNullOrWhiteSpace(_editingSnippet.Shortcut))
        {
            _snippetValidationMsg = "Shortcut cannot be empty.";
            return;
        }
        if (_editingSnippet.Shortcut.Contains(" "))
        {
            _snippetValidationMsg = "Shortcut cannot contain spaces.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editingSnippet.Code))
        {
            _snippetValidationMsg = "Snippet code cannot be empty.";
            return;
        }

        await SnippetService.SaveSnippetAsync(_editingSnippet);
        await UpdateEditorSnippetsAsync();
        IsSaveSnippetModalOpen = false;
        StateHasChanged();
    }

    [JSInvokable]
    public Task<string> GetClipboardTextAsync()
    {
        try
        {
            if (System.Windows.Clipboard.ContainsText())
            {
                return Task.FromResult(System.Windows.Clipboard.GetText());
            }
        }
        catch { }
        return Task.FromResult("");
    }

