    private string GetTabDisplayName(ExploreDB.Services.QueryTab? tab)
    {
        if (tab == null) return "Query Runner";
        return tab.IsDirty ? $"{tab.Name} *" : tab.Name;
    }

    private string GetTabConnectionSummary(ExploreDB.Services.QueryTab? tab)
    {
        if (tab == null || string.IsNullOrEmpty(tab.ConnectionString)) return "";
        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(tab.ConnectionString);
            string server = builder.DataSource;
            string db = builder.InitialCatalog;
            
            if (string.IsNullOrEmpty(db)) 
            {
                return "Not Connected";
            }
            
            return $"{server} ➔ {db}";
        }
        catch
        {
            return "";
        }
    }

    private string GetTabTooltip(ExploreDB.Services.QueryTab? tab)
    {
        if (tab == null) return "Query Runner";
        if (string.IsNullOrEmpty(tab.ConnectionString)) return $"<strong>Name:</strong> {tab.Name}";
        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(tab.ConnectionString);
            string server = builder.DataSource;
            string db = builder.InitialCatalog;
            
            if (string.IsNullOrEmpty(db))
            {
                return $"<strong>Name:</strong> {tab.Name}<br/><strong>Server:</strong> {server}<br/><strong>DB:</strong> Not Selected";
            }
            
            return $"<strong>Name:</strong> {tab.Name}<br/><strong>Server:</strong> {server}<br/><strong>DB:</strong> {db}";
        }
        catch
        {
            return $"<strong>Name:</strong> {tab.Name}";
        }
    }



    protected override async Task OnInitializedAsync()
    {
        ConnectionService.OnConnectionChanged += OnConnectionChangedHandler;
        ConnectionService.OnDatabaseSwitching += OnDatabaseSwitchingHandler;
        SchemaService.OnTablesLoaded += OnSchemaLoadedHandler;
        SchemaService.OnViewsLoaded += OnSchemaLoadedHandler;
        SchemaService.OnStoredProceduresLoaded += OnSchemaLoadedHandler;
        QueryStateService.OnTabUpdated += HandleTabUpdated;
        
        if (!QueryStateService.Initialized)
        {
            if (QueryStateService.HasSavedTabs())
            {
                ShowRestoreSessionPrompt = true;
                return;
            }
            else
            {
                await QueryStateService.LoadTabsAsync();
                
                // Set the initial tab's connection to whatever the global context is currently
                var firstTab = QueryStateService.Tabs.FirstOrDefault();
                if (firstTab != null && string.IsNullOrEmpty(firstTab.ConnectionString))
                {
                    firstTab.ConnectionString = ConnectionService.ConnectionString;
                }
            }
            QueryStateService.Initialized = true;
        }
    }

    private async Task HandleRestoreSessionAsync(bool restore)
    {
        ShowRestoreSessionPrompt = false;
        if (restore)
        {
            await QueryStateService.LoadTabsAsync();
            foreach (var tab in QueryStateService.Tabs)
            {
                tab.ConnectionString = ""; // Open tabs as not connected
            }
        }
        else
        {
            QueryStateService.ClearSavedState();
            await QueryStateService.LoadTabsAsync();
            var firstTab = QueryStateService.Tabs.FirstOrDefault();
            if (firstTab != null && string.IsNullOrEmpty(firstTab.ConnectionString))
            {
                firstTab.ConnectionString = ConnectionService.ConnectionString;
            }
        }
        QueryStateService.Initialized = true;
        
        var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
        if (currentTab != null && _editor != null)
        {
            await _editor.SetValue(currentTab.Content);
        }
        
        StateHasChanged();
    }

    private async Task SwitchTabAsync(Guid tabId)
    {
        if (QueryStateService.ActiveTabId == tabId) return;
        
        var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
        if (currentTab != null && _editor != null)
        {
            currentTab.Content = await _editor.GetValue();
        }

        QueryStateService.ActiveTabId = tabId;
        var newTab = QueryStateService.Tabs.First(t => t.Id == tabId);
        
        if (_editor != null)
        {
            await _editor.SetValue(newTab.Content);
        }
        
        if (string.IsNullOrEmpty(newTab.ConnectionString))
        {
            newTab.ConnectionString = ConnectionService.ConnectionString;
        }
        else if (newTab.ConnectionString != ConnectionService.ConnectionString)
        {
            ConnectionService.SaveActiveConnection(newTab.ConnectionString);
        }
        
        await QueryStateService.SaveTabsAsync();
    }

    private async Task NewTabAsync()
    {
        var maxTabs = Config.GetValue<int>("MaxOpenTabs", 20);
        if (QueryStateService.Tabs.Count >= maxTabs)
        {
            ShowLimitAlert = true;
            return;
        }

        var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
        if (currentTab != null && _editor != null)
        {
            currentTab.Content = await _editor.GetValue();
        }

        int newCount = 1;
        while (QueryStateService.Tabs.Any(t => t.Name == $"SQLQuery{newCount}.sql"))
        {
            newCount++;
        }
        
        var newTab = new ExploreDB.Services.QueryTab { 
            Name = $"SQLQuery{newCount}.sql",
            ConnectionString = ConnectionService.ConnectionString
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;

        if (_editor != null)
        {
            await _editor.SetValue(newTab.Content);
        }
        await QueryStateService.SaveTabsAsync();
    }

    private async Task OpenFileAsync()
    {
        try
        {
            var result = await Microsoft.Maui.Storage.FilePicker.Default.PickAsync(new Microsoft.Maui.Storage.PickOptions
            {
                PickerTitle = "Select a SQL file",
            });

            if (result != null)
            {
                var maxTabs = Config.GetValue<int>("MaxOpenTabs", 20);
                if (QueryStateService.Tabs.Count >= maxTabs)
                {
                    ShowLimitAlert = true;
                    return;
                }

                var text = await File.ReadAllTextAsync(result.FullPath);
                
                var currentTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId);
                if (currentTab != null && _editor != null)
                {
                    currentTab.Content = await _editor.GetValue();
                }

                var newTab = new ExploreDB.Services.QueryTab
                {
                    Name = result.FileName,
                    Content = text,
                    ConnectionString = ConnectionService.ConnectionString
                };
                QueryStateService.Tabs.Add(newTab);
                QueryStateService.ActiveTabId = newTab.Id;
                await QueryStateService.SaveTabsAsync();
                
                if (_editor != null)
                {
                    await _editor.SetValue(text);
                }
            }
        }
        catch { }
    }

    private async Task PopoutTabAsync(Guid tabId)
    {
        var tabToPop = QueryStateService.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tabToPop == null) return;

        if (QueryStateService.ActiveTabId == tabId && _editor != null)
        {
            tabToPop.Content = await _editor.GetValue();
        }

        tabToPop.IsPoppedOut = true;
        
        // Open native window via MAUI
        var windowTitle = string.IsNullOrEmpty(tabToPop.FilePath) ? tabToPop.Name : System.IO.Path.GetFileName(tabToPop.FilePath);
        if (windowTitle.Length > 100) windowTitle = windowTitle.Substring(0, 97) + "...";
        var popoutWindow = new Microsoft.Maui.Controls.Window(new PopoutPage(tabId, QueryStateService))
        {
            Title = windowTitle
        };
        Microsoft.Maui.Controls.Application.Current?.OpenWindow(popoutWindow);

        if (QueryStateService.ActiveTabId == tabId)
        {
            var nextTab = QueryStateService.Tabs.FirstOrDefault(t => !t.IsPoppedOut);
            if (nextTab != null)
            {
                await SwitchTabAsync(nextTab.Id);
            }
        }
        
        QueryStateService.NotifyTabUpdated(tabId);
    }

    private async Task CloseTabAsync(Guid tabId)
    {
        if (QueryStateService.Tabs.Count <= 1) return;
        
        var tabToRemove = QueryStateService.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tabToRemove == null) return;

        string currentContent = tabToRemove.Content;
        if (QueryStateService.ActiveTabId == tabId && _editor != null)
        {
            currentContent = await _editor.GetValue();
            tabToRemove.Content = currentContent;
        }

        if (!string.IsNullOrWhiteSpace(currentContent) && string.IsNullOrEmpty(tabToRemove.FilePath))
        {
            TabIdToClose = tabId;
            ShowCloseTabConfirmation = true;
            return;
        }

        await ConfirmCloseTabAsync(tabId);
    }

    private async Task ConfirmCloseTabAsync(Guid? tabId = null)
    {
        Guid idToClose = tabId ?? TabIdToClose ?? Guid.Empty;
        if (idToClose == Guid.Empty) return;

        var tabToRemove = QueryStateService.Tabs.FirstOrDefault(t => t.Id == idToClose);
        if (tabToRemove != null)
        {
            if (tabToRemove.QueryCts != null && !tabToRemove.QueryCts.IsCancellationRequested)
            {
                try { tabToRemove.QueryCts.Cancel(); } catch { }
            }
            QueryStateService.Tabs.Remove(tabToRemove);

            if (QueryStateService.ActiveTabId == idToClose)
            {
                QueryStateService.ActiveTabId = QueryStateService.Tabs.First().Id;
                var newTab = QueryStateService.Tabs.First();
                if (_editor != null)
                {
                    await _editor.SetValue(newTab.Content);
                }
                
                if (newTab.ConnectionString != ConnectionService.ConnectionString && !string.IsNullOrEmpty(newTab.ConnectionString))
                {
                    ConnectionService.SaveActiveConnection(newTab.ConnectionString);
                }
            }
            await QueryStateService.SaveTabsAsync();
        }

        ShowCloseTabConfirmation = false;
        TabIdToClose = null;
    }

    private bool ShowClearAllTabsConfirmation = false;

    private async Task ClearAllTabsAsync()
    {
        if (_editor != null)
        {
            ActiveTab.Content = await _editor.GetValue();
        }

        bool hasUnsaved = QueryStateService.Tabs.Any(t => !string.IsNullOrWhiteSpace(t.Content) && string.IsNullOrEmpty(t.FilePath));
        if (hasUnsaved)
        {
            ShowClearAllTabsConfirmation = true;
            IsTabDropdownOpen = false;
            return;
        }

        await ConfirmClearAllTabsAsync();
    }

    private async Task ConfirmClearAllTabsAsync()
    {
        foreach (var tab in QueryStateService.Tabs)
        {
            if (tab.QueryCts != null && !tab.QueryCts.IsCancellationRequested)
            {
                try { tab.QueryCts.Cancel(); } catch { }
            }
        }
        
        QueryStateService.Tabs.Clear();
        var newTab = new QueryTab
        {
            Id = Guid.NewGuid(),
            Name = "SQLQuery1.sql",
            ConnectionString = ConnectionService.ConnectionString
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        
        if (_editor != null)
        {
            await _editor.SetValue("");
        }
        
        await QueryStateService.SaveTabsAsync();
        IsTabDropdownOpen = false;
        ShowClearAllTabsConfirmation = false;
    }

    private async Task SaveAndCloseTabAsync()
    {
        if (TabIdToClose != null)
        {
            bool saved = await SaveQueryAsync(TabIdToClose);
            if (saved)
            {
                await ConfirmCloseTabAsync(TabIdToClose);
            }
            else
            {
                ShowCloseTabConfirmation = false;
            }
        }
    }

