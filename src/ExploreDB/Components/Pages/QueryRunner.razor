@using System.IO
@page "/"
@page "/runner"
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@using Microsoft.Data.SqlClient
@using System.Data
@using Microsoft.Extensions.Configuration
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject QueryStateService QueryStateService
@inject QueryExecutionService QueryExecutionService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HistoryService HistoryService
@inject ThemeService ThemeService
@inject SnippetService SnippetService
@inject WindowManagerService WindowManager
@inject UserSettingsService UserSettingsService
@implements IDisposable

<div class="query-runner-container d-flex flex-column h-100 p-0 overflow-hidden" style="min-height: 0;">
    @if (string.IsNullOrEmpty(ConnectionService.ConnectionString))
    {
        <ExploreDB.Components.Shared.NoDatabaseBanner Height="100%" />
    }
    else
    {
    <!-- Fixed Top Action Toolbar -->
    <div class="query-runner-toolbar d-flex align-items-center flex-nowrap flex-shrink-0 gap-2">
        <div class="d-flex gap-2 flex-shrink-0 align-items-center ms-auto">
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Open File (Ctrl+O)" data-bs-placement="bottom" @onclick="OpenFileAsync">
                <i class="bi bi-folder2-open"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Save Query (Ctrl+S)" data-bs-placement="bottom" @onclick="SaveActiveQueryAsync">
                <i class="bi bi-floppy"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Save As... (Ctrl+Shift+S)" data-bs-placement="bottom" @onclick="SaveAsQueryAsync">
                <i class="bi bi-file-earmark-plus"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Clear Editor" data-bs-placement="bottom" @onclick="() => ShowClearConfirmation = true">
                <i class="bi bi-eraser text-warning"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Format SQL" data-bs-placement="bottom" @onclick="FormatSqlAsync">
                <i class="bi bi-magic text-info"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Toggle Comment (Ctrl+/)" data-bs-placement="bottom" @onclick="ToggleCommentAsync">
                <i class="bi bi-chat-left-text text-info"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="View History" data-bs-placement="bottom" @onclick='() => Nav.NavigateTo("/history")'>
                <i class="bi bi-clock-history"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Snippet Manager (Alt+S)" data-bs-placement="bottom" @onclick='() => Nav.NavigateTo("/snippets")'>
                <i class="bi bi-bookmarks text-info"></i>
            </button>
        </div>

        <div class="d-flex align-items-center flex-shrink-0 order-first">
            @if (ActiveTab.IsExecuting)
            {
                @if (ActiveTab.IsCancelling)
                {
                    <button class="btn btn-sm btn-danger shadow-sm d-inline-flex align-items-center opacity-75" style="height: 30px;" disabled>
                        <span class="spinner-border spinner-border-sm me-1" role="status" style="width: 12px; height: 12px;"></span><span>Stopping...</span>
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger shadow-sm d-inline-flex align-items-center" style="height: 30px;" data-bs-tooltip="true" data-bs-title="Stop Execution" data-bs-placement="bottom" @onclick="CancelExecution">
                        <i class="bi bi-stop-fill me-1"></i><span>Stop</span>
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-primary shadow-sm d-inline-flex align-items-center" style="height: 30px;" data-bs-tooltip="true" data-bs-title="Execute Query (F5)" data-bs-placement="bottom" @onclick="ExecuteAsync">
                    <i class="bi bi-play-fill me-1"></i><span>Execute</span>
                </button>
            }
        </div>
    </div>
    
    @if (!string.IsNullOrEmpty(FormatError) && !IsEditorFullScreen)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-2 flex-shrink-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Format Error:</strong> @FormatError
            <button type="button" class="btn-close" @onclick="() => FormatError = null" aria-label="Close"></button>
        </div>
    }

    <!-- Split-Pane Workspace Area -->
    <div class="query-runner-workspace d-flex flex-column flex-grow-1 overflow-hidden" style="min-height: 0;">
        <!-- Execution Harness Area (Editor) -->
        <div class="card shadow-sm @(IsEditorFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-2 m-0 rounded-0" : !ActiveTab.HasExecuted || IsMinimized ? "flex-grow-1" : "flex-shrink-0") d-flex flex-column overflow-hidden" style="@(IsEditorFullScreen ? "background-color: var(--app-bg); z-index: 9999; height: 100vh;" : "background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border); min-height: 120px;")">
            <!-- SSMS-Style Tab Strip -->
            <div class="ssms-tab-strip d-flex align-items-stretch justify-content-between flex-shrink-0">
                <div id="ssms-tab-scroll" class="ssms-tab-scroll d-flex align-items-stretch flex-grow-1">
                        @foreach (var tab in QueryStateService.Tabs.Where(t => !t.IsPoppedOut).OrderByDescending(t => t.IsPinned))
                        {
                            var isCurrent = tab.Id == QueryStateService.ActiveTabId;
                            <div class="ssms-tab @(isCurrent ? "active" : "") @(tab.IsPinned ? "is-pinned" : "") d-flex align-items-center user-select-none" 
                                 @oncontextmenu="(e) => ShowTabContextMenu(e, tab.Id)"
                                 @oncontextmenu:preventDefault="true"
                                 @onclick="() => SwitchTabAsync(tab.Id)"
                                 @onmouseup="(e) => OnTabMouseUpAsync(e, tab.Id)"
                                 data-bs-tooltip="true" 
                                 data-bs-title="@GetTabTooltip(tab)" 
                                 data-bs-html="true" 
                                 data-bs-placement="bottom">
                                <i class="bi bi-file-earmark-code me-1 ssms-tab-icon @(isCurrent ? "text-primary" : "text-muted")"></i>
                                <span class="ssms-tab-name text-truncate">@tab.Name</span>
                                @if (tab.IsPinned)
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-link p-0 ms-2 ssms-tab-pin-btn position-relative d-flex align-items-center justify-content-center" 
                                            @onclick="() => TogglePinTabAsync(tab.Id)" 
                                            @onclick:stopPropagation 
                                            title="@(tab.IsDirty ? "Unsaved changes • Pinned (Click to unpin)" : "Pinned (Click to unpin)")">
                                        <i class="bi bi-pin-angle ssms-tab-pin-icon"></i>
                                        @if (tab.IsDirty)
                                        {
                                            <span class="ssms-tab-pin-dirty-dot"></span>
                                        }
                                    </button>
                                }
                                @if (false)
                                {

                                }
                                @if (true)
                                {
                                    <button type="button" 
                                            class="btn btn-sm btn-link p-0 ms-2 ssms-tab-close-btn @(tab.IsDirty ? "is-dirty" : "") @(tab.IsPinned ? "d-none" : "d-flex") align-items-center justify-content-center" 
                                            @onclick="() => CloseTabAsync(tab.Id)" 
                                            @onclick:stopPropagation 
                                            title="@(tab.IsDirty ? "Unsaved changes (Click to close)" : "Close Tab (Ctrl+W)")">
                                        <span class="ssms-tab-dirty-dot"></span>
                                        <i class="bi bi-x ssms-tab-close-icon"></i>
                                    </button>
                                }
                            </div>
                        }
                        <button type="button" 
                                class="btn btn-sm btn-link ssms-new-tab-btn d-flex align-items-center justify-content-center px-2" 
                                @onclick="NewTabAsync" 
                                data-bs-tooltip="true" 
                                data-bs-title="New Query (Ctrl+N)" 
                                data-bs-placement="bottom">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>

                    <!-- Right Controls: Tab Search Dropdown & Popout -->
                    <div class="d-flex align-items-center flex-shrink-0 px-2 gap-1 border-start" style="border-color: var(--app-border) !important;">
                        @if (IsEditorFullScreen)
                        {
                            <button type="button" 
                                    class="btn btn-sm toolbar-icon-btn border-0 shadow-none d-flex align-items-center justify-content-center" 
                                    style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                    title="Save Query (Ctrl+S)" 
                                    @onclick="SaveActiveQueryAsync">
                                <i class="bi bi-floppy" style="font-size: 0.75rem;"></i>
                            </button>
                            <button type="button" 
                                    class="btn btn-sm toolbar-icon-btn border-0 shadow-none d-flex align-items-center justify-content-center" 
                                    style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                    title="Format SQL" 
                                    @onclick="FormatSqlAsync">
                                <i class="bi bi-magic text-info" style="font-size: 0.75rem;"></i>
                            </button>
                            <button type="button" 
                                    class="btn btn-sm toolbar-icon-btn border-0 shadow-none d-flex align-items-center justify-content-center" 
                                    style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                    title="Toggle Comment (Ctrl+/)" 
                                    @onclick="ToggleCommentAsync">
                                <i class="bi bi-chat-left-text text-info" style="font-size: 0.75rem;"></i>
                            </button>
                            <div class="vr my-1 mx-1" style="height: 14px; opacity: 0.25;"></div>
                        }
                        <div class="position-relative">
                            <button type="button" 
                                    class="btn btn-sm toolbar-icon-btn border-0 shadow-none @(IsTabDropdownOpen ? "active" : "")" 
                                    style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                    @onclick="() => IsTabDropdownOpen = !IsTabDropdownOpen" 
                                    title="All Tabs & Search">
                                <i class="bi bi-chevron-down" style="font-size: 0.8rem;"></i>
                            </button>
                            @if (IsTabDropdownOpen)
                            {
                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsTabDropdownOpen = false"></div>
                                <div class="dropdown-menu show shadow-lg p-1 mt-1" style="position: absolute; top: 100%; right: 0; left: auto; z-index: 1050; min-width: 400px; max-width: 550px; overflow-x: hidden; background-color: var(--app-dropdown-bg); color: var(--app-text); border-color: var(--app-border);">
                                    <div class="p-1 mb-1 d-flex align-items-center">
                                        <input type="text" class="form-control form-control-sm flex-grow-1 @(QueryStateService.Tabs.Count > 1 ? "me-2" : "")" style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" placeholder="Search tabs..." @bind="TabSearchTerm" @bind:event="oninput" @onclick:stopPropagation />
                                        @if (QueryStateService.Tabs.Count > 1)
                                        {
                                            <button class="btn btn-sm btn-outline-danger border-0 d-flex align-items-center justify-content-center flex-shrink-0 rounded-1" style="width: 30px; height: 30px;" @onclick="ClearAllTabsAsync" @onclick:stopPropagation data-bs-tooltip="true" data-bs-title="Clear All Tabs" data-bs-placement="bottom">
                                                <i class="bi bi-trash" style="font-size: 1.1rem;"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="custom-scrollbar-light custom-scrollbar-solid-track" style="max-height: 300px; overflow-y: auto;">
                                        @foreach (var tab in QueryStateService.Tabs.Where(t => !t.IsPoppedOut && (string.IsNullOrEmpty(TabSearchTerm) || t.Name.Contains(TabSearchTerm, StringComparison.OrdinalIgnoreCase))).OrderByDescending(t => t.IsPinned))
                                        {
                                            <div class="dropdown-item d-flex justify-content-between align-items-center @(tab.Id == QueryStateService.ActiveTabId ? "bg-primary bg-opacity-25 rounded-1" : "rounded-1")" style="cursor: pointer; min-width: 0; color: var(--app-text);" data-bs-tooltip="true" data-bs-title="@GetTabTooltip(tab)" data-bs-html="true" data-bs-placement="left" @onclick="async () => { await SwitchTabAsync(tab.Id); IsTabDropdownOpen = false; }">
                                                <div class="d-flex flex-column text-truncate me-3" style="flex: 1; min-width: 0;">
                                                    <div class="d-flex align-items-center text-truncate">
                                                        @if (false)
                                                        {
                                                            <i class="bi bi-pin-angle-fill text-warning me-1" style="font-size: 0.8rem;" title="Pinned"></i>
                                                        }
                                                        <span class="text-truncate">@GetTabDisplayName(tab)</span>
                                                        @if (false)
                                                        {
                                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem; padding: 1px 4px;">Unsaved</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(GetTabConnectionSummary(tab)))
                                                    {
                                                        <span class="text-secondary text-truncate" style="font-size: 0.7rem;">@GetTabConnectionSummary(tab)</span>
                                                    }
                                                </div>
                                        
                                                <div class="d-flex align-items-center flex-shrink-0">
                                                    @if (true)
                                                    {
                                                        <button type="button" class="btn btn-sm p-0 rounded me-1 d-flex align-items-center justify-content-center tab-dropdown-pin-btn @(tab.IsPinned ? "is-pinned" : "")" @onclick="async () => { await TogglePinTabAsync(tab.Id); }" @onclick:stopPropagation title="@(tab.IsPinned ? "Unpin Tab" : "Pin Tab")">
                                                            <i class="bi @(tab.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")" style="font-size: 0.85rem;"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-info border-0 p-0 rounded me-1 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;" @onclick="async () => { await PopoutTabAsync(tab.Id); IsTabDropdownOpen = false; }" @onclick:stopPropagation title="Pop Out">
                                                            <i class="bi bi-box-arrow-up-right" style="font-size: 0.9rem;"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger border-0 p-0 rounded @(tab.IsPinned ? "d-none" : "d-flex") align-items-center justify-content-center" style="width: 26px; height: 26px;" @onclick="async () => { if (!tab.IsPinned) { await CloseTabAsync(tab.Id); IsTabDropdownOpen = false; } }" @onclick:stopPropagation title="Close">
                                                            <i class="bi bi-x" style="font-size: 1.3rem;"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <hr class="dropdown-divider border-secondary my-2">
                                    <button class="dropdown-item text-info text-center py-1 mb-2 mt-1 rounded-2" style="border: 1px dashed var(--bs-info); margin-left: 10px; margin-right: 10px; width: calc(100% - 20px);" @onclick="async () => { await NewTabAsync(); IsTabDropdownOpen = false; }">
                                        <i class="bi bi-plus-lg me-1"></i> New Query
                                    </button>
                                </div>
                            }
                        </div>

                        @if (QueryStateService.Tabs.Count(t => !t.IsPoppedOut) > 1 && !IsEditorFullScreen)
                        {
                            <button type="button" 
                                    class="btn btn-sm toolbar-icon-btn border-0 shadow-none" 
                                    style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                    title="Pop Out Active Tab" 
                                    @onclick="() => PopoutTabAsync(ActiveTab.Id)">
                                <i class="bi bi-box-arrow-up-right text-info" style="font-size: 0.8rem;"></i>
                            </button>
                        }

                        <button type="button" 
                                class="btn btn-sm toolbar-icon-btn border-0 shadow-none d-flex align-items-center justify-content-center" 
                                style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                title="@(IsEditorFullScreen ? "Restore Down (Esc)" : "Expand Editor to Full Screen")" 
                                @onclick="ToggleEditorFullScreen">
                            <i class="bi @(IsEditorFullScreen ? "bi-fullscreen-exit text-warning" : "bi-arrows-fullscreen")" style="font-size: 0.75rem;"></i>
                        </button>
                        @if (false /* skip old popout */ && QueryStateService.Tabs.Count(t => !t.IsPoppedOut) > 1)
                        {
                            <button type="button" 
                                    class="btn btn-sm toolbar-icon-btn border-0 shadow-none" 
                                    style="width: 22px; height: 22px; min-width: 22px; min-height: 22px;"
                                    title="Pop Out Active Tab" 
                                    @onclick="() => PopoutTabAsync(ActiveTab.Id)">
                                <i class="bi bi-box-arrow-up-right text-info" style="font-size: 0.8rem;"></i>
                            </button>
                        }
                    </div>
                </div>

                <div class="card-body p-0 d-flex flex-column flex-grow-1" style="min-height: 0; overflow: hidden;">
                    <div id="query-editor-wrapper" class="@(!ActiveTab.HasExecuted || IsMinimized || IsEditorFullScreen ? "flex-grow-1" : "")" style="@(!ActiveTab.HasExecuted || IsMinimized || IsEditorFullScreen ? "height: 100%;" : (_customEditorHeight.HasValue ? $"height: {_customEditorHeight.Value}px;" : "height: 180px;")) width: 100%; display: block; overflow: hidden; min-height: 120px;">
                        @if (QueryStateService.Initialized && _isMonacoLoaded)
                        {
                            <StandaloneCodeEditor @ref="_editor" Id="query-editor" CssClass="w-100 h-100" ConstructionOptions="EditorConstructionOptions" OnDidInit="EditorOnDidInit" OnDidChangeModelContent="EditorOnDidChangeModelContent" />
                        }
                        else
                        {
                            <div class="d-flex justify-content-center align-items-center h-100" style="min-height: 120px;">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                <span class="text-muted small">Loading editor...</span>
                            </div>
                        }
                    </div>
                </div>
                <!-- Resizer Bar (Drag to Resize Query Editor) -->
                <div id="query-editor-resizer"
                     class="sql-compare-splitter flex-shrink-0"
                     style="@(ActiveTab.HasExecuted && !IsMinimized && !IsFullScreen ? "" : "display: none;")"
                     title="Drag up or down to resize query editor">
                    <div class="sql-compare-splitter-handle"></div>
                </div>
            </div>

    <!-- Results Area --> 
    @if (ActiveTab.HasExecuted)
    {
        <div class="@(IsFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-3" : IsMinimized ? "flex-shrink-0" : "flex-grow-1 d-flex flex-column overflow-hidden")" 
             style="@(IsFullScreen ? "background-color: var(--app-bg); z-index: 9999;" : IsMinimized ? "" : "min-height: 0;")">
            <div class="card shadow-sm d-flex flex-column h-100" style="@(IsFullScreen ? "height: 100%;" : IsMinimized ? "border-bottom-left-radius: 0; border-bottom-right-radius: 0;" : "min-height: 0;") background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border); overflow: hidden;">
                <div class="card-header p-0 d-flex justify-content-between align-items-center flex-shrink-0" style="border-bottom: 1px solid var(--app-border); background-color: var(--app-surface-secondary); height: 26px; min-height: 26px; max-height: 26px;">
                    <div class="d-flex align-items-center flex-grow-1 overflow-hidden">
                        <ul class="nav nav-tabs border-bottom-0 h-100 align-items-center" style="border-color: var(--app-border); margin-bottom: 0;">
                        <li class="nav-item h-100 d-flex align-items-center">
                            <a class="nav-link d-inline-flex align-items-center gap-1 @(ResultTab == "Results" ? "active border-bottom-0 fw-semibold" : "border-transparent")"
                               style="@(ResultTab == "Results" ? "background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border);" : "color: var(--app-text-muted);") font-size: 0.78rem; padding: 2px 10px; height: 24px; cursor: pointer; border-radius: 4px 4px 0 0;"
                               @onclick='() => { ResultTab = "Results"; IsMinimized = false; }'>
                                <i class="bi bi-table" style="font-size: 0.75rem;"></i>
                                <span>Results</span>
                            </a>
                        </li>
                        <li class="nav-item h-100 d-flex align-items-center">
                            <a class="nav-link d-inline-flex align-items-center gap-1 @(ResultTab == "Messages" ? "active border-bottom-0 fw-semibold" : "border-transparent")"
                               style="@(ResultTab == "Messages" ? "background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border);" : "color: var(--app-text-muted);") font-size: 0.78rem; padding: 2px 10px; height: 24px; cursor: pointer; border-radius: 4px 4px 0 0;"
                               @onclick='() => { ResultTab = "Messages"; IsMinimized = false; }'>
                                <i class="bi bi-file-earmark-text" style="font-size: 0.75rem;"></i>
                                <span>Messages</span>
                                @if (ActiveTab.MessageBadgeCount > 0) { <span class="badge @(ActiveTab.HasMessageErrors ? "bg-danger text-white" : "bg-secondary") ms-1" style="font-size: 0.65rem; padding: 1px 5px; border-radius: 8px;">@ActiveTab.MessageBadgeCount</span> }
                            </a>
                        </li>
                        </ul>
                        <div class="d-flex align-items-center ms-3 gap-3">
                            @if (ActiveTab.HasExecuted && ActiveTab.LastExecutionTimeMs >= 0 && !ActiveTab.IsExecuting)
                            {
                                var timingTooltip = ActiveTab.LastConnectionTimeMs > 0 && ActiveTab.LastQueryTimeMs > 0
                                    ? $"Total: {GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)} (Query: {GetFormattedExecutionTimeMs(ActiveTab.LastQueryTimeMs)} | Connection: {GetFormattedExecutionTimeMs(ActiveTab.LastConnectionTimeMs)})"
                                    : $"Total: {GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)}";

                                <span class="text-muted d-inline-flex align-items-center" style="font-size: 0.75rem; white-space: nowrap;" title="@timingTooltip">
                                    <i class="bi bi-stopwatch me-1" style="font-size: 0.75rem;"></i>@GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)
                                </span>
                            }

                            @if (ResultTab == "Results" && ActiveTab.ResultSets.Count > 0)
                            {
                                <QueryRowCountBadge Tab="ActiveTab" />
                            }
    
                            @if (false)
                            {

                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center pe-2 gap-1">
                        @if (ResultTab == "Results" && ActiveTab.ResultSets.Count > 0 && !ActiveTab.IsExecuting)
                        {
                            <button class="btn btn-sm d-flex align-items-center gap-1 me-1 @(_isSearchOpen ? "btn-primary text-white border-0 shadow-sm" : "btn-outline-secondary border-0")" 
                                    style="@(_isSearchOpen ? "" : "color: var(--app-text);") height: 22px; font-size: 0.75rem; padding: 1px 7px;" 
                                    @onclick="ToggleSearch" 
                                    title="Find in results (Ctrl+F)">
                                <i class="bi bi-search" style="font-size: 0.72rem;"></i>
                                <span>Search</span>
                            </button>
                        }
                        @*

                        {

                        }
                        @if (!IsFullScreen)
                        {
                        *@
                        @if (!IsFullScreen)
                        {
                            <button class="btn btn-sm btn-outline-secondary border-0 p-0 d-flex align-items-center justify-content-center me-1" style="width: 22px; height: 22px; color: var(--app-text);" @onclick="ToggleMinimize" title="@(IsMinimized ? "Restore Up (Ctrl+R)" : "Minimize (Ctrl+R)")">
                                <i class="bi @(IsMinimized ? "bi-chevron-up" : "bi-chevron-down")" style="font-size: 0.75rem; line-height: 1;"></i>
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary border-0 p-0 d-flex align-items-center justify-content-center @(!IsFullScreen ? "me-1" : "")" style="width: 22px; height: 22px; color: var(--app-text);" @onclick="ToggleFullScreen" title="@(IsFullScreen ? "Restore Down" : "Expand to Full Screen")">
                            <i class="bi @(IsFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")" style="font-size: 0.75rem; line-height: 1;"></i>
                        </button>
                        
                        @if (!IsFullScreen)
                        {
                            <button class="btn btn-sm btn-outline-secondary border-0 p-0 d-flex align-items-center justify-content-center" style="width: 22px; height: 22px; color: var(--app-text);" @onclick="() => ActiveTab.HasExecuted = false" title="Close Results">
                                <i class="bi bi-x-lg" style="font-size: 0.75rem; line-height: 1;"></i>
                            </button>
                        }
                    </div>
                </div>
                @if (!IsMinimized)
                {
                    <div class="card-body p-0 d-flex flex-column flex-grow-1 position-relative overflow-hidden" style="min-height: 0;">
                            @if (ResultTab == "Results")
                            {
                                if (ActiveTab.IsExecuting && ActiveTab.ResultSets.Count == 0)
                                {
                                    <QueryExecutionTimer Tab="ActiveTab" Mode="QueryExecutionTimer.DisplayMode.ExecutingSpinner" IsDarkTheme="ThemeService.IsDark" />
                                }
                                else if (ActiveTab.ResultSets.Count == 0 && !ActiveTab.HasExecuted)
                                {
                                    <div class="text-muted text-center mt-5">
                                        Enter a custom query and click Execute to see results.
                                    </div>
                                }
                                else if (ActiveTab.ResultSets.Count == 0 && ActiveTab.HasExecuted)
                                {
                                    <div class="text-muted text-center mt-5">Command completed successfully. No data tables returned.</div>
                                }
                                else
                                {
                                    @if (_isSearchOpen)
                                    {
                                        <div class="position-absolute shadow-lg rounded-pill d-flex align-items-center px-2 py-1 gap-2" 
                                             style="top: 10px; right: 20px; z-index: 1050; background: var(--app-surface); border: 1px solid var(--app-border); backdrop-filter: blur(8px); box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
                                            <i class="bi bi-search text-muted small ms-1"></i>
                                            <input type="text" 
                                                   class="form-control form-control-sm border-0 bg-transparent py-0 px-1 shadow-none" 
                                                   placeholder="Find in results (Ctrl+F)..." 
                                                   style="color: var(--app-text); width: 180px; font-size: 0.82rem;"
                                                   @bind="_globalSearchTerm" 
                                                   @bind:event="oninput" 
                                                   @onkeydown='async (e) => { if (e.Key == "Escape") { if (!string.IsNullOrEmpty(_globalSearchTerm)) _globalSearchTerm = string.Empty; else await ToggleSearch(); } }' 
                                                   id="global-results-search-input" />
                                            
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-sm py-0 px-1 @(_searchCaseSensitive ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                        style="font-size: 0.72rem; border-radius: 4px;" 
                                                        @onclick="() => _searchCaseSensitive = !_searchCaseSensitive" 
                                                        title="Match Case">
                                                    Aa
                                                </button>
                                                <button class="btn btn-sm py-0 px-1 ms-1 @(_searchMatchWholeWord ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                        style="font-size: 0.72rem; border-radius: 4px;" 
                                                        @onclick="() => _searchMatchWholeWord = !_searchMatchWholeWord" 
                                                        title="Match Whole Word">
                                                    [ab]
                                                </button>
                                                <button class="btn btn-sm py-0 px-1 ms-1 @(_searchExactMatch ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                        style="font-size: 0.72rem; border-radius: 4px;" 
                                                        @onclick="() => _searchExactMatch = !_searchExactMatch" 
                                                        title="Exact Match">
                                                    ⊚
                                                </button>
                                            </div>

                                            <button class="btn btn-sm btn-link text-muted p-0 border-0 ms-1 me-1" 
                                                    @onclick="HandleSearchCloseClick" 
                                                    title="@(!string.IsNullOrEmpty(_globalSearchTerm) ? "Clear (Esc)" : "Close (Esc)")">
                                                <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
                                            </button>
                                        </div>
                                    }
                                    <div id="results-multi-container" class="w-100 h-100 d-flex flex-column position-relative custom-scrollbar-light" style="overflow-y: auto; overflow-x: hidden; min-height: 0;">
                                        @if (false /* Search moved outside scroll container */ && _isSearchOpen)
                                        {
                                            <div class="position-absolute shadow-lg rounded-pill d-flex align-items-center px-2 py-1 gap-2" 
                                                 style="top: 10px; right: 20px; z-index: 1050; background: var(--app-surface); border: 1px solid var(--app-border); backdrop-filter: blur(8px); box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
                                                <i class="bi bi-search text-muted small ms-1"></i>
                                                <input type="text" 
                                                       class="form-control form-control-sm border-0 bg-transparent py-0 px-1 shadow-none" 
                                                       placeholder="Find in results (Ctrl+F)..." 
                                                       style="color: var(--app-text); width: 180px; font-size: 0.82rem;"
                                                       @bind="_globalSearchTerm" 
                                                       @bind:event="oninput" 
                                                       @onkeydown='async (e) => { if (e.Key == "Escape") { if (!string.IsNullOrEmpty(_globalSearchTerm)) _globalSearchTerm = string.Empty; else await ToggleSearch(); } }' 
                                                       id="global-results-search-input" />
                                                
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-sm py-0 px-1 @(_searchCaseSensitive ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                            style="font-size: 0.72rem; border-radius: 4px;" 
                                                            @onclick="() => _searchCaseSensitive = !_searchCaseSensitive" 
                                                            title="Match Case">
                                                        Aa
                                                    </button>
                                                    <button class="btn btn-sm py-0 px-1 ms-1 @(_searchMatchWholeWord ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                            style="font-size: 0.72rem; border-radius: 4px;" 
                                                            @onclick="() => _searchMatchWholeWord = !_searchMatchWholeWord" 
                                                            title="Match Whole Word">
                                                        [ab]
                                                    </button>
                                                    <button class="btn btn-sm py-0 px-1 ms-1 @(_searchExactMatch ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                            style="font-size: 0.72rem; border-radius: 4px;" 
                                                            @onclick="() => _searchExactMatch = !_searchExactMatch" 
                                                            title="Exact Match">
                                                        ⊚
                                                    </button>
                                                </div>

                                                @if (false /* Removed duplicate clear button in search box */)
                                                {
                                                    <button class="btn btn-sm btn-link text-muted p-0 border-0 ms-1" 
                                                            @onclick="() => _globalSearchTerm = string.Empty" 
                                                            title="Clear search">
                                                        <i class="bi bi-x-circle-fill" style="font-size: 0.8rem;"></i>
                                                    </button>
                                                }

                                                <button class="btn btn-sm btn-link text-muted p-0 border-0 ms-1 me-1" 
                                                        @onclick="HandleSearchCloseClick" 
                                                        title="@(!string.IsNullOrEmpty(_globalSearchTerm) ? "Clear (Esc)" : "Close (Esc)")">
                                                    <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
                                                </button>
                                            </div>
                                        }

                                        @for (int i = 0; i < ActiveTab.ResultSets.Count; i++)
                                        {
                                            var rsItem = ActiveTab.ResultSets[i];
                                            var capturedIndex = i + 1;
                                            var totalCount = ActiveTab.ResultSets.Count;

                                            <div @key="rsItem" id="@($"rs-pane-{capturedIndex}")" 
                                                 class="d-flex flex-column overflow-hidden" 
                                                 style="@QueryExecutionService.GetResultSetPaneStyle(rsItem, totalCount)">
                                                <ResultSetGrid Data="rsItem" 
                                                               ResultSetIndex="capturedIndex" 
                                                               TotalResultSets="totalCount" 
                                                               SearchTerm="@_globalSearchTerm" 
                                                               SearchCaseSensitive="@_searchCaseSensitive" 
                                                               SearchMatchWholeWord="@_searchMatchWholeWord" 
                                                               SearchExactMatch="@_searchExactMatch" 
                                                               OnToggleSearch="ToggleSearch" 
                                                               OnExportStateChanged="HandleExportStateChanged" 
                                                               OnOpenCodeInNewTab="HandleOpenCodeInNewTab" />
                                            </div>

                                            @if (ActiveTab.ResultSets.Count > 1)
                                            {
                                                <div class="sql-compare-splitter" title="Drag to resize result set">
                                                    <div class="sql-compare-splitter-handle"></div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    if (false) {
                                    int rsIndex = 1;
                                    foreach (var rs in ActiveTab.ResultSets)
                                    {
                                        var capturedIndex = rsIndex;
                                        @if (ActiveTab.ResultSets.Count > 1) 
                                        { 
                                            var isCollapsed = ActiveTab.CollapsedResultSets.Contains(capturedIndex);
                                            <div class="d-flex align-items-center mb-2 mt-4" style="cursor:pointer;" @onclick="() => ActiveTab.ToggleResultSet(capturedIndex)">
                                                <hr class="flex-grow-1 m-0" style="border-color: var(--app-border); opacity: 0.5;">
                                                <span class="px-3 fw-bold d-flex align-items-center gap-2" style="color: var(--app-table-header-text); letter-spacing: 1px; font-size: 0.95rem; white-space:nowrap;">
                                                    Result Set @capturedIndex
                                                    <i class="bi @(isCollapsed ? "bi-chevron-down" : "bi-chevron-up")" style="font-size:0.75rem;"></i>
                                                </span>
                                                <hr class="flex-grow-1 m-0" style="border-color: var(--app-border); opacity: 0.5;">
                                            </div>
                                            @if (!isCollapsed)
                                            {
                                                <ResultSetGrid Data="rs" OnExportStateChanged="HandleExportStateChanged" OnOpenCodeInNewTab="HandleOpenCodeInNewTab" />
                                            }
                                        }
                                        else
                                        {
                                            <ResultSetGrid Data="rs" OnExportStateChanged="HandleExportStateChanged" OnOpenCodeInNewTab="HandleOpenCodeInNewTab" />
                                        }
                                        rsIndex++;
                                    }
                                    }
                                    if (false) {
                                    }
                                }
                            }
                            else if (ResultTab == "Messages")
                            {
                                <div class="p-3 overflow-auto flex-grow-1 custom-scrollbar-light" style="min-height: 0;">
                                <pre class="m-0" style="color: var(--app-text); font-size: 0.85em; white-space: pre-wrap; font-family: Consolas, 'Courier New', monospace;">
@{ var messagesSnapshot = ActiveTab.GetMessagesSnapshot(); }
@if (messagesSnapshot.Count == 0) { <span class="text-muted fst-italic">No Messages.</span> }
@foreach (var msg in messagesSnapshot)
{
    @if (msg.IsError || msg.Text.StartsWith("Error:", StringComparison.OrdinalIgnoreCase) || msg.Text.StartsWith("ERROR:", StringComparison.OrdinalIgnoreCase))
    {
        var navLine = msg.LineNumber;
        if (!navLine.HasValue && msg.IsError)
        {
            navLine = QueryExecutionService.ParseLineNumberFromErrorText(msg.Text);
        }

        if (navLine.HasValue && navLine.Value > 0)
        {
            <span class="text-danger fw-semibold" style="cursor: pointer; user-select: text;" title="Double-click to navigate to line @(navLine.Value) in editor" @ondblclick="() => JumpToEditorLineAsync(navLine.Value)">@msg.Text</span><br/>
        }
        else
        {
            <span class="text-danger fw-semibold">@msg.Text</span><br/>
        }
    }
    else
    {
        <span>@msg.Text</span><br/>
    }
}
                                </pre>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div> <!-- /query-runner-workspace -->
    }
</div>

<QueryExecutionTimer Tab="ActiveTab" Mode="QueryExecutionTimer.DisplayMode.LongExecutionToast" IsDarkTheme="ThemeService.IsDark" />

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="background: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-header" style="border-bottom: 1px solid var(--app-border);">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "")" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--app-border);">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowPopoutLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="background: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-header" style="border-bottom: 1px solid var(--app-border);">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Popout Limit Reached</h5>
                    <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "")" @onclick="() => ShowPopoutLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxPopoutTabs", 5))</strong> popped out tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing popout windows before opening new ones.</p>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--app-border);">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowPopoutLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
