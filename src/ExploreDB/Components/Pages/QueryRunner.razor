        string tooltip = $"<strong>Name:</strong> {tab.Name}<br/><strong>File Path:</strong> {pathInfo}";

        if (string.IsNullOrEmpty(tab.ConnectionString)) return tooltip;
        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(tab.ConnectionString);
            string server = builder.DataSource;
            string db = builder.InitialCatalog;
            
            if (string.IsNullOrEmpty(db))
            {
                return $"{tooltip}<br/><strong>Server:</strong> {server}<br/><strong>DB:</strong> Not Selected";
            }
            
            return $"{tooltip}<br/><strong>Server:</strong> {server}<br/><strong>DB:</strong> {db}";
        }
        catch
        {
            return tooltip;
        }
    }



