    private async Task CloseOtherTabsAsync(Guid keepTabId)
    {
        if (_editor != null)
        {
            ActiveTab.Content = await _editor.GetValue();
        }

        var tabsToClose = QueryStateService.Tabs
            .Where(t => t.Id != keepTabId && !t.IsPinned)
            .ToList();

        foreach (var tab in tabsToClose)
        {
            if (tab.QueryCts != null && !tab.QueryCts.IsCancellationRequested)
            {
                try { tab.CancelAction?.Invoke(); } catch { }
                try { tab.QueryCts.Cancel(); } catch { }
            }
            QueryStateService.Tabs.Remove(tab);
        }

        QueryStateService.ActiveTabId = keepTabId;
        var activeTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == keepTabId);
        if (activeTab != null && _editor != null)
        {
            await _editor.SetValue(activeTab.Content);
        }

        await QueryStateService.SaveTabsAsync();
        await ScrollActiveTabIntoViewAsync();
    }

    private async Task CloseTabsToTheRightAsync(Guid currentTabId)
    {
        if (_editor != null)
        {
            ActiveTab.Content = await _editor.GetValue();
        }

        var orderedTabs = QueryStateService.Tabs.Where(t => !t.IsPoppedOut).OrderByDescending(t => t.IsPinned).ToList();
        int currentIndex = orderedTabs.FindIndex(t => t.Id == currentTabId);
        if (currentIndex < 0 || currentIndex >= orderedTabs.Count - 1) return;

        var tabsToClose = orderedTabs.Skip(currentIndex + 1).Where(t => !t.IsPinned).ToList();

        foreach (var tab in tabsToClose)
        {
            if (tab.QueryCts != null && !tab.QueryCts.IsCancellationRequested)
            {
                try { tab.CancelAction?.Invoke(); } catch { }
                try { tab.QueryCts.Cancel(); } catch { }
            }
            QueryStateService.Tabs.Remove(tab);
        }

        if (!QueryStateService.Tabs.Any(t => t.Id == QueryStateService.ActiveTabId))
        {
            QueryStateService.ActiveTabId = currentTabId;
            var activeTab = QueryStateService.Tabs.FirstOrDefault(t => t.Id == currentTabId);
            if (activeTab != null && _editor != null)
            {
                await _editor.SetValue(activeTab.Content);
            }
        }

        await QueryStateService.SaveTabsAsync();
        await ScrollActiveTabIntoViewAsync();
    }

    private async Task<bool> HandleClearAllTabsWithPinsAsync()
    {
        var unpinnedTabs = QueryStateService.Tabs.Where(t => !t.IsPinned).ToList();
        foreach (var tab in unpinnedTabs)
        {
            if (tab.QueryCts != null && !tab.QueryCts.IsCancellationRequested)
            {
                try { tab.CancelAction?.Invoke(); } catch { }
                try { tab.QueryCts.Cancel(); } catch { }
            }
            QueryStateService.Tabs.Remove(tab);
        }

        if (QueryStateService.Tabs.Count == 0)
        {
            var newTab = new QueryTab
            {
                Id = Guid.NewGuid(),
                Name = "SQLQuery1.sql",
                ConnectionString = ConnectionService.ConnectionString
            };
            QueryStateService.Tabs.Add(newTab);
            QueryStateService.ActiveTabId = newTab.Id;
            if (_editor != null)
            {
                await _editor.SetValue("");
            }
        }
        else
        {
            var active = QueryStateService.Tabs.FirstOrDefault(t => t.Id == QueryStateService.ActiveTabId) ?? QueryStateService.Tabs.First();
            QueryStateService.ActiveTabId = active.Id;
            if (_editor != null)
            {
                await _editor.SetValue(active.Content);
            }
        }

        await QueryStateService.SaveTabsAsync();
        IsTabDropdownOpen = false;
        ShowClearAllTabsConfirmation = false;
        return true;
    }

    private async Task ConfirmClearAllTabsAsync()
    {
        if (QueryStateService.Tabs.Count > 0)
        {
            await HandleClearAllTabsWithPinsAsync();
            return;
        }
    {
        foreach (var tab in QueryStateService.Tabs)
        {
            if (tab.QueryCts != null && !tab.QueryCts.IsCancellationRequested)
            {
                try { tab.CancelAction?.Invoke(); } catch { }
                try { tab.QueryCts.Cancel(); } catch { }
            }
        }
        
        QueryStateService.Tabs.Clear();
        var newTab = new QueryTab
        {
            Id = Guid.NewGuid(),
            Name = "SQLQuery1.sql",
            ConnectionString = ConnectionService.ConnectionString
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        
        if (_editor != null)
        {
            await _editor.SetValue("");
        }
        
        await QueryStateService.SaveTabsAsync();
        IsTabDropdownOpen = false;
        ShowClearAllTabsConfirmation = false;
    }

    }

