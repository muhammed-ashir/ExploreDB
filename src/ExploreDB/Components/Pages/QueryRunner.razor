    {
        if (ActiveTab != _fallbackTab && ActiveTab.ConnectionString != ConnectionService.ConnectionString)
        {
            ActiveTab.ConnectionString = ConnectionService.ConnectionString;
            await QueryStateService.SaveTabsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

