@page "/table/{FullName}"
@using ExploreDB.Services
@inject SchemaService SchemaService
@inject PathfinderService PathfinderService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="container-fluid">
    @if (IsLoading)
    {
        <LoadingSpinner />
    }
    else if (Table == null)
    {
        <div class="alert alert-warning">Table not found: @FullName</div>
    }
    else
    {
        <div class="row mb-4 align-items-center">
            <div class="col">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex flex-column overflow-hidden justify-content-center" style="min-width: 0;">
                        <h5 class="text-white mb-0 fw-bold text-wrap d-flex align-items-center gap-2" style="letter-spacing: 0.5px; word-break: break-word;">
                            @Table.Name
                            <span class="badge fw-normal align-middle" style="background-color: rgba(13, 110, 253, 0.15); color: #8bb9fe; border: 1px solid rgba(13, 110, 253, 0.4); font-size: 0.45em; padding: 0.35em 0.6em;">TABLE</span>
                        </h5>
                        <small class="text-muted fw-bold" style="font-size: 0.7em; letter-spacing: 1px; margin-top: 2px;">SCHEMA: <span class="text-lowercase">@Table.Schema</span></small>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <a href="javascript:void(0)" @onclick="NavigateBack" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 hover-scale transition-transform fw-medium rounded-pill px-3 py-1 shadow-sm border-secondary text-light">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div> 
        </div>

        <style>
            .schema-accordion .accordion-item {
                border-radius: 0.375rem !important;
                overflow: hidden;
                border-top: 1px solid #495057 !important;
            }
            .schema-accordion .accordion-button {
                background-color: transparent !important;
                color: #adb5bd !important;
                border: none !important;
                box-shadow: none !important;
            }
            .schema-accordion .accordion-button:not(.collapsed) {
                background-color: rgba(255,255,255,0.05) !important;
                color: #fff !important;
                border-bottom: 1px solid #495057 !important;
            }
            .schema-accordion .accordion-button::after {
                filter: invert(1) grayscale(100%) brightness(200%);
            }
            .schema-accordion .accordion-button:not(.collapsed) + .query-actions {
                display: flex !important;
            }
            .schema-accordion .query-actions {
                display: none !important;
            }
        </style>
        
        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs border-secondary mb-4">
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Columns" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Columns")' style="cursor:pointer">
                    Columns
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Relationships" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Relationships")' style="cursor:pointer">
                    Relationships
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-inline-flex align-items-baseline gap-2 @(ActiveTab == "UsedBy" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("UsedBy")' style="cursor:pointer">
                    <span>Used By</span>
                    <i class="bi bi-info-circle text-muted" data-bs-tooltip="true" data-bs-title="views, procedures, and functions that query this table" data-bs-placement="top" style="font-size: 0.85em; opacity: 0.8;"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Queries" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Queries")' style="cursor:pointer">
                    Query
                </a>
            </li>
        </ul>

        <div class="tab-content pb-5">
            @if (ActiveTab == "Columns")
            {
                <!-- Columns Tab -->
                <div class="card glass-card text-white">
                    <div class="card-body">
                        <div class="mb-4">
                            <div class="input-group shadow-sm w-100 flex-nowrap">
                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary shadow-none" style="min-width: 200px;"
                                       placeholder="Search columns..."
                                       @bind="TableColumnSearchTerm"
                                       @bind:event="oninput" />
                                <button class="btn @(ColumnSearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => ColumnSearchCaseSensitive = !ColumnSearchCaseSensitive">
                                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                </button>
                                <button class="btn @(ColumnSearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { ColumnSearchMatchWholeWord = !ColumnSearchMatchWholeWord; if (ColumnSearchMatchWholeWord) ColumnSearchExactMatch = false; }">
                                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                </button>
                                <button class="btn @(ColumnSearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { ColumnSearchExactMatch = !ColumnSearchExactMatch; if (ColumnSearchExactMatch) ColumnSearchMatchWholeWord = false; }">
                                    <i class="bi bi-bullseye fs-6"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="table-responsive custom-scrollbar-light">
                            <table class="table table-dark table-hover align-middle border-secondary mb-0">
                                <thead>
                                    <tr>
                                        <th class="border-secondary text-muted fw-normal">Column Name</th>
                                        <th class="border-secondary text-muted fw-normal text-end">Data Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (VisibleTableColumns.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="2" class="text-center py-4 text-muted">No matching columns found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var col in VisibleTableColumns)
                                        {
                                            <tr>
                                                <td class="border-secondary fw-medium">
                                                    @{
                                                        var fkTable = GetForeignKeyTable(col.Name);
                                                    }
                                                    @if (fkTable != null)
                                                    {
                                                        <a href="@BuildTableLink(fkTable)" class="text-white text-decoration-none d-inline-flex align-items-center hover-scale transition-transform" title="Navigate to @GetShortName(fkTable)">
                                                            @col.Name
                                                            @{
                                                                var shortName = GetShortName(fkTable);
                                                                var displayName = shortName.Length > 30 ? shortName.Substring(0, 30) + "..." : shortName;
                                                            }
                                                            <span class="badge bg-dark text-muted border border-secondary ms-2 align-middle d-inline-flex align-items-center gap-1" title="@shortName">
                                                                <i class="bi bi-link-45deg" title="Foreign Key"></i>@displayName
                                                            </span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        @col.Name
                                                        @if (IsPrimaryKey(col.Name)) {
                                                            <i class="bi bi-key-fill text-muted ms-2" title="Primary Key"></i>
                                                        }
                                                    }
                                                </td>
                                                <td class="border-secondary text-end"><span class="badge bg-dark text-muted border border-secondary font-monospace">@col.DataType</span></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "Relationships")
            {
                <!-- Relationships Tab -->
                @if (Table.OutgoingKeys.Count == 0 && Table.IncomingKeys.Count == 0)
                {
                    <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                        <div class="text-muted">No foreign key relationships to display.</div>
                    </div>
                }
                else
                {
                    <div class="mb-4 d-flex justify-content-start">
                    <div class="input-group shadow-sm w-50 flex-nowrap">
                        <input type="text"
                               class="form-control bg-dark text-white border-secondary shadow-none" style="min-width: 200px;"
                               placeholder="Search relationships..."
                               @bind="RelationshipSearchTerm"
                               @bind:event="oninput" />
                        <button class="btn @(RelationshipSearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => RelationshipSearchCaseSensitive = !RelationshipSearchCaseSensitive">
                            <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                        </button>
                        <button class="btn @(RelationshipSearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { RelationshipSearchMatchWholeWord = !RelationshipSearchMatchWholeWord; if (RelationshipSearchMatchWholeWord) RelationshipSearchExactMatch = false; }">
                            <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                        </button>
                        <button class="btn @(RelationshipSearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { RelationshipSearchExactMatch = !RelationshipSearchExactMatch; if (RelationshipSearchExactMatch) RelationshipSearchMatchWholeWord = false; }">
                            <i class="bi bi-bullseye fs-6"></i>
                        </button>
                    </div>
                </div>
                <div class="accordion schema-accordion" id="relationshipsAccordion">
                    <div class="accordion-item glass-card mb-3 border-secondary">
                        <h2 class="accordion-header" id="headingParents">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseParents" aria-expanded="true" aria-controls="collapseParents">
                                <div class="d-flex align-items-baseline gap-2">
                                    <span>Parents</span>
                                    <i class="bi bi-info-circle text-muted" data-bs-tooltip="true" data-bs-title="tables that this table references" data-bs-placement="top" style="font-size: 0.85em;"></i>
                                </div>
                            </button>
                        </h2>
                        <div id="collapseParents" class="accordion-collapse collapse show" aria-labelledby="headingParents" data-bs-parent="#relationshipsAccordion">
                            <div class="accordion-body text-white">
                                @if (Table.OutgoingKeys.Count == 0)
                                {
                                    <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                        <div class="text-muted">No parent tables.</div>
                                    </div>
                                }
                                else if (!FilteredOutgoingKeys.Any())
                                {
                                    <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                        <div class="text-muted">No matching parent tables found.</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        @foreach (var rel in FilteredOutgoingKeys)
                                        {
                                            <div class="col-12 col-md-6">
                                                <a href="@BuildTableLink(rel.ToTable)" class="card text-decoration-none h-100 hover-scale transition-transform" style="background-color: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1);"
                                                   data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @(rel.ToTable.Replace("[", "").Replace("]", "").Split('.').LastOrDefault())<br/><b>Schema:</b> @(rel.ToTable.Replace("[", "").Replace("]", "").Split('.').FirstOrDefault()?.ToLower())" data-bs-placement="bottom">
                                                    <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                                                        <div class="text-primary fw-bold fs-4 flex-shrink-0">
                                                            <i class="bi bi-table"></i>
                                                        </div>
                                                        <div class="overflow-hidden" style="min-width: 0;">
                                                            <div class="text-white fw-bold text-truncate" style="font-size: 0.95em;">@(rel.ToTable.Replace("[", "").Replace("]", "").Split('.').LastOrDefault())</div>
                                                            <div class="text-muted mt-1 text-truncate" style="font-size: 0.7em; letter-spacing: 0.5px;">SCHEMA: <span class="text-lowercase">@(rel.ToTable.Replace("[", "").Replace("]", "").Split('.').FirstOrDefault())</span></div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item glass-card mb-3 border-secondary">
                        <h2 class="accordion-header" id="headingChildren">
                            <button class="accordion-button fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseChildren" aria-expanded="false" aria-controls="collapseChildren">
                                <div class="d-flex align-items-baseline gap-2">
                                    <span>Children</span>
                                    <i class="bi bi-info-circle text-muted" data-bs-tooltip="true" data-bs-title="tables that reference this table" data-bs-placement="top" style="font-size: 0.85em;"></i>
                                </div>
                            </button>
                        </h2>
                        <div id="collapseChildren" class="accordion-collapse collapse" aria-labelledby="headingChildren" data-bs-parent="#relationshipsAccordion">
                            <div class="accordion-body text-white">
                                @if (Table.IncomingKeys.Count == 0)
                                {
                                    <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                        <div class="text-muted">No child tables.</div>
                                    </div>
                                }
                                else if (!FilteredIncomingKeys.Any())
                                {
                                    <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                        <div class="text-muted">No matching child tables found.</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        @foreach (var rel in FilteredIncomingKeys)
                                        {
                                            <div class="col-12 col-md-6">
                                                <a href="@BuildTableLink(rel.FromTable)" class="card text-decoration-none h-100 hover-scale transition-transform" style="background-color: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1);"
                                                   data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @(rel.FromTable.Replace("[", "").Replace("]", "").Split('.').LastOrDefault())<br/><b>Schema:</b> @(rel.FromTable.Replace("[", "").Replace("]", "").Split('.').FirstOrDefault()?.ToLower())" data-bs-placement="bottom">
                                                    <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                                                        <div class="text-primary fw-bold fs-4 flex-shrink-0">
                                                            <i class="bi bi-table"></i>
                                                        </div>
                                                        <div class="overflow-hidden" style="min-width: 0;">
                                                            <div class="text-white fw-bold text-truncate" style="font-size: 0.95em;">@(rel.FromTable.Replace("[", "").Replace("]", "").Split('.').LastOrDefault())</div>
                                                            <div class="text-muted mt-1 text-truncate" style="font-size: 0.7em; letter-spacing: 0.5px;">SCHEMA: <span class="text-lowercase">@(rel.FromTable.Replace("[", "").Replace("]", "").Split('.').FirstOrDefault())</span></div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="accordion-item glass-card mb-3 border-secondary">
                        <h2 class="accordion-header" id="headingTree">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTree" aria-expanded="false" aria-controls="collapseTree">
                                <div class="d-flex align-items-baseline gap-2">
                                    <span>Dependency Tree</span>
                                    <i class="bi bi-info-circle text-muted" data-bs-tooltip="true" data-bs-title="recursive dependency text tree" data-bs-placement="top" style="font-size: 0.85em;"></i>
                                </div>
                            </button>
                        </h2>
                        <div id="collapseTree" class="accordion-collapse collapse" aria-labelledby="headingTree" data-bs-parent="#relationshipsAccordion">
                            <div class="accordion-body text-white">
                                        <style>
                                            ul.sql-tree {
                                                padding-left: 20px;
                                                list-style: none;
                                                margin-bottom: 0;
                                            }

                                            ul.sql-tree li {
                                                position: relative;
                                                padding-top: 6px;
                                                padding-bottom: 6px;
                                                padding-left: 20px;
                                            }

                                            ul.sql-tree li::before {
                                                content: "";
                                                position: absolute;
                                                top: 0;
                                                left: 0;
                                                border-left: 1px dashed #6c757d;
                                                height: 100%;
                                            }

                                            ul.sql-tree li::after {
                                                content: "";
                                                position: absolute;
                                                top: 18px;
                                                left: 0;
                                                border-top: 1px dashed #6c757d;
                                                width: 15px;
                                            }

                                            ul.sql-tree li:last-child::before {
                                                height: 19px;
                                            }

                                            .tree-conn {
                                                color: #adb5bd;
                                                font-size: 0.85em;
                                            }
                                        </style>

                                        @if (!Table.OutgoingKeys.Any() && !Table.IncomingKeys.Any())
                                        {
                                            <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                                <div class="text-muted">No foreign key relationships to display.</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="tree-root ms-2">
                                                @if (Table.OutgoingKeys.Any())
                                                {
                                                    <div class="fw-bold ms-2 mb-1 text-muted">Parents <i class="bi bi-info-circle ms-1" data-bs-tooltip="true" data-bs-title="tables that this table references" data-bs-placement="top" style="font-size: 0.85em;"></i></div>
                                                    <div class="ms-2 mb-3">
                                                        @RenderUpstream(Table, new HashSet<string>())
                                                    </div>
                                                }

                                                @if (Table.IncomingKeys.Any())
                                                {
                                                    <div class="fw-bold ms-2 mb-1 text-muted">Children <i class="bi bi-info-circle ms-1" data-bs-tooltip="true" data-bs-title="tables that reference this table" data-bs-placement="top" style="font-size: 0.85em;"></i></div>
                                                    <div class="ms-2">
                                                        @RenderDownstream(Table, new HashSet<string>())
                                                    </div>
                                                }
                                            </div>
                                        }
                            </div>
                        </div>
                    </div>
                </div>
                }
            }
            else if (ActiveTab == "UsedBy")
            {
                <!-- Used By Tab -->
                <div class="text-white mt-1">
                    @if ((Table.ReferencedByViews.Count + Table.ReferencedBySPs.Count) == 0)
                    {
                        <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                            <div class="text-muted">No views or procedures reference this table.</div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4 d-flex flex-wrap align-items-center gap-3">
                            <div class="flex-grow-1" style="min-width: 300px; max-width: 500px;">
                                <div class="input-group shadow-sm flex-nowrap">
                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary shadow-none" style="min-width: 200px;"
                                       placeholder="Search dependent views, procedures, & functions..."
                                       @bind="UsedBySearchTerm"
                                       @bind:event="oninput" />
                                <button class="btn @(UsedBySearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => UsedBySearchCaseSensitive = !UsedBySearchCaseSensitive">
                                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                </button>
                                <button class="btn @(UsedBySearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { UsedBySearchMatchWholeWord = !UsedBySearchMatchWholeWord; if (UsedBySearchMatchWholeWord) UsedBySearchExactMatch = false; }">
                                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                </button>
                                <button class="btn @(UsedBySearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { UsedBySearchExactMatch = !UsedBySearchExactMatch; if (UsedBySearchExactMatch) UsedBySearchMatchWholeWord = false; }">
                                    <i class="bi bi-bullseye fs-6"></i>
                                </button>
                            </div>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-4 text-light ms-auto mt-2 mt-md-0">
                                <div class="form-check m-0">
                                    <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowSPs" @bind="UsedByShowSPs">
                                    <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowSPs">
                                        SP
                                    </label>
                                </div>
                                <div class="form-check m-0">
                                    <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowViews" @bind="UsedByShowViews">
                                    <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowViews">
                                        View
                                    </label>
                                </div>
                                <div class="form-check m-0">
                                    <input class="form-check-input bg-dark border-secondary cursor-pointer" type="checkbox" id="checkShowFunctions" @bind="UsedByShowFunctions">
                                    <label class="form-check-label text-light small cursor-pointer user-select-none" for="checkShowFunctions">
                                        Function
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div>
                            @if (!FilteredUsedBy.Any())
                            {
                                <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                                    <div class="text-muted">No matching dependent objects found.</div>
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (var dep in FilteredUsedBy)
                                    {
                                        var isProc = dep.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase) || dep.Type == "SP";
                                        var isFunc = dep.Type.Contains("Function", StringComparison.OrdinalIgnoreCase);
                                        var link = isProc ? BuildProcLink(dep.FullName) : isFunc ? BuildFuncLink(dep.FullName) : BuildObjectLink(dep.FullName);
                                        var iconClass = isProc ? "text-warning font-monospace" : isFunc ? "text-info font-monospace" : "text-success";
                                        <div class="col-md-6 col-12">
                                            <a href="@link" class="card text-decoration-none h-100 hover-scale transition-transform" style="background-color: rgba(0, 0, 0, 0.2); border: 1px solid rgba(255, 255, 255, 0.1);"
                                               data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> @(dep.Type)<br/><b>Name:</b> @dep.Name<br/><b>Schema:</b> @dep.Schema.ToLower()" data-bs-placement="bottom">
                                                <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                                                    <div class="@iconClass fw-bold fs-4 flex-shrink-0">
                                                        @if (isProc || isFunc)
                                                        {
                                                            @("{}")
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-layout-text-window"></i>
                                                        }
                                                    </div>
                                                    <div class="overflow-hidden" style="min-width: 0;">
                                                        <div class="fw-bold text-light mb-1 text-truncate" style="font-size: 1.1rem;">@dep.Name</div>
                                                        <div class="text-muted fw-bold text-truncate" style="font-size: 0.7rem; letter-spacing: 0.5px;">SCHEMA: <span class="text-lowercase">@dep.Schema</span></div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (ActiveTab == "Queries")
            {
                <div class="accordion schema-accordion" id="queryAccordion">
                    <div class="accordion-item glass-card mb-4">
                        <h2 class="accordion-header position-relative" id="headingSelectQuery">
                            <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSelectQuery" aria-expanded="true" aria-controls="collapseSelectQuery">
                                SELECT Query
                            </button>
                            <span class="query-actions position-absolute top-50 translate-middle-y gap-2" style="right: 55px; z-index: 10;">
                                <button type="button"
                                        class="btn btn-sm d-flex align-items-center gap-2 @(SelectCopied ? "btn-success" : "btn-outline-light")"
                                        @onclick="CopySelectQuery"
                                        @onclick:stopPropagation="true">
                                    <i class="bi @(SelectCopied ? "bi-check2" : "bi-clipboard")"></i> @(SelectCopied ? "Copied!" : "Copy")
                                </button>
                                <button type="button" class="btn btn-primary btn-sm fw-bold shadow d-flex align-items-center gap-2" @onclick="@(() => LoadAndRunQuery(SelectQuery, $"Select_{Table.Name}.sql"))" @onclick:stopPropagation="true">
                                    <i class="bi bi-play-fill"></i> Run
                                </button>
                            </span>
                        </h2>
                        <div id="collapseSelectQuery" class="accordion-collapse collapse show" aria-labelledby="headingSelectQuery" data-bs-parent="#queryAccordion">
                            <div class="accordion-body text-white pt-3">
                                <pre class="query-preview mb-0">@SelectQuery</pre>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item glass-card mb-4">
                        <h2 class="accordion-header position-relative" id="headingInsertQuery">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInsertQuery" aria-expanded="false" aria-controls="collapseInsertQuery">
                                INSERT Query
                            </button>
                            <span class="query-actions position-absolute top-50 translate-middle-y gap-2" style="right: 55px; z-index: 10;">
                                <button type="button"
                                        class="btn btn-sm d-flex align-items-center gap-2 @(InsertCopied ? "btn-success" : "btn-outline-light")"
                                        @onclick="CopyInsertQuery"
                                        @onclick:stopPropagation="true">
                                    <i class="bi @(InsertCopied ? "bi-check2" : "bi-clipboard")"></i> @(InsertCopied ? "Copied!" : "Copy")
                                </button>
                                <button type="button" class="btn btn-primary btn-sm fw-bold shadow d-flex align-items-center gap-2" @onclick="@(() => LoadAndRunQuery(InsertQuery, $"Insert_{Table.Name}.sql"))" @onclick:stopPropagation="true">
                                    <i class="bi bi-play-fill"></i> Run
                                </button>
                            </span>
                        </h2>
                        <div id="collapseInsertQuery" class="accordion-collapse collapse" aria-labelledby="headingInsertQuery" data-bs-parent="#queryAccordion">
                            <div class="accordion-body text-white pt-3">
                                <pre class="query-preview mb-0">@InsertQuery</pre>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item glass-card mb-4">
                        <h2 class="accordion-header position-relative" id="headingUpdateQuery">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUpdateQuery" aria-expanded="false" aria-controls="collapseUpdateQuery">
                                UPDATE Query
                            </button>
                            <span class="query-actions position-absolute top-50 translate-middle-y gap-2" style="right: 55px; z-index: 10;">
                                <button type="button"
                                        class="btn btn-sm d-flex align-items-center gap-2 @(UpdateCopied ? "btn-success" : "btn-outline-light")"
                                        @onclick="CopyUpdateQuery"
                                        @onclick:stopPropagation="true">
                                    <i class="bi @(UpdateCopied ? "bi-check2" : "bi-clipboard")"></i> @(UpdateCopied ? "Copied!" : "Copy")
                                </button>
                                <button type="button" class="btn btn-primary btn-sm fw-bold shadow d-flex align-items-center gap-2" @onclick="@(() => LoadAndRunQuery(UpdateQuery, $"Update_{Table.Name}.sql"))" @onclick:stopPropagation="true">
                                    <i class="bi bi-play-fill"></i> Run
                                </button>
                            </span>
                        </h2>
                        <div id="collapseUpdateQuery" class="accordion-collapse collapse" aria-labelledby="headingUpdateQuery" data-bs-parent="#queryAccordion">
                            <div class="accordion-body text-white pt-3">
                                
                                @if (Table.Columns.Count == 0)
                                {
                                    <span class="text-muted">No columns available for query generation.</span>
                                }
                                else
                                {
                                    <div class="d-flex gap-2 mb-3">
                                        <div class="input-group input-group-sm flex-grow-1" style="min-width: 0;">
                                            <input type="text"
                                                   class="form-control bg-dark text-white border-secondary shadow-none" style="min-width: 200px;"
                                                   placeholder="Search update columns..."
                                                   @bind="UpdateColumnSearchTerm"
                                                   @bind:event="oninput" />
                                            <button class="btn @(UpdateColumnSearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => UpdateColumnSearchCaseSensitive = !UpdateColumnSearchCaseSensitive">
                                                <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                            </button>
                                            <button class="btn @(UpdateColumnSearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { UpdateColumnSearchMatchWholeWord = !UpdateColumnSearchMatchWholeWord; if (UpdateColumnSearchMatchWholeWord) UpdateColumnSearchExactMatch = false; }">
                                                <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                            </button>
                                            <button class="btn @(UpdateColumnSearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { UpdateColumnSearchExactMatch = !UpdateColumnSearchExactMatch; if (UpdateColumnSearchExactMatch) UpdateColumnSearchMatchWholeWord = false; }">
                                                <i class="bi bi-bullseye fs-6"></i>
                                            </button>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-light text-nowrap px-3" @onclick="SelectAllUpdateColumns">Select All</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap px-3" @onclick="ClearUpdateColumns">Clear</button>
                                    </div>

                                    <div class="query-option-list mb-3 custom-scrollbar-light" style="max-height: 250px; overflow-y: auto;">
                                        @if (VisibleUpdateColumns.Count == 0)
                                        {
                                            <div class="text-muted small">No matching columns found.</div>
                                        }
                                        else
                                        {
                                            <div class="d-grid gap-2">
                                                @foreach (var col in VisibleUpdateColumns)
                                                {
                                                    <label class="query-option-item">
                                                        <span class="query-option-meta">
                                                            <input type="checkbox"
                                                                   class="form-check-input"
                                                                   checked="@IsUpdateColumnSelected(col.Name)"
                                                                   @onchange="args => SetUpdateColumnSelection(col.Name, args.Value)" />
                                                            <span class="fw-semibold query-option-name">@col.Name</span>
                                                        </span>
                                                        <span class="badge bg-dark border border-secondary text-muted">@col.DataType</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="text-muted small mb-2">A dummy `WHERE` clause is added automatically below.</div>
                                    <pre class="query-preview mb-0">@UpdateQuery</pre>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    }
</div>

@if (ShowLimitAlert)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Tab Limit Reached</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowLimitAlert = false"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">You have reached the maximum limit of <strong>@(Config.GetValue<int>("MaxOpenTabs", 20))</strong> open tabs.</p>
                    <p class="text-muted small mt-2 mb-0">Please close some existing tabs before opening new ones.</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-primary px-4" @onclick="() => ShowLimitAlert = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string FullName { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool ShowLimitAlert = false;
    private bool IsLoading = true;
    private TableInfo? Table;
    private HashSet<string> SelectedUpdateColumns = new(StringComparer.OrdinalIgnoreCase);
    private string TableColumnSearchTerm = string.Empty;
    private bool ColumnSearchCaseSensitive;
    private bool ColumnSearchMatchWholeWord;
    private bool ColumnSearchExactMatch;
    private string UpdateColumnSearchTerm = string.Empty;
    private bool UpdateColumnSearchCaseSensitive = false;
    private bool UpdateColumnSearchMatchWholeWord = false;
    private bool UpdateColumnSearchExactMatch = false;
    private bool SelectCopied;
    private bool InsertCopied;
    private bool UpdateCopied;

    private string ActiveTab = "Columns";

    private string RelationshipSearchTerm = string.Empty;
    private bool RelationshipSearchCaseSensitive = false;
    private bool RelationshipSearchMatchWholeWord = false;
    private bool RelationshipSearchExactMatch = false;

    private string UsedBySearchTerm = string.Empty;
    private bool UsedBySearchCaseSensitive = false;
    private bool UsedByShowSPs = true;
    private bool UsedByShowViews = true;
    private bool UsedByShowFunctions = true;
    private bool UsedBySearchMatchWholeWord = false;
    private bool UsedBySearchExactMatch = false;

    private IEnumerable<Relationship> FilteredOutgoingKeys
    {
        get
        {
            if (Table == null) return Array.Empty<Relationship>();
            if (string.IsNullOrWhiteSpace(RelationshipSearchTerm)) return Table.OutgoingKeys;
            
            var searchStr = RelationshipSearchCaseSensitive ? RelationshipSearchTerm : RelationshipSearchTerm.ToLowerInvariant();
            
            return Table.OutgoingKeys.Where(k => 
            {
                var val = RelationshipSearchCaseSensitive ? k.ToTable : k.ToTable.ToLowerInvariant();
                if (RelationshipSearchExactMatch) return val == searchStr;
                if (RelationshipSearchMatchWholeWord) return val.Split('.', '[', ']', '_', '-').Contains(searchStr);
                return val.Contains(searchStr);
            });
        }
    }

    private IEnumerable<Relationship> FilteredIncomingKeys
    {
        get
        {
            if (Table == null) return Array.Empty<Relationship>();
            if (string.IsNullOrWhiteSpace(RelationshipSearchTerm)) return Table.IncomingKeys;
            
            var searchStr = RelationshipSearchCaseSensitive ? RelationshipSearchTerm : RelationshipSearchTerm.ToLowerInvariant();
            
            return Table.IncomingKeys.Where(k => 
            {
                var val = RelationshipSearchCaseSensitive ? k.FromTable : k.FromTable.ToLowerInvariant();
                if (RelationshipSearchExactMatch) return val == searchStr;
                if (RelationshipSearchMatchWholeWord) return val.Split('.', '[', ']', '_', '-').Contains(searchStr);
                return val.Contains(searchStr);
            });
        }
    }

    private IEnumerable<Dependency> FilteredUsedBy
    {
        get
        {
            if (Table == null) return Array.Empty<Dependency>();
            
            var allUsedBy = Enumerable.Empty<Dependency>();
            if (UsedByShowViews) allUsedBy = allUsedBy.Concat(Table.ReferencedByViews);
            
            var spsAndFuncs = Table.ReferencedBySPs;
            if (UsedByShowSPs) allUsedBy = allUsedBy.Concat(spsAndFuncs.Where(d => d.Type.Contains("Procedure", StringComparison.OrdinalIgnoreCase)));
            if (UsedByShowFunctions) allUsedBy = allUsedBy.Concat(spsAndFuncs.Where(d => d.Type.Contains("Function", StringComparison.OrdinalIgnoreCase)));
            
            if (string.IsNullOrWhiteSpace(UsedBySearchTerm)) return allUsedBy;
            
            var searchStr = UsedBySearchCaseSensitive ? UsedBySearchTerm : UsedBySearchTerm.ToLowerInvariant();
            
            return allUsedBy.Where(d => 
            {
                var nameVal = UsedBySearchCaseSensitive ? d.Name : d.Name.ToLowerInvariant();
                var schemaVal = UsedBySearchCaseSensitive ? d.Schema : d.Schema.ToLowerInvariant();
                
                if (UsedBySearchExactMatch) 
                    return nameVal == searchStr || schemaVal == searchStr;
                if (UsedBySearchMatchWholeWord) 
                    return nameVal.Split('_', '-', '.').Contains(searchStr) || schemaVal.Split('_', '-', '.').Contains(searchStr);
                    
                return nameVal.Contains(searchStr) || schemaVal.Contains(searchStr);
            });
        }
    }

    private List<ColumnInfo> VisibleTableColumns => FilterColumns(TableColumnSearchTerm, ColumnSearchCaseSensitive, ColumnSearchMatchWholeWord, ColumnSearchExactMatch);
    private List<ColumnInfo> VisibleUpdateColumns => FilterColumns(UpdateColumnSearchTerm, UpdateColumnSearchCaseSensitive, UpdateColumnSearchMatchWholeWord, UpdateColumnSearchExactMatch);
    private string SelectQuery => $"SELECT TOP 100 * FROM {QuotedTableName(Table!)};";
    private string InsertQuery => BuildInsertQuery();
    private string UpdateQuery => BuildUpdateQuery();

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        await Task.Yield();
        
        var decoded = Uri.UnescapeDataString(FullName);
        Table = SchemaService.Tables.FirstOrDefault(t => t.FullName == decoded);
        
        if (Table != null && !Table.AreDependenciesLoaded)
        {
            await SchemaService.LoadTableDependenciesAsync(Table.FullName);
        }

        InsertCopied = false;
        UpdateCopied = false;
        SelectedUpdateColumns = Table?.Columns
            .Select(c => c.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase) ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        TableColumnSearchTerm = string.Empty;
        UpdateColumnSearchTerm = string.Empty;
        RelationshipSearchTerm = string.Empty;
        UsedBySearchTerm = string.Empty;

        IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("scrollToMainTop"); } catch { }
        }
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }

    private async Task LoadAndRunQuery(string queryText, string tabName)
    {
        if (QueryStateService.Tabs.Count >= Config.GetValue<int>("MaxOpenTabs", 20))
        {
            ShowLimitAlert = true;
            return;
        }

        var newCount = QueryStateService.Tabs.Count + 1;
        var newTab = new ExploreDB.Services.QueryTab 
        { 
            Name = tabName,
            Content = queryText
        };
        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        await QueryStateService.SaveTabsAsync();
        
        Navigation.NavigateTo("/runner");
    }

    private void NavigateBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/explorer");
    }

    private string BuildTableLink(string targetFullName)
    {
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"/table/{Uri.EscapeDataString(targetFullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string BuildProcLink(string procFullName)
    {
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"/proc/{Uri.EscapeDataString(procFullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string BuildFuncLink(string funcFullName)
    {
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"/function/{Uri.EscapeDataString(funcFullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string BuildObjectLink(string targetFullName)
    {
        var isView = SchemaService.Views.Any(v => v.FullName.Equals(targetFullName, StringComparison.OrdinalIgnoreCase));
        var prefix = isView ? "/view" : "/table";
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(targetFullName)}";
        if (string.IsNullOrWhiteSpace(currentRoute)) return baseLink;
        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string GetShortName(string fullName)
    {
        return fullName.Replace("[", "").Replace("]", "");
    }

    private string BuildInsertQuery()
    {
        if (Table == null)
        {
            return string.Empty;
        }

        if (Table.Columns.Count == 0)
        {
            return $"-- No columns found for {QuotedTableName(Table)}.";
        }

        var newLine = Environment.NewLine;
        var columnLines = string.Join($",{newLine}    ", Table.Columns.Select(c => QuoteIdentifier(c.Name)));
        var valueLines = string.Join($",{newLine}    ", Table.Columns.Select(c => BuildParameterName("p", c.Name)));

        return
            $"INSERT INTO {QuotedTableName(Table)} ({newLine}" +
            $"    {columnLines}{newLine}" +
            $"){newLine}" +
            $"VALUES ({newLine}" +
            $"    {valueLines}{newLine}" +
            $");";
    }

    private string BuildUpdateQuery()
    {
        if (Table == null)
        {
            return string.Empty;
        }

        var selectedColumns = Table.Columns
            .Where(c => SelectedUpdateColumns.Contains(c.Name))
            .ToList();

        if (selectedColumns.Count == 0)
        {
            return "-- Select at least one column to generate an UPDATE query.";
        }

        var newLine = Environment.NewLine;
        var setLines = string.Join(
            $",{newLine}",
            selectedColumns.Select(c => $"    {QuoteIdentifier(c.Name)} = {BuildParameterName("set", c.Name)}"));

        return
            $"UPDATE {QuotedTableName(Table)}{newLine}" +
            $"SET{newLine}" +
            $"{setLines}{newLine}" +
            $"WHERE <add_condition_here>;";
    }


    private static string QuoteIdentifier(string identifier)
    {
        return $"[{identifier.Replace("]", "]]")}]";
    }

    private static string QuotedTableName(TableInfo table)
    {
        return $"{QuoteIdentifier(table.Schema)}.{QuoteIdentifier(table.Name)}";
    }

    private static string BuildParameterName(string prefix, string columnName)
    {
        var safeName = new string(columnName.Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray()).Trim('_');

        if (string.IsNullOrWhiteSpace(safeName))
        {
            safeName = "value";
        }

        if (char.IsDigit(safeName[0]))
        {
            safeName = $"c_{safeName}";
        }

        return $"@{prefix}_{safeName}";
    }

    private bool IsUpdateColumnSelected(string columnName)
    {
        return SelectedUpdateColumns.Contains(columnName);
    }

    private List<ColumnInfo> FilterColumns(string searchTerm, bool caseSensitive, bool matchWholeWord, bool exactMatch)
    {
        if (Table == null) return new List<ColumnInfo>();
        if (string.IsNullOrWhiteSpace(searchTerm)) return Table.Columns.ToList();

        var searchStr = caseSensitive ? searchTerm : searchTerm.ToLower();

        return Table.Columns.Where(c =>
        {
            var colName = caseSensitive ? c.Name : c.Name.ToLower();
            var dataType = caseSensitive ? c.DataType : c.DataType.ToLower();

            if (exactMatch)
            {
                return colName == searchStr || dataType == searchStr;
            }
            if (matchWholeWord)
            {
                return colName.Split(' ', '.', '_').Contains(searchStr) || 
                       dataType.Split(' ', '.', '_').Contains(searchStr);
            }
            
            return colName.Contains(searchStr) || dataType.Contains(searchStr);
        }).ToList();
    }

    private void SetUpdateColumnSelection(string columnName, object? value)
    {
        if (ParseCheckboxValue(value))
        {
            SelectedUpdateColumns.Add(columnName);
            return;
        }

        SelectedUpdateColumns.Remove(columnName);
    }



    private static bool ParseCheckboxValue(object? value)
    {
        return value switch
        {
            bool selected => selected,
            string selectedText when bool.TryParse(selectedText, out var parsed) => parsed,
            _ => false
        };
    }

    private void SelectAllUpdateColumns()
    {
        if (Table == null)
        {
            return;
        }

        SelectedUpdateColumns = Table.Columns
            .Select(c => c.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void ClearUpdateColumns()
    {
        SelectedUpdateColumns.Clear();
    }

    private async Task CopyInsertQuery()
    {
        await CopyQueryAsync(InsertQuery, "InsertCopied");
    }

    private async Task CopySelectQuery()
    {
        await CopyQueryAsync(SelectQuery, "SelectCopied");
    }

    private async Task CopyUpdateQuery()
    {
        await CopyQueryAsync(UpdateQuery, "UpdateCopied");
    }

    private async Task CopyQueryAsync(string query, string copyStateVar)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", query);
        
        switch (copyStateVar)
        {
            case "SelectCopied": SelectCopied = true; break;
            case "InsertCopied": InsertCopied = true; break;
            case "UpdateCopied": UpdateCopied = true; break;
        }
        
        StateHasChanged();
        await Task.Delay(2000);
        
        switch (copyStateVar)
        {
            case "SelectCopied": SelectCopied = false; break;
            case "InsertCopied": InsertCopied = false; break;
            case "UpdateCopied": UpdateCopied = false; break;
        }
        
        StateHasChanged();
    }




    private RenderFragment RenderUpstream(TableInfo currentTable, HashSet<string> path) => __builder =>
    {
        var nextPath = new HashSet<string>(path) { currentTable.FullName };
        var parents = currentTable.OutgoingKeys;
        if (!parents.Any()) return;

        <ul class="sql-tree">
            @foreach (var rel in parents)
            {
                var parentTable = SchemaService.Tables.FirstOrDefault(t => t.FullName == rel.ToTable);
                if (parentTable == null) continue;

                bool isCycle = path.Contains(parentTable.FullName);

                <li>
                    <a href="@BuildTableLink(parentTable.FullName)" class="text-decoration-none"
                       data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @parentTable.Name<br/><b>Schema:</b> @parentTable.Schema.ToLower()<br/><b>Join:</b> ON @(GetShortName(currentTable.Name)).@(rel.FromColumn) = @(GetShortName(parentTable.Name)).@(rel.ToColumn)" data-bs-placement="right">
                        <span style="color: #00e676; font-weight: bold;">@GetShortName(parentTable.Name)</span>
                    </a>
                    @if (isCycle)
                    {
                        <span class="text-danger ms-2 small">[Cycle detected]</span>
                    }
                    else
                    {
                        @RenderUpstream(parentTable, nextPath)
                    }
                </li>
            }
        </ul>
    };

    private RenderFragment RenderDownstream(TableInfo currentTable, HashSet<string> path) => __builder =>
    {
        var nextPath = new HashSet<string>(path) { currentTable.FullName };
        var children = currentTable.IncomingKeys;
        if (!children.Any()) return;

        <ul class="sql-tree">
            @foreach (var rel in children)
            {
                var childTable = SchemaService.Tables.FirstOrDefault(t => t.FullName == rel.FromTable);
                if (childTable == null) continue;

                bool isCycle = path.Contains(childTable.FullName);

                <li>
                    <a href="@BuildTableLink(childTable.FullName)" class="text-decoration-none"
                       data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @childTable.Name<br/><b>Schema:</b> @childTable.Schema.ToLower()<br/><b>Join:</b> ON @(GetShortName(currentTable.Name)).@(rel.ToColumn) = @(GetShortName(childTable.Name)).@(rel.FromColumn)" data-bs-placement="right">
                        <span style="color: #ff9800; font-weight: bold;">@GetShortName(childTable.Name)</span>
                    </a>
                    @if (isCycle)
                    {
                        <span class="text-danger ms-2 small">[Cycle detected]</span>
                    }
                    else
                    {
                        @RenderDownstream(childTable, nextPath)
                    }
                </li>
            }
        </ul>
    };

    private bool IsForeignKey(string columnName)
    {
        return Table?.OutgoingKeys.Any(k => k.FromColumn == columnName) ?? false;
    }

    private string? GetForeignKeyTable(string columnName)
    {
        return Table?.OutgoingKeys.FirstOrDefault(k => k.FromColumn == columnName)?.ToTable;
    }

    private bool IsPrimaryKey(string columnName)
    {
        if (string.Equals(columnName, "Id", StringComparison.OrdinalIgnoreCase)) return true;
        if (Table != null && string.Equals(columnName, Table.Name + "Id", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }
}
