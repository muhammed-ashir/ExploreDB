    private async Task LoadTrendsForSelectedQueryAsync()
    {
        _hoveredTrendIndex = null;
        if (_selectedItem == null || _result == null || !_result.IsUsingQueryStore || _selectedItem.QueryId <= 0)
        {
            _trends.Clear();
            return;
        }

        var targetConn = GetTargetConnectionString();
        if (string.IsNullOrWhiteSpace(targetConn)) return;

        _isLoadingTrends = true;
        StateHasChanged();

        try
        {
            var (start, end) = _filterOptions.GetResolvedTimeRange();
            _trends = await SlowQueryService.GetQueryExecutionTrendsAsync(
                targetConn,
                _selectedItem.QueryId,
                start,
                end);
        }
        catch
        {
            _trends.Clear();
        }
        finally
        {
            _isLoadingTrends = false;
            StateHasChanged();
        }
    }

