    private async Task DownloadExecutionPlanAsync()
    {
        if (_selectedItem == null) return;

        _isLoadingPlan = true;
        StateHasChanged();

        try
        {
            string? planXml = _selectedItem.QueryPlanXml;
            if (string.IsNullOrWhiteSpace(planXml))
            {
                var targetConn = GetTargetConnectionString();
                planXml = await SlowQueryService.GetExecutionPlanXmlAsync(
                    targetConn,
                    _selectedItem,
                    _result?.IsUsingQueryStore ?? false);

                _selectedItem.QueryPlanXml = planXml;
            }

            if (!string.IsNullOrWhiteSpace(planXml))
            {
                string objName = !string.IsNullOrWhiteSpace(_selectedItem.ObjectName) ? _selectedItem.ObjectName : $"Rank{_selectedItem.Rank}";
                string fileName = $"Plan_{objName}_{DateTime.Now:yyyyMMdd_HHmmss}.sqlplan";

                using var stream = new MemoryStream(Encoding.UTF8.GetBytes(planXml));
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            }
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Failed to download execution plan");
        }
        finally
        {
            _isLoadingPlan = false;
            StateHasChanged();
        }
    }

    private async Task OpenInQueryRunnerAsync()
    {
        if (_selectedItem == null) return;

        string sql = _showFullBatch && !string.IsNullOrWhiteSpace(_selectedItem.FullBatchText)
            ? _selectedItem.FullBatchText
            : _selectedItem.StatementText;

        string objName = !string.IsNullOrWhiteSpace(_selectedItem.ObjectName) 
            ? _selectedItem.ObjectName 
            : $"Query_Rank{_selectedItem.Rank}";
        string tabName = $"Tuning_{objName}_{DateTime.Now:HHmmss}.sql";

        var targetConn = GetTargetConnectionString();
        var newTab = new QueryTab
        {
            Id = Guid.NewGuid(),
            Name = tabName,
            Content = sql,
            OriginalContent = sql,
            ConnectionString = targetConn
        };

        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        QueryStateService.NotifyTabUpdated(newTab.Id);
        await QueryStateService.SaveTabsAsync();

        if (IsPopout)
        {
            WindowManager.NavigateMainWindow("/runner");
        }
        else
        {
            Nav.NavigateTo("/runner");
