    .hover-glow:hover {
        opacity: 1 !important;
        filter: brightness(1.2);
    }
</style>

@code {
    [CascadingParameter(Name = "IsPopout")]
    public bool IsPopout { get; set; } = false;

    private bool _isLoading = false;
    private bool _forceDmv = false;
    private bool _showModeHelpModal = false;
    private bool _showFullBatch = false;
    private bool _copyFeedback = false;
    private bool _isLoadingPlan = false;
    private bool _isLoadingTrends = false;
    private string _searchTerm = "";

    private SlowQueryResult? _result;
    private SlowQueryItem? _selectedItem;
    private List<QueryIntervalTrend> _trends = new();
    private SlowQueryFilterOptions _filterOptions = new();

    private StandaloneCodeEditor? _monacoEditor;
    private bool _monacoReady = false;

    private IEnumerable<SlowQueryItem> FilteredQueries
    {
        get
        {
            if (_result?.Queries == null) return Enumerable.Empty<SlowQueryItem>();
            if (string.IsNullOrWhiteSpace(_searchTerm)) return _result.Queries;

            var term = _searchTerm.Trim();
            return _result.Queries.Where(q =>
                (q.ObjectName != null && q.ObjectName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (q.ObjectSchema != null && q.ObjectSchema.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                q.StatementText.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ConnectionService.OnConnectionChanged += HandleConnectionChanged;
        ThemeService.OnThemeChanged += HandleThemeChanged;

        // Load preferences from UserSettingsService
        var settings = UserSettingsService.Settings;
        if (Enum.TryParse<RankingMetric>(settings.SlowQueryDefaultMetric, true, out var metric))
        {
            _filterOptions.Metric = metric;
        }
        if (Enum.TryParse<TimeWindowPreset>(settings.SlowQueryDefaultTimeWindow, true, out var timeWindow))
        {
            _filterOptions.TimeWindow = timeWindow;
        }
        if (settings.SlowQueryTopCount > 0)
        {
            _filterOptions.TopCount = settings.SlowQueryTopCount;
        }

        if (SchemaService.IsDatabaseConnected)
        {
            await LoadQueriesAsync();
        }
    }

    private async Task LoadQueriesAsync()
    {
        if (string.IsNullOrWhiteSpace(ConnectionService.ConnectionString)) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            _result = await SlowQueryService.GetTopQueriesAsync(
                ConnectionService.ConnectionString,
                _filterOptions,
                forceDmv: _forceDmv);

            if (_result.Queries.Any())
            {
                // Preserve selection if possible, otherwise select rank #1
                var prevSelected = _selectedItem;
                _selectedItem = _result.Queries.FirstOrDefault(q => 
                    prevSelected != null && (q.QueryId > 0 ? q.QueryId == prevSelected.QueryId : q.QueryHash == prevSelected.QueryHash))
                    ?? _result.Queries.First();

                await UpdateMonacoContentAsync();
                await LoadTrendsForSelectedQueryAsync();
            }
            else
            {
                _selectedItem = null;
                _trends.Clear();
            }
        }
        catch (Exception ex)
        {
            _result = new SlowQueryResult { ErrorMessage = ex.Message };
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectQueryAsync(SlowQueryItem query)
    {
        if (_selectedItem == query) return;
        _selectedItem = query;
        _showFullBatch = false;

        await UpdateMonacoContentAsync();
        await LoadTrendsForSelectedQueryAsync();
    }

    private async Task ToggleBatchViewAsync(bool showFull)
    {
        _showFullBatch = showFull;
        await UpdateMonacoContentAsync();
    }

    private async Task LoadTrendsForSelectedQueryAsync()
    {
        if (_selectedItem == null || _result == null || !_result.IsUsingQueryStore || _selectedItem.QueryId <= 0)
        {
            _trends.Clear();
            return;
        }

        _isLoadingTrends = true;
        StateHasChanged();

        try
        {
            var (start, end) = _filterOptions.GetResolvedTimeRange();
            _trends = await SlowQueryService.GetQueryExecutionTrendsAsync(
                ConnectionService.ConnectionString,
                _selectedItem.QueryId,
                start,
                end);
        }
        catch
        {
            _trends.Clear();
        }
        finally
        {
            _isLoadingTrends = false;
            StateHasChanged();
        }
    }

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        string initialSql = _selectedItem != null
            ? (_showFullBatch && !string.IsNullOrWhiteSpace(_selectedItem.FullBatchText) ? _selectedItem.FullBatchText : _selectedItem.StatementText)
            : "";

        return new StandaloneEditorConstructionOptions
        {
            Language = "sql",
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            Value = initialSql,
            AutomaticLayout = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            LineNumbers = "on",
            ReadOnly = true,
            ScrollBeyondLastLine = false,
            FontSize = 13,
            OverviewRulerBorder = false,
            HideCursorInOverviewRuler = true,
            FixedOverflowWidgets = true,
            Scrollbar = new EditorScrollbarOptions { UseShadows = false }
        };
    }

    private async Task OnMonacoInitAsync()
    {
        _monacoReady = true;
        await UpdateMonacoContentAsync();
    }

    private async Task UpdateMonacoContentAsync()
    {
        if (_monacoEditor != null && _monacoReady && _selectedItem != null)
        {
            string sql = _showFullBatch && !string.IsNullOrWhiteSpace(_selectedItem.FullBatchText)
                ? _selectedItem.FullBatchText
                : _selectedItem.StatementText;

            await _monacoEditor.SetValue(sql);
        }
    }

    private async Task OnTimeWindowChangedAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<TimeWindowPreset>(e.Value?.ToString(), out var preset))
        {
            _filterOptions.TimeWindow = preset;
            PersistPreferences();
            await LoadQueriesAsync();
        }
    }

    private async Task OnMetricChangedAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<RankingMetric>(e.Value?.ToString(), out var metric))
        {
            _filterOptions.Metric = metric;
            PersistPreferences();
            await LoadQueriesAsync();
        }
    }

    private async Task OnTopCountChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int topCount))
        {
            _filterOptions.TopCount = topCount;
            PersistPreferences();
            await LoadQueriesAsync();
        }
    }

    private async Task SetEngineModeAsync(bool forceDmv)
    {
        if (_forceDmv == forceDmv) return;
        _forceDmv = forceDmv;
        await LoadQueriesAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadQueriesAsync();
    }

    private void PersistPreferences()
    {
        UserSettingsService.UpdateSlowQueryPreferences(
            _filterOptions.TimeWindow.ToString(),
            _filterOptions.Metric.ToString(),
            _filterOptions.TopCount);
    }

    private async Task CopySqlAsync()
    {
        if (_selectedItem == null) return;
        string sql = _showFullBatch && !string.IsNullOrWhiteSpace(_selectedItem.FullBatchText)
            ? _selectedItem.FullBatchText
            : _selectedItem.StatementText;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", sql);
            _copyFeedback = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copyFeedback = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task CopyEnableQueryStoreScriptAsync()
    {
        const string script = "ALTER DATABASE CURRENT SET QUERY_STORE = ON (OPERATION_MODE = READ_WRITE);";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", script);
        }
        catch { }
    }

    private async Task DownloadExecutionPlanAsync()
    {
        if (_selectedItem == null) return;

        _isLoadingPlan = true;
        StateHasChanged();

        try
        {
            string? planXml = _selectedItem.QueryPlanXml;
            if (string.IsNullOrWhiteSpace(planXml))
            {
                planXml = await SlowQueryService.GetExecutionPlanXmlAsync(
                    ConnectionService.ConnectionString,
                    _selectedItem,
                    _result?.IsUsingQueryStore ?? false);

                _selectedItem.QueryPlanXml = planXml;
            }

            if (!string.IsNullOrWhiteSpace(planXml))
            {
                string objName = !string.IsNullOrWhiteSpace(_selectedItem.ObjectName) ? _selectedItem.ObjectName : $"Rank{_selectedItem.Rank}";
                string fileName = $"Plan_{objName}_{DateTime.Now:yyyyMMdd_HHmmss}.sqlplan";

                using var stream = new MemoryStream(Encoding.UTF8.GetBytes(planXml));
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            }
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Failed to download execution plan");
        }
        finally
        {
            _isLoadingPlan = false;
            StateHasChanged();
        }
    }

    private async Task OpenInQueryRunnerAsync()
    {
        if (_selectedItem == null) return;

        string sql = _showFullBatch && !string.IsNullOrWhiteSpace(_selectedItem.FullBatchText)
            ? _selectedItem.FullBatchText
            : _selectedItem.StatementText;

        string objName = !string.IsNullOrWhiteSpace(_selectedItem.ObjectName) 
            ? _selectedItem.ObjectName 
            : $"Query_Rank{_selectedItem.Rank}";
        string tabName = $"Tuning_{objName}_{DateTime.Now:HHmmss}.sql";

        var newTab = new QueryTab
        {
            Id = Guid.NewGuid(),
            Name = tabName,
            Content = sql,
            OriginalContent = sql,
            ConnectionString = ConnectionService.ConnectionString
        };

        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        QueryStateService.NotifyTabUpdated(newTab.Id);
        await QueryStateService.SaveTabsAsync();

        if (IsPopout)
        {
            WindowManager.NavigateMainWindow("/runner");
        }
        else
        {
            Nav.NavigateTo("/runner");
        }
    }

    private void OpenPopout()
    {
        WindowManager.OpenToolPopout(
            "slow-query-analyzer",
            "/tools/slow-query-analyzer",
            "Slow Query Analyzer - ExploreDB",
            closeOnConnectionChange: false);
    }

    private async void HandleConnectionChanged()
    {
        await InvokeAsync(async () =>
        {
            if (SchemaService.IsDatabaseConnected)
            {
                await LoadQueriesAsync();
            }
            else
            {
                _result = null;
                _selectedItem = null;
                _trends.Clear();
                StateHasChanged();
            }
        });
    }

    private async void HandleThemeChanged()
    {
        if (_monacoEditor != null && _monacoReady)
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await BlazorMonaco.Editor.Global.SetTheme(JS, ThemeService.IsDark ? "vs-dark" : "vs");
                }
                catch { }
            });
        }
    }

    public void Dispose()
    {
        ConnectionService.OnConnectionChanged -= HandleConnectionChanged;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
