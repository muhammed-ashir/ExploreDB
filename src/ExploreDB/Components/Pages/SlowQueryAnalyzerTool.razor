    {
        TrendMetric.Duration => "#fbbf24",
        TrendMetric.Cpu => "#c084fc",
        _ => "#38bdf8"
    };

    private string GetTrendGradientStart() => _selectedTrendMetric switch
    {
        TrendMetric.Duration => "#d97706",
        TrendMetric.Cpu => "#9333ea",
        _ => "#0284c7"
    };

    private List<(double X, double Y, QueryIntervalTrend Trend)> GetTrendPoints()
    {
        var list = new List<(double X, double Y, QueryIntervalTrend Trend)>();
        if (!_trends.Any()) return list;

        int count = _trends.Count;
        double maxVal = 0;
        foreach (var t in _trends)
        {
            double v = _selectedTrendMetric switch
            {
                TrendMetric.Duration => t.AvgDurationMs,
                TrendMetric.Cpu => t.AvgCpuMs,
                _ => (double)t.Executions
            };
            if (v > maxVal) maxVal = v;
        }
        if (maxVal <= 0) maxVal = 1;

        const double yTop = 15.0;
        const double yBottom = 105.0;
        const double yRange = yBottom - yTop;

        if (count == 1)
        {
            double val = _selectedTrendMetric switch
            {
                TrendMetric.Duration => _trends[0].AvgDurationMs,
                TrendMetric.Cpu => _trends[0].AvgCpuMs,
                _ => (double)_trends[0].Executions
            };
            double y = yBottom - ((val / maxVal) * yRange);
            list.Add((0.0, y, _trends[0]));
            list.Add((1000.0, y, _trends[0]));
            return list;
        }

        for (int i = 0; i < count; i++)
        {
            var t = _trends[i];
            double x = (i / (double)(count - 1)) * 1000.0;
            double val = _selectedTrendMetric switch
            {
                TrendMetric.Duration => t.AvgDurationMs,
                TrendMetric.Cpu => t.AvgCpuMs,
                _ => (double)t.Executions
            };
            double y = yBottom - ((val / maxVal) * yRange);
            list.Add((x, y, t));
        }

        return list;
    }

    private string GetSmoothSvgPath(List<(double X, double Y, QueryIntervalTrend Trend)> points)
    {
        if (points.Count == 0) return "";
        if (points.Count == 1) return FormattableString.Invariant($"M 0 {points[0].Y:F1} L 1000 {points[0].Y:F1}");
        if (points.Count == 2) return FormattableString.Invariant($"M {points[0].X:F1} {points[0].Y:F1} L {points[1].X:F1} {points[1].Y:F1}");

        var sb = new StringBuilder();
        sb.Append(FormattableString.Invariant($"M {points[0].X:F1} {points[0].Y:F1}"));

        for (int i = 0; i < points.Count - 1; i++)
        {
            var p0 = i > 0 ? points[i - 1] : points[i];
            var p1 = points[i];
            var p2 = points[i + 1];
            var p3 = i < points.Count - 2 ? points[i + 2] : p2;

            double cp1x = p1.X + (p2.X - p0.X) / 6.0;
            double cp1y = p1.Y + (p2.Y - p0.Y) / 6.0;
            double cp2x = p2.X - (p3.X - p1.X) / 6.0;
            double cp2y = p2.Y - (p3.Y - p1.Y) / 6.0;

            cp1y = Math.Clamp(cp1y, 10.0, 108.0);
            cp2y = Math.Clamp(cp2y, 10.0, 108.0);

            sb.Append(FormattableString.Invariant($" C {cp1x:F1} {cp1y:F1}, {cp2x:F1} {cp2y:F1}, {p2.X:F1} {p2.Y:F1}"));
        }

        return sb.ToString();
    }

    private string GetSmoothAreaPath(List<(double X, double Y, QueryIntervalTrend Trend)> points)
    {
        if (points.Count == 0) return "";
        string linePath = GetSmoothSvgPath(points);
        double lastX = points.Last().X;
        double firstX = points.First().X;
        return FormattableString.Invariant($"{linePath} L {lastX:F1} 108 L {firstX:F1} 108 Z");
    }

    private string GetTrendMetricSummary()
    {
        if (!_trends.Any()) return "";
        switch (_selectedTrendMetric)
        {
            case TrendMetric.Duration:
                double maxDur = _trends.Max(t => t.AvgDurationMs);
                double avgDur = _trends.Average(t => t.AvgDurationMs);
                return $"Peak: {SlowQueryItem.FormatDuration(maxDur)} · Window Avg: {SlowQueryItem.FormatDuration(avgDur)}";
            case TrendMetric.Cpu:
                double maxCpu = _trends.Max(t => t.AvgCpuMs);
                double avgCpu = _trends.Average(t => t.AvgCpuMs);
                return $"Peak: {SlowQueryItem.FormatDuration(maxCpu)} · Window Avg: {SlowQueryItem.FormatDuration(avgCpu)}";
            default:
                long maxEx = _trends.Max(t => t.Executions);
                double avgEx = _trends.Average(t => t.Executions);
                return $"Peak: {maxEx:N0} execs · Avg: {avgEx:N1} execs/bucket";
        }
    }

    public void Dispose()
    {
        ConnectionService.OnConnectionChanged -= HandleConnectionChanged;
        ConnectionService.OnDatabaseSwitched -= OnDatabaseSwitchedHandler;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
