    private void HandleConnectionChanged()
    {
        RefreshAvailableConnections();
        InvokeAsync(async () =>
        {
            if (SchemaService.IsDatabaseConnected && !string.IsNullOrWhiteSpace(SchemaService.ActiveDatabase))
            {
                _selectedConnectionString = ConnectionService.ConnectionString ?? "";
                _selectedDatabase = SchemaService.ActiveDatabase;
                _serverSearch = GetSelectedServerDisplayName();
                _databaseSearch = GetSelectedDatabaseDisplayName();
                await LoadDatabasesForSelectedServerAsync();
                await LoadQueriesAsync();
            }
            else
            {
                _selectedConnectionString = ConnectionService.ConnectionString ?? (_availableConnections.FirstOrDefault()?.ConnectionString ?? "");
                _selectedDatabase = string.Empty;
                _serverSearch = GetSelectedServerDisplayName();
                _databaseSearch = string.Empty;
                _result = null;
                _selectedItem = null;
                _trends.Clear();
                if (!string.IsNullOrWhiteSpace(_selectedConnectionString))
                {
                    await LoadDatabasesForSelectedServerAsync();
                }
            }
            StateHasChanged();
        });
    }

    private string GetTargetConnectionString()
    {
        if (string.IsNullOrWhiteSpace(_selectedConnectionString))
        {
            return ConnectionService.ConnectionString ?? string.Empty;
        }
        if (string.IsNullOrWhiteSpace(_selectedDatabase))
        {
            return _selectedConnectionString;
        }
        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(_selectedConnectionString)
            {
                InitialCatalog = _selectedDatabase
            };
            return builder.ConnectionString;
        }
        catch
        {
            return _selectedConnectionString;
        }
    }

    private void RefreshAvailableConnections()
    {
        var list = new List<ConnectionService.SavedConnection>();

        void AddIfNotPresent(ConnectionService.SavedConnection conn)
        {
            if (string.IsNullOrWhiteSpace(conn.ConnectionString)) return;
            var existing = list.FirstOrDefault(x => IsSameServerConnection(x, conn));
            if (existing == null)
            {
                list.Add(conn);
            }
            else
            {
                if ((string.IsNullOrWhiteSpace(existing.Name) || string.Equals(existing.Name, existing.Server, StringComparison.OrdinalIgnoreCase))
                    && !string.IsNullOrWhiteSpace(conn.Name) && !string.Equals(conn.Name, conn.Server, StringComparison.OrdinalIgnoreCase))
                {
                    existing.Name = conn.Name;
                }
            }
        }

        if (ConnectionService.ActiveSessionConnections != null)
        {
            foreach (var c in ConnectionService.ActiveSessionConnections)
            {
                AddIfNotPresent(c);
            }
        }

        if (ConnectionService.SavedConnections != null)
        {
            foreach (var c in ConnectionService.SavedConnections)
            {
                AddIfNotPresent(c);
            }
        }

        if (!string.IsNullOrWhiteSpace(ConnectionService.ConnectionString))
        {
            string srv = "Active Connection";
            string db = "";
            try
            {
                var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
                srv = b.DataSource;
                db = b.InitialCatalog;
            }
            catch { }

            var activeConn = new ConnectionService.SavedConnection
            {
                Id = "current_active",
                Name = srv,
                Server = srv,
                Database = db,
                ConnectionString = ConnectionService.ConnectionString
            };

            if (!list.Any(x => IsSameServerConnection(x, activeConn)))
            {
                list.Insert(0, activeConn);
            }
        }

        _availableConnections = list;

        if (string.IsNullOrEmpty(_selectedConnectionString) && _availableConnections.Count > 0)
        {
            _selectedConnectionString = _availableConnections[0].ConnectionString;
        }
    }

    private static bool IsSameServerConnection(ConnectionService.SavedConnection a, ConnectionService.SavedConnection b)
    {
        if (ReferenceEquals(a, b)) return true;
        if (a == null || b == null) return false;

        if (!string.IsNullOrEmpty(a.Id) && !string.IsNullOrEmpty(b.Id) &&
            !string.Equals(a.Id, "current_active", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(b.Id, "current_active", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(a.Id, b.Id, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(a.ConnectionString) && !string.IsNullOrWhiteSpace(b.ConnectionString) &&
            string.Equals(a.ConnectionString, b.ConnectionString, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        string normA = NormalizeServerConnectionString(a.ConnectionString);
        string normB = NormalizeServerConnectionString(b.ConnectionString);
        if (!string.IsNullOrEmpty(normA) && !string.IsNullOrEmpty(normB) &&
            string.Equals(normA, normB, StringComparison.OrdinalIgnoreCase))
        {
            if (string.IsNullOrEmpty(a.Name) || string.IsNullOrEmpty(b.Name) ||
                string.Equals(a.Name, b.Name, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        if (!string.IsNullOrWhiteSpace(a.Server) && !string.IsNullOrWhiteSpace(b.Server) &&
            string.Equals(a.Server, b.Server, StringComparison.OrdinalIgnoreCase))
        {
            if (string.Equals(a.Name ?? "", b.Name ?? "", StringComparison.OrdinalIgnoreCase) &&
                string.Equals(a.Username ?? "", b.Username ?? "", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static string NormalizeServerConnectionString(string? connStr)
    {
        if (string.IsNullOrWhiteSpace(connStr)) return string.Empty;
        try
        {
            var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connStr);
            b.InitialCatalog = "";
            b.Remove("Initial Catalog");
            b.Remove("Database");
            return b.ConnectionString;
        }
        catch
        {
            return connStr.Trim();
        }
    }

    private static string GetConnectionOptionLabel(ConnectionService.SavedConnection conn)
    {
        if (string.IsNullOrWhiteSpace(conn.Name) || string.Equals(conn.Name, conn.Server, StringComparison.OrdinalIgnoreCase))
        {
            return conn.Server ?? "Unknown Server";
        }
        return $"{conn.Server} ({conn.Name})";
    }

    private static string GetServerDisplayName(string? connStr)
    {
        if (string.IsNullOrWhiteSpace(connStr)) return "None";
        try
        {
            var b = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connStr);
            return b.DataSource;
        }
        catch
        {
            return "Server";
        }
    }

    private string GetSelectedServerDisplayName()
    {
        var conn = _availableConnections.FirstOrDefault(c => 
            string.Equals(c.ConnectionString, _selectedConnectionString, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(NormalizeServerConnectionString(c.ConnectionString), NormalizeServerConnectionString(_selectedConnectionString), StringComparison.OrdinalIgnoreCase));
        if (conn != null)
        {
            return GetConnectionOptionLabel(conn);
        }
        return GetServerDisplayName(_selectedConnectionString);
    }

    private string GetSelectedDatabaseDisplayName() => _selectedDatabase ?? string.Empty;

    private void OpenServerDropdown()
    {
        _isServerDropdownOpen = true;
        _isDatabaseDropdownOpen = false;
        _serverSearch = "";
    }

    private void CloseServerDropdown()
    {
        _isServerDropdownOpen = false;
        _serverSearch = GetSelectedServerDisplayName();
    }

    private async Task OnServerSelectedAsync(string connString)
    {
        _isServerDropdownOpen = false;
        if (!string.Equals(_selectedConnectionString, connString, StringComparison.OrdinalIgnoreCase))
        {
            _selectedConnectionString = connString;
            _selectedDatabase = string.Empty;
            _databaseSearch = string.Empty;
            _serverSearch = GetSelectedServerDisplayName();
            _selectedItem = null;
            _trends.Clear();
            _result = null;
            await LoadDatabasesForSelectedServerAsync();
            StateHasChanged();
        }
        else
        {
            _serverSearch = GetSelectedServerDisplayName();
        }
    }

    private void OpenDatabaseDropdown()
    {
        _isDatabaseDropdownOpen = true;
        _isServerDropdownOpen = false;
        _databaseSearch = "";
        if (_availableDatabases.Count == 0 && !_isLoadingDatabases)
        {
            _ = LoadDatabasesForSelectedServerAsync();
        }
    }

    private void CloseDatabaseDropdown()
    {
        _isDatabaseDropdownOpen = false;
        _databaseSearch = GetSelectedDatabaseDisplayName();
    }

    private async Task OnDatabaseSelectedAsync(string db)
    {
        _isDatabaseDropdownOpen = false;
        if (!string.Equals(_selectedDatabase, db, StringComparison.OrdinalIgnoreCase))
        {
            _selectedDatabase = db;
            _databaseSearch = db;
            _selectedItem = null;
            _trends.Clear();
            await LoadQueriesAsync();
        }
        else
        {
            _databaseSearch = db;
        }
    }

    private async Task LoadDatabasesForSelectedServerAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedConnectionString))
        {
            _availableDatabases.Clear();
            return;
        }

        _isLoadingDatabases = true;
        await InvokeAsync(StateHasChanged);

        var dbs = new List<string>();
        string targetConn = _selectedConnectionString;

        try
        {
            await Task.Run(async () =>
            {
                bool fetched = false;
                try
                {
                    var masterBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(targetConn)
                    {
                        InitialCatalog = "master",
                        ConnectTimeout = 4
                    };
                    using var conn = new Microsoft.Data.SqlClient.SqlConnection(masterBuilder.ConnectionString);
                    await conn.OpenAsync();
                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                    using var reader = await cmd.ExecuteReaderAsync();
                    while (await reader.ReadAsync())
                    {
                        dbs.Add(reader.GetString(0));
                    }
                    fetched = true;
                }
                catch { }

                if (!fetched)
                {
                    try
                    {
                        using var conn = new Microsoft.Data.SqlClient.SqlConnection(targetConn);
                        await conn.OpenAsync();
                        using var cmd = conn.CreateCommand();
                        cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                        using var reader = await cmd.ExecuteReaderAsync();
                        while (await reader.ReadAsync())
                        {
                            dbs.Add(reader.GetString(0));
                        }
                    }
                    catch { }
                }
            });
        }
        catch { }
        finally
        {
            _availableDatabases = dbs;
            _isLoadingDatabases = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleThemeChanged()
    {
        if (_monacoEditor != null && _monacoReady)
        {
            await InvokeAsync(async () =>
            {
                try
                {
                    await BlazorMonaco.Editor.Global.SetTheme(JS, ThemeService.IsDark ? "vs-dark" : "vs");
                }
                catch { }
            });
        }
    }

