@page "/tools/slow-query-analyzer"
@using System.IO
@using System.Text
@using System.Threading
@using System.Globalization
@using ExploreDB.Services
@using ExploreDB.Services.SlowQuery
@using BlazorMonaco
@using BlazorMonaco.Editor
@inject SlowQueryService SlowQueryService
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject QueryStateService QueryStateService
@inject UserSettingsService UserSettingsService
@inject WindowManagerService WindowManager
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject ToolRegistryService ToolService
@implements IDisposable

<div class="container-fluid d-flex flex-column pb-2 overflow-hidden slow-query-container" style="@(IsPopout ? "height: calc(100vh - 45px); max-height: calc(100vh - 45px);" : "height: 100%; min-height: 0;")">
    <!-- TOP TOOLBAR -->
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2 pt-2 border-bottom pb-2" style="border-color: var(--app-border) !important;">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (!IsPopout)
            {
                <a href="tools" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" title="Back to Tools Hub">
                    <i class="bi bi-arrow-left"></i>
                    <span>Tools</span>
                </a>
            }

            <h4 class="fw-bold mb-0" style="font-size: 1.2rem; color: var(--app-text);">
                Slow Query Analyzer
            </h4>

            @if (!string.IsNullOrWhiteSpace(_selectedDatabase) && _result != null)
            {
                <div class="d-flex align-items-center gap-2 ms-2">
                    @if (_result.IsQueryStoreSupported)
                    {
                        <!-- Option A: Segmented Mode Selector -->
                        <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Query Analysis Engine">
                            <button type="button"
                                    class="btn btn-sm @(!_forceDmv ? "btn-primary text-white" : "btn-outline-secondary") d-inline-flex align-items-center px-2 py-1"
                                    style="font-size: 0.76rem;"
                                    @onclick="() => SetEngineModeAsync(false)"
                                    title="Analyze persisted historical runtime stats across time windows">
                                <span>Historical (Time Range)</span>
                            </button>
                            <button type="button"
                                    class="btn btn-sm @(_forceDmv ? "btn-primary text-white" : "btn-outline-secondary") d-inline-flex align-items-center px-2 py-1"
                                    style="font-size: 0.76rem;"
                                    @onclick="() => SetEngineModeAsync(true)"
                                    title="Analyze live in-memory execution stats currently in server cache">
                                <span>Live / Real-Time</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-2 py-1 d-inline-flex align-items-center"
                              style="font-size: 0.75rem;"
                              title="Showing live in-memory execution stats from server cache">
                            <span>Live / Real-Time</span>
                        </span>
                    }

                    <!-- Info Explainer Tooltip Button -->
                    <button type="button"
                            class="btn btn-sm btn-link text-muted p-0 text-decoration-none ms-1"
                            style="font-size: 1rem; line-height: 1;"
                            @onclick="() => _showModeHelpModal = true"
                            data-bs-tooltip="true"
                            data-bs-placement="bottom"
                            data-bs-title="What are these modes? (Click to view details)">
                        <i class="bi bi-info-circle"></i>
                    </button>
                </div>
            }
        </div>

        <!-- Controls Toolbar -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Server Dropdown -->
            <div class="position-relative" style="width: 200px;">
                <input class="form-control form-control-sm pe-4 text-truncate"
                       value="@(_isServerDropdownOpen ? _serverSearch : GetSelectedServerDisplayName())"
                       @oninput="@((ChangeEventArgs e) => _serverSearch = e.Value?.ToString() ?? "")"
                       placeholder="Search connection..."
                       @onfocus="OpenServerDropdown"
                       disabled="@_isLoading"
                       data-bs-tooltip="true"
                       data-bs-placement="bottom"
                       data-bs-title="@GetSelectedServerDisplayName()"
                       style="cursor: @(_isLoading ? "not-allowed" : "pointer"); font-size: 0.82rem; height: 31px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />

                @if (_isServerDropdownOpen)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseServerDropdown"></div>
                    <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 220px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                        @{
                            var filteredConns = _availableConnections.Where(c =>
                                string.IsNullOrWhiteSpace(_serverSearch) ||
                                (c.Name ?? "").Contains(_serverSearch, StringComparison.OrdinalIgnoreCase) ||
                                (c.Server ?? "").Contains(_serverSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                            if (filteredConns.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var c in filteredConns)
                                    {
                                        string displayName = GetConnectionOptionLabel(c);
                                        <button type="button" class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate"
                                                style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.82rem; background-color: transparent; color: var(--app-text);"
                                                data-bs-tooltip="true"
                                                data-bs-placement="right"
                                                data-bs-title="@displayName"
                                                @onclick="() => OnServerSelectedAsync(c.ConnectionString)">
                                            @displayName
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-2 text-muted small text-center" style="font-size: 0.8rem;">No connections found</div>
                            }
                        }
                    </div>
                }

                <div class="position-absolute h-100 d-flex align-items-center" style="right: 8px; top: 0; pointer-events: none;">
                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                </div>
            </div>

            <!-- Database Dropdown -->
            <div class="position-relative" style="width: 175px;">
                <input class="form-control form-control-sm pe-4 text-truncate"
                       value="@(_isDatabaseDropdownOpen ? _databaseSearch : GetSelectedDatabaseDisplayName())"
                       @oninput="@((ChangeEventArgs e) => _databaseSearch = e.Value?.ToString() ?? "")"
                       placeholder="Search database..."
                       @onfocus="OpenDatabaseDropdown"
                       disabled="@_isLoading"
                       data-bs-tooltip="true"
                       data-bs-placement="bottom"
                       data-bs-title="@(string.IsNullOrEmpty(GetSelectedDatabaseDisplayName()) ? "Search database..." : GetSelectedDatabaseDisplayName())"
                       style="cursor: @(_isLoading ? "not-allowed" : "pointer"); font-size: 0.82rem; height: 31px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />

                @if (_isDatabaseDropdownOpen)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseDatabaseDropdown"></div>
                    <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 220px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                        @if (_isLoadingDatabases)
                        {
                            <div class="p-3 text-center text-info">
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <small>Loading databases...</small>
                            </div>
                        }
                        else if (_availableDatabases.Any())
                        {
                            var filteredDbs = _availableDatabases.Where(d =>
                                string.IsNullOrWhiteSpace(_databaseSearch) ||
                                d.Contains(_databaseSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                            if (filteredDbs.Any())
                            {
                                <div class="list-group list-group-flush">
                                    @foreach (var db in filteredDbs)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate"
                                                style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.82rem; background-color: transparent; color: var(--app-text);"
                                                data-bs-tooltip="true"
                                                data-bs-placement="right"
                                                data-bs-title="@db"
                                                @onclick="() => OnDatabaseSelectedAsync(db)">
                                            @db
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-2 text-muted small text-center" style="font-size: 0.8rem;">No databases found</div>
                            }
                        }
                        else
                        {
                            <div class="p-2 text-muted small text-center" style="font-size: 0.8rem;">No databases available</div>
                        }
                    </div>
                }

                <div class="position-absolute h-100 d-flex align-items-center" style="right: 8px; top: 0; pointer-events: none;">
                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_selectedDatabase))
            {
                <!-- Time Window Preset (Query Store only) -->
                @if (_result != null && _result.IsUsingQueryStore)
                {
                    <div class="d-flex align-items-center gap-1">
                        <label class="text-muted small fw-medium mb-0 me-1" style="font-size: 0.8rem;">Window:</label>
                        <select class="form-select form-select-sm shadow-none"
                                style="width: 130px; font-size: 0.82rem; height: 31px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                value="@_filterOptions.TimeWindow"
                                @onchange="OnTimeWindowChangedAsync">
                            <option value="@TimeWindowPreset.Last1Hour">Last 1 Hour</option>
                            <option value="@TimeWindowPreset.Last4Hours">Last 4 Hours</option>
                            <option value="@TimeWindowPreset.Last24Hours">Last 24 Hours</option>
                            <option value="@TimeWindowPreset.Last7Days">Last 7 Days</option>
                            <option value="@TimeWindowPreset.Last30Days">Last 30 Days</option>
                        </select>
                    </div>
                }

                <!-- Metric Selector -->
                <div class="d-flex align-items-center gap-1">
                    <label class="text-muted small fw-medium mb-0 me-1" style="font-size: 0.8rem;">Rank By:</label>
                    <select class="form-select form-select-sm shadow-none"
                            style="width: 160px; font-size: 0.82rem; height: 31px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                            value="@_filterOptions.Metric"
                            @onchange="OnMetricChangedAsync">
                        <option value="@RankingMetric.TotalCpu">Total CPU Time</option>
                        <option value="@RankingMetric.AvgCpu">Avg CPU Time</option>
                        <option value="@RankingMetric.TotalDuration">Total Duration</option>
                        <option value="@RankingMetric.AvgDuration">Avg Duration</option>
                        <option value="@RankingMetric.PhysicalReads">Physical Reads (Disk)</option>
                        <option value="@RankingMetric.LogicalReads">Logical Reads (Memory)</option>
                        <option value="@RankingMetric.LogicalWrites">Logical Writes</option>
                        <option value="@RankingMetric.ExecutionCount">Execution Count</option>
                    </select>
                </div>

                <!-- Top N Selector -->
                <div class="d-flex align-items-center gap-1">
                    <label class="text-muted small fw-medium mb-0 me-1" style="font-size: 0.8rem;">Top:</label>
                    <select class="form-select form-select-sm shadow-none"
                            style="width: 75px; font-size: 0.82rem; height: 31px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                            value="@_filterOptions.TopCount"
                            @onchange="OnTopCountChangedAsync">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <!-- Refresh Button -->
                <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1 shadow-sm px-2"
                        style="height: 31px;"
                        @onclick="RefreshAsync"
                        disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Loading...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>Refresh</span>
                    }
                </button>
            }

            @if (!IsPopout)
            {
                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center shadow-sm"
                        style="height: 31px; width: 31px;"
                        @onclick="OpenPopout"
                        data-bs-tooltip="true"
                        data-bs-placement="bottom"
                        data-bs-title="Open in dedicated popout window">
                    <i class="bi bi-box-arrow-up-right"></i>
                </button>
            }
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(_selectedDatabase))
    {
        <NoDatabaseBanner Height="calc(100vh - 120px)" Message="Select a server and database from the toolbar above to analyze top resource-consuming queries." />
    }
    else
    {
        <!-- Query Store Disabled Info Banner -->
        @if (_result != null && !_result.IsQueryStoreSupported && _result.StoreState == QueryStoreState.Disabled)
        {
            <div class="alert alert-warning d-flex align-items-center justify-content-between py-2 px-3 mb-2 rounded-2 border" style="font-size: 0.82rem;" role="alert">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0" style="font-size: 0.95rem; margin-top: 2px;"></i>
                    <div>
                        <strong>Historical tracking is disabled</strong> on <code>@_selectedDatabase</code>. Showing real-time live execution statistics instead.
                        To persist query performance history across time windows and server restarts, enable Query Store.
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-warning border-0 text-decoration-underline py-0 text-nowrap flex-shrink-0 ms-3"
                        @onclick="CopyEnableQueryStoreScriptAsync">
                    <i class="bi bi-clipboard me-1"></i>Copy Enable Script
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_result?.ErrorMessage))
        {
            <div class="alert alert-danger py-2 px-3 mb-2 rounded-2" style="font-size: 0.84rem;">
                <i class="bi bi-exclamation-circle me-1"></i>@_result.ErrorMessage
            </div>
        }

        <!-- MAIN SPLIT VIEW -->
        <div class="row g-2 flex-grow-1 overflow-hidden" style="min-height: 0;">
            <!-- LEFT COLUMN: LEADERBOARD LIST -->
            <div class="@(_isSidebarCollapsed ? "col-auto" : "col-12 col-lg-5 col-xl-4") d-flex flex-column h-100 overflow-hidden"
                 style="@(_isSidebarCollapsed ? "width: 64px; min-width: 64px; max-width: 64px;" : "")">
                <div class="card h-100 shadow-sm d-flex flex-column overflow-hidden" style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                    @if (_isSidebarCollapsed)
                    {
                        <!-- Collapsed: Expand Icon Header -->
                        <div class="p-2 border-bottom d-flex align-items-center justify-content-center" style="height: 47px; border-color: var(--app-border) !important;">
                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center"
                                    style="height: 31px; width: 31px;"
                                    data-bs-tooltip="true"
                                    data-bs-placement="right"
                                    data-bs-title="Expand leaderboard"
                                    @onclick="ToggleSidebarCollapseAsync">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        <!-- Collapsed: Ranking Number Badges -->
                        <div class="flex-grow-1 overflow-y-auto py-2 d-flex flex-column align-items-center custom-scrollbar-light" style="gap: 6px;">
                            @foreach (var query in FilteredQueries)
                            {
                                bool isSelected = _selectedItem == query;
                                string rankBadgeClass = query.Rank switch
                                {
                                    1 => "badge bg-danger text-white border-0",
                                    2 => "badge bg-warning text-dark border-0",
                                    3 => "badge bg-info text-white border-0",
                                    _ => "badge bg-secondary-subtle text-body border"
                                };

                                <button type="button"
                                        class="btn p-0 d-flex align-items-center justify-content-center transition-all flex-shrink-0"
                                        style="width: 36px; height: 24px; border: none; background: transparent;"
                                        data-bs-tooltip="true"
                                        data-bs-placement="right"
                                        data-bs-title="#@query.Rank: @query.DisplayObjectName (@query.FormattedTotalCpu CPU, @query.FormattedAvgDuration)"
                                        @onclick="() => SelectQueryAsync(query)">
                                    <span class="@rankBadgeClass d-flex align-items-center justify-content-center w-100 h-100 rounded-2"
                                          style="font-size: 0.68rem; font-weight: 700; padding: 0; @(isSelected ? "box-shadow: 0 0 0 2px var(--bs-primary);" : "")">
                                        #@query.Rank
                                    </span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Filter and List Header -->
                        <div class="p-2 border-bottom d-flex align-items-center gap-2" style="border-color: var(--app-border) !important;">
                            <div class="input-group input-group-sm flex-grow-1">
                                <span class="input-group-text border-end-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text"
                                       class="form-control shadow-none border-start-0"
                                       placeholder="Filter queries / procedures..."
                                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                                       @bind="_searchTerm"
                                       @bind:event="oninput" />
                                @if (!string.IsNullOrEmpty(_searchTerm))
                                {
                                    <button class="btn btn-outline-secondary border-start-0" style="background-color: var(--app-input-bg); color: var(--app-text-muted); border-color: var(--app-input-border);" @onclick="() => _searchTerm = string.Empty">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center flex-shrink-0 ms-1"
                                    style="height: 31px; width: 31px;"
                                    data-bs-tooltip="true"
                                    data-bs-placement="bottom"
                                    data-bs-title="Collapse leaderboard"
                                    @onclick="ToggleSidebarCollapseAsync">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </div>

                        <!-- Query List Items -->
                        <div class="flex-grow-1 overflow-y-auto p-2 d-flex flex-column gap-2 custom-scrollbar-light">
                            @if (_isLoading)
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center p-5 text-muted">
                                    <span class="spinner-border text-primary mb-2" role="status"></span>
                                    <span class="small">Analyzing query execution statistics...</span>
                                </div>
                            }
                            else if (!FilteredQueries.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center p-5 text-muted text-center">
                                    <i class="bi bi-check2-circle fs-1 mb-2 text-success"></i>
                                    <div class="fw-semibold small">No queries found</div>
                                    <div class="small" style="font-size: 0.76rem;">Try clearing the filter or expanding the time window.</div>
                                </div>
                            }
                            else
                            {
                                @foreach (var query in FilteredQueries)
                                {
                                    bool isSelected = _selectedItem == query;
                                    string rankBadgeClass = query.Rank switch
                                    {
                                        1 => "badge bg-danger text-white",
                                        2 => "badge bg-warning text-dark",
                                        3 => "badge bg-info text-white",
                                        _ => "badge bg-secondary-subtle text-body border"
                                    };

                                    <div class="query-card rounded-2 transition-all position-relative @(isSelected ? "selected-card" : "")"
                                         style="cursor: pointer; padding: 10px 12px; border: 1px solid @(isSelected ? "var(--bs-primary)" : "var(--app-border)"); background-color: @(isSelected ? "rgba(14, 165, 233, 0.08)" : "var(--app-surface-secondary)");"
                                         @onclick="() => SelectQueryAsync(query)">
                                        
                                        <!-- Top Row: Rank & Object Name / SQL Preview -->
                                        <div class="d-flex align-items-center gap-2 mb-1 text-truncate">
                                            <span class="@rankBadgeClass flex-shrink-0" style="font-size: 0.72rem; min-width: 26px; text-align: center;">#@query.Rank</span>
                                            <span class="fw-bold text-truncate" 
                                                  style="font-size: 0.82rem; color: var(--app-text);" 
                                                  title="@(query.IsAdHoc && !string.IsNullOrWhiteSpace(query.StatementText) ? query.StatementText : query.DisplayObjectName)">
                                                @query.DisplayObjectName
                                            </span>
                                        </div>

                                        <!-- Bottom Row: Primary Metrics -->
                                        <div class="d-flex align-items-center gap-3 text-muted" style="font-size: 0.74rem;">
                                            <span title="Total CPU Time"><i class="bi bi-cpu me-1 text-primary"></i><strong>@query.FormattedTotalCpu</strong></span>
                                            <span title="Avg Duration"><i class="bi bi-stopwatch me-1 text-warning"></i>@query.FormattedAvgDuration</span>
                                            <span title="Execution Count"><i class="bi bi-arrow-repeat me-1 text-success"></i>@SlowQueryItem.FormatNumber(query.ExecutionCount) execs</span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: QUERY INSPECTOR, CODE & METRICS -->
            <div class="@(_isSidebarCollapsed ? "col" : "col-12 col-lg-7 col-xl-8") d-flex flex-column h-100 overflow-hidden">
                @if (_selectedItem == null)
                {
                    <div class="card h-100 shadow-sm d-flex align-items-center justify-content-center p-5 text-muted text-center" style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                        <i class="bi bi-cursor-fill fs-1 text-muted mb-2"></i>
                        <h5 class="fw-bold">Select a Query from the Leaderboard</h5>
                        <p class="small mb-0">Click any query on the left to inspect its formatted SQL, performance metrics, and execution history.</p>
                    </div>
                }
                else
                {
                    <div class="card h-100 shadow-sm d-flex flex-column overflow-hidden" style="background-color: var(--app-surface); border: 1px solid var(--app-border);">
                        <!-- Action Bar Header -->
                        <div class="p-2 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-color: var(--app-border) !important; background-color: var(--app-surface-secondary);">
                            <div class="d-flex align-items-center gap-2 text-truncate" style="max-width: 60%;">
                                <span class="badge bg-primary text-white flex-shrink-0" style="font-size: 0.78rem;">#@_selectedItem.Rank</span>
                                <span class="fw-bold text-truncate" 
                                      style="font-size: 0.88rem; color: var(--app-text);" 
                                      title="@(_selectedItem.IsAdHoc && !string.IsNullOrWhiteSpace(_selectedItem.StatementText) ? _selectedItem.StatementText : _selectedItem.DisplayObjectName)">
                                    @_selectedItem.DisplayObjectName
                                </span>
                                @if (_selectedItem.IsAdHoc)
                                {
                                    <span class="badge bg-secondary-subtle text-muted border flex-shrink-0" style="font-size: 0.68rem;">Ad-hoc</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle flex-shrink-0" style="font-size: 0.68rem;">Stored Procedure</span>
                                }
                            </div>

                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <!-- Statement vs Full Batch Toggle -->
                                @if (!string.IsNullOrWhiteSpace(_selectedItem.FullBatchText) && _selectedItem.FullBatchText != _selectedItem.StatementText)
                                {
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <button type="button"
                                                class="btn btn-sm @(!_showFullBatch ? "btn-primary text-white" : "btn-outline-secondary") px-2 py-1"
                                                style="font-size: 0.75rem;"
                                                @onclick="() => ToggleBatchViewAsync(false)">
                                            Statement
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm @(_showFullBatch ? "btn-primary text-white" : "btn-outline-secondary") px-2 py-1"
                                                style="font-size: 0.75rem;"
                                                @onclick="() => ToggleBatchViewAsync(true)">
                                            Full Batch
                                        </button>
                                    </div>
                                }

                                <!-- Copy SQL -->
                                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center shadow-sm"
                                        style="height: 31px; width: 31px;"
                                        @onclick="CopySqlAsync"
                                        data-bs-tooltip="true"
                                        data-bs-placement="bottom"
                                        data-bs-title="@(_copyFeedback ? "Copied!" : "Copy SQL")">
                                    <i class="bi @(_copyFeedback ? "bi-check2 text-success" : "bi-clipboard")"></i>
                                </button>

                                <!-- Export .sqlplan / View Plan -->
                                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center shadow-sm"
                                        style="height: 31px; width: 31px;"
                                        @onclick="DownloadExecutionPlanAsync"
                                        disabled="@_isLoadingPlan"
                                        data-bs-tooltip="true"
                                        data-bs-placement="bottom"
                                        data-bs-title="Export Execution Plan (.sqlplan)">
                                    @if (_isLoadingPlan)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status" style="width: 0.85rem; height: 0.85rem;"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark-code"></i>
                                    }
                                </button>

                                <!-- 1-CLICK OPEN IN QUERY RUNNER -->
                                <button class="btn btn-sm btn-success d-inline-flex align-items-center justify-content-center shadow-sm"
                                        style="height: 31px; width: 31px;"
                                        @onclick="OpenInQueryRunnerAsync"
                                        data-bs-tooltip="true"
                                        data-bs-placement="bottom"
                                        data-bs-title="Open in Query Runner">
                                    <i class="bi bi-play-fill fs-6"></i>
                                </button>

                                <!-- Expand to Full-Width Code Popup (Result Grid Style) -->
                                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center shadow-sm"
                                        style="height: 31px; width: 31px;"
                                        @onclick="OpenSqlPopup"
                                        data-bs-tooltip="true"
                                        data-bs-placement="bottom"
                                        data-bs-title="Expand code viewer to full screen">
                                    <i class="bi bi-arrows-angle-expand"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Scrollable Inspector Content -->
                        <div class="flex-grow-1 overflow-y-auto p-3 d-flex flex-column gap-3 custom-scrollbar-light">
                            <!-- MONACO CODE VIEWER -->
                            <div class="rounded-2 overflow-hidden border" style="height: 240px; min-height: 180px; border-color: var(--app-border) !important;">
                                <StandaloneCodeEditor @ref="_monacoEditor"
                                                      Id="slow-query-monaco"
                                                      CssClass="w-100 h-100"
                                                      ConstructionOptions="EditorConstructionOptions"
                                                      OnDidInit="OnMonacoInitAsync" />
                            </div>

                            <!-- PERFORMANCE METRICS STATS CARDS (5 KEY RESOURCE METRICS) -->
                            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-2">
                                <!-- CPU Card -->
                                <div class="col">
                                    <div class="metric-card p-2 rounded-2 border h-100" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                        <div class="text-muted small text-truncate" style="font-size: 0.72rem;">
                                            <i class="bi bi-cpu text-primary me-1"></i>Total CPU
                                        </div>
                                        <div class="d-flex align-items-baseline gap-1 flex-wrap text-truncate mt-1">
                                            <span class="fw-bold" style="color: var(--app-text); font-size: 0.92rem;">@_selectedItem.FormattedTotalCpu</span>
                                            <span class="text-muted opacity-50" style="font-size: 0.75rem;">|</span>
                                            <span class="text-muted text-truncate" style="font-size: 0.72rem;">Avg: @_selectedItem.FormattedAvgCpu</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Duration Card -->
                                <div class="col">
                                    <div class="metric-card p-2 rounded-2 border h-100" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                        <div class="text-muted small text-truncate" style="font-size: 0.72rem;">
                                            <i class="bi bi-stopwatch text-warning me-1"></i>Total Duration
                                        </div>
                                        <div class="d-flex align-items-baseline gap-1 flex-wrap text-truncate mt-1">
                                            <span class="fw-bold" style="color: var(--app-text); font-size: 0.92rem;">@_selectedItem.FormattedTotalDuration</span>
                                            <span class="text-muted opacity-50" style="font-size: 0.75rem;">|</span>
                                            <span class="text-muted text-truncate" style="font-size: 0.72rem;">Avg: @_selectedItem.FormattedAvgDuration</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Physical Reads Card -->
                                <div class="col">
                                    <div class="metric-card p-2 rounded-2 border h-100" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                        <div class="text-muted small text-truncate" style="font-size: 0.72rem;">
                                            <i class="bi bi-hdd text-danger me-1"></i>Physical Reads
                                        </div>
                                        <div class="d-flex align-items-baseline gap-1 flex-wrap text-truncate mt-1">
                                            <span class="fw-bold" style="color: var(--app-text); font-size: 0.92rem;">@SlowQueryItem.FormatNumber(_selectedItem.TotalPhysicalReads)</span>
                                            <span class="text-muted opacity-50" style="font-size: 0.75rem;">|</span>
                                            <span class="text-muted text-truncate" style="font-size: 0.72rem;">Avg: @SlowQueryItem.FormatNumber(_selectedItem.AvgPhysicalReads)</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Logical Reads Card -->
                                <div class="col">
                                    <div class="metric-card p-2 rounded-2 border h-100" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                        <div class="text-muted small text-truncate" style="font-size: 0.72rem;">
                                            <i class="bi bi-memory text-info me-1"></i>Logical Reads
                                        </div>
                                        <div class="d-flex align-items-baseline gap-1 flex-wrap text-truncate mt-1">
                                            <span class="fw-bold" style="color: var(--app-text); font-size: 0.92rem;">@SlowQueryItem.FormatNumber(_selectedItem.TotalLogicalReads)</span>
                                            <span class="text-muted opacity-50" style="font-size: 0.75rem;">|</span>
                                            <span class="text-muted text-truncate" style="font-size: 0.72rem;">Avg: @SlowQueryItem.FormatNumber(_selectedItem.AvgLogicalReads)</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Logical Writes Card -->
                                <div class="col">
                                    <div class="metric-card p-2 rounded-2 border h-100" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                        <div class="text-muted small text-truncate" style="font-size: 0.72rem;">
                                            <i class="bi bi-pencil-square text-secondary me-1"></i>Writes
                                        </div>
                                        <div class="d-flex align-items-baseline gap-1 flex-wrap text-truncate mt-1">
                                            <span class="fw-bold" style="color: var(--app-text); font-size: 0.92rem;">@SlowQueryItem.FormatNumber(_selectedItem.TotalLogicalWrites)</span>
                                            <span class="text-muted opacity-50" style="font-size: 0.75rem;">|</span>
                                            <span class="text-muted text-truncate" style="font-size: 0.72rem;">Avg: @SlowQueryItem.FormatNumber(_selectedItem.AvgLogicalWrites)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- EXECUTION TRENDS (QUERY STORE MODE) -->
                            @if (_result != null && _result.IsUsingQueryStore)
                            {
                                <div class="card rounded-2 border shadow-none" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important; padding: 0.6rem 0.85rem;">
                                    @if (_isLoadingTrends)
                                    {
                                        <div class="d-flex align-items-center justify-content-center p-3 text-muted">
                                            <span class="spinner-border spinner-border-sm me-2 text-primary" role="status"></span>
                                            <span class="small">Loading activity timeline...</span>
                                        </div>
                                    }
                                    else if (!_trends.Any())
                                    {
                                        <div class="text-muted small text-center p-2">
                                            No runtime interval history found for this query in the selected window.
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Trends Header with Metric Pills & Hover State -->
                                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                            <!-- Left: Hover info or summary -->
                                            <div class="d-flex align-items-center gap-2 flex-wrap" style="font-size: 0.74rem; min-height: 22px;">
                                                @if (_hoveredTrendIndex.HasValue && _hoveredTrendIndex.Value >= 0 && _hoveredTrendIndex.Value < _trends.Count)
                                                {
                                                    var ht = _trends[_hoveredTrendIndex.Value];
                                                    <span class="badge bg-dark border text-light fw-normal py-1 px-2" style="border-color: var(--app-border) !important; font-size: 0.7rem;">
                                                        <i class="bi bi-clock me-1"></i>@ht.IntervalStart.ToString("MMM dd HH:mm") - @ht.IntervalEnd.ToString("HH:mm")
                                                    </span>
                                                    <span style="color: #38bdf8;"><strong>@ht.Executions.ToString("N0")</strong> execs</span>
                                                    <span class="text-muted">·</span>
                                                    <span style="color: #fbbf24;"><strong>@SlowQueryItem.FormatDuration(ht.AvgDurationMs)</strong> avg dur</span>
                                                    <span class="text-muted">·</span>
                                                    <span style="color: #c084fc;"><strong>@SlowQueryItem.FormatDuration(ht.AvgCpuMs)</strong> avg cpu</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold small" style="color: var(--app-text); font-size: 0.76rem;">
                                                        Trend
                                                    </span>
                                                    <span class="text-muted small" style="font-size: 0.7rem;">
                                                        (@GetTrendMetricSummary())
                                                    </span>
                                                }
                                            </div>

                                            <!-- Right: Metric Toggle Pills (Azure-style, Compact) -->
                                            <div class="d-inline-flex align-items-center rounded-pill border" style="background-color: var(--app-surface); border-color: var(--app-border) !important; padding: 1.5px; gap: 1px;">
                                                <button type="button" 
                                                        class="btn rounded-pill border-0 transition-all @(_selectedTrendMetric == TrendMetric.Executions ? "fw-bold shadow-sm text-white" : "text-muted")"
                                                        style="font-size: 0.67rem; line-height: 1.15; padding: 2px 7px; @(_selectedTrendMetric == TrendMetric.Executions ? "background-color: #0284c7;" : "background: transparent;")"
                                                        @onclick="() => _selectedTrendMetric = TrendMetric.Executions">
                                                    Executions
                                                </button>
                                                <button type="button" 
                                                        class="btn rounded-pill border-0 transition-all @(_selectedTrendMetric == TrendMetric.Duration ? "fw-bold shadow-sm text-white" : "text-muted")"
                                                        style="font-size: 0.67rem; line-height: 1.15; padding: 2px 7px; @(_selectedTrendMetric == TrendMetric.Duration ? "background-color: #d97706;" : "background: transparent;")"
                                                        @onclick="() => _selectedTrendMetric = TrendMetric.Duration">
                                                    Avg Duration
                                                </button>
                                                <button type="button" 
                                                        class="btn rounded-pill border-0 transition-all @(_selectedTrendMetric == TrendMetric.Cpu ? "fw-bold shadow-sm text-white" : "text-muted")"
                                                        style="font-size: 0.67rem; line-height: 1.15; padding: 2px 7px; @(_selectedTrendMetric == TrendMetric.Cpu ? "background-color: #7c3aed;" : "background: transparent;")"
                                                        @onclick="() => _selectedTrendMetric = TrendMetric.Cpu">
                                                    Avg CPU
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Azure-Style Gradient Area Chart (SVG) -->
                                        var points = GetTrendPoints();
                                        string linePath = GetSmoothSvgPath(points);
                                        string areaPath = GetSmoothAreaPath(points);
                                        string strokeColor = GetTrendMetricColor();
                                        string gradientStart = GetTrendGradientStart();
                                        string gradientId = $"azureTrendGrad_{_selectedTrendMetric}";

                                        <div class="position-relative w-100" style="height: 75px;">
                                            <svg viewBox="0 0 1000 120" 
                                                 preserveAspectRatio="none" 
                                                 style="width: 100%; height: 100%; display: block; overflow: visible;"
                                                 @onmouseleave="() => _hoveredTrendIndex = null">
                                                
                                                <defs>
                                                    <linearGradient id="@gradientId" x1="0" y1="0" x2="0" y2="1">
                                                        <stop offset="0%" stop-color="@gradientStart" stop-opacity="0.45" />
                                                        <stop offset="65%" stop-color="@gradientStart" stop-opacity="0.12" />
                                                        <stop offset="100%" stop-color="@gradientStart" stop-opacity="0.0" />
                                                    </linearGradient>
                                                </defs>

                                                <!-- Horizontal Guidelines -->
                                                <line x1="0" y1="25" x2="1000" y2="25" stroke="var(--app-border)" stroke-dasharray="4,4" stroke-opacity="0.5" stroke-width="1" />
                                                <line x1="0" y1="65" x2="1000" y2="65" stroke="var(--app-border)" stroke-dasharray="4,4" stroke-opacity="0.5" stroke-width="1" />
                                                <line x1="0" y1="108" x2="1000" y2="108" stroke="var(--app-border)" stroke-opacity="0.8" stroke-width="1" />

                                                <!-- Area Fill -->
                                                @if (!string.IsNullOrEmpty(areaPath))
                                                {
                                                    <path d="@areaPath" fill="url(#@gradientId)" />
                                                }

                                                <!-- Top Curve Line -->
                                                @if (!string.IsNullOrEmpty(linePath))
                                                {
                                                    <path d="@linePath" fill="none" stroke="@strokeColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                                                }

                                                <!-- Interactive Crosshair & Indicator Point -->
                                                @if (_hoveredTrendIndex.HasValue && _hoveredTrendIndex.Value >= 0 && _hoveredTrendIndex.Value < _trends.Count)
                                                {
                                                    int hIdx = _hoveredTrendIndex.Value;
                                                    double hX = _trends.Count == 1 ? 500.0 : (hIdx / (double)(_trends.Count - 1)) * 1000.0;
                                                    double hY = points.Count > hIdx ? points[hIdx].Y : 108.0;

                                                    <!-- Vertical Crosshair Line -->
                                                    <line x1="@hX.ToString("F1", CultureInfo.InvariantCulture)" 
                                                          y1="10" 
                                                          x2="@hX.ToString("F1", CultureInfo.InvariantCulture)" 
                                                          y2="108" 
                                                          stroke="@strokeColor" 
                                                          stroke-width="1.5" 
                                                          stroke-dasharray="3,3" 
                                                          opacity="0.85" />

                                                    <!-- Highlight Halo & Dot -->
                                                    <circle cx="@hX.ToString("F1", CultureInfo.InvariantCulture)" 
                                                            cy="@hY.ToString("F1", CultureInfo.InvariantCulture)" 
                                                            r="8" 
                                                            fill="@strokeColor" 
                                                            opacity="0.25" />
                                                    <circle cx="@hX.ToString("F1", CultureInfo.InvariantCulture)" 
                                                            cy="@hY.ToString("F1", CultureInfo.InvariantCulture)" 
                                                            r="4.5" 
                                                            fill="@strokeColor" 
                                                            stroke="#ffffff" 
                                                            stroke-width="2" />
                                                }

                                                <!-- Transparent Hover Hit Columns -->
                                                @for (int i = 0; i < _trends.Count; i++)
                                                {
                                                    int idx = i;
                                                    double colW = 1000.0 / Math.Max(1, _trends.Count);
                                                    double colX = i * colW;
                                                    <rect x="@colX.ToString("F1", CultureInfo.InvariantCulture)"
                                                          y="0"
                                                          width="@colW.ToString("F1", CultureInfo.InvariantCulture)"
                                                          height="120"
                                                          fill="transparent"
                                                          style="cursor: crosshair;"
                                                          @onmouseenter="() => _hoveredTrendIndex = idx" />
                                                }
                                            </svg>
                                        </div>

                                        <!-- Clean X-Axis Time Markers -->
                                        <div class="d-flex align-items-center justify-content-between mt-1 text-muted" style="font-size: 0.7rem;">
                                            <span>@_trends.First().IntervalStart.ToString("MMM dd, HH:mm")</span>
                                            @if (_trends.Count >= 3)
                                            {
                                                <span>@_trends[_trends.Count / 2].IntervalStart.ToString("MMM dd, HH:mm")</span>
                                            }
                                            <span>@_trends.Last().IntervalEnd.ToString("MMM dd, HH:mm")</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="card rounded-2 border shadow-none" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important; padding: 10px 14px;">
                                    <div class="d-flex align-items-center justify-content-between text-muted" style="font-size: 0.76rem;">
                                        <span><i class="bi bi-clock-history me-1"></i>First Seen in Cache: @(_selectedItem.FirstSeen?.ToString("g") ?? "N/A")</span>
                                        <span><i class="bi bi-arrow-clockwise me-1"></i>Last Executed: @(_selectedItem.LastExecutionTime?.ToString("g") ?? "N/A")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- MODE EXPLANATION MODAL -->
@if (_showModeHelpModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1060;" @onclick="() => _showModeHelpModal = false">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;" @onclick:stopPropagation="true">
            <div class="modal-content shadow-lg border" style="background-color: var(--app-surface); border-color: var(--app-border) !important; color: var(--app-text);">
                <div class="modal-header border-bottom py-2 px-3" style="border-color: var(--app-border) !important;">
                    <h5 class="modal-title fw-bold fs-6 d-flex align-items-center gap-2 mb-0">
                        <i class="bi bi-info-circle-fill text-primary"></i>
                        <span>Query Analysis Modes Explained</span>
                    </h5>
                    <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "") shadow-none" @onclick="() => _showModeHelpModal = false"></button>
                </div>
                <div class="modal-body p-3 d-flex flex-column gap-2" style="font-size: 0.85rem; line-height: 1.5;">
                    <!-- Query Store Card -->
                    <div class="p-2.5 p-3 rounded-3 border" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                <i class="bi bi-clock-history me-1"></i>Historical (Time Range)
                            </span>
                            <span class="text-muted" style="font-size: 0.76rem;">Powered by Query Store</span>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 0.82rem;">
                            Analyzes persistent execution history across specific time windows (survives SQL Server restarts) with activity timeline trends.
                        </p>
                    </div>

                    <!-- Live Plan Cache Card -->
                    <div class="p-2.5 p-3 rounded-3 border" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                <i class="bi bi-lightning-charge me-1"></i>Live / Real-Time
                            </span>
                            <span class="text-muted" style="font-size: 0.76rem;">Powered by Active Plan Cache</span>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 0.82rem;">
                            Inspects active compiled queries currently in memory (RAM) for immediate resource stats without needing Query Store. Resets on restart.
                        </p>
                    </div>
                </div>
                <div class="modal-footer border-top py-2 px-3" style="border-color: var(--app-border) !important;">
                    <button type="button" class="btn btn-sm btn-primary px-3" @onclick="() => _showModeHelpModal = false">
                        Got it
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- PURE SQL CODE VIEWER POPUP MODAL (RESULT GRID STYLE) -->
@if (_isSqlPopupOpen && _selectedItem != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 1070;" @onclick="CloseSqlPopup" @onkeydown="HandlePopupKeyDown">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 92vw; height: 90vh;" @onclick:stopPropagation="true">
            <div class="modal-content shadow-lg h-100 flex-column d-flex" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <!-- Modal Header -->
                <div class="modal-header py-2 px-3 flex-shrink-0 d-flex align-items-center justify-content-between" style="border-bottom: 1px solid var(--app-border); background-color: var(--app-surface-secondary);">
                    <div class="d-flex align-items-center gap-2 text-truncate me-2" style="max-width: 60%;">
                        <span class="badge bg-primary text-white flex-shrink-0" style="font-size: 0.78rem;">#@_selectedItem.Rank</span>
                        <span class="fw-bold text-truncate" style="font-size: 0.95rem; color: var(--app-text);" title="@(_selectedItem.IsAdHoc && !string.IsNullOrWhiteSpace(_selectedItem.StatementText) ? _selectedItem.StatementText : _selectedItem.DisplayObjectName)">
                            @_selectedItem.DisplayObjectName
                        </span>
                        @if (_selectedItem.IsAdHoc)
                        {
                            <span class="badge bg-secondary-subtle text-muted border flex-shrink-0" style="font-size: 0.68rem;">Ad-hoc</span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle flex-shrink-0" style="font-size: 0.68rem;">Stored Procedure</span>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Statement vs Full Batch Toggle -->
                        @if (!string.IsNullOrWhiteSpace(_selectedItem.FullBatchText) && _selectedItem.FullBatchText != _selectedItem.StatementText)
                        {
                            <div class="btn-group btn-group-sm shadow-sm" role="group">
                                <button type="button"
                                        class="btn btn-sm @(!_showFullBatch ? "btn-primary text-white" : "btn-outline-secondary") px-2 py-1"
                                        style="font-size: 0.75rem;"
                                        @onclick="() => ToggleBatchViewAsync(false)">
                                    Statement
                                </button>
                                <button type="button"
                                        class="btn btn-sm @(_showFullBatch ? "btn-primary text-white" : "btn-outline-secondary") px-2 py-1"
                                        style="font-size: 0.75rem;"
                                        @onclick="() => ToggleBatchViewAsync(true)">
                                    Full Batch
                                </button>
                            </div>
                        }

                        <!-- Copy SQL -->
                        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1"
                                style="height: 31px;"
                                @onclick="CopySqlAsync"
                                title="@(_copyFeedback ? "Copied!" : "Copy SQL")">
                            <i class="bi @(_copyFeedback ? "bi-check2 text-success" : "bi-clipboard")"></i>
                            <span style="font-size: 0.78rem;">@(_copyFeedback ? "Copied" : "Copy SQL")</span>
                        </button>

                        <!-- Open in Query Runner -->
                        <button class="btn btn-sm btn-success d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1"
                                style="height: 31px;"
                                @onclick="OpenInQueryRunnerAsync"
                                title="Open in Query Runner">
                            <i class="bi bi-play-fill fs-6"></i>
                            <span style="font-size: 0.78rem;">Open in Query Runner</span>
                        </button>

                        <!-- Close Button -->
                        <button type="button" 
                                class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "") m-0 ms-1 shadow-none" 
                                aria-label="Close" 
                                @onclick="CloseSqlPopup"></button>
                    </div>
                </div>

                <!-- Modal Body with Full-Height Monaco Editor -->
                <div class="modal-body p-0 flex-grow-1 position-relative" style="min-height: 0;">
                    <StandaloneCodeEditor @ref="_popupMonacoEditor"
