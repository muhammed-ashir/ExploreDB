@page "/explorer"
@using ExploreDB.Services
@inject SchemaService SchemaService
@inject NavigationManager Nav
@implements IDisposable

@if (SchemaService.IsLoading)
{
    <LoadingSpinner Height="calc(100vh - 100px)" Message="Loading tables..." />
}
else if (!SchemaService.IsDatabaseConnected)
{
    <NoDatabaseBanner Height="calc(100vh - 100px)" />
}
else
{
<div class="container-fluid">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0">Table Explorer</h2>
        </div>
        <div class="col-auto text-end">
            <div class="d-flex justify-content-end align-items-center gap-2 mb-2">
                <label class="text-muted small mb-0">Show</label>
                <div class="position-relative">
                    <div class="form-control form-control-sm bg-dark text-white border-secondary shadow-sm cursor-pointer d-flex justify-content-between align-items-center" style="width: 75px;" @onclick="() => IsPageSizeDropdownOpen = !IsPageSizeDropdownOpen">
                        <span>@_pageSize</span>
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                    </div>
                    @if (IsPageSizeDropdownOpen)
                    {
                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsPageSizeDropdownOpen = false"></div>
                        <div class="dropdown-menu show bg-dark border-secondary shadow-lg p-1 mt-1" style="position: absolute; top: 100%; right: 0; z-index: 1050; min-width: 75px;">
                            @foreach (var size in new[] { 12, 24, 48, 96 })
                            {
                                <button class="dropdown-item text-white py-1 @(_pageSize == size ? "bg-primary" : "")" type="button" @onclick="() => { SetPageSize(size); IsPageSizeDropdownOpen = false; }">
                                    @size
                                </button>
                            }
                        </div>
                    }
                </div>
                <label class="text-muted small mb-0">per page</label>
            </div>
            <div class="text-muted small">
                Showing @PagedTables.Count() of @FilteredTables.Count() tables
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group shadow-sm flex-nowrap">
                <input type="text" 
                       class="form-control bg-dark text-white border-secondary" style="min-width: 200px;" 
                       placeholder="Search tables..." 
                       @bind="SearchTerm" 
                       @bind:event="oninput" />
                <button class="btn @(CaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => CaseSensitive = !CaseSensitive">
                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                </button>
                <button class="btn @(MatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { MatchWholeWord = !MatchWholeWord; if (MatchWholeWord) ExactMatch = false; }">
                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                </button>
                <button class="btn @(ExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { ExactMatch = !ExactMatch; if (ExactMatch) MatchWholeWord = false; }">
                    <i class="bi bi-bullseye fs-6"></i>
                </button>
            </div>
        </div>

    </div>

    <div class="row">
        @if (SchemaService.Tables.Count == 0)
        {
            <div class="col-12">
                <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                    <div class="text-muted">No tables found.</div>
                </div>
            </div>
        }
        else if (!FilteredTables.Any())
        {
            <div class="col-12">
                <div class="d-flex justify-content-center align-items-center bg-transparent rounded overflow-hidden position-relative" style="padding: 3rem 1rem; width: 100%; border: 1px solid #444;">
                    <div class="text-muted">No matching tables found. Try a different search term.</div>
                </div>
            </div>
        }
        else
        {
            @foreach (var table in PagedTables)
            {
                <div class="col-12 col-xl-6 mb-3">
                    <a href="table/@Uri.EscapeDataString(table.FullName)" class="text-decoration-none"
                       data-bs-tooltip="true" data-bs-html="true" data-bs-title="<b>Type:</b> Table<br/><b>Name:</b> @table.Name<br/><b>Schema:</b> @table.Schema.ToLower()" data-bs-placement="bottom">
                        <div class="card glass-card text-white node-card h-100 py-3 px-4 d-flex flex-row align-items-center justify-content-between transition-transform hover-scale">
                            <div class="d-flex align-items-center gap-3 overflow-hidden w-100">
                                <div class="text-primary fs-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px;">
                                    <i class="bi bi-table"></i>
                                </div>
                                <div class="overflow-hidden" style="min-width: 0;">
                                    <h5 class="mb-1 fw-bold text-white text-truncate" style="letter-spacing: 0.5px;">@table.Name</h5>
                                    <small class="text-muted fw-bold text-truncate d-block" style="font-size: 0.7em; letter-spacing: 1px;">SCHEMA: <span class="text-lowercase">@table.Schema</span></small>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }

            @if (TotalPages > 1)
            {
                <div class="col-12 mt-4 d-flex justify-content-center">
                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                <button class="page-link bg-dark text-white border-secondary" @onclick="() => SetPage(CurrentPage - 1)">Previous</button>
                            </li>
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNum = i;
                                if (TotalPages > 10 && (pageNum > 2 && pageNum < TotalPages - 1 && Math.Abs(pageNum - CurrentPage) > 2))
                                {
                                    if (pageNum == CurrentPage - 3 || pageNum == CurrentPage + 3)
                                    {
                                        <li class="page-item disabled"><span class="page-link bg-dark text-white border-secondary">...</span></li>
                                    }
                                    continue;
                                }
                                <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                                    <button class="page-link @(pageNum == CurrentPage ? "bg-primary border-primary" : "bg-dark text-white border-secondary")" @onclick="() => SetPage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link bg-dark text-white border-secondary" @onclick="() => SetPage(CurrentPage + 1)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
}

@code {
    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            CurrentPage = 1;
        }
    }
    private bool ExactMatch = false;
    private bool MatchWholeWord = false;
    private bool CaseSensitive = false;

    private int _pageSize = 24;
    private bool IsPageSizeDropdownOpen = false;
    private int CurrentPage = 1;

    private void SetPageSize(int size)
    {
        _pageSize = size;
        CurrentPage = 1;
    }

    private int TotalPages => (int)Math.Ceiling(FilteredTables.Count() / (double)_pageSize);
    private IEnumerable<TableInfo> PagedTables => FilteredTables.Skip((CurrentPage - 1) * _pageSize).Take(_pageSize);

    private IEnumerable<TableInfo> FilteredTables
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return SchemaService.Tables;

            var searchTerm = CaseSensitive ? SearchTerm : SearchTerm.ToLower();

            return SchemaService.Tables.Where(t =>
            {
                var tableName = CaseSensitive ? t.Name : t.Name.ToLower();
                var schemaName = CaseSensitive ? t.Schema : t.Schema.ToLower();

                if (ExactMatch)
                {
                    // Exact match: entire name must match search term
                    return tableName == searchTerm || schemaName == searchTerm;
                }
                else if (MatchWholeWord)
                {
                    return tableName.Split(' ', '.', '_').Contains(searchTerm) ||
                           schemaName.Split(' ', '.', '_').Contains(searchTerm);
                }
                else
                {
                    return tableName.Contains(searchTerm) || schemaName.Contains(searchTerm);
                }
            });
        }
    }

    protected override void OnInitialized()
    {
        SchemaService.OnSchemaLoaded += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SetPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    public void Dispose()
    {
        SchemaService.OnSchemaLoaded -= Refresh;
    }
}
