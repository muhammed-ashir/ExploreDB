    private void HandleDatabaseSwitched()
    {
        InvokeAsync(() =>
        {
            if (Profiler.IsStreaming && !Profiler.IsDemoMode)
            {
                _statusMessage = $"Sidebar database switched to '{SchemaService.ActiveDatabase}'. (Active trace is profiling '{_sessionConfig.Filters.DatabaseName}').";
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        ConnectionService.OnConnectionChanged -= HandleConnectionChanged;
        ConnectionService.OnDatabaseSwitched -= HandleDatabaseSwitched;
        Profiler.EventsBatchAvailable -= HandleNewEventsBatch;
        Profiler.MetricsUpdated -= HandleMetricsUpdated;
        Profiler.StatusChanged -= HandleStatusChanged;
        Profiler.ErrorOccurred -= HandleErrorOccurred;

        if (IsPopout && Profiler.IsStreaming)
        {
            _ = Profiler.StopAsync();
        }
    }
