    private void ApplyFilter()
    {
        IEnumerable<TraceEvent> query = _events;

        // Apply preset
        query = _activePreset switch
        {
            PresetType.Slow => query.Where(e => e.DurationMilliseconds >= 200),
            PresetType.ErrorsDeadlocks => query.Where(e => e.EventType == TraceEventType.ErrorReported || e.EventType == TraceEventType.Deadlock),
            PresetType.HighReads => query.Where(e => e.LogicalReads >= 5000),
            PresetType.RpcOnly => query.Where(e => e.EventType == TraceEventType.RpcCompleted),
            _ => query
        };

        // Apply text filter
        if (!string.IsNullOrWhiteSpace(_filterText))
        {
            string search = _filterText.Trim();
            query = query.Where(e =>
                (e.TextData != null && e.TextData.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (e.SummaryText.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (e.DatabaseName != null && e.DatabaseName.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (e.ClientAppName != null && e.ClientAppName.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (e.ClientHostName != null && e.ClientHostName.Contains(search, StringComparison.OrdinalIgnoreCase)) ||
                (e.Spid.HasValue && e.Spid.Value.ToString().Contains(search)));
        }

        _filteredEvents = query.ToList();
    }

    private async Task SelectEvent(TraceEvent evt)
    {
        _selectedEvent = evt;
        _selectedAggregate = null;

        if (evt.EventType == TraceEventType.Deadlock || evt.EventType == TraceEventType.ErrorReported)
        {
            _activeInspectorTab = InspectorTab.ErrorOrDeadlock;
        }
        else
        {
            _activeInspectorTab = InspectorTab.Sql;
        }

        await UpdateMonacoTextAsync(CurrentInspectorSql);
    }

    private async Task SelectAggregate(QueryAggregate agg)
    {
        _selectedAggregate = agg;
        _selectedEvent = null;
        _activeInspectorTab = InspectorTab.Sql;

        await UpdateMonacoTextAsync(agg.NormalizedText);
    }

    private void SortAggregates(AggregateSortColumn column)
    {
        if (_aggregateSortCol == column)
        {
            _aggregateSortAsc = !_aggregateSortAsc;
        }
        else
        {
            _aggregateSortCol = column;
            _aggregateSortAsc = false;
        }

        SortAggregatesList();
    }

    private void SortAggregatesList()
    {
        _sortedAggregates = _aggregateSortCol switch
        {
            AggregateSortColumn.Count => _aggregateSortAsc ? _aggregatesList.OrderBy(a => a.ExecutionCount).ToList() : _aggregatesList.OrderByDescending(a => a.ExecutionCount).ToList(),
            AggregateSortColumn.AvgDuration => _aggregateSortAsc ? _aggregatesList.OrderBy(a => a.AvgDurationMs).ToList() : _aggregatesList.OrderByDescending(a => a.AvgDurationMs).ToList(),
            AggregateSortColumn.MaxDuration => _aggregateSortAsc ? _aggregatesList.OrderBy(a => a.MaxDurationMs).ToList() : _aggregatesList.OrderByDescending(a => a.MaxDurationMs).ToList(),
            AggregateSortColumn.TotalDuration => _aggregateSortAsc ? _aggregatesList.OrderBy(a => a.TotalDurationMs).ToList() : _aggregatesList.OrderByDescending(a => a.TotalDurationMs).ToList(),
            AggregateSortColumn.TotalReads => _aggregateSortAsc ? _aggregatesList.OrderBy(a => a.TotalLogicalReads).ToList() : _aggregatesList.OrderByDescending(a => a.TotalLogicalReads).ToList(),
            _ => _aggregatesList.OrderByDescending(a => a.ExecutionCount).ToList()
        };
    }

    private string GetSortIndicator(AggregateSortColumn col)
    {
        if (_aggregateSortCol != col) return "";
        return _aggregateSortAsc ? "▲" : "▼";
    }

