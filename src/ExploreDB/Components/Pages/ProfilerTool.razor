    private async Task StartTraceAsync()
    {
        if (!CanStartLiveTrace) return;

        _errorMessage = null;
        _sessionConfig.ConnectionString = ConnectionService.ConnectionString;
        _sessionConfig.Filters.DatabaseName = SchemaService.ActiveDatabase;
        _sessionConfig.MaxEventBufferSize = _bufferCapacityChoice;

        var (success, error) = await Profiler.StartAsync(_sessionConfig);
        if (!success)
        {
            _errorMessage = error;
        }
    }

