            }
            catch { }
        }
    }

    private async Task OpenInQueryEditor()
    {
        string sql = CurrentInspectorSql;
        if (string.IsNullOrEmpty(sql)) return;

        string tabName = _selectedEvent != null
            ? $"Trace_Event_{_selectedEvent.Id}_{DateTime.Now:HHmmss}.sql"
            : $"TraceQuery_{DateTime.Now:HHmmss}.sql";

        var newTab = new QueryTab
        {
            Id = Guid.NewGuid(),
            Name = tabName,
            Content = sql,
            OriginalContent = sql,
            ConnectionString = ConnectionService.ConnectionString
        };

        QueryStateService.Tabs.Add(newTab);
        QueryStateService.ActiveTabId = newTab.Id;
        QueryStateService.NotifyTabUpdated(newTab.Id);
        await QueryStateService.SaveTabsAsync();

        if (IsPopout)
        {
            WindowManager.NavigateMainWindow("/runner");
        }
        else
        {
            Nav.NavigateTo("/runner");
        }
    }

