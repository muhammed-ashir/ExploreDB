    private async Task CopySelectedSqlAsync()
    {
        string sql = CurrentInspectorSql;
        if (string.IsNullOrEmpty(sql)) return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sql);
        _isSqlCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isSqlCopied = false;
        StateHasChanged();
    }

    private async Task CopyDeadlockXmlAsync()
    {
        string? xml = _selectedEvent?.DeadlockXml;
        if (string.IsNullOrEmpty(xml)) return;

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", xml);
        _isXmlCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isXmlCopied = false;
        StateHasChanged();
    }

