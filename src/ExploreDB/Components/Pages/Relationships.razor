    private async Task ExportActiveProfileAsync()
    {
        try
        {
            var profileName = ActiveProfileName ?? $"Local_{SchemaService.ActiveDatabase}";
            var safeFileName = VirtualRelationshipService.GetSafeFileName(profileName) + "_relations.exploredb";
            string filter = "ExploreDB Relation Profile (*.exploredb)|*.exploredb|All Files (*.*)|*.*";

            var filePath = await WindowManager.ShowSaveFileDialogAsync(safeFileName, filter, ".exploredb");
            if (string.IsNullOrEmpty(filePath)) return;

            var json = VirtualRelationshipService.ExportProfileJson();
            await File.WriteAllTextAsync(filePath, json, System.Text.Encoding.UTF8);

            ProfileNotificationMessage = $"Successfully exported {VirtualRelationshipService.GetActiveVirtualEntries().Count} relationships to '{Path.GetFileName(filePath)}'!";
            IsProfileNotificationSuccess = true;
        }
        catch (Exception ex)
        {
            ProfileNotificationMessage = $"Export failed: {ex.Message}";
            IsProfileNotificationSuccess = false;
        }
    }

    private async Task ImportProfileAsync()
    {
        try
        {
            string filter = "ExploreDB Relation Profile (*.exploredb)|*.exploredb|All Files (*.*)|*.*";
            var filePath = await WindowManager.ShowOpenFileDialogAsync(filter, "Import Relation Profile", ".exploredb");
            if (string.IsNullOrEmpty(filePath)) return;

            if (!File.Exists(filePath))
            {
                ProfileNotificationMessage = "Selected file does not exist.";
                IsProfileNotificationSuccess = false;
                return;
            }

            var json = await File.ReadAllTextAsync(filePath, System.Text.Encoding.UTF8);
            var summary = VirtualRelationshipService.AnalyzeImportJson(json);

            if (summary.ImportedEntries.Count == 0)
            {
                ProfileNotificationMessage = summary.Warnings.Count > 0 
                    ? string.Join(" ", summary.Warnings) 
                    : "No valid relationships found in the selected file.";
                IsProfileNotificationSuccess = false;
                return;
            }

            PendingImportSummary = summary;
            ImportTargetProfileName = summary.ProfileName;
            ImportAsNewProfile = true;
            LinkCurrentDbAfterImport = true;
            ShowImportPreviewModal = true;
        }
        catch (Exception ex)
        {
            ProfileNotificationMessage = $"Failed to read import file: {ex.Message}";
            IsProfileNotificationSuccess = false;
        }
    }

    private void ConfirmImport()
    {
        ShowImportPreviewModal = false;
        if (PendingImportSummary == null) return;

        try
        {
            VirtualRelationshipService.ExecuteImport(
                PendingImportSummary, 
                ImportTargetProfileName, 
                ImportAsNewProfile, 
                LinkCurrentDbAfterImport);

            ProfileNotificationMessage = $"Successfully imported {PendingImportSummary.TotalRelationships} relationship(s)!";
            IsProfileNotificationSuccess = true;
            RefreshAvailableProfiles();
            ResetPagination();
        }
        catch (Exception ex)
        {
            ProfileNotificationMessage = $"Import failed: {ex.Message}";
            IsProfileNotificationSuccess = false;
        }
    }

