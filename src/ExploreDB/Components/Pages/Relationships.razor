    private async Task VerifyRelationship(Relationship rel)
    {
        var key = $"{rel.FromTable}|{rel.FromColumn}|{rel.ToTable}|{rel.ToColumn}";
        VerifyingKey = key;
        IsProcessingAction = true;
        ActionLoadingMessage = $"Verifying relationship integrity {FormatTableDisplay(rel.FromTable, SchemaService)}.{rel.FromColumn} -> {FormatTableDisplay(rel.ToTable, SchemaService)}.{rel.ToColumn}...";
        VerificationStatusMessage = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var result = await VirtualRelationshipService.VerifyRelationshipAsync(rel);
            IsVerificationSuccess = result.Success && !result.HasOrphans;
            VerificationStatusMessage = result.Message;
        }
        finally
        {
            VerifyingKey = null;
            IsProcessingAction = false;
            StateHasChanged();
        }
    }

