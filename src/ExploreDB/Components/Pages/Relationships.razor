    private static (string Schema, string Table) SplitSchemaAndTable(string fullName, SchemaService? schemaService = null)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return (string.Empty, string.Empty);
        var clean = fullName.Replace("[", "").Replace("]", "").Trim();
        var parts = clean.Split('.');
        if (parts.Length > 1)
        {
            return (parts[0], string.Join(".", parts.Skip(1)));
        }
        if (schemaService != null)
        {
            var matched = schemaService.Tables.FirstOrDefault(t =>
                t.Name.Equals(clean, StringComparison.OrdinalIgnoreCase) ||
                t.FullName.Equals(fullName, StringComparison.OrdinalIgnoreCase));
            if (matched != null && !string.IsNullOrEmpty(matched.Schema))
            {
                return (matched.Schema, matched.Name);
            }
        }
        return (string.Empty, clean);
    }

    private static string FormatTableDisplay(string fullName, SchemaService? schemaService = null)
    {
        var (schema, table) = SplitSchemaAndTable(fullName, schemaService);
        return !string.IsNullOrEmpty(schema) ? $"{schema}.{table}" : table;
    }

