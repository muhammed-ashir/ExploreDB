    private async Task SaveCustomRelationship()
    {
        CustomRelErrorMessage = null;
        if (string.IsNullOrWhiteSpace(CustomRelFromTable) || string.IsNullOrWhiteSpace(CustomRelFromColumn) ||
            string.IsNullOrWhiteSpace(CustomRelToTable) || string.IsNullOrWhiteSpace(CustomRelToColumn))
        {
            CustomRelErrorMessage = "Please select both source and target tables and columns.";
            return;
        }

        if (string.Equals(CustomRelFromTable, CustomRelToTable, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(CustomRelFromColumn, CustomRelToColumn, StringComparison.OrdinalIgnoreCase))
        {
            CustomRelErrorMessage = "Cannot link a column to itself.";
            return;
        }

        var cleanFrom = CustomRelFromTable.Replace("[", "").Replace("]", "").Trim();
        var fromTableInfo = SchemaService.Tables?.FirstOrDefault(t =>
            string.Equals(t.FullName, CustomRelFromTable, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(t.FullName.Replace("[", "").Replace("]", "").Trim(), cleanFrom, StringComparison.OrdinalIgnoreCase));

        if (fromTableInfo != null && fromTableInfo.OutgoingKeys.Any(k =>
            k.Type == RelationshipType.Physical &&
            string.Equals(k.FromColumn, CustomRelFromColumn, StringComparison.OrdinalIgnoreCase)))
        {
            CustomRelErrorMessage = $"Column [{CustomRelFromColumn}] already has a physical foreign key constraint in the database.";
            return;
        }

        IsProcessingAction = true;
        ActionLoadingMessage = "Saving custom relationship...";
        StateHasChanged();
        await Task.Yield();

        try
        {
            var rel = new Relationship
            {
                FromTable = CustomRelFromTable,
                FromColumn = CustomRelFromColumn,
                ToTable = CustomRelToTable,
                ToColumn = CustomRelToColumn,
                IsNullable = CustomRelIsNullable,
                Type = RelationshipType.UserDefined,
                ConfidenceScore = 100,
                MatchReason = "User defined custom relationship"
            };

            VirtualRelationshipService.AddCustomRelationship(rel);
            ResetCustomRelForm();
            ActiveTab = "active";
            VerificationStatusMessage = "Custom relationship added successfully!";
            IsVerificationSuccess = true;
        }
        finally
        {
            IsProcessingAction = false;
            StateHasChanged();
        }
    }

