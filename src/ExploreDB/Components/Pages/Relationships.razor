    private IEnumerable<TableInfo> AvailableTablesToAddAsLookup
    {
        get
        {
            if (SchemaService.Tables == null) return Enumerable.Empty<TableInfo>();
            var active = VirtualRelationshipService?.GetActiveNonRoutingTables() ?? new HashSet<string>();
            return SchemaService.Tables
                .Where(t => !active.Contains(t.FullName) && !active.Contains($"[{t.Schema}].[{t.Name}]") && !active.Contains(t.Name))
                .OrderBy(t => t.FullName);
        }
    }

    protected override void OnInitialized()
    {
        VirtualRelationshipService.OnVirtualRelationshipsChanged += HandleRelationshipsChanged;
        VirtualRelationshipService.OnScanningStateChanged += HandleScanningStateChanged;
        VirtualRelationshipService.OnNonRoutingTablesChanged += HandleNonRoutingTablesChanged;
        SchemaService.OnTablesLoaded += HandleSchemaUpdated;
        RefreshAvailableProfiles();

        // Ensure suggestions are available if tables are loaded
        if (SchemaService.Tables != null && SchemaService.Tables.Count > 0)
        {
            _ = VirtualRelationshipService.EnsureSuggestionsScannedAsync();
        }
    }

