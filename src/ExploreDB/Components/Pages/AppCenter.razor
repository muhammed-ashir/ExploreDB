@page "/app-center"
@using System.IO
@using ExploreDB.Services
@using Microsoft.Extensions.Logging
@inject UserSettingsService UserSettingsService
@inject GitHubUpdateService UpdateService
@inject StoreUpdateService StoreUpdateService
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject NavigationManager Nav
@inject Microsoft.Extensions.Logging.ILogger<AppCenter> Logger
@inject ConnectionService ConnectionService
@inject WindowManagerService WindowManager
@implements IDisposable

<div class="container-fluid h-100 d-flex flex-column pb-5" style="color: var(--app-text);">
    <!-- Header -->
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0" style="color: var(--app-text);">App Center</h2>
        </div>
    </div>

    <!-- Main Tabbed Layout -->
    <div class="row g-4 flex-grow-1 align-content-start">
        <!-- Left Sub-Menu Navigation -->
        <div class="col-12 col-md-4 col-lg-3">
            <div class="card shadow-sm border" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                <div class="p-2 list-group list-group-flush border-0">
                    <button type="button" 
                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 py-2.5 px-3 rounded-2 @(ActiveTab == "editor" ? "active" : "")"
                            style="@(ActiveTab == "editor" ? "background-color: var(--app-surface-secondary); color: var(--app-text); font-weight: 600; border-left: 3px solid #0d6efd !important;" : "background: transparent; color: var(--app-text);")"
                            @onclick='() => ActiveTab = "editor"'>
                        <i class="bi bi-code-slash text-info fs-5"></i>
                        <span class="fw-semibold">Editor</span>
                    </button>

                    <button type="button" 
                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 py-2.5 px-3 rounded-2 @(ActiveTab == "appearance" ? "active" : "")"
                            style="@(ActiveTab == "appearance" ? "background-color: var(--app-surface-secondary); color: var(--app-text); font-weight: 600; border-left: 3px solid #0d6efd !important;" : "background: transparent; color: var(--app-text);")"
                            @onclick='() => ActiveTab = "appearance"'>
                        <i class="bi bi-palette text-warning fs-5"></i>
                        <span class="fw-semibold">Appearance</span>
                    </button>

                    <button type="button" 
                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 py-2.5 px-3 rounded-2 @(ActiveTab == "license" ? "active" : "")"
                            style="display: none !important; @(ActiveTab == "license" ? "background-color: var(--app-surface-secondary); color: var(--app-text); font-weight: 600; border-left: 3px solid #0d6efd !important;" : "background: transparent; color: var(--app-text);")"
                            >
                        @* <i class="bi bi-key text-warning fs-5"></i> *@
                        @* <span class="fw-semibold">License</span> *@
                    </button>

                    <button type="button" 
                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 py-2.5 px-3 rounded-2 @(ActiveTab == "connections" ? "active" : "")"
                            style="@(ActiveTab == "connections" ? "background-color: var(--app-surface-secondary); color: var(--app-text); font-weight: 600; border-left: 3px solid #0d6efd !important;" : "background: transparent; color: var(--app-text);")"
                            @onclick='() => ActiveTab = "connections"'>
                        <i class="bi bi-hdd-network text-info fs-5"></i>
                        <span class="fw-semibold">Connections</span>
                    </button>

                    <button type="button" 
                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 py-2.5 px-3 rounded-2 @(ActiveTab == "profile" ? "active" : "")"
                            style="@(ActiveTab == "profile" ? "background-color: var(--app-surface-secondary); color: var(--app-text); font-weight: 600; border-left: 3px solid #0d6efd !important;" : "background: transparent; color: var(--app-text);")"
                            @onclick='() => ActiveTab = "profile"'>
                        <i class="bi bi-person-circle text-primary fs-5"></i>
                        <span class="fw-semibold">Profile</span>
                    </button>

                    <button type="button" 
                            class="list-group-item list-group-item-action d-flex align-items-center gap-3 border-0 py-2.5 px-3 rounded-2 @(ActiveTab == "about" ? "active" : "")"
                            style="@(ActiveTab == "about" ? "background-color: var(--app-surface-secondary); color: var(--app-text); font-weight: 600; border-left: 3px solid #0d6efd !important;" : "background: transparent; color: var(--app-text);")"
                            @onclick='() => ActiveTab = "about"'>
                        <i class="bi bi-info-circle text-success fs-5"></i>
                        <span class="fw-semibold">About</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Content Area -->
        <div class="col-12 col-md-8 col-lg-9">
            @if (ActiveTab == "editor")
            {
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-code-slash text-info fs-5"></i>
                            <h5 class="fw-bold mb-0">Editor</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="form-check form-switch mb-4 d-flex align-items-center justify-content-between ps-0">
                            <div>
                                <label class="form-check-label fw-bold d-block cursor-pointer mb-1" for="autoAliasSwitch">Auto-generate Table Aliases</label>
                                <span class="text-muted small d-block">Automatically generates uppercase aliases (e.g. <code>FROM Customers AS C</code>) when selecting a table or view in autocomplete.</span>
                            </div>
                            <input class="form-check-input ms-3 flex-shrink-0 cursor-pointer" type="checkbox" id="autoAliasSwitch" style="transform: scale(1.3);" checked="@UserSettingsService.Settings.AutoGenerateAliases" @onchange="OnAutoAliasToggleChanged" />
                        </div>

                        <hr style="border-color: var(--app-border);" />

                        <div class="form-check form-switch mb-4 d-flex align-items-center justify-content-between ps-0 @(!UserSettingsService.Settings.AutoGenerateAliases ? "opacity-50" : "")">
                            <div>
                                <label class="form-check-label fw-bold d-block cursor-pointer mb-1" for="useAsSwitch">Include 'AS' Keyword in Aliases</label>
                                <span class="text-muted small d-block">Includes the explicit <code>AS</code> keyword in the generated snippet (e.g. <code>Customers AS C</code> vs <code>Customers C</code>).</span>
                            </div>
                            <input class="form-check-input ms-3 flex-shrink-0 cursor-pointer" type="checkbox" id="useAsSwitch" style="transform: scale(1.3);" disabled="@(!UserSettingsService.Settings.AutoGenerateAliases)" checked="@UserSettingsService.Settings.UseAsKeyword" @onchange="OnUseAsToggleChanged" />
                        </div>

                        <hr style="border-color: var(--app-border);" />

                        <div class="form-check form-switch mb-4 d-flex align-items-center justify-content-between ps-0">
                            <div>
                                <label class="form-check-label fw-bold d-block cursor-pointer mb-1" for="keepInClauseSwitch">Keep 'IN (...)' Lists on Single Line</label>
                                <span class="text-muted small d-block">Formats comma-separated values in <code>IN (...)</code> clauses onto a single line (e.g. <code>IN (1, 2, 3)</code>) instead of breaking each value onto a separate line.</span>
                            </div>
                            <input class="form-check-input ms-3 flex-shrink-0 cursor-pointer" type="checkbox" id="keepInClauseSwitch" style="transform: scale(1.3);" checked="@UserSettingsService.Settings.KeepInClauseOnSingleLine" @onchange="OnKeepInClauseToggleChanged" />
                        </div>

                        <hr style="border-color: var(--app-border);" />

                        <div class="mb-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <label class="form-check-label fw-bold d-block mb-1" for="formattingStyleSelect">SQL Formatting Style</label>
                                    <span class="text-muted small d-block">Choose formatting style when formatting SQL queries (Ctrl+K, Ctrl+D or Format SQL).</span>
                                </div>
                                <select id="formattingStyleSelect" class="form-select form-select-sm w-auto cursor-pointer" style="min-width: 190px; background-color: var(--app-surface-secondary); color: var(--app-text); border-color: var(--app-border);" value="@UserSettingsService.Settings.FormattingStyle" @onchange="OnFormattingStyleChanged">
                                    <option value="Default">Default (Expanded)</option>
                                    <option value="Collapsed">Collapsed (Single-Line)</option>
                                </select>
                            </div>
                        </div>
                        <div style="display:none;">
                        </div>

                        <!-- Syntax Preview -->
                        <div class="p-3 rounded-3 mt-4 border" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                            <div class="mb-2">
                                <span class="text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px; font-size: 0.7rem;">Syntax Preview</span>
                            </div>
                            <pre class="editor-syntax-preview mb-0 p-3 rounded"><code>@GetFormattingPreviewMarkup()</code></pre>


                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "appearance")
            {
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-palette text-warning fs-5"></i>
                            <h5 class="fw-bold mb-0">Appearance &amp; Display</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <!-- Theme Mode -->
                        <div class="mb-4">
                            <label class="fw-bold d-block mb-1">Color Theme</label>
                            <span class="text-muted small d-block mb-3">Choose your visual theme preference for ExploreDB.</span>
                            <div class="d-flex gap-3">
                                <div class="card p-3 cursor-pointer flex-fill border text-center transition-all @(ThemeService.IsDark ? "border-primary shadow-sm" : "")"
                                     style="background-color: var(--app-surface-secondary); border-color: var(--app-border); border-radius: 8px;"
                                     @onclick='() => SetAppTheme("dark")'>
                                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                                        <i class="bi bi-moon-stars-fill text-warning fs-5"></i>
                                        <span class="fw-bold">Dark Theme</span>
                                    </div>
                                    <small class="text-muted">High contrast dark surface for low eye strain</small>
                                </div>
                                <div class="card p-3 cursor-pointer flex-fill border text-center transition-all @(!ThemeService.IsDark ? "border-primary shadow-sm" : "")"
                                     style="background-color: var(--app-surface-secondary); border-color: var(--app-border); border-radius: 8px;"
                                     @onclick='() => SetAppTheme("light")'>
                                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                                        <i class="bi bi-sun-fill text-warning fs-5"></i>
                                        <span class="fw-bold">Light Theme</span>
                                    </div>
                                    <small class="text-muted">Clean bright interface for illuminated environments</small>
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: var(--app-border);" />

                        <!-- Application UI Font Size -->
                        <div class="mb-4">
                            <label class="fw-bold d-block mb-1">Application UI Font Size</label>
                            <span class="text-muted small d-block mb-3">Scales navigation menus, toolbars, dialogs, and result data tables proportionally across the entire app.</span>
                            
                            <div class="row g-2">
                                @{
                                    var fontSizes = new[]
                                    {
                                        new { Key = "Tiny", Label = "Tiny", Size = "12px", Desc = "Max density / 4K monitors" },
                                        new { Key = "Compact", Label = "Compact", Size = "14px", Desc = "High density for laptops" },
                                        new { Key = "Default", Label = "Default", Size = "16px", Desc = "Standard ExploreDB size" },
                                        new { Key = "Large", Label = "Large", Size = "18px", Desc = "Comfortable reading" },
                                        new { Key = "XLarge", Label = "Extra Large", Size = "20px", Desc = "High visibility & accessibility" }
                                    };
                                }
                                @foreach (var fs in fontSizes)
                                {
                                    var isSelected = UserSettingsService.Settings.AppFontSize == fs.Key;
                                    <div class="col-12 col-sm-6 col-md">
                                        <div class="card p-2 text-center h-100 cursor-pointer border @(isSelected ? "border-primary bg-primary bg-opacity-10 shadow-sm" : "")"
                                             style="background-color: var(--app-surface-secondary); border-color: var(--app-border); border-radius: 8px; transition: all 0.15s ease;"
                                             @onclick="() => OnAppFontSizeChanged(fs.Key)">
                                            <div class="fw-bold" style="font-size: @(fs.Size);">Aa</div>
                                            <div class="fw-semibold small mt-1" style="color: var(--app-text);">@fs.Label</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@fs.Size</div>
                                            <div class="text-muted mt-1" style="font-size: 0.68rem; line-height: 1.2;">@fs.Desc</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <hr style="border-color: var(--app-border);" />

                        <!-- SQL Query Editor Font Size -->
                        <div class="mb-4">
                            <label class="fw-bold d-block mb-1">Query Editor Font Size</label>
                            <span class="text-muted small d-block mb-3">Independent font size control for the SQL query editor.</span>

                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var edSize in new[] { 11, 12, 13, 14, 15, 16, 18, 20 })
                                {
                                    var isEdSelected = UserSettingsService.Settings.EditorFontSize == edSize;
                                    <button type="button" 
                                            class="btn btn-sm px-3 py-1.5 @(isEdSelected ? "btn-primary text-white shadow-sm" : "btn-outline-secondary")"
                                            style="border-radius: 6px; font-weight: 500;"
                                            @onclick="() => OnEditorFontSizeChanged(edSize)">
                                        @(edSize)px @(edSize == 14 ? "(Default)" : "")
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            @*
            else if (ActiveTab == "license")
            {
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-key text-warning fs-5"></i>
                            <h5 class="fw-bold mb-0">License</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @if (!IsLicensed)
                        {
                            <!-- Unlicensed / Free Edition Status Banner -->
                            <div class="d-flex align-items-center p-3 rounded-3 mb-4 border" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-secondary bg-opacity-25" style="width: 48px; height: 48px;">
                                        <i class="bi bi-award text-secondary fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">ExploreDB Free Edition</h5>
                                        <small class="text-muted">No active license key registered on this device</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Activation Section -->
                            <div class="p-4 rounded-3 border mb-4" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <h6 class="fw-bold mb-1">Activate License</h6>
                                <p class="text-muted small mb-3">Purchased a license key from the ExploreDB portal? Enter your key below to register this workstation.</p>
                                
                                <div class="input-group mb-2">
                                    <input type="text" 
                                           class="form-control" 
                                           placeholder="EDB-XXXX-XXXX-XXXX-XXXX" 
                                           style="background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border); font-family: monospace;"
                                           @bind="LicenseKeyInput" />
                                    <button class="btn btn-primary px-4 fw-medium" @onclick="HandleActivateLicense">Activate License</button>
                                </div>

                                @if (!string.IsNullOrEmpty(LicenseMessage))
                                {
                                    <div class="small mt-2 @(LicenseSuccess ? "text-success" : "text-danger")">
                                        <i class="bi @(LicenseSuccess ? "bi-check-circle" : "bi-exclamation-circle") me-1"></i>@LicenseMessage
                                    </div>
                                }
                            </div>

                            <!-- Purchase / Web Portal Link Box -->
                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between p-3 rounded-3 border gap-3" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <div>
                                    <div class="fw-semibold mb-1">Don't have a license key yet?</div>
                                    <small class="text-muted">Purchase a license on the ExploreDB Web Portal to unlock all current and future capabilities.</small>
                                </div>
                                <a href="https://zerinapps.web.app/app/exploredb" target="_blank" class="btn btn-outline-primary px-3 fw-medium flex-shrink-0 text-decoration-none">
                                    <span>Get License Key</span>
                                    <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <!-- Active / Licensed Status Banner -->
                            <div class="d-flex align-items-center p-3 rounded-3 mb-4 border" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center bg-success bg-opacity-25" style="width: 48px; height: 48px;">
                                        <i class="bi bi-patch-check-fill text-success fs-3"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0">ExploreDB Pro Edition</h5>
                                        <small class="text-muted">License active and registered on this device</small>
                                    </div>
                                </div>
                            </div>

                            <!-- License Details -->
                            <div class="p-4 rounded-3 border mb-4" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <h6 class="fw-bold mb-3">License Details</h6>
                                <div class="row g-3 mb-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small text-muted fw-bold">License Key</label>
                                        <input type="text" class="form-control text-muted" style="background-color: var(--app-surface); border-color: var(--app-border); font-family: monospace;" readonly value="@MaskedLicenseKey" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label small text-muted fw-bold">Active Workstation</label>
                                        <input type="text" class="form-control text-muted" style="background-color: var(--app-surface); border-color: var(--app-border);" readonly value="@Environment.MachineName" />
                                    </div>
                                </div>

                                <div class="pt-3 border-top d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3" style="border-color: var(--app-border) !important;">
                                    <div>
                                        <span class="fw-semibold d-block">Transfer or Deactivate</span>
                                        <small class="text-muted">Remove this license from this computer to activate it on another device.</small>
                                    </div>
                                    <button class="btn btn-outline-danger px-3 fw-medium flex-shrink-0" @onclick="HandleDeactivateLicense">
                                        Deactivate License
                                    </button>
                                </div>
                            </div>

                            <!-- Web Portal Link Box -->
                            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between p-3 rounded-3 border gap-3" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <div>
                                    <div class="fw-semibold mb-1">Manage Your Licenses Online</div>
                                    <small class="text-muted">View active devices, invoices, and license keys anytime on the ExploreDB Web Portal.</small>
                                </div>
                                <a href="https://zerinapps.web.app/app/exploredb" target="_blank" class="btn btn-outline-primary px-3 fw-medium flex-shrink-0 text-decoration-none">
                                    <span>Web Portal</span>
                                    <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
            *@
            else if (ActiveTab == "profile")
            {
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle text-primary fs-5"></i>
                            <h5 class="fw-bold mb-0">Profile</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--app-border) !important;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white fs-4 fw-bold" style="width: 48px; height: 48px;">
                                @GetAvatarLetter()
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0">@GetDisplayName()</h5>
                                <small class="text-muted">@Environment.MachineName</small>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label small text-muted fw-bold">Display Name</label>
                                <input type="text" class="form-control" style="background-color: var(--app-surface-secondary); color: var(--app-text); border-color: var(--app-border);" value="@ProfileName" @oninput="OnProfileNameInput" placeholder="@Environment.UserName" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small text-muted fw-bold">Workstation / Computer</label>
                                <input type="text" class="form-control" style="background-color: var(--app-surface-secondary); color: var(--app-text); border-color: var(--app-border);" readonly value="@Environment.MachineName" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted fw-bold">App Data Storage Directory</label>
                                <input type="text" class="form-control text-muted" style="background-color: var(--app-surface-secondary); border-color: var(--app-border);" readonly value="@AppEnvironmentService.AppDataDirectory" />
                                <small class="text-muted">All connection profiles, query tabs, and user settings are encrypted and stored locally in this path.</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "connections")
            {
                <!-- Export Connections Card -->
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-arrow-up-right text-primary fs-5"></i>
                            <div>
                                <h5 class="fw-bold mb-0">Export Connections</h5>
                                <small class="text-muted">Export selected connection profiles to a portable <code>.exploredb</code> backup file.</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <!-- Toolbar: Search, Selection Badge & Passwords Switch -->
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
                            <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 480px;">
                                <div class="input-group input-group-sm flex-grow-1" style="max-width: 300px;">
                                    <span class="input-group-text border-end-0" style="background-color: var(--app-surface-secondary); color: var(--app-text-muted); border-color: var(--app-border);">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text"
                                           class="form-control shadow-none border-start-0 ps-0 @(!string.IsNullOrEmpty(ConnectionSearchText) ? "border-end-0" : "")"
                                           style="background-color: var(--app-surface-secondary); color: var(--app-text); border-color: var(--app-border);"
                                           placeholder="Filter connections..."
                                           @bind="ConnectionSearchText"
                                           @bind:event="oninput" />
                                    @if (!string.IsNullOrEmpty(ConnectionSearchText))
                                    {
                                        <button class="btn btn-outline-secondary border-start-0"
                                                style="background-color: var(--app-surface-secondary); color: var(--app-text-muted); border-color: var(--app-border);"
                                                type="button"
                                                title="Clear filter"
                                                @onclick="() => ConnectionSearchText = string.Empty">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                                <span class="badge bg-secondary-subtle text-secondary border fw-normal" style="font-size: 0.75rem; white-space: nowrap;">
                                    @SelectedCount of @ConnectionService.SavedConnections.Count selected
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <div class="form-check form-switch d-flex align-items-center gap-2 mb-0 ps-0">
                                    <input class="form-check-input cursor-pointer ms-0 me-1" type="checkbox" id="includePasswordsSwitch" style="transform: scale(1.15);" @bind="IncludePasswordsInExport" />
                                    <label class="form-check-label cursor-pointer small fw-medium user-select-none" for="includePasswordsSwitch" title="Passwords are encrypted using AES-256">
                                        Include Passwords
                                    </label>
                                </div>
                                @if (IncludePasswordsInExport)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1" style="font-size: 0.68rem;" title="Passwords are encrypted using AES-256 in the export file">
                                        <i class="bi bi-shield-lock-fill"></i> Encrypted
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Table / List of Saved Connections -->
                        @if (!FilteredConnectionsForExport.Any())
                        {
                            <div class="text-center py-4 text-muted small border rounded-3" style="border-color: var(--app-border) !important; background-color: var(--app-surface-secondary);">
                                @(ConnectionService.SavedConnections.Count == 0 ? "No saved connections found in ExploreDB." : "No connections match your filter.")
                            </div>
                        }
                        else
                        {
                            <div class="border rounded-3 overflow-hidden custom-scrollbar-light" style="border-color: var(--app-border) !important; max-height: 260px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0 align-middle" style="color: var(--app-text); table-layout: fixed; width: 100%;">
                                    <thead style="background-color: var(--app-surface-secondary); position: sticky; top: 0; z-index: 2;">
                                        <tr class="small text-muted border-bottom" style="border-color: var(--app-border) !important;">
                                            <th style="width: 44px;" class="text-center">
                                                <input class="form-check-input cursor-pointer" type="checkbox" checked="@AreAllFilteredSelected" @onchange="ToggleSelectAllFiltered" />
                                            </th>
                                            <th style="width: 48%;">Connection Name</th>
                                            <th style="width: 36%;">Server</th>
                                            <th style="width: 16%;">Auth Type</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var conn in FilteredConnectionsForExport)
                                        {
                                            bool isSelected = !string.IsNullOrEmpty(conn.Id) && SelectedConnectionIds.Contains(conn.Id);
                                            string authType = string.IsNullOrEmpty(conn.AuthType) ? (conn.UseWindowsAuth ? "Windows" : "SqlServer") : conn.AuthType;
                                            string authBadgeClass = authType == "Windows"
                                                ? "bg-primary-subtle text-primary-emphasis border border-primary-subtle"
                                                : authType == "EntraMfa"
                                                    ? "bg-info-subtle text-info-emphasis border border-info-subtle"
                                                    : "bg-warning-subtle text-warning-emphasis border border-warning-subtle";
                                            string authDisplayName = authType == "Windows" ? "Windows" : authType == "EntraMfa" ? "Entra MFA" : "SQL Auth";

                                            <tr class="cursor-pointer @(isSelected ? "table-active" : "")" @onclick="() => ToggleConnectionSelection(conn.Id)">
                                                <td class="text-center" @onclick:stopPropagation>
                                                    <input class="form-check-input cursor-pointer" type="checkbox" checked="@isSelected" @onchange="() => ToggleConnectionSelection(conn.Id)" />
                                                </td>
                                                <td class="text-truncate pe-2" title="@(string.IsNullOrWhiteSpace(conn.Name) ? "Unnamed Connection" : conn.Name)">
                                                    <span class="fw-semibold" style="font-size: 0.88rem;">@(string.IsNullOrWhiteSpace(conn.Name) ? "Unnamed Connection" : conn.Name)</span>
                                                    @if (!string.IsNullOrEmpty(conn.Username))
                                                    {
                                                        <span class="text-muted ms-2 small">(@conn.Username)</span>
                                                    }
                                                </td>
                                                <td class="small font-monospace text-muted text-truncate pe-2" title="@conn.Server">@conn.Server</td>
                                                <td>
                                                    <span class="badge @authBadgeClass" style="font-size: 0.72rem; font-weight: 600;">@authDisplayName</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ExportSuccessMessage))
                        {
                            <div class="alert alert-success mt-3 mb-0 py-2 px-3 small d-flex align-items-start justify-content-between gap-2" style="border-radius: 8px;">
                                <div class="d-flex align-items-start gap-2 flex-grow-1 overflow-hidden" style="word-break: break-word;">
                                    <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                                    <span class="text-break">@ExportSuccessMessage</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm flex-shrink-0 mt-1" @onclick="() => ExportSuccessMessage = null"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ExportErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0 py-2 px-3 small d-flex align-items-start justify-content-between gap-2" style="border-radius: 8px;">
                                <div class="d-flex align-items-start gap-2 flex-grow-1 overflow-hidden" style="word-break: break-word;">
                                    <i class="bi bi-exclamation-octagon-fill text-danger flex-shrink-0 mt-1"></i>
                                    <span class="text-break">@ExportErrorMessage</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm flex-shrink-0 mt-1" @onclick="() => ExportErrorMessage = null"></button>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent py-3 px-4 border-top d-flex justify-content-end align-items-center" style="border-color: var(--app-border) !important;">
                        <button class="btn btn-primary px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2"
                                disabled="@(SelectedCount == 0 || IsProcessingFile)"
                                @onclick="ExportSelectedConnectionsAsync">
                            <i class="bi bi-download"></i>
                            <span>Export Selected (@SelectedCount)</span>
                        </button>
                    </div>
                </div>

                <!-- Import Connections Card -->
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-arrow-in-down text-success fs-5"></i>
                            <div>
                                <h5 class="fw-bold mb-0">Import Connections</h5>
                                <small class="text-muted">Restore or merge connection profiles from an exported <code>.exploredb</code> backup file.</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <!-- Duplicate Handling Policy Options -->
                        <div class="mb-2">
                            <label class="fw-bold d-block mb-2 small text-uppercase text-muted" style="letter-spacing: 0.5px; font-size: 0.72rem;">
                                If an imported connection already exists:
                            </label>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <div class="card p-3 cursor-pointer h-100 border transition-all @(SelectedConflictPolicy == ConnectionService.ImportConflictPolicy.AddAsCopy ? "border-primary shadow-sm" : "")"
                                         style="background-color: var(--app-surface-secondary); border-color: var(--app-border); border-radius: 8px;"
                                         @onclick="() => SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.AddAsCopy">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-copy text-primary fs-5"></i>
                                                <span class="fw-bold" style="font-size: 0.9rem;">Keep Both</span>
                                            </div>
                                            <input class="form-check-input cursor-pointer m-0" type="radio" name="conflictPolicy"
                                                   checked="@(SelectedConflictPolicy == ConnectionService.ImportConflictPolicy.AddAsCopy)"
                                                   @onchange="() => SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.AddAsCopy" />
                                        </div>
                                        <small class="text-muted d-block" style="font-size: 0.78rem;">Adds profile with <code>(Imported)</code> suffix. Safest option.</small>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <div class="card p-3 cursor-pointer h-100 border transition-all @(SelectedConflictPolicy == ConnectionService.ImportConflictPolicy.Overwrite ? "border-warning shadow-sm" : "")"
                                         style="background-color: var(--app-surface-secondary); border-color: var(--app-border); border-radius: 8px;"
                                         @onclick="() => SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.Overwrite">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-arrow-repeat text-warning fs-5"></i>
                                                <span class="fw-bold" style="font-size: 0.9rem;">Overwrite</span>
                                            </div>
                                            <input class="form-check-input cursor-pointer m-0" type="radio" name="conflictPolicy"
                                                   checked="@(SelectedConflictPolicy == ConnectionService.ImportConflictPolicy.Overwrite)"
                                                   @onchange="() => SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.Overwrite" />
                                        </div>
                                        <small class="text-muted d-block" style="font-size: 0.78rem;">Updates existing profile settings with imported data.</small>
                                    </div>
                                </div>

                                <div class="col-12 col-md-4">
                                    <div class="card p-3 cursor-pointer h-100 border transition-all @(SelectedConflictPolicy == ConnectionService.ImportConflictPolicy.Skip ? "border-secondary shadow-sm" : "")"
                                         style="background-color: var(--app-surface-secondary); border-color: var(--app-border); border-radius: 8px;"
                                         @onclick="() => SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.Skip">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-skip-forward text-secondary fs-5"></i>
                                                <span class="fw-bold" style="font-size: 0.9rem;">Skip Duplicates</span>
                                            </div>
                                            <input class="form-check-input cursor-pointer m-0" type="radio" name="conflictPolicy"
                                                   checked="@(SelectedConflictPolicy == ConnectionService.ImportConflictPolicy.Skip)"
                                                   @onchange="() => SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.Skip" />
                                        </div>
                                        <small class="text-muted d-block" style="font-size: 0.78rem;">Keeps current connection unchanged; only adds new ones.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ImportSuccessMessage))
                        {
                            <div class="alert alert-success mt-3 mb-0 py-2 px-3 small d-flex align-items-start justify-content-between gap-2" style="border-radius: 8px;">
                                <div class="d-flex align-items-start gap-2 flex-grow-1 overflow-hidden" style="word-break: break-word;">
                                    <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                                    <span class="text-break">@ImportSuccessMessage</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm flex-shrink-0 mt-1" @onclick="() => ImportSuccessMessage = null"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ImportErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0 py-2 px-3 small d-flex align-items-start justify-content-between gap-2" style="border-radius: 8px;">
                                <div class="d-flex align-items-start gap-2 flex-grow-1 overflow-hidden" style="word-break: break-word;">
                                    <i class="bi bi-exclamation-octagon-fill text-danger flex-shrink-0 mt-1"></i>
                                    <span class="text-break">@ImportErrorMessage</span>
                                </div>
                                <button type="button" class="btn-close btn-close-sm flex-shrink-0 mt-1" @onclick="() => ImportErrorMessage = null"></button>
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent py-3 px-4 border-top d-flex justify-content-end align-items-center" style="border-color: var(--app-border) !important;">
                        <button class="btn btn-success px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2"
                                disabled="@IsProcessingFile"
                                @onclick="ImportConnectionsFileAsync">
                            @if (IsProcessingFile)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>Importing...</span>
                            }
                            else
                            {
                                <i class="bi bi-folder2-open"></i>
                                <span>Select .exploredb File...</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else if (ActiveTab == "about")
            {
                <div class="card shadow-sm border mb-4" style="background-color: var(--app-surface); border-color: var(--app-border) !important; border-radius: 10px;">
                    <div class="card-header py-3 px-4 border-bottom" style="background: transparent; border-color: var(--app-border) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-success fs-5"></i>
                            <h5 class="fw-bold mb-0">About</h5>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between p-3 rounded-3 mb-4 border" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                            <div>
                                <h4 class="fw-bold mb-1">ExploreDB</h4>
                                <div class="text-info fw-semibold" style="font-size: 0.9rem;">Version @AppEnvironmentService.VersionString</div>
                            </div>
                            <button class="btn btn-outline-info px-4 fw-medium" @onclick="CheckForUpdatesAsync" disabled="@IsCheckingUpdates">
                                @if (IsCheckingUpdates)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Checking...</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-repeat me-1"></i>
                                    <span>Check for Updates</span>
                                }
                            </button>
                        </div>

                        <!-- Legal Collapsibles -->
                        <div class="accordion mb-4" id="legalAccordion">
                            <div class="accordion-item border mb-2 rounded" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#termsCollapse" style="background: transparent; color: var(--app-text);">
                                        <i class="bi bi-file-earmark-text text-primary me-2"></i>Terms & Conditions
                                    </button>
                                </h2>
                                <div id="termsCollapse" class="accordion-collapse collapse" data-bs-parent="#legalAccordion">
                                    <div class="accordion-body small text-muted">
                                        <p><strong>1. Execution & Safety:</strong> All queries and commands execute directly from your local machine to the target SQL Server. You maintain full responsibility for scripts and data modifications executed against production databases.</p>
                                        <p><strong>2. License & Workstations:</strong> A purchased license key authorizes activation on your designated workstations. Keys can be deactivated and transferred to new devices via the desktop app or the ExploreDB Web Portal, and must not be publicly shared or redistributed.</p>
                                        <p class="mb-0"><strong>3. Data Integrity:</strong> ExploreDB is a direct client interface tool. Users are encouraged to maintain active database backups and use transactions (<code>BEGIN TRAN / COMMIT</code>) when running destructive operations.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="accordion-item border rounded" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#privacyCollapse" style="background: transparent; color: var(--app-text);">
                                        <i class="bi bi-shield-check text-success me-2"></i>Privacy Policy
                                    </button>
                                </h2>
                                <div id="privacyCollapse" class="accordion-collapse collapse" data-bs-parent="#legalAccordion">
                                    <div class="accordion-body small text-muted">
                                        <p><strong>Zero Telemetry on Database Content:</strong> ExploreDB does NOT collect, inspect, transmit, or store any database schemas, query texts, connection credentials, or table records on any external server.</p>
                                        <p class="mb-0"><strong>Local File Privacy:</strong> All user settings, session tabs, and cached schemas reside solely on your device within your personal AppData folder.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Modern Update Status Modal -->
    @if (ShowUpdateModal)
    {
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 1070;" @onclick="() => ShowUpdateModal = false">
            <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation="true">
                <div class="modal-content glass-card shadow-lg text-center p-4" style="background-color: var(--app-surface-secondary); color: var(--app-text); border-radius: 12px; border: 1px solid var(--app-border) !important;">
                    @if (AvailableUpdate != null)
                    {
                        <div class="mb-3 text-info">
                            <i class="bi bi-arrow-up-circle-fill" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Update Available!</h5>
                        <p class="small text-muted mb-3">A new version of ExploreDB is ready to install.</p>

                        @if (IsDownloadingUpdate)
                        {
                            <div class="mb-3 text-info small fw-bold">
                                <span class="spinner-border spinner-border-sm me-2"></span> Downloading update...
                                @if (IsStoreUpdate && UpdateProgress > 0)
                                {
                                    <span>(@(Math.Round(UpdateProgress))%)</span>
                                    <div class="progress mt-2 bg-dark" style="height: 6px;">
                                        <div class="progress-bar bg-info" style="width: @(UpdateProgress.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                    </div>
                                }
                            </div>
                        }
                        else if (StoreUpdateReadyToRestart)
                        {
                            <div class="mb-3 text-success small fw-bold">
                                ✅ Update downloaded! Restarting application...
                            </div>
                        }
                        else if (InstallerLaunched)
                        {
                            <div class="mb-3 text-success small fw-bold">
                                ✅ Installer launched! Check your taskbar.
                            </div>
                        }
                        else if (DownloadFailed)
                        {
                            <div class="mb-3 text-danger small">
                                Direct download failed.<br />
                                @if (!IsStoreUpdate && !string.IsNullOrEmpty(AvailableUpdate.DownloadUrl))
                                {
                                    <a href="@AvailableUpdate.DownloadUrl" target="_blank" class="fw-bold text-decoration-underline text-danger">Click to download via browser</a>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-center gap-2">
                            <button class="btn btn-outline-secondary px-3 rounded-pill fw-medium" @onclick="() => ShowUpdateModal = false">Later</button>
                            @if (!InstallerLaunched && !StoreUpdateReadyToRestart)
                            {
                                <button class="btn btn-primary px-4 rounded-pill fw-medium" disabled="@IsDownloadingUpdate" @onclick="DownloadAndInstallUpdateAsync">
                                    Update Now
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary px-4 rounded-pill fw-medium" @onclick="() => ShowUpdateModal = false">Done</button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 text-success">
                            <i class="bi bi-patch-check-fill" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold mb-2">You're Up to Date!</h5>
                        <p class="small text-muted mb-4">You are running ExploreDB v@(AppEnvironmentService.VersionString).<br/>You have the latest version installed.</p>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-primary px-4 rounded-pill fw-medium shadow-sm" @onclick="() => ShowUpdateModal = false">OK</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string ActiveTab = "editor";
    private string LicenseKeyInput = "";
    private string LicenseMessage = "";
    private bool LicenseSuccess = false;
    private string ProfileName = "";

    // Connections Tab State
    private HashSet<string> SelectedConnectionIds = new();
    private bool IncludePasswordsInExport = false;
    private string ConnectionSearchText = "";
    private string? ExportSuccessMessage;
    private string? ExportErrorMessage;
    private ConnectionService.ImportConflictPolicy SelectedConflictPolicy = ConnectionService.ImportConflictPolicy.AddAsCopy;
    private string? ImportSuccessMessage;
    private string? ImportErrorMessage;
    private bool IsProcessingFile = false;

    private IEnumerable<ConnectionService.SavedConnection> FilteredConnectionsForExport
    {
        get
        {
            var list = ConnectionService.SavedConnections.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(ConnectionSearchText))
            {
                list = list.Where(c => 
                    (c.Name?.Contains(ConnectionSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.Server?.Contains(ConnectionSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.Database?.Contains(ConnectionSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.Username?.Contains(ConnectionSearchText, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }
            return list;
        }
    }

    private int SelectedCount => ConnectionService.SavedConnections.Count(c => !string.IsNullOrEmpty(c.Id) && SelectedConnectionIds.Contains(c.Id));

    private bool AreAllFilteredSelected
    {
        get
        {
            var filteredList = FilteredConnectionsForExport.Where(c => !string.IsNullOrEmpty(c.Id)).ToList();
            return filteredList.Count > 0 && filteredList.All(c => SelectedConnectionIds.Contains(c.Id));
        }
    }

    private void HandleConnectionChanged()
    {
        var validIds = ConnectionService.SavedConnections.Where(c => !string.IsNullOrEmpty(c.Id)).Select(c => c.Id).ToHashSet();
        SelectedConnectionIds.IntersectWith(validIds);
        InvokeAsync(StateHasChanged);
    }

    private void InitializeConnectionSelection()
    {
        SelectedConnectionIds = new HashSet<string>(ConnectionService.SavedConnections.Where(c => !string.IsNullOrEmpty(c.Id)).Select(c => c.Id));
    }

    private void ToggleConnectionSelection(string id)
    {
        if (SelectedConnectionIds.Contains(id))
        {
            SelectedConnectionIds.Remove(id);
        }
        else
        {
            SelectedConnectionIds.Add(id);
        }
    }

    private void SelectAllConnections()
    {
        foreach (var c in ConnectionService.SavedConnections)
        {
            if (!string.IsNullOrEmpty(c.Id))
            {
                SelectedConnectionIds.Add(c.Id);
            }
        }
    }

    private void DeselectAllConnections()
    {
        SelectedConnectionIds.Clear();
    }

    private void ToggleSelectAllFiltered(ChangeEventArgs e)
    {
        bool selectAll = (bool)(e.Value ?? false);
        var filteredIds = FilteredConnectionsForExport.Where(c => !string.IsNullOrEmpty(c.Id)).Select(c => c.Id).ToList();
        if (selectAll)
        {
            foreach (var id in filteredIds)
            {
                SelectedConnectionIds.Add(id);
            }
        }
        else
        {
            foreach (var id in filteredIds)
            {
                SelectedConnectionIds.Remove(id);
            }
        }
    }

    private async Task ExportSelectedConnectionsAsync()
    {
        ExportSuccessMessage = null;
        ExportErrorMessage = null;

        var validIds = SelectedConnectionIds.Where(id => ConnectionService.SavedConnections.Any(c => c.Id == id)).ToList();
        if (validIds.Count == 0)
        {
            ExportErrorMessage = "Please select at least one connection to export.";
            return;
        }

        try
        {
            string defaultFileName = $"ExploreDB_Connections_{DateTime.Now:yyyyMMdd_HHmm}.exploredb";
            string filter = "ExploreDB Connections (*.exploredb)|*.exploredb|All Files (*.*)|*.*";
            
            var filePath = await WindowManager.ShowSaveFileDialogAsync(defaultFileName, filter, ".exploredb");
            if (string.IsNullOrEmpty(filePath))
            {
                return; // User cancelled
            }

            string json = ConnectionService.ExportConnections(validIds, IncludePasswordsInExport);
            await File.WriteAllTextAsync(filePath, json, System.Text.Encoding.UTF8);

            ExportSuccessMessage = $"Successfully exported {validIds.Count} connection(s) to: {Path.GetFileName(filePath)}";
        }
        catch (Exception ex)
        {
            ExportErrorMessage = $"Export failed: {ex.Message}";
            Logger.LogError(ex, "AppCenter: Failed to export connections.");
        }
    }

    private async Task ImportConnectionsFileAsync()
    {
        ImportSuccessMessage = null;
        ImportErrorMessage = null;
        IsProcessingFile = true;

        try
        {
            string filter = "ExploreDB Connections (*.exploredb)|*.exploredb|All Files (*.*)|*.*";
            var filePath = await WindowManager.ShowOpenFileDialogAsync(filter, "Import ExploreDB Connections", ".exploredb");

            if (string.IsNullOrEmpty(filePath))
            {
                return; // User cancelled
            }

            if (!File.Exists(filePath))
            {
                ImportErrorMessage = "Selected file does not exist.";
                return;
            }

            string json = await File.ReadAllTextAsync(filePath, System.Text.Encoding.UTF8);
            var result = ConnectionService.ImportConnections(json, SelectedConflictPolicy);

            if (!string.IsNullOrEmpty(result.ErrorMessage))
            {
                ImportErrorMessage = result.ErrorMessage;
                return;
            }

            var parts = new List<string>();
            if (result.Added > 0) parts.Add($"{result.Added} added");
            if (result.Updated > 0) parts.Add($"{result.Updated} updated");
            if (result.Skipped > 0) parts.Add($"{result.Skipped} skipped (duplicate)");

            string details = parts.Count > 0 ? string.Join(", ", parts) : "0 changes";
            ImportSuccessMessage = $"Successfully imported {result.TotalInFile} connection(s) from '{Path.GetFileName(filePath)}' ({details}).";

            InitializeConnectionSelection();
        }
        catch (System.Text.Json.JsonException)
        {
            ImportErrorMessage = "Invalid or corrupted file format. Please ensure you are importing a valid .exploredb file.";
        }
        catch (Exception ex)
        {
            ImportErrorMessage = $"Import failed: {ex.Message}";
            Logger.LogError(ex, "AppCenter: Failed to import connections.");
        }
        finally
        {
            IsProcessingFile = false;
            await InvokeAsync(StateHasChanged);
        }
    }

