    private bool IsLicensed => !string.IsNullOrWhiteSpace(UserSettingsService.Settings.LicenseKey);

    private string MaskedLicenseKey
    {
        get
        {
            var key = UserSettingsService.Settings.LicenseKey?.Trim() ?? "";
            if (key.Length <= 8) return key;
            var prefix = key.Substring(0, Math.Min(4, key.Length)).TrimEnd('-');
            var suffix = key.Substring(key.Length - 4).TrimStart('-');
            return $"{prefix}-••••-••••-{suffix}";
        }
    }

    private void HandleActivateLicense()
    {
        if (string.IsNullOrWhiteSpace(LicenseKeyInput))
        {
            LicenseMessage = "Please enter a valid license key.";
            LicenseSuccess = false;
            return;
        }

        if (LicenseKeyInput.Trim().Length < 10)
        {
            LicenseMessage = "Invalid license key format. Expected 16-20 characters.";
            LicenseSuccess = false;
            return;
        }

        UserSettingsService.UpdateLicenseKey(LicenseKeyInput.Trim());
        LicenseMessage = "License key registered successfully! All features unlocked.";
        LicenseSuccess = true;
        LicenseKeyInput = "";
    }

    private void HandleDeactivateLicense()
    {
        UserSettingsService.UpdateLicenseKey("");
        LicenseMessage = "License successfully deactivated on this device.";
        LicenseSuccess = true;
    }

    private bool IsCheckingUpdates = false;
    private bool ShowUpdateModal = false;
    private UpdateInfo? AvailableUpdate;
    private bool IsDownloadingUpdate = false;
    private bool DownloadFailed = false;
    private bool InstallerLaunched = false;

    private bool IsStoreUpdate = false;
    private double UpdateProgress = 0;
    private bool StoreUpdateReadyToRestart = false;

    private async Task CheckForUpdatesAsync()
    {
        if (IsCheckingUpdates) return;
        IsCheckingUpdates = true;
        DownloadFailed = false;
        InstallerLaunched = false;
        StoreUpdateReadyToRestart = false;
        UpdateProgress = 0;
        Logger.LogInformation("AppCenter: Manual check for updates initiated by user.");
        try
        {
#if WINDOWS
            IsStoreUpdate = await StoreUpdateService.CheckForUpdateAsync();
            if (IsStoreUpdate)
            {
                AvailableUpdate = new UpdateInfo("STORE_UPDATE", false);
                Logger.LogInformation("AppCenter: Store update detected.");
            }
            else
            {
                AvailableUpdate = await UpdateService.CheckForUpdateAsync();
                Logger.LogInformation("AppCenter: Store update not found. External release check: {Result}", AvailableUpdate != null ? "Update Available" : "Up-to-date");
            }

#else
            AvailableUpdate = await UpdateService.CheckForUpdateAsync();
            Logger.LogInformation("AppCenter (Non-Windows): External release check: {Result}", AvailableUpdate != null ? "Update Available" : "Up-to-date");
#endif
            ShowUpdateModal = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AppCenter: Error occurred during manual update check.");
            AvailableUpdate = null;
            ShowUpdateModal = true;
        }
        finally
        {
            IsCheckingUpdates = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadAndInstallUpdateAsync()
    {
        if (AvailableUpdate == null) return;
        IsDownloadingUpdate = true;
        Logger.LogInformation("AppCenter: User initiated update download/install. IsStoreUpdate: {IsStoreUpdate}", IsStoreUpdate);
        DownloadFailed = false;
        try
        {
            if (IsStoreUpdate)
            {
                var success = await StoreUpdateService.DownloadAndInstallUpdateAsync(percent =>
                {
                    UpdateProgress = percent;
                    InvokeAsync(StateHasChanged);
                });
                if (success)
                {
                    Logger.LogInformation("AppCenter: Store update installation successful. Ready to restart.");
                    StoreUpdateReadyToRestart = true;
                }
                else
                {
                    Logger.LogWarning(IsStoreUpdate ? "AppCenter: Store update installation failed." : "AppCenter: External update installer execution failed.");
                    DownloadFailed = true;
                }
            }
            else
            {
                if (string.IsNullOrEmpty(AvailableUpdate.DownloadUrl)) return;
                var success = await UpdateService.DownloadAndExecuteUpdateAsync(AvailableUpdate.DownloadUrl);
                if (success)
                {
                    Logger.LogInformation("AppCenter: External update installer launched successfully.");
                    InstallerLaunched = true;
                }
                else
                {
                    Logger.LogWarning(IsStoreUpdate ? "AppCenter: Store update installation failed." : "AppCenter: External update installer execution failed.");
                    DownloadFailed = true;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AppCenter: Exception occurred during update download/install.");
            DownloadFailed = true;
        }
        finally
        {
            IsDownloadingUpdate = false;
            await InvokeAsync(StateHasChanged);
        }
    }

