    private MarkupString GetFormattingPreviewMarkup()
    {
        var custAlias = GetCustomerAliasPreview();
        var ordAlias = GetOrderAliasPreview();
        var inClause = GetInClausePreview();

        if (UserSettingsService.Settings.FormattingStyle == "Collapsed")
        {
            var joinCond = UserSettingsService.Settings.AutoGenerateAliases
                ? "O.CustomerId=C.Id"
                : "[dbo].[Orders].CustomerId=[dbo].[Customers].Id";

            return (MarkupString)$@"<span class=""keyword"">SELECT</span> o.OrderID, o.OrderDate, c.CustomerName
<span class=""keyword"">FROM</span> [dbo].[Customers]{custAlias.Value} <span class=""keyword"">WITH</span>(NOLOCK)
     <span class=""keyword"">INNER JOIN</span> [dbo].[Orders]{ordAlias.Value} <span class=""keyword"">WITH</span>(NOLOCK) <span class=""keyword"">ON</span> {joinCond}
<span class=""keyword"">WHERE</span> o.OrderDate>='2025-01-01' <span class=""keyword"">AND</span> [StatusID] {inClause.Value}";
        }
        else
        {
            var joinCond = GetJoinConditionPreview();

            return (MarkupString)$@"<span class=""keyword"">SELECT</span> o.OrderID,
       o.OrderDate,
       c.CustomerName
<span class=""keyword"">FROM</span> [dbo].[Customers]{custAlias.Value} <span class=""keyword"">WITH</span> (NOLOCK)
    <span class=""keyword"">INNER JOIN</span> [dbo].[Orders]{ordAlias.Value} <span class=""keyword"">WITH</span> (NOLOCK)
        <span class=""keyword"">ON</span> {joinCond}
<span class=""keyword"">WHERE</span> o.OrderDate >= '2025-01-01'
      <span class=""keyword"">AND</span> [StatusID] {inClause.Value}";
        }
    }

    private MarkupString GetInClausePreview()
