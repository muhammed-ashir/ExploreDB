                </div>

                <!-- Action Toolbar (Replaces tabs) -->
                <div class="px-3 py-2 flex-shrink-0 d-flex align-items-center justify-content-between gap-2" style="border-bottom: 1px solid var(--app-border); background-color: var(--app-surface-secondary);">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm" @onclick="() => DownloadBinaryBytesAsync(_activeBinaryBytes, _activeBinaryColumnName)" title="Save to disk">
                            <i class="bi bi-download"></i>
                            <span>Save File</span>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" @onclick="() => CopyBinaryHexAsync(_activeBinaryBytes)" title="Copy full 0x hex string">
                            <i class="bi @(_isBinaryHexCopied ? "bi-check-lg text-success" : "bi-clipboard")"></i>
                            <span>@(_isBinaryHexCopied ? "Hex Copied!" : "Copy Hex")</span>
                        </button>
                        @if (_activeBinaryIsImage)
                        {
                            <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" @onclick="CopyBinaryBase64Async" title="Copy base64 data URI">
                                <i class="bi @(_isBinaryBase64Copied ? "bi-check-lg text-success" : "bi-code-square")"></i>
                                <span>@(_isBinaryBase64Copied ? "Base64 Copied!" : "Copy Base64")</span>
                            </button>
                        }
                    </div>

                    @if (_activeBinaryIsImage || _activeBinaryIsPdf)
                    {
                        <div>
                            @if (_activeBinaryTab == "preview")
                            {
                                <button class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" 
                                        @onclick='() => _activeBinaryTab = "hex"' 
                                        title="Inspect underlying byte structure and headers">
                                    <i class="bi bi-file-earmark-code"></i>
                                    <span>View Raw Hex</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1 shadow-sm" 
                                        @onclick='() => _activeBinaryTab = "preview"' 
                                        title="@(_activeBinaryIsPdf ? "Return to document preview" : "Return to image preview")">
                                    <i class="bi @(_activeBinaryIsPdf ? "bi-file-earmark-pdf" : "bi-image")"></i>
                                    <span>@(_activeBinaryIsPdf ? "View Document" : "View Image")</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- Body -->
                <div class="modal-body p-3 flex-grow-1 position-relative overflow-auto d-flex flex-column" style="background-color: var(--app-surface); min-height: 200px;">
                    @if ((_activeBinaryIsImage || _activeBinaryIsPdf) && _activeBinaryTab == "preview")
                    {
                        @if (_activeBinaryIsImage)
                        {
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" 
                                 style="background-image: repeating-conic-gradient(#80808020 0% 25%, transparent 0% 50%) 50% / 20px 20px; border-radius: 6px; overflow: auto; min-height: 300px;">
                                <img src="data:@(_activeBinaryMimeType);base64,@(_activeBinaryBase64)" 
                                     alt="Preview" 
                                     style="max-width: 100%; max-height: calc(90vh - 180px); object-fit: contain; box-shadow: 0 4px 20px rgba(0,0,0,0.4); border-radius: 4px;" />
                            </div>
                        }
                        else if (_activeBinaryIsPdf)
                        {
                            <div class="w-100 h-100 flex-grow-1 position-relative rounded overflow-hidden" style="min-height: calc(90vh - 150px); background-color: #525659;">
                                @if (!string.IsNullOrEmpty(_activePdfBlobUrl))
                                {
                                    <iframe src="@($"{_activePdfBlobUrl}#toolbar=0&navpanes=0")" class="w-100 h-100 border-0" style="min-height: calc(90vh - 150px); display: block;" title="PDF Preview"></iframe>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-white" style="min-height: 300px;">
                                        <span class="spinner-border spinner-border-sm me-2"></span> Loading PDF...
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="w-100 h-100 position-relative">
                            <div class="m-0 p-3 h-100 w-100 rounded overflow-auto" 
                                 style="font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace; font-size: 0.85rem; line-height: 1.6; background-color: var(--app-surface-secondary); color: var(--app-text); border: 1px solid var(--app-border); word-break: break-all; white-space: pre-wrap; max-height: calc(90vh - 150px); user-select: text;">@_activeBinaryRawHex</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [Parameter]
    public object? Data { get; set; }

    [Parameter]
    public long? ExecutionTimeMs { get; set; }

    [Parameter]
    public EventCallback<ExportStatus> OnExportStateChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenCodeInNewTab { get; set; }

    [Parameter]
    public EventCallback OnToggleSearch { get; set; }

    private bool IsTextDefinition =>
        Columns.Count == 1 &&
        Columns[0].Equals("Text", StringComparison.OrdinalIgnoreCase) &&
        Rows.Count > 0;

    private string _definitionEditorId = "def-editor-" + Guid.NewGuid().ToString("N");
    private StandaloneCodeEditor? _definitionEditor;
    private bool _isCodeCopied = false;

    private string GetFullCodeText()
    {
        if (!IsTextDefinition) return string.Empty;
        var colName = Columns[0];
        var sb = new System.Text.StringBuilder();
        foreach (var r in Rows)
        {
            if (r.TryGetValue(colName, out var val) && val != null)
            {
                var line = val.ToString() ?? "";
                sb.Append(line);
                if (!line.EndsWith("\n") && !line.EndsWith("\r"))
                {
                    sb.AppendLine();
                }
            }
        }
        return sb.ToString();
    }

    private StandaloneEditorConstructionOptions DefinitionEditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "sql",
            Value = GetFullCodeText(),
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            ReadOnly = true,
            Minimap = new EditorMinimapOptions { Enabled = true },
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            FontSize = 13,
            WordWrap = "off",
            Scrollbar = new EditorScrollbarOptions { UseShadows = false }
        };
    }

    private async Task CopyFullCodeAsync()
    {
        var text = GetFullCodeText();
        if (!string.IsNullOrEmpty(text))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
                _isCodeCopied = true;
                StateHasChanged();
                _ = Task.Delay(2000).ContinueWith(_ =>
                {
                    _isCodeCopied = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            catch { }
        }
    }

    private async Task HandleOpenInNewTab()
    {
        var code = GetFullCodeText();
        if (!string.IsNullOrEmpty(code))
        {
            await OnOpenCodeInNewTab.InvokeAsync(code);
        }
    }

    public record ExportStatus(bool IsExporting, bool IsSuccess, Action CancelAction, string Format = "Excel");

    private QueryResultTable? _tableStore;
    private List<IDictionary<string, object>> Rows = new();
    
    // Export State
    private bool IsExporting = false;
    private bool IsExportDropdownOpen = false;
    private bool ShowExportSuccess = false;
    private CancellationTokenSource? _exportCts;

    // Selection & Context Menu State
    private HashSet<(int Row, int Col)> SelectedCells = new();
    private (int Row, int Col) _lastSelectedCell = (-1, -1);
    private bool ShowContextMenuState = false;
    private bool IsColumnContextMenu = false;
    private double RowContextMenuX = 0;
    private double RowContextMenuY = 0;
    private string ContextMenuColumn = "";
    private string _contextMenuId = "ctxMenu_" + Guid.NewGuid().ToString("N");
    private bool _shouldPositionContextMenu = false;
    private string? _copyFeedbackMessage = null;
    private CancellationTokenSource? _copyFeedbackCts;


    
    // Aggregates State
    private string? ActiveAggregateColumn = null;
    private int AggCount = 0;
    private int AggDistinct = 0;
    private double? AggSum = null;
    private double? AggAverage = null;
    private object? AggMin = null;
    private object? AggMax = null;
    private List<string> Columns = new();

    [Parameter]
    public int ResultSetIndex { get; set; } = 1;

    [Parameter]
    public int TotalResultSets { get; set; } = 1;

    [Parameter]
    public string SearchTerm { get; set; } = "";

    [Parameter]
    public bool SearchCaseSensitive { get; set; } = false;

    [Parameter]
    public bool SearchMatchWholeWord { get; set; } = false;

    [Parameter]
    public bool SearchExactMatch { get; set; } = false;

    private string _tableContainerId = "gridTable_" + Guid.NewGuid().ToString("N");
    private Dictionary<string, double> _columnWidths = new();
    private DotNetObjectReference<ResultSetGrid>? _dotNetRef;

    private string GetColumnWidthStyle(string col)
    {
        if (_columnWidths.TryGetValue(col, out var w))
        {
            return $"width: {w}px; min-width: {w}px; max-width: {Math.Max(w, 1200)}px; overflow: hidden;";
        }
        return "min-width: 80px; max-width: 800px; overflow: hidden;";
    }

    [JSInvokable]
    public void SetColumnWidth(string columnName, double width)
    {
        if (!string.IsNullOrEmpty(columnName))
        {
            _columnWidths[columnName] = width;
        }
    }

    private object? _lastDataRef;
    private bool _shouldResetScroll = false;

    private void InitializeSmartColumnWidths()
    {
        if (Columns.Count == 0) return;
        int sampleCount = Math.Min(15, TotalDataCount);

        for (int c = 0; c < Columns.Count; c++)
        {
            var col = Columns[c];
            int headerChars = col.Length;
            int maxDataChars = 0;

            for (int r = 0; r < sampleCount; r++)
            {
                var raw = GetRawCellValue(r, c, col);
                var formatted = FormatCellValue(raw, c);
                if (!string.IsNullOrEmpty(formatted))
                {
                    maxDataChars = Math.Max(maxDataChars, formatted.Length);
                }
            }

            double headerWidth = headerChars * 6.5 + 34 + (!string.IsNullOrEmpty(GetColumnDateFormat(c)) ? 18 : 0);
            double dataWidth = maxDataChars > 0 ? (maxDataChars * 6.2 + 16) : 0;
            double estimatedWidth = Math.Clamp(Math.Max(headerWidth, dataWidth), 52, 420);
            _columnWidths[col] = Math.Round(estimatedWidth);
        }
    }

    protected override void OnParametersSet()
    {
        ClearCellSelection();


        _columnDateFormatCache.Clear();
        bool isNewData = !ReferenceEquals(Data, _lastDataRef);
        if (isNewData)
        {
            _lastDataRef = Data;
            _currentScrollTop = 0;
            _renderedFirstVisible = -1;
            _shouldResetScroll = true;
            _columnWidths.Clear();
        }

        if (Data is QueryResultTable qrt)
        {
            _tableStore = qrt;
            Columns = qrt.Columns.ToList();
            Rows.Clear();
        }
        else if (Data is IEnumerable<object> en)
        {
            _tableStore = null;
            Rows = en.Select(d => (IDictionary<string, object>)d).ToList();
            if (Rows.Any())
            {
                Columns = Rows.First().Keys.ToList();
            }
        }
        else
        {
            _tableStore = null;
            Columns.Clear();
            Rows.Clear();
            _columnWidths.Clear();
        }

        if (isNewData && Columns.Count > 0)
        {
            InitializeSmartColumnWidths();
        }

        ApplyFilter();
        ApplySorting();
        _renderedFirstVisible = -1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShowContextMenuState && _shouldPositionContextMenu)
        {
            _shouldPositionContextMenu = false;
            try
            {
                await JS.InvokeVoidAsync("positionContextMenu", _contextMenuId, RowContextMenuX, RowContextMenuY);
            }
            catch { }
        }

        if (_shouldResetScroll)
        {
            _shouldResetScroll = false;
            try
            {
                await JS.InvokeVoidAsync("resetGridScrollTop", _tableContainerId);
            }
            catch { }
        }

        if (IsTextDefinition && _definitionEditor != null)
        {
            try
            {
                var currentText = GetFullCodeText();
                var editorVal = await _definitionEditor.GetValue();
                if (editorVal != currentText)
                {
                    await _definitionEditor.SetValue(currentText);
                }
            }
            catch { }
        }
        else if (!IsTextDefinition && Columns.Count > 0)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("initGridColumnResizers", _tableContainerId, _dotNetRef);
                await JS.InvokeVoidAsync("initGridVirtualScroll", _tableContainerId, _dotNetRef, ActiveRowCount);
            }
            catch { }
        }
    }

    private int TotalDataCount => _tableStore?.RowCount ?? Rows.Count;
    private int ActiveRowCount => _filteredIndices != null ? _filteredIndices.Length : TotalDataCount;

    private int GetActualRowIndex(int displayIndex)
    {
        int idx = _filteredIndices != null ? _filteredIndices[displayIndex] : displayIndex;
        return _sortedIndices != null ? _sortedIndices[idx] : idx;
    }

    private object? GetRawCellValue(int actualRowIndex, int colIndex, string colName)
    {
        if (_tableStore != null)
        {
            return _tableStore.GetValue(actualRowIndex, colIndex);
        }
        if (actualRowIndex >= 0 && actualRowIndex < Rows.Count)
        {
            Rows[actualRowIndex].TryGetValue(colName, out var v);
            return v;
        }
        return null;
    }

    private readonly Dictionary<int, string?> _columnDateFormatCache = new();

    private string? GetColumnDataType(int colIdx)
    {
        if (_tableStore != null)
        {
            return _tableStore.GetColumnType(colIdx);
        }
        return null;
    }

    private string? GetColumnDateFormat(int colIdx)
    {
        if (_columnDateFormatCache.TryGetValue(colIdx, out var cached))
        {
            return cached;
        }

        string? format = null;
        var typeName = GetColumnDataType(colIdx)?.ToLowerInvariant();
        if (!string.IsNullOrEmpty(typeName))
        {
            format = typeName switch
            {
                "datetime2" => "yyyy-MM-dd HH:mm:ss.fffffff",
                "datetime" => "yyyy-MM-dd HH:mm:ss.fff",
                "date" => "yyyy-MM-dd",
                "time" => "HH:mm:ss.fffffff",
                "smalldatetime" => "yyyy-MM-dd HH:mm:ss",
                "datetimeoffset" => "yyyy-MM-dd HH:mm:ss.fffffff zzz",
                _ => null
            };
        }

        if (format == null && TotalDataCount > 0 && colIdx >= 0 && colIdx < Columns.Count)
        {
            int checkLimit = Math.Min(10, TotalDataCount);
            for (int r = 0; r < checkLimit; r++)
            {
                var sample = GetRawCellValue(r, colIdx, Columns[colIdx]);
                if (sample == null) continue;
                if (sample is DateTime dt)
                {
                    if (dt.Ticks % TimeSpan.TicksPerMillisecond != 0)
                        format = "yyyy-MM-dd HH:mm:ss.fffffff";
                    else if (dt.Millisecond != 0)
                        format = "yyyy-MM-dd HH:mm:ss.fff";
                    else if (dt.TimeOfDay == TimeSpan.Zero)
                        format = "yyyy-MM-dd";
                    else
                        format = "yyyy-MM-dd HH:mm:ss";
                    break;
                }
                if (sample is DateTimeOffset)
                {
                    format = "yyyy-MM-dd HH:mm:ss.fffffff zzz";
                    break;
                }
                if (sample is DateOnly)
                {
                    format = "yyyy-MM-dd";
                    break;
                }
                if (sample is TimeOnly || sample is TimeSpan)
                {
                    format = "HH:mm:ss.fffffff";
                    break;
                }
                break;
            }
        }

        _columnDateFormatCache[colIdx] = format;
        return format;
    }

    private string? FormatCellValue(object? rawVal, int colIdx = -1)
    {
        if (rawVal == null) return null;
        if (rawVal is DateTime dt)
        {
            var typeName = colIdx >= 0 ? GetColumnDataType(colIdx)?.ToLowerInvariant() : null;
            if (typeName == "date")
                return dt.ToString("yyyy-MM-dd");
            if (typeName == "datetime")
                return dt.ToString("yyyy-MM-dd HH:mm:ss.fff");
            if (typeName == "smalldatetime")
                return dt.ToString("yyyy-MM-dd HH:mm:ss");
            if (typeName == "datetime2")
                return dt.ToString("yyyy-MM-dd HH:mm:ss.fffffff");

            // Intelligent fallback when column type is not explicitly known
            if (dt.Ticks % TimeSpan.TicksPerMillisecond != 0)
                return dt.ToString("yyyy-MM-dd HH:mm:ss.fffffff");
            if (dt.Millisecond != 0)
                return dt.ToString("yyyy-MM-dd HH:mm:ss.fff");
            if (dt.TimeOfDay == TimeSpan.Zero)
                return dt.ToString("yyyy-MM-dd");
            return dt.ToString("yyyy-MM-dd HH:mm:ss");
        }
        if (rawVal is DateTimeOffset dto)
        {
            return dto.ToString("yyyy-MM-dd HH:mm:ss.fffffff zzz");
        }

        if (rawVal is DateOnly d)
        {
            return d.ToString("yyyy-MM-dd");
        }

        if (rawVal is TimeOnly to)
        {
            return to.ToString("HH:mm:ss.fffffff");
        }

        if (rawVal is TimeSpan ts)
        {
            var typeName = colIdx >= 0 ? GetColumnDataType(colIdx)?.ToLowerInvariant() : null;
            if (typeName == "time")
            {
                return ts.ToString(@"hh\:mm\:ss\.fffffff");
            }
        }
        if (rawVal is byte[] b) return BinaryDataHelper.FormatBinaryForDisplay(b);
        return rawVal.ToString();
    }

    private string? GetColumnValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val))
        {
            int colIdx = _tableStore != null ? _tableStore.GetColumnIndex(column) : Columns.IndexOf(column);
            return FormatCellValue(val, colIdx);
        }
        return null;
    }

    private const int RowHeight = 24;
    private const double MaxVirtualHeight = 10_000_000.0;
    private double _currentScrollTop = 0;
    private double _viewportHeight = 450;
    private int _renderedFirstVisible = -1;
    private int _lastStartIndex = 0;
    private int _lastEndIndex = 0;
    private int _lastTopSpacerHeight = 0;
    private int _lastBottomSpacerHeight = 0;

    private int[]? _sortedIndices = null;
    private int[]? _filteredIndices = null;
    private string? SortColumn = null;
    private bool SortAscending = true;

    private bool _isAllSelected = false;
    private HashSet<int> SelectedEntireRows = new();
    private HashSet<int> SelectedEntireCols = new();

    private int GetViewportRows()
    {
        return Math.Max(1, (int)((_viewportHeight - 36) / RowHeight));
    }

    private int CalculateFirstVisible(int count, int viewportRows, out bool isScaled)
    {
        isScaled = count * (double)RowHeight > MaxVirtualHeight;
        if (!isScaled)
        {
            return Math.Clamp((int)(_currentScrollTop / RowHeight), 0, Math.Max(0, count - viewportRows));
        }
        else
        {
            double maxScroll = Math.Max(1.0, MaxVirtualHeight - _viewportHeight);
            double scrollFraction = Math.Clamp(_currentScrollTop / maxScroll, 0.0, 1.0);
            return Math.Clamp((int)(scrollFraction * (count - viewportRows)), 0, Math.Max(0, count - viewportRows));
        }
    }

    private void ComputeVirtualSlice(out int startIndex, out int endIndex, out int topSpacerHeight, out int bottomSpacerHeight)
    {
        int count = ActiveRowCount;
        if (count == 0)
        {
            startIndex = 0;
            endIndex = 0;
            topSpacerHeight = 0;
            bottomSpacerHeight = 0;
            return;
        }

        int viewportRows = GetViewportRows();
        int buffer = 25;

        int firstVisible = CalculateFirstVisible(count, viewportRows, out bool isScaled);

        if (_renderedFirstVisible < 0 || Math.Abs(firstVisible - _renderedFirstVisible) >= 4 || firstVisible <= 5 || firstVisible >= count - viewportRows - 5)
        {
            _renderedFirstVisible = firstVisible;
            _lastStartIndex = Math.Max(0, firstVisible - buffer);
            _lastEndIndex = Math.Min(count, firstVisible + viewportRows + buffer);

            double totalVirtualHeight = isScaled ? MaxVirtualHeight : count * (double)RowHeight;
            int renderedRowsHeight = (_lastEndIndex - _lastStartIndex) * RowHeight;

            if (_lastStartIndex <= 0)
            {
                _lastTopSpacerHeight = 0;
                _lastBottomSpacerHeight = Math.Max(0, (int)(totalVirtualHeight - renderedRowsHeight));
            }
            else if (_lastEndIndex >= count)
            {
                _lastBottomSpacerHeight = 0;
                _lastTopSpacerHeight = Math.Max(0, (int)(totalVirtualHeight - renderedRowsHeight));
            }
            else
            {
                if (!isScaled)
                {
                    _lastTopSpacerHeight = _lastStartIndex * RowHeight;
                    _lastBottomSpacerHeight = (count - _lastEndIndex) * RowHeight;
                }
                else
                {
                    int bufferBefore = firstVisible - _lastStartIndex;
                    int bufferPixelHeight = bufferBefore * RowHeight;
                    _lastTopSpacerHeight = Math.Max(0, (int)_currentScrollTop - bufferPixelHeight);
                    _lastBottomSpacerHeight = Math.Max(0, (int)(totalVirtualHeight - _lastTopSpacerHeight - renderedRowsHeight));
                }
            }
        }

        startIndex = _lastStartIndex;
        endIndex = _lastEndIndex;
        topSpacerHeight = _lastTopSpacerHeight;
        bottomSpacerHeight = _lastBottomSpacerHeight;
    }

    [JSInvokable]
    public void OnVirtualScroll(double scrollTop, double clientHeight)
    {
        _currentScrollTop = Math.Max(0, scrollTop);
        if (clientHeight > 50) _viewportHeight = clientHeight;

        int count = ActiveRowCount;
        if (count == 0) return;

        int viewportRows = GetViewportRows();
        int firstVisible = CalculateFirstVisible(count, viewportRows, out _);

        if (_renderedFirstVisible < 0 || Math.Abs(firstVisible - _renderedFirstVisible) >= 4 || firstVisible <= 5 || firstVisible >= count - viewportRows - 5)
        {
            StateHasChanged();
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            _filteredIndices = null;
            return;
        }

        int total = TotalDataCount;
        if (total == 0)
        {
            _filteredIndices = Array.Empty<int>();
            return;
        }

        var matches = new List<int>();
        var search = SearchCaseSensitive ? SearchTerm : SearchTerm.ToLowerInvariant();
        int colCount = Columns.Count;

        for (int i = 0; i < total; i++)
        {
            bool matched = false;
            for (int c = 0; c < colCount; c++)
            {
                var val = GetRawCellValue(i, c, Columns[c]);
                if (val == null) continue;
                var str = FormatCellValue(val, c);
                if (string.IsNullOrEmpty(str)) continue;

                var compStr = SearchCaseSensitive ? str : str.ToLowerInvariant();
                if (SearchExactMatch)
                {
                    if (compStr == search) { matched = true; break; }
                }
                else if (SearchMatchWholeWord)
                {
                    if (compStr.Split(' ', '.', '_', '-', ',', ';', ':', '/', '\\').Contains(search))
                    {
                        matched = true; break;
                    }
                }
                else
                {
                    if (compStr.Contains(search)) { matched = true; break; }
                }
            }
            if (matched) matches.Add(i);
        }

        _filteredIndices = matches.ToArray();
    }

    private void SortBy(string column)
    {
        ClearCellSelection();

        if (SortColumn == column)
        {
            if (SortAscending)
            {
                SortAscending = false;
            }
            else
            {
                SortColumn = null;
                _sortedIndices = null;
                return;
            }
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }

        ApplySorting();
        _renderedFirstVisible = -1;
    }

    private void ApplySorting()
    {
        if (string.IsNullOrEmpty(SortColumn))
        {
            _sortedIndices = null;
            return;
        }

        int total = TotalDataCount;
        if (total == 0) return;

        int colIdx = _tableStore != null ? _tableStore.GetColumnIndex(SortColumn) : Columns.IndexOf(SortColumn);
        if (colIdx < 0) return;

        var indices = new int[total];
        for (int i = 0; i < total; i++) indices[i] = i;

        Array.Sort(indices, (a, b) =>
        {
            var valA = GetRawCellValue(a, colIdx, SortColumn);
            var valB = GetRawCellValue(b, colIdx, SortColumn);
            int cmp = CompareCellValues(valA, valB);
            return SortAscending ? cmp : -cmp;
        });

        _sortedIndices = indices;
    }

    private int CompareCellValues(object? a, object? b)
    {
        if (a == null && b == null) return 0;
        if (a == null) return -1;
        if (b == null) return 1;

        if (a is IComparable compA && a.GetType() == b.GetType())
        {
            return compA.CompareTo(b);
        }

        if (a is byte[] bytesA && b is byte[] bytesB)
        {
            return bytesA.Length.CompareTo(bytesB.Length);
        }

        return string.Compare(a.ToString(), b.ToString(), StringComparison.OrdinalIgnoreCase);
    }

