    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (e.Key.Equals("c", StringComparison.OrdinalIgnoreCase))
            {
                if (SelectedCells.Count > 0 || SelectedEntireRows.Count > 0 || SelectedEntireCols.Count > 0 || _isAllSelected)
                {
                    if (e.ShiftKey)
                    {
                        await CopySelectedWithHeadersAsync();
                    }
                    else
                    {
                        await CopySelectedAsync();
                    }
                }
            }
            else if (e.Key.Equals("a", StringComparison.OrdinalIgnoreCase))
            {
                SelectAllCurrentPage();
            }
            else if (e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
            {
                if (OnToggleSearch.HasDelegate)
                {
                    await OnToggleSearch.InvokeAsync();
                }
            }
        }
        else if (e.Key == "Escape")
        {
            HideContextMenu();
            ClearCellSelection();

            StateHasChanged();
        }
    }

