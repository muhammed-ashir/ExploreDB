    {
        ToggleSelectAll();
    }

    private void ShowColumnHeaderContextMenu(MouseEventArgs e, int colIndex, string colName)
    {
        HideContextMenu();
        ContextMenuColumn = colName;
        IsColumnContextMenu = true;
        if (!SelectedEntireCols.Contains(colIndex) && !_isAllSelected)
        {
            ClearCellSelection();

            SelectedEntireCols.Add(colIndex);
            _lastSelectedCell = (0, colIndex);
        }
        RowContextMenuX = e.ClientX;
        RowContextMenuY = e.ClientY;
        ShowContextMenuState = true;
        _shouldPositionContextMenu = true;
    }

    private void ShowCellContextMenu(MouseEventArgs e, int actualRowIndex, int colIndex)
    {
        HideContextMenu();
        IsColumnContextMenu = false;
        if (colIndex >= 0 && colIndex < Columns.Count)
        {
            ContextMenuColumn = Columns[colIndex];
        }
        var coord = (actualRowIndex, colIndex);
        if (!IsCellSelected(actualRowIndex, colIndex))
        {
            ClearCellSelection();

            if (actualRowIndex >= 0 && actualRowIndex < TotalDataCount && colIndex >= 0 && colIndex < Columns.Count)
            {
                SelectedCells.Add(coord);
                _lastSelectedCell = coord;
            }
        }
        RowContextMenuX = e.ClientX;
        RowContextMenuY = e.ClientY;
        ShowContextMenuState = true;
        _shouldPositionContextMenu = true;
    }

    private void ShowRowHeaderContextMenu(MouseEventArgs e, int actualRowIndex)
    {
        HideContextMenu();
        IsColumnContextMenu = false;
        ContextMenuColumn = "";
        if (actualRowIndex >= 0 && actualRowIndex < TotalDataCount)
        {
            if (!SelectedEntireRows.Contains(actualRowIndex) && !_isAllSelected)
            {
                ClearCellSelection();

                SelectedEntireRows.Add(actualRowIndex);
                _lastSelectedCell = (actualRowIndex, 0);
            }
        }
        else
        {
            if (!_isAllSelected && SelectedCells.Count == 0 && SelectedEntireRows.Count == 0)
            {
                _isAllSelected = true;
            }
        }
        RowContextMenuX = e.ClientX;
        RowContextMenuY = e.ClientY;
        ShowContextMenuState = true;
        _shouldPositionContextMenu = true;
    }

    private byte[]? SelectedSingleCellByteValue
    {
        get
        {
            if (SelectedCells.Count == 1 && !_isAllSelected && SelectedEntireRows.Count == 0 && SelectedEntireCols.Count == 0)
            {
                var (r, c) = SelectedCells.First();
                if (r >= 0 && r < TotalDataCount && c >= 0 && c < Columns.Count)
                {
                    var raw = GetRawCellValue(r, c, Columns[c]);
                    if (raw is byte[] bytes) return bytes;
                }
            }
            return null;
        }
    }

    private const int MaxClipboardChars = 120_000_000;
    private const int MaxJsClipboardFallbackChars = 20_000_000;
    private const string ClipboardBusyMessage = "Copy already in progress...";
    private const string ClipboardTooLargeMessage = "Selection too large for clipboard — use Export to CSV";
    private const string ClipboardWriteFailedMessage = "Copy failed — selection too large or clipboard locked";
    private volatile bool _isClipboardCopyBusy = false;

    private sealed record GridDataSnapshot(
        QueryResultTable? TableStore,
        List<IDictionary<string, object>>? LegacyRows,
        List<string> Columns,
        int[]? ViewIndices,
        int TotalDataCount,
        int ActiveRowCount);

    private sealed record ClipboardBuildResult(
        string Text,
        int CopiedRows,
        int TotalTargetRows,
        int CopiedCols,
        bool WasCapped,
        bool OutOfMemory);

    private GridDataSnapshot CaptureGridSnapshot()
    {
        var tableStore = _tableStore;
        var legacyRows = tableStore == null ? Rows.ToList() : null;
        int total = tableStore?.RowCount ?? legacyRows!.Count;
        var viewIndices = _viewIndices;
        int active = viewIndices != null ? viewIndices.Length : total;
        return new GridDataSnapshot(tableStore, legacyRows, Columns.ToList(), viewIndices, total, active);
    }

    private static object? GetSnapshotRawCellValue(GridDataSnapshot snap, int actualRowIndex, int colIndex)
    {
        if (snap.TableStore != null)
        {
            return snap.TableStore.GetValue(actualRowIndex, colIndex);
        }
        if (snap.LegacyRows != null && (uint)actualRowIndex < (uint)snap.LegacyRows.Count && (uint)colIndex < (uint)snap.Columns.Count)
        {
            snap.LegacyRows[actualRowIndex].TryGetValue(snap.Columns[colIndex], out var v);
            return v;
        }
        return null;
    }

    private static string FormatSnapshotClipboardCell(GridDataSnapshot snap, int actualRowIndex, int colIndex)
    {
        if (snap.TableStore != null)
        {
            if (snap.TableStore.IsNull(actualRowIndex, colIndex))
            {
                return "NULL";
            }
            if (snap.TableStore.IsBinaryColumn(colIndex))
            {
                var b = snap.TableStore.GetBinaryBytes(actualRowIndex, colIndex);
                if (b != null)
                {
                    return b.Length <= BinaryDataHelper.ShortBinaryThreshold
                        ? BinaryDataHelper.ToHexString(b, prefix: true)
                        : BinaryDataHelper.FormatBinaryForDisplay(b);
                }
            }
            return snap.TableStore.FormatCellForDisplay(actualRowIndex, colIndex) ?? "NULL";
        }

        var raw = GetSnapshotRawCellValue(snap, actualRowIndex, colIndex);
        if (raw is byte[] bytes)
        {
            return bytes.Length <= BinaryDataHelper.ShortBinaryThreshold
                ? BinaryDataHelper.ToHexString(bytes, prefix: true)
                : BinaryDataHelper.FormatBinaryForDisplay(bytes);
        }
        return FormatSnapshotCellValue(null, raw, colIndex) ?? "NULL";
    }

    private static List<int> ResolveTargetColumns(
        int colCount,
        bool isAllSelected,
        List<int> selectedCols,
        List<int> selectedRows,
        List<(int Row, int Col)> selectedCells)
    {
        if (isAllSelected || selectedRows.Count > 0)
        {
            return Enumerable.Range(0, colCount).ToList();
        }

        var colSet = new HashSet<int>();
        foreach (var c in selectedCols)
        {
            if ((uint)c < (uint)colCount) colSet.Add(c);
        }
        foreach (var cell in selectedCells)
        {
            if ((uint)cell.Col < (uint)colCount) colSet.Add(cell.Col);
        }

        var cols = colSet.ToList();
        cols.Sort();
        return cols;
    }

    private static List<int> ResolveExplicitRowsInDisplayOrder(
        GridDataSnapshot snap,
        IEnumerable<int>? entireRows,
        IEnumerable<(int Row, int Col)>? cells)
    {
        var rowSet = new HashSet<int>();
        if (entireRows != null)
        {
            foreach (var r in entireRows)
            {
                if ((uint)r < (uint)snap.TotalDataCount) rowSet.Add(r);
            }
        }
        if (cells != null)
        {
            foreach (var cell in cells)
            {
                if ((uint)cell.Row < (uint)snap.TotalDataCount) rowSet.Add(cell.Row);
            }
        }
        if (rowSet.Count == 0) return new List<int>();

        if (snap.ViewIndices == null)
        {
            var sorted = rowSet.ToList();
            sorted.Sort();
            return sorted;
        }

        var ordered = new List<int>(rowSet.Count);
        if (rowSet.Count <= 4)
        {
            var keyed = new List<(int DisplayIdx, int ActualIdx)>(rowSet.Count);
            foreach (var r in rowSet)
            {
                int d = Array.IndexOf(snap.ViewIndices, r);
                keyed.Add((d >= 0 ? d : int.MaxValue, r));
            }
            keyed.Sort((a, b) =>
            {
                int cmp = a.DisplayIdx.CompareTo(b.DisplayIdx);
                return cmp != 0 ? cmp : a.ActualIdx.CompareTo(b.ActualIdx);
            });
            foreach (var item in keyed) ordered.Add(item.ActualIdx);
            return ordered;
        }

        for (int i = 0; i < snap.ViewIndices.Length; i++)
        {
            int actual = snap.ViewIndices[i];
            if (rowSet.Remove(actual))
            {
                ordered.Add(actual);
                if (rowSet.Count == 0) break;
            }
        }
        if (rowSet.Count > 0)
        {
            var remaining = rowSet.ToList();
            remaining.Sort();
            ordered.AddRange(remaining);
        }
        return ordered;
    }

    private async Task<bool> TryWriteClipboardAsync(string text)
    {
        if (string.IsNullOrEmpty(text)) return false;

        if (await WindowManager.TrySetClipboardTextAsync(text))
        {
            return true;
        }

        if (text.Length <= MaxJsClipboardFallbackChars)
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
                return true;
            }
            catch { }
        }
        return false;
    }

    private static ClipboardBuildResult BuildClipboardTextFromSnapshot(
        GridDataSnapshot snap,
        bool includeHeaders,
        bool allDisplayRows,
        List<int> targetCols,
        List<int> selectedRows,
        List<(int Row, int Col)> selectedCells)
    {
        List<int>? explicitRows = allDisplayRows
            ? null
            : ResolveExplicitRowsInDisplayOrder(snap, selectedRows, selectedCells);

        int totalTargetRows = allDisplayRows ? snap.ActiveRowCount : explicitRows!.Count;
        if (totalTargetRows == 0 || targetCols.Count == 0)
        {
            return new ClipboardBuildResult(string.Empty, 0, 0, 0, false, false);
        }

        int estimatedCap = (int)Math.Min(16_777_216L, Math.Max(256L, (long)totalTargetRows * targetCols.Count * 12L));
        var sb = new StringBuilder(estimatedCap);
        int copiedRows = 0;
        bool wasCapped = false;

        try
        {
            if (includeHeaders)
            {
                for (int cIdx = 0; cIdx < targetCols.Count; cIdx++)
                {
                    if (cIdx > 0) sb.Append('\t');
                    sb.Append(snap.Columns[targetCols[cIdx]]);
                }
            }

            for (int i = 0; i < totalTargetRows; i++)
            {
                if (copiedRows > 0 && sb.Length >= MaxClipboardChars)
                {
                    wasCapped = true;
                    break;
                }

                if (includeHeaders || copiedRows > 0)
                {
                    sb.Append("\r\n");
                }

                int actualRow = allDisplayRows
                    ? (snap.ViewIndices != null ? snap.ViewIndices[i] : i)
                    : explicitRows![i];

                for (int cIdx = 0; cIdx < targetCols.Count; cIdx++)
                {
                    if (cIdx > 0) sb.Append('\t');
                    sb.Append(FormatSnapshotClipboardCell(snap, actualRow, targetCols[cIdx]));
                }
                copiedRows++;
            }

            return new ClipboardBuildResult(sb.ToString(), copiedRows, totalTargetRows, targetCols.Count, wasCapped, false);
        }
        catch (OutOfMemoryException)
        {
            return new ClipboardBuildResult(string.Empty, 0, totalTargetRows, targetCols.Count, false, true);
        }
    }

    private Task CopySelectedAsync() => CopySelectedCoreAsync(includeHeaders: false);

    private Task CopySelectedWithHeadersAsync() => CopySelectedCoreAsync(includeHeaders: true);

    private async Task CopySelectedCoreAsync(bool includeHeaders)
    {
        HideContextMenu();
        if (_isClipboardCopyBusy)
        {
            ShowCopyFeedback(ClipboardBusyMessage, 2000, CopyFeedbackKind.Warning);
            return;
        }

        var snap = CaptureGridSnapshot();
        if (snap.TotalDataCount == 0 || snap.Columns.Count == 0) return;

        bool isAll = _isAllSelected;
        var colsSelected = SelectedEntireCols.ToList();
        var rowsSelected = SelectedEntireRows.ToList();
        var cellsSelected = SelectedCells.ToList();

        if (!isAll && colsSelected.Count == 0 && rowsSelected.Count == 0 && cellsSelected.Count == 0)
        {
            return;
        }

        if (cellsSelected.Count == 1 && !isAll && rowsSelected.Count == 0 && colsSelected.Count == 0)
        {
            var (r, c) = cellsSelected[0];
            if ((uint)r < (uint)snap.TotalDataCount && (uint)c < (uint)snap.Columns.Count)
            {
                var raw = GetSnapshotRawCellValue(snap, r, c);
                string cellText = raw is byte[] bytes
                    ? BinaryDataHelper.ToHexString(bytes, prefix: true)
                    : (FormatSnapshotCellValue(snap.TableStore, raw, c) ?? "NULL");
                string payload = includeHeaders ? $"{snap.Columns[c]}\r\n{cellText}" : cellText;
                bool singleOk = await TryWriteClipboardAsync(payload);
                if (_disposed) return;
                ShowCopyFeedback(
                    singleOk
                        ? (includeHeaders ? "Copied 1 cell (with headers)" : "Copied 1 cell")
                        : "Copy failed — clipboard unavailable",
                    singleOk ? 3500 : 6000,
                    singleOk ? CopyFeedbackKind.Success : CopyFeedbackKind.Error);
            }
            return;
        }

        var targetCols = ResolveTargetColumns(snap.Columns.Count, isAll, colsSelected, rowsSelected, cellsSelected);
        if (targetCols.Count == 0) return;

        bool allDisplayRows = isAll || colsSelected.Count > 0;
        if (allDisplayRows && snap.ActiveRowCount == 0) return;

        _isClipboardCopyBusy = true;
        try
        {
            var result = await Task.Run(() =>
                BuildClipboardTextFromSnapshot(snap, includeHeaders, allDisplayRows, targetCols, rowsSelected, cellsSelected));

            if (_disposed) return;

            if (result.OutOfMemory)
            {
                ShowCopyFeedback(ClipboardTooLargeMessage, 7000, CopyFeedbackKind.Error);
                return;
            }
            if (string.IsNullOrEmpty(result.Text) || result.CopiedRows == 0) return;

            bool ok = await TryWriteClipboardAsync(result.Text);
            if (_disposed) return;
            if (!ok)
            {
                ShowCopyFeedback(ClipboardWriteFailedMessage, 7000, CopyFeedbackKind.Error);
                return;
            }

            string summary = FormatCopySummary(result, snap.Columns.Count, colsSelected.Count > 0, includeHeaders);
            ShowCopyFeedback(
                summary,
                result.WasCapped ? 7000 : 4000,
                result.WasCapped ? CopyFeedbackKind.Warning : CopyFeedbackKind.Success);
        }
        finally
        {
            _isClipboardCopyBusy = false;
        }
    }

    private static string FormatCopySummary(
        ClipboardBuildResult result,
        int totalColumns,
        bool hasColumnSelection,
        bool includeHeaders)
    {
        string rowWord = result.CopiedRows == 1 ? "row" : "rows";
        string colWord = result.CopiedCols == 1 ? "col" : "cols";

        if (result.WasCapped)
        {
            if (result.CopiedCols == totalColumns)
            {
                return $"Copied {result.CopiedRows:N0} of {result.TotalTargetRows:N0} rows"
                    + (includeHeaders ? " (with headers)" : "")
                    + " — limit reached, use Export to CSV";
            }
            if (hasColumnSelection)
            {
                return $"Copied {result.CopiedRows:N0} of {result.TotalTargetRows:N0} rows ({result.CopiedCols} {colWord}"
                    + (includeHeaders ? ", with headers" : "")
                    + ") — limit reached, use Export to CSV";
            }
            long cappedCells = (long)result.CopiedRows * result.CopiedCols;
            string cappedCellWord = cappedCells == 1 ? "cell" : "cells";
            return $"Copied {cappedCells:N0} {cappedCellWord} ({result.CopiedRows:N0} of {result.TotalTargetRows:N0} rows"
                + (includeHeaders ? ", with headers" : "")
                + ") — limit reached, use Export to CSV";
        }

        if (result.CopiedCols == totalColumns)
        {
            return $"Copied {result.CopiedRows:N0} {rowWord}" + (includeHeaders ? " (with headers)" : "");
        }
        if (hasColumnSelection)
        {
            return $"Copied {result.CopiedRows:N0} {rowWord} ({result.CopiedCols} {colWord}"
                + (includeHeaders ? ", with headers" : "")
                + ")";
        }

        long totalCells = (long)result.CopiedRows * result.CopiedCols;
        string cellWord = totalCells == 1 ? "cell" : "cells";
        return $"Copied {totalCells:N0} {cellWord}" + (includeHeaders ? " (with headers)" : "");
    }

    private string ResolveTargetTableName()
    {
        string rawTable = !string.IsNullOrWhiteSpace(_tableStore?.TableName)
            ? _tableStore.TableName.Trim()
            : "";

        if (string.IsNullOrEmpty(rawTable)) return "[TargetTable]";

        if (rawTable.Contains('.'))
        {
            var parts = rawTable.Split('.');
            var s = parts[0].Trim('[', ']');
            var t = parts[1].Trim('[', ']');
            return $"[{s}].[{t}]";
        }

        var cleanName = rawTable.Trim('[', ']');
        var matched = SchemaService.Tables?.FirstOrDefault(t =>
            t.Name.Equals(cleanName, StringComparison.OrdinalIgnoreCase));
        return matched != null ? matched.FullName : $"[{cleanName}]";
    }

    private async Task CopyAsInsertAsync()
    {
        HideContextMenu();
        if (_isClipboardCopyBusy)
        {
            ShowCopyFeedback(ClipboardBusyMessage, 2000, CopyFeedbackKind.Warning);
            return;
        }

        var snap = CaptureGridSnapshot();
        if (snap.TotalDataCount == 0 || snap.Columns.Count == 0) return;

        bool isAll = _isAllSelected;
        var colsSelected = SelectedEntireCols.ToList();
        var rowsSelected = SelectedEntireRows.ToList();
        var cellsSelected = SelectedCells.ToList();
        int anchorRow = _lastSelectedCell.Row;
        string tableName = ResolveTargetTableName();

        var targetCols = ResolveTargetColumns(snap.Columns.Count, isAll, colsSelected, rowsSelected, cellsSelected);
        if (targetCols.Count == 0)
        {
            targetCols = Enumerable.Range(0, snap.Columns.Count).ToList();
        }

        bool allDisplayRows = isAll || colsSelected.Count > 0;
        if (allDisplayRows && snap.ActiveRowCount == 0) return;

        _isClipboardCopyBusy = true;
        try
        {
            var result = await Task.Run(() =>
            {
                List<int>? explicitRows = null;
                if (!allDisplayRows)
                {
                    explicitRows = ResolveExplicitRowsInDisplayOrder(snap, rowsSelected, cellsSelected);
                    if (explicitRows.Count == 0)
                    {
                        int fallbackRow = (anchorRow >= 0 && anchorRow < snap.TotalDataCount)
                            ? anchorRow
                            : (snap.ViewIndices != null && snap.ActiveRowCount > 0 ? snap.ViewIndices[0] : 0);
                        explicitRows.Add(fallbackRow);
                    }
                }

                int totalTargetRows = allDisplayRows ? snap.ActiveRowCount : explicitRows!.Count;
                if (totalTargetRows == 0)
                {
                    return new ClipboardBuildResult(string.Empty, 0, 0, targetCols.Count, false, false);
                }

                var colNames = string.Join(", ", targetCols.Select(c =>
                {
                    var cleanCol = snap.Columns[c].Replace("[", "").Replace("]", "");
                    return "[" + cleanCol + "]";
                }));
                var sb = new StringBuilder(Math.Min(16_777_216, Math.Max(512, totalTargetRows * 64)));
                sb.AppendLine($"INSERT INTO {tableName} ({colNames})");
                sb.AppendLine("VALUES");

                int copiedRows = 0;
                bool wasCapped = false;

                try
                {
                    for (int i = 0; i < totalTargetRows; i++)
                    {
                        if (copiedRows > 0 && sb.Length >= MaxClipboardChars)
                        {
                            wasCapped = true;
                            break;
                        }

                        if (copiedRows > 0)
                        {
                            sb.AppendLine(",");
                        }

                        int actualRow = allDisplayRows
                            ? (snap.ViewIndices != null ? snap.ViewIndices[i] : i)
                            : explicitRows![i];

                        sb.Append("    (");
                        for (int cIdx = 0; cIdx < targetCols.Count; cIdx++)
                        {
                            if (cIdx > 0) sb.Append(", ");
                            int c = targetCols[cIdx];
                            var raw = GetSnapshotRawCellValue(snap, actualRow, c);
                            sb.Append(FormatSnapshotSqlLiteral(snap.TableStore, raw, c));
                        }
                        sb.Append(")");
                        copiedRows++;
                    }
                    sb.AppendLine(";");

                    return new ClipboardBuildResult(sb.ToString(), copiedRows, totalTargetRows, targetCols.Count, wasCapped, false);
                }
                catch (OutOfMemoryException)
                {
                    return new ClipboardBuildResult(string.Empty, 0, totalTargetRows, targetCols.Count, false, true);
                }
            });

            if (_disposed) return;

            if (result.OutOfMemory)
            {
                ShowCopyFeedback(ClipboardTooLargeMessage, 7000, CopyFeedbackKind.Error);
                return;
            }
            if (string.IsNullOrEmpty(result.Text) || result.CopiedRows == 0) return;

            bool ok = await TryWriteClipboardAsync(result.Text);
            if (_disposed) return;
            if (!ok)
            {
                ShowCopyFeedback(ClipboardWriteFailedMessage, 7000, CopyFeedbackKind.Error);
                return;
            }

            string msg = result.WasCapped
                ? $"Copied {result.CopiedRows:N0} of {result.TotalTargetRows:N0} rows as INSERT — limit reached, use Export to CSV"
                : $"Copied {result.CopiedRows:N0} {(result.CopiedRows == 1 ? "row" : "rows")} as INSERT";
            ShowCopyFeedback(msg, result.WasCapped ? 7000 : 4000, result.WasCapped ? CopyFeedbackKind.Warning : CopyFeedbackKind.Success);
        }
        finally
        {
            _isClipboardCopyBusy = false;
        }
    }

    private string FormatSqlLiteral(object? val, int colIndex)
        => FormatSnapshotSqlLiteral(_tableStore, val, colIndex);

    private static string FormatSnapshotSqlLiteral(QueryResultTable? tableStore, object? val, int colIndex)
    {
        if (val == null || val is DBNull)
        {
            return "NULL";
        }

        if (val is byte[] bytes)
        {
            return BinaryDataHelper.ToHexString(bytes, prefix: true);
        }

        if (val is bool b)
        {
            return b ? "1" : "0";
        }

        if (val is sbyte or byte or short or ushort or int or uint or long or ulong)
        {
            return Convert.ToString(val, CultureInfo.InvariantCulture)!;
        }

        if (val is float f)
        {
            return f.ToString(CultureInfo.InvariantCulture);
        }

        if (val is double d)
        {
            return d.ToString(CultureInfo.InvariantCulture);
        }

        if (val is decimal dec)
        {
            return dec.ToString(CultureInfo.InvariantCulture);
        }

        if (val is DateTime dt)
        {
            if (dt.Millisecond > 0)
                return $"'{dt:yyyy-MM-dd HH:mm:ss.fff}'";
            if (dt.TimeOfDay == TimeSpan.Zero)
                return $"'{dt:yyyy-MM-dd}'";
            return $"'{dt:yyyy-MM-dd HH:mm:ss}'";
        }

        if (val is DateTimeOffset dto)
        {
            return $"'{dto:yyyy-MM-dd HH:mm:ss.fff zzz}'";
        }

        if (val is TimeSpan ts)
        {
            return $"'{ts:c}'";
        }

        if (val is Guid g)
        {
            return $"'{g}'";
        }

        string colType = tableStore?.GetColumnType(colIndex)?.ToLowerInvariant() ?? "";
        if (colType is "int" or "bigint" or "smallint" or "tinyint" or "bit")
        {
            var str = val.ToString()?.Trim();
            if (long.TryParse(str, out var num)) return num.ToString(CultureInfo.InvariantCulture);
            if (bool.TryParse(str, out var bVal)) return bVal ? "1" : "0";
        }
        if (colType is "decimal" or "numeric" or "money" or "smallmoney" or "float" or "real")
        {
            var str = val.ToString()?.Trim();
            if (decimal.TryParse(str, NumberStyles.Any, CultureInfo.InvariantCulture, out var num))
                return num.ToString(CultureInfo.InvariantCulture);
        }

        var text = val.ToString() ?? "";
        var escaped = text.Replace("'", "''");
        bool isUnicode = colType.StartsWith("n", StringComparison.OrdinalIgnoreCase) || text.Any(c => c > 127);
        return isUnicode ? $"N'{escaped}'" : $"'{escaped}'";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (e.Key.Equals("c", StringComparison.OrdinalIgnoreCase))
            {
                if (SelectedCells.Count > 0 || SelectedEntireRows.Count > 0 || SelectedEntireCols.Count > 0 || _isAllSelected)
                {
                    if (e.ShiftKey)
                    {
                        await CopySelectedWithHeadersAsync();
                    }
                    else
                    {
                        await CopySelectedAsync();
                    }
                }
            }
            else if (e.Key.Equals("a", StringComparison.OrdinalIgnoreCase))
            {
                SelectAllCurrentPage();
            }
            else if (e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
            {
                if (OnToggleSearch.HasDelegate)
                {
                    await OnToggleSearch.InvokeAsync();
                }
            }
        }
        else if (e.Key == "Escape")
        {
            HideContextMenu();
            ClearCellSelection();

            StateHasChanged();
        }
    }

    private void ShowCopyFeedback(string message, int durationMs = 3500, CopyFeedbackKind kind = CopyFeedbackKind.Success)
    {
        var prevCts = _copyFeedbackCts;
        var cts = new CancellationTokenSource();
        _copyFeedbackCts = cts;
        if (prevCts != null)
        {
            try { prevCts.Cancel(); } catch { }
            try { prevCts.Dispose(); } catch { }
        }
        var token = cts.Token;

        _copyFeedbackMessage = message;
        _copyFeedbackKind = kind;
        StateHasChanged();

        _ = Task.Delay(durationMs, token).ContinueWith(t =>
        {
            if (!t.IsCanceled && !_disposed)
            {
                _copyFeedbackMessage = null;
                InvokeAsync(StateHasChanged);
            }
        });
    }

