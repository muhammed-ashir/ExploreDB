@using System.Collections.Generic
@using System.Linq
@using System.IO
@using System.Threading
@using ClosedXML.Excel
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@inject IJSRuntime JS
@inject ThemeService ThemeService
@implements IDisposable

<div class="position-relative w-100 h-100 d-flex flex-column overflow-hidden" style="min-height: 0;">
@if (Columns.Count > 0)
{
    @if (IsTextDefinition)
    {
        <div class="code-view-container d-flex flex-column mb-3" style="border: 1px solid var(--app-border); border-radius: 6px; overflow: hidden; background-color: var(--app-surface);">
            <!-- Header Toolbar -->
            <div class="d-flex justify-content-between align-items-center px-3 py-2" style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border);">
                <div class="d-flex align-items-center gap-2">
                    @if (ExecutionTimeMs.HasValue)
                    {
                        <span class="text-muted small"><i class="bi bi-stopwatch me-1"></i>@(ExecutionTimeMs.Value)ms</span>
                    }
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" style="color: var(--app-text); border-color: var(--app-border); font-size: 0.8rem;" @onclick="CopyFullCodeAsync" title="Copy code to clipboard">
                        <i class="bi @(_isCodeCopied ? "bi-check-lg text-success" : "bi-clipboard")"></i>
                        <span>@(_isCodeCopied ? "Copied!" : "Copy")</span>
                    </button>
                    @if (OnOpenCodeInNewTab.HasDelegate)
                    {
                        <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.8rem;" @onclick="HandleOpenInNewTab" title="Open code in a new query tab">
                            <i class="bi bi-box-arrow-up-right"></i>
                            <span>Open in New Tab</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Monaco Editor -->
            <div style="height: 520px; min-height: 280px; width: 100%;">
                <StandaloneCodeEditor @ref="_definitionEditor" Id="@_definitionEditorId" ConstructionOptions="DefinitionEditorConstructionOptions" CssClass="w-100 h-100" />
            </div>
        </div>
    }
    else
    {

    <div id="@_tableContainerId" class="table-responsive rounded position-relative flex-grow-1 custom-scrollbar-light" tabindex="0" style="border: 1px solid var(--app-border); outline: none; overflow: auto; min-height: 0; height: 100%; overflow-anchor: none !important;" @onkeydown="HandleKeyDown">
        <table class="result-set-table" style="width: max-content;">
            <thead>
                <tr>
                    <th class="col-index p-0 align-middle text-center" 
                        style="cursor: pointer; user-select: none;" 
                        @onclick="ToggleSelectAll" 
                        @oncontextmenu="e => ShowRowHeaderContextMenu(e, -1)" 
                        @oncontextmenu:preventDefault="true"
                        title="@(_isAllSelected ? "Click to deselect all" : "Click to select all")">
                        <div class="px-2 py-1 d-flex align-items-center justify-content-center" style="font-size: 0.75rem;">
                            <span>#</span>
                            @if (_isAllSelected)
                            {

                            }
                        </div>
                    </th>
                    @for (int cIdx = 0; cIdx < Columns.Count; cIdx++)
                    {
                        var col = Columns[cIdx];
                        int localCol = cIdx;
                        bool isColSelected = IsColumnFullySelected(localCol);
                        <th class="p-0 align-middle @(isColSelected ? "selected-col-header" : "") col-resizable position-relative" 
                            data-col-index="@localCol"
                            data-col-name="@col"
                            style="@GetColumnWidthStyle(col)">
                            <div class="d-flex justify-content-between align-items-center overflow-hidden px-2 py-1 gap-2" 
                                 style="cursor: pointer; user-select: none;" 
                                 title="Click to select column (Ctrl+Click to toggle, Shift+Click for range)"
                                 @onclick="e => OnColumnHeaderClick(e, localCol)" 
                                 @oncontextmenu="e => ShowColumnHeaderContextMenu(e, localCol, col)" 
                                 @oncontextmenu:preventDefault="true">
                                <div class="d-flex align-items-center gap-1 text-truncate flex-grow-1" style="min-width: 0;">
                                    <span class="text-truncate">@col</span>
                                    @{
                                        var dateFormat = GetColumnDateFormat(localCol);
                                    }
                                    @if (!string.IsNullOrEmpty(dateFormat))
                                    {
                                        <i class="bi bi-info-circle text-info flex-shrink-0" 
                                           style="font-size: 0.72rem; opacity: 0.85; cursor: help;" 
                                           title="Format: @dateFormat"
                                           @onclick:stopPropagation="true"></i>
                                    }
                                </div>
                                <button class="btn btn-link p-0 px-1 ms-2 me-1 d-inline-flex align-items-center justify-content-center sort-btn text-decoration-none border-0 shadow-none flex-shrink-0" 
                                        type="button"
                                        title="Sort by @col"
                                        @onclick="() => SortBy(col)" 
                                        @onclick:stopPropagation="true">
                                    @if (SortColumn == col)
                                    {
                                        <i class="bi @(SortAscending ? "bi-sort-up text-warning" : "bi-sort-down text-warning")" style="font-size: 0.95rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-down-up text-muted" style="opacity: 0.45; font-size: 0.85rem;"></i>
                                    }
                                </button>
                            </div>
                            <div class="grid-col-resizer" 
                                 data-col-index="@localCol" 
                                 data-col-name="@col"
                                 title="Drag to resize column (Double-click to auto-fit)">
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    ComputeVirtualSlice(out int startIndex, out int endIndex, out int topSpacerHeight, out int bottomSpacerHeight);
                }
                @if (topSpacerHeight > 0)
                {
                    <tr style="height: @(topSpacerHeight)px; pointer-events: none;">
                        <td colspan="@(Columns.Count + 1)" style="padding: 0; border: none; height: @(topSpacerHeight)px;"></td>
                    </tr>
                }
                @for (int i = startIndex; i < endIndex; i++)
                {
                    int displayIndex = i;
                    int actualIndex = GetActualRowIndex(displayIndex);
                    bool isFullRowSelected = IsRowFullySelected(actualIndex);
                    <tr style="height: @(RowHeight)px;">
                        <td class="col-index text-center align-middle" 
                            style="font-size: 0.75rem; cursor: pointer; user-select: none; padding: 2px 4px; height: @(RowHeight)px;"
                            title="Click to select row (Ctrl+Click to toggle, Shift+Click for range)"
                            @onclick="e => OnRowHeaderClick(e, actualIndex)"
                            @oncontextmenu="e => ShowRowHeaderContextMenu(e, actualIndex)"
                            @oncontextmenu:preventDefault="true">
                            @if (isFullRowSelected)
                            {
                                <span class="d-inline-flex align-items-center justify-content-center">

                                    @(displayIndex + 1)
                                </span>
                            }
                            else
                            {
                                @(displayIndex + 1)
                            }
                        </td>
                        @for (int colIdx = 0; colIdx < Columns.Count; colIdx++)
                        {
                            var col = Columns[colIdx];
                            int localCol = colIdx;
                            var rawCellVal = GetRawCellValue(actualIndex, localCol, col);
                            var val = FormatCellValue(rawCellVal, localCol);
                            bool isCellSelected = IsCellSelected(actualIndex, localCol);
                            <td class="@(isCellSelected ? "selected-cell" : "")"
                                style="white-space: nowrap; max-width: 1px; overflow: hidden; text-overflow: ellipsis; padding: 2px 8px; font-size: 0.78rem; line-height: 1.25; height: @(RowHeight)px;" 
                                title="@val"
                                @onclick="e => OnCellClick(e, actualIndex, localCol)"
                                @oncontextmenu="e => ShowCellContextMenu(e, actualIndex, localCol)"
                                @oncontextmenu:preventDefault="true">
                                @if (val == null) {
                                    <span class="text-muted fst-italic">NULL</span>
                                } else if (rawCellVal is byte[] rawBytes && rawBytes.Length > BinaryDataHelper.ShortBinaryThreshold) {
                                    @if (BinaryDataHelper.IsImage(rawBytes, out var imgFormat, out _)) {
                                        <span class="badge rounded-pill text-info border border-info bg-dark-subtle cursor-pointer d-inline-flex align-items-center gap-1"
                                              style="cursor: pointer; font-size: 0.72rem; padding: 1px 7px; line-height: 1.25;"
                                              @onclick="() => OpenBinaryViewer(rawBytes, col)"
                                              @onclick:stopPropagation
                                              title="Click to view image">
                                            <i class="bi bi-image" style="font-size: 0.7rem;"></i> Image: @imgFormat, @BinaryDataHelper.FormatFileSize(rawBytes.Length)
                                        </span>
                                    } else if (BinaryDataHelper.IsPdf(rawBytes)) {
                                        <span class="badge rounded-pill text-danger border border-danger bg-dark-subtle cursor-pointer d-inline-flex align-items-center gap-1"
                                              style="cursor: pointer; font-size: 0.72rem; padding: 1px 7px; line-height: 1.25;"
                                              @onclick="() => OpenBinaryViewer(rawBytes, col)"
                                              @onclick:stopPropagation
                                              title="Click to view PDF document">
                                            <i class="bi bi-file-earmark-pdf" style="font-size: 0.7rem;"></i> PDF: @BinaryDataHelper.FormatFileSize(rawBytes.Length)
                                        </span>
                                    } else {
                                        <span class="badge rounded-pill text-secondary border border-secondary bg-dark-subtle cursor-pointer d-inline-flex align-items-center gap-1"
                                              style="cursor: pointer; font-size: 0.72rem; padding: 1px 7px; line-height: 1.25;"
                                              @onclick="() => OpenBinaryViewer(rawBytes, col)"
                                              @onclick:stopPropagation
                                              title="Click to view binary data">
                                            <i class="bi bi-file-earmark-binary" style="font-size: 0.7rem;"></i> Binary: @BinaryDataHelper.FormatFileSize(rawBytes.Length)
                                        </span>
                                    }
                                } else if (IsJsonOrXml(val)) {
                                    <span style="color: var(--app-table-header-text); cursor: pointer; text-decoration: underline;" @onclick="() => OpenCodeViewer(val)" @onclick:stopPropagation>@val</span>
                                } else {
                                    @val
                                }
                            </td>
                        }
                    </tr>
                }
                @if (bottomSpacerHeight > 0)
                {
                    <tr style="height: @(bottomSpacerHeight)px; pointer-events: none;">
                        <td colspan="@(Columns.Count + 1)" style="padding: 0; border: none; height: @(bottomSpacerHeight)px;"></td>
                    </tr>
                }
                @if (ActiveRowCount == 0)
                {
                    <tr>
                        <td colspan="@(Columns.Count + 1)" class="text-center text-muted py-4">
                            No matching records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="grid-col-guide" style="display: none;"></div>
    </div>

    @if (!string.IsNullOrEmpty(ActiveAggregateColumn))
    {
        <div class="d-flex justify-content-between align-items-center rounded mt-3 px-3 py-2 shadow-sm" style="font-size: 0.85rem; background-color: var(--app-surface-secondary); border: 1px solid var(--app-border); color: var(--app-text);">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-warning fw-bold">@ActiveAggregateColumn</span>
                <span class="text-muted">|</span>
                <span>COUNT : <strong style="color: var(--app-table-header-text);">@AggCount</strong></span>
                <span class="text-muted">|</span>
                <span>DISTINCT : <strong style="color: var(--app-table-header-text);">@AggDistinct</strong></span>
                @if (AggSum.HasValue)
                {
                    <span class="text-muted">|</span>
                    <span>SUM : <strong style="color: var(--app-table-header-text);">@AggSum</strong></span>
                }
                @if (AggAverage.HasValue)
                {
                    <span class="text-muted">|</span>
                    <span>AVERAGE : <strong style="color: var(--app-table-header-text);">@Math.Round(AggAverage.Value, 2)</strong></span>
                }
                @if (AggMin != null)
                {
                    <span class="text-muted">|</span>
                    <span>MIN : <strong style="color: var(--app-table-header-text);">@AggMin</strong></span>
                }
                @if (AggMax != null)
                {
                    <span class="text-muted">|</span>
                    <span>MAX : <strong style="color: var(--app-table-header-text);">@AggMax</strong></span>
                }
            </div>
            <i class="bi bi-x-lg text-muted ms-3" style="cursor: pointer; font-size: 0.8rem;" @onclick="() => ActiveAggregateColumn = null" onmouseover="this.classList.replace('text-muted', 'text-white')" onmouseout="this.classList.replace('text-white', 'text-muted')"></i>
        </div>
    }


    }
}
else
{
    <div class="alert border text-muted" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">This result set is empty.</div>
}

@if (ShowContextMenuState)
{
    <!-- Invisible overlay to close context menu -->
    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 2050;" @onclick="HideContextMenu" @oncontextmenu="HideContextMenu" @oncontextmenu:preventDefault="true"></div>
    
    <!-- Unified context menu positioned at cursor -->
    <div id="@_contextMenuId" class="position-fixed shadow-lg rounded" 
         style="top: min(@(RowContextMenuY)px, calc(100vh - 280px)); left: min(@(RowContextMenuX)px, calc(100vw - 250px)); z-index: 2060; min-width: 230px; background-color: var(--app-dropdown-bg); border: 1px solid var(--app-border); color: var(--app-text); max-height: calc(100vh - 20px); overflow-y: auto; visibility: hidden;" 
         @onclick:stopPropagation>
        <div class="py-1">
            @if (SelectedSingleCellByteValue is byte[] selectedBytes)
            {
                <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="() => { HideContextMenu(); _ = OpenBinaryViewer(selectedBytes, ContextMenuColumn); }">
                    <i class="bi @(BinaryDataHelper.IsImage(selectedBytes, out _, out _) ? "bi-image text-info" : (BinaryDataHelper.IsPdf(selectedBytes) ? "bi-file-earmark-pdf text-danger" : "bi-file-earmark-binary text-warning")) text-muted"></i>
                    <span>@(BinaryDataHelper.IsImage(selectedBytes, out _, out _) ? "View Image" : (BinaryDataHelper.IsPdf(selectedBytes) ? "View PDF Document" : "View Binary / Hex"))</span>
                </button>
                <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="() => { HideContextMenu(); _ = CopyBinaryHexAsync(selectedBytes); }">
                    <i class="bi bi-file-earmark-code text-muted"></i>
                    <span>Copy Hex (0x...)</span>
                </button>
                <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="() => { HideContextMenu(); _ = DownloadBinaryBytesAsync(selectedBytes, ContextMenuColumn); }">
                    <i class="bi bi-download text-muted"></i>
                    <span>Save to File</span>
                </button>
                <div class="dropdown-divider my-1" style="border-top-color: var(--app-border);"></div>
            }
            <button class="dropdown-item px-3 py-1 d-flex align-items-center justify-content-between grid-ctx-btn" type="button" @onclick="CopySelectedAsync">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-copy text-muted"></i>
                    <span>Copy</span>
                </div>
                <span class="text-muted small ms-3" style="font-size: 0.75rem;">Ctrl+C</span>
            </button>
            <button class="dropdown-item px-3 py-1 d-flex align-items-center justify-content-between grid-ctx-btn" type="button" @onclick="CopySelectedWithHeadersAsync">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-spreadsheet text-muted"></i>
                    <span>Copy with Headers</span>
                </div>
                <span class="text-muted small ms-3" style="font-size: 0.75rem;">Ctrl+Shift+C</span>
            </button>
            <button class="dropdown-item px-3 py-1 d-flex align-items-center justify-content-between grid-ctx-btn" type="button" @onclick="SelectAllCurrentPage">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check2-all text-muted"></i>
                    <span>Select All</span>
                </div>
                <span class="text-muted small ms-3" style="font-size: 0.75rem;">Ctrl+A</span>
            </button>

            <div class="dropdown-divider my-1" style="border-top-color: var(--app-border);"></div>
            @if (CanCopyAsInClause)
            {
                <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="CopyColumnAsInClause">
                <i class="bi bi-clipboard text-muted"></i>
                <span>Copy as IN clause</span>
            </button>
            }
            @if (CanCopyAsInClause)
            {
                <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="CalculateAggregates">
                    <i class="bi bi-calculator text-muted"></i>
                    <span>Show aggregate result</span>
                </button>
            }
            <div class="dropdown-divider my-1" style="border-top-color: var(--app-border);"></div>
            <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="async () => { HideContextMenu(); await ExportToExcelAsync(); }">
                <i class="bi bi-file-earmark-excel text-success fs-6"></i>
                <span>Export to Excel (.xlsx)</span>
            </button>
            <button class="dropdown-item px-3 py-1 d-flex align-items-center gap-2 grid-ctx-btn" type="button" @onclick="async () => { HideContextMenu(); await ExportToCsvAsync(); }">
                <i class="bi bi-file-earmark-text text-primary fs-6"></i>
                <span>Export to CSV (.csv)</span>
            </button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(_copyFeedbackMessage))
{
    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-4 px-3 py-2 rounded-pill shadow-lg d-flex align-items-center gap-2 text-white" 
         style="background-color: rgba(25, 135, 84, 0.95); z-index: 2100; font-size: 0.82rem; pointer-events: none; border: 1px solid rgba(255,255,255,0.2);">
        <i class="bi bi-check2-circle fs-6"></i>
        <span class="fw-medium">@_copyFeedbackMessage</span>
    </div>
}

<style>
    .dropdown-divider + .dropdown-divider {
        display: none !important;
    }
    .table-responsive,
    .result-set-table,
    .result-set-table tbody,
    .result-set-table tr {
        overflow-anchor: none !important;
    }
    .result-set-table,
    .result-set-table th,
    .result-set-table td {
        user-select: none !important;
        -webkit-user-select: none !important;
    }
    .result-set-table thead {
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .result-set-table thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: var(--app-surface-secondary);
    }
    .result-set-table thead th.col-index {
        position: sticky;
        top: 0;
        left: 0;
        z-index: 15;
        background-color: var(--app-surface-secondary);
    }
    .result-set-table tbody td.col-index {
        position: sticky;
        left: 0;
        z-index: 4;
        background-color: var(--app-surface-secondary);
    }
    .grid-ctx-btn {
        color: var(--app-text) !important;
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
        cursor: pointer;
        transition: background-color 0.1s ease;
        font-size: 0.82rem;
        padding-top: 4px !important;
        padding-bottom: 4px !important;
    }
    .grid-ctx-btn:hover {
        background-color: var(--primary-color) !important;
        color: #ffffff !important;
    }
    .grid-ctx-btn:hover i,
    .grid-ctx-btn:hover span {
        color: #ffffff !important;
    }
    .result-set-table td.selected-cell {
        background-color: rgba(13, 110, 253, 0.28) !important;
        box-shadow: inset 0 0 0 1px rgba(13, 110, 253, 0.6) !important;
    }
    .result-set-table td.selected-cell:hover {
        background-color: rgba(13, 110, 253, 0.38) !important;
    }
    .result-set-table td.col-index.selected-row-header {
        background-color: rgba(13, 110, 253, 0.45) !important;
        color: #ffffff !important;
        font-weight: 600;
    }
    .result-set-table thead th.selected-col-header {
        background-color: rgba(13, 110, 253, 0.4) !important;
        color: #ffffff !important;
    }
    .result-set-table thead th.selected-col-header span {
        color: #ffffff !important;
        font-weight: 600;
    }
    .sort-btn {
        opacity: 0.7;
        transition: opacity 0.15s ease, background-color 0.15s ease;
        border-radius: 4px;
        line-height: 1;
    }
    .sort-btn:hover {
        opacity: 1 !important;
        background-color: rgba(255, 255, 255, 0.18);
    }
</style>




@if (IsCodeViewerOpen)
{
    <style>
    .dropdown-divider + .dropdown-divider {
        display: none !important;
    }.glass-card { backdrop-filter: none !important; }</style><div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 999999;">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="height: 90vh;">
            <div class="modal-content shadow-lg h-100 flex-column d-flex" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-header py-2 flex-shrink-0" style="border-bottom: 1px solid var(--app-border);">
                    <h5 class="modal-title d-flex align-items-center gap-2" style="color: var(--app-table-header-text);">
                        <i class="bi bi-file-earmark-code"></i> Data Viewer (@CodeViewerLanguage.ToUpper())
                    </h5>
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "") m-0" aria-label="Close" @onclick="CloseCodeViewer"></button>
                    </div>
                </div>
                <div class="modal-body p-0 flex-grow-1 position-relative">
                    <BlazorMonaco.Editor.StandaloneCodeEditor @ref="_codeEditor" Id="cellDataEditor" ConstructionOptions="EditorConstructionOptions" CssClass="w-100 h-100" />
                </div>
            </div>
        </div>
    </div>
}

@if (IsBinaryViewerOpen && _activeBinaryBytes != null)
{
    <style>
    .dropdown-divider + .dropdown-divider {
        display: none !important;

        }.glass-card { backdrop-filter: none !important; }</style><div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 999999;">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="height: 90vh;">
            <div class="modal-content shadow-lg h-100 flex-column d-flex" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <!-- Header -->
                <div class="modal-header py-2 flex-shrink-0 d-flex align-items-center justify-content-between" style="border-bottom: 1px solid var(--app-border);">
                    <div class="d-flex align-items-center gap-2">
                        @if (_activeBinaryIsImage)
                        {
                            <i class="bi bi-image text-info fs-5"></i>
                        }
                        else if (_activeBinaryIsPdf)
                        {
                            <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-binary text-warning fs-5"></i>
                        }
                        <h5 class="modal-title mb-0 d-flex align-items-center gap-2" style="color: var(--app-table-header-text); font-size: 1.05rem;">
                            <span>@(_activeBinaryIsImage ? "Image Viewer" : (_activeBinaryIsPdf ? "PDF Viewer" : "Binary Viewer"))</span>
                            <span class="text-muted fw-normal">&mdash;</span>
                            <span class="fw-bold font-monospace" style="color: var(--app-text);">@_activeBinaryColumnName</span>
                        </h5>
                    </div>
                    
