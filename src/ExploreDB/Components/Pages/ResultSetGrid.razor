    private string BuildClipboardText(bool includeHeaders)
    {
        int totalRows = TotalDataCount;
        int colCount = Columns.Count;
        if (totalRows == 0 || colCount == 0) return string.Empty;

        if (SelectedCells.Count == 1 && !_isAllSelected && SelectedEntireRows.Count == 0 && SelectedEntireCols.Count == 0)
        {
            var (r, c) = SelectedCells.First();
            if (r >= 0 && r < totalRows && c >= 0 && c < colCount)
            {
                var raw = GetRawCellValue(r, c, Columns[c]);
                if (raw is byte[] bytes)
                {
                    var hex = BinaryDataHelper.ToHexString(bytes, prefix: true);
                    return includeHeaders ? $"{Columns[c]}\r\n{hex}" : hex;
                }
                var val = FormatCellValue(raw, c) ?? "NULL";
                return includeHeaders ? $"{Columns[c]}\r\n{val}" : val;
            }
        }

        var targetRows = new List<int>();
        var targetCols = new List<int>();

        if (_isAllSelected)
        {
            int maxExport = Math.Min(totalRows, 10000);
            for (int r = 0; r < maxExport; r++) targetRows.Add(r);
            for (int c = 0; c < colCount; c++) targetCols.Add(c);
        }
        else
        {
            if (SelectedEntireRows.Count > 0)
                targetRows.AddRange(SelectedEntireRows.OrderBy(r => r));
            if (SelectedEntireCols.Count > 0)
                targetCols.AddRange(SelectedEntireCols.OrderBy(c => c));

            foreach (var cell in SelectedCells)
            {
                if (!targetRows.Contains(cell.Row)) targetRows.Add(cell.Row);
                if (!targetCols.Contains(cell.Col)) targetCols.Add(cell.Col);
            }

            targetRows.Sort();
            targetCols.Sort();
        }

        if (targetRows.Count == 0)
        {
            for (int r = 0; r < Math.Min(totalRows, 50); r++) targetRows.Add(r);
        }
        if (targetCols.Count == 0)
        {
            for (int c = 0; c < colCount; c++) targetCols.Add(c);
        }

        var sb = new System.Text.StringBuilder();
        if (includeHeaders)
        {
            sb.Append(string.Join("\t", targetCols.Select(c => Columns[c])));
            sb.Append("\r\n");
        }

        for (int rIdx = 0; rIdx < targetRows.Count; rIdx++)
        {
            int r = targetRows[rIdx];
            var rowVals = new List<string>(targetCols.Count);
            foreach (var c in targetCols)
            {
                var raw = GetRawCellValue(r, c, Columns[c]);
                if (raw is byte[] b)
                {
                    rowVals.Add(b.Length <= BinaryDataHelper.ShortBinaryThreshold ? BinaryDataHelper.ToHexString(b, prefix: true) : BinaryDataHelper.FormatBinaryForDisplay(b));
                }
                else
                {
                    rowVals.Add(FormatCellValue(raw, c) ?? "NULL");
                }
            }
            sb.Append(string.Join("\t", rowVals));
            if (rIdx < targetRows.Count - 1) sb.Append("\r\n");
        }

        return sb.ToString();
    }

    private string GetCopySummary()
    {
        if (SelectedCells.Count == 1) return "1 cell";
        if (Columns.Count == 0) return $"{SelectedCells.Count} cells";

        var targetRows = SelectedCells.Select(x => x.Row).Distinct().Count();
        var targetCols = SelectedCells.Select(x => x.Col).Distinct().Count();

        if (targetCols == Columns.Count && SelectedCells.Count == targetRows * Columns.Count)
        {
            return $"{targetRows} row{(targetRows > 1 ? "s" : "")}";
        }

        return $"{SelectedCells.Count} cells";
    }

