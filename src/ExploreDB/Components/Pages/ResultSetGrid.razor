    private bool CanCopyAsInClause
    {
        get
        {
            if (_isAllSelected) return false;
            if (SelectedEntireCols.Count > 1) return false;
            if (SelectedEntireRows.Count > 0) return false;

            if (SelectedEntireCols.Count == 1) return true;
            if (IsColumnContextMenu && !string.IsNullOrEmpty(ContextMenuColumn)) return true;

            if (SelectedCells.Count > 0)
            {
                return SelectedCells.Select(c => c.Col).Distinct().Count() == 1;
            }

            return !string.IsNullOrEmpty(ContextMenuColumn);
        }
    }

    private sealed record InClauseBuildResult(
        string Text,
        int UniqueCount,
        int ScannedRows,
        bool WasCapped,
        bool OutOfMemory);

    private static string QuoteSqlUnicodeLiteral(string text)
        => "N'" + text.Replace("'", "''") + "'";

    private static string? FormatSnapshotInClauseLiteral(GridDataSnapshot snap, int actualRowIndex, int colIndex, string colType, bool asciiNegativeSign)
    {
        if (snap.TableStore != null && !string.IsNullOrEmpty(colType))
        {
            if (snap.TableStore.IsNull(actualRowIndex, colIndex))
            {
                return null;
            }

            if (asciiNegativeSign && colType is "int" or "bigint" or "smallint" or "tinyint")
            {
                var intText = snap.TableStore.FormatCellForDisplay(actualRowIndex, colIndex);
                return string.IsNullOrEmpty(intText) ? null : intText;
            }

            if (colType is "varchar" or "nvarchar" or "char" or "nchar" or "text" or "ntext" or "xml" or "uniqueidentifier" or "date" or "datetime" or "datetime2" or "smalldatetime" or "time" or "datetimeoffset")
            {
                var strText = snap.TableStore.FormatCellForDisplay(actualRowIndex, colIndex);
                return string.IsNullOrEmpty(strText) ? null : QuoteSqlUnicodeLiteral(strText);
            }
        }

        var raw = GetSnapshotRawCellValue(snap, actualRowIndex, colIndex);
        if (raw == null || raw is DBNull) return null;

        if (raw is byte[] bytes)
        {
            return BinaryDataHelper.ToHexString(bytes, prefix: true);
        }

        if (raw is bool b)
        {
            return b ? "1" : "0";
        }

        if (raw is sbyte or byte or short or ushort or int or uint or long or ulong)
        {
            return Convert.ToString(raw, CultureInfo.InvariantCulture);
        }

        if (raw is float f)
        {
            return f.ToString(CultureInfo.InvariantCulture);
        }

        if (raw is double d)
        {
            return d.ToString(CultureInfo.InvariantCulture);
        }

        if (raw is decimal dec)
        {
            return dec.ToString(CultureInfo.InvariantCulture);
        }

        if (raw is string str)
        {
            return string.IsNullOrEmpty(str) ? null : QuoteSqlUnicodeLiteral(str);
        }

        var formatted = FormatSnapshotCellValue(snap.TableStore, raw, colIndex);
        if (string.IsNullOrEmpty(formatted)) return null;
        if (formatted.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) return formatted;
        return QuoteSqlUnicodeLiteral(formatted);
    }

    private async Task CopyColumnAsInClause()
    {
        bool canCopy = CanCopyAsInClause;
        bool isColumnMenu = IsColumnContextMenu;
        string contextCol = ContextMenuColumn;
        HideContextMenu();
        if (!canCopy) return;

        if (_isClipboardCopyBusy)
        {
            ShowCopyFeedback(ClipboardBusyMessage, 2000, CopyFeedbackKind.Warning);
            return;
        }

        var snap = CaptureGridSnapshot();
        if (snap.TotalDataCount == 0 || snap.Columns.Count == 0) return;

        var colsSelected = SelectedEntireCols.ToList();
        var rowsSelected = SelectedEntireRows.ToList();
        var cellsSelected = SelectedCells.ToList();
        bool isAll = _isAllSelected;

        int resolvedContextColIdx = !string.IsNullOrEmpty(contextCol)
            ? (snap.TableStore != null ? snap.TableStore.GetColumnIndex(contextCol) : snap.Columns.IndexOf(contextCol))
            : -1;

        List<int> targetCols;
        bool allDisplayRows;
        bool fromCellsOnly = false;

        if (isColumnMenu || colsSelected.Count > 0 || (cellsSelected.Count == 0 && rowsSelected.Count == 0 && !isAll && !string.IsNullOrEmpty(contextCol)))
        {
            targetCols = colsSelected.Count > 0
                ? colsSelected.Where(c => (uint)c < (uint)snap.Columns.Count).Distinct().OrderBy(c => c).ToList()
                : (resolvedContextColIdx >= 0 ? new List<int> { resolvedContextColIdx } : new List<int>());
            allDisplayRows = true;
        }
        else if (cellsSelected.Count > 0)
        {
            targetCols = cellsSelected
                .Select(x => x.Col)
                .Where(c => (uint)c < (uint)snap.Columns.Count)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
            allDisplayRows = false;
            fromCellsOnly = true;
        }
        else if (rowsSelected.Count > 0 || isAll)
        {
            int fallbackCol = resolvedContextColIdx >= 0 ? resolvedContextColIdx : 0;
            targetCols = new List<int> { fallbackCol };
            allDisplayRows = isAll;
        }
        else
        {
            return;
        }

        if (targetCols.Count == 0) return;
        if (allDisplayRows && snap.ActiveRowCount == 0) return;

        bool asciiNegativeSign = string.Equals(CultureInfo.CurrentCulture.NumberFormat.NegativeSign, "-", StringComparison.Ordinal);

        _isClipboardCopyBusy = true;
        try
        {
            var result = await Task.Run(() =>
            {
                List<int>? explicitRows = null;
                if (!allDisplayRows)
                {
                    explicitRows = ResolveExplicitRowsInDisplayOrder(
                        snap,
                        fromCellsOnly ? null : rowsSelected,
                        fromCellsOnly ? cellsSelected : null);
                }

                int totalTargetRows = allDisplayRows ? snap.ActiveRowCount : explicitRows!.Count;
                if (totalTargetRows == 0)
                {
                    return new InClauseBuildResult(string.Empty, 0, 0, false, false);
                }

                var colTypes = new string[targetCols.Count];
                for (int i = 0; i < targetCols.Count; i++)
                {
                    colTypes[i] = snap.TableStore?.GetColumnType(targetCols[i])?.ToLowerInvariant() ?? "";
                }

                var seen = new HashSet<string>(StringComparer.Ordinal);
                var sb = new StringBuilder(Math.Min(4_194_304, Math.Max(256, totalTargetRows * 8)));
                sb.Append("IN (");

                int scannedRows = 0;
                int uniqueCount = 0;
                bool wasCapped = false;

                try
                {
                    for (int i = 0; i < totalTargetRows; i++)
                    {
                        int actualRow = allDisplayRows
                            ? (snap.ViewIndices != null ? snap.ViewIndices[i] : i)
                            : explicitRows![i];

                        for (int cIdx = 0; cIdx < targetCols.Count; cIdx++)
                        {
                            var literal = FormatSnapshotInClauseLiteral(snap, actualRow, targetCols[cIdx], colTypes[cIdx], asciiNegativeSign);
                            if (literal != null && seen.Add(literal))
                            {
                                int extraLen = (uniqueCount > 0 ? 2 : 0) + literal.Length + 1;
                                if (uniqueCount > 0 && sb.Length + extraLen > MaxClipboardChars)
                                {
                                    wasCapped = true;
                                    break;
                                }
                                if (uniqueCount > 0) sb.Append(", ");
                                sb.Append(literal);
                                uniqueCount++;
                            }
                        }

                        if (wasCapped) break;
                        scannedRows++;
                    }

                    if (uniqueCount == 0)
                    {
                        return new InClauseBuildResult(string.Empty, 0, scannedRows, false, false);
                    }

                    sb.Append(')');
                    seen.Clear();
                    return new InClauseBuildResult(sb.ToString(), uniqueCount, scannedRows, wasCapped, false);
                }
                catch (OutOfMemoryException)
                {
                    return new InClauseBuildResult(string.Empty, 0, scannedRows, false, true);
                }
            });

            if (_disposed) return;

            if (result.OutOfMemory)
            {
                ShowCopyFeedback("Too many unique values — filter rows or use Export", 7000, CopyFeedbackKind.Error);
                return;
            }
            if (result.UniqueCount == 0 || string.IsNullOrEmpty(result.Text))
            {
                ShowCopyFeedback("No non-empty values for IN clause", 4000, CopyFeedbackKind.Warning);
                return;
            }

            bool ok = await TryWriteClipboardAsync(result.Text);
            if (_disposed) return;
            if (!ok)
            {
                ShowCopyFeedback(ClipboardWriteFailedMessage, 7000, CopyFeedbackKind.Error);
                return;
            }

            string valueWord = result.UniqueCount == 1 ? "value" : "values";
            string rowWord = result.ScannedRows == 1 ? "row" : "rows";
            string msg = $"Copied {result.UniqueCount:N0} unique {valueWord} (from {result.ScannedRows:N0} {rowWord})";
            CopyFeedbackKind kind = CopyFeedbackKind.Success;
            if (result.WasCapped)
            {
                msg += " — limit reached";
                kind = CopyFeedbackKind.Warning;
            }
            else if (result.UniqueCount > 25_000)
            {
                msg += " — large IN() may hit SQL limit";
                kind = CopyFeedbackKind.Warning;
            }

            ShowCopyFeedback(msg, kind == CopyFeedbackKind.Warning ? 7000 : 4500, kind);
        }
        finally
        {
            _isClipboardCopyBusy = false;
        }
    }

    private void CalculateAggregates()
    {
        if (!CanCopyAsInClause) return;
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;
        int colIdx = _tableStore != null ? _tableStore.GetColumnIndex(ContextMenuColumn) : Columns.IndexOf(ContextMenuColumn);
        if (colIdx < 0) return;

        if (_tableStore != null)
        {
            var agg = _tableStore.ComputeAggregates(colIdx, _filteredIndices);
            AggCount = agg.Count;
            AggDistinct = agg.DistinctCount;
            AggSum = agg.Sum;
            AggAverage = agg.Average;
            AggMin = agg.Min is DateTime minDt ? minDt.ToString("g")
                   : agg.Min is DateTimeOffset minDto ? minDto.ToString("g")
                   : agg.Min is DateOnly minDo ? minDo.ToString("yyyy-MM-dd")
                   : agg.Min;
            AggMax = agg.Max is DateTime maxDt ? maxDt.ToString("g")
                   : agg.Max is DateTimeOffset maxDto ? maxDto.ToString("g")
                   : agg.Max is DateOnly maxDo ? maxDo.ToString("yyyy-MM-dd")
                   : agg.Max;
            ActiveAggregateColumn = ContextMenuColumn;
            HideContextMenu();
            return;
        }

        int rowCount = ActiveRowCount;
        var values = new List<object?>(Math.Min(rowCount, 100000));
        for (int i = 0; i < rowCount; i++)
        {
            int actualIdx = GetActualRowIndex(i);
            var v = GetRawCellValue(actualIdx, colIdx, ContextMenuColumn);
            if (v != null) values.Add(v);
        }

        AggCount = values.Count;
        AggDistinct = values.Select(v => v is byte[] b ? Convert.ToHexString(b) : v?.ToString()).Distinct().Count();
        
        AggSum = null;
        AggAverage = null;
        AggMin = null;
        AggMax = null;

        if (values.Count > 0)
        {
            var firstVal = values.First();
            if (firstVal is short or int or long or decimal or float or double or byte)
            {
                var doubles = values.Select(v => Convert.ToDouble(v)).ToList();
                AggSum = doubles.Sum();
                AggAverage = doubles.Average();
                AggMin = doubles.Min();
                AggMax = doubles.Max();
            }
            else if (firstVal is DateTime or DateOnly or DateTimeOffset)
            {
                var dates = values.Select(v => Convert.ToDateTime(v)).ToList();
                AggMin = dates.Min().ToString("g");
                AggMax = dates.Max().ToString("g");
            }
        }

        ActiveAggregateColumn = ContextMenuColumn;
        HideContextMenu();
    }

    private void CancelExport()
