    public void Dispose()
    {
        _disposed = true;
        if (_subscribedTable != null)
        {
            _subscribedTable.OnRowsUpdated -= HandleTableRowsUpdated;
            _subscribedTable = null;
        }
        if (!string.IsNullOrEmpty(_activePdfBlobUrl))
        {
            try { _ = JS.InvokeVoidAsync("revokeBlobUrl", _activePdfBlobUrl); } catch { }
        }
        try { _ = JS.InvokeVoidAsync("destroyGridColumnResizers", _tableContainerId); } catch { }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        UserSettingsService.OnSettingsChanged -= HandleSettingsChanged;
        _copyFeedbackCts?.Cancel();
        _copyFeedbackCts?.Dispose();
        _filterCts?.Cancel();
        _filterCts?.Dispose();
        _sortCts?.Cancel();
        _sortCts?.Dispose();
    }
