    private void HideContextMenu()
    {
        ShowContextMenuState = false;
        _shouldPositionContextMenu = false;
        IsColumnContextMenu = false;
    }

    private int GetDisplayRowIndex(int actualRowIndex)
    {
        if (_viewIndices == null) return actualRowIndex;
        return Array.IndexOf(_viewIndices, actualRowIndex);
    }

    private void HandleRowHeaderClick(MouseEventArgs e, int actualRowIndex)
    {
        HideContextMenu();
        if (Columns.Count == 0 || actualRowIndex < 0 || actualRowIndex >= TotalDataCount) return;

        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedEntireRows.Contains(actualRowIndex))
                SelectedEntireRows.Remove(actualRowIndex);
            else
            {
                SelectedEntireRows.Add(actualRowIndex);
                _lastSelectedCell = (actualRowIndex, 0);
            }
        }
        else if (e.ShiftKey && _lastSelectedCell.Row >= 0)
        {
            int prevDisplay = GetDisplayRowIndex(_lastSelectedCell.Row);
            int curDisplay = GetDisplayRowIndex(actualRowIndex);
            ClearCellSelection();

            if (prevDisplay >= 0 && curDisplay >= 0)
            {
                int startD = Math.Max(0, Math.Min(prevDisplay, curDisplay));
                int endD = Math.Min(ActiveRowCount - 1, Math.Max(prevDisplay, curDisplay));
                for (int d = startD; d <= endD; d++)
                {
                    SelectedEntireRows.Add(GetActualRowIndex(d));
                }
            }
            else
            {
                SelectedEntireRows.Add(actualRowIndex);
            }
            _lastSelectedCell = (actualRowIndex, 0);
        }
        else
        {
            ClearCellSelection();

            SelectedEntireRows.Add(actualRowIndex);
            _lastSelectedCell = (actualRowIndex, 0);
        }
    }

    private void HandleCellClick(MouseEventArgs e, int actualRowIndex, int colIndex)
    {
        HideContextMenu();
        if (actualRowIndex < 0 || actualRowIndex >= TotalDataCount || colIndex < 0 || colIndex >= Columns.Count) return;
        var coord = (actualRowIndex, colIndex);

        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedCells.Contains(coord))
                SelectedCells.Remove(coord);
            else
            {
                SelectedCells.Add(coord);
                _lastSelectedCell = coord;
            }
        }
        else if (e.ShiftKey && _lastSelectedCell.Row >= 0 && _lastSelectedCell.Col >= 0)
        {
            int prevDisplay = GetDisplayRowIndex(_lastSelectedCell.Row);
            int curDisplay = GetDisplayRowIndex(actualRowIndex);
            int prevAnchorCol = _lastSelectedCell.Col;
            ClearCellSelection();

            if (prevDisplay >= 0 && curDisplay >= 0)
            {
                int startD = Math.Max(0, Math.Min(prevDisplay, curDisplay));
                int endD = Math.Min(ActiveRowCount - 1, Math.Max(prevDisplay, curDisplay));
                int startC = Math.Max(0, Math.Min(prevAnchorCol, colIndex));
                int endC = Math.Min(Columns.Count - 1, Math.Max(prevAnchorCol, colIndex));

                for (int d = startD; d <= endD; d++)
                {
                    int r = GetActualRowIndex(d);
                    for (int c = startC; c <= endC; c++)
                    {
                        SelectedCells.Add((r, c));
                    }
                }
            }
            else
            {
                SelectedCells.Add(coord);
            }
            _lastSelectedCell = (actualRowIndex, colIndex);
        }
        else
        {
            ClearCellSelection();

            SelectedCells.Add(coord);
            _lastSelectedCell = coord;
        }
    }

    private void HandleColumnHeaderClick(MouseEventArgs e, int colIndex)
    {
        HideContextMenu();
        if (colIndex < 0 || colIndex >= Columns.Count) return;

        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedEntireCols.Contains(colIndex))
                SelectedEntireCols.Remove(colIndex);
            else
            {
                SelectedEntireCols.Add(colIndex);
                _lastSelectedCell = (0, colIndex);
            }
        }
        else if (e.ShiftKey && _lastSelectedCell.Col >= 0 && _lastSelectedCell.Col < Columns.Count)
        {
            int prevCol = _lastSelectedCell.Col;
            ClearCellSelection();

            int startC = Math.Min(prevCol, colIndex);
            int endC = Math.Max(prevCol, colIndex);
            for (int c = startC; c <= endC; c++) SelectedEntireCols.Add(c);
            _lastSelectedCell = (0, colIndex);
        }
        else
        {
            ClearCellSelection();

            SelectedEntireCols.Add(colIndex);
            _lastSelectedCell = (0, colIndex);
        }
    }

    private void ToggleSelectAll()
    {
        HideContextMenu();
        _isAllSelected = !_isAllSelected;
        SelectedCells.Clear();
        SelectedEntireRows.Clear();
        SelectedEntireCols.Clear();
        _lastSelectedCell = (0, 0);
        StateHasChanged();
    }

