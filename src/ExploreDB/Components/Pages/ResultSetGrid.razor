    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.MetaKey)
        {
            if (e.Key.Equals("c", StringComparison.OrdinalIgnoreCase))
            {
                bool hasTextSelection = false;
                try
                {
                    hasTextSelection = await JS.InvokeAsync<bool>("hasTextSelection");
                }
                catch { }

                if (!hasTextSelection && SelectedCells.Count > 0)
                {
                    if (e.ShiftKey)
                    {
                        await CopySelectedWithHeadersAsync();
                    }
                    else
                    {
                        await CopySelectedAsync();
                    }
                }
            }
            else if (e.Key.Equals("a", StringComparison.OrdinalIgnoreCase))
            {
                SelectAllCurrentPage();
            }
        }
        else if (e.Key == "Escape")
        {
            HideContextMenu();
            ClearCellSelection();
            StateHasChanged();
        }
    }

    private void ShowCopyFeedback(string message)
    {
        _copyFeedbackCts?.Cancel();
        _copyFeedbackCts = new CancellationTokenSource();
        var token = _copyFeedbackCts.Token;

        _copyFeedbackMessage = message;
        StateHasChanged();

        _ = Task.Delay(2000, token).ContinueWith(t =>
        {
            if (!t.IsCanceled)
            {
                _copyFeedbackMessage = null;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task CopyColumnAsInClause()
    {
        HideContextMenu();
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;

        var values = FilteredRows
            .Select(r => GetColumnValue(r, ContextMenuColumn))
            .Where(v => v != null)
            .Select(v => v.ToString())
            .Distinct()
            .ToList();

        if (values.Count > 0)
        {
            // Simple heuristic to check if we need quotes
            bool useQuotes = !decimal.TryParse(values.First(), out _);
            
            var formattedValues = values.Select(v => {
                if (useQuotes)
                {
                    string escaped = v.Replace("'", "''");
                    return string.Format("N'{0}'", escaped);
                }
                return v;
            });
            var inClause = $"IN ({string.Join(", ", formattedValues)})";

            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", inClause);
                ShowCopyFeedback("IN clause copied");
            }
            catch
            {
                // Clipboard API might fail if not in secure context, silently handle for now
            }
        }
    }

    private void CalculateAggregates()
    {
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;

        var values = FilteredRows
            .Select(r => r.TryGetValue(ContextMenuColumn, out var val) ? val : null)
            .Where(v => v != null)
            .ToList();

        AggCount = values.Count;
        AggDistinct = values.Select(v => v?.ToString()).Distinct().Count();
        
        AggSum = null;
        AggAverage = null;
        AggMin = null;
        AggMax = null;

        if (values.Count > 0)
        {
            var firstVal = values.First();
            if (firstVal is short or int or long or decimal or float or double or byte)
            {
                var doubles = values.Select(v => Convert.ToDouble(v)).ToList();
                AggSum = doubles.Sum();
                AggAverage = doubles.Average();
                AggMin = doubles.Min();
                AggMax = doubles.Max();
            }
            else if (firstVal is DateTime or DateOnly or DateTimeOffset)
            {
                var dates = values.Select(v => Convert.ToDateTime(v)).ToList();
                AggMin = dates.Min().ToString("g");
                AggMax = dates.Max().ToString("g");
            }
            else
            {
                // For strings/GUIDs, we only care about Count and Distinct.
                // Alphabetical Min/Max is rarely useful and clutters the UI.
            }
        }

        ActiveAggregateColumn = ContextMenuColumn;
        HideContextMenu();
    }

    private void CancelExport()
    {
        _exportCts?.Cancel();
    }

    private async Task ExportToExcelAsync()
    {
        if (FilteredRows == null || FilteredRows.Count == 0) return;

        // Take snapshot for thread safety in case the user runs another query
        var rowsSnapshot = FilteredRows.ToList();
        var colsSnapshot = Columns.ToList();

        IsExporting = true;
        _exportCts = new CancellationTokenSource();
        if (OnExportStateChanged.HasDelegate)
        {
            await OnExportStateChanged.InvokeAsync(new ExportStatus(true, false, CancelExport));
        }
        StateHasChanged();
        
        // Small delay to ensure the UI renders the loading spinner before the CPU-bound task blocks the thread
        await Task.Delay(50);

        try
        {
            var token = _exportCts.Token;
            byte[] fileBytes = await Task.Run(() =>
            {
                using var workbook = new XLWorkbook();
                var worksheet = workbook.Worksheets.Add("Result Set");

                // Add Headers
                for (int i = 0; i < colsSnapshot.Count; i++)
                {
                    worksheet.Cell(1, i + 1).Value = colsSnapshot[i];
                    worksheet.Cell(1, i + 1).Style.Font.Bold = true;
                }

                // Add Data
                for (int rowIdx = 0; rowIdx < rowsSnapshot.Count; rowIdx++)
                {
                    if (token.IsCancellationRequested) return Array.Empty<byte>();
                    
                    var row = rowsSnapshot[rowIdx];
                    for (int colIdx = 0; colIdx < colsSnapshot.Count; colIdx++)
                    {
                        if (row.TryGetValue(colsSnapshot[colIdx], out var val) && val != null)
                        {
                            if (val is string s) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = s;
                            else if (val is int i) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = i;
                            else if (val is long l) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = l;
                            else if (val is short sh) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = sh;
                            else if (val is byte b) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = b;
                            else if (val is decimal d) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = d;
                            else if (val is double dub) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dub;
                            else if (val is float f) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = f;
                            else if (val is bool bl) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = bl;
                            else if (val is DateTime dt) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dt;
                            else if (val is TimeSpan ts) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = ts;
                            else worksheet.Cell(rowIdx + 2, colIdx + 1).Value = val.ToString();
                        }
                    }
                }

                if (token.IsCancellationRequested) return Array.Empty<byte>();
                worksheet.Columns().AdjustToContents();

                if (token.IsCancellationRequested) return Array.Empty<byte>();

                using var memoryStream = new MemoryStream();
                workbook.SaveAs(memoryStream);
                if (token.IsCancellationRequested) return Array.Empty<byte>();
                return memoryStream.ToArray();
            }, token);

            if (token.IsCancellationRequested || fileBytes == null || fileBytes.Length == 0)
            {
                return;
            }
            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Export_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", streamRef);
            
            ShowExportSuccess = true;
            if (OnExportStateChanged.HasDelegate)
            {
                await OnExportStateChanged.InvokeAsync(new ExportStatus(false, true, null!));
            }
        }
        catch (OperationCanceledException)
        {
            // Export was cancelled by the user, do nothing
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to excel: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
            if (OnExportStateChanged.HasDelegate && !ShowExportSuccess)
            {
                _ = OnExportStateChanged.InvokeAsync(new ExportStatus(false, false, null!));
            }
            _exportCts?.Dispose();
            _exportCts = null;
            StateHasChanged();
        }
    }

    private bool IsJsonOrXml(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return false;
        var trimmed = val.TrimStart();
        if (trimmed.Length < 2) return false;
        char first = trimmed[0];
        return first == '{' || first == '[' || first == '<';
    }

    private bool IsCodeViewerOpen = false;
    private string CodeViewerContent = "";
    private string CodeViewerLanguage = "text";
    private BlazorMonaco.Editor.StandaloneCodeEditor? _codeEditor;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = CodeViewerLanguage,
            Value = CodeViewerContent,
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            ReadOnly = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            FormatOnPaste = true,
            ScrollBeyondLastLine = false
        };
    }
    
    private void OpenCodeViewer(string content)
    {
        CodeViewerContent = content;
        var trimmed = content.TrimStart();
        
        if (trimmed.StartsWith("{") || trimmed.StartsWith("[")) 
        {
            CodeViewerLanguage = "json";
            try 
            {
                var parsed = System.Text.Json.JsonSerializer.Deserialize<object>(content);
                CodeViewerContent = System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            } 
            catch { }
        }
        else if (trimmed.StartsWith("<")) 
        {
            CodeViewerLanguage = "xml";
            try 
            {
                var doc = System.Xml.Linq.XDocument.Parse(content);
                CodeViewerContent = doc.ToString();
            } 
            catch { }
        }
        else 
        {
            CodeViewerLanguage = "text";
        }
        
        IsCodeViewerOpen = true;
        StateHasChanged();
    }
    
    private void CloseCodeViewer()
    {
        IsCodeViewerOpen = false;
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        _copyFeedbackCts?.Cancel();
        _copyFeedbackCts?.Dispose();
    }
}





