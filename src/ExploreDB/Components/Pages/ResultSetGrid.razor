    private void HandleRowHeaderClick(MouseEventArgs e, int actualRowIndex)
    {
        HideContextMenu();
        if (Columns.Count == 0) return;

        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedEntireRows.Contains(actualRowIndex))
                SelectedEntireRows.Remove(actualRowIndex);
            else
                SelectedEntireRows.Add(actualRowIndex);
        }
        else if (e.ShiftKey && _lastSelectedCell.Row >= 0)
        {
            ClearCellSelection();

            int startR = Math.Min(_lastSelectedCell.Row, actualRowIndex);
            int endR = Math.Max(_lastSelectedCell.Row, actualRowIndex);
            for (int r = startR; r <= endR; r++) SelectedEntireRows.Add(r);
        }
        else
        {
            ClearCellSelection();

            SelectedEntireRows.Add(actualRowIndex);
            _lastSelectedCell = (actualRowIndex, 0);
        }
    }

    private void HandleCellClick(MouseEventArgs e, int actualRowIndex, int colIndex)
    {
        HideContextMenu();
        var coord = (actualRowIndex, colIndex);

        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedCells.Contains(coord))
                SelectedCells.Remove(coord);
            else
            {
                SelectedCells.Add(coord);
                _lastSelectedCell = coord;
            }
        }
        else if (e.ShiftKey && _lastSelectedCell.Row >= 0 && _lastSelectedCell.Col >= 0)
        {
            ClearCellSelection();

            int startR = Math.Min(_lastSelectedCell.Row, actualRowIndex);
            int endR = Math.Max(_lastSelectedCell.Row, actualRowIndex);
            int startC = Math.Min(_lastSelectedCell.Col, colIndex);
            int endC = Math.Max(_lastSelectedCell.Col, colIndex);

            for (int r = startR; r <= endR; r++)
            {
                for (int c = startC; c <= endC; c++)
                {
                    SelectedCells.Add((r, c));
                }
            }
        }
        else
        {
            ClearCellSelection();

            SelectedCells.Add(coord);
            _lastSelectedCell = coord;
        }
    }

    private void HandleColumnHeaderClick(MouseEventArgs e, int colIndex)
    {
        HideContextMenu();
        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedEntireCols.Contains(colIndex))
                SelectedEntireCols.Remove(colIndex);
            else
                SelectedEntireCols.Add(colIndex);
        }
        else
