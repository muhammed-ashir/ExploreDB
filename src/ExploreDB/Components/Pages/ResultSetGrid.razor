    private async Task ExportToExcelAsync()
    {
        int rowCount = ActiveRowCount;
        if (rowCount == 0 || Columns.Count == 0) return;

        var colsSnapshot = Columns.ToList();

        IsExporting = true;
        _exportCts = new CancellationTokenSource();
        if (OnExportStateChanged.HasDelegate)
        {
            await OnExportStateChanged.InvokeAsync(new ExportStatus(true, false, CancelExport, "Excel"));
        }
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            var token = _exportCts.Token;
            byte[] fileBytes = await Task.Run(() =>
            {
                using var workbook = new XLWorkbook();
                var worksheet = workbook.Worksheets.Add("Result Set");

                for (int i = 0; i < colsSnapshot.Count; i++)
                {
                    worksheet.Cell(1, i + 1).Value = colsSnapshot[i];
                    worksheet.Cell(1, i + 1).Style.Font.Bold = true;
                }

                int maxRows = Math.Min(rowCount, 1048500);
                for (int rowIdx = 0; rowIdx < maxRows; rowIdx++)
                {
                    if (token.IsCancellationRequested) return Array.Empty<byte>();
                    int actualIndex = GetActualRowIndex(rowIdx);

                    for (int colIdx = 0; colIdx < colsSnapshot.Count; colIdx++)
                    {
                        var val = GetRawCellValue(actualIndex, colIdx, colsSnapshot[colIdx]);
                        if (val != null)
                        {
                            if (val is string s) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = s;
                            else if (val is int iv) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = iv;
                            else if (val is long lv) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = lv;
                            else if (val is short sv) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = sv;
                            else if (val is decimal dv) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dv;
                            else if (val is double dub) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dub;
                            else if (val is float f) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = f;
                            else if (val is bool b) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = b;
                            else if (val is DateTime dt) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dt;
                            else if (val is TimeSpan ts) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = ts;
                            else if (val is byte[] bytes)
                            {
                                if (bytes.Length <= 16000)
                                    worksheet.Cell(rowIdx + 2, colIdx + 1).Value = BinaryDataHelper.ToHexString(bytes, prefix: true);
                                else
                                    worksheet.Cell(rowIdx + 2, colIdx + 1).Value = BinaryDataHelper.FormatBinaryForDisplay(bytes);
                            }
                            else worksheet.Cell(rowIdx + 2, colIdx + 1).Value = val.ToString();
                        }
                    }
                }

                if (token.IsCancellationRequested) return Array.Empty<byte>();
                worksheet.Columns().AdjustToContents(1, Math.Min(maxRows + 1, 100));

                if (token.IsCancellationRequested) return Array.Empty<byte>();

                using var memoryStream = new MemoryStream();
                workbook.SaveAs(memoryStream);
                if (token.IsCancellationRequested) return Array.Empty<byte>();
                return memoryStream.ToArray();
            }, token);

            if (token.IsCancellationRequested || fileBytes == null || fileBytes.Length == 0)
            {
                return;
            }
            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Export_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", streamRef);
            
            ShowExportSuccess = true;
            if (OnExportStateChanged.HasDelegate)
            {
                await OnExportStateChanged.InvokeAsync(new ExportStatus(false, true, null!, "Excel"));
            }
        }
        catch (OperationCanceledException)
        {
            // Export was cancelled by the user, do nothing
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to excel: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
            if (OnExportStateChanged.HasDelegate && !ShowExportSuccess)
            {
                _ = OnExportStateChanged.InvokeAsync(new ExportStatus(false, false, null!, "Excel"));
            }
            _exportCts?.Dispose();
            _exportCts = null;
            StateHasChanged();
        }
    }

    private async Task ExportToCsvAsync()
    {
        int rowCount = ActiveRowCount;
        if (rowCount == 0 || Columns.Count == 0) return;

        var colsSnapshot = Columns.ToList();

        IsExporting = true;
        _exportCts = new CancellationTokenSource();
        if (OnExportStateChanged.HasDelegate)
        {
            await OnExportStateChanged.InvokeAsync(new ExportStatus(true, false, CancelExport, "CSV"));
        }
        StateHasChanged();
        await Task.Delay(50);

        try
        {
            var token = _exportCts.Token;
            byte[] fileBytes = await Task.Run(() =>
            {
                using var memoryStream = new MemoryStream();
                using (var writer = new StreamWriter(memoryStream, new System.Text.UTF8Encoding(true)))
                {
                    for (int i = 0; i < colsSnapshot.Count; i++)
                    {
                        if (i > 0) writer.Write(",");
                        writer.Write(EscapeCsvCell(colsSnapshot[i]));
                    }
                    writer.Write("\r\n");

                    for (int rowIdx = 0; rowIdx < rowCount; rowIdx++)
                    {
                        if (token.IsCancellationRequested) return Array.Empty<byte>();
                        int actualIndex = GetActualRowIndex(rowIdx);

                        for (int colIdx = 0; colIdx < colsSnapshot.Count; colIdx++)
                        {
                            if (colIdx > 0) writer.Write(",");

                            var val = GetRawCellValue(actualIndex, colIdx, colsSnapshot[colIdx]);
                            if (val != null)
                            {
                                if (val is byte[] bytes)
                                {
                                    // Full database saved value as raw 0x... hex string (untruncated)
                                    writer.Write(BinaryDataHelper.ToHexString(bytes, prefix: true));
                                }
                                else if (val is DateTime dt)
                                {
                                    writer.Write(EscapeCsvCell(FormatCellValue(dt, colIdx)));
                                }
                                else if (val is DateTimeOffset dto)
                                {
                                    writer.Write(EscapeCsvCell(FormatCellValue(dto, colIdx)));
                                }
                                else if (val is bool b)
                                {
                                    writer.Write(b ? "True" : "False");
                                }
                                else
                                {
                                    writer.Write(EscapeCsvCell(val.ToString() ?? ""));
                                }
                            }
                        }
                        writer.Write("\r\n");
                    }

                    writer.Flush();
                }

                if (token.IsCancellationRequested) return Array.Empty<byte>();
                return memoryStream.ToArray();
            }, token);

            if (token.IsCancellationRequested || fileBytes == null || fileBytes.Length == 0)
            {
                return;
            }

            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Export_{DateTime.Now:yyyyMMdd_HHmmss}.csv", streamRef);
            
            ShowExportSuccess = true;
            if (OnExportStateChanged.HasDelegate)
            {
                await OnExportStateChanged.InvokeAsync(new ExportStatus(false, true, null!, "CSV"));
            }
        }
        catch (OperationCanceledException)
        {
            // Export was cancelled by the user, do nothing
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to CSV: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
            if (OnExportStateChanged.HasDelegate && !ShowExportSuccess)
            {
                _ = OnExportStateChanged.InvokeAsync(new ExportStatus(false, false, null!, "CSV"));
            }
            _exportCts?.Dispose();
            _exportCts = null;
            StateHasChanged();
        }
    }

    private static string EscapeCsvCell(string? str)
    {
        if (string.IsNullOrEmpty(str)) return "";
        bool needsQuotes = str.Contains(',') || str.Contains('"') || str.Contains('\n') || str.Contains('\r');
        if (needsQuotes)
        {
            return "\"" + str.Replace("\"", "\"\"") + "\"";
        }
        return str;
    }

    private bool IsJsonOrXml(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return false;
        var trimmed = val.TrimStart();
        if (trimmed.Length < 2) return false;
        char first = trimmed[0];
        return first == '{' || first == '[' || first == '<';
    }

    private bool IsCodeViewerOpen = false;
    private string CodeViewerContent = "";
    private string CodeViewerLanguage = "text";
    private BlazorMonaco.Editor.StandaloneCodeEditor? _codeEditor;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = CodeViewerLanguage,
            Value = CodeViewerContent,
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            ReadOnly = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            FormatOnPaste = true,
            ScrollBeyondLastLine = false
        };
    }
    
    private void OpenCodeViewer(string content)
    {
        CodeViewerContent = content;
        var trimmed = content.TrimStart();
        
        if (trimmed.StartsWith("{") || trimmed.StartsWith("[")) 
        {
            CodeViewerLanguage = "json";
            try 
            {
                var parsed = System.Text.Json.JsonSerializer.Deserialize<object>(content);
                CodeViewerContent = System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            } 
            catch { }
        }
        else if (trimmed.StartsWith("<")) 
        {
            CodeViewerLanguage = "xml";
            try 
            {
                var doc = System.Xml.Linq.XDocument.Parse(content);
                CodeViewerContent = doc.ToString();
            } 
            catch { }
        }
        else 
        {
            CodeViewerLanguage = "text";
        }
        
        IsCodeViewerOpen = true;
        StateHasChanged();
    }
    
    private void CloseCodeViewer()
    {
        IsCodeViewerOpen = false;
    }

    // Binary / Image Viewer State
    private bool IsBinaryViewerOpen = false;
    private byte[]? _activeBinaryBytes;
    private string _activeBinaryColumnName = "";
    private bool _activeBinaryIsImage = false;
    private bool _activeBinaryIsPdf = false;
    private string _activePdfBlobUrl = "";
    private string _activeBinaryFormat = "";
    private string _activeBinaryMimeType = "";
    private string _activeBinaryBase64 = "";
    private string _activeBinaryRawHex = "";
    private string _activeBinaryTab = "preview";
    private bool _isBinaryHexCopied = false;
    private bool _isBinaryBase64Copied = false;

    private async Task OpenBinaryViewer(byte[] bytes, string columnName)
    {
        _activeBinaryBytes = bytes;
        _activeBinaryColumnName = columnName;
        _activeBinaryIsImage = BinaryDataHelper.IsImage(bytes, out var fmt, out var mime);
        _activeBinaryIsPdf = BinaryDataHelper.IsPdf(bytes);
        _activeBinaryFormat = fmt;
        _activeBinaryMimeType = mime;
        _activeBinaryBase64 = _activeBinaryIsImage ? Convert.ToBase64String(bytes) : "";
        _activeBinaryRawHex = BinaryDataHelper.GetRawHexForDisplay(bytes);
        _activeBinaryTab = (_activeBinaryIsImage || _activeBinaryIsPdf) ? "preview" : "hex";
        _isBinaryHexCopied = false;
        _isBinaryBase64Copied = false;
        _activePdfBlobUrl = "";
        IsBinaryViewerOpen = true;
        StateHasChanged();

        if (_activeBinaryIsPdf)
        {
            try
            {
                using var stream = new MemoryStream(bytes);
                using var streamRef = new DotNetStreamReference(stream);
                _activePdfBlobUrl = await JS.InvokeAsync<string>("createBlobUrlFromStream", streamRef, "application/pdf");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error creating PDF blob URL: {ex.Message}");
            }
        }
    }

    private async Task CloseBinaryViewer()
    {
        if (!string.IsNullOrEmpty(_activePdfBlobUrl))
        {
            try
            {
                await JS.InvokeVoidAsync("revokeBlobUrl", _activePdfBlobUrl);
            }
            catch { }
            _activePdfBlobUrl = "";
        }
        IsBinaryViewerOpen = false;
        _activeBinaryBytes = null;
        _activeBinaryBase64 = "";
        _activeBinaryRawHex = "";
        _activeBinaryIsPdf = false;
        StateHasChanged();
    }

    private async Task CopyBinaryHexAsync(byte[] bytes)
    {
        if (bytes == null || bytes.Length == 0) return;
        try
        {
            var hex = BinaryDataHelper.ToHexString(bytes, prefix: true);
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", hex);
            _isBinaryHexCopied = true;
            ShowCopyFeedback("Hex copied");
            StateHasChanged();
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _isBinaryHexCopied = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch { }
    }

    private async Task CopyBinaryBase64Async()
    {
        if (_activeBinaryBytes == null || _activeBinaryBytes.Length == 0) return;
        try
        {
            var b64 = $"data:{_activeBinaryMimeType};base64,{_activeBinaryBase64}";
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", b64);
            _isBinaryBase64Copied = true;
            ShowCopyFeedback("Base64 copied");
            StateHasChanged();
            _ = Task.Delay(2000).ContinueWith(_ =>
            {
                _isBinaryBase64Copied = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch { }
    }

    private async Task DownloadBinaryBytesAsync(byte[] bytes, string colName)
    {
        if (bytes == null || bytes.Length == 0) return;
        try
        {
            string ext;
            if (BinaryDataHelper.IsImage(bytes, out var imgFormat, out _))
            {
                ext = imgFormat.ToLowerInvariant();
                if (ext == "jpeg") ext = "jpg";
            }
            else if (BinaryDataHelper.IsPdf(bytes))
            {
                ext = "pdf";
            }
            else
            {
                ext = "bin";
            }

            var cleanCol = string.IsNullOrWhiteSpace(colName) ? "data" : colName.Replace(" ", "_");
            var fileName = $"{cleanCol}_{DateTime.Now:yyyyMMdd_HHmmss}.{ext}";

            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            ShowCopyFeedback($"Downloaded {fileName}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading binary data: {ex.Message}");
        }
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (!string.IsNullOrEmpty(_activePdfBlobUrl))
        {
            try { _ = JS.InvokeVoidAsync("revokeBlobUrl", _activePdfBlobUrl); } catch { }
        }
        try { _ = JS.InvokeVoidAsync("destroyGridColumnResizers", _tableContainerId); } catch { }
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        _copyFeedbackCts?.Cancel();
        _copyFeedbackCts?.Dispose();
    }
}





