    private void ClearCellSelection()
    {
        _isAllSelected = false;
        SelectedEntireRows.Clear();
        SelectedEntireCols.Clear();
        SelectedCells.Clear();
        _lastSelectedCell = (-1, -1);
    }

    private bool HasAnySelection => _isAllSelected || SelectedEntireRows.Count > 0 || SelectedEntireCols.Count > 0 || SelectedCells.Count > 0;

    private bool IsCellSelected(int actualRowIndex, int localCol)
    {
        if (!HasAnySelection) return false;
        return _isAllSelected || 
               SelectedEntireRows.Contains(actualRowIndex) || 
               SelectedEntireCols.Contains(localCol) || 
               SelectedCells.Contains((actualRowIndex, localCol));
    }

    private bool IsRowFullySelected(int actualRowIndex)
    {
        if (!HasAnySelection) return false;
        if (_isAllSelected || SelectedEntireRows.Contains(actualRowIndex)) return true;
        if (Columns.Count == 0) return false;
        for (int c = 0; c < Columns.Count; c++)
        {
            if (!IsCellSelected(actualRowIndex, c)) return false;
        }
        return true;
    }

