    private string? GetColumnValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val))
        {
            if (val is DateTime dt)
            {
                return dt.ToString("M/d/yyyy h:mm:ss.fff tt");
            }
            if (val is DateTimeOffset dto)
            {
                return dto.ToString("M/d/yyyy h:mm:ss.fff tt zzz");
            }
            return val?.ToString();
        }
        return null;
    }

    private List<IDictionary<string, object>> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return Rows;

            var searchStr = SearchCaseSensitive ? SearchTerm : SearchTerm.ToLowerInvariant();
            
            return Rows.Where(r => 
                r.Values.Any(v => 
                {
                    if (v == null) return false;
                    var valStr = SearchCaseSensitive ? v.ToString()! : v.ToString()!.ToLowerInvariant();
                    
                    if (SearchExactMatch)
                    {
                        return valStr == searchStr;
                    }
                    if (SearchMatchWholeWord)
                    {
                        return valStr.Split(' ', '.', '_', '-', ',', ';', ':', '/', '\\').Contains(searchStr);
                    }
                    return valStr.Contains(searchStr);
                })
            ).ToList();
        }
    }

    private int TotalPages => PageSize == -1 ? 1 : (int)Math.Ceiling(FilteredRows.Count / (double)PageSize);

    private List<IDictionary<string, object>> SortedRows
    {
        get
        {
            var filtered = FilteredRows;
            if (string.IsNullOrEmpty(SortColumn)) return filtered;

            try 
            {
                if (SortAscending)
                    return filtered.OrderBy(r => GetSortValue(r, SortColumn)).ToList();
                else
                    return filtered.OrderByDescending(r => GetSortValue(r, SortColumn)).ToList();
            }
            catch
            {
                // Fallback to string sort if types are mixed
                if (SortAscending)
                    return filtered.OrderBy(r => GetColumnValue(r, SortColumn)).ToList();
                else
                    return filtered.OrderByDescending(r => GetColumnValue(r, SortColumn)).ToList();
            }
        }
    }

    private object? GetSortValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val) && val != null)
        {
            if (val is string s) return s;
            if (val is IComparable) return val;
            return val.ToString();
        }
        return null;
    }

    private string? SortColumn = null;
    private bool SortAscending = true;

    private void SortBy(string column)
    {
        ClearCellSelection();
        if (SortColumn == column)
        {
            if (SortAscending)
                SortAscending = false;
            else
                SortColumn = null;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        CurrentPage = 1;
    }

    private List<IDictionary<string, object>> PagedRows
    {
        get
        {
            var sorted = SortedRows;
            if (PageSize == -1) return sorted;
            
            return sorted.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    private void SetPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        ClearCellSelection();
        CurrentPage = page;
    }

    private void HideContextMenu()
    {
        ShowContextMenuState = false;
        IsColumnContextMenu = false;
    }

    private bool IsRowFullySelected(int rowIndex)
    {
        if (Columns.Count == 0) return false;
        for (int c = 0; c < Columns.Count; c++)
        {
            if (!SelectedCells.Contains((rowIndex, c))) return false;
        }
        return true;
    }

    private void HandleRowHeaderClick(MouseEventArgs e, int rowIndex)
    {
        HideContextMenu();

        if (Columns.Count == 0) return;

        if (e.CtrlKey || e.MetaKey)
        {
            bool allSelected = IsRowFullySelected(rowIndex);
            for (int c = 0; c < Columns.Count; c++)
            {
                if (allSelected)
                {
                    SelectedCells.Remove((rowIndex, c));
                }
                else
                {
                    SelectedCells.Add((rowIndex, c));
                }
            }
            if (!allSelected)
            {
                _lastSelectedCell = (rowIndex, 0);
            }
        }
        else if (e.ShiftKey && _lastSelectedCell.Row >= 0)
        {
            SelectedCells.Clear();
            int startR = Math.Min(_lastSelectedCell.Row, rowIndex);
            int endR = Math.Max(_lastSelectedCell.Row, rowIndex);

            for (int r = startR; r <= endR; r++)
            {
                for (int c = 0; c < Columns.Count; c++)
                {
                    SelectedCells.Add((r, c));
                }
            }
        }
        else
        {
            SelectedCells.Clear();
            for (int c = 0; c < Columns.Count; c++)
            {
                SelectedCells.Add((rowIndex, c));
            }
            _lastSelectedCell = (rowIndex, 0);
        }
    }

    private void HandleCellClick(MouseEventArgs e, int rowIndex, int colIndex)
    {
        HideContextMenu();

        var coord = (rowIndex, colIndex);

        if (e.CtrlKey || e.MetaKey)
        {
            if (SelectedCells.Contains(coord))
            {
                SelectedCells.Remove(coord);
            }
            else
            {
                SelectedCells.Add(coord);
                _lastSelectedCell = coord;
            }
        }
        else if (e.ShiftKey && _lastSelectedCell.Row >= 0 && _lastSelectedCell.Col >= 0)
        {
            SelectedCells.Clear();
            int startR = Math.Min(_lastSelectedCell.Row, rowIndex);
            int endR = Math.Max(_lastSelectedCell.Row, rowIndex);
            int startC = Math.Min(_lastSelectedCell.Col, colIndex);
            int endC = Math.Max(_lastSelectedCell.Col, colIndex);

            for (int r = startR; r <= endR; r++)
            {
                for (int c = startC; c <= endC; c++)
                {
                    SelectedCells.Add((r, c));
                }
            }
        }
        else
        {
            SelectedCells.Clear();
            SelectedCells.Add(coord);
            _lastSelectedCell = coord;
        }
    }

    private void ToggleSelectAll()
    {
        HideContextMenu();
        var pagedCount = PagedRows.Count;
        var colCount = Columns.Count;
        if (pagedCount == 0 || colCount == 0) return;

        int totalCells = pagedCount * colCount;
        if (SelectedCells.Count == totalCells)
        {
            ClearCellSelection();
        }
        else
        {
            SelectedCells.Clear();
            for (int r = 0; r < pagedCount; r++)
            {
                for (int c = 0; c < colCount; c++)
                {
                    SelectedCells.Add((r, c));
                }
            }
            _lastSelectedCell = (0, 0);
        }
        StateHasChanged();
    }

    private void SelectAllCurrentPage()
    {
        HideContextMenu();
        SelectedCells.Clear();
        var pagedCount = PagedRows.Count;
        var colCount = Columns.Count;
        for (int r = 0; r < pagedCount; r++)
        {
            for (int c = 0; c < colCount; c++)
            {
                SelectedCells.Add((r, c));
            }
        }
        _lastSelectedCell = (0, 0);
        StateHasChanged();
    }

