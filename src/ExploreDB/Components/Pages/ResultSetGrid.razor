    private string BuildClipboardText(bool includeHeaders)
    {
        var paged = PagedRows;
        if (paged.Count == 0 || Columns.Count == 0 || SelectedCells.Count == 0) return string.Empty;

        // Single cell special case: clean raw copy
        if (SelectedCells.Count == 1)
        {
            var (r, c) = SelectedCells.First();
            if (r >= 0 && r < paged.Count && c >= 0 && c < Columns.Count)
            {
                var val = GetColumnValue(paged[r], Columns[c]) ?? "NULL";
                if (includeHeaders)
                {
                    return $"{Columns[c]}\r\n{val}";
                }
                return val;
            }
        }

        var targetRows = SelectedCells.Select(x => x.Row).Where(r => r >= 0 && r < paged.Count).Distinct().OrderBy(r => r).ToList();
        var targetCols = SelectedCells.Select(x => x.Col).Where(c => c >= 0 && c < Columns.Count).Distinct().OrderBy(c => c).ToList();

        if (targetRows.Count == 0 || targetCols.Count == 0) return string.Empty;

        var sb = new System.Text.StringBuilder();

        if (includeHeaders)
        {
            var headerNames = targetCols.Select(c => Columns[c]);
            sb.Append(string.Join("\t", headerNames));
            sb.Append("\r\n");
        }

        for (int rIdx = 0; rIdx < targetRows.Count; rIdx++)
        {
            var row = paged[targetRows[rIdx]];
            var rowValues = new List<string>(targetCols.Count);

            foreach (var c in targetCols)
            {
                if (SelectedCells.Contains((targetRows[rIdx], c)))
                {
                    var val = GetColumnValue(row, Columns[c]);
                    rowValues.Add(val ?? "NULL");
                }
                else
                {
                    rowValues.Add("");
                }
            }

            sb.Append(string.Join("\t", rowValues));
            if (rIdx < targetRows.Count - 1)
            {
                sb.Append("\r\n");
            }
        }

        return sb.ToString();
    }

    private string GetCopySummary()
    {
        if (SelectedCells.Count == 1) return "1 cell";
        if (Columns.Count == 0) return $"{SelectedCells.Count} cells";

        var targetRows = SelectedCells.Select(x => x.Row).Distinct().Count();
        var targetCols = SelectedCells.Select(x => x.Col).Distinct().Count();

        if (targetCols == Columns.Count && SelectedCells.Count == targetRows * Columns.Count)
        {
            return $"{targetRows} row{(targetRows > 1 ? "s" : "")}";
        }

        return $"{SelectedCells.Count} cells";
    }

    private async Task CopySelectedAsync()
    {
        HideContextMenu();
        var text = BuildClipboardText(includeHeaders: false);
        if (!string.IsNullOrEmpty(text))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
                ShowCopyFeedback($"{GetCopySummary()} copied");
            }
            catch { }
        }
    }

    private async Task CopySelectedWithHeadersAsync()
    {
        HideContextMenu();
        var text = BuildClipboardText(includeHeaders: true);
        if (!string.IsNullOrEmpty(text))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
