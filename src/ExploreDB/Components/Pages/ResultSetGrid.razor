@using System.Collections.Generic
@using System.Linq
@inject IJSRuntime JS

<div class="position-relative">
@if (Columns.Count > 0)
{
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <label class="text-muted small mb-0 me-2">Show</label>
            <div class="position-relative">
                <div class="form-control form-control-sm bg-dark text-white border-secondary shadow-sm cursor-pointer d-flex justify-content-between align-items-center" style="width: 75px;" @onclick="() => IsPageSizeDropdownOpen = !IsPageSizeDropdownOpen">
                    <span>@(PageSize == -1 ? "All" : PageSize.ToString())</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                </div>
                @if (IsPageSizeDropdownOpen)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsPageSizeDropdownOpen = false"></div>
                    <div class="dropdown-menu show bg-dark border-secondary shadow-lg p-1 mt-1" style="position: absolute; top: 100%; left: 0; z-index: 1050; min-width: 75px;">
                        @foreach (var size in new[] { 12, 24, 48, 96, -1 })
                        {
                            <button class="dropdown-item text-white py-1 @(PageSize == size ? "bg-primary" : "")" type="button" @onclick="() => { PageSize = size; IsPageSizeDropdownOpen = false; }">
                                @(size == -1 ? "All" : size.ToString())
                            </button>
                        }
                    </div>
                }
            </div>
            <label class="text-muted small mb-0 ms-2">per page</label>
        </div>
        <div style="width: 350px;">
            <div class="input-group input-group-sm flex-grow-1" style="min-width: 0;">
                <input type="text"
                       class="form-control bg-dark text-white border-secondary shadow-none"
                       placeholder="Search in results..."
                       @bind="SearchTerm"
                       @bind:event="oninput" />
                <button class="btn @(SearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => SearchCaseSensitive = !SearchCaseSensitive">
                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                </button>
                <button class="btn @(SearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { SearchMatchWholeWord = !SearchMatchWholeWord; if (SearchMatchWholeWord) SearchExactMatch = false; }">
                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                </button>
                <button class="btn @(SearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { SearchExactMatch = !SearchExactMatch; if (SearchExactMatch) SearchMatchWholeWord = false; }">
                    <i class="bi bi-bullseye fs-6"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive border border-secondary rounded">
        <table class="table table-dark table-striped table-sm table-bordered border-secondary mb-0" style="min-width: 100%; width: max-content;">
            <thead>
                <tr>
                    @foreach (var col in Columns)
                    {
                        <th class="text-info bg-black border-secondary p-0 align-middle" style="resize: horizontal; overflow: hidden; min-width: 120px; max-width: 800px;">
                            <div class="d-flex justify-content-between align-items-center overflow-hidden px-2 py-2" style="cursor: pointer; user-select: none;" @onclick="() => SortBy(col)" @oncontextmenu="e => ShowHeaderContextMenu(e, col)" @oncontextmenu:preventDefault="true">
                                <span class="text-truncate">@col</span>
                                @if (SortColumn == col)
                                {
                                    <i class="bi @(SortAscending ? "bi-sort-up" : "bi-sort-down") ms-2 text-warning flex-shrink-0"></i>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-down-up ms-2 text-muted flex-shrink-0" style="opacity: 0.3;"></i>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in PagedRows)
                {
                    <tr>
                        @foreach (var col in Columns)
                        {
                            var val = GetColumnValue(row, col);
                            <td style="white-space: nowrap; max-width: 1px; overflow: hidden; text-overflow: ellipsis;" title="@val">
                                @if (val == null)
                                {
                                    <span class="text-muted fst-italic">NULL</span>
                                }
                                else
                                {
                                    @val
                                }
                            </td>
                        }
                    </tr>
                }
                @if (PagedRows.Count == 0)
                {
                    <tr>
                        <td colspan="@Columns.Count" class="text-center text-muted py-4">
                            No matching records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(ActiveAggregateColumn))
    {
        <div class="d-flex justify-content-between align-items-center bg-dark border border-secondary rounded mt-3 px-3 py-2 shadow-sm text-white" style="font-size: 0.85rem;">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-warning fw-bold">@ActiveAggregateColumn</span>
                <span class="text-muted">|</span>
                <span>COUNT : <strong class="text-info">@AggCount</strong></span>
                <span class="text-muted">|</span>
                <span>DISTINCT : <strong class="text-info">@AggDistinct</strong></span>
                @if (AggSum.HasValue)
                {
                    <span class="text-muted">|</span>
                    <span>SUM : <strong class="text-info">@AggSum</strong></span>
                }
                @if (AggAverage.HasValue)
                {
                    <span class="text-muted">|</span>
                    <span>AVERAGE : <strong class="text-info">@Math.Round(AggAverage.Value, 2)</strong></span>
                }
                @if (AggMin != null)
                {
                    <span class="text-muted">|</span>
                    <span>MIN : <strong class="text-info">@AggMin</strong></span>
                }
                @if (AggMax != null)
                {
                    <span class="text-muted">|</span>
                    <span>MAX : <strong class="text-info">@AggMax</strong></span>
                }
            </div>
            <i class="bi bi-x-lg text-muted ms-3" style="cursor: pointer; font-size: 0.8rem;" @onclick="() => ActiveAggregateColumn = null" onmouseover="this.classList.replace('text-muted', 'text-white')" onmouseout="this.classList.replace('text-white', 'text-muted')"></i>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small">
            @if (FilteredRows.Count == 0)
            {
                <span>Showing 0 entries</span>
            }
            else
            {
                <span>
                    Showing @((CurrentPage - 1) * (PageSize == -1 ? FilteredRows.Count : PageSize) + 1) to @Math.Min(PageSize == -1 ? FilteredRows.Count : CurrentPage * PageSize, FilteredRows.Count) of @FilteredRows.Count entries
                    @(FilteredRows.Count < Rows.Count ? $"(filtered from {Rows.Count} total entries)" : "")
                </span>
            }
        </div>
        <div class="d-flex align-items-center">
            @if (ExecutionTimeMs.HasValue)
            {
                <span class="text-muted small @(TotalPages > 1 ? "me-3" : "")"><i class="bi bi-stopwatch me-1"></i>@(ExecutionTimeMs.Value)ms</span>
            }
            @if (TotalPages > 1)
            {
                <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                        <button class="page-link bg-dark text-white border-secondary" @onclick="() => SetPage(CurrentPage - 1)">Previous</button>
                    </li>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        if (TotalPages > 7 && (pageNum > 2 && pageNum < TotalPages - 1 && Math.Abs(pageNum - CurrentPage) > 1))
                        {
                            if (pageNum == CurrentPage - 2 || pageNum == CurrentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link bg-dark text-white border-secondary">...</span></li>
                            }
                            continue;
                        }
                        
                        <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                            <button class="page-link @(pageNum == CurrentPage ? "bg-primary border-primary" : "bg-dark text-white border-secondary")" @onclick="() => SetPage(pageNum)">@pageNum</button>
                        </li>
                    }
                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                        <button class="page-link bg-dark text-white border-secondary" @onclick="() => SetPage(CurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
        </div>
    </div>
}
else
{
    <div class="alert alert-dark border-secondary text-muted">This result set is empty.</div>
}

@if (ShowContextMenu)
{
    <!-- Invisible overlay to close menu -->
    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1050;" @onclick="HideContextMenu" @oncontextmenu="HideContextMenu" @oncontextmenu:preventDefault="true"></div>
    
    <!-- Top-centered menu relative to this grid -->
    <div class="position-absolute shadow-lg" style="top: 45px; left: 50%; transform: translateX(-50%); z-index: 1060; min-width: 280px;">
        <div class="card bg-dark border-secondary" @onclick:stopPropagation>
            <div class="card-body p-2">
                <div class="d-flex justify-content-between align-items-center text-info small fw-bold px-2 mb-2 border-bottom border-secondary pb-2" style="letter-spacing: 0.5px;">
                    <span>@ContextMenuColumn</span>
                    <i class="bi bi-x-lg text-muted" style="cursor: pointer; font-size: 0.8rem;" @onclick="HideContextMenu" onmouseover="this.classList.replace('text-muted', 'text-white')" onmouseout="this.classList.replace('text-white', 'text-muted')"></i>
                </div>
                <button class="btn w-100 text-start text-white copy-in-btn border-0 py-2 d-flex align-items-center gap-2" @onclick="CopyColumnAsInClause">
                    <i class="bi bi-clipboard text-muted"></i> Copy as IN clause
                </button>
                <button class="btn w-100 text-start text-white copy-in-btn border-0 py-2 d-flex align-items-center gap-2" @onclick="CalculateAggregates">
                    <i class="bi bi-calculator text-muted"></i> Show aggregate result
                </button>
            </div>
        </div>
    </div>
    
    <style>
        .copy-in-btn:hover { background-color: #0d6efd !important; }
        .copy-in-btn:hover i { color: white !important; }
    </style>
}
</div>

@code {
    [Parameter]
    public IEnumerable<dynamic> Data { get; set; } = Array.Empty<dynamic>();

    [Parameter]
    public long? ExecutionTimeMs { get; set; }

    private List<IDictionary<string, object>> Rows = new();
    
    // Context Menu State
    private bool ShowContextMenu = false;
    private double ContextMenuX = 0;
    private double ContextMenuY = 0;
    private string ContextMenuColumn = "";
    
    // Aggregates State
    private string? ActiveAggregateColumn = null;
    private int AggCount = 0;
    private int AggDistinct = 0;
    private double? AggSum = null;
    private double? AggAverage = null;
    private object? AggMin = null;
    private object? AggMax = null;
    private List<string> Columns = new();

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            CurrentPage = 1;
        }
    }

    private bool _searchCaseSensitive = false;
    private bool SearchCaseSensitive
    {
        get => _searchCaseSensitive;
        set { _searchCaseSensitive = value; CurrentPage = 1; }
    }
    
    private bool _searchMatchWholeWord = false;
    private bool SearchMatchWholeWord
    {
        get => _searchMatchWholeWord;
        set { _searchMatchWholeWord = value; CurrentPage = 1; }
    }
    
    private bool _searchExactMatch = false;
    private bool SearchExactMatch
    {
        get => _searchExactMatch;
        set { _searchExactMatch = value; CurrentPage = 1; }
    }

    private int _pageSize = 24;
    private bool IsPageSizeDropdownOpen = false;
    private int PageSize
    {
        get => _pageSize;
        set
        {
            _pageSize = value;
            CurrentPage = 1;
        }
    }

    private int CurrentPage = 1;

    protected override void OnParametersSet()
    {
        Rows = Data.Select(d => (IDictionary<string, object>)d).ToList();
        if (Rows.Any())
        {
            Columns = Rows.First().Keys.ToList();
        }
        else
        {
            Columns.Clear();
        }
    }

    private string? GetColumnValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val))
        {
            return val?.ToString();
        }
        return null;
    }

    private List<IDictionary<string, object>> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return Rows;

            var searchStr = SearchCaseSensitive ? SearchTerm : SearchTerm.ToLowerInvariant();
            
            return Rows.Where(r => 
                r.Values.Any(v => 
                {
                    if (v == null) return false;
                    var valStr = SearchCaseSensitive ? v.ToString()! : v.ToString()!.ToLowerInvariant();
                    
                    if (SearchExactMatch)
                    {
                        return valStr == searchStr;
                    }
                    if (SearchMatchWholeWord)
                    {
                        return valStr.Split(' ', '.', '_', '-', ',', ';', ':', '/', '\\').Contains(searchStr);
                    }
                    return valStr.Contains(searchStr);
                })
            ).ToList();
        }
    }

    private int TotalPages => PageSize == -1 ? 1 : (int)Math.Ceiling(FilteredRows.Count / (double)PageSize);

    private List<IDictionary<string, object>> SortedRows
    {
        get
        {
            var filtered = FilteredRows;
            if (string.IsNullOrEmpty(SortColumn)) return filtered;

            try 
            {
                if (SortAscending)
                    return filtered.OrderBy(r => GetSortValue(r, SortColumn)).ToList();
                else
                    return filtered.OrderByDescending(r => GetSortValue(r, SortColumn)).ToList();
            }
            catch
            {
                // Fallback to string sort if types are mixed
                if (SortAscending)
                    return filtered.OrderBy(r => GetColumnValue(r, SortColumn)).ToList();
                else
                    return filtered.OrderByDescending(r => GetColumnValue(r, SortColumn)).ToList();
            }
        }
    }

    private object? GetSortValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val) && val != null)
        {
            if (val is string s) return s;
            if (val is IComparable) return val;
            return val.ToString();
        }
        return null;
    }

    private string? SortColumn = null;
    private bool SortAscending = true;

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            if (SortAscending)
                SortAscending = false;
            else
                SortColumn = null;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        CurrentPage = 1;
    }

    private List<IDictionary<string, object>> PagedRows
    {
        get
        {
            var sorted = SortedRows;
            if (PageSize == -1) return sorted;
            
            return sorted.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    private void SetPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
    }

    private void ShowHeaderContextMenu(MouseEventArgs e, string column)
    {
        ContextMenuColumn = column;
        ContextMenuX = e.ClientX;
        ContextMenuY = e.ClientY;
        ShowContextMenu = true;
    }

    private void HideContextMenu()
    {
        ShowContextMenu = false;
    }

    private async Task CopyColumnAsInClause()
    {
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;

        var values = FilteredRows
            .Select(r => GetColumnValue(r, ContextMenuColumn))
            .Where(v => v != null)
            .Select(v => v.ToString())
            .Distinct()
            .ToList();

        if (values.Count > 0)
        {
            // Simple heuristic to check if we need quotes
            bool useQuotes = !decimal.TryParse(values.First(), out _);
            
            var formattedValues = values.Select(v => {
                if (useQuotes)
                {
                    string escaped = v.Replace("'", "''");
                    return string.Format("N'{0}'", escaped);
                }
                return v;
            });
            var inClause = $"IN ({string.Join(", ", formattedValues)})";

            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", inClause);
            }
            catch
            {
                // Clipboard API might fail if not in secure context, silently handle for now
            }
        }
        
        HideContextMenu();
    }

    private void CalculateAggregates()
    {
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;

        var values = FilteredRows
            .Select(r => r.TryGetValue(ContextMenuColumn, out var val) ? val : null)
            .Where(v => v != null)
            .ToList();

        AggCount = values.Count;
        AggDistinct = values.Select(v => v?.ToString()).Distinct().Count();
        
        AggSum = null;
        AggAverage = null;
        AggMin = null;
        AggMax = null;

        if (values.Count > 0)
        {
            var firstVal = values.First();
            if (firstVal is short or int or long or decimal or float or double or byte)
            {
                var doubles = values.Select(v => Convert.ToDouble(v)).ToList();
                AggSum = doubles.Sum();
                AggAverage = doubles.Average();
                AggMin = doubles.Min();
                AggMax = doubles.Max();
            }
            else if (firstVal is DateTime or DateOnly or DateTimeOffset)
            {
                var dates = values.Select(v => Convert.ToDateTime(v)).ToList();
                AggMin = dates.Min().ToString("g");
                AggMax = dates.Max().ToString("g");
            }
            else
            {
                // For strings/GUIDs, we only care about Count and Distinct.
                // Alphabetical Min/Max is rarely useful and clutters the UI.
            }
        }

        ActiveAggregateColumn = ContextMenuColumn;
        HideContextMenu();
    }
}
