    private bool CanCopyAsInClause
    {
        get
        {
            if (_isAllSelected) return false;
            if (SelectedEntireCols.Count > 1) return false;
            if (SelectedEntireRows.Count > 0) return false;

            if (SelectedEntireCols.Count == 1) return true;
            if (IsColumnContextMenu && !string.IsNullOrEmpty(ContextMenuColumn)) return true;

            if (SelectedCells.Count > 0)
            {
                return SelectedCells.Select(c => c.Col).Distinct().Count() == 1;
            }

            return !string.IsNullOrEmpty(ContextMenuColumn);
        }
    }

    private async Task CopyColumnAsInClause()
    {
        HideContextMenu();
        if (!CanCopyAsInClause) return;
        List<string?> rawList;

        if (IsColumnContextMenu || SelectedEntireCols.Count > 0 || (SelectedCells.Count == 0 && SelectedEntireRows.Count == 0 && !_isAllSelected && !string.IsNullOrEmpty(ContextMenuColumn)))
        {
            int colIdx = _tableStore != null ? _tableStore.GetColumnIndex(ContextMenuColumn) : Columns.IndexOf(ContextMenuColumn);
            int rowCount = ActiveRowCount;
            var targetCols = new List<int>();
            if (SelectedEntireCols.Count > 0)
            {
                targetCols.AddRange(SelectedEntireCols.Where(c => c >= 0 && c < Columns.Count).OrderBy(c => c));
            }
            else if (colIdx >= 0)
            {
                targetCols.Add(colIdx);
            }
            if (targetCols.Count == 0) return;

            int limit = Math.Min(rowCount, 10000);
            rawList = new List<string?>(limit * Math.Max(1, targetCols.Count));
            for (int i = 0; i < limit; i++)
            {
                int actualIdx = GetActualRowIndex(i);
                foreach (var c in targetCols)
                {
                    var val = FormatCellValue(GetRawCellValue(actualIdx, c, Columns[c]), c);
                    if (val != null) rawList.Add(val);
    
                }

            }
        }
        else if (SelectedCells.Count > 0 || SelectedEntireRows.Count > 0 || _isAllSelected)
        {
            rawList = new List<string?>();
            int colIdx = !string.IsNullOrEmpty(ContextMenuColumn) ? (_tableStore != null ? _tableStore.GetColumnIndex(ContextMenuColumn) : Columns.IndexOf(ContextMenuColumn)) : 0;
            if (colIdx < 0) colIdx = 0;

            if (_isAllSelected)
            {
                int rowCount = Math.Min(ActiveRowCount, 5000);
                for (int i = 0; i < rowCount; i++)
                {
                    int actualIdx = GetActualRowIndex(i);
                    var val = FormatCellValue(GetRawCellValue(actualIdx, colIdx, Columns[colIdx]), colIdx);
                    if (val != null) rawList.Add(val);
    
                }
            }
            else if (SelectedEntireRows.Count > 0)
            {
                foreach (var r in SelectedEntireRows.OrderBy(x => x).Take(5000))
                {
                    var val = FormatCellValue(GetRawCellValue(r, colIdx, Columns[colIdx]), colIdx);
                    if (val != null) rawList.Add(val);
    
                }
            }
            else
            {
                foreach (var coord in SelectedCells.OrderBy(x => x.Row).Take(5000))
                {
                    if (coord.Col >= 0 && coord.Col < Columns.Count)
                    {
                        var val = FormatCellValue(GetRawCellValue(coord.Row, coord.Col, Columns[coord.Col]), coord.Col);
                        if (val != null) rawList.Add(val);
        
                    }
                }
            }
        }
        else
        {
            return;
        }

        var values = rawList
            .Select(v => v?.ToString())
            .Where(v => !string.IsNullOrEmpty(v))
            .Distinct()
            .ToList();

        if (values.Count > 0)
        {
            var formattedValues = values.Select(v => {
                if (v!.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
                {
                    return v!;
                }
                if (decimal.TryParse(v, out _))
                {
                    return v!;
                }
                string escaped = v!.Replace("'", "''");
                return string.Format("N'{0}'", escaped);
            });
            var inClause = $"IN ({string.Join(", ", formattedValues)})";

            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", inClause);
                ShowCopyFeedback("IN clause copied");
            }
            catch
            {
            }
        }
    }

    private void CalculateAggregates()
    {
        if (!CanCopyAsInClause) return;
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;
        int colIdx = _tableStore != null ? _tableStore.GetColumnIndex(ContextMenuColumn) : Columns.IndexOf(ContextMenuColumn);
        if (colIdx < 0) return;

        int rowCount = ActiveRowCount;
        var values = new List<object?>(Math.Min(rowCount, 100000));
        for (int i = 0; i < rowCount; i++)
        {
            int actualIdx = GetActualRowIndex(i);
            var v = GetRawCellValue(actualIdx, colIdx, ContextMenuColumn);
            if (v != null) values.Add(v);
        }

        AggCount = values.Count;
        AggDistinct = values.Select(v => v is byte[] b ? Convert.ToHexString(b) : v?.ToString()).Distinct().Count();
        
        AggSum = null;
        AggAverage = null;
        AggMin = null;
        AggMax = null;

        if (values.Count > 0)
        {
            var firstVal = values.First();
            if (firstVal is short or int or long or decimal or float or double or byte)
            {
                var doubles = values.Select(v => Convert.ToDouble(v)).ToList();
                AggSum = doubles.Sum();
                AggAverage = doubles.Average();
                AggMin = doubles.Min();
                AggMax = doubles.Max();
            }
            else if (firstVal is DateTime or DateOnly or DateTimeOffset)
            {
                var dates = values.Select(v => Convert.ToDateTime(v)).ToList();
                AggMin = dates.Min().ToString("g");
                AggMax = dates.Max().ToString("g");
            }
        }

        ActiveAggregateColumn = ContextMenuColumn;
        HideContextMenu();
    }

