@using System.Collections.Generic
@using System.Linq
@using System.IO
@using System.Threading
@using ClosedXML.Excel
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@inject IJSRuntime JS
@inject ThemeService ThemeService
@implements IDisposable

<div class="position-relative">
@if (Columns.Count > 0)
{
    @if (IsTextDefinition)
    {
        <div class="code-view-container d-flex flex-column mb-3" style="border: 1px solid var(--app-border); border-radius: 6px; overflow: hidden; background-color: var(--app-surface);">
            <!-- Header Toolbar -->
            <div class="d-flex justify-content-between align-items-center px-3 py-2" style="background-color: var(--app-surface-secondary); border-bottom: 1px solid var(--app-border);">
                <div class="d-flex align-items-center gap-2">
                    @if (ExecutionTimeMs.HasValue)
                    {
                        <span class="text-muted small"><i class="bi bi-stopwatch me-1"></i>@(ExecutionTimeMs.Value)ms</span>
                    }
                </div>
                
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" style="color: var(--app-text); border-color: var(--app-border); font-size: 0.8rem;" @onclick="CopyFullCodeAsync" title="Copy code to clipboard">
                        <i class="bi @(_isCodeCopied ? "bi-check-lg text-success" : "bi-clipboard")"></i>
                        <span>@(_isCodeCopied ? "Copied!" : "Copy")</span>
                    </button>
                    @if (OnOpenCodeInNewTab.HasDelegate)
                    {
                        <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" style="font-size: 0.8rem;" @onclick="HandleOpenInNewTab" title="Open code in a new query tab">
                            <i class="bi bi-box-arrow-up-right"></i>
                            <span>Open in New Tab</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Monaco Editor -->
            <div style="height: 520px; min-height: 280px; width: 100%;">
                <StandaloneCodeEditor @ref="_definitionEditor" Id="@_definitionEditorId" ConstructionOptions="DefinitionEditorConstructionOptions" CssClass="w-100 h-100" />
            </div>
        </div>
    }
    else
    {
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <label class="text-muted small mb-0 me-2">Show</label>
            <div class="position-relative">
                <div class="form-control form-control-sm shadow-sm cursor-pointer d-flex justify-content-between align-items-center" style="width: 75px; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" @onclick="() => IsPageSizeDropdownOpen = !IsPageSizeDropdownOpen">
                    <span>@(PageSize == -1 ? "All" : PageSize.ToString())</span>
                    <i class="bi bi-chevron-down text-muted" style="font-size: 0.75rem;"></i>
                </div>
                @if (IsPageSizeDropdownOpen)
                {
                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsPageSizeDropdownOpen = false"></div>
                    <div class="dropdown-menu show shadow-lg p-1 mt-1" style="position: absolute; top: 100%; left: 0; z-index: 1050; min-width: 75px; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                        @foreach (var size in new[] { 12, 24, 48, 96, -1 })
                        {
                            <button class="dropdown-item py-1 @(PageSize == size ? "bg-primary text-white" : "")" style="@(PageSize == size ? "" : "color: var(--app-text);")" type="button" @onclick="() => { PageSize = size; IsPageSizeDropdownOpen = false; }">
                                @(size == -1 ? "All" : size.ToString())
                            </button>
                        }
                    </div>
                }
            </div>
            <label class="text-muted small mb-0 ms-2">per page</label>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm flex-grow-1" style="width: 350px;">
                <input type="text"
                       class="form-control shadow-none"
                       style="background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);"
                       placeholder="Search in results..."
                       @bind="SearchTerm"
                       @bind:event="oninput" />
                <button class="btn @(SearchCaseSensitive ? "btn-primary text-white" : "btn-outline-secondary") px-3" style="z-index: 0; border-color: var(--app-input-border); @(SearchCaseSensitive ? "" : "background-color: var(--app-input-bg); color: var(--app-text-muted);")" title="Match Case" @onclick="() => SearchCaseSensitive = !SearchCaseSensitive">
                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                </button>
                <button class="btn @(SearchMatchWholeWord ? "btn-primary text-white" : "btn-outline-secondary") px-3" style="z-index: 0; border-color: var(--app-input-border); @(SearchMatchWholeWord ? "" : "background-color: var(--app-input-bg); color: var(--app-text-muted);")" title="Match Whole Word" @onclick="() => { SearchMatchWholeWord = !SearchMatchWholeWord; if (SearchMatchWholeWord) SearchExactMatch = false; }">
                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                </button>
                <button class="btn @(SearchExactMatch ? "btn-primary text-white" : "btn-outline-secondary") px-3" style="z-index: 0; border-color: var(--app-input-border); @(SearchExactMatch ? "" : "background-color: var(--app-input-bg); color: var(--app-text-muted);")" title="Exact Match" @onclick="() => { SearchExactMatch = !SearchExactMatch; if (SearchExactMatch) SearchMatchWholeWord = false; }">
                    <i class="bi bi-bullseye fs-6"></i>
                </button>
            </div>
            <button class="btn btn-sm btn-outline-success px-3 d-flex align-items-center gap-2 flex-shrink-0" @onclick="ExportToExcelAsync" disabled="@IsExporting">
                @if (IsExporting)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span>Exporting...</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel"></i>
                    <span>Export</span>
                }
            </button>
        </div>
    </div>

    <div class="table-responsive rounded" style="border: 1px solid var(--app-border);">
        <table class="result-set-table" style="min-width: 100%; width: max-content;">
            <thead>
                <tr>
                    <th class="col-index p-0 align-middle text-center">
                        <div class="px-2 py-2" style="font-size: 0.8rem;">#</div>
                    </th>
                    @foreach (var col in Columns)
                    {
                        <th class="p-0 align-middle" style="resize: horizontal; overflow: hidden; min-width: 120px; max-width: 800px;">
                            <div class="d-flex justify-content-between align-items-center overflow-hidden px-2 py-2" style="cursor: pointer; user-select: none;" @onclick="() => SortBy(col)" @oncontextmenu="e => ShowHeaderContextMenu(e, col)" @oncontextmenu:preventDefault="true">
                                <span class="text-truncate">@col</span>
                                @if (SortColumn == col)
                                {
                                    <i class="bi @(SortAscending ? "bi-sort-up" : "bi-sort-down") ms-2 text-warning flex-shrink-0"></i>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-down-up ms-2 text-muted flex-shrink-0" style="opacity: 0.3;"></i>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    int offset = PageSize == -1 ? 0 : (CurrentPage - 1) * PageSize;
                    int rowIndex = 1;
                }
                @foreach (var row in PagedRows)
                {
                    <tr>
                        <td class="col-index text-center align-middle" style="font-size: 0.8rem;">
                            @(offset + rowIndex++)
                        </td>
                        @foreach (var col in Columns)
                        {
                            var val = GetColumnValue(row, col);
                            <td style="white-space: nowrap; max-width: 1px; overflow: hidden; text-overflow: ellipsis;" title="@val">
                                @if (val == null) { <span class="text-muted fst-italic">NULL</span> } else if (IsJsonOrXml(val)) { <span style="color: var(--app-table-header-text); cursor: pointer; text-decoration: underline;" @onclick="() => OpenCodeViewer(val)" @onclick:stopPropagation>@val</span> } else {
                                    @val
                                }
                            </td>
                        }
                    </tr>
                }
                @if (PagedRows.Count == 0)
                {
                    <tr>
                        <td colspan="@(Columns.Count + 1)" class="text-center text-muted py-4">
                            No matching records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(ActiveAggregateColumn))
    {
        <div class="d-flex justify-content-between align-items-center rounded mt-3 px-3 py-2 shadow-sm" style="font-size: 0.85rem; background-color: var(--app-surface-secondary); border: 1px solid var(--app-border); color: var(--app-text);">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <span class="text-warning fw-bold">@ActiveAggregateColumn</span>
                <span class="text-muted">|</span>
                <span>COUNT : <strong style="color: var(--app-table-header-text);">@AggCount</strong></span>
                <span class="text-muted">|</span>
                <span>DISTINCT : <strong style="color: var(--app-table-header-text);">@AggDistinct</strong></span>
                @if (AggSum.HasValue)
                {
                    <span class="text-muted">|</span>
                    <span>SUM : <strong style="color: var(--app-table-header-text);">@AggSum</strong></span>
                }
                @if (AggAverage.HasValue)
                {
                    <span class="text-muted">|</span>
                    <span>AVERAGE : <strong style="color: var(--app-table-header-text);">@Math.Round(AggAverage.Value, 2)</strong></span>
                }
                @if (AggMin != null)
                {
                    <span class="text-muted">|</span>
                    <span>MIN : <strong style="color: var(--app-table-header-text);">@AggMin</strong></span>
                }
                @if (AggMax != null)
                {
                    <span class="text-muted">|</span>
                    <span>MAX : <strong style="color: var(--app-table-header-text);">@AggMax</strong></span>
                }
            </div>
            <i class="bi bi-x-lg text-muted ms-3" style="cursor: pointer; font-size: 0.8rem;" @onclick="() => ActiveAggregateColumn = null" onmouseover="this.classList.replace('text-muted', 'text-white')" onmouseout="this.classList.replace('text-white', 'text-muted')"></i>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small">
            @if (FilteredRows.Count == 0)
            {
                <span>Showing 0 entries</span>
            }
            else
            {
                <span>
                    Showing @((CurrentPage - 1) * (PageSize == -1 ? FilteredRows.Count : PageSize) + 1) to @Math.Min(PageSize == -1 ? FilteredRows.Count : CurrentPage * PageSize, FilteredRows.Count) of @FilteredRows.Count entries
                    @(FilteredRows.Count < Rows.Count ? $"(filtered from {Rows.Count} total entries)" : "")
                </span>
            }
        </div>
        <div class="d-flex align-items-center">
            @if (ExecutionTimeMs.HasValue)
            {
                <span class="text-muted small @(TotalPages > 1 ? "me-3" : "")"><i class="bi bi-stopwatch me-1"></i>@(ExecutionTimeMs.Value)ms</span>
            }
            @if (TotalPages > 1)
            {
                <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                        <button class="page-link" style="background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border);" @onclick="() => SetPage(CurrentPage - 1)">Previous</button>
                    </li>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        if (TotalPages > 7 && (pageNum > 2 && pageNum < TotalPages - 1 && Math.Abs(pageNum - CurrentPage) > 1))
                        {
                            if (pageNum == CurrentPage - 2 || pageNum == CurrentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link" style="background-color: var(--app-surface); color: var(--app-text-muted); border-color: var(--app-border);">...</span></li>
                            }
                            continue;
                        }
                        
                        <li class="page-item @(pageNum == CurrentPage ? "active" : "")">
                            <button class="page-link @(pageNum == CurrentPage ? "bg-primary border-primary text-white" : "")" style="@(pageNum == CurrentPage ? "" : "background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border);")" @onclick="() => SetPage(pageNum)">@pageNum</button>
                        </li>
                    }
                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                        <button class="page-link" style="background-color: var(--app-surface); color: var(--app-text); border-color: var(--app-border);" @onclick="() => SetPage(CurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
            }
        </div>
    </div>
    }
}
else
{
    <div class="alert border text-muted" style="background-color: var(--app-surface-secondary); border-color: var(--app-border) !important;">This result set is empty.</div>
}

@if (ShowContextMenu)
{
    <!-- Invisible overlay to close menu -->
    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1050;" @onclick="HideContextMenu" @oncontextmenu="HideContextMenu" @oncontextmenu:preventDefault="true"></div>
    
    <!-- Top-centered menu relative to this grid -->
    <div class="position-absolute shadow-lg" style="top: 45px; left: 50%; transform: translateX(-50%); z-index: 1060; min-width: 280px;">
        <div class="card" style="background-color: var(--app-dropdown-bg); border: 1px solid var(--app-border); color: var(--app-text);" @onclick:stopPropagation>
            <div class="card-body p-2">
                <div class="d-flex justify-content-between align-items-center small fw-bold px-2 mb-2 pb-2" style="letter-spacing: 0.5px; color: var(--app-table-header-text); border-bottom: 1px solid var(--app-border);">
                    <span>@ContextMenuColumn</span>
                    <i class="bi bi-x-lg text-muted" style="cursor: pointer; font-size: 0.8rem;" @onclick="HideContextMenu"></i>
                </div>
                <button class="btn w-100 text-start copy-in-btn border-0 py-2 d-flex align-items-center gap-2" style="color: var(--app-text);" @onclick="CopyColumnAsInClause">
                    <i class="bi bi-clipboard text-muted"></i> Copy as IN clause
                </button>
                <button class="btn w-100 text-start copy-in-btn border-0 py-2 d-flex align-items-center gap-2" style="color: var(--app-text);" @onclick="CalculateAggregates">
                    <i class="bi bi-calculator text-muted"></i> Show aggregate result
                </button>
            </div>
        </div>
    </div>
    
    <style>
        .copy-in-btn:hover { background-color: var(--primary-color) !important; color: #ffffff !important; }
        .copy-in-btn:hover i { color: #ffffff !important; }
    </style>
}




@if (IsCodeViewerOpen)
{
    <style>.glass-card { backdrop-filter: none !important; }</style><div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); z-index: 999999;">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="height: 90vh;">
            <div class="modal-content shadow-lg h-100 flex-column d-flex" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border);">
                <div class="modal-header py-2 flex-shrink-0" style="border-bottom: 1px solid var(--app-border);">
                    <h5 class="modal-title d-flex align-items-center gap-2" style="color: var(--app-table-header-text);">
                        <i class="bi bi-file-earmark-code"></i> Data Viewer (@CodeViewerLanguage.ToUpper())
                    </h5>
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <button type="button" class="btn-close @(ThemeService.IsDark ? "btn-close-white" : "") m-0" aria-label="Close" @onclick="CloseCodeViewer"></button>
                    </div>
                </div>
                <div class="modal-body p-0 flex-grow-1 position-relative">
                    <BlazorMonaco.Editor.StandaloneCodeEditor @ref="_codeEditor" Id="cellDataEditor" ConstructionOptions="EditorConstructionOptions" CssClass="w-100 h-100" />
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [Parameter]
    public IEnumerable<dynamic> Data { get; set; } = Array.Empty<dynamic>();

    [Parameter]
    public long? ExecutionTimeMs { get; set; }

    [Parameter]
    public EventCallback<ExportStatus> OnExportStateChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenCodeInNewTab { get; set; }

    private bool IsTextDefinition =>
        Columns.Count == 1 &&
        Columns[0].Equals("Text", StringComparison.OrdinalIgnoreCase) &&
        Rows.Count > 0;

    private string _definitionEditorId = "def-editor-" + Guid.NewGuid().ToString("N");
    private StandaloneCodeEditor? _definitionEditor;
    private bool _isCodeCopied = false;

    private string GetFullCodeText()
    {
        if (!IsTextDefinition) return string.Empty;
        var colName = Columns[0];
        var sb = new System.Text.StringBuilder();
        foreach (var r in Rows)
        {
            if (r.TryGetValue(colName, out var val) && val != null)
            {
                var line = val.ToString() ?? "";
                sb.Append(line);
                if (!line.EndsWith("\n") && !line.EndsWith("\r"))
                {
                    sb.AppendLine();
                }
            }
        }
        return sb.ToString();
    }

    private StandaloneEditorConstructionOptions DefinitionEditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "sql",
            Value = GetFullCodeText(),
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            ReadOnly = true,
            Minimap = new EditorMinimapOptions { Enabled = true },
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            FontSize = 13,
            WordWrap = "off",
            Scrollbar = new EditorScrollbarOptions { UseShadows = false }
        };
    }

    private async Task CopyFullCodeAsync()
    {
        var text = GetFullCodeText();
        if (!string.IsNullOrEmpty(text))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
                _isCodeCopied = true;
                StateHasChanged();
                _ = Task.Delay(2000).ContinueWith(_ =>
                {
                    _isCodeCopied = false;
                    InvokeAsync(StateHasChanged);
                });
            }
            catch { }
        }
    }

    private async Task HandleOpenInNewTab()
    {
        var code = GetFullCodeText();
        if (!string.IsNullOrEmpty(code))
        {
            await OnOpenCodeInNewTab.InvokeAsync(code);
        }
    }

    public record ExportStatus(bool IsExporting, bool IsSuccess, Action CancelAction);

    private List<IDictionary<string, object>> Rows = new();
    
    // Export State
    private bool IsExporting = false;
    private bool ShowExportSuccess = false;
    private CancellationTokenSource? _exportCts;

    // Context Menu State
    private bool ShowContextMenu = false;
    private double ContextMenuX = 0;
    private double ContextMenuY = 0;
    private string ContextMenuColumn = "";
    
    // Aggregates State
    private string? ActiveAggregateColumn = null;
    private int AggCount = 0;
    private int AggDistinct = 0;
    private double? AggSum = null;
    private double? AggAverage = null;
    private object? AggMin = null;
    private object? AggMax = null;
    private List<string> Columns = new();

    private string _searchTerm = "";
    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            CurrentPage = 1;
        }
    }

    private bool _searchCaseSensitive = false;
    private bool SearchCaseSensitive
    {
        get => _searchCaseSensitive;
        set { _searchCaseSensitive = value; CurrentPage = 1; }
    }
    
    private bool _searchMatchWholeWord = false;
    private bool SearchMatchWholeWord
    {
        get => _searchMatchWholeWord;
        set { _searchMatchWholeWord = value; CurrentPage = 1; }
    }
    
    private bool _searchExactMatch = false;
    private bool SearchExactMatch
    {
        get => _searchExactMatch;
        set { _searchExactMatch = value; CurrentPage = 1; }
    }

    private int _pageSize = 24;
    private bool IsPageSizeDropdownOpen = false;
    private int PageSize
    {
        get => _pageSize;
        set
        {
            _pageSize = value;
            CurrentPage = 1;
        }
    }

    private int CurrentPage = 1;

    protected override void OnParametersSet()
    {
        Rows = Data.Select(d => (IDictionary<string, object>)d).ToList();
        if (Rows.Any())
        {
            Columns = Rows.First().Keys.ToList();
        }
        else
        {
            Columns.Clear();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsTextDefinition && _definitionEditor != null)
        {
            try
            {
                var currentText = GetFullCodeText();
                var editorVal = await _definitionEditor.GetValue();
                if (editorVal != currentText)
                {
                    await _definitionEditor.SetValue(currentText);
                }
            }
            catch { }
        }
    }

    private string? GetColumnValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val))
        {
            if (val is DateTime dt)
            {
                return dt.ToString("M/d/yyyy h:mm:ss.fff tt");
            }
            if (val is DateTimeOffset dto)
            {
                return dto.ToString("M/d/yyyy h:mm:ss.fff tt zzz");
            }
            return val?.ToString();
        }
        return null;
    }

    private List<IDictionary<string, object>> FilteredRows
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchTerm))
                return Rows;

            var searchStr = SearchCaseSensitive ? SearchTerm : SearchTerm.ToLowerInvariant();
            
            return Rows.Where(r => 
                r.Values.Any(v => 
                {
                    if (v == null) return false;
                    var valStr = SearchCaseSensitive ? v.ToString()! : v.ToString()!.ToLowerInvariant();
                    
                    if (SearchExactMatch)
                    {
                        return valStr == searchStr;
                    }
                    if (SearchMatchWholeWord)
                    {
                        return valStr.Split(' ', '.', '_', '-', ',', ';', ':', '/', '\\').Contains(searchStr);
                    }
                    return valStr.Contains(searchStr);
                })
            ).ToList();
        }
    }

    private int TotalPages => PageSize == -1 ? 1 : (int)Math.Ceiling(FilteredRows.Count / (double)PageSize);

    private List<IDictionary<string, object>> SortedRows
    {
        get
        {
            var filtered = FilteredRows;
            if (string.IsNullOrEmpty(SortColumn)) return filtered;

            try 
            {
                if (SortAscending)
                    return filtered.OrderBy(r => GetSortValue(r, SortColumn)).ToList();
                else
                    return filtered.OrderByDescending(r => GetSortValue(r, SortColumn)).ToList();
            }
            catch
            {
                // Fallback to string sort if types are mixed
                if (SortAscending)
                    return filtered.OrderBy(r => GetColumnValue(r, SortColumn)).ToList();
                else
                    return filtered.OrderByDescending(r => GetColumnValue(r, SortColumn)).ToList();
            }
        }
    }

    private object? GetSortValue(IDictionary<string, object> row, string column)
    {
        if (row.TryGetValue(column, out var val) && val != null)
        {
            if (val is string s) return s;
            if (val is IComparable) return val;
            return val.ToString();
        }
        return null;
    }

    private string? SortColumn = null;
    private bool SortAscending = true;

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            if (SortAscending)
                SortAscending = false;
            else
                SortColumn = null;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        CurrentPage = 1;
    }

    private List<IDictionary<string, object>> PagedRows
    {
        get
        {
            var sorted = SortedRows;
            if (PageSize == -1) return sorted;
            
            return sorted.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    private void SetPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
    }

    private void ShowHeaderContextMenu(MouseEventArgs e, string column)
    {
        ContextMenuColumn = column;
        ContextMenuX = e.ClientX;
        ContextMenuY = e.ClientY;
        ShowContextMenu = true;
    }

    private void HideContextMenu()
    {
        ShowContextMenu = false;
    }

    private async Task CopyColumnAsInClause()
    {
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;

        var values = FilteredRows
            .Select(r => GetColumnValue(r, ContextMenuColumn))
            .Where(v => v != null)
            .Select(v => v.ToString())
            .Distinct()
            .ToList();

        if (values.Count > 0)
        {
            // Simple heuristic to check if we need quotes
            bool useQuotes = !decimal.TryParse(values.First(), out _);
            
            var formattedValues = values.Select(v => {
                if (useQuotes)
                {
                    string escaped = v.Replace("'", "''");
                    return string.Format("N'{0}'", escaped);
                }
                return v;
            });
            var inClause = $"IN ({string.Join(", ", formattedValues)})";

            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", inClause);
            }
            catch
            {
                // Clipboard API might fail if not in secure context, silently handle for now
            }
        }
        
        HideContextMenu();
    }

    private void CalculateAggregates()
    {
        if (string.IsNullOrEmpty(ContextMenuColumn)) return;

        var values = FilteredRows
            .Select(r => r.TryGetValue(ContextMenuColumn, out var val) ? val : null)
            .Where(v => v != null)
            .ToList();

        AggCount = values.Count;
        AggDistinct = values.Select(v => v?.ToString()).Distinct().Count();
        
        AggSum = null;
        AggAverage = null;
        AggMin = null;
        AggMax = null;

        if (values.Count > 0)
        {
            var firstVal = values.First();
            if (firstVal is short or int or long or decimal or float or double or byte)
            {
                var doubles = values.Select(v => Convert.ToDouble(v)).ToList();
                AggSum = doubles.Sum();
                AggAverage = doubles.Average();
                AggMin = doubles.Min();
                AggMax = doubles.Max();
            }
            else if (firstVal is DateTime or DateOnly or DateTimeOffset)
            {
                var dates = values.Select(v => Convert.ToDateTime(v)).ToList();
                AggMin = dates.Min().ToString("g");
                AggMax = dates.Max().ToString("g");
            }
            else
            {
                // For strings/GUIDs, we only care about Count and Distinct.
                // Alphabetical Min/Max is rarely useful and clutters the UI.
            }
        }

        ActiveAggregateColumn = ContextMenuColumn;
        HideContextMenu();
    }

    private void CancelExport()
    {
        _exportCts?.Cancel();
    }

    private async Task ExportToExcelAsync()
    {
        if (FilteredRows == null || FilteredRows.Count == 0) return;

        // Take snapshot for thread safety in case the user runs another query
        var rowsSnapshot = FilteredRows.ToList();
        var colsSnapshot = Columns.ToList();

        IsExporting = true;
        _exportCts = new CancellationTokenSource();
        if (OnExportStateChanged.HasDelegate)
        {
            await OnExportStateChanged.InvokeAsync(new ExportStatus(true, false, CancelExport));
        }
        StateHasChanged();
        
        // Small delay to ensure the UI renders the loading spinner before the CPU-bound task blocks the thread
        await Task.Delay(50);

        try
        {
            var token = _exportCts.Token;
            byte[] fileBytes = await Task.Run(() =>
            {
                using var workbook = new XLWorkbook();
                var worksheet = workbook.Worksheets.Add("Result Set");

                // Add Headers
                for (int i = 0; i < colsSnapshot.Count; i++)
                {
                    worksheet.Cell(1, i + 1).Value = colsSnapshot[i];
                    worksheet.Cell(1, i + 1).Style.Font.Bold = true;
                }

                // Add Data
                for (int rowIdx = 0; rowIdx < rowsSnapshot.Count; rowIdx++)
                {
                    if (token.IsCancellationRequested) return Array.Empty<byte>();
                    
                    var row = rowsSnapshot[rowIdx];
                    for (int colIdx = 0; colIdx < colsSnapshot.Count; colIdx++)
                    {
                        if (row.TryGetValue(colsSnapshot[colIdx], out var val) && val != null)
                        {
                            if (val is string s) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = s;
                            else if (val is int i) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = i;
                            else if (val is long l) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = l;
                            else if (val is short sh) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = sh;
                            else if (val is byte b) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = b;
                            else if (val is decimal d) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = d;
                            else if (val is double dub) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dub;
                            else if (val is float f) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = f;
                            else if (val is bool bl) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = bl;
                            else if (val is DateTime dt) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = dt;
                            else if (val is TimeSpan ts) worksheet.Cell(rowIdx + 2, colIdx + 1).Value = ts;
                            else worksheet.Cell(rowIdx + 2, colIdx + 1).Value = val.ToString();
                        }
                    }
                }

                if (token.IsCancellationRequested) return Array.Empty<byte>();
                worksheet.Columns().AdjustToContents();

                if (token.IsCancellationRequested) return Array.Empty<byte>();

                using var memoryStream = new MemoryStream();
                workbook.SaveAs(memoryStream);
                if (token.IsCancellationRequested) return Array.Empty<byte>();
                return memoryStream.ToArray();
            }, token);

            if (token.IsCancellationRequested || fileBytes == null || fileBytes.Length == 0)
            {
                return;
            }
            using var stream = new MemoryStream(fileBytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Export_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", streamRef);
            
            ShowExportSuccess = true;
            if (OnExportStateChanged.HasDelegate)
            {
                await OnExportStateChanged.InvokeAsync(new ExportStatus(false, true, null!));
            }
        }
        catch (OperationCanceledException)
        {
            // Export was cancelled by the user, do nothing
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to excel: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
            if (OnExportStateChanged.HasDelegate && !ShowExportSuccess)
            {
                _ = OnExportStateChanged.InvokeAsync(new ExportStatus(false, false, null!));
            }
            _exportCts?.Dispose();
            _exportCts = null;
            StateHasChanged();
        }
    }

    private bool IsJsonOrXml(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return false;
        var trimmed = val.TrimStart();
        if (trimmed.Length < 2) return false;
        char first = trimmed[0];
        return first == '{' || first == '[' || first == '<';
    }

    private bool IsCodeViewerOpen = false;
    private string CodeViewerContent = "";
    private string CodeViewerLanguage = "text";
    private BlazorMonaco.Editor.StandaloneCodeEditor? _codeEditor;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = CodeViewerLanguage,
            Value = CodeViewerContent,
            Theme = ThemeService.IsDark ? "vs-dark" : "vs",
            ReadOnly = true,
            Minimap = new EditorMinimapOptions { Enabled = false },
            FormatOnPaste = true,
            ScrollBeyondLastLine = false
        };
    }
    
    private void OpenCodeViewer(string content)
    {
        CodeViewerContent = content;
        var trimmed = content.TrimStart();
        
        if (trimmed.StartsWith("{") || trimmed.StartsWith("[")) 
        {
            CodeViewerLanguage = "json";
            try 
            {
                var parsed = System.Text.Json.JsonSerializer.Deserialize<object>(content);
                CodeViewerContent = System.Text.Json.JsonSerializer.Serialize(parsed, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            } 
            catch { }
        }
        else if (trimmed.StartsWith("<")) 
        {
            CodeViewerLanguage = "xml";
            try 
            {
                var doc = System.Xml.Linq.XDocument.Parse(content);
                CodeViewerContent = doc.ToString();
            } 
            catch { }
        }
        else 
        {
            CodeViewerLanguage = "text";
        }
        
        IsCodeViewerOpen = true;
        StateHasChanged();
    }
    
    private void CloseCodeViewer()
    {
        IsCodeViewerOpen = false;
    }

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private async void HandleThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
