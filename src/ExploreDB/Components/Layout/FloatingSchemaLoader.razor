@using ExploreDB.Services
@inject SchemaService SchemaService
@implements IDisposable

@if (_showWidget)
{
    <div class="floating-loader-container @(_isExpanded ? "expanded" : "collapsed")" style="position: fixed; bottom: 20px; left: 20px; z-index: 9999; display: flex; flex-direction: column; align-items: flex-start;">
        @if (_isExpanded)
        {
            <div class="card glass-card border-secondary shadow-lg mb-2 p-3 text-white" style="width: 250px; background-color: rgba(33, 37, 41, 0.85); backdrop-filter: blur(12px); border-radius: 12px; transform-origin: bottom left; animation: slideUp 0.3s ease-out forwards;">
                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-database-down me-2"></i>Schema Loading</h6>
                    <button class="btn-close btn-close-white" style="font-size: 0.7rem;" @onclick="ToggleExpand"></button>
                </div>
                
                <div class="d-flex flex-column gap-2 mt-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small @(SchemaService.IsLoadingTables ? "text-info" : "text-success") fw-bold">Tables</span>
                        @if (SchemaService.IsLoadingTables) { <div class="spinner-border spinner-border-sm text-info" role="status"></div> } else { <i class="bi bi-check-circle-fill text-success"></i> }
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small @(SchemaService.IsLoadingViews ? "text-info" : "text-success") fw-bold">Views</span>
                        @if (SchemaService.IsLoadingViews) { <div class="spinner-border spinner-border-sm text-info" role="status"></div> } else { <i class="bi bi-check-circle-fill text-success"></i> }
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small @(SchemaService.IsLoadingStoredProcedures ? "text-info" : "text-success") fw-bold">Procedures</span>
                        @if (SchemaService.IsLoadingStoredProcedures) { <div class="spinner-border spinner-border-sm text-info" role="status"></div> } else { <i class="bi bi-check-circle-fill text-success"></i> }
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small @(SchemaService.IsLoadingFunctions ? "text-info" : "text-success") fw-bold">Functions</span>
                        @if (SchemaService.IsLoadingFunctions) { <div class="spinner-border spinner-border-sm text-info" role="status"></div> } else { <i class="bi bi-check-circle-fill text-success"></i> }
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small @(SchemaService.IsLoadingTypes ? "text-info" : "text-success") fw-bold">Types</span>
                        @if (SchemaService.IsLoadingTypes) { <div class="spinner-border spinner-border-sm text-info" role="status"></div> } else { <i class="bi bi-check-circle-fill text-success"></i> }
                    </div>
                </div>
            </div>
        }

        <button class="loading-fab @(IsAnythingLoading ? "is-loading" : "is-done")" @onclick="ToggleExpand" title="Schema Loading Progress">
            @if (IsAnythingLoading)
            {
                <div class="spinner-ring"></div>
                <i class="bi bi-database-down icon-pulse"></i>
            }
            else
            {
                <i class="bi bi-check2 icon-success"></i>
            }
        </button>
    </div>

    <style>
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(10px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        
        .loading-fab {
            position: relative;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(20, 24, 30, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            padding: 0;
            outline: none;
            color: #fff;
        }

        .loading-fab:hover {
            background: rgba(30, 35, 43, 0.9);
            border-color: rgba(255, 255, 255, 0.2);
        }
        

        .spinner-ring {
            position: absolute;
            top: -2px; left: -2px; right: -2px; bottom: -2px;
            border-radius: 50%;
            border: 2px solid transparent;
            border-top-color: #0dcaf0;
            border-right-color: rgba(13, 202, 240, 0.3);
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .icon-pulse {
            font-size: 1.4rem;
            color: #0dcaf0;
            animation: pulse-icon 2s ease-in-out infinite;
        }

        @@keyframes pulse-icon {
            0% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); opacity: 0.8; }
        }

        .icon-success {
            font-size: 1.6rem;
            color: #198754;
            animation: pop-in 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @@keyframes pop-in {
            0% { transform: scale(0); }
            100% { transform: scale(1); }
        }
    </style>
}

@code {
    private bool _showWidget = false;
    private bool _isExpanded = false;
    private CancellationTokenSource? _debounceCts;

    public void ForceShow()
    {
        _debounceCts?.Cancel();
        _showWidget = true;
        _isExpanded = true;
        StateHasChanged();
    }

    private bool IsAnythingLoading => SchemaService.IsLoadingTables || 
                                      SchemaService.IsLoadingViews || 
                                      SchemaService.IsLoadingFunctions || 
                                      SchemaService.IsLoadingStoredProcedures || 
                                      SchemaService.IsLoadingTypes;

    protected override void OnInitialized()
    {
        SchemaService.OnTablesLoaded += HandleLoadUpdate;
        SchemaService.OnViewsLoaded += HandleLoadUpdate;
        SchemaService.OnFunctionsLoaded += HandleLoadUpdate;
        SchemaService.OnStoredProceduresLoaded += HandleLoadUpdate;
        SchemaService.OnTypesLoaded += HandleLoadUpdate;
        
        // Initial check in case it's already loading
        if (IsAnythingLoading)
        {
            HandleLoadUpdate();
        }
    }

    private async void HandleLoadUpdate()
    {
        await InvokeAsync(async () =>
        {
            if (IsAnythingLoading)
            {
                if (!_showWidget)
                {
                    // Debounce before showing
                    _debounceCts?.Cancel();
                    _debounceCts = new CancellationTokenSource();
                    try
                    {
                        await Task.Delay(500, _debounceCts.Token);
                        if (IsAnythingLoading)
                        {
                            _showWidget = true;
                            StateHasChanged();
                        }
                    }
                    catch (TaskCanceledException) { }
                }
                else
                {
                    // Already showing, just update UI
                    StateHasChanged();
                }
            }
            else
            {
                // Nothing is loading anymore
                _debounceCts?.Cancel();
                if (_showWidget)
                {
                    // Keep it visible for 1.5 seconds so user sees "Done", then hide
                    StateHasChanged();
                    await Task.Delay(1500);
                    _showWidget = false;
                    _isExpanded = false;
                    StateHasChanged();
                }
            }
        });
    }

    private void ToggleExpand()
    {
        _isExpanded = !_isExpanded;
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        SchemaService.OnTablesLoaded -= HandleLoadUpdate;
        SchemaService.OnViewsLoaded -= HandleLoadUpdate;
        SchemaService.OnFunctionsLoaded -= HandleLoadUpdate;
        SchemaService.OnStoredProceduresLoaded -= HandleLoadUpdate;
        SchemaService.OnTypesLoaded -= HandleLoadUpdate;
    }
}
