@using ExploreDB.Services
@inject NavigationManager Nav
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@implements IDisposable

<div class="d-flex flex-column h-100">
    <div class="px-3 pb-3 pt-2 border-bottom border-secondary">
        @if (!string.IsNullOrEmpty(ActiveServer))
        {
            <div>
                <div class="position-relative mb-2">
                    <input class="form-control form-control-sm bg-dark text-white border-secondary pe-4 text-truncate" 
                           @bind="ConnectionSearch" 
                           @bind:event="oninput"
                           placeholder="Search active connections..." 
                           @onfocus="OpenConnectionDropdown"
                           data-bs-tooltip="true" data-bs-placement="right" data-bs-html="true" data-bs-title="@GetActiveConnectionTooltipHtml()"
                           style="cursor: pointer; font-size: 0.85rem;" />
                    
                    @if (IsConnectionDropdownOpen)
                    {
                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseConnectionDropdown"></div>
                        <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 200px; overflow-y: auto; overscroll-behavior: contain;">
                            @{
                                var filteredConns = ConnectionService.ActiveSessionConnections.Where(c => 
                                    string.IsNullOrWhiteSpace(ConnectionSearch) || 
                                    (c.Name ?? "").Contains(ConnectionSearch, StringComparison.OrdinalIgnoreCase) || 
                                    (c.Server ?? "").Contains(ConnectionSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                                if (filteredConns.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var c in filteredConns)
                                        {
                                            string displayName = string.IsNullOrWhiteSpace(c.Name) ? c.Server : $"{c.Server} ({c.Name})";
                                            <button type="button" class="list-group-item list-group-item-action bg-dark text-light border-0 py-2 px-3 small text-truncate" style="border-bottom: 1px solid #333 !important; font-size: 0.85rem;" data-bs-tooltip="true" data-bs-placement="right" data-bs-html="true" data-bs-title="@GetConnectionTooltipHtml(c)" @onclick="() => OnConnectionSelected(c.ConnectionString)">
                                                @displayName
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 text-muted small text-center">No active connections yet.</div>
                                }
                            }
                        </div>
                    }

                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
                <div class="position-relative">
                    <input class="form-control form-control-sm bg-dark text-white border-secondary pe-4 text-truncate" 
                           @bind="DatabaseSearch" 
                           @bind:event="oninput"
                           placeholder="Search database..." 
                           @onfocus="OpenDropdown"
                           data-bs-tooltip="true" data-bs-placement="right" data-bs-title="@DatabaseSearch"
                           style="cursor: pointer;" />
                    
                    @if (IsDropdownOpen)
                    {
                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseDropdown"></div>
                        <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 200px; overflow-y: auto; overscroll-behavior: contain;">
                            @if (IsLoadingDBs)
                            {
                                <div class="p-3 text-center text-info">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <small>Loading...</small>
                                </div>
                            }
                            else if (ServerDatabases.Any())
                            {
                                var filtered = ServerDatabases.Where(d => string.IsNullOrWhiteSpace(DatabaseSearch) || d.Contains(DatabaseSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                                if (filtered.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var db in filtered)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action bg-dark text-light border-0 py-2 px-3 small text-truncate" style="border-bottom: 1px solid #333 !important; font-size: 0.85rem;" data-bs-tooltip="true" data-bs-placement="right" data-bs-title="@db" @onclick="() => OnDatabaseSelected(db)">
                                                @db
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 text-muted small text-center">No matches found.</div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-muted small text-center">No databases found.</div>
                            }
                        </div>
                    }

                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="flex-grow-1 custom-scrollbar-light" style="overflow-y: auto; overscroll-behavior: contain;">
        <div class="list-group list-group-flush pb-3">

            <a href=""
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsRunnerActive ? "active" : "")">
                <span>Query Runner</span>
            </a>

            <a href="builder"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsPathfinderActive ? "active" : "")">
                <span>Query Builder</span>
            </a>

            <a href="explorer"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsExplorerActive ? "active" : "")">
                <span>Table Explorer</span>
            </a>

            <a href="views"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsViewExplorerActive ? "active" : "")">
                <span>View Explorer</span>
            </a>

            <a href="procs"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsSpExplorerActive ? "active" : "")">
                <span>SP Explorer</span>
            </a>

            <a href="functions"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsFunctionExplorerActive ? "active" : "")">
                <span>Function Explorer</span>
            </a>

            <a href="types"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsTypeExplorerActive ? "active" : "")">
                <span>Type Explorer</span>
            </a>

            <a href="learning"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsLearningActive ? "active" : "")">
                <span>Learning Hub</span>
            </a>
        </div>
    </div>
    
    <div class="p-3 text-center border-top border-secondary mt-auto" style="opacity: 0.5;">
        <small class="text-white">v @Microsoft.Maui.ApplicationModel.AppInfo.Current.VersionString</small>
    </div>
</div>

@code {
    private string CurrentUrl = "";
    private string ActiveServer = "";
    private string SelectedDatabase = "";
    private string DatabaseSearch = "";
    private bool IsDropdownOpen = false;
    private string ConnectionSearch = "";
    private bool IsConnectionDropdownOpen = false;
    private List<string> ServerDatabases = new();
    private bool IsLoadingDBs = false;

    private bool IsRunnerActive => CurrentUrl == Nav.BaseUri || CurrentUrl == Nav.BaseUri.TrimEnd('/');
    private bool IsPathfinderActive => CurrentUrl.Contains("/builder");
    private bool IsLearningActive => CurrentUrl.Contains("/learning");
    private bool IsExplorerActive => CurrentUrl.Contains("/explorer");
    private bool IsViewExplorerActive => CurrentUrl.Contains("/views") && !CurrentUrl.Contains("/view/");
    private bool IsSpExplorerActive => CurrentUrl.Contains("/procs") || CurrentUrl.Contains("/proc/");
    private bool IsFunctionExplorerActive => CurrentUrl.Contains("/functions") || CurrentUrl.Contains("/function/");
    private bool IsTypeExplorerActive => CurrentUrl.Contains("/types") || CurrentUrl.Contains("/type/");

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ConnectionService.OnConnectionChanged += OnConnectionChangedHandler;
        CurrentUrl = Nav.Uri;
        await LoadServerDatabases();
        ConnectionSearch = GetActiveConnectionDisplayName();
    }

    private string GetActiveConnectionDisplayName()
    {
        var active = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == ConnectionService.ConnectionString);
        if (active == null) 
        {
            active = ConnectionService.SavedConnections.FirstOrDefault(c => c.Server == ActiveServer);
        }
        if (active == null) return ActiveServer;
        return string.IsNullOrWhiteSpace(active.Name) ? active.Server : $"{active.Server} ({active.Name})";
    }

    private string GetActiveConnectionTooltipHtml()
    {
        var active = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == ConnectionService.ConnectionString);
        if (active == null)
        {
            active = ConnectionService.SavedConnections.FirstOrDefault(c => c.Server == ActiveServer);
        }
        return GetConnectionTooltipHtml(active);
    }

    private string GetConnectionTooltipHtml(ExploreDB.Services.ConnectionService.SavedConnection c)
    {
        if (c == null) return "";
        string html = $"<b>Connection Name:</b> {(string.IsNullOrWhiteSpace(c.Name) ? "-" : c.Name)}<br/><b>Server Name:</b> {c.Server}<br/><b>Auth Type:</b> {c.AuthType}";
        if (c.AuthType != "Windows" && !string.IsNullOrWhiteSpace(c.Username))
        {
            html += $"<br/><b>User:</b> {c.Username}";
        }
        return html;
    }

    private async void OnConnectionChangedHandler()
    {
        await LoadServerDatabases();
        ConnectionSearch = GetActiveConnectionDisplayName();
        await SchemaService.LoadSchemaAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadServerDatabases()
    {
        if (string.IsNullOrEmpty(ConnectionService.ConnectionString))
        {
            ActiveServer = "";
            ServerDatabases.Clear();
            return;
        }

        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
            string server = builder.DataSource;
            
            if (ActiveServer != server)
            {
                ActiveServer = server;
                IsLoadingDBs = true;
                await InvokeAsync(StateHasChanged);
                
                var dbs = new List<string>();
                var masterBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString) { InitialCatalog = "master" };
                bool fetched = false;

                try
                {
                    using var conn = new Microsoft.Data.SqlClient.SqlConnection(masterBuilder.ConnectionString);
                    await conn.OpenAsync();
                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                    using var reader = await cmd.ExecuteReaderAsync();
                    while (await reader.ReadAsync()) dbs.Add(reader.GetString(0));
                    fetched = true;
                }
                catch { }

                if (!fetched)
                {
                    using var conn = new Microsoft.Data.SqlClient.SqlConnection(ConnectionService.ConnectionString);
                    await conn.OpenAsync();
                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                    using var reader = await cmd.ExecuteReaderAsync();
                    while (await reader.ReadAsync()) dbs.Add(reader.GetString(0));
                }
                ServerDatabases = dbs;
                IsLoadingDBs = false;
            }
            SelectedDatabase = builder.InitialCatalog;
            DatabaseSearch = SelectedDatabase;
        }
        catch
        {
            ActiveServer = "";
            ServerDatabases.Clear();
            IsLoadingDBs = false;
        }
    }

    private void OpenDropdown()
    {
        IsDropdownOpen = true;
        DatabaseSearch = "";
    }

    private void CloseDropdown()
    {
        IsDropdownOpen = false;
        DatabaseSearch = SelectedDatabase;
    }

    private void OpenConnectionDropdown()
    {
        IsConnectionDropdownOpen = true;
        ConnectionSearch = "";
    }

    private void CloseConnectionDropdown()
    {
        IsConnectionDropdownOpen = false;
        ConnectionSearch = GetActiveConnectionDisplayName();
    }

    private void OnConnectionSelected(string connString)
    {
        IsConnectionDropdownOpen = false;
        ConnectionService.SaveActiveConnection(connString);
        ConnectionSearch = GetActiveConnectionDisplayName();
    }

    private void OnConnectionDropdownChanged(ChangeEventArgs e)
    {
        var newConnString = e.Value?.ToString();
        if (!string.IsNullOrEmpty(newConnString))
        {
            ConnectionService.SaveActiveConnection(newConnString);
        }
    }

    private async Task OnDatabaseSelected(string db)
    {
        SelectedDatabase = db;
        DatabaseSearch = db;
        IsDropdownOpen = false;
        await SwitchDatabaseAsync();
    }

    private async Task SwitchDatabaseAsync()
    {
        if (string.IsNullOrEmpty(SelectedDatabase)) return;

        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
            if (builder.InitialCatalog == SelectedDatabase) return;
            
            ConnectionService.NotifyDatabaseSwitching(SelectedDatabase);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50); // Give UI time to render the loader
            
            builder.InitialCatalog = SelectedDatabase;
            var newConnString = builder.ConnectionString;
            
            var result = await ConnectionService.TestConnectionAsync(newConnString);
            if (result.Success)
            {
                ConnectionService.SaveActiveConnection(newConnString);
                // Schema load is automatically triggered by OnConnectionChanged
            }
            else
            {
                var oldBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
                SelectedDatabase = oldBuilder.InitialCatalog; // Revert
            }

            ConnectionService.NotifyDatabaseSwitched();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location;
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ConnectionService.OnConnectionChanged -= OnConnectionChangedHandler;
    }
}
