@using ExploreDB.Services
@inject NavigationManager Nav
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject ThemeService ThemeService
@inject UserSettingsService UserSettingsService
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex flex-column h-100">
    <div class="px-3 pb-3 pt-2 border-bottom border-secondary">
        @if (!string.IsNullOrEmpty(ActiveServer))
        {
            <div>
                <div class="position-relative mb-2">
                    <input class="form-control form-control-sm pe-4 text-truncate" 
                           @bind="ConnectionSearch" 
                           @bind:event="oninput"
                           placeholder="Search active connections..." 
                           @onfocus="OpenConnectionDropdown"
                           data-bs-tooltip="true" data-bs-placement="right" data-bs-html="true" data-bs-title="@GetActiveConnectionTooltipHtml()"
                           style="cursor: pointer; font-size: 0.85rem; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />
                    
                    @if (IsConnectionDropdownOpen)
                    {
                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseConnectionDropdown"></div>
                        <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 200px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                            @{
                                var filteredConns = ConnectionService.ActiveSessionConnections.Where(c => 
                                    string.IsNullOrWhiteSpace(ConnectionSearch) || 
                                    (c.Name ?? "").Contains(ConnectionSearch, StringComparison.OrdinalIgnoreCase) || 
                                    (c.Server ?? "").Contains(ConnectionSearch, StringComparison.OrdinalIgnoreCase)).ToList();

                                if (filteredConns.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var c in filteredConns)
                                        {
                                            string displayName = string.IsNullOrWhiteSpace(c.Name) ? c.Server : $"{c.Server} ({c.Name})";
                                            <div class="list-group-item list-group-item-action border-0 py-2 px-3 small d-flex justify-content-between align-items-center" style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.85rem; background-color: transparent; color: var(--app-text); cursor: pointer;" @onclick="() => OnConnectionSelected(c.ConnectionString)">
                                                <span class="text-truncate flex-grow-1" data-bs-tooltip="true" data-bs-placement="right" data-bs-html="true" data-bs-title="@GetConnectionTooltipHtml(c)">
                                                    @displayName
                                                </span>
                                                <button class="btn p-0 text-danger ms-2 shadow-none bg-transparent border-0 flex-shrink-0" title="Disconnect this server" @onclick="() => OnDisconnectClick(c.ConnectionString)" @onclick:stopPropagation>
                                                    <i class="bi bi-power" style="font-size: 0.95rem;"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 text-muted small text-center">No active connections yet.</div>
                                }
                            }
                        </div>
                    }

                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
                <div class="position-relative">
                    <input class="form-control form-control-sm pe-4 text-truncate" 
                           @bind="DatabaseSearch" 
                           @bind:event="oninput"
                           placeholder="Search database..." 
                           @onfocus="OpenDropdown"
                           data-bs-tooltip="true" data-bs-placement="right" data-bs-title="@DatabaseSearch"
                           style="cursor: pointer; background-color: var(--app-input-bg); color: var(--app-input-text); border-color: var(--app-input-border);" />
                    
                    @if (IsDropdownOpen)
                    {
                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseDropdown"></div>
                        <div class="dropdown-menu show w-100 shadow-lg p-0 mt-1 custom-scrollbar-light custom-scrollbar-solid-track" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 200px; overflow-y: auto; overscroll-behavior: contain; background-color: var(--app-dropdown-bg); border-color: var(--app-border);">
                            @if (IsLoadingDBs)
                            {
                                <div class="p-3 text-center text-info">
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <small>Loading...</small>
                                </div>
                            }
                            else if (ServerDatabases.Any())
                            {
                                var filtered = ServerDatabases.Where(d => string.IsNullOrWhiteSpace(DatabaseSearch) || d.Contains(DatabaseSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                                if (filtered.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var db in filtered)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action border-0 py-2 px-3 small text-truncate" style="border-bottom: 1px solid var(--app-border) !important; font-size: 0.85rem; background-color: transparent; color: var(--app-text);" data-bs-tooltip="true" data-bs-placement="right" data-bs-title="@db" @onclick="() => OnDatabaseSelected(db)">
                                                @db
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 text-muted small text-center">No matches found.</div>
                                }
                            }
                            else
                            {
                                <div class="p-3 text-muted small text-center">No databases found.</div>
                            }
                        </div>
                    }

                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 10px; top: 0; pointer-events: none;">
                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="flex-grow-1 custom-scrollbar-light" style="overflow-y: auto; overscroll-behavior: contain;">
        <div class="list-group list-group-flush pb-3">

            <a href=""
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsRunnerActive ? "active" : "")">
                <span>Query Runner</span>
            </a>

            <a href="builder"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsPathfinderActive ? "active" : "")">
                <span>Query Builder</span>
            </a>

            <a href="relationships"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsRelationshipsActive ? "active" : "")"
               title="Virtual Relationships">
                <span>Virtual Relationships</span>
            </a>

            <div class="sidebar-divider"></div>

            <button type="button" 
                    class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item d-flex align-items-center justify-content-between @(IsAnyExplorerActive && !IsExplorersExpanded ? "active" : "")"
                    @onclick="ToggleExplorers">
                <span>Explorers</span>
                <i class="bi bi-chevron-down text-muted" 
                   style="font-size: 0.75rem; transition: transform 0.2s ease; transform: @(IsExplorersExpanded ? "rotate(0deg)" : "rotate(-90deg)");"></i>
            </button>

            @if (IsExplorersExpanded)
            {
                <div class="sidebar-submenu">
                    <a href="explorer"
                       class="list-group-item list-group-item-action bg-transparent border-0 sidebar-subitem @(IsExplorerActive ? "active" : "")">
                        <span>Tables</span>
                    </a>

                    <a href="views"
                       class="list-group-item list-group-item-action bg-transparent border-0 sidebar-subitem @(IsViewExplorerActive ? "active" : "")">
                        <span>Views</span>
                    </a>

                    <a href="procs"
                       class="list-group-item list-group-item-action bg-transparent border-0 sidebar-subitem @(IsSpExplorerActive ? "active" : "")">
                        <span>Stored Procedures</span>
                    </a>

                    <a href="functions"
                       class="list-group-item list-group-item-action bg-transparent border-0 sidebar-subitem @(IsFunctionExplorerActive ? "active" : "")">
                        <span>Functions</span>
                    </a>

                    <a href="types"
                       class="list-group-item list-group-item-action bg-transparent border-0 sidebar-subitem @(IsTypeExplorerActive ? "active" : "")">
                        <span>Types</span>
                    </a>
                </div>
            }

            <div class="sidebar-divider"></div>

            <a href="tools"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsToolsActive ? "active" : "")">
                <span>Tools Hub</span>
            </a>

            <a href="learning"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsLearningActive ? "active" : "")">
                <span>Learning Hub</span>
            </a>

            <div class="sidebar-divider"></div>

            <a href="app-center"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsAppCenterActive ? "active" : "")">
                <span>App Center</span>
            </a>
        </div>
    </div>
</div>

@code {
    private sealed record CachedServerDbList(List<string> Databases, DateTime FetchedUtc);

    private string CurrentUrl = "";
    private string ActiveServer = "";
    private string SelectedDatabase = "";
    private string DatabaseSearch = "";
    private bool IsDropdownOpen = false;
    private string ConnectionSearch = "";
    private bool IsConnectionDropdownOpen = false;
    private List<string> ServerDatabases = new();
    private bool IsLoadingDBs = false;
    private bool IsExplorersExpanded = false;

    private readonly Dictionary<string, CachedServerDbList> _dbListCache = new(StringComparer.OrdinalIgnoreCase);
    private static readonly TimeSpan DbListCacheTtl = TimeSpan.FromSeconds(60);
    private string _activeConnIdentityKey = "";
    private CancellationTokenSource? _dbLoadCts;
    private long _dbLoadGeneration = 0;
    private volatile bool _disposed = false;

    private bool IsRunnerActive => CurrentUrl == Nav.BaseUri || CurrentUrl == Nav.BaseUri.TrimEnd('/');
    private bool IsPathfinderActive => CurrentUrl.Contains("/builder");
    private bool IsRelationshipsActive => CurrentUrl.Contains("/relationships");
    private bool IsLearningActive => CurrentUrl.Contains("/learning");
    private bool IsToolsActive => CurrentUrl.Contains("/tools");
    private bool IsExplorerActive => CurrentUrl.Contains("/explorer");
    private bool IsViewExplorerActive => CurrentUrl.Contains("/views") && !CurrentUrl.Contains("/view/");
    private bool IsSpExplorerActive => CurrentUrl.Contains("/procs") || CurrentUrl.Contains("/proc/");
    private bool IsFunctionExplorerActive => CurrentUrl.Contains("/functions") || CurrentUrl.Contains("/function/");
    private bool IsTypeExplorerActive => CurrentUrl.Contains("/types") || CurrentUrl.Contains("/type/");
    private bool IsAppCenterActive => CurrentUrl.Contains("/app-center");
    private bool IsAnyExplorerActive => IsExplorerActive || IsViewExplorerActive || IsSpExplorerActive || IsFunctionExplorerActive || IsTypeExplorerActive;

    private void ToggleExplorers()
    {
        IsExplorersExpanded = !IsExplorersExpanded;
    }

    protected override Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ConnectionService.OnConnectionChanged += OnConnectionChangedHandler;
        ConnectionService.OnSavedConnectionsChanged += OnSavedConnectionsChangedHandler;
        ThemeService.OnThemeChanged += HandleThemeChanged;
        CurrentUrl = Nav.Uri;
        if (IsAnyExplorerActive)
        {
            IsExplorersExpanded = true;
        }
        SyncActiveConnectionDisplayFromService();
        _ = LoadServerDatabasesAsync(forceRefresh: false);
        return Task.CompletedTask;
    }

    private string GetActiveConnectionDisplayName()
    {
        var active = ConnectionService.ResolveConnectionMetadata(ConnectionService.ConnectionString);
        if (active == null) return ActiveServer;
        return string.IsNullOrWhiteSpace(active.Name) ? active.Server : $"{active.Server} ({active.Name})";
    }

    private string GetActiveConnectionTooltipHtml()
    {
        var active = ConnectionService.ResolveConnectionMetadata(ConnectionService.ConnectionString);
        return GetConnectionTooltipHtml(active);
    }

    private string GetConnectionTooltipHtml(ExploreDB.Services.ConnectionService.SavedConnection? c)
    {
        if (c == null) return "";
        string html = $"<b>Connection Name:</b> {(string.IsNullOrWhiteSpace(c.Name) ? "-" : c.Name)}<br/><b>Server Name:</b> {c.Server}<br/><b>Auth Type:</b> {c.AuthType}";
        if (c.AuthType != "Windows" && !string.IsNullOrWhiteSpace(c.Username))
        {
            html += $"<br/><b>User:</b> {c.Username}";
        }
        return html;
    }

    private void SyncActiveConnectionDisplayFromService()
    {
        string connStr = ConnectionService.ConnectionString;
        if (string.IsNullOrWhiteSpace(connStr))
        {
            ActiveServer = "";
            SelectedDatabase = "";
            DatabaseSearch = "";
            ConnectionSearch = "";
            _activeConnIdentityKey = "";
            ServerDatabases.Clear();
            IsLoadingDBs = false;
            IsDropdownOpen = false;
            IsConnectionDropdownOpen = false;
            _dbListCache.Clear();
            return;
        }

        PruneDisconnectedDbCache();

        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connStr);
            string server = builder.DataSource ?? "";
            string db = builder.InitialCatalog ?? "";
            string identityKey = ConnectionService.GetConnectionIdentityKey(connStr);

            bool serverChanged =
                !string.Equals(_activeConnIdentityKey, identityKey, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(ActiveServer, server, StringComparison.OrdinalIgnoreCase);

            bool connectionChanged =
                serverChanged ||
                !string.Equals(SelectedDatabase, db, StringComparison.OrdinalIgnoreCase);

            if (connectionChanged)
            {
                IsConnectionDropdownOpen = false;
                IsDropdownOpen = false;
            }

            ActiveServer = server;
            SelectedDatabase = db;
            DatabaseSearch = db;
            _activeConnIdentityKey = identityKey;
            ConnectionSearch = GetActiveConnectionDisplayName();

            if (!string.IsNullOrEmpty(identityKey) && _dbListCache.TryGetValue(identityKey, out var cached))
            {
                ServerDatabases = cached.Databases;
                IsLoadingDBs = false;
            }
            else if (serverChanged)
            {
                ServerDatabases = new List<string>();
            }
        }
        catch
        {
            ConnectionSearch = GetActiveConnectionDisplayName();
        }
    }

    private void PruneDisconnectedDbCache()
    {
        if (_dbListCache.Count == 0) return;
        var activeKeys = new HashSet<string>(
            ConnectionService.ActiveSessionConnections
                .Select(ConnectionService.GetConnectionIdentityKey)
                .Where(k => !string.IsNullOrEmpty(k)),
            StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(ConnectionService.ConnectionString))
        {
            var currentKey = ConnectionService.GetConnectionIdentityKey(ConnectionService.ConnectionString);
            if (!string.IsNullOrEmpty(currentKey)) activeKeys.Add(currentKey);
        }

        foreach (var key in _dbListCache.Keys.ToList())
        {
            if (!activeKeys.Contains(key))
            {
                _dbListCache.Remove(key);
            }
        }
    }

    private async void OnConnectionChangedHandler()
    {
        if (_disposed) return;

        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                SyncActiveConnectionDisplayFromService();
                StateHasChanged();
            });

            var schemaTask = SchemaService.LoadSchemaAsync();
            var dbTask = LoadServerDatabasesAsync(forceRefresh: false);
            await Task.WhenAll(schemaTask, dbTask);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Error handling connection changed in NavMenu");
        }
    }

    private async Task LoadServerDatabasesAsync(bool forceRefresh)
    {
        if (_disposed) return;

        string targetConnStr = ConnectionService.ConnectionString;
        if (string.IsNullOrWhiteSpace(targetConnStr))
        {
            CancelPendingDbLoad();
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                SyncActiveConnectionDisplayFromService();
                StateHasChanged();
            });
            return;
        }

        string identityKey = ConnectionService.GetConnectionIdentityKey(targetConnStr);
        CachedServerDbList? cached = null;
        bool hasCache = !string.IsNullOrEmpty(identityKey) && _dbListCache.TryGetValue(identityKey, out cached);

        if (!forceRefresh && hasCache && cached != null && (DateTime.UtcNow - cached.FetchedUtc) < DbListCacheTtl)
        {
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                if (string.Equals(_activeConnIdentityKey, identityKey, StringComparison.OrdinalIgnoreCase))
                {
                    ServerDatabases = cached.Databases;
                    IsLoadingDBs = false;
                    StateHasChanged();
                }
            });
            return;
        }

        var cts = new CancellationTokenSource();
        var prevCts = Interlocked.Exchange(ref _dbLoadCts, cts);
        try { prevCts?.Cancel(); } catch { }
        try { prevCts?.Dispose(); } catch { }

        long gen = Interlocked.Increment(ref _dbLoadGeneration);
        var token = cts.Token;

        if (!hasCache)
        {
            await InvokeAsync(() =>
            {
                if (_disposed || token.IsCancellationRequested || gen != Interlocked.Read(ref _dbLoadGeneration)) return;
                ServerDatabases = new List<string>();
                IsLoadingDBs = true;
                StateHasChanged();
            });
        }

        try
        {
            var dbs = await Task.Run(async () =>
            {
                var list = new List<string>();
                var masterBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(targetConnStr) { InitialCatalog = "master" };
                bool fetched = false;

                try
                {
                    using var conn = new Microsoft.Data.SqlClient.SqlConnection(masterBuilder.ConnectionString);
                    await conn.OpenAsync(token);
                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                    using var reader = await cmd.ExecuteReaderAsync(token);
                    while (await reader.ReadAsync(token)) list.Add(reader.GetString(0));
                    fetched = true;
                }
                catch (OperationCanceledException) { throw; }
                catch { }

                if (!fetched)
                {
                    token.ThrowIfCancellationRequested();
                    using var conn = new Microsoft.Data.SqlClient.SqlConnection(targetConnStr);
                    await conn.OpenAsync(token);
                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = "SELECT name FROM sys.databases WHERE state = 0 ORDER BY name";
                    using var reader = await cmd.ExecuteReaderAsync(token);
                    while (await reader.ReadAsync(token)) list.Add(reader.GetString(0));
                }

                return list;
            }, token);

            if (_disposed || token.IsCancellationRequested || gen != Interlocked.Read(ref _dbLoadGeneration))
            {
                return;
            }

            await InvokeAsync(() =>
            {
                if (_disposed || token.IsCancellationRequested || gen != Interlocked.Read(ref _dbLoadGeneration)) return;
                if (!string.IsNullOrEmpty(identityKey))
                {
                    _dbListCache[identityKey] = new CachedServerDbList(dbs, DateTime.UtcNow);
                }
                ServerDatabases = dbs;
                IsLoadingDBs = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
        catch
        {
            if (_disposed || token.IsCancellationRequested || gen != Interlocked.Read(ref _dbLoadGeneration))
            {
                return;
            }

            await InvokeAsync(() =>
            {
                if (_disposed || token.IsCancellationRequested || gen != Interlocked.Read(ref _dbLoadGeneration)) return;
                if (!hasCache)
                {
                    ServerDatabases = new List<string>();
                }
                IsLoadingDBs = false;
                StateHasChanged();
            });
        }
    }

    private void CancelPendingDbLoad()
    {
        Interlocked.Increment(ref _dbLoadGeneration);
        var prevCts = Interlocked.Exchange(ref _dbLoadCts, null);
        if (prevCts != null)
        {
            try { prevCts.Cancel(); } catch { }
            try { prevCts.Dispose(); } catch { }
        }
    }

    private void OpenDropdown()
    {
        IsDropdownOpen = true;
        DatabaseSearch = "";
        if (!string.IsNullOrEmpty(_activeConnIdentityKey) &&
            (!_dbListCache.TryGetValue(_activeConnIdentityKey, out var cached) ||
             (DateTime.UtcNow - cached.FetchedUtc) >= DbListCacheTtl))
        {
            _ = LoadServerDatabasesAsync(forceRefresh: true);
        }
    }

    private void CloseDropdown()
    {
        IsDropdownOpen = false;
        DatabaseSearch = SelectedDatabase;
    }

    private void OpenConnectionDropdown()
    {
        IsConnectionDropdownOpen = true;
        ConnectionSearch = "";
    }

    private void CloseConnectionDropdown()
    {
        IsConnectionDropdownOpen = false;
        ConnectionSearch = GetActiveConnectionDisplayName();
    }

    private void OnConnectionSelected(string connString)
    {
        IsConnectionDropdownOpen = false;
        ConnectionService.SaveActiveConnection(connString);
        SyncActiveConnectionDisplayFromService();
    }

    private void OnDisconnectClick(string connString)
    {
        string key = ConnectionService.GetConnectionIdentityKey(connString);
        if (!string.IsNullOrEmpty(key))
        {
            _dbListCache.Remove(key);
        }
        ConnectionService.DisconnectConnection(connString);
        IsConnectionDropdownOpen = false;
        StateHasChanged();
    }

    private void OnConnectionDropdownChanged(ChangeEventArgs e)
    {
        var newConnString = e.Value?.ToString();
        if (!string.IsNullOrEmpty(newConnString))
        {
            ConnectionService.SaveActiveConnection(newConnString);
        }
    }

    private async Task OnDatabaseSelected(string db)
    {
        SelectedDatabase = db;
        DatabaseSearch = db;
        IsDropdownOpen = false;
        await SwitchDatabaseAsync();
    }

    private async Task SwitchDatabaseAsync()
    {
        if (string.IsNullOrEmpty(SelectedDatabase)) return;
        string expectedConnStr = ConnectionService.ConnectionString;
        if (string.IsNullOrEmpty(expectedConnStr)) return;

        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(expectedConnStr);
            if (string.Equals(builder.InitialCatalog, SelectedDatabase, StringComparison.OrdinalIgnoreCase)) return;

            ConnectionService.NotifyDatabaseSwitching(SelectedDatabase);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(50); // Give UI time to render the loader

            builder.InitialCatalog = SelectedDatabase;
            var newConnString = builder.ConnectionString;

            var result = await ConnectionService.TestConnectionAsync(newConnString);
            if (!string.Equals(ConnectionService.ConnectionString, expectedConnStr, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (result.Success)
            {
                ConnectionService.SaveActiveConnection(newConnString);
                // Schema load is automatically triggered by OnConnectionChanged
            }
            else
            {
                var oldBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
                SelectedDatabase = oldBuilder.InitialCatalog; // Revert
                DatabaseSearch = SelectedDatabase;
            }
        }
        catch { }
        finally
        {
            ConnectionService.NotifyDatabaseSwitched();
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location;
        if (IsAnyExplorerActive)
        {
            IsExplorersExpanded = true;
        }
        StateHasChanged();
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void HandleThemeChanged()
    {
        if (_disposed) return;
        InvokeAsync(StateHasChanged);
    }

    private void OnSavedConnectionsChangedHandler()
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            if (_disposed) return;
            ConnectionSearch = GetActiveConnectionDisplayName();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        CancelPendingDbLoad();
        Nav.LocationChanged -= OnLocationChanged;
        ConnectionService.OnConnectionChanged -= OnConnectionChangedHandler;
        ConnectionService.OnSavedConnectionsChanged -= OnSavedConnectionsChangedHandler;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
