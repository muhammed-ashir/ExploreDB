@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ThemeService ThemeService
@inject IJSRuntime JS

<div class="h-100 d-flex flex-column p-3 pt-4" style="height: 100vh; overflow-y: auto; background-color: var(--app-bg); color: var(--app-text);">
    <CascadingValue Value="true" Name="IsPopout">
        <CascadingValue Value="IsAtRoot" Name="IsPopoutRoot">
            @Body
        </CascadingValue>
    </CascadingValue>
</div>

@code {
    private string RootUri = "";

    private bool IsAtRoot 
    {
        get 
        {
            if (string.IsNullOrEmpty(RootUri) || RootUri == Nav.BaseUri) return true;
            return Nav.Uri.Equals(RootUri, StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        RootUri = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("setAppTheme", ThemeService.CurrentTheme);
            }
            catch { }
        }
    }

    private async void HandleThemeChanged()
    {
        try
        {
            await JS.InvokeVoidAsync("setAppTheme", ThemeService.CurrentTheme);
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (RootUri == Nav.BaseUri && !e.Location.Equals(Nav.BaseUri, StringComparison.OrdinalIgnoreCase))
        {
            RootUri = e.Location;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
