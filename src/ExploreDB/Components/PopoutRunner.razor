    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("setUserSettings", UserSettingsService.Settings);
            await JS.InvokeVoidAsync("setEditorFontSize", UserSettingsService.Settings.EditorFontSize);
            await InvokeAsync(StateHasChanged);
            }
            catch { }

            if (_objRef != null)
            {
                try
                {
                    await JS.InvokeVoidAsync("window.globalShortcuts.registerQueryRunner", _objRef);
                    await JS.InvokeVoidAsync("initQueryEditorSplitter", _objRef, "popout-editor-resizer", "popout-editor-wrapper");
                }
                catch { }
            }

            try
            {
                await JS.InvokeAsync<bool>("waitForMonaco", 5000);
            }
            catch { }

            _isReady = true;
            if (ActiveTab.ResultSets != null && ActiveTab.ResultSets.Count > 1 && ResultTab == "Results")
            {
                try { await JS.InvokeVoidAsync("initResultSetSplitters", "results-multi-container"); } catch { }
            }
            await InvokeAsync(StateHasChanged);
        }
    }

