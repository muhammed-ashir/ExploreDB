    private int _lastSplitterResultSetCount = 0;
    private Guid _lastSplitterTabId = Guid.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("setUserSettings", UserSettingsService.Settings);
                await JS.InvokeVoidAsync("setEditorFontSize", UserSettingsService.Settings.EditorFontSize);
                await InvokeAsync(StateHasChanged);
            }
            catch { }

            if (_objRef != null)
            {
                try
                {
                    await JS.InvokeVoidAsync("window.globalShortcuts.registerQueryRunner", _objRef);
                    await JS.InvokeVoidAsync("initQueryEditorSplitter", _objRef, "popout-editor-resizer", "popout-editor-wrapper");
                }
                catch { }
            }

            try
            {
                await JS.InvokeAsync<bool>("waitForMonaco", 5000);
            }
            catch { }

            _isReady = true;
            await InvokeAsync(StateHasChanged);
        }

        if (_isReady && ActiveTab.HasExecuted && !IsMinimized && ResultTab == "Results")
        {
            int rsCount = ActiveTab.ResultSets?.Count ?? 0;
            if (rsCount > 1)
            {
                if (_lastSplitterTabId != ActiveTab.Id || _lastSplitterResultSetCount != rsCount)
                {
                    _lastSplitterTabId = ActiveTab.Id;
                    _lastSplitterResultSetCount = rsCount;
                    try { await JS.InvokeVoidAsync("initResultSetSplitters", "results-multi-container"); } catch { }
                }
            }
            else
            {
                _lastSplitterResultSetCount = 0;
            }
        }
    }

