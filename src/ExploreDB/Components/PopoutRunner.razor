            await ExecuteResolvedInputAsync(targetTab, queryText, fullScript ?? "", Math.Max(0, lineOffset));
        }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Block shortcut query execution error handled in PopoutRunner");
        }
        StateHasChanged();
    }

    private async void OnSchemaLoadedHandler()
    {
        try
        {
            if (!_isEditorReady) return;
            var cts = new CancellationTokenSource();
            var prev = Interlocked.Exchange(ref _autocompleteDebounceCts, cts);
            try { prev?.Cancel(); } catch { }
            try { prev?.Dispose(); } catch { }

            await Task.Delay(80, cts.Token);
            await InvokeAsync(RegisterAutocompleteItemsAsync);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Serilog.Log.Warning(ex, "Error handling schema loaded in PopoutRunner");
        }
    }

