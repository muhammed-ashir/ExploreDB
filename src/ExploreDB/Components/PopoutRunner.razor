    private async Task RegisterAutocompleteItemsAsync()
    {
        if (!_isEditorReady) return;
        var schema = SchemaService.GetCachedSchema(ActiveTab.ConnectionString);
        
        object tables = (SchemaService.Tables != null && SchemaService.Tables.Count > 0)
            ? (object)SchemaService.Tables.Select(t => new { 
                name = t.Name, 
                schema = t.Schema,
                fullName = t.FullName, 
                columns = t.Columns.Select(c => c.Name).ToList(),
                insertColumns = t.Columns.Where(c => !c.IsIdentity && !c.IsComputed).Select(c => c.Name).ToList(),
                relations = t.OutgoingKeys.Select(k => new { fromCol = k.FromColumn, toTable = k.ToTable.ToLower(), toCol = k.ToColumn })
                             .Concat(t.IncomingKeys.Select(k => new { fromCol = k.ToColumn, toTable = k.FromTable.ToLower(), toCol = k.FromColumn }))
                             .ToList()
              }).ToList()
            : schema.Tables.Select(t => {
                var parts = t.Replace("[", "").Replace("]", "").Split('.');
                var s = parts.Length > 1 ? parts[0] : "dbo";
                var n = parts.Length > 1 ? parts[1] : parts[0];
                return new { 
                    name = n, 
                    schema = s, 
                    fullName = t, 
                    columns = new List<string>(), 
                    insertColumns = new List<string>(),
                    relations = new List<object>() 
                };
              }).ToList();
        var views = (SchemaService.Views != null && SchemaService.Views.Count > 0)
            ? SchemaService.Views.Select(v => new { name = v.Name, fullName = v.FullName, columns = v.Columns.Select(c => c.Name).ToList() }).ToList()
            : schema.Views.Select(v => new { name = v.Split('.').Last().Trim('[', ']'), fullName = v, columns = new List<string>() }).ToList();
        
        await JS.InvokeVoidAsync("updateSqlAutocompleteData", tables, views, null, null);
        await Task.Delay(1); 

        var columns = schema.Columns;
        await JS.InvokeVoidAsync("updateSqlAutocompleteData", null, null, columns, null);
        await Task.Delay(1);

        var sps = schema.Sps.Select(s => new { name = s.Split('.').Last().Trim('[', ']'), fullName = s, parameters = new List<object>() }).ToList();
        var functions = schema.Functions.Select(f => new { name = f.Split('.').Last().Trim('[', ']'), fullName = f, functionType = "", parameters = new List<object>() }).ToList();
        await JS.InvokeVoidAsync("registerSqlAutocomplete", null, null, null, sps, functions, null);
    }

    private async Task HandleOpenCodeInNewTab(string code)
    {
        if (string.IsNullOrWhiteSpace(code)) return;

        string tabName = "Definition.sql";
        var match = System.Text.RegularExpressions.Regex.Match(
            code,
            @"CREATE\s+(?:OR\s+ALTER\s+)?(?:PROCEDURE|PROC|VIEW|FUNCTION|TRIGGER)\s+([^\s\(\r\n]+)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (match.Success)
        {
            string raw = match.Groups[1].Value.Trim();
            var parts = raw.Split('.');
            string cleanName = parts.Last().Trim('[', ']');
            if (!string.IsNullOrWhiteSpace(cleanName))
            {
                tabName = $"{cleanName}.sql";
            }
        }
        else
        {
            int count = 1;
            while (QueryStateService.Tabs.Any(t => t.Name == $"Definition{count}.sql"))
            {
                count++;
            }
            tabName = $"Definition{count}.sql";
        }

        var newTab = new ExploreDB.Services.QueryTab
        {
            Name = tabName,
            Content = code,
            OriginalContent = code,
            ConnectionString = ActiveTab.ConnectionString
        };

        QueryStateService.Tabs.Add(newTab);
        await QueryStateService.SaveTabsAsync();
    }

    private static bool IsReadOnlyQuery(string queryText)
    {
        var q = queryText.TrimStart();
        if (q.StartsWith("select", StringComparison.OrdinalIgnoreCase) || 
            q.StartsWith("with", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var stripped = q;
        if (stripped.StartsWith("execute", StringComparison.OrdinalIgnoreCase))
        {
            stripped = stripped.Substring(7).TrimStart();
        }
        else if (stripped.StartsWith("exec", StringComparison.OrdinalIgnoreCase))
        {
            stripped = stripped.Substring(4).TrimStart();
        }

        if (stripped.StartsWith("sp_helptext", StringComparison.OrdinalIgnoreCase) ||
            stripped.StartsWith("sp_help", StringComparison.OrdinalIgnoreCase) ||
            stripped.StartsWith("sp_spaceused", StringComparison.OrdinalIgnoreCase) ||
            stripped.StartsWith("sp_depends", StringComparison.OrdinalIgnoreCase) ||
            stripped.StartsWith("sp_who", StringComparison.OrdinalIgnoreCase) ||
            stripped.StartsWith("sp_columns", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    private async Task ExecuteAsync()
    {
        if (ActiveTab.IsExecuting || string.IsNullOrEmpty(ActiveTab.ConnectionString)) return;
        
        // Save content from editor to model before executing
        if (_editor != null)
        {
            ActiveTab.Content = await _editor.GetValue();
        }

        ActiveTab.IsExecuting = true;
        ActiveTab.IsCancelling = false;
        ActiveTab.HasExecuted = true;
        ActiveTab.ResultSets.Clear();
        ActiveTab.Messages.Clear();
        ActiveTab.ExecElapsedSeconds = 0;
        
        _execTimer?.Dispose();
        _execTimer = new System.Timers.Timer(1000);
        _execTimer.Elapsed += (s, e) => {
            ActiveTab.ExecElapsedSeconds++;
            InvokeAsync(StateHasChanged);
        };
        _execTimer.Start();

        ActiveTab.QueryCts = new CancellationTokenSource();
        ResultTab = "Results";
        StateHasChanged();

        var connWatch = System.Diagnostics.Stopwatch.StartNew();
        var queryWatch = new System.Diagnostics.Stopwatch();
        int lineOffset = 0;
        bool isSuccess = false;
        string? errorMessage = null;
        string dbName = "";
        string serverName = "";
        QueryResultTable? currentStreamingTable = null;
        List<object?[]>? currentBatch = null;
        try
        {
            string queryToRun = ActiveTab.Content;

            
            if (_editor != null)
            {
                var selection = await _editor.GetSelection();
                if (selection != null && (selection.StartLineNumber != selection.EndLineNumber || selection.StartColumn != selection.EndColumn))
                {
                    var model = await _editor.GetModel();
                    queryToRun = await model.GetValueInRange(selection, EndOfLinePreference.LF);
                    lineOffset = (int)selection.StartLineNumber - 1;
                }
            }
            
            if (string.IsNullOrWhiteSpace(queryToRun))
            {
                ActiveTab.Messages.Add(new QueryOutputMessage("Error: Query text is empty.", isError: true));
                ResultTab = "Messages";
                return;
            }

            var connStrBuilder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ActiveTab.ConnectionString);
            if (connStrBuilder.PacketSize < 32767)
            {
                connStrBuilder.PacketSize = 32767;
            }
            using var conn = new SqlConnection(connStrBuilder.ConnectionString);
            dbName = conn.Database;
            serverName = conn.DataSource;
            conn.InfoMessage += (sender, e) => 
            {
                InvokeAsync(() => {
                    foreach (SqlError err in e.Errors)
                    {
                        if (err.Class > 10)
                        {
                            var (hMsg, nLine) = FormatSqlErrorHeader(err, lineOffset);
                            ActiveTab.Messages.Add(new QueryOutputMessage(hMsg, isError: true, lineNumber: nLine));
                            ActiveTab.Messages.Add(new QueryOutputMessage(err.Message, isError: true, lineNumber: nLine));
                        }
                        else
                        {
                            ActiveTab.Messages.Add(new QueryOutputMessage(err.Message, isError: false));
                        }
                    }
                    if (e.Errors.Count == 0 && !string.IsNullOrWhiteSpace(e.Message))
                    {
                        ActiveTab.Messages.Add(new QueryOutputMessage(e.Message, isError: false));
                    }
                    StateHasChanged();
                });
            };
            
            ActiveTab.CancelAction = () => { try { conn.Close(); } catch { } };
            await conn.OpenAsync(ActiveTab.QueryCts.Token);
            connWatch.Stop();
            ActiveTab.LastConnectionTimeMs = connWatch.ElapsedMilliseconds;
            queryWatch.Start();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = queryToRun;
            cmd.CommandTimeout = 0;
            
            ActiveTab.CancelAction = () =>
            {
                try { cmd.Cancel(); } catch { }
                try { conn.Close(); } catch { }
            };

            using var ctr = ActiveTab.QueryCts.Token.Register(() => {
                try { cmd.Cancel(); } catch { }
                try { conn.Close(); } catch { }
            });
            
            ActiveTab.IsCurrentQuerySelect = IsReadOnlyQuery(queryToRun);

            using var reader = await cmd.ExecuteReaderAsync(ActiveTab.QueryCts.Token);
            int totalRows = 0;
            int affectedStatementCount = 0;

            var renderWatch = System.Diagnostics.Stopwatch.StartNew();
            
            do
            {
                try
                {
                    // High-performance streaming rowstore
                    int fieldCount = reader.FieldCount;
                    
                    if (fieldCount > 0)
                    {
                        var columnNames = new string[fieldCount];
                        var columnTypes = new string[fieldCount];
                        for (int i = 0; i < fieldCount; i++)
                        {
                            columnNames[i] = reader.GetName(i);
                            if (string.IsNullOrEmpty(columnNames[i])) columnNames[i] = $"Column{i}";
                            try { columnTypes[i] = reader.GetDataTypeName(i); } catch { columnTypes[i] = ""; }
                        }

                        var table = new QueryResultTable(columnNames, columnTypes);
                        currentStreamingTable = table;
                        try
                        {
                            var schemaTable = reader.GetSchemaTable();
                            if (schemaTable != null && schemaTable.Rows.Count > 0)
                            {
                                var hasBaseTable = schemaTable.Columns.Contains("BaseTableName");
                                var hasBaseSchema = schemaTable.Columns.Contains("BaseSchemaName");
                                if (hasBaseTable)
                                {
                                    var baseTable = schemaTable.Rows[0]["BaseTableName"]?.ToString();
                                    var baseSchema = hasBaseSchema ? schemaTable.Rows[0]["BaseSchemaName"]?.ToString() : null;
                                    if (!string.IsNullOrWhiteSpace(baseTable))
                                    {
                                        table.TableName = string.IsNullOrWhiteSpace(baseSchema) ? $"[{baseTable}]" : $"[{baseSchema}].[{baseTable}]";
                                    }
                                }
                            }
                        }
                        catch { }

                        if (string.IsNullOrEmpty(table.TableName) && !string.IsNullOrWhiteSpace(queryToRun))
                        {
                            var match = System.Text.RegularExpressions.Regex.Match(
                                queryToRun,
                                @"\bFROM\s+([\[\]a-zA-Z0-9_\.]+)",
                                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                            if (match.Success)
                            {
                                table.TableName = match.Groups[1].Value.Trim();
                            }
                        }
                        ActiveTab.ResultSets.Add(table);
                        ResultTab = "Results";
                        await InvokeAsync(StateHasChanged);
                        var batch = new List<object?[]>(2000);
                        currentBatch = batch;
                        int yieldCount = 0;
                        while (await reader.ReadAsync(ActiveTab.QueryCts.Token))
                        {
                            if (ActiveTab.QueryCts.IsCancellationRequested || ActiveTab.IsCancelling)
                            {
                                throw new OperationCanceledException(ActiveTab.QueryCts.Token);
                            }

                            var rowValues = new object?[fieldCount];
                            reader.GetValues(rowValues);
                            for (int colIdx = 0; colIdx < fieldCount; colIdx++)
                            {
                                if (rowValues[colIdx] is DBNull) rowValues[colIdx] = null;
                            }
                            batch.Add(rowValues);
                            if (batch.Count >= 2000)
                            {
                                table.AddRows(batch);
                                batch.Clear();
                                if (renderWatch.ElapsedMilliseconds >= 300)
                                {
                                    renderWatch.Restart();
                                    await InvokeAsync(StateHasChanged);
                                }
                                else if (++yieldCount % 10 == 0)
                                {
                                    await Task.Yield();
                                }
                                if (false)
                                {
                                    await Task.Delay(1);
                                    await InvokeAsync(StateHasChanged);
                                }
                            }
                            for (int i = 0; i < fieldCount; i++)
                            {
                                // Value populated above via reader.GetValues
                            }
                            // Row added to batch above
                            
                            // Throttled UI yields handled above every 300ms without thread sleep delay
                        }
                        
                        if (batch.Count > 0)
                        {
                            table.AddRows(batch);
                        }
                        table.IsComplete = true;
                        currentStreamingTable = null;
                        currentBatch = null;
                        await InvokeAsync(StateHasChanged);
                        if (false)
                        ActiveTab.ResultSets.Add(table);
                        totalRows += table.RowCount;
                        var rowWord = table.RowCount == 1 ? "row" : "rows";
                        ActiveTab.Messages.Add($"({table.RowCount} {rowWord} returned)");
                        ActiveTab.Messages.Add("");
                        affectedStatementCount++;
                    }
                    else
                    {
                        if (reader.RecordsAffected >= 0)
                        {
                            var rowWord = reader.RecordsAffected == 1 ? "row" : "rows";
                            ActiveTab.Messages.Add($"({reader.RecordsAffected} {rowWord} affected)");
                ActiveTab.Messages.Add("");

                            affectedStatementCount++;
                        }
                    }
                }
                catch (Exception ex) when (ex is not OperationCanceledException && !(ActiveTab.QueryCts?.IsCancellationRequested ?? false) && !ActiveTab.IsCancelling)
                {
                    ActiveTab.Messages.Add(new QueryOutputMessage($"Error reading result set: {ex.Message}", isError: true));
                    break;
                }
            } while (await reader.NextResultAsync(ActiveTab.QueryCts.Token));

            if (affectedStatementCount == 0 && ActiveTab.ResultSets.Count == 0 && reader.RecordsAffected >= 0)
            {
                var rowWord = reader.RecordsAffected == 1 ? "row" : "rows";
                ActiveTab.Messages.Add($"({reader.RecordsAffected} {rowWord} affected)");
                ActiveTab.Messages.Add("");
            }

            ActiveTab.Messages.Add("");
            ActiveTab.AddCompletionTime();

            ResultTab = ActiveTab.ResultSets.Count == 0 ? "Messages" : "Results";
            isSuccess = true;
        }
        catch (Exception ex) when (ex is OperationCanceledException || (ActiveTab.QueryCts != null && ActiveTab.QueryCts.IsCancellationRequested) || ActiveTab.IsCancelling)
        {
            if (currentBatch != null && currentBatch.Count > 0 && currentStreamingTable != null) { currentStreamingTable.AddRows(currentBatch); currentBatch.Clear(); }
            if (currentStreamingTable != null) currentStreamingTable.IsComplete = true;
            if (ActiveTab.ResultSets != null) { foreach (var rs in ActiveTab.ResultSets.OfType<QueryResultTable>()) rs.IsComplete = true; }
            int partialTotal = ActiveTab.ResultSets?.OfType<QueryResultTable>().Sum(t => t.RowCount) ?? 0;
            if (partialTotal > 0)
            {
                ActiveTab.Messages.Add($"({partialTotal:N0} {(partialTotal == 1 ? "row" : "rows")} returned - Execution cancelled by user)");
                ResultTab = "Results";
            }
            else
            {
                ActiveTab.Messages.Add("Query execution was canceled by the user.");
                ResultTab = "Messages";
            }
            errorMessage = "Cancelled";
            ActiveTab.Messages.Add("");
            ActiveTab.AddCompletionTime();
        }
        catch (Exception ex) when (false)
        {
            ActiveTab.Messages.Add("Query execution was canceled by the user.");
            errorMessage = "Cancelled";
            ActiveTab.Messages.Add("");
            ActiveTab.AddCompletionTime();
            ResultTab = "Messages";
        }
        catch (SqlException sqlEx)
        {
            ResultTab = "Messages";
            errorMessage = sqlEx.Message;
            foreach (SqlError err in sqlEx.Errors)
            {
                var (hMsg, nLine) = FormatSqlErrorHeader(err, lineOffset);
                ActiveTab.Messages.Add(new QueryOutputMessage(hMsg, isError: true, lineNumber: nLine));
                ActiveTab.Messages.Add(new QueryOutputMessage(err.Message, isError: true, lineNumber: nLine));
            }
            if (sqlEx.Errors.Count == 0)
            {
                var (hEx, nExLine) = FormatSqlErrorHeader(sqlEx, lineOffset);
                ActiveTab.Messages.Add(new QueryOutputMessage(hEx, isError: true, lineNumber: nExLine));
                ActiveTab.Messages.Add(new QueryOutputMessage(sqlEx.Message, isError: true, lineNumber: nExLine));
            }
            ActiveTab.Messages.Add("");
            ActiveTab.AddCompletionTime();
        }
        catch (Exception ex)
        {
            ActiveTab.Messages.Add(new QueryOutputMessage($"Error: {ex.Message}", isError: true));
            errorMessage = ex.Message;
            ActiveTab.Messages.Add("");
            ActiveTab.AddCompletionTime();
            ResultTab = "Messages";
        }
        finally
        {
            if (connWatch.IsRunning) connWatch.Stop();
            if (queryWatch.IsRunning) queryWatch.Stop();
            ActiveTab.LastConnectionTimeMs = connWatch.ElapsedMilliseconds;
            _execTimer?.Stop();
            ActiveTab.IsExecuting = false;
            ActiveTab.IsCancelling = false;
            ActiveTab.CancelAction = null;
            var execMs = queryWatch.ElapsedMilliseconds > 0 ? (connWatch.ElapsedMilliseconds + queryWatch.ElapsedMilliseconds) : connWatch.ElapsedMilliseconds;
            var queryMs = queryWatch.ElapsedMilliseconds;
            ActiveTab.LastExecutionTimeMs = execMs;
            ActiveTab.LastQueryTimeMs = queryMs;


            if (isSuccess)
            {
                Serilog.Log.Information(
                    "Query executed in {ExecTimeMs}ms (query: {QueryTimeMs}ms, conn: {ConnTimeMs}ms) on {Server}/{Database} [{TabName}] (Popout)",
                    ActiveTab.LastExecutionTimeMs,
                    ActiveTab.LastQueryTimeMs,
                    ActiveTab.LastConnectionTimeMs,
                    string.IsNullOrEmpty(serverName) ? "Server" : serverName,
                    string.IsNullOrEmpty(dbName) ? "Database" : dbName,
                    ActiveTab.Name);
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                Serilog.Log.Information(
                    "Query finished with {Status} in {ExecTimeMs}ms on {Server}/{Database} [{TabName}] (Popout): {Error}",
                    errorMessage == "Cancelled" ? "Cancellation" : "Error",
                    ActiveTab.LastExecutionTimeMs,
                    string.IsNullOrEmpty(serverName) ? "Server" : serverName,
                    string.IsNullOrEmpty(dbName) ? "Database" : dbName,
                    ActiveTab.Name,
                    errorMessage);
            }


            ActiveTab.QueryCts?.Dispose();
            ActiveTab.QueryCts = null;
            StateHasChanged();
        }
    }

    private async Task DockTab()
    {
        if (_editor != null)
        {
            try
            {
                ActiveTab.Content = await _editor.GetValue();
            }
            catch { }
        }
        WindowManager.DockQueryTab(TabId);
    }

    private async Task ClearQueryAsync()
    {
        if (_editor != null)
        {
            await _editor.SetValue("");
        }
        if (ActiveTab != null)
        {
            ActiveTab.Content = "";
        }
        ShowClearConfirmation = false;
    }

