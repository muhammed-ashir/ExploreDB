@using System.IO
@using BlazorMonaco.Editor
@using BlazorMonaco
@using ExploreDB.Services
@using Microsoft.Data.SqlClient
@using System.Data
@using Microsoft.Extensions.Configuration
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject QueryStateService QueryStateService
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject IJSRuntime JS
@inject ThemeService ThemeService
@inject WindowManagerService WindowManager
@inject UserSettingsService UserSettingsService
@implements IDisposable

<div class="query-runner-container d-flex flex-column h-100 px-3 overflow-hidden" style="background-color: var(--app-bg); color: var(--app-text); padding-top: 12px; padding-bottom: 12px; min-height: 0;">
    <div class="query-runner-toolbar d-flex justify-content-between align-items-center flex-nowrap flex-shrink-0">
        <div class="d-flex flex-column justify-content-center" style="min-width: 0; color: var(--app-text-muted); font-size: 0.85rem;">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-database me-2"></i>
                <span class="fw-medium text-truncate" title="@GetTabConnectionSummary(ActiveTab)">@GetTabConnectionSummary(ActiveTab)</span>
            </div>
            <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-code me-2"></i>
                <span class="text-truncate" title="@(string.IsNullOrEmpty(ActiveTab.FilePath) ? "Unsaved" : ActiveTab.FilePath)">@(string.IsNullOrEmpty(ActiveTab.FilePath) ? "Unsaved" : ActiveTab.FilePath)</span>
            </div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0 align-items-center">
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Dock to Main Window" data-bs-placement="bottom" @onclick="DockTab">
                <i class="bi bi-box-arrow-in-down-right"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Save Query (Ctrl+S)" data-bs-placement="bottom" @onclick="SaveActiveQueryAsync">
                <i class="bi bi-floppy"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Save As... (Ctrl+Shift+S)" data-bs-placement="bottom" @onclick="SaveAsQueryAsync">
                <i class="bi bi-file-earmark-plus"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Clear Editor" data-bs-placement="bottom" @onclick="() => ShowClearConfirmation = true">
                <i class="bi bi-eraser text-warning"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Format SQL" data-bs-placement="bottom" @onclick="FormatSqlAsync">
                <i class="bi bi-magic text-info"></i>
            </button>
            <button class="btn btn-sm toolbar-icon-btn shadow-sm" data-bs-tooltip="true" data-bs-title="Toggle Comment (Ctrl+/)" data-bs-placement="bottom" @onclick="ToggleCommentAsync">
                <i class="bi bi-chat-left-text text-info"></i>
            </button>

            @if (ActiveTab.IsExecuting)
            {
                @if (ActiveTab.IsCancelling)
                {
                    <button class="btn btn-sm btn-danger shadow-sm d-inline-flex align-items-center opacity-75" style="height: 30px;" disabled>
                        <span class="spinner-border spinner-border-sm me-1" role="status" style="width: 12px; height: 12px;"></span>Stopping...
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger shadow-sm d-inline-flex align-items-center" style="height: 30px;" data-bs-tooltip="true" data-bs-title="Stop Execution" data-bs-placement="bottom" @onclick="CancelExecution">
                        <i class="bi bi-stop-fill me-1"></i>Stop
                    </button>
                }
            }
            else
            {
                <button class="btn btn-sm btn-primary shadow-sm d-inline-flex align-items-center" style="height: 30px;" data-bs-tooltip="true" data-bs-title="Execute Query (F5)" data-bs-placement="bottom" @onclick="ExecuteAsync">
                    <i class="bi bi-play-fill me-1"></i>Execute
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(FormatError))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-2 flex-shrink-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Format Error:</strong> @FormatError
            <button type="button" class="btn-close" @onclick="() => FormatError = null" aria-label="Close"></button>
        </div>
    }

    <!-- Split-Pane Workspace Area -->
    <div class="query-runner-workspace d-flex flex-column flex-grow-1 overflow-hidden" style="min-height: 0;">
        <!-- Execution Harness Area (Editor) -->
        <div class="card shadow-sm @(!ActiveTab.HasExecuted || IsMinimized ? "flex-grow-1" : "flex-shrink-0") d-flex flex-column overflow-hidden" style="background-color: var(--app-surface); color: var(--app-text); border: 1px solid var(--app-border); min-height: 120px;">
            <div class="card-body p-0 d-flex flex-column flex-grow-1" style="min-height: 0; overflow: hidden;">
                <div id="popout-editor-wrapper" class="@(!ActiveTab.HasExecuted || IsMinimized ? "flex-grow-1" : "")" style="@(!ActiveTab.HasExecuted || IsMinimized ? "height: 100%;" : (_customEditorHeight.HasValue ? $"height: {_customEditorHeight.Value}px;" : "height: 280px;")) width: 100%; display: block; overflow: hidden; min-height: 120px;">
                    @if (_isReady)
                    {
                        <StandaloneCodeEditor @ref="_editor" Id="query-editor" CssClass="w-100 h-100" ConstructionOptions="EditorConstructionOptions" OnDidInit="EditorOnDidInit" OnDidChangeModelContent="EditorOnDidChangeModelContent" />
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center h-100" style="min-height: 120px;">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span class="text-muted small">Loading editor...</span>
                        </div>
                    }
                </div>
            </div>
            <!-- Resizer Bar (Drag to Resize Query Editor) -->
            <div id="popout-editor-resizer"
                 class="sql-compare-splitter flex-shrink-0"
                 style="@(ActiveTab.HasExecuted && !IsMinimized && !IsFullScreen ? "" : "display: none;")"
                 title="Drag up or down to resize query editor">
                <div class="sql-compare-splitter-handle"></div>
            </div>
        </div>

    <!-- Results Area --> 
    @if (ActiveTab.HasExecuted)
    {
        <div class="@(IsFullScreen ? "position-fixed top-0 start-0 w-100 h-100 p-3" : IsMinimized ? "flex-shrink-0" : "flex-grow-1 d-flex flex-column overflow-hidden")" 
             style="@(IsFullScreen ? "background-color: rgba(15, 15, 20, 0.95); z-index: 9999;" : IsMinimized ? "" : "min-height: 0;")">
            <div class="card glass-card text-white d-flex flex-column h-100" style="@(IsFullScreen ? "height: 100%;" : IsMinimized ? "border-bottom-left-radius: 0; border-bottom-right-radius: 0;" : "min-height: 0;") overflow: hidden;">
                <div class="card-header border-secondary p-0 d-flex justify-content-between align-items-center flex-shrink-0" style="height: 26px; min-height: 26px; max-height: 26px;">
                        <div class="d-flex align-items-center flex-grow-1 overflow-hidden">
                            <ul class="nav nav-tabs border-secondary border-bottom-0 h-100 align-items-center" style="margin-bottom: 0;">
                            <li class="nav-item h-100 d-flex align-items-center">
                                <a class="nav-link d-inline-flex align-items-center gap-1 @(ResultTab == "Results" ? "active bg-dark text-white border-secondary border-bottom-0 fw-semibold" : "text-muted border-transparent")"
                                   @onclick='() => { ResultTab = "Results"; IsMinimized = false; }' style="font-size: 0.78rem; padding: 2px 10px; height: 24px; cursor: pointer; border-radius: 4px 4px 0 0;">
                                    <i class="bi bi-table" style="font-size: 0.75rem;"></i>
                                    <span>Results</span>
                                </a>
                            </li>
                            <li class="nav-item h-100 d-flex align-items-center">
                                <a class="nav-link d-inline-flex align-items-center gap-1 @(ResultTab == "Messages" ? "active bg-dark text-white border-secondary border-bottom-0 fw-semibold" : "text-muted border-transparent")"
                                   @onclick='() => { ResultTab = "Messages"; IsMinimized = false; }' style="font-size: 0.78rem; padding: 2px 10px; height: 24px; cursor: pointer; border-radius: 4px 4px 0 0;">
                                    <i class="bi bi-file-earmark-text" style="font-size: 0.75rem;"></i>
                                    <span>Messages</span>
                                    @if (ActiveTab.MessageBadgeCount > 0) { <span class="badge @(ActiveTab.HasMessageErrors ? "bg-danger text-white" : "bg-secondary") ms-1" style="font-size: 0.65rem; padding: 1px 5px; border-radius: 8px;">@ActiveTab.MessageBadgeCount</span> }
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center ms-3 gap-3">
                            @if (ActiveTab.HasExecuted && ActiveTab.LastExecutionTimeMs >= 0 && !ActiveTab.IsExecuting)
                            {
                                var timingTooltip = ActiveTab.LastConnectionTimeMs > 0 && ActiveTab.LastQueryTimeMs > 0
                                    ? $"Total: {GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)} (Query: {GetFormattedExecutionTimeMs(ActiveTab.LastQueryTimeMs)} | Connection: {GetFormattedExecutionTimeMs(ActiveTab.LastConnectionTimeMs)})"
                                    : $"Total: {GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)}";

                                <span class="text-muted d-inline-flex align-items-center" style="font-size: 0.75rem; white-space: nowrap;" title="@timingTooltip">
                                    <i class="bi bi-stopwatch me-1" style="font-size: 0.75rem;"></i>@GetFormattedExecutionTimeMs(ActiveTab.LastExecutionTimeMs)</span>
                                <!--end-timer-->
                            }
                            @if (ResultTab == "Results" && ActiveTab.ResultSets != null && ActiveTab.ResultSets.Count > 0)
                            {
                                var totalRows = GetTotalRowCount(ActiveTab.ResultSets);
                                @if (ActiveTab.IsExecuting) { <span class="text-primary fw-medium d-inline-flex align-items-center" style="font-size: 0.75rem; white-space: nowrap;"><span class="spinner-border spinner-border-sm me-1" style="width: 0.75rem; height: 0.75rem; border-width: 0.15em;" role="status"></span><span>@(totalRows == 1 ? "1 row" : $"{totalRows:N0} rows")</span></span> } else { <span class="text-muted fw-medium" style="font-size: 0.75rem; white-space: nowrap;">
                                    <i class="bi bi-list me-1" style="font-size: 0.75rem;"></i>@(totalRows == 1 ? "1 row" : $"{totalRows:N0} rows")</span> }
                                <!--end-timer-->
                            }
                            @if (false)
                            {

                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center pe-2 gap-1">
                        @if (ResultTab == "Results" && ActiveTab.ResultSets != null && ActiveTab.ResultSets.Count > 0 && !ActiveTab.IsExecuting)
                        {
                            <button class="btn btn-sm d-flex align-items-center gap-1 me-1 @(_isSearchOpen ? "btn-primary text-white border-0 shadow-sm" : "btn-outline-secondary border-0")" 
                                    style="@(_isSearchOpen ? "" : "color: var(--app-text);") height: 22px; font-size: 0.75rem; padding: 1px 7px;" 
                                    @onclick="ToggleSearch" 
                                    title="Find in results (Ctrl+F)">
                                <i class="bi bi-search" style="font-size: 0.72rem;"></i>
                                <span>Search</span>
                            </button>
                        }
                            @if (false)
                            {

                            }
                            @if (!IsFullScreen)
                            {
                                <button class="btn btn-sm btn-outline-secondary border-0 p-0 d-flex align-items-center justify-content-center text-white me-1" style="width: 22px; height: 22px;" @onclick="ToggleMinimize" title="@(IsMinimized ? "Restore Up (Ctrl+R)" : "Minimize (Ctrl+R)")">
                                    <i class="bi @(IsMinimized ? "bi-chevron-up" : "bi-chevron-down")" style="font-size: 0.75rem; line-height: 1;"></i>
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-secondary border-0 p-0 d-flex align-items-center justify-content-center text-white @(!IsFullScreen ? "me-1" : "")" style="width: 22px; height: 22px;" @onclick="ToggleFullScreen" title="@(IsFullScreen ? "Restore Down" : "Expand to Full Screen")">
                                <i class="bi @(IsFullScreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")" style="font-size: 0.75rem; line-height: 1;"></i>
                            </button>
                            
                            @if (!IsFullScreen)
                            {
                                <button class="btn btn-sm btn-outline-secondary border-0 p-0 d-flex align-items-center justify-content-center text-white" style="width: 22px; height: 22px;" @onclick="() => ActiveTab.HasExecuted = false" title="Close Results">
                                    <i class="bi bi-x-lg" style="font-size: 0.75rem; line-height: 1;"></i>
                                </button>
                            }
                        </div>
                    </div>
                    
                    @if (!IsMinimized)
                    {
                        <div class="card-body p-0 d-flex flex-column flex-grow-1 position-relative overflow-hidden" style="min-height: 0;">
                        @if (ResultTab == "Results")
                        {
                            if (ActiveTab.IsExecuting && (ActiveTab.ResultSets == null || ActiveTab.ResultSets.Count == 0))
                            {
                                <div class="text-center mt-5">
                                    <div class="spinner-border @(ActiveTab.IsCancelling ? "text-warning" : "text-primary")" style="width: 3rem; height: 3rem; border-width: 0.25em;"></div>
                                    <div class="mt-3 text-muted fs-5">
                                        @if (ActiveTab.IsCancelling)
                                        {
                                            <span class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>Cancelling query...</span>
                                        }
                                        else
                                        {
                                            <span>Executing... (@(TimeSpan.FromSeconds(ActiveTab.ExecElapsedSeconds).ToString(@"mm\:ss")))</span>
                                        }
                                    </div>
                                </div>
                            }
                            else if (ActiveTab.ResultSets == null || ActiveTab.ResultSets.Count == 0)
                            {
                                <div class="text-muted text-center mt-5">Command completed successfully. No data tables returned.</div>
                            }
                            else
                            {
                                @if (_isSearchOpen)
                                {
                                    <div class="position-absolute shadow-lg rounded-pill d-flex align-items-center px-2 py-1 gap-2" 
                                         style="top: 10px; right: 20px; z-index: 1050; background: var(--app-surface); border: 1px solid var(--app-border); backdrop-filter: blur(8px); box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
                                        <i class="bi bi-search text-muted small ms-1"></i>
                                        <input type="text" 
                                               class="form-control form-control-sm border-0 bg-transparent py-0 px-1 shadow-none" 
                                               placeholder="Find in results (Ctrl+F)..." 
                                               style="color: var(--app-text); width: 180px; font-size: 0.82rem;"
                                               @bind="_globalSearchTerm" 
                                               @bind:event="oninput" 
                                               @onkeydown='async (e) => { if (e.Key == "Escape") { if (!string.IsNullOrEmpty(_globalSearchTerm)) _globalSearchTerm = string.Empty; else await ToggleSearch(); } }'
                                               id="global-results-search-input" />
                                        
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-sm py-0 px-1 @(_searchCaseSensitive ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                    style="font-size: 0.72rem; border-radius: 4px;" 
                                                    @onclick="() => _searchCaseSensitive = !_searchCaseSensitive" 
                                                    title="Match Case">
                                                Aa
                                            </button>
                                            <button class="btn btn-sm py-0 px-1 ms-1 @(_searchMatchWholeWord ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                    style="font-size: 0.72rem; border-radius: 4px;" 
                                                    @onclick="() => _searchMatchWholeWord = !_searchMatchWholeWord" 
                                                    title="Match Whole Word">
                                                [ab]
                                            </button>
                                            <button class="btn btn-sm py-0 px-1 ms-1 @(_searchExactMatch ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                    style="font-size: 0.72rem; border-radius: 4px;" 
                                                    @onclick="() => _searchExactMatch = !_searchExactMatch" 
                                                    title="Exact Match">
                                                ⊚
                                            </button>
                                        </div>

                                        <button class="btn btn-sm btn-link text-muted p-0 border-0 ms-1 me-1" 
                                                @onclick="HandleSearchCloseClick" 
                                                title="@(!string.IsNullOrEmpty(_globalSearchTerm) ? "Clear (Esc)" : "Close (Esc)")">
                                            <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
                                        </button>
                                    </div>
                                }
                                <div id="results-multi-container" class="w-100 h-100 d-flex flex-column position-relative custom-scrollbar-light" style="overflow-y: auto; overflow-x: hidden; min-height: 0;">
                                    @if (false /* Search moved outside scroll container */ && _isSearchOpen)
                                    {
                                        <div class="position-absolute shadow-lg rounded-pill d-flex align-items-center px-2 py-1 gap-2" 
                                             style="top: 10px; right: 20px; z-index: 1050; background: var(--app-surface); border: 1px solid var(--app-border); backdrop-filter: blur(8px); box-shadow: 0 4px 20px rgba(0,0,0,0.35);">
                                            <i class="bi bi-search text-muted small ms-1"></i>
                                            <input type="text" 
                                                   class="form-control form-control-sm border-0 bg-transparent py-0 px-1 shadow-none" 
                                                   placeholder="Find in results (Ctrl+F)..." 
                                                   style="color: var(--app-text); width: 180px; font-size: 0.82rem;"
                                                   @bind="_globalSearchTerm" 
                                                   @bind:event="oninput" 
                                                   @onkeydown='async (e) => { if (e.Key == "Escape") { if (!string.IsNullOrEmpty(_globalSearchTerm)) _globalSearchTerm = string.Empty; else await ToggleSearch(); } }'
                                                   id="global-results-search-input" />
                                            
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-sm py-0 px-1 @(_searchCaseSensitive ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                        style="font-size: 0.72rem; border-radius: 4px;" 
                                                        @onclick="() => _searchCaseSensitive = !_searchCaseSensitive" 
                                                        title="Match Case">
                                                    Aa
                                                </button>
                                                <button class="btn btn-sm py-0 px-1 ms-1 @(_searchMatchWholeWord ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                        style="font-size: 0.72rem; border-radius: 4px;" 
                                                        @onclick="() => _searchMatchWholeWord = !_searchMatchWholeWord" 
                                                        title="Match Whole Word">
                                                    [ab]
                                                </button>
                                                <button class="btn btn-sm py-0 px-1 ms-1 @(_searchExactMatch ? "btn-primary text-white" : "btn-outline-secondary")" 
                                                        style="font-size: 0.72rem; border-radius: 4px;" 
                                                        @onclick="() => _searchExactMatch = !_searchExactMatch" 
                                                        title="Exact Match">
                                                    ⊚
                                                </button>
                                            </div>

                                            @if (false /* Removed duplicate clear button in search box */)
                                            {
                                                <button class="btn btn-sm btn-link text-muted p-0 border-0 ms-1" 
                                                        @onclick="() => _globalSearchTerm = string.Empty" 
                                                        title="Clear search">
                                                    <i class="bi bi-x-circle-fill" style="font-size: 0.8rem;"></i>
                                                </button>
                                            }

                                            <button class="btn btn-sm btn-link text-muted p-0 border-0 ms-1 me-1" 
                                                    @onclick="HandleSearchCloseClick" 
                                                    title="@(!string.IsNullOrEmpty(_globalSearchTerm) ? "Clear (Esc)" : "Close (Esc)")">
                                                <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
                                            </button>
                                        </div>
                                    }

                                    @for (int i = 0; i < ActiveTab.ResultSets.Count; i++)
                                    {
                                        var rsItem = ActiveTab.ResultSets[i];
                                        var capturedIndex = i + 1;
                                        var totalCount = ActiveTab.ResultSets.Count;

                                        <div @key="rsItem" id="@($"rs-pane-{capturedIndex}")" 
                                             class="d-flex flex-column overflow-hidden" 
                                             style="@GetResultSetPaneStyle(rsItem, totalCount)">
                                            <ExploreDB.Components.Pages.ResultSetGrid Data="rsItem" 
                                                           ResultSetIndex="capturedIndex" 
                                                           TotalResultSets="totalCount" 
                                                           SearchTerm="@_globalSearchTerm" 
                                                           SearchCaseSensitive="@_searchCaseSensitive" 
                                                           SearchMatchWholeWord="@_searchMatchWholeWord" 
                                                           SearchExactMatch="@_searchExactMatch" 
                                                           OnToggleSearch="ToggleSearch"
                                                           OnOpenCodeInNewTab="HandleOpenCodeInNewTab" />
                                        </div>

                                        @if (ActiveTab.ResultSets.Count > 1)
                                        {
                                            <div class="sql-compare-splitter" title="Drag to resize result set">
                                                <div class="sql-compare-splitter-handle"></div>
                                            </div>
                                        }
                                    }
                                </div>
                                if (false) {
                                int rsIndex = 1;
                                foreach (var rs in ActiveTab.ResultSets)
                                {
                                    @if (ActiveTab.ResultSets.Count > 1) 
                                    { 
                                        <div class="d-flex align-items-center mb-3 mt-4">
                                            <hr class="flex-grow-1 m-0" style="border-color: var(--app-border); opacity: 0.5;">
                                            <span class="px-3 fw-bold" style="color: var(--app-table-header-text); letter-spacing: 1px; font-size: 0.95rem;">Result Set @rsIndex</span>
                                            <hr class="flex-grow-1 m-0" style="border-color: var(--app-border); opacity: 0.5;">
                                        </div>
                                    }
                                    <ExploreDB.Components.Pages.ResultSetGrid Data="rs" OnOpenCodeInNewTab="HandleOpenCodeInNewTab" />
                                    rsIndex++;
                                }
                                }
                                if (false) {
                                }
                            }
                        }
                        else if (ResultTab == "Messages")
                        {
                            <div class="p-3 overflow-auto flex-grow-1 custom-scrollbar-light" style="min-height: 0;">
                            <pre class="m-0" style="color: var(--app-text); font-size: 0.85em; white-space: pre-wrap; font-family: Consolas, 'Courier New', monospace;">
@if (ActiveTab.Messages.Count == 0) { <span class="text-muted fst-italic">No Messages.</span> }
@foreach (var msg in ActiveTab.Messages)
{
    @if (msg.IsError || msg.Text.StartsWith("Error:", StringComparison.OrdinalIgnoreCase) || msg.Text.StartsWith("ERROR:", StringComparison.OrdinalIgnoreCase))
    {
        var navLine = msg.LineNumber;
        if (!navLine.HasValue && msg.IsError)
        {
            var match = System.Text.RegularExpressions.Regex.Match(msg.Text, @"\bLine\s+(\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (match.Success && int.TryParse(match.Groups[1].Value, out int pLine)) navLine = pLine;
        }

        if (navLine.HasValue && navLine.Value > 0)
        {
            <span class="text-danger fw-semibold" style="cursor: pointer; user-select: text;" title="Double-click to navigate to line @(navLine.Value) in editor" @ondblclick="() => JumpToEditorLineAsync(navLine.Value)">@msg.Text</span><br/>
        }
        else
        {
            <span class="text-danger fw-semibold">@msg.Text</span><br/>
        }
    }
    else
    {
        <span>@msg.Text</span><br/>
    }
}
                            </pre>
                            </div>
                        }
                        </div>
                    }
                </div>
            </div>
        }
    </div> <!-- /query-runner-workspace -->
</div>

@if (ShowClearConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary shadow-lg">
                <div class="modal-body p-4 pb-2">
                    <p class="text-light text-opacity-75 mb-0" style="font-size: 0.95rem;">
                        Are you sure you want to <strong class="text-warning">clear the editor</strong>? This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-0 p-4 pt-2">
                    <button type="button" class="btn btn-dark border-secondary" @onclick="() => ShowClearConfirmation = false">Cancel</button>
                    <button type="button" class="btn btn-warning px-4 fw-bold shadow-sm text-dark" @onclick="ClearQueryAsync">Clear</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid TabId { get; set; }

