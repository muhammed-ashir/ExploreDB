@using ExploreDB.Components.Pages

<div class="h-100 d-flex flex-column" style="height: 100vh; background-color: var(--app-bg); color: var(--app-text);">
    <PopoutRunner TabId="@TabId" />
</div>

@code {
    [Parameter]
    public Guid TabId { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                MauiProgram.InvokeAppReady(TabId);
            }
            catch { }
        }
    }
}
