@using DbExplore.Services
@inject NavigationManager Nav
@implements IDisposable

<div class="d-flex flex-column h-100 bg-dark">
    <div class="p-3 border-bottom border-secondary">
        <h5 class="text-white mb-3">
            <span>DbExplore</span>
        </h5>
    </div>

    <div class="flex-grow-1">
        <div class="list-group list-group-flush">
            <div class="px-3 pt-3 pb-2 text-uppercase small fw-bold" style="color: #6c757d; letter-spacing: 0.08em;">
                Workspace
            </div>

            <a href=""
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsPathfinderActive ? "active" : "")">
                <span>Pathfinder</span>
            </a>

            <a href="runner"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsRunnerActive ? "active" : "")">
                <span>Query Runner</span>
            </a>

            <a href="explorer"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsExplorerActive ? "active" : "")">
                <span>Table Explorer</span>
            </a>

            <a href="views"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsViewExplorerActive ? "active" : "")">
                <span>View Explorer</span>
            </a>

            <a href="procs"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsSpExplorerActive ? "active" : "")">
                <span>SP Explorer</span>
            </a>

            <div class="px-3 pt-4 pb-2 text-uppercase small fw-bold" style="color: #6c757d; letter-spacing: 0.08em;">
                Tools
            </div>

            <a href="compare"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsDataCompareActive ? "active" : "")">
                <span>Data Compare</span>
            </a>

            <div class="px-3 pt-4 pb-2 text-uppercase small fw-bold" style="color: #6c757d; letter-spacing: 0.08em;">
                Learning
            </div>

            <a href="joins"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsJoinGuideActive ? "active" : "")">
                <span>Join Guide</span>
            </a>

            <a href="tricks"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsTricksActive ? "active" : "")">
                <span>DB Tricks & Tips</span>
            </a>

            <a href="advanced"
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsAdvancedSqlActive ? "active" : "")">
                <span>Advanced SQL Guide</span>
            </a>
        </div>
    </div>
</div>

@code {
    private string CurrentUrl = "";

    private bool IsPathfinderActive => CurrentUrl == Nav.BaseUri || CurrentUrl == Nav.BaseUri.TrimEnd('/');
    private bool IsRunnerActive => CurrentUrl.Contains("/runner");
    private bool IsJoinGuideActive => CurrentUrl.Contains("/joins");
    private bool IsExplorerActive => CurrentUrl.Contains("/explorer");
    private bool IsViewExplorerActive => CurrentUrl.Contains("/views") && !CurrentUrl.Contains("/view/");
    private bool IsSpExplorerActive => CurrentUrl.Contains("/procs") || CurrentUrl.Contains("/proc/");
    private bool IsDataCompareActive => CurrentUrl.Contains("/compare");
    private bool IsTricksActive => CurrentUrl.Contains("/tricks");
    private bool IsAdvancedSqlActive => CurrentUrl.Contains("/advanced");

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        CurrentUrl = Nav.Uri;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location;
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
