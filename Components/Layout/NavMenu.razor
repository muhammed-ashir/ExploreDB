@using DbExplore.Services
@inject NavigationManager Nav
@implements IDisposable

<div class="d-flex flex-column h-100 bg-dark">
    <div class="p-3 border-bottom border-secondary">
        <h5 class="text-white mb-3">
            <span style="font-size: 1.5rem;">🗄️</span> DbExplore
        </h5>
    </div>

    <div class="flex-grow-1">
        <div class="list-group list-group-flush">
            <a href="" 
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsPathfinderActive ? "active" : "")">
                <span style="font-size: 1.2rem;">⚡</span>
                <span class="ms-2">Pathfinder</span>
            </a>
            
            <a href="explorer" 
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsExplorerActive ? "active" : "")">
                <span style="font-size: 1.2rem;">🔍</span>
                <span class="ms-2">Table Explorer</span>
            </a>

            <a href="views" 
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsViewExplorerActive ? "active" : "")">
                <span style="font-size: 1.2rem;">👁️</span>
                <span class="ms-2">View Explorer</span>
            </a>
            
            <a href="tricks" 
               class="list-group-item list-group-item-action bg-transparent text-light border-0 py-3 sidebar-item @(IsTricksActive ? "active" : "")">
                <span style="font-size: 1.2rem;">💡</span>
                <span class="ms-2">DB Tricks & Tips</span>
            </a>
        </div>
    </div>
</div>

@code {
    private string CurrentUrl = "";

    private bool IsPathfinderActive => CurrentUrl == Nav.BaseUri || CurrentUrl == Nav.BaseUri.TrimEnd('/');
    private bool IsExplorerActive => CurrentUrl.Contains("/explorer");
    private bool IsViewExplorerActive => CurrentUrl.Contains("/views");
    private bool IsTricksActive => CurrentUrl.Contains("/tricks");

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        CurrentUrl = Nav.Uri;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location;
        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
