@inherits LayoutComponentBase
@implements IDisposable
@inject ConnectionService ConnectionService
@inject SchemaService SchemaService
@inject NavigationManager Nav
@inject ExploreDB.Services.GitHubUpdateService UpdateService

<div class="container-fluid p-0">
    @if (IsSwitchingDatabaseGlobal)
    {
        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px); z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="text-white mt-4 fw-bold">Switching to @SwitchingDatabaseName</h4>
            <p class="text-light">Please wait while the schema is loading.</p>
        </div>
    }

    @if (UpdateInfo != null)
    {
        @if (UpdateInfo.IsMandatory)
        {
            <div class="modal fade show d-block" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(10px); z-index: 3000;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content glass-card border-0 text-white" style="background-color: rgba(13, 110, 253, 0.2); border: 1px solid rgba(13, 110, 253, 0.4) !important;">
                        <div class="modal-body text-center p-5">
                            <h3 class="fw-bold mb-3">🚨 Update Required</h3>
                            <p class="mb-4 text-light">An update is required to continue using ExploreDB. You must update to the latest version before proceeding.</p>
                            
                            @if (DownloadFailed)
                            {
                                <div class="mb-3 text-danger small">
                                    Automatic download failed.<br/>
                                    <a href="#" @onclick="FallbackUpdate" @onclick:preventDefault class="fw-bold text-decoration-underline text-danger">Click here to download via Browser instead.</a>
                                </div>
                            }
                            @if (InstallerLaunched)
                            {
                                <div class="mb-3 text-success fw-bold p-3 rounded" style="background: rgba(25, 135, 84, 0.2); border: 1px solid rgba(25, 135, 84, 0.4);">
                                    ✅ Installer opened! Please check your taskbar.
                                </div>
                            }
                            
                            @if (IsDownloadingUpdate)
                            {
                                <div class="p-2 text-info fw-bold">
                                    <span class="spinner-border spinner-border-sm me-2"></span> Downloading Update...
                                </div>
                            }
                            else if (!InstallerLaunched)
                            {
                                <button class="btn btn-primary btn-lg w-100 fw-bold shadow" @onclick="DownloadAndUpdate">
                                    Update Now
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (!UpdateDismissed)
        {
            <div class="alert fade show m-3 d-flex align-items-center justify-content-between shadow-sm" style="background-color: #0f253f; border: 1px solid #1a3c63; color: white; position: relative; z-index: 3000;" role="alert">
                <div>
                    @if (InstallerLaunched)
                    {
                        <strong class="text-success">✅ Installer opened! Please check your taskbar.</strong>
                    }
                    else
                    {
                        <strong>✨ A new version of ExploreDB is available!</strong> 
                        @if (DownloadFailed)
                        {
                            <span class="ms-2 text-danger">Automatic download failed. <a href="#" @onclick="FallbackUpdate" @onclick:preventDefault class="fw-bold text-decoration-underline text-danger">Click here to download via Browser instead.</a></span>
                        }
                    }
                </div>
                <div>
                    @if (IsDownloadingUpdate)
                    {
                        <span class="me-3 text-info fw-bold"><span class="spinner-border spinner-border-sm me-1"></span> Downloading...</span>
                    }
                    else if (!InstallerLaunched)
                    {
                        <button type="button" class="btn btn-primary btn-sm me-3" @onclick="DownloadAndUpdate">
                            Update Now
                        </button>
                    }
                    <button type="button" class="btn-close" @onclick="() => UpdateDismissed = true" style="filter: invert(1); top: 0; padding: 0.75rem; position: relative; right: 0;"></button>
                </div>
            </div>
        }
    }
    @if (!IsConnected)
    {
        <div class="modal fade show d-block" style="background: rgba(0,0,0,0.8);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content glass-card border-0 text-white" style="background-color: #2b3035;">
                    <div class="modal-header border-bottom border-secondary">
                        <h5 class="modal-title fw-bold mb-0">Connection Manager</h5>
                    </div>
                    <div class="modal-body p-0">
                        <div class="d-flex flex-column" style="height: 450px;">
                            <div class="p-3 border-bottom border-secondary d-flex gap-2">
                                <div class="input-group input-group-sm flex-grow-1 shadow-sm">
                                    <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Search connections..." @bind="SearchConn" @bind:event="oninput" />
                                    <button class="btn @(FilterCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-2" style="z-index: 0;" title="Match Case" @onclick="() => FilterCaseSensitive = !FilterCaseSensitive">
                                        <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                    </button>
                                    <button class="btn @(FilterWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-2" style="z-index: 0;" title="Match Whole Word" @onclick="() => { FilterWholeWord = !FilterWholeWord; if (FilterWholeWord) FilterExactMatch = false; }">
                                        <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                    </button>
                                    <button class="btn @(FilterExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-2" style="z-index: 0;" title="Exact Match" @onclick="() => { FilterExactMatch = !FilterExactMatch; if (FilterExactMatch) FilterWholeWord = false; }">
                                        <i class="bi bi-bullseye fs-6"></i>
                                    </button>
                                </div>
                                <button class="btn btn-sm btn-outline-info text-nowrap d-flex align-items-center gap-1" @onclick="NewConnection">
                                    <i class="bi bi-plus-lg"></i> New
                                </button>
                            </div>
                            <div class="flex-grow-1 overflow-auto p-2 custom-scrollbar-light" style="overscroll-behavior: contain;">
                                @if (!FilteredConnections.Any())
                                {
                                    <div class="text-muted text-center mt-4 small">No saved connections.</div>
                                }
                                else
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var c in FilteredConnections)
                                        {
                                            <div class="list-group-item bg-transparent border-secondary p-2 @(ActiveConnId == c.Id ? "bg-primary text-white" : "text-light")">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="cursor-pointer flex-grow-1 pe-2 overflow-hidden" @onclick="() => LoadConnection(c)">
                                                        <div class="fw-bold mb-1" style="font-size: 0.9em;">@(string.IsNullOrWhiteSpace(c.Name) ? "Unnamed Connection" : c.Name)</div>
                                                        <div class="text-opacity-75 text-white" style="font-size: 0.75em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                            @{
                                                                string authType = string.IsNullOrEmpty(c.AuthType) ? (c.UseWindowsAuth ? "Windows" : "SqlServer") : c.AuthType;
                                                                string authDisplay = string.Equals(authType, "SqlServer", StringComparison.OrdinalIgnoreCase) 
                                                                    ? $"SQL Auth ({(string.IsNullOrEmpty(c.Username) ? "sa" : c.Username)})" 
                                                                    : "Windows Auth";
                                                                string coreDetails = string.IsNullOrEmpty(c.Server) ? c.ConnectionString : $"{c.Server} • {authDisplay}";
                                                            }
                                                            @coreDetails
                                                        </div>
                                                    </div>
                                                    <button class="btn p-0 text-danger ms-2 shadow-none bg-transparent border-0" style="flex-shrink: 0;" title="Delete" @onclick="() => ConfirmDelete(c)">
                                                        <i class="bi bi-trash3-fill" style="font-size: 1.15rem;"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (IsDetailsVisible)
        {
            <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); z-index: 1060;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content glass-card border-secondary text-white shadow-lg" style="background-color: #2b3035;">
                        <div class="modal-header border-bottom border-secondary">
                            <h6 class="modal-title fw-bold text-info mb-0">Connection Details</h6>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => IsDetailsVisible = false" style="font-size: 0.8rem;"></button>
                        </div>
                        <div class="modal-body p-4">
                                
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Connection Name</label>
                                    <input type="text" class="form-control bg-dark text-white border-secondary" @bind="ConnName" placeholder="e.g. Production DB" />
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label small text-muted">Server Name / IP</label>
                                    <input type="text" class="form-control bg-dark text-white border-secondary" @bind="Server" placeholder="localhost, .\SQLEXPRESS, etc." />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small text-muted">Authentication Type</label>
                                    <div class="position-relative">
                                        <div class="form-control bg-dark text-white border-secondary pe-5 cursor-pointer d-flex align-items-center" 
                                             style="cursor: pointer; min-height: 38px;"
                                             @onclick="() => IsAuthDropdownOpen = !IsAuthDropdownOpen">
                                            @(AuthType == "Windows" ? "Windows Authentication" : AuthType == "SqlServer" ? "SQL Server Authentication" : "Microsoft Entra MFA")
                                            <div class="position-absolute h-100 d-flex align-items-center" style="right: 12px; top: 0; pointer-events: none;">
                                                <i class="bi bi-chevron-down text-muted" style="font-size: 0.85rem;"></i>
                                            </div>
                                        </div>
                                        @if (IsAuthDropdownOpen)
                                        {
                                            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsAuthDropdownOpen = false"></div>
                                            <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-1 mt-1 custom-scrollbar-light" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 200px; overflow-y: auto; overscroll-behavior: contain;">
                                                <button class="dropdown-item text-white @(AuthType == "Windows" ? "bg-primary" : "") py-2" type="button" @onclick='() => SetAuthType("Windows")'>Windows Authentication</button>
                                                <button class="dropdown-item text-white @(AuthType == "SqlServer" ? "bg-primary" : "") py-2" type="button" @onclick='() => SetAuthType("SqlServer")'>SQL Server Authentication</button>
                                                <button class="dropdown-item text-white @(AuthType == "EntraMfa" ? "bg-primary" : "") py-2" type="button" @onclick='() => SetAuthType("EntraMfa")'>Microsoft Entra MFA</button>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (AuthType == "SqlServer" || AuthType == "EntraMfa")
                                {
                                    <div class="row mb-3">
                                        <div class="@(AuthType == "EntraMfa" ? "col-12" : "col-6")">
                                            <label class="form-label small text-muted">Username @(AuthType == "EntraMfa" ? "(Optional)" : "")</label>
                                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="Username" placeholder="@(AuthType == "EntraMfa" ? "email@domain.com" : "")" />
                                        </div>
                                        @if (AuthType == "SqlServer")
                                        {
                                            <div class="col-6">
                                                <label class="form-label small text-muted">Password</label>
                                                <input type="password" class="form-control bg-dark text-white border-secondary" @bind="Password" />
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label small text-muted">Database</label>
                                    <div class="position-relative">
                                        <input class="form-control bg-dark text-white border-secondary pe-5" 
                                               @bind="DatabaseSearch" 
                                               @bind:event="oninput"
                                               placeholder="Type to search or select..." 
                                               @onfocus="OpenDatabaseDropdown" />
                                        
                                        @if (IsDatabaseDropdownOpen)
                                        {
                                            <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="CloseDatabaseDropdown"></div>
                                            <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-0 mt-1 custom-scrollbar-light" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 200px; overflow-y: auto; overscroll-behavior: contain;">
                                                @if (IsFetchingDatabases)
                                                {
                                                    <div class="p-4 text-center text-info">
                                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                                        <small>Loading databases...</small>
                                                    </div>
                                                }
                                                else if (AvailableDatabases.Any())
                                                {
                                                    var filtered = AvailableDatabases.Where(d => string.IsNullOrWhiteSpace(DatabaseSearch) || d.Contains(DatabaseSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                                                    if (filtered.Any())
                                                    {
                                                        <div class="list-group list-group-flush">
                                                            @foreach (var db in filtered)
                                                            {
                                                                <button type="button" class="list-group-item list-group-item-action bg-dark text-light border-0 py-2 px-3" style="border-bottom: 1px solid #333 !important;" @onclick="() => SelectDatabase(db)">
                                                                    @db
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="p-3 text-muted small text-center">No matching databases found.</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="p-3 text-muted small text-center">Server not connected or no databases.</div>
                                                }
                                            </div>
                                        }

                                        <div class="position-absolute h-100 d-flex align-items-center" style="right: 12px; top: 0; pointer-events: none;">
                                            <i class="bi bi-chevron-down text-muted" style="font-size: 0.85rem;"></i>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(ErrorMsg))
                                {
                                    <div class="alert alert-danger py-2 px-3 small mb-0 mt-3 d-flex align-items-start" style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.2); color: #ea868f;" title="@ErrorMsg">
                                        <i class="bi bi-exclamation-triangle-fill me-2" style="margin-top: 2px;"></i>
                                        <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                            @ErrorMsg
                                        </div>
                                    </div>
                                }

                                <div class="d-flex gap-2 mt-4">
                                    <button class="btn btn-outline-success flex-grow-1 @(string.IsNullOrWhiteSpace(Server) ? "opacity-50" : "")" style="@(string.IsNullOrWhiteSpace(Server) ? "cursor: not-allowed;" : "")" @onclick="SaveCurrentConnection">Save Profile</button>
                                    <button class="btn btn-premium flex-grow-1 fw-bold @((string.IsNullOrWhiteSpace(Server) || string.IsNullOrWhiteSpace(Database)) ? "opacity-50" : "")" style="@((string.IsNullOrWhiteSpace(Server) || string.IsNullOrWhiteSpace(Database)) ? "cursor: not-allowed;" : "")" @onclick="Connect" disabled="@(IsBusy)">
                                        @if(IsBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                        @(IsBusy ? "Connecting..." : "Connect")
                                    </button>
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (ConnectionToDelete != null)
        {
            <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); z-index: 1070;">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content glass-card border-danger text-white shadow-lg text-center p-4" style="background-color: #2b3035;">
                        <div class="mb-3 text-danger">
                            <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Delete Connection?</h5>
                        <p class="small text-muted mb-4">Are you sure you want to delete <strong>@(string.IsNullOrWhiteSpace(ConnectionToDelete.Name) ? "Unnamed Connection" : ConnectionToDelete.Name)</strong>? This action cannot be undone.</p>
                        <div class="d-flex justify-content-center gap-3">
                            <button class="btn btn-outline-secondary px-4 rounded-pill" @onclick="CancelDelete">Cancel</button>
                            <button class="btn btn-danger px-4 rounded-pill fw-bold shadow" @onclick="ExecuteDelete">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (ShowSavePrompt)
        {
            <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7); z-index: 1070;">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content glass-card border-primary text-white shadow-lg text-center p-4" style="background-color: #2b3035;">
                        <div class="mb-3 text-primary">
                            <i class="bi bi-floppy-fill" style="font-size: 3rem;"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Save Profile?</h5>
                        <p class="small text-muted mb-4">Would you like to save this connection for future use?</p>
                        <div class="d-flex justify-content-center gap-3">
                            <button class="btn btn-outline-secondary px-4 rounded-pill" @onclick="() => FinalizeConnect(false)">No</button>
                            <button class="btn btn-primary px-4 rounded-pill fw-bold shadow" @onclick="() => FinalizeConnect(true)">Yes, Save</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (ShowToast)
        {
            <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 2000;">
                <div class="toast show align-items-center text-white border-0 shadow-lg" role="alert" style="animation: slideInUp 0.3s ease; background-color: #2b3035; border-left: 4px solid var(--bs-@ToastThemeClass) !important;">
                    <div class="d-flex">
                        <div class="toast-body d-flex align-items-center flex-grow-1 overflow-hidden" title="@ToastMessage">
                            <i class="bi @ToastIconClass me-3 fs-5 text-@ToastThemeClass flex-shrink-0"></i>
                            <span class="text-truncate">@ToastMessage</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-3 m-auto flex-shrink-0" @onclick="() => ShowToast = false"></button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="app-shell">
            <aside class="sidebar app-shell-sidebar @(SidebarCollapsed ? "collapsed" : "")">
                <NavMenu />
            </aside>

            <main class="app-shell-main d-flex flex-column" style="height: 100vh; overflow-y: auto;">
                <div class="border-bottom border-secondary p-2 d-flex align-items-center sticky-top" style="background-color: rgba(33, 37, 41, 0.95); backdrop-filter: blur(5px); z-index: 1020;">
                    <button class="btn btn-sm btn-outline-secondary text-white border-0 me-3" @onclick="() => SidebarCollapsed = !SidebarCollapsed" title="Toggle Sidebar">
                        <span style="font-size: 1.2rem; line-height: 1;">☰</span>
                    </button>
                    <div class="ms-auto d-flex align-items-center gap-3">
                        <span class="fw-bold text-muted small">@GetWorkspaceTitle()</span>
                        <button class="btn btn-sm btn-outline-info d-flex align-items-center justify-content-center border-0" style="width: 32px; height: 32px;" title="Switch Server" @onclick="Disconnect">
                            <i class="bi bi-power" style="font-size: 1.2rem;"></i>
                        </button>
                    </div>
                </div>
                <div class="app-shell-content flex-grow-1">
                    @Body
                </div>
            </main>
        </div>
    }
</div>

@code {
    private bool IsConnected = false;
    private bool IsBusy = false;
    private bool SidebarCollapsed = false;
    private bool IsDetailsVisible = false;
    private bool ShowSavePrompt = false;
    private bool ShowToast = false;
    private string ToastMessage = "";
    private string ToastThemeClass = "success";
    private string ToastIconClass = "bi-check-circle-fill";
    private ConnectionService.SavedConnection ConnectionToDelete = null;
    private string ConnString = "";
    private string ConnName = "";
    private string Server = "";
    private string AuthType = "Windows";
    private string Username = "";
    private string Password = "";
    private string Database = "";
    private string DatabaseSearch = "";
    private bool IsDatabaseDropdownOpen = false;
    private bool IsAuthDropdownOpen = false;
    private List<string> AvailableDatabases = new();
    private bool IsFetchingDatabases = false;
    private bool IsSwitchingDatabaseGlobal = false;
    private string SwitchingDatabaseName = "";
    private string ActiveConnId = "";
    private string ErrorMsg = "";
    private bool FilterCaseSensitive = false;
    private bool FilterWholeWord = false;
    private bool FilterExactMatch = false;

    private string GetWorkspaceTitle()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ConnectionService.ConnectionString))
                return "ExploreDB Workspace";

            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(ConnectionService.ConnectionString);
            var dbName = builder.InitialCatalog;
            
            if (!string.IsNullOrEmpty(dbName))
            {
                var serverName = builder.DataSource;
                if (!string.IsNullOrEmpty(serverName))
                    return $"{serverName} ➔ {dbName}";
                return dbName;
            }
        }
        catch { }

        return string.IsNullOrWhiteSpace(ConnName) ? "ExploreDB Workspace" : ConnName;
    }

    private string _searchConn = "";
    private string SearchConn
    {
        get => _searchConn;
        set
        {
            _searchConn = value;
        }
    }

    private IEnumerable<ConnectionService.SavedConnection> FilteredConnections => 
        ConnectionService.SavedConnections
            .Where(c => 
            {
                if (string.IsNullOrEmpty(SearchConn)) return true;
                
                string searchFor = SearchConn;
                string name = c.Name ?? "";
                string connStr = c.ConnectionString ?? "";
                
                StringComparison comp = FilterCaseSensitive ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
                
                if (FilterExactMatch)
                {
                    return string.Equals(name, searchFor, comp) || string.Equals(connStr, searchFor, comp);
                }
                
                if (FilterWholeWord)
                {
                    try 
                    {
                        string pattern = $@"\b{System.Text.RegularExpressions.Regex.Escape(searchFor)}\b";
                        System.Text.RegularExpressions.RegexOptions opt = FilterCaseSensitive ? System.Text.RegularExpressions.RegexOptions.None : System.Text.RegularExpressions.RegexOptions.IgnoreCase;
                        return System.Text.RegularExpressions.Regex.IsMatch(name, pattern, opt) || 
                               System.Text.RegularExpressions.Regex.IsMatch(connStr, pattern, opt);
                    }
                    catch { return false; }
                }
                
                return name.Contains(searchFor, comp) || connStr.Contains(searchFor, comp);
            })
            .OrderByDescending(c => c.LastUsed);

    private ExploreDB.Services.UpdateInfo? UpdateInfo;
    private bool UpdateDismissed = false;
    private bool IsDownloadingUpdate = false;
    private bool DownloadFailed = false;
    private bool InstallerLaunched = false;
    private System.Threading.PeriodicTimer? _updateTimer;

    protected override async Task OnInitializedAsync()
    {
        ConnString = ConnectionService.ConnectionString;
        var active = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == ConnString);
        if (active != null)
        {
            LoadConnection(active);
        }
        else if (ConnectionService.SavedConnections.Count == 0)
        {
            IsDetailsVisible = true;
        }

        ConnectionService.OnDatabaseSwitching += OnDatabaseSwitchingHandler;
        ConnectionService.OnDatabaseSwitched += OnDatabaseSwitchedHandler;

        // Check for updates silently in the background
        UpdateInfo = await UpdateService.CheckForUpdateAsync();

        // Start background polling every 1 hour
        _ = StartBackgroundUpdateCheck();
    }

    private async Task StartBackgroundUpdateCheck()
    {
        _updateTimer = new System.Threading.PeriodicTimer(TimeSpan.FromHours(1));
        while (await _updateTimer.WaitForNextTickAsync())
        {
            try 
            {
                var newInfo = await UpdateService.CheckForUpdateAsync();
                if (newInfo != null)
                {
                    UpdateInfo = newInfo;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }
    }

    private async Task DownloadAndUpdate()
    {
        if (string.IsNullOrEmpty(UpdateInfo?.DownloadUrl)) return;
        
        IsDownloadingUpdate = true;
        DownloadFailed = false;
        StateHasChanged();

        var success = await UpdateService.DownloadAndExecuteUpdateAsync(UpdateInfo.DownloadUrl);
        if (!success)
        {
            DownloadFailed = true;
        }
        else
        {
            InstallerLaunched = true;
        }
        
        IsDownloadingUpdate = false;
        StateHasChanged();
    }

    private async Task FallbackUpdate()
    {
        await Microsoft.Maui.ApplicationModel.Launcher.OpenAsync("https://zerinapps.web.app/app/dbexplorer");
    }

    private async Task OpenDatabaseDropdown()
    {
        IsDatabaseDropdownOpen = true;
        DatabaseSearch = "";
        if (!AvailableDatabases.Any() && !IsFetchingDatabases)
        {
            await FetchDatabases();
        }
    }

    private void CloseDatabaseDropdown()
    {
        IsDatabaseDropdownOpen = false;
        DatabaseSearch = Database;
    }

    private void SetAuthType(string type)
    {
        AuthType = type;
        IsAuthDropdownOpen = false;
    }

    private void SelectDatabase(string db)
    {
        Database = db;
        DatabaseSearch = db;
        IsDatabaseDropdownOpen = false;
    }

    private async Task FetchDatabases()
    {
        if(string.IsNullOrWhiteSpace(Server)) return;
        IsFetchingDatabases = true;
        ErrorMsg = "";
        try {
            AvailableDatabases = await ConnectionService.GetDatabasesAsync(Server, AuthType, Username, Password);
        } catch (Exception ex) {
            ErrorMsg = "Failed to fetch databases: " + ex.Message;
        }
        IsFetchingDatabases = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OnDatabaseSwitchingHandler(string dbName)
    {
        SwitchingDatabaseName = dbName;
        IsSwitchingDatabaseGlobal = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnDatabaseSwitchedHandler()
    {
        IsSwitchingDatabaseGlobal = false;
        InvokeAsync(StateHasChanged);
    }

    private void LoadConnection(ConnectionService.SavedConnection c)
    {
        ActiveConnId = c.Id;
        ConnName = c.Name;
        Server = c.Server;
        AuthType = string.IsNullOrEmpty(c.AuthType) ? (c.UseWindowsAuth ? "Windows" : "SqlServer") : c.AuthType;
        Username = c.Username;
        Password = c.Password;
        Database = "";
        DatabaseSearch = "";
        ConnString = c.ConnectionString;
        AvailableDatabases.Clear();
        IsDetailsVisible = true;
    }

    private void ConfirmDelete(ConnectionService.SavedConnection c)
    {
        ConnectionToDelete = c;
    }

    private void CancelDelete()
    {
        ConnectionToDelete = null;
    }

    private void ExecuteDelete()
    {
        if (ConnectionToDelete == null) return;
        
        string id = ConnectionToDelete.Id;
        ConnectionService.DeleteConnection(id);
        ConnectionToDelete = null;
        
        if (ActiveConnId == id)
        {
            NewConnection();
        }
    }

    private void NewConnection()
    {
        ActiveConnId = "";
        ConnName = "";
        Server = "";
        AuthType = "Windows";
        Username = "";
        Password = "";
        Database = "";
        DatabaseSearch = "";
        ConnString = "";
        AvailableDatabases.Clear();
        IsDetailsVisible = true;
    }

    private async Task SaveCurrentConnection()
    {
        if (string.IsNullOrWhiteSpace(Server))
        {
            await TriggerToast("Please enter valid inputs.", "danger", "bi-exclamation-circle-fill");
            return;
        }

        if (!string.IsNullOrEmpty(ActiveConnId))
        {
            var loaded = ConnectionService.SavedConnections.FirstOrDefault(c => c.Id == ActiveConnId);
            if (loaded != null)
            {
                bool coreChanged = !string.Equals(loaded.Server ?? "", Server ?? "", StringComparison.OrdinalIgnoreCase) || 
                                   !string.Equals(loaded.AuthType ?? "", AuthType ?? "", StringComparison.OrdinalIgnoreCase) ||
                                   !string.Equals(loaded.Username ?? "", Username ?? "", StringComparison.OrdinalIgnoreCase);
                if (coreChanged)
                {
                    ActiveConnId = ""; // Branch off to a new connection save
                }
            }
        }

        bool isAlreadySaved = !string.IsNullOrEmpty(ActiveConnId) && ConnectionService.SavedConnections.Any(c => 
            c.Id == ActiveConnId &&
            string.Equals(c.Name ?? "", ConnName ?? "", StringComparison.Ordinal) &&
            string.Equals(c.Server ?? "", Server ?? "", StringComparison.OrdinalIgnoreCase) && 
            string.Equals(c.AuthType ?? "", AuthType ?? "", StringComparison.OrdinalIgnoreCase) && 
            string.Equals(c.Username ?? "", Username ?? "", StringComparison.OrdinalIgnoreCase) &&
            string.Equals(c.Password ?? "", Password ?? "", StringComparison.Ordinal));

        if (isAlreadySaved)
        {
            await TriggerToast("Profile already saved.", "info", "bi-info-circle-fill");
            return;
        }
        ConnString = ConnectionService.BuildConnectionString(Server, AuthType, Username, Password, "");
        bool isUpdate = !string.IsNullOrEmpty(ActiveConnId);
        ConnectionService.UpsertConnection(ActiveConnId, ConnName, Server, AuthType, Username, Password, "", ConnString);
        
        var saved = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == ConnString && c.Name == (string.IsNullOrWhiteSpace(ConnName) ? "Unnamed Connection" : ConnName));
        if (saved != null) ActiveConnId = saved.Id;

        await TriggerToast(isUpdate ? "Profile updated successfully." : "Profile saved successfully.", "success", "bi-check-circle-fill");
    }

    private async Task Connect()
    {
        if (string.IsNullOrWhiteSpace(Server) || string.IsNullOrWhiteSpace(Database))
        {
            await TriggerToast("Please enter valid inputs.", "danger", "bi-exclamation-circle-fill");
            return;
        }

        if (!string.IsNullOrEmpty(ActiveConnId))
        {
            var loaded = ConnectionService.SavedConnections.FirstOrDefault(c => c.Id == ActiveConnId);
            if (loaded != null)
            {
                bool coreChanged = !string.Equals(loaded.Server ?? "", Server ?? "", StringComparison.OrdinalIgnoreCase) || 
                                   !string.Equals(loaded.AuthType ?? "", AuthType ?? "", StringComparison.OrdinalIgnoreCase) ||
                                   !string.Equals(loaded.Username ?? "", Username ?? "", StringComparison.OrdinalIgnoreCase);
                if (coreChanged)
                {
                    ActiveConnId = ""; // Branch off to a new connection save
                }
            }
        }
        
        ConnString = ConnectionService.BuildConnectionString(Server, AuthType, Username, Password, Database);

        IsBusy = true;
        var result = await ConnectionService.TestConnectionAsync(ConnString);
        IsBusy = false;

        if (result.Success)
        {
            bool isSaved = ConnectionService.SavedConnections.Any(c => 
                string.Equals(c.Server, Server, StringComparison.OrdinalIgnoreCase) && 
                string.Equals(c.AuthType, AuthType, StringComparison.OrdinalIgnoreCase) && 
                string.Equals(c.Username ?? "", Username ?? "", StringComparison.OrdinalIgnoreCase));
                
            if (!isSaved)
            {
                ShowSavePrompt = true;
            }
            else
            {
                await FinalizeConnect(false);
            }
        }
        else
        {
            await TriggerToast($"Connection failed: {result.ErrorMessage}", "danger", "bi-exclamation-triangle-fill");
        }
    }

    private async Task FinalizeConnect(bool save)
    {
        ShowSavePrompt = false;
        IsBusy = true;
        
        if (save)
        {
            string baseConnString = ConnectionService.BuildConnectionString(Server, AuthType, Username, Password, "");
            ConnectionService.UpsertConnection(ActiveConnId, ConnName, Server, AuthType, Username, Password, "", baseConnString);
            
            var saved = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == baseConnString && c.Name == (string.IsNullOrWhiteSpace(ConnName) ? "Unnamed Connection" : ConnName));
            if (saved != null) ActiveConnId = saved.Id;
        }
        
        ConnectionService.SaveActiveConnection(ConnString);
        await SchemaService.LoadSchemaAsync();
        IsConnected = true;
        IsBusy = false;
    }

    private async Task TriggerToast(string message, string themeClass, string iconClass)
    {
        ToastMessage = message;
        ToastThemeClass = themeClass;
        ToastIconClass = iconClass;
        ShowToast = true;
        StateHasChanged();
        await Task.Delay(3000);
        ShowToast = false;
        StateHasChanged();
    }

    private void Disconnect()
    {
        IsConnected = false;
    }

    public void Dispose()
    {
        _updateTimer?.Dispose();
        ConnectionService.OnDatabaseSwitching -= OnDatabaseSwitchingHandler;
        ConnectionService.OnDatabaseSwitched -= OnDatabaseSwitchedHandler;
    }
}
