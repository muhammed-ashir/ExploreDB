@page "/compare"
@using DbExplore.Services
@inject ConnectionService ConnectionService
@inject DataCompareService CompareService

<div class="container-fluid h-100 d-flex flex-column">
    <style>
        .custom-dropdown-item:hover {
            background-color: rgba(255, 255, 255, 0.1) !important;
        }
    </style>
    
    @if (IsSourceDropdownOpen || IsTargetDropdownOpen)
    {
        <!-- Transparent backdrop to close dropdowns when clicking outside -->
        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" 
             @onclick="CloseDropdowns"></div>
    }
    <div class="row mb-3 mt-2">
        <div class="col">
            <h3 class="fw-bold mb-0">Data Compare</h3>
            <p class="text-secondary small mb-0">Compare table data across two databases on the same server.</p>
        </div>
    </div>

    @if (CurrentState == PageState.Setup)
    {
        <div class="row flex-grow-1 align-items-center justify-content-center">
            <div class="col-md-10 col-lg-8">
                <div class="card bg-dark border-secondary shadow-sm">
                    <div class="card-header border-secondary p-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">Select Databases to Compare</h5>
                        <button class="btn btn-sm btn-link text-info text-decoration-none py-0" @onclick="OpenNewConnectionModal">+ Add Connection</button>
                    </div>
                    <div class="card-body p-4">
                        <div class="row align-items-center mb-4">
                            <div class="col-md-5 position-relative">
                                <div class="mb-1">
                                    <label class="form-label text-info fw-bold small mb-0">Source Database</label>
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center bg-black text-white" 
                                            type="button" 
                                            @onclick="() => { IsSourceDropdownOpen = !IsSourceDropdownOpen; IsTargetDropdownOpen = false; }">
                                        <span class="text-truncate me-2">
                                            @(string.IsNullOrEmpty(SourceConnString) ? "-- Select Source --" : GetConnectionDisplayName(SourceConnString))
                                        </span>
                                        <span class="small text-muted">▼</span>
                                    </button>
                                    
                                    @if (IsSourceDropdownOpen)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 bg-dark border-secondary shadow-lg mt-1" style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                            <div class="mb-2 position-sticky top-0 bg-dark z-3 pt-1 pb-2">
                                                <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" 
                                                       placeholder="Search connection..." 
                                                       @bind="SourceSearchTerm" @bind:event="oninput" 
                                                       @onclick:stopPropagation="true" />
                                            </div>
                                            @foreach (var conn in FilteredSourceConnections)
                                            {
                                                <a class="dropdown-item custom-dropdown-item text-light cursor-pointer rounded px-3 py-2 @(SourceConnString == conn.ConnectionString ? "bg-primary" : "")"
                                                   @onclick="() => { SourceConnString = conn.ConnectionString; CloseDropdowns(); }">
                                                    <div class="fw-bold">@conn.Name</div>
                                                    <div class="small @(SourceConnString == conn.ConnectionString ? "text-light text-opacity-75" : "text-muted")">@GetDbName(conn.ConnectionString)</div>
                                                </a>
                                            }
                                            @if (!FilteredSourceConnections.Any())
                                            {
                                                <div class="text-center text-muted small py-3">No matches found</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <div class="col-md-2 text-center text-muted my-3 my-md-0">
                                <h5 class="mb-0 fw-bold">VS</h5>
                            </div>

                            <div class="col-md-5 position-relative">
                                <div class="mb-1">
                                    <label class="form-label text-warning fw-bold small mb-0">Target Database</label>
                                </div>
                                
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary w-100 text-start d-flex justify-content-between align-items-center bg-black text-white" 
                                            type="button" 
                                            @onclick="() => { IsTargetDropdownOpen = !IsTargetDropdownOpen; IsSourceDropdownOpen = false; }">
                                        <span class="text-truncate me-2">
                                            @(string.IsNullOrEmpty(TargetConnString) ? "-- Select Target --" : GetConnectionDisplayName(TargetConnString))
                                        </span>
                                        <span class="small text-muted">▼</span>
                                    </button>
                                    
                                    @if (IsTargetDropdownOpen)
                                    {
                                        <div class="dropdown-menu show w-100 p-2 bg-dark border-secondary shadow-lg mt-1" style="max-height: 300px; overflow-y: auto; z-index: 1050;">
                                            <div class="mb-2 position-sticky top-0 bg-dark z-3 pt-1 pb-2">
                                                <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" 
                                                       placeholder="Search connection..." 
                                                       @bind="TargetSearchTerm" @bind:event="oninput" 
                                                       @onclick:stopPropagation="true" />
                                            </div>
                                            @foreach (var conn in FilteredTargetConnections)
                                            {
                                                <a class="dropdown-item custom-dropdown-item text-light cursor-pointer rounded px-3 py-2 @(TargetConnString == conn.ConnectionString ? "bg-primary" : "")"
                                                   @onclick="() => { TargetConnString = conn.ConnectionString; CloseDropdowns(); }">
                                                    <div class="fw-bold">@conn.Name</div>
                                                    <div class="small @(TargetConnString == conn.ConnectionString ? "text-light text-opacity-75" : "text-muted")">@GetDbName(conn.ConnectionString)</div>
                                                </a>
                                            }
                                            @if (!FilteredTargetConnections.Any())
                                            {
                                                <div class="text-center text-muted small py-3">No matches found</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(SourceConnString) && !string.IsNullOrEmpty(TargetConnString))
                        {
                            @if (!CompareService.AreOnSameServer(SourceConnString, TargetConnString))
                            {
                                <div class="alert alert-danger py-2 small mb-0">
                                    <span class="fw-bold">Error:</span> Both databases must reside on the same SQL Server instance for this comparison tool.
                                </div>
                            }
                            else if (SourceConnString == TargetConnString)
                            {
                                <div class="alert alert-warning py-2 small mb-0">
                                    Please select different databases to compare.
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-primary w-100 fw-bold" @onclick="RunAnalysis">
                                    Start Analysis
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (CurrentState == PageState.Analyzing)
    {
        <div class="row flex-grow-1 align-items-center justify-content-center">
            <div class="text-center">
                <div class="spinner-border text-info mb-3" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="fw-bold">@LoadingMessage</h5>
                <p class="text-muted small">This may take a moment depending on database size.</p>
            </div>
        </div>
    }
    else if (CurrentState == PageState.Results && CompareResult != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <span class="text-info">@GetDbName(SourceConnString)</span>
                <span class="text-muted mx-2">➔</span>
                <span class="text-warning">@GetDbName(TargetConnString)</span>
            </h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Reset">New Comparison</button>
        </div>

        <ul class="nav nav-tabs border-secondary mb-3">
            <li class="nav-item">
                <a class="nav-link cursor-pointer @(ActiveTab == "Comparable" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")" 
                   @onclick='() => { ActiveTab = "Comparable"; TablesCurrentPage = 1; }'>
                    🟢 Comparable Tables (@CompareResult.ComparableTables.Count)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link cursor-pointer @(ActiveTab == "NonComparable" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted border-transparent")" 
                   @onclick='() => { ActiveTab = "NonComparable"; TablesCurrentPage = 1; }'>
                    🔴 Non-Comparable Tables (@CompareResult.NonComparableTables.Count)
                </a>
            </li>
        </ul>

        <div class="card bg-dark border-secondary shadow-sm flex-grow-1 d-flex flex-column" style="min-height: 0;">
            <div class="card-body p-0" style="overflow-y: auto;">
                @if (ActiveTab == "Comparable")
                {
                    <table class="table table-dark table-hover table-sm mb-0">
                        <thead class="sticky-top bg-dark">
                            <tr>
                                <th class="border-secondary py-2 px-3">Table Name</th>
                                <th class="border-secondary py-2 px-3 text-end">Source Rows</th>
                                <th class="border-secondary py-2 px-3 text-end">Target Rows</th>
                                <th class="border-secondary py-2 px-3">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in PaginatedComparableTables)
                            {
                                <tr class="cursor-pointer" @onclick="() => ShowDiff(table)">
                                    <td class="border-secondary px-3 align-middle">
                                        @table.FullName
                                        @if (table.IsLargeTable)
                                        {
                                            <span class="badge bg-warning text-dark ms-2" title="Large table. Comparison may take a long time.">⚠️ Large</span>
                                        }
                                    </td>
                                    <td class="border-secondary px-3 align-middle text-end font-monospace">@table.SourceRowCount.ToString("N0")</td>
                                    <td class="border-secondary px-3 align-middle text-end font-monospace">@table.TargetRowCount.ToString("N0")</td>
                                    <td class="border-secondary px-3 align-middle">
                                        @if (table.Status == "Identical")
                                        {
                                            <span class="badge bg-success">Identical</span>
                                        }
                                        else if (table.Status == "Differences Found")
                                        {
                                            <span class="badge bg-danger">Differences Found</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@table.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!CompareResult.ComparableTables.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted border-secondary">No comparable tables found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="table table-dark table-hover table-sm mb-0">
                        <thead class="sticky-top bg-dark">
                            <tr>
                                <th class="border-secondary py-2 px-3">Table Name</th>
                                <th class="border-secondary py-2 px-3">Reason Skipped</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var table in PaginatedNonComparableTables)
                            {
                                <tr>
                                    <td class="border-secondary px-3">@table.FullName</td>
                                    <td class="border-secondary px-3 text-warning">@table.NonComparableReason</td>
                                </tr>
                            }
                            @if (!CompareResult.NonComparableTables.Any())
                            {
                                <tr>
                                    <td colspan="2" class="text-center py-4 text-muted border-secondary">All tables are comparable.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            
            @if (ActiveTableCount > 0)
            {
                <div class="p-2 border-top border-secondary bg-black d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <span class="small text-muted">Showing @(((TablesCurrentPage - 1) * TablesPageSize) + 1) to @Math.Min(TablesCurrentPage * TablesPageSize, ActiveTableCount) of @ActiveTableCount tables</span>
                        <div class="btn-group btn-group-sm">
                            @foreach (var size in new[] { 10, 20, 50, 100 })
                            {
                                <button class="btn @(TablesPageSize == size ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick="() => { TablesPageSize = size; TablesCurrentPage = 1; }">@size</button>
                            }
                        </div>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" disabled="@(TablesCurrentPage <= 1)" @onclick="() => TablesCurrentPage--">Previous</button>
                        <button class="btn btn-secondary disabled">Page @TablesCurrentPage of @Math.Max(1, ActiveTotalPages)</button>
                        <button class="btn btn-outline-secondary" disabled="@(TablesCurrentPage >= ActiveTotalPages)" @onclick="() => TablesCurrentPage++">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (ShowDiffModal && SelectedTable != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content glass-card border-0 text-white" style="background-color: #1a1d20;">
                <div class="modal-header border-bottom border-secondary bg-dark">
                    <h5 class="modal-title fw-bold">
                        Data Diff: <span class="text-info">@SelectedTable.FullName</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDiff"></button>
                </div>
                <div class="modal-body p-0 d-flex flex-column">
                    @if (IsLoadingDiff)
                    {
                        <div class="d-flex justify-content-center align-items-center flex-grow-1">
                            <div class="spinner-border text-info" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span class="ms-3 fw-bold">Fetching differences...</span>
                        </div>
                    }
                    else if (DiffRows == null || !DiffRows.Any())
                    {
                        <div class="d-flex justify-content-center align-items-center flex-grow-1">
                            <span class="text-success fw-bold fs-5">✓ No differences found</span>
                        </div>
                    }
                    else
                    {
                        <div class="p-2 border-bottom border-secondary bg-black d-flex flex-wrap justify-content-between align-items-center small gap-2">
                            <div class="d-flex gap-4 align-items-center">
                                <span><span class="badge" style="background-color: rgba(40,167,69,0.2); border: 1px solid #28a745; color: #28a745">Green</span> Exists only in Source</span>
                                <span><span class="badge" style="background-color: rgba(220,53,69,0.2); border: 1px solid #dc3545; color: #dc3545">Red</span> Exists only in Target</span>
                                <span><span class="badge" style="background-color: rgba(255,193,7,0.2); border: 1px solid #ffc107; color: #ffc107">Yellow</span> Exists in both, values modified</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold">Rows: @FilteredDiffRows.Count()</span>
                                <div class="dropdown position-relative">
                                    <button class="btn btn-sm btn-outline-secondary d-flex justify-content-between align-items-center bg-dark text-white" 
                                            style="min-width: 180px;"
                                            type="button" 
                                            @onclick="() => IsFilterDropdownOpen = !IsFilterDropdownOpen">
                                        <span class="me-2">
                                            @(DiffFilter == "All" ? "All Differences" : 
                                              DiffFilter == "Added" ? "Exists only in Source" :
                                              DiffFilter == "Deleted" ? "Exists only in Target" : "Modified")
                                        </span>
                                        <span class="small text-muted">▼</span>
                                    </button>
                                    
                                    @if (IsFilterDropdownOpen)
                                    {
                                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1060;" @onclick="() => IsFilterDropdownOpen = false"></div>
                                        <div class="dropdown-menu show dropdown-menu-end p-2 bg-dark border-secondary shadow-lg mt-1" style="z-index: 1061; position: absolute; right: 0; min-width: 200px;">
                                            <a class="dropdown-item custom-dropdown-item text-light cursor-pointer rounded px-3 py-2 @(DiffFilter == "All" ? "bg-primary" : "")"
                                               @onclick='() => SetDiffFilter("All")'>
                                                All Differences
                                            </a>
                                            <a class="dropdown-item custom-dropdown-item text-light cursor-pointer rounded px-3 py-2 @(DiffFilter == "Added" ? "bg-primary" : "")"
                                               @onclick='() => SetDiffFilter("Added")'>
                                                Exists only in Source
                                            </a>
                                            <a class="dropdown-item custom-dropdown-item text-light cursor-pointer rounded px-3 py-2 @(DiffFilter == "Deleted" ? "bg-primary" : "")"
                                               @onclick='() => SetDiffFilter("Deleted")'>
                                                Exists only in Target
                                            </a>
                                            <a class="dropdown-item custom-dropdown-item text-light cursor-pointer rounded px-3 py-2 @(DiffFilter == "Modified" ? "bg-primary" : "")"
                                               @onclick='() => SetDiffFilter("Modified")'>
                                                Modified
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="flex-grow-1 overflow-auto">
                            <table class="table table-dark table-sm table-bordered border-secondary mb-0" style="white-space: nowrap;">
                                <thead class="sticky-top bg-dark" style="z-index: 2;">
                                    <tr>
                                        <th style="width: 100px;">Status</th>
                                        @foreach (var col in DiffColumns)
                                        {
                                            <th>@col</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in PaginatedDiffRows)
                                    {
                                        if (row.RowStatus == "Added")
                                        {
                                            <tr style="background-color: rgba(40,167,69,0.15);">
                                                <td class="align-middle"><span class="text-success fw-bold">SourceOnly</span></td>
                                                @foreach (var col in DiffColumns)
                                                {
                                                    <td class="font-monospace text-success">@(row.SourceData.ContainsKey(col) ? row.SourceData[col]?.ToString() : "")</td>
                                                }
                                            </tr>
                                        }
                                        else if (row.RowStatus == "Deleted")
                                        {
                                            <tr style="background-color: rgba(220,53,69,0.15);">
                                                <td class="align-middle"><span class="text-danger text-decoration-line-through">TargetOnly</span></td>
                                                @foreach (var col in DiffColumns)
                                                {
                                                    <td class="font-monospace text-danger text-decoration-line-through">@(row.TargetData.ContainsKey(col) ? row.TargetData[col]?.ToString() : "")</td>
                                                }
                                            </tr>
                                        }
                                        else if (row.RowStatus == "Modified")
                                        {
                                            <tr style="background-color: rgba(255,193,7,0.05);">
                                                <td class="align-middle"><span class="text-warning fw-bold">Modified</span></td>
                                                @foreach (var col in DiffColumns)
                                                {
                                                    var sVal = row.SourceData.ContainsKey(col) ? row.SourceData[col]?.ToString() : "";
                                                    var tVal = row.TargetData.ContainsKey(col) ? row.TargetData[col]?.ToString() : "";
                                                    var isDiff = sVal != tVal;
                                                    
                                                    <td class="font-monospace align-middle">
                                                        @if (isDiff)
                                                        {
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="text-warning">@sVal</span>
                                                                <span class="text-muted small">|</span>
                                                                <span class="text-warning">@tVal</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-warning">@sVal</span>
                                                        }
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        @if (FilteredDiffRows.Any())
                        {
                            <div class="p-2 border-top border-secondary bg-black d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="small text-muted">Showing @(((DiffCurrentPage - 1) * DiffPageSize) + 1) to @Math.Min(DiffCurrentPage * DiffPageSize, FilteredDiffRows.Count()) of @FilteredDiffRows.Count() rows</span>
                                    <div class="btn-group btn-group-sm">
                                        @foreach (var size in new[] { 10, 20, 50, 100 })
                                        {
                                            <button class="btn @(DiffPageSize == size ? "btn-secondary" : "btn-outline-secondary")"
                                                    @onclick="() => { DiffPageSize = size; ResetPagination(); }">@size</button>
                                        }
                                    </div>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" disabled="@(DiffCurrentPage <= 1)" @onclick="() => DiffCurrentPage--">Previous</button>
                                    <button class="btn btn-secondary disabled">Page @DiffCurrentPage of @Math.Max(1, TotalDiffPages)</button>
                                    <button class="btn btn-outline-secondary" disabled="@(DiffCurrentPage >= TotalDiffPages)" @onclick="() => DiffCurrentPage++">Next</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (ShowNewConnectionModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0 text-white" style="background-color: #2b3035;">
                <div class="modal-header border-bottom border-secondary">
                    <h5 class="modal-title fw-bold">Add New Connection</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => ShowNewConnectionModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Connection Name</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" @bind="NewConnName" placeholder="e.g. Production DB" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Connection String</label>
                        <textarea class="form-control bg-dark text-white border-secondary" rows="4" @bind="NewConnString" placeholder="Server=myServer;Database=myDB;..."></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(NewConnError))
                    {
                        <div class="alert alert-danger py-2 small mb-0">@NewConnError</div>
                    }
                </div>
                <div class="modal-footer border-top border-secondary">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => ShowNewConnectionModal = false">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveNewConnection">Save Connection</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum PageState { Setup, Analyzing, Results }
    private PageState CurrentState = PageState.Setup;
    
    private string SourceConnString = "";
    private string TargetConnString = "";
    
    // Custom Dropdown State
    private bool IsSourceDropdownOpen = false;
    private string SourceSearchTerm = "";
    private bool IsTargetDropdownOpen = false;
    private string TargetSearchTerm = "";

    private IEnumerable<ConnectionService.SavedConnection> FilteredSourceConnections =>
        ConnectionService.SavedConnections
            .Where(c => string.IsNullOrEmpty(SourceSearchTerm) || 
                        c.Name.Contains(SourceSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                        c.ConnectionString.Contains(SourceSearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Name);

    private IEnumerable<ConnectionService.SavedConnection> FilteredTargetConnections =>
        ConnectionService.SavedConnections
            .Where(c => string.IsNullOrEmpty(TargetSearchTerm) || 
                        c.Name.Contains(TargetSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                        c.ConnectionString.Contains(TargetSearchTerm, StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Name);

    // New Connection Modal State
    private bool ShowNewConnectionModal = false;
    private string NewConnName = "";
    private string NewConnString = "";
    private string NewConnError = "";

    private void OpenNewConnectionModal()
    {
        NewConnName = "";
        NewConnString = "";
        NewConnError = "";
        ShowNewConnectionModal = true;
    }

    private void SaveNewConnection()
    {
        if (string.IsNullOrWhiteSpace(NewConnString))
        {
            NewConnError = "Connection string is required.";
            return;
        }

        try
        {
            // Simple validation check
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(NewConnString);
            
            ConnectionService.UpsertConnection("", NewConnName, NewConnString);
            ShowNewConnectionModal = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NewConnError = "Invalid connection string: " + ex.Message;
        }
    }

    private void CloseDropdowns()
    {
        IsSourceDropdownOpen = false;
        IsTargetDropdownOpen = false;
        SourceSearchTerm = "";
        TargetSearchTerm = "";
    }

    private string GetConnectionDisplayName(string connString)
    {
        var conn = ConnectionService.SavedConnections.FirstOrDefault(c => c.ConnectionString == connString);
        if (conn != null) return $"{conn.Name} ({GetDbName(conn.ConnectionString)})";
        return GetDbName(connString);
    }

    // Tables Pagination
    private int TablesCurrentPage = 1;
    private int TablesPageSize = 20;

    private IEnumerable<CompareTableResult> PaginatedComparableTables =>
        CompareResult?.ComparableTables.OrderBy(t => t.FullName).Skip((TablesCurrentPage - 1) * TablesPageSize).Take(TablesPageSize) ?? Enumerable.Empty<CompareTableResult>();

    private int TotalComparablePages => CompareResult == null ? 0 : (int)Math.Ceiling(CompareResult.ComparableTables.Count / (double)TablesPageSize);

    private IEnumerable<CompareTableResult> PaginatedNonComparableTables =>
        CompareResult?.NonComparableTables.OrderBy(t => t.FullName).Skip((TablesCurrentPage - 1) * TablesPageSize).Take(TablesPageSize) ?? Enumerable.Empty<CompareTableResult>();

    private int TotalNonComparablePages => CompareResult == null ? 0 : (int)Math.Ceiling(CompareResult.NonComparableTables.Count / (double)TablesPageSize);
    
    private int ActiveTableCount => ActiveTab == "Comparable" ? (CompareResult?.ComparableTables.Count ?? 0) : (CompareResult?.NonComparableTables.Count ?? 0);
    private int ActiveTotalPages => ActiveTab == "Comparable" ? TotalComparablePages : TotalNonComparablePages;

    private string LoadingMessage = "Scanning schemas and matching tables...";
    private DataCompareResult? CompareResult;
    private string ActiveTab = "Comparable";

    // Diff Modal State
    private bool ShowDiffModal = false;
    private CompareTableResult? SelectedTable;
    private bool IsLoadingDiff = false;
    private List<DataDiffRow> DiffRows = new();
    private List<string> DiffColumns = new();

    // Diff Pagination and Filtering
    private string DiffFilter = "All";
    private bool IsFilterDropdownOpen = false;
    private int DiffCurrentPage = 1;
    private int DiffPageSize = 20;

    private void SetDiffFilter(string filter)
    {
        DiffFilter = filter;
        IsFilterDropdownOpen = false;
        ResetPagination();
    }

    private IEnumerable<DataDiffRow> FilteredDiffRows =>
        DiffRows.Where(r => 
            DiffFilter == "All" || 
            (DiffFilter == "Added" && r.RowStatus == "Added") ||
            (DiffFilter == "Deleted" && r.RowStatus == "Deleted") ||
            (DiffFilter == "Modified" && r.RowStatus == "Modified")
        );

    private IEnumerable<DataDiffRow> PaginatedDiffRows =>
        FilteredDiffRows.Skip((DiffCurrentPage - 1) * DiffPageSize).Take(DiffPageSize);

    private int TotalDiffPages => (int)Math.Ceiling(FilteredDiffRows.Count() / (double)DiffPageSize);

    private void ResetPagination()
    {
        DiffCurrentPage = 1;
    }

    private string GetDbName(string connString)
    {
        try
        {
            var builder = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(connString);
            return builder.InitialCatalog;
        }
        catch { return "Unknown"; }
    }

    private async Task RunAnalysis()
    {
        CurrentState = PageState.Analyzing;
        StateHasChanged();
        
        await Task.Delay(50); // let UI render loading spinner

        try
        {
            CompareResult = await CompareService.AnalyzeDatabasesAsync(SourceConnString, TargetConnString);
            ActiveTab = "Comparable";
            CurrentState = PageState.Results;
        }
        catch (Exception ex)
        {
            LoadingMessage = "Error: " + ex.Message;
        }
    }

    private void Reset()
    {
        CurrentState = PageState.Setup;
        CompareResult = null;
        SourceConnString = "";
        TargetConnString = "";
    }

    private async Task ShowDiff(CompareTableResult table)
    {
        if (table.Status == "Identical") return; // Nothing to show
        
        SelectedTable = table;
        ShowDiffModal = true;
        IsLoadingDiff = true;
        DiffRows.Clear();
        DiffColumns.Clear();
        DiffFilter = "All";
        DiffCurrentPage = 1;
        StateHasChanged();
        
        await Task.Delay(50); // let UI render loading state

        try
        {
            DiffRows = await CompareService.GetTableDifferencesAsync(SourceConnString, TargetConnString, table.Schema, table.Name);
            if (DiffRows.Any())
            {
                // Collect all columns from the first row (source or target)
                var firstRow = DiffRows.First();
                var keys = firstRow.SourceData.Keys.Any() 
                    ? firstRow.SourceData.Keys.ToList() 
                    : firstRow.TargetData.Keys.ToList();
                
                keys.Remove("RowStatus");
                DiffColumns = keys;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Diff Error: " + ex.Message);
        }
        finally
        {
            IsLoadingDiff = false;
            StateHasChanged();
        }
    }

    private void CloseDiff()
    {
        ShowDiffModal = false;
        SelectedTable = null;
        DiffRows.Clear();
    }
}
