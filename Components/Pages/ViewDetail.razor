@page "/view/{FullName}"
@using DbExplore.Services
@inject SchemaService SchemaService
@inject NavigationManager Navigation

<div class="container-fluid">
    @if (View == null)
    {
        <div class="alert alert-warning">View not found: @FullName</div>
    }
    else
    {
        <div class="row mb-4 align-items-center">
            <div class="col-auto">
                <button class="btn btn-outline-light btn-sm" @onclick="NavigateBack">Back</button>
            </div>
            <div class="col">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="text-white mb-0">@View.Name</h2>
                    <span class="badge bg-secondary">@View.Schema</span>
                </div>
            </div>
            <div class="col-auto">
                <a href="/runner?type=view&name=@Uri.EscapeDataString(View.FullName)" class="btn btn-primary btn-sm">▶ Run in Query Runner</a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card glass-card h-100 text-white">
                    <div class="card-header border-secondary fw-bold">Columns</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var col in View.Columns)
                        {
                            <li class="list-group-item bg-transparent text-white border-secondary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">@col.Name</span>
                                    <span class="badge bg-dark border border-secondary text-muted">@col.DataType</span>
                                </div>
                                @if (!string.IsNullOrEmpty(col.SourceTable))
                                {
                                    <div class="small mt-1" style="font-size: 0.85em;">
                                        <span class="text-secondary">Source:</span>
                                        @{
                                            var sourceFullName = $"[{col.SourceSchema}].[{col.SourceTable}]";
                                            var textClass = IsView(sourceFullName) ? "text-info" : "text-primary";
                                        }
                                        <a href="@BuildObjectLink(sourceFullName)" class="text-decoration-none @textClass">
                                            @col.SourceTable
                                        </a>
                                        <span class="text-secondary">.</span><span class="text-light">@col.SourceColumn</span>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-md-8">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="card glass-card text-white">
                            <div class="card-header border-secondary text-info fw-bold">
                                Parents (Upstream)
                                <small class="d-block text-muted fw-normal">Tables or views this view selects from.</small>
                            </div>
                            <div class="card-body">
                                @if (View.Parents.Count == 0)
                                {
                                    <span class="text-muted">No dependencies found.</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var dep in View.Parents)
                                        {
                                            var badgeClass = dep.Type == "Table" ? "bg-primary" : "bg-info text-dark";

                                            <a href="@BuildObjectLink(dep.FullName)" class="btn btn-outline-info btn-sm text-start" style="min-width: 200px;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold">@GetShortName(dep.Name)</span>
                                                    <span class="badge @badgeClass" style="font-size: 0.7em;">@dep.Type</span>
                                                </div>
                                                <small class="text-muted" style="font-size: 0.7em;">@dep.Schema</small>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card glass-card text-white">
                            <div class="card-header border-secondary text-warning fw-bold">
                                Children (Downstream)
                                <small class="d-block text-muted fw-normal">Views that select from this view.</small>
                            </div>
                            <div class="card-body">
                                @if (View.Children.Count == 0)
                                {
                                    <span class="text-muted">No dependent views.</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var dep in View.Children)
                                        {
                                            var badgeClass = dep.Type == "Table" ? "bg-primary" : "bg-info text-dark";

                                            <a href="@BuildObjectLink(dep.FullName)" class="btn btn-outline-warning btn-sm text-start" style="min-width: 200px;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold">@GetShortName(dep.Name)</span>
                                                    <span class="badge @badgeClass" style="font-size: 0.7em;">@dep.Type</span>
                                                </div>
                                                <small class="text-muted" style="font-size: 0.7em;">@dep.Schema</small>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card glass-card text-white">
                            <div class="card-header border-secondary fw-bold" style="color: #b388ff;">
                                Referenced by Stored Procedures
                                <small class="d-block text-muted fw-normal">SPs that read from this view.</small>
                            </div>
                            <div class="card-body">
                                @if (View.ReferencedBySPs.Count == 0)
                                {
                                    <span class="text-muted">No stored procedures reference this view.</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var dep in View.ReferencedBySPs)
                                        {
                                            var spFull = $"[{dep.Schema}].[{dep.Name}]";
                                            <a href="@BuildProcLink(spFull)" class="btn btn-sm text-start" style="min-width: 180px; border-color: #b388ff; color: #b388ff;">
                                                <div class="fw-bold">@dep.Name</div>
                                                <small class="text-muted" style="font-size: 0.7em;">@dep.Schema</small>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string FullName { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private ViewInfo? View;

    protected override void OnParametersSet()
    {
        var decoded = Uri.UnescapeDataString(FullName);
        View = SchemaService.Views.FirstOrDefault(t => t.FullName == decoded);
    }

    private void NavigateBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/views");
    }

    private string BuildObjectLink(string fullName)
    {
        var prefix = IsView(fullName) ? "/view" : "/table";
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(fullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string BuildProcLink(string procFullName)
    {
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"/proc/{Uri.EscapeDataString(procFullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string GetShortName(string name)
    {
        return name.Replace("[", "").Replace("]", "");
    }

    private bool IsView(string fullName)
    {
        return SchemaService.Views.Any(v => v.FullName == fullName);
    }
}
