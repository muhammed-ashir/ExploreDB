@page "/learning"

<div class="container-fluid h-100 d-flex flex-column pb-5">
    @if (string.IsNullOrEmpty(ActiveTopic))
    {
        <div class="mt-4 mb-4">
            <h2 class="fw-bold text-white mb-1">Learning Hub</h2>
            <p class="text-secondary">Select a topic below to explore guides, tricks, and advanced SQL concepts.</p>
        </div>
        
        <div class="row g-4 flex-grow-1">
            <div class="col-md-4">
                <div class="card glass-card text-white h-100 p-4 border-secondary transition-transform shadow-sm" style="cursor: pointer;" @onclick='() => SetTopic("joins")' onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="text-center mb-4 mt-2">
                        <i class="bi bi-diagram-3 text-primary" style="font-size: 3.5rem;"></i>
                    </div>
                    <h4 class="text-center fw-bold mb-3">Join Guide</h4>
                    <p class="text-secondary text-center small">A practical SQL Server join reference for choosing the right join, preventing duplicates, and debugging multi-table queries.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card glass-card text-white h-100 p-4 border-secondary transition-transform shadow-sm" style="cursor: pointer;" @onclick='() => SetTopic("tricks")' onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="text-center mb-4 mt-2">
                        <i class="bi bi-magic text-info" style="font-size: 3.5rem;"></i>
                    </div>
                    <h4 class="text-center fw-bold mb-3">DB Tricks & Tips</h4>
                    <p class="text-secondary text-center small">Useful snippets, best practices, and clever tricks for exploring and working with your databases more efficiently.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card glass-card text-white h-100 p-4 border-secondary transition-transform shadow-sm" style="cursor: pointer;" @onclick='() => SetTopic("advanced")' onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                    <div class="text-center mb-4 mt-2">
                        <i class="bi bi-braces-asterisk text-warning" style="font-size: 3.5rem;"></i>
                    </div>
                    <h4 class="text-center fw-bold mb-3">Advanced SQL</h4>
                    <p class="text-secondary text-center small">Take your skills to the next level with a deep dive into window functions, CTEs, complex aggregations, and performance tuning.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mt-4 flex-grow-1 overflow-auto custom-scrollbar-light pe-3">
            <button class="btn btn-outline-secondary btn-sm mb-4 text-light border-secondary hover-bg-dark" @onclick='() => SetTopic("")'>
                <i class="bi bi-arrow-left me-2"></i> Back to Topics
            </button>
            
            @if (ActiveTopic == "joins")
            {
                <JoinGuide />
            }
            else if (ActiveTopic == "tricks")
            {
                <DbTricks />
            }
            else if (ActiveTopic == "advanced")
            {
                <AdvancedSql />
            }
        </div>
    }
</div>

@code {
    private string ActiveTopic = "";

    private void SetTopic(string topic)
    {
        ActiveTopic = topic;
    }
}
