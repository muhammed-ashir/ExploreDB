@page "/learning"

<div class="container-fluid h-100 d-flex flex-column pb-5">
    @if (string.IsNullOrEmpty(ActiveTopic))
    {
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold text-white mb-0">Learning Hub</h2>
            </div>
        </div>
        
        <div class="row g-3 flex-grow-1 align-content-start">
            <div class="col-12 col-xl-6">
                <div class="card glass-card text-white node-card py-3 px-4 d-flex flex-row align-items-center justify-content-between transition-transform hover-scale" style="cursor: pointer;" @onclick='() => SetTopic("joins")'>
                    <div class="d-flex align-items-center gap-3 overflow-hidden">
                        <div class="text-primary fs-3 d-flex align-items-center justify-content-center" style="width: 40px;">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div class="overflow-hidden" style="min-width: 0;">
                            <h5 class="mb-0 fw-bold text-white text-wrap" style="letter-spacing: 0.5px; word-break: break-word;">Join Guide</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6">
                <div class="card glass-card text-white node-card py-3 px-4 d-flex flex-row align-items-center justify-content-between transition-transform hover-scale" style="cursor: pointer;" @onclick='() => SetTopic("tricks")'>
                    <div class="d-flex align-items-center gap-3 overflow-hidden">
                        <div class="text-info fs-3 d-flex align-items-center justify-content-center" style="width: 40px;">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div class="overflow-hidden" style="min-width: 0;">
                            <h5 class="mb-0 fw-bold text-white text-wrap" style="letter-spacing: 0.5px; word-break: break-word;">DB Tricks & Tips</h5>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-6">
                <div class="card glass-card text-white node-card py-3 px-4 d-flex flex-row align-items-center justify-content-between transition-transform hover-scale" style="cursor: pointer;" @onclick='() => SetTopic("advanced")'>
                    <div class="d-flex align-items-center gap-3 overflow-hidden">
                        <div class="text-warning fs-3 d-flex align-items-center justify-content-center" style="width: 40px;">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div class="overflow-hidden" style="min-width: 0;">
                            <h5 class="mb-0 fw-bold text-white text-wrap" style="letter-spacing: 0.5px; word-break: break-word;">Advanced SQL</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mt-4 flex-grow-1 overflow-auto custom-scrollbar-light pe-3">
            <button class="btn btn-outline-secondary btn-sm mb-4 text-light border-secondary hover-bg-dark" @onclick='() => SetTopic("")'>
                <i class="bi bi-arrow-left me-2"></i> Back to Topics
            </button>
            
            @if (ActiveTopic == "joins")
            {
                <JoinGuide />
            }
            else if (ActiveTopic == "tricks")
            {
                <DbTricks />
            }
            else if (ActiveTopic == "advanced")
            {
                <AdvancedSql />
            }
        </div>
    }
</div>

@code {
    private string ActiveTopic = "";

    private void SetTopic(string topic)
    {
        ActiveTopic = topic;
    }
}
