@page "/proc/{FullName}"
@using DbExplore.Services
@using Dapper
@using Microsoft.Data.SqlClient
@using System.Data
@using System.Text.RegularExpressions
@inject SchemaService SchemaService
@inject ConnectionService ConnectionService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid">
    @if (Sp == null)
    {
        <div class="alert alert-warning">Stored procedure not found: @FullName</div>
    }
    else
    {
        <div class="row mb-4 align-items-center">
            <div class="col-auto">
                <button class="btn btn-outline-light btn-sm" @onclick="NavigateBack">Back</button>
            </div>
            <div class="col">
                <h2 class="text-white mb-1">@Sp.Name</h2>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-secondary">@Sp.Schema</span>
                    <span class="badge bg-dark border border-secondary text-muted">@Sp.Parameters.Count param@(Sp.Parameters.Count == 1 ? "" : "s")</span>
                    @if (Sp.CreatedDate.HasValue)
                    {
                        <small class="text-muted" style="font-size: 0.8em;">Created @Sp.CreatedDate.Value.ToString("dd MMM yyyy")</small>
                    }
                    @if (Sp.ModifiedDate.HasValue)
                    {
                        <small class="text-muted" style="font-size: 0.8em;">Modified @Sp.ModifiedDate.Value.ToString("dd MMM yyyy")</small>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card glass-card text-white mb-4">
                    <div class="card-header border-secondary fw-bold d-flex justify-content-between align-items-center">
                        <div>
                            Execution Harness
                            <small class="d-block text-muted fw-normal">Test this procedure</small>
                        </div>
                        <button class="btn btn-sm btn-primary" @onclick="ExecuteProcedureAsync" disabled="@IsExecuting">
                            @if (IsExecuting) { <span class="spinner-border spinner-border-sm"></span> }
                            else { <span>Execute</span> }
                        </button>
                    </div>
                    <div class="card-body">
                        @if (Sp.Parameters.Count == 0)
                        {
                            <span class="text-muted fst-italic">No parameters. Call with no arguments.</span>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var p in Sp.Parameters)
                                {
                                    <div>
                                        <label class="form-label small fw-bold mb-1 text-warning" style="font-family: monospace;">
                                            @p.Name
                                            @if (p.IsOutput) { <span class="badge bg-danger ms-1" style="font-size: 0.6em;">OUT</span> }
                                            <span class="text-info ms-2" style="font-size: 0.8em;">@p.DisplayType</span>
                                        </label>
                                        @if (!p.IsOutput)
                                        {
                                            var val = GetParamValueString(p.Name);
                                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                                   value="@val" @oninput="(e) => SetParamValueString(p.Name, e.Value?.ToString())"
                                                   placeholder="@(p.HasDefault ? $"Default: {p.DefaultValue ?? "NULL"}" : "Value...")" />
                                        }
                                        else
                                        {
                                            <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                                   value="@GetOutputValueString(p.Name)" readonly placeholder="Output will appear here..." />
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card glass-card text-white">
                    <div class="card-header border-secondary fw-bold d-flex justify-content-between align-items-center">
                        <div>
                            EXECUTE Statement
                            <small class="d-block text-muted fw-normal">Ready to run in SSMS or Azure Data Studio</small>
                        </div>
                        <button class="btn btn-sm @(Copied ? "btn-success" : "btn-outline-light")"
                                @onclick="CopyExecStatement"
                                title="Copy to clipboard">
                            @(Copied ? "Copied" : "Copy")
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <pre class="m-0 p-3 text-success" style="font-size: 0.82em; white-space: pre-wrap; word-break: break-all; background: transparent; border: none;">@ExecStatement</pre>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card glass-card text-white h-100 d-flex flex-column" style="min-height: 500px;">
                    <div class="card-header border-secondary p-0">
                        <ul class="nav nav-tabs border-secondary">
                            <li class="nav-item">
                                <a class="nav-link @(ActiveTab == "Results" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted")"
                                   @onclick='() => SetActiveTab("Results")' style="cursor:pointer">Results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ActiveTab == "Messages" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted")"
                                   @onclick='() => SetActiveTab("Messages")' style="cursor:pointer">
                                    Messages
                                    @if (Messages.Count > 0) { <span class="badge bg-secondary ms-1">@Messages.Count</span> }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ActiveTab == "Scratchpad" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted")"
                                   @onclick='() => SetActiveTab("Scratchpad")' style="cursor:pointer">Scratchpad</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ActiveTab == "Dependencies" ? "active bg-dark text-white border-secondary border-bottom-0" : "text-muted")"
                                   @onclick='() => SetActiveTab("Dependencies")' style="cursor:pointer">Dependencies</a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body overflow-auto flex-grow-1" style="max-height: 800px;">
                        @if (ActiveTab == "Results")
                        {
                            if (IsExecuting)
                            {
                                <div class="text-center mt-5"><div class="spinner-border text-primary"></div><div class="mt-2 text-muted">Executing...</div></div>
                            }
                            else if (ResultSets.Count == 0 && !HasExecuted)
                            {
                                <div class="text-muted text-center mt-5">Enter parameters on the left and click Execute to see results.</div>
                            }
                            else if (ResultSets.Count == 0 && HasExecuted)
                            {
                                <div class="text-muted text-center mt-5">Command completed successfully. No data tables returned.</div>
                            }
                            else
                            {
                                int rsIndex = 1;
                                foreach (var rs in ResultSets)
                                {
                                    <div class="fw-bold mb-2 mt-3 text-info">Result Set @rsIndex</div>
                                    <ResultSetGrid Data="rs" />
                                    rsIndex++;
                                }
                            }
                        }
                        else if (ActiveTab == "Messages")
                        {
                            <pre class="m-0 text-light" style="font-size: 0.85em; white-space: pre-wrap;">
@if (Messages.Count == 0) { <span class="text-muted fst-italic">No messages.</span> }
@foreach (var msg in Messages) { @msg<br/> }
                            </pre>
                        }
                        else if (ActiveTab == "Scratchpad")
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Runnable script version of this procedure.</span>
                                <button class="btn btn-sm btn-outline-light" @onclick="CopyScratchpad">Copy Code</button>
                            </div>
                            @if (ScratchpadText == null)
                            {
                                <div class="text-center mt-5"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                            }
                            else
                            {
                                <pre class="m-0 p-3 bg-black text-success border border-secondary" style="font-size: 0.82em; white-space: pre-wrap;">@ScratchpadText</pre>
                            }
                        }
                        else if (ActiveTab == "Dependencies")
                        {
                            @if (Sp.Dependencies.Count == 0)
                            {
                                <span class="text-muted fst-italic">No resolvable dependencies found.</span>
                                <div class="mt-2">
                                    <small class="text-secondary">This can happen with cross-database references, dynamic SQL, or system procedures.</small>
                                </div>
                            }
                            else
                            {
                                if (DepTables.Any())
                                {
                                    <div class="mb-3">
                                        <div class="text-uppercase text-muted small mb-2" style="letter-spacing: 0.08em; font-size: 0.7em;">
                                            Tables (@DepTables.Count)
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var dep in DepTables)
                                            {
                                                <a href="@BuildDependencyLink(dep)"
                                                   class="btn btn-outline-primary btn-sm text-start"
                                                   style="min-width: 180px;">
                                                    <div class="fw-bold">@dep.Name</div>
                                                    <small class="text-muted" style="font-size: 0.7em;">@dep.Schema</small>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }

                                if (DepViews.Any())
                                {
                                    <div>
                                        <div class="text-uppercase text-muted small mb-2" style="letter-spacing: 0.08em; font-size: 0.7em;">
                                            Views (@DepViews.Count)
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var dep in DepViews)
                                            {
                                                <a href="@BuildDependencyLink(dep)"
                                                   class="btn btn-outline-info btn-sm text-start"
                                                   style="min-width: 180px;">
                                                    <div class="fw-bold">@dep.Name</div>
                                                    <small class="text-muted" style="font-size: 0.7em;">@dep.Schema</small>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string FullName { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private SpInfo? Sp;
    private bool Copied = false;
    private string ActiveTab = "Results";
    private bool IsExecuting = false;
    private bool HasExecuted = false;
    private Dictionary<string, string?> InputValues = new();
    private Dictionary<string, string?> OutputValues = new();
    private List<IEnumerable<dynamic>> ResultSets = new();
    private List<string> Messages = new();
    private string? ScratchpadText;

    private List<Dependency> DepTables => Sp?.Dependencies.Where(d => d.Type == "Table").OrderBy(d => d.Name).ToList() ?? new();
    private List<Dependency> DepViews => Sp?.Dependencies.Where(d => d.Type == "View").OrderBy(d => d.Name).ToList() ?? new();

    protected override void OnParametersSet()
    {
        var decoded = Uri.UnescapeDataString(FullName);
        Sp = SchemaService.StoredProcedures.FirstOrDefault(s => s.FullName == decoded);
        Copied = false;
        
        InputValues.Clear();
        OutputValues.Clear();
        ResultSets.Clear();
        Messages.Clear();
        HasExecuted = false;
        ActiveTab = "Results";
        ScratchpadText = null;

        if (Sp != null)
        {
            foreach (var p in Sp.Parameters)
            {
                if (!p.IsOutput)
                {
                    InputValues[p.Name] = string.Empty;
                }
                else
                {
                    OutputValues[p.Name] = string.Empty;
                }
            }
        }
    }

    private async Task SetActiveTab(string tab)
    {
        ActiveTab = tab;
        if (tab == "Scratchpad")
        {
            await LoadScratchpadAsync();
        }
    }

    private string GetParamValueString(string name) => InputValues.TryGetValue(name, out var val) ? (val ?? "") : "";
    private void SetParamValueString(string name, string? val) => InputValues[name] = val;
    private string GetOutputValueString(string name) => OutputValues.TryGetValue(name, out var val) ? (val ?? "") : "";

    private async Task ExecuteProcedureAsync()
    {
        if (Sp == null || IsExecuting) return;

        IsExecuting = true;
        HasExecuted = true;
        ResultSets.Clear();
        Messages.Clear();
        ActiveTab = "Results";
        StateHasChanged();

        try
        {
            using var conn = new SqlConnection(ConnectionService.ConnectionString);
            conn.InfoMessage += (sender, args) =>
            {
                Messages.Add(args.Message);
                InvokeAsync(StateHasChanged);
            };
            await conn.OpenAsync();

            var dapperParams = new DynamicParameters();
            foreach (var p in Sp.Parameters)
            {
                if (p.IsOutput)
                {
                    // Size matters for output strings, map to size -1 (max)
                    dapperParams.Add(p.Name, dbType: null, direction: ParameterDirection.Output, size: p.MaxLength > 0 ? p.MaxLength : -1);
                }
                else
                {
                    var val = InputValues.TryGetValue(p.Name, out var str) && !string.IsNullOrWhiteSpace(str) ? str : null;
                    dapperParams.Add(p.Name, val);
                }
            }

            dapperParams.Add("@__ReturnValue", dbType: DbType.Int32, direction: ParameterDirection.ReturnValue);

            using var multi = await conn.QueryMultipleAsync(Sp.FullName, dapperParams, commandType: CommandType.StoredProcedure);
            
            while (!multi.IsConsumed)
            {
                var rs = await multi.ReadAsync<dynamic>();
                ResultSets.Add(rs);
            }

            foreach (var p in Sp.Parameters.Where(p => p.IsOutput))
            {
                var outVal = dapperParams.Get<object>(p.Name);
                OutputValues[p.Name] = outVal?.ToString() ?? "NULL";
            }
            
            var retVal = dapperParams.Get<int>("@__ReturnValue");
            Messages.Add($"Return Value: {retVal}");
        }
        catch (Exception ex)
        {
            Messages.Add($"ERROR: {ex.Message}");
            ActiveTab = "Messages";
        }
        finally
        {
            IsExecuting = false;
        }
    }

    private async Task LoadScratchpadAsync()
    {
        if (Sp == null || ScratchpadText != null) return;
        var def = await SchemaService.GetStoredProcedureDefinitionAsync(Sp.FullName);
        if (string.IsNullOrWhiteSpace(def))
        {
            ScratchpadText = "-- Could not load definition.";
            return;
        }

        var body = def;
        // Attempt to strip out the CREATE PROCEDURE header
        // This regex looks for the CREATE/ALTER PROCEDURE statement, skips everything up to the first 'AS',
        // and captures the rest. Note: This is a simple approximation and might fail if 'AS' is heavily used in comments before the actual AS.
        var match = Regex.Match(def, @"(?i)\b(?:CREATE|ALTER)\s+(?:PROCEDURE|PROC)\b.*?\bAS\b(.*)", RegexOptions.Singleline);
        if (match.Success && match.Groups.Count > 1)
        {
            body = match.Groups[1].Value.TrimStart();
        }

        var lines = new System.Text.StringBuilder();
        lines.AppendLine($"-- Scratchpad for {Sp.FullName}");
        foreach (var p in Sp.Parameters)
        {
            var val = InputValues.TryGetValue(p.Name, out var str) && !string.IsNullOrWhiteSpace(str) ? $"'{str}'" : "NULL";
            lines.AppendLine($"DECLARE {p.Name} {p.DisplayType} = {val};");
        }
        lines.AppendLine();
        lines.AppendLine("-- Procedure Body:");
        lines.AppendLine(body);

        ScratchpadText = lines.ToString();
    }

    private async Task CopyScratchpad()
    {
        if (string.IsNullOrWhiteSpace(ScratchpadText)) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ScratchpadText);
    }

    private void NavigateBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/procs");
    }

    private string BuildDependencyLink(Dependency dependency)
    {
        var prefix = dependency.Type == "View" ? "/view" : "/table";
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(dependency.FullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string ExecStatement
    {
        get
        {
            if (Sp == null) return string.Empty;

            if (Sp.Parameters.Count == 0)
                return $"EXEC {Sp.FullName};";

            var lines = new System.Text.StringBuilder();
            lines.AppendLine($"EXEC {Sp.FullName}");

            var outputParams = Sp.Parameters.Where(p => p.IsOutput).ToList();

            foreach (var p in outputParams)
            {
                lines.AppendLine($"    -- DECLARE {p.Name} {p.DisplayType};");
            }

            if (outputParams.Any())
            {
                lines.AppendLine();
            }

            var allParams = Sp.Parameters.ToList();
            for (int i = 0; i < allParams.Count; i++)
            {
                var p = allParams[i];
                var isLast = i == allParams.Count - 1;
                var comma = isLast ? "" : ",";

                string placeholder;
                if (p.IsOutput)
                    placeholder = $"{p.Name} OUTPUT";
                else if (p.HasDefault && p.DefaultValue != null)
                    placeholder = $"{p.Name} = {p.DefaultValue}";
                else
                    placeholder = $"{p.Name} = NULL  -- {p.DisplayType}";

                lines.AppendLine($"    {placeholder}{comma}");
            }

            return lines.ToString().TrimEnd();
        }
    }

    private async Task CopyExecStatement()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ExecStatement);
        Copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        Copied = false;
        StateHasChanged();
    }
}
