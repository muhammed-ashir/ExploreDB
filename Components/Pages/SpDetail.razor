@page "/proc/{FullName}"
@using ExploreDB.Services
@using Dapper
@using Microsoft.Data.SqlClient
@using System.Data
@using System.Text.RegularExpressions
@inject SchemaService SchemaService
@inject ConnectionService ConnectionService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="container-fluid">
    @if (Sp == null)
    {
        <div class="alert alert-warning">Stored procedure not found: @FullName</div>
    }
    else
    {
        <!-- Header -->
        <div class="row mb-4 align-items-center">
            <div class="col">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex flex-column overflow-hidden justify-content-center" style="min-width: 0;">
                        <h5 class="text-white mb-0 fw-bold text-wrap d-flex align-items-center gap-2" style="letter-spacing: 0.5px; word-break: break-word;">
                            @Sp.Name
                            <span class="badge bg-warning text-dark fw-normal align-middle" style="font-size: 0.45em; padding: 0.35em 0.6em;">SP</span>
                        </h5>
                        <small class="text-muted fw-bold" style="font-size: 0.7em; letter-spacing: 1px; margin-top: 2px;">SCHEMA: <span class="text-lowercase">@Sp.Schema</span></small>
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <a href="javascript:void(0)" @onclick="NavigateBack" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 hover-scale transition-transform fw-medium rounded-pill px-3 py-1 shadow-sm border-secondary text-light">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <style>
            .schema-accordion .accordion-item {
                border-radius: 0.375rem !important;
                overflow: hidden;
                border-top: 1px solid #495057 !important;
            }
            .schema-accordion .accordion-button {
                background-color: transparent !important;
                color: #adb5bd !important;
                border: none !important;
                box-shadow: none !important;
            }
            .schema-accordion .accordion-button:not(.collapsed) {
                background-color: rgba(255,255,255,0.05) !important;
                color: #fff !important;
                border-bottom: 1px solid #495057 !important;
            }
            .schema-accordion .accordion-button::after {
                filter: invert(1) grayscale(100%) brightness(200%);
            }
        </style>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs border-secondary mb-4">
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Parameters" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Parameters")' style="cursor:pointer">
                    Parameters
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Dependencies" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Dependencies")' style="cursor:pointer">
                    Dependencies
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ActiveTab == "Execution" ? "active bg-transparent text-white border-secondary border-bottom-0 fw-bold" : "text-muted border-transparent hover-text-white")"
                   @onclick='() => SetActiveTab("Execution")' style="cursor:pointer">
                    Execution
                </a>
            </li>
        </ul>

        <div class="tab-content pb-5">
            @if (ActiveTab == "Parameters")
            {
                <div class="card glass-card text-white">
                    <div class="card-body">
                        <div class="mb-4">
                            <div class="input-group shadow-sm w-100">
                                <input type="text"
                                       class="form-control bg-dark text-white border-secondary shadow-none"
                                       placeholder="Search parameters..."
                                       @bind="ParamSearchTerm"
                                       @bind:event="oninput" />
                                <button class="btn @(ParamCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => ParamCaseSensitive = !ParamCaseSensitive">
                                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                </button>
                                <button class="btn @(ParamMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { ParamMatchWholeWord = !ParamMatchWholeWord; if (ParamMatchWholeWord) ParamExactMatch = false; }">
                                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                </button>
                                <button class="btn @(ParamExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { ParamExactMatch = !ParamExactMatch; if (ParamExactMatch) ParamMatchWholeWord = false; }">
                                    <i class="bi bi-bullseye fs-6"></i>
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive custom-scrollbar-light">
                            <table class="table table-dark table-hover align-middle border-secondary mb-0">
                                <thead>
                                    <tr>
                                        <th class="border-secondary text-muted fw-normal">Parameter Name</th>
                                        <th class="border-secondary text-muted fw-normal">Default Value</th>
                                        <th class="border-secondary text-muted fw-normal text-end">Data Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (VisibleParams.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center py-4 text-muted">No matching parameters found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var p in VisibleParams)
                                        {
                                            <tr>
                                                <td class="border-secondary fw-medium align-middle">
                                                    @p.Name
                                                    @if (p.IsOutput)
                                                    {
                                                        <span class="badge bg-warning text-dark border border-warning ms-2 align-middle fw-normal" style="font-size: 0.5em;">OUTPUT</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-dark border border-secondary text-muted ms-2 align-middle fw-normal" style="font-size: 0.5em;">INPUT</span>
                                                    }
                                                </td>
                                                <td class="border-secondary">
                                                    @if (p.HasDefault)
                                                    {
                                                        <span class="font-monospace text-success" style="font-size: 0.85em;">@p.DefaultValue</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic small">none</span>
                                                    }
                                                </td>
                                                <td class="border-secondary text-end">
                                                    <span class="badge bg-dark text-muted border border-secondary font-monospace" style="font-size: 0.85em;">
                                                        @p.DisplayType
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "Dependencies")
            {
                <div class="text-white mt-1">
                    <div class="mb-4 d-flex justify-content-start">
                        <div class="input-group shadow-sm w-50">
                            <input type="text"
                                   class="form-control bg-dark text-white border-secondary shadow-none"
                                   placeholder="Search dependencies..."
                                   @bind="DependencySearchTerm"
                                   @bind:event="oninput" />
                            <button class="btn @(DependencySearchCaseSensitive ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Case" @onclick="() => DependencySearchCaseSensitive = !DependencySearchCaseSensitive">
                                <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                            </button>
                            <button class="btn @(DependencySearchMatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Match Whole Word" @onclick="() => { DependencySearchMatchWholeWord = !DependencySearchMatchWholeWord; if (DependencySearchMatchWholeWord) DependencySearchExactMatch = false; }">
                                <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                            </button>
                            <button class="btn @(DependencySearchExactMatch ? "btn-primary" : "btn-outline-secondary bg-dark text-muted") border-secondary px-3" style="z-index: 0;" title="Exact Match" @onclick="() => { DependencySearchExactMatch = !DependencySearchExactMatch; if (DependencySearchExactMatch) DependencySearchMatchWholeWord = false; }">
                                <i class="bi bi-bullseye fs-6"></i>
                            </button>
                        </div>
                    </div>
                    @if (Sp.Dependencies.Count == 0)
                    {
                        <div class="card glass-card border-secondary text-center py-5">
                            <div class="text-muted small fst-italic">No resolvable dependencies found.</div>
                            <div class="mt-2">
                                <small class="text-secondary">This can happen with cross-database references, dynamic SQL, or system procedures.</small>
                            </div>
                        </div>
                    }
                    else if (!FilteredDependencies.Any())
                    {
                        <div class="text-muted p-4 text-center">No matching dependencies found.</div>
                    }
                    else
                    {
                        <div class="mt-2 mb-4">
                            <div class="row g-3">
                                @foreach (var dep in FilteredDependencies)
                                {
                                    <div class="col-md-6 col-12">
                                        <a href="@BuildDependencyLink(dep)" class="card text-decoration-none h-100 hover-scale transition-transform" style="background-color: #2b3035; border: 1px solid rgba(255, 255, 255, 0.1);">
                                            <div class="card-body py-3 px-4 d-flex align-items-center gap-3">
                                                <div class="@(dep.Type == "Table" ? "text-primary" : "text-success") fw-bold fs-4">
                                                    <i class="bi @(dep.Type == "Table" ? "bi-table" : "bi-layout-text-window")"></i>
                                                </div>
                                                <div class="overflow-hidden" style="min-width: 0;">
                                                    <div class="text-white fw-bold text-truncate" style="font-size: 0.95em;">@dep.Name</div>
                                                    <div class="text-muted" style="font-size: 0.7em; letter-spacing: 0.5px;">SCHEMA: <span class="text-lowercase">@dep.Schema</span></div>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else if (ActiveTab == "Execution")
            {
                <div class="card glass-card text-white">
                    <div class="card-body p-0 position-relative">
                        <div class="p-3 d-flex justify-content-between align-items-center border-bottom border-secondary bg-dark bg-opacity-50">
                            <div>
                                <span class="fw-bold">EXECUTE Statement</span>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm @(Copied ? "btn-success" : "btn-outline-light")"
                                        @onclick="CopyExecStatement"
                                        title="Copy to clipboard">
                                    <i class="bi @(Copied ? "bi-check2" : "bi-clipboard")"></i> @(Copied ? "Copied" : "Copy")
                                </button>
                                <a href="/runner?type=sp&name=@Uri.EscapeDataString(Sp.FullName)" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-play-fill"></i> Run
                                </a>
                            </div>
                        </div>
                        <div class="p-4" style="background: rgba(0, 0, 0, 0.3);">
                            <pre class="m-0 text-success query-preview" style="background: transparent; border: none; font-size: 0.85em;">@ExecStatement</pre>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string FullName { get; set; } = string.Empty;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private SpInfo? Sp;
    private bool Copied = false;
    private string ActiveTab = "Parameters";
    
    // Parameter Search State
    private string _paramSearchTerm = "";
    private string ParamSearchTerm
    {
        get => _paramSearchTerm;
        set
        {
            if (_paramSearchTerm != value)
            {
                _paramSearchTerm = value;
                FilterParams();
            }
        }
    }

    private bool _paramCaseSensitive = false;
    private bool ParamCaseSensitive
    {
        get => _paramCaseSensitive;
        set { _paramCaseSensitive = value; FilterParams(); }
    }

    private bool _paramMatchWholeWord = false;
    private bool ParamMatchWholeWord
    {
        get => _paramMatchWholeWord;
        set { _paramMatchWholeWord = value; FilterParams(); }
    }

    private bool _paramExactMatch = false;
    private bool ParamExactMatch
    {
        get => _paramExactMatch;
        set { _paramExactMatch = value; FilterParams(); }
    }

    private List<SpParameter> VisibleParams = new();

    private string DependencySearchTerm = string.Empty;
    private bool DependencySearchCaseSensitive = false;
    private bool DependencySearchMatchWholeWord = false;
    private bool DependencySearchExactMatch = false;

    private IEnumerable<Dependency> FilteredDependencies
    {
        get
        {
            if (Sp == null) return Array.Empty<Dependency>();
            
            var deps = Sp.Dependencies.OrderBy(d => d.Type).ThenBy(d => d.Name);
            if (string.IsNullOrWhiteSpace(DependencySearchTerm)) return deps;
            
            var searchStr = DependencySearchCaseSensitive ? DependencySearchTerm : DependencySearchTerm.ToLowerInvariant();
            
            return deps.Where(d => 
            {
                var nameVal = DependencySearchCaseSensitive ? d.Name : d.Name.ToLowerInvariant();
                var schemaVal = DependencySearchCaseSensitive ? d.Schema : d.Schema.ToLowerInvariant();
                
                if (DependencySearchExactMatch) 
                    return nameVal == searchStr || schemaVal == searchStr;
                if (DependencySearchMatchWholeWord) 
                    return nameVal.Split('_', '-', '.').Contains(searchStr) || schemaVal.Split('_', '-', '.').Contains(searchStr);
                    
                return nameVal.Contains(searchStr) || schemaVal.Contains(searchStr);
            });
        }
    }

    protected override void OnParametersSet()
    {
        var decoded = Uri.UnescapeDataString(FullName);
        Sp = SchemaService.StoredProcedures.FirstOrDefault(s => s.FullName == decoded);
        Copied = false;
        
        ActiveTab = "Parameters";

        if (Sp != null)
        {
            FilterParams();
        }
    }

    private void FilterParams()
    {
        if (Sp == null) return;
        
        if (string.IsNullOrWhiteSpace(ParamSearchTerm))
        {
            VisibleParams = Sp.Parameters.ToList();
            return;
        }

        var comparison = ParamCaseSensitive ? StringComparison.Ordinal : StringComparison.OrdinalIgnoreCase;
        var query = ParamSearchTerm.Trim();

        VisibleParams = Sp.Parameters.Where(p =>
        {
            if (ParamExactMatch)
            {
                return p.Name.Equals(query, comparison);
            }
            if (ParamMatchWholeWord)
            {
                var regexOpts = ParamCaseSensitive ? RegexOptions.None : RegexOptions.IgnoreCase;
                return Regex.IsMatch(p.Name, $@"\b{Regex.Escape(query)}\b", regexOpts);
            }

            return p.Name.Contains(query, comparison);
        }).ToList();
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }

    private void NavigateBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }

        Navigation.NavigateTo("/procs");
    }

    private string BuildDependencyLink(Dependency dependency)
    {
        var prefix = dependency.Type == "View" ? "/view" : "/table";
        var currentRoute = Navigation.ToBaseRelativePath(Navigation.Uri);
        var baseLink = $"{prefix}/{Uri.EscapeDataString(dependency.FullName)}";

        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return baseLink;
        }

        return $"{baseLink}?returnUrl={Uri.EscapeDataString(currentRoute)}";
    }

    private string ExecStatement
    {
        get
        {
            if (Sp == null) return string.Empty;

            if (Sp.Parameters.Count == 0)
                return $"EXEC {Sp.FullName};";

            var lines = new System.Text.StringBuilder();
            lines.AppendLine($"EXEC {Sp.FullName}");

            var outputParams = Sp.Parameters.Where(p => p.IsOutput).ToList();

            foreach (var p in outputParams)
            {
                lines.AppendLine($"    -- DECLARE {p.Name} {p.DisplayType};");
            }

            if (outputParams.Any())
            {
                lines.AppendLine();
            }

            var allParams = Sp.Parameters.ToList();
            for (int i = 0; i < allParams.Count; i++)
            {
                var p = allParams[i];
                var isLast = i == allParams.Count - 1;
                var comma = isLast ? "" : ",";

                string placeholder;
                if (p.IsOutput)
                    placeholder = $"{p.Name} OUTPUT";
                else if (p.HasDefault && p.DefaultValue != null)
                    placeholder = $"{p.Name} = {p.DefaultValue}";
                else
                    placeholder = $"{p.Name} = NULL  -- {p.DisplayType}";

                lines.AppendLine($"    {placeholder}{comma}");
            }

            return lines.ToString().TrimEnd();
        }
    }

    private async Task CopyExecStatement()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", ExecStatement);
        Copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        Copied = false;
        StateHasChanged();
    }
}
