@page "/builder"
@using ExploreDB.Services
@inject SchemaService SchemaService
@inject PathfinderService PathfinderService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject QueryStateService QueryStateService
@implements IDisposable

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-white mb-0">Query Builder</h2>

            </div>
            <div class="btn-group shadow-sm">
                <button class="btn @(CurrentMode == QueryMode.Select ? "btn-primary" : "btn-dark border-secondary text-light")" @onclick="() => SetMode(QueryMode.Select)">SELECT</button>
                <button class="btn @(CurrentMode == QueryMode.Update ? "btn-primary" : "btn-dark border-secondary text-light")" @onclick="() => SetMode(QueryMode.Update)">UPDATE</button>
                <button class="btn @(CurrentMode == QueryMode.Delete ? "btn-primary" : "btn-dark border-secondary text-light")" @onclick="() => SetMode(QueryMode.Delete)">DELETE</button>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Column Picker -->
        <div class="col-md-4 d-flex flex-column gap-4">
            <div class="card bg-dark border-secondary shadow-sm d-flex flex-column" style="flex: 1; min-height: 0;">
                <div class="card-header border-secondary p-2" style="position: sticky; top: 0; z-index: 30; background: inherit;">
                    <div class="row g-2">
                        @if (CurrentMode != QueryMode.Select)
                        {
                            <div class="col-12 mb-2">
                                <label class="small text-warning fw-bold mb-1">Target Table (To @CurrentMode)</label>
                                <div class="position-relative w-100">
                                    <div class="form-control form-control-sm bg-black text-white border-warning position-relative cursor-pointer" @onclick="() => IsTargetTableDropdownOpen = !IsTargetTableDropdownOpen">
                                        <span>@(string.IsNullOrEmpty(TargetTable) ? "Select Target Table..." : TargetTable)</span>
                                        <div class="position-absolute h-100 d-flex align-items-center" style="right: 12px; top: 0; pointer-events: none;">
                                            <i class="bi bi-chevron-down text-muted" style="font-size: 0.85rem;"></i>
                                        </div>
                                    </div>
                                    @if (IsTargetTableDropdownOpen)
                                    {
                                        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsTargetTableDropdownOpen = false"></div>
                                        <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-1 mt-1 custom-scrollbar-light" style="position: absolute; top: 100%; left: 0; z-index: 1050; max-height: 250px; overflow-y: auto;">
                                            <div class="p-1 mb-1">
                                                <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="Search tables..." @bind="TargetTableSearch" @bind:event="oninput" @onclick:stopPropagation />
                                            </div>
                                            @foreach (var table in SchemaService.Tables.Where(t => string.IsNullOrEmpty(TargetTableSearch) || t.Name.Contains(TargetTableSearch, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <button class="dropdown-item text-white py-1 @(TargetTable == table.FullName ? "bg-primary" : "")" type="button" @onclick="() => SelectTargetTable(table.FullName)">
                                                    @table.Name
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <hr class="border-secondary mt-1 mb-2 opacity-50"/>
                            <label class="small text-info fw-bold mb-1">Source/Filter Tables (To JOIN)</label>
                        }
                        <div class="col-12 d-flex flex-column gap-2 position-relative">
                            <div class="input-group input-group-sm shadow-sm">
                                <input type="text" class="form-control bg-black text-white border-secondary" 
                                       placeholder="Search..." @bind="SearchCol" @bind:event="oninput" />
                                <button class="btn @(CaseSensitive ? "btn-primary" : "btn-outline-secondary bg-black text-muted") border-secondary px-2" style="z-index: 0;" title="Match Case" @onclick="() => CaseSensitive = !CaseSensitive">
                                    <span style="font-family: Georgia, serif; font-weight: bold; font-size: 0.9em; letter-spacing: 0.5px;">Aa</span>
                                </button>
                                <button class="btn @(MatchWholeWord ? "btn-primary" : "btn-outline-secondary bg-black text-muted") border-secondary px-2" style="z-index: 0;" title="Match Whole Word" @onclick="() => { MatchWholeWord = !MatchWholeWord; if (MatchWholeWord) ExactMatch = false; }">
                                    <span style="font-family: monospace; font-weight: bold; font-size: 0.9em;">[ab]</span>
                                </button>
                                <button class="btn @(ExactMatch ? "btn-primary" : "btn-outline-secondary bg-black text-muted") border-secondary px-2" style="z-index: 0;" title="Exact Match" @onclick="() => { ExactMatch = !ExactMatch; if (ExactMatch) MatchWholeWord = false; }">
                                    <i class="bi bi-bullseye"></i>
                                </button>
                            </div>
                            
                            <div class="position-relative w-100 mt-1">
                                <div class="form-control form-control-sm bg-black text-white border-secondary position-relative cursor-pointer" @onclick="() => IsScopeDropdownOpen = !IsScopeDropdownOpen">
                                    <span>@(SearchFilter == "All" ? "Tables & Columns" : SearchFilter == "Table" ? "Tables Only" : "Columns Only")</span>
                                    <div class="position-absolute h-100 d-flex align-items-center" style="right: 12px; top: 0; pointer-events: none;">
                                        <i class="bi bi-chevron-down text-muted" style="font-size: 0.85rem;"></i>
                                    </div>
                                </div>
                                @if (IsScopeDropdownOpen)
                                {
                                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 1040;" @onclick="() => IsScopeDropdownOpen = false"></div>
                                    <div class="dropdown-menu show w-100 bg-dark border-secondary shadow-lg p-1 mt-1 custom-scrollbar-light" style="position: absolute; top: 100%; left: 0; z-index: 1050;">
                                        <button class="dropdown-item text-white @(SearchFilter == "All" ? "bg-primary" : "") py-2" type="button" @onclick='() => { SearchFilter = "All"; IsScopeDropdownOpen = false; }'>Tables & Columns</button>
                                        <button class="dropdown-item text-white @(SearchFilter == "Table" ? "bg-primary" : "") py-2" type="button" @onclick='() => { SearchFilter = "Table"; IsScopeDropdownOpen = false; }'>Tables Only</button>
                                        <button class="dropdown-item text-white @(SearchFilter == "Column" ? "bg-primary" : "") py-2" type="button" @onclick='() => { SearchFilter = "Column"; IsScopeDropdownOpen = false; }'>Columns Only</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div style="overflow-y: auto; max-height: 600px; flex: 1;">
                    <div class="card-body p-0">
                        @if (SchemaService.Tables.Count == 0)
                        {
                            <div class="p-3 text-center text-muted">Connect to a database to start.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var table in FilteredTables)
                                {
                                    var matchingColumns = table.Columns.Where(c => SearchMatch(table.Name, c.Name)).ToList();
                                    @if (matchingColumns.Any())
                                    {
                                        <div class="list-group-item bg-transparent text-light border-secondary">
                                            <div class="d-flex align-items-center gap-2">
                                                <input class="form-check-input mt-0"
                                                       type="checkbox"
                                                       id="@GetTableCheckboxId(table)"
                                                       checked="@AreAllColumnsSelected(table)"
                                                       @onchange="(e) => ToggleTableColumns(table, e.Value is true)" />
                                                <label class="small fw-bold text-uppercase cursor-pointer mb-0" style="color: #6ea8fe;" for="@GetTableCheckboxId(table)">
                                                    @table.Name
                                                </label>
                                            </div>
                                            @foreach(var col in matchingColumns)
                                            {
                                                var key = GetColumnKey(table, col.Name);
                                                var isSelected = SelectedColumns.Contains(key);
                                                <div class="form-check mt-1">
                                                    <input class="form-check-input" type="checkbox" id="@key" 
                                                           checked="@isSelected" 
                                                           @onchange="(e) => ToggleColumn(key, table.FullName, e.Value is true)" />
                                                    <label class="form-check-label small text-break cursor-pointer" for="@key">
                                                        @col.Name
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Selected Columns Box -->
            <div class="card bg-dark border-secondary shadow-sm d-flex flex-column" style="flex: 1; min-height: 0;">
                <div class="card-header border-secondary d-flex justify-content-between align-items-center" style="position: sticky; top: 0; z-index: 20; background: inherit;">
                    <span class="fw-bold">Selected Tables &amp; Columns</span>
                    <button class="btn btn-sm btn-outline-warning" @onclick="ClearAll">
                        Clear All
                    </button>
                </div>
                <div class="card-body p-0 bg-black" style="overflow-y: auto; flex: 1;">
                    @if (SelectedColumns.Count == 0)
                    {
                        <div class="p-4 text-center text-muted mt-3 mb-3">Select columns from the left to start building your query.</div>
                    }
                    else
                    {
                        <div class="p-3 d-flex flex-column gap-3">
                            @{ var uniqueTables = SelectedColumns.Select(k => k.Substring(0, k.LastIndexOf('.'))).Distinct().ToList(); }
                            @foreach (var group in SelectedColumns.GroupBy(k => k.Substring(0, k.LastIndexOf('.'))))
                            {
                                var table = group.Key;
                                var isFirst = table == uniqueTables.First();
                                var isLast = table == uniqueTables.Last();
                                
                                <div class="border rounded p-3 mb-3 border-secondary" style="background-color: #1a1d20; transition: all 0.2s;">
                                    <div class="text-info fw-bold mb-3 pb-2 border-bottom border-secondary">
                                        <div class="text-break mb-2" style="font-size: 1.1rem; word-break: break-all;">@table</div>
                                        <div class="d-flex gap-2">
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" title="Move Up" disabled="@isFirst" @onclick="() => MoveTable(table, -1)">
                                                    Up
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary py-0 px-2" title="Move Down" disabled="@isLast" @onclick="() => MoveTable(table, 1)">
                                                    Down
                                                </button>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger py-0 px-2" 
                                                    title="Remove Table"
                                                    @onclick="() => RemoveTable(table)">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var key in group)
                                        {
                                            var col = key.Substring(key.LastIndexOf('.') + 1);
                                            <span class="badge bg-secondary d-flex align-items-center gap-2 p-2 border border-secondary text-wrap text-break text-start" style="font-size: 0.9rem; max-width: 100%;">
                                                <span class="flex-grow-1">@col</span>
                                                <button type="button" class="btn-close btn-close-white flex-shrink-0" style="font-size: 0.5rem;" aria-label="Remove"
                                                        @onclick="() => ToggleColumn(key, table, false)"></button>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Result Area -->
        <div class="col-md-8 d-flex flex-column gap-4">
                @if (CurrentMode == QueryMode.Update && !string.IsNullOrEmpty(TargetTable))
                {
                    <div class="card bg-dark border-secondary shadow-sm">
                        <div class="card-header border-secondary fw-bold text-warning d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-sliders pe-1"></i> Update Column Mapping</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearMappings">Reset Mappings</button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive custom-scrollbar-light" style="max-height: 400px;">
                                <table class="table table-dark table-hover mb-0 align-middle">
                                    <thead style="position: sticky; top: 0; z-index: 10;">
                                        <tr>
                                            <th class="border-secondary bg-dark text-muted fw-normal" style="width: 40%;">Target Column (@TargetTable)</th>
                                            <th class="border-secondary bg-dark text-muted fw-normal" style="width: 10%;"></th>
                                            <th class="border-secondary bg-dark text-muted fw-normal" style="width: 50%;">Source Value / Mapped Column</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var col in SchemaService.Tables.FirstOrDefault(t => t.FullName == TargetTable)?.Columns ?? new List<ColumnInfo>())
                                        {
                                            var targetColName = col.Name;
                                            UpdateMappings.TryGetValue(targetColName, out var mappedValue);
                                            <tr>
                                                <td class="border-secondary font-monospace small">@targetColName</td>
                                                <td class="border-secondary text-center text-muted"><i class="bi bi-arrow-right"></i></td>
                                                <td class="border-secondary">
                                                    <select class="form-select form-select-sm bg-black text-white border-secondary" 
                                                            value="@mappedValue" 
                                                            @onchange="(e) => MapColumn(targetColName, e.Value?.ToString())">
                                                        <option value="">-- Leave Unchanged --</option>
                                                        <optgroup label="Custom Value">
                                                            <option value="@($"@set_{targetColName}")">Parameter (@($"@set_{targetColName}"))</option>
                                                        </optgroup>
                                                        @if (SelectedColumns.Count > 0)
                                                        {
                                                            <optgroup label="Source Columns (From Selection)">
                                                                @foreach (var sc in SelectedColumns)
                                                                {
                                                                    <option value="@sc">@sc</option>
                                                                }
                                                            </optgroup>
                                                        }
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

             <!-- Generated SQL Box -->
             <div class="card bg-dark border-secondary shadow-sm" style="flex: 1;">
                 <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                     <span class="fw-bold">Generated SQL</span>
                     <div class="d-flex gap-2">
                         <button class="btn btn-sm btn-primary" @onclick="RunInRunner" disabled="@(SelectedColumns.Count == 0)">
                             <i class="bi bi-play-fill"></i> Run
                         </button>
                         <button class="btn btn-sm @(CopyLabel == "Copied! ✓" ? "btn-success" : "btn-outline-secondary")" @onclick="CopySql" title="Copy to clipboard">
                             @CopyLabel
                         </button>
                     </div>
                 </div>
                 <div class="card-body p-0 bg-black">
                     <textarea class="form-control bg-black text-success border-0 font-monospace p-3" 
                               style="resize: vertical; min-height: 400px;" readonly>@GeneratedSql</textarea>
                 </div>
                 @if (HasOneToMany)
                 {
                     <div class="card-footer bg-dark border-secondary p-3">
                         <div class="alert alert-warning mb-0 border-0 shadow-sm" style="background-color: rgba(255, 193, 7, 0.1); color: #ffeb3b;">
                             <h6 class="alert-heading fw-bold mb-2">
                                 <span style="font-size: 1.1rem;">⚠️</span> One-to-Many Join Detected
                             </h6>
                             <p class="small mb-2 text-light text-opacity-75">
                                 Rows may multiply because multiple matching child rows exist for a single parent row. <br/>
                                 A <code>SELECT DISTINCT</code> has been applied automatically to suppress exact duplicates.
                             </p>
                             <hr class="border-secondary opacity-25 my-2">
                             @if (OptimalTableOrder != null)
                             {
                                 <div class="mt-3 p-3 rounded" style="background-color: rgba(40, 167, 69, 0.1); border: 1px solid rgba(40, 167, 69, 0.3);">
                                     <div class="d-flex justify-content-between align-items-center">
                                         <div>
                                             <h6 class="fw-bold text-success mb-1">✨ Optimal Join Order Available</h6>
                                             <p class="small text-light text-opacity-75 mb-0">
                                                 Start from the most granular table to avoid row duplication entirely:
                                             </p>
                                             <div class="font-monospace small mt-2 text-warning">
                                                 @string.Join(" ➔ ", OptimalTableOrder.Select(t => t.Replace("[", "").Replace("]", "")))
                                             </div>
                                         </div>
                                         <button class="btn btn-sm btn-success" @onclick="ApplyOptimalOrder">Update Order</button>
                                     </div>
                                 </div>
                             }
                             else
                             {
                                 <div class="mt-3 p-3 rounded" style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.3);">
                                     <h6 class="fw-bold text-danger mb-1">❌ Unavoidable Duplication (Cartesian Product)</h6>
                                     <p class="small text-light text-opacity-75 mb-0">
                                         I checked all possible join sequences, but the tables you've selected contain multiple parallel child paths (siblings). Reordering the tables cannot prevent duplication here.
                                     </p>
                                 </div>
                                 <hr class="border-secondary opacity-25 my-3">
                                 <p class="small mb-1 fw-bold text-warning">💡 Suggestions to resolve this:</p>
                                 <ul class="small mb-0 text-light text-opacity-75 ps-4">
                                     <li><strong>Filter Data:</strong> Add a <code>WHERE</code> clause to target specific records.</li>
                                     <li><strong>Aggregate:</strong> Use aggregate functions (<code>MAX()</code>, <code>SUM()</code>, <code>COUNT()</code>) and <code>GROUP BY</code>.</li>
                                     <li><strong>Top Match:</strong> Rewrite the join to fetch only the first match (e.g., using <code>OUTER APPLY (SELECT TOP 1 ...)</code>).</li>
                                 </ul>
                             }
                         </div>
                     </div>
                 }
                 <div class="card-footer bg-dark border-secondary p-3 border-top-0 border-top mt-2">
                     <h6 class="text-info fw-bold mb-3"><i class="bi bi-diagram-3 pe-1"></i> Join Path Routing</h6>
                     @if (LastJoinPlan != null && LastJoinPlan.Steps.Count > 0)
                     {
                         <div class="d-flex flex-wrap gap-2 align-items-center small mb-3">
                             <span class="badge bg-primary border border-primary px-2 py-1 fs-6">@LastJoinPlan.RootTable</span>
                             @foreach (var step in LastJoinPlan.Steps)
                             {
                                 <span class="text-secondary fw-bold fs-5">➔</span>
                                 var isIgnored = IgnoredRoutingTables.Contains(step.FullName);
                                 <div class="btn-group btn-group-sm shadow-sm">
                                     <span class="btn btn-dark border-secondary disabled py-1 text-light fw-bold" style="opacity: 1;">
                                         @step.FullName
                                     </span>
                                     @if (!step.IsSelectedTable)
                                     {
                                         <button type="button" class="btn py-1 btn-outline-danger border-secondary" title="Block routing through this table" @onclick="() => ToggleIgnoreRoutingTable(step.FullName)">
                                             Block <i class="bi bi-slash-circle ps-1"></i>
                                         </button>
                                     }
                                 </div>
                             }
                         </div>
                     }
                     else if (SelectedColumns.Count > 0)
                     {
                         <span class="text-muted small mb-3 d-block">Select multiple tables to see the discovered routing path.</span>
                     }
                     else
                     {
                         <span class="text-muted small mb-3 d-block">No routing path generated yet.</span>
                     }

                     @if (IgnoredRoutingTables.Count > 0)
                     {
                         <div class="p-2 rounded" style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid rgba(220, 53, 69, 0.3);">
                             <div class="text-danger small fw-bold mb-2">Blocked Hubs (Algorithm will route around these):</div>
                             <div class="d-flex flex-wrap gap-2">
                                 @foreach(var ignored in IgnoredRoutingTables)
                                 {
                                     <span class="badge bg-danger d-flex align-items-center gap-2 p-2 border border-danger text-wrap text-start" style="font-size: 0.85rem; max-width: 100%;">
                                         <span class="flex-grow-1">@ignored</span>
                                         <button type="button" class="btn-close btn-close-white flex-shrink-0" style="font-size: 0.5rem;" aria-label="Remove" @onclick="() => ToggleIgnoreRoutingTable(ignored)"></button>
                                     </span>
                                 }
                             </div>
                         </div>
                     }
                 </div>
             </div>
        </div>
    </div>
</div>

@code {
    private string SearchCol = "";
    private string SearchFilter = "All";
    private bool ExactMatch = false;
    private bool MatchWholeWord = false;
    private bool CaseSensitive = false;
    public enum QueryMode { Select, Update, Delete }
    private QueryMode CurrentMode = QueryMode.Select;
    private string? TargetTable;
    private Dictionary<string, string?> UpdateMappings = new();
    private bool IsTargetTableDropdownOpen = false;
    private string TargetTableSearch = "";
    
    private bool IsScopeDropdownOpen = false;
    
    // List (not HashSet) preserves insertion order — first selected table becomes the JOIN root
    private List<string> SelectedColumns = new();
    private string GeneratedSql = "-- Select columns on the left to generate a query.";
    private bool HasOneToMany = false;
    private List<string>? OptimalTableOrder = null;
    private HashSet<string> IgnoredRoutingTables = new(StringComparer.OrdinalIgnoreCase);
    private PathfinderJoinPlan? LastJoinPlan;

    private IEnumerable<TableInfo> FilteredTables => SchemaService.Tables; // We filter columns inside

    protected override void OnInitialized()
    {
        SchemaService.OnSchemaLoaded += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool SearchMatch(string tableName, string colName)
    {
        if (string.IsNullOrWhiteSpace(SearchCol)) return true;

        var searchTerm = CaseSensitive ? SearchCol : SearchCol.ToLower();
        var tableToSearch = CaseSensitive ? tableName : tableName.ToLower();
        var colToSearch = CaseSensitive ? colName : colName.ToLower();

        bool tableMatches = false;
        bool colMatches = false;

        if (ExactMatch)
        {
            // Exact match: entire name must match search term
            tableMatches = tableToSearch == searchTerm;
            colMatches = colToSearch == searchTerm;
        }
        else if (MatchWholeWord)
        {
            tableMatches = tableToSearch.Split(' ', '.', '_').Contains(searchTerm);
            colMatches = colToSearch.Split(' ', '.', '_').Contains(searchTerm);
        }
        else
        {
            tableMatches = tableToSearch.Contains(searchTerm);
            colMatches = colToSearch.Contains(searchTerm);
        }

        return SearchFilter switch
        {
            "Table" => tableMatches,
            "Column" => colMatches,
            _ => tableMatches || colMatches
        };
    }

    private void ToggleColumn(string key, string tableName, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedColumns.Contains(key))
                SelectedColumns.Add(key);
        }
        else
        {
            SelectedColumns.Remove(key);
        }

        Generate();
    }

    private void ToggleTableColumns(TableInfo table, bool shouldSelect)
    {
        var keys = table.Columns
            .Select(col => GetColumnKey(table, col.Name))
            .ToList();

        if (shouldSelect)
        {
            foreach (var key in keys)
            {
                if (!SelectedColumns.Contains(key))
                    SelectedColumns.Add(key);
            }
        }
        else
        {
            var keySet = keys.ToHashSet();
            SelectedColumns.RemoveAll(keySet.Contains);
        }

        Generate();
    }

    private bool AreAllColumnsSelected(TableInfo table)
    {
        return table.Columns.Count > 0 &&
               table.Columns.All(col => SelectedColumns.Contains(GetColumnKey(table, col.Name)));
    }

    private string GetColumnKey(TableInfo table, string columnName)
    {
        return $"{table.FullName}.{columnName}";
    }

    private string GetTableCheckboxId(TableInfo table)
    {
        return $"table-{table.Schema}-{table.Name}"
            .Replace("[", "")
            .Replace("]", "")
            .Replace(".", "-")
            .Replace(" ", "-");
    }

    private void Generate()
    {
        OptimalTableOrder = null;

        if (CurrentMode == QueryMode.Select && SelectedColumns.Count == 0)
        {
            GeneratedSql = "-- Select columns on the left to generate a query.";
            HasOneToMany = false;
            LastJoinPlan = null;
            return;
        }
        else if (CurrentMode != QueryMode.Select && string.IsNullOrEmpty(TargetTable))
        {
            GeneratedSql = $"-- Select a Target Table to generate an {CurrentMode.ToString().ToUpper()} query.";
            HasOneToMany = false;
            LastJoinPlan = null;
            return;
        }

        var tables = SelectedColumns
            .Select(k => k.Substring(0, k.LastIndexOf('.')))
            .Distinct()
            .ToList();

        if (CurrentMode != QueryMode.Select && !string.IsNullOrEmpty(TargetTable))
        {
            if (!tables.Contains(TargetTable))
            {
                tables.Insert(0, TargetTable);
            }
            else
            {
                tables.Remove(TargetTable);
                tables.Insert(0, TargetTable);
            }
        }

        if (CurrentMode == QueryMode.Select)
        {
            var result = PathfinderService.GenerateQuery(tables, SelectedColumns.ToList(), IgnoredRoutingTables);
            GeneratedSql = result.Sql;
            HasOneToMany = result.HasOneToMany;
            LastJoinPlan = result.JoinPlan;

            if (HasOneToMany && tables.Count > 1)
            {
                foreach (var candidate in tables.Skip(1))
                {
                    var testOrder = new List<string> { candidate };
                    testOrder.AddRange(tables.Where(t => t != candidate));

                    var plan = PathfinderService.GenerateJoinPlan(testOrder);
                    if (plan != null && string.IsNullOrEmpty(plan.ErrorMessage) && !plan.HasOneToMany && plan.UnreachableTables.Count == 0)
                    {
                        OptimalTableOrder = plan.Steps.Select(s => s.FullName).ToList();
                        OptimalTableOrder.Insert(0, plan.RootTable);
                        break;
                    }
                }
            }
        }
        else if (CurrentMode == QueryMode.Update)
        {
            var plan = PathfinderService.GenerateJoinPlan(tables, TargetTable, "t", "j");
            var result = PathfinderService.GenerateJoinedUpdateQuery(plan, UpdateMappings);
            GeneratedSql = result.Sql;
            HasOneToMany = result.HasOneToMany;
            LastJoinPlan = plan;
        }
        else if (CurrentMode == QueryMode.Delete)
        {
            var plan = PathfinderService.GenerateJoinPlan(tables, TargetTable, "t", "j");
            var result = PathfinderService.GenerateJoinedDeleteQuery(plan);
            GeneratedSql = result.Sql;
            HasOneToMany = result.HasOneToMany;
            LastJoinPlan = plan;
        }
    }

    private void SetMode(QueryMode mode)
    {
        CurrentMode = mode;
        Generate();
    }

    private void SelectTargetTable(string table)
    {
        TargetTable = table;
        IsTargetTableDropdownOpen = false;
        UpdateMappings.Clear();
        Generate();
    }

    private void ClearMappings()
    {
        UpdateMappings.Clear();
        Generate();
    }

    private void MapColumn(string targetCol, string? sourceCol)
    {
        if (string.IsNullOrEmpty(sourceCol))
        {
            UpdateMappings.Remove(targetCol);
        }
        else
        {
            UpdateMappings[targetCol] = sourceCol;
        }
        Generate();
    }

    private void ApplyOptimalOrder()
    {
        if (OptimalTableOrder == null) return;

        var newSelectedColumns = new List<string>();
        foreach (var table in OptimalTableOrder)
        {
            newSelectedColumns.AddRange(SelectedColumns.Where(c => c.StartsWith(table + ".")));
        }
        
        newSelectedColumns.AddRange(SelectedColumns.Where(c => !newSelectedColumns.Contains(c)));

        SelectedColumns = newSelectedColumns;
        Generate();
    }

    private void RemoveTable(string tableName)
    {
        SelectedColumns.RemoveAll(c => c.StartsWith(tableName + "."));
        Generate();
    }

    private void ClearAll()
    {
        SelectedColumns.Clear();
        GeneratedSql = "-- Select columns on the left to generate a query.";
        HasOneToMany = false;
        LastJoinPlan = null;
        StateHasChanged();
    }

    private void ToggleIgnoreRoutingTable(string tableName)
    {
        if (!IgnoredRoutingTables.Add(tableName))
        {
            IgnoredRoutingTables.Remove(tableName);
        }
        Generate();
    }

    private string CopyLabel = "Copy";

    private void RunInRunner()
    {
        QueryStateService.CustomQuery = GeneratedSql;
        Navigation.NavigateTo("/?type=custom");
    }

    private async Task CopySql()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", GeneratedSql);
        CopyLabel = "Copied! ✓";
        StateHasChanged();
        await Task.Delay(1500);
        CopyLabel = "Copy";
        StateHasChanged();
    }

    public void Dispose()
    {
        SchemaService.OnSchemaLoaded -= Refresh;
    }

    private void MoveTable(string table, int direction)
    {
        var tables = SelectedColumns
            .Select(k => k.Substring(0, k.LastIndexOf('.')))
            .Distinct()
            .ToList();
            
        int index = tables.IndexOf(table);
        if (index < 0) return;
        
        int newIndex = index + direction;
        if (newIndex < 0 || newIndex >= tables.Count) return;
        
        tables.RemoveAt(index);
        tables.Insert(newIndex, table);
        
        var newSelectedColumns = new List<string>();
        foreach (var t in tables)
        {
            newSelectedColumns.AddRange(SelectedColumns.Where(c => c.StartsWith(t + ".")));
        }
        
        SelectedColumns = newSelectedColumns;
        Generate();
    }
}
