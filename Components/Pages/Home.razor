@page "/"
@using DbExplore.Services
@inject SchemaService SchemaService
@inject PathfinderService PathfinderService
@inject IJSRuntime JS
@implements IDisposable

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold mb-0">
                <span style="font-size: 2rem;">⚡</span> Pathfinder <span class="text-primary">Auto-Join</span>
            </h2>
            <p class="text-secondary small">Select columns from different tables, and I'll discover the JOIN path for you.</p>
        </div>
    </div>

    <div class="row">
        <!-- Column Picker -->
        <div class="col-md-4">
            <div class="card bg-dark border-secondary shadow-sm" style="height: 100%;">
                <div class="card-header border-secondary p-2" style="position: sticky; top: 0; z-index: 20; background: inherit;">
                    <div class="row g-2">
                        <div class="col-12">
                            <input type="text" class="form-control form-control-sm bg-black text-white border-secondary" 
                                   placeholder="🔎 Search..." @bind="SearchCol" @bind:event="oninput" />
                        </div>
                        <div class="col-auto" style="flex: 1;">
                            <select class="form-select form-select-sm bg-dark text-white border-secondary w-100" @bind="SearchFilter">
                                <option value="All">All</option>
                                <option value="Table">Tables Only</option>
                                <option value="Column">Columns Only</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm @(ExactMatch ? "btn-primary" : "btn-outline-secondary")" 
                                    @onclick="()=> ExactMatch = !ExactMatch"
                                    title="Exact match">
                                🎯
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm @(MatchWholeWord ? "btn-primary" : "btn-outline-secondary")" 
                                    @onclick="()=> MatchWholeWord = !MatchWholeWord"
                                    title="Match whole word">
                                📝
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-sm @(CaseSensitive ? "btn-primary" : "btn-outline-secondary")" 
                                    @onclick="() => CaseSensitive = !CaseSensitive"
                                    title="Case sensitive">
                                🔤
                            </button>
                        </div>
                    </div>
                </div>
                <div style="overflow-y: auto; max-height: 600px; flex: 1;">
                    <div class="card-body p-0">
                        @if (SchemaService.Tables.Count == 0)
                        {
                            <div class="p-3 text-center text-muted">Connect to a database to start.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var table in FilteredTables)
                                {
                                    var matchingColumns = table.Columns.Where(c => SearchMatch(table.Name, c.Name)).ToList();
                                    @if (matchingColumns.Any())
                                    {
                                        <div class="list-group-item bg-transparent text-light border-secondary">
                                            <div class="d-flex align-items-center gap-2">
                                                <input class="form-check-input mt-0"
                                                       type="checkbox"
                                                       id="@GetTableCheckboxId(table)"
                                                       checked="@AreAllColumnsSelected(table)"
                                                       @onchange="(e) => ToggleTableColumns(table, e.Value is true)" />
                                                <label class="small fw-bold text-uppercase cursor-pointer mb-0" style="color: #6ea8fe;" for="@GetTableCheckboxId(table)">
                                                    @table.Name
                                                </label>
                                            </div>
                                            @foreach(var col in matchingColumns)
                                            {
                                                var key = GetColumnKey(table, col.Name);
                                                var isSelected = SelectedColumns.Contains(key);
                                                <div class="form-check mt-1">
                                                    <input class="form-check-input" type="checkbox" id="@key" 
                                                           checked="@isSelected" 
                                                           @onchange="(e) => ToggleColumn(key, table.FullName, e.Value is true)" />
                                                    <label class="form-check-label small text-break cursor-pointer" for="@key">
                                                        @col.Name
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Result Area -->
        <div class="col-md-8">
             <div class="card bg-dark border-secondary shadow-sm h-100">
                 <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                     <span class="fw-bold">Generated SQL</span>
                     <div class="d-flex gap-2">
                         <button class="btn btn-sm @(CopyLabel == "Copied! ✓" ? "btn-success" : "btn-outline-secondary")" @onclick="CopySql" title="Copy to clipboard">
                             @CopyLabel
                         </button>
                         <button class="btn btn-sm btn-outline-warning" @onclick="ClearAll">
                             <span style="font-size: 1rem;">🗑️</span> Clear All
                         </button>
                     </div>
                 </div>
                 <div class="card-body p-0 bg-black">
                     <textarea class="form-control bg-black text-success border-0 font-monospace h-100 p-3" 
                               style="resize: none; min-height: 400px;" readonly>@GeneratedSql</textarea>
                 </div>
                 @if (HasOneToMany)
                 {
                     <div class="card-footer bg-dark border-secondary p-3">
                         <div class="alert alert-warning mb-0 border-0 shadow-sm" style="background-color: rgba(255, 193, 7, 0.1); color: #ffeb3b;">
                             <h6 class="alert-heading fw-bold mb-2">
                                 <span style="font-size: 1.1rem;">⚠️</span> One-to-Many Join Detected
                             </h6>
                             <p class="small mb-2 text-light text-opacity-75">
                                 Rows may multiply because multiple matching child rows exist for a single parent row. <br/>
                                 A <code>SELECT DISTINCT</code> has been applied automatically to suppress exact duplicates.
                             </p>
                             <hr class="border-secondary opacity-25 my-2">
                             <p class="small mb-1 fw-bold text-warning">💡 Suggestions to prevent unintentional row duplication:</p>
                             <ul class="small mb-0 text-light text-opacity-75 ps-4">
                                 <li><strong>Filter Data:</strong> Add a <code>WHERE</code> clause to target specific records.</li>
                                 <li><strong>Aggregate:</strong> Use aggregate functions (<code>MAX()</code>, <code>SUM()</code>, <code>COUNT()</code>) and <code>GROUP BY</code>.</li>
                                 <li><strong>Top Match:</strong> Rewrite the join to fetch only the first match (e.g., using <code>OUTER APPLY (SELECT TOP 1 ...)</code>).</li>
                             </ul>
                         </div>
                     </div>
                 }
             </div>
        </div>
    </div>
</div>

@code {
    private string SearchCol = "";
    private string SearchFilter = "All";
    private bool ExactMatch = false;
    private bool MatchWholeWord = false;
    private bool CaseSensitive = false;
    
    // List (not HashSet) preserves insertion order — first selected table becomes the JOIN root
    private List<string> SelectedColumns = new();
    private string GeneratedSql = "-- Select columns on the left to generate a query.";
    private bool HasOneToMany = false;

    private IEnumerable<TableInfo> FilteredTables => SchemaService.Tables; // We filter columns inside

    protected override void OnInitialized()
    {
        SchemaService.OnSchemaLoaded += Refresh;
    }

    private void Refresh()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool SearchMatch(string tableName, string colName)
    {
        if (string.IsNullOrWhiteSpace(SearchCol)) return true;

        var searchTerm = CaseSensitive ? SearchCol : SearchCol.ToLower();
        var tableToSearch = CaseSensitive ? tableName : tableName.ToLower();
        var colToSearch = CaseSensitive ? colName : colName.ToLower();

        bool tableMatches = false;
        bool colMatches = false;

        if (ExactMatch)
        {
            // Exact match: entire name must match search term
            tableMatches = tableToSearch == searchTerm;
            colMatches = colToSearch == searchTerm;
        }
        else if (MatchWholeWord)
        {
            tableMatches = tableToSearch.Split(' ', '.', '_').Contains(searchTerm);
            colMatches = colToSearch.Split(' ', '.', '_').Contains(searchTerm);
        }
        else
        {
            tableMatches = tableToSearch.Contains(searchTerm);
            colMatches = colToSearch.Contains(searchTerm);
        }

        return SearchFilter switch
        {
            "Table" => tableMatches,
            "Column" => colMatches,
            _ => tableMatches || colMatches
        };
    }

    private void ToggleColumn(string key, string tableName, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedColumns.Contains(key))
                SelectedColumns.Add(key);
        }
        else
        {
            SelectedColumns.Remove(key);
        }

        Generate();
    }

    private void ToggleTableColumns(TableInfo table, bool shouldSelect)
    {
        var keys = table.Columns
            .Select(col => GetColumnKey(table, col.Name))
            .ToList();

        if (shouldSelect)
        {
            foreach (var key in keys)
            {
                if (!SelectedColumns.Contains(key))
                    SelectedColumns.Add(key);
            }
        }
        else
        {
            var keySet = keys.ToHashSet();
            SelectedColumns.RemoveAll(keySet.Contains);
        }

        Generate();
    }

    private bool AreAllColumnsSelected(TableInfo table)
    {
        return table.Columns.Count > 0 &&
               table.Columns.All(col => SelectedColumns.Contains(GetColumnKey(table, col.Name)));
    }

    private string GetColumnKey(TableInfo table, string columnName)
    {
        return $"{table.FullName}.{columnName}";
    }

    private string GetTableCheckboxId(TableInfo table)
    {
        return $"table-{table.Schema}-{table.Name}"
            .Replace("[", "")
            .Replace("]", "")
            .Replace(".", "-")
            .Replace(" ", "-");
    }

    private void Generate()
    {
        if (SelectedColumns.Count == 0)
        {
            GeneratedSql = "-- Select columns on the left to generate a query.";
            HasOneToMany = false;
            return;
        }

        // Extract table names in selection order (preserves root choice)
        // key format: "[schema].[Table].ColumnName"
        var tables = SelectedColumns
            .Select(k => k.Substring(0, k.LastIndexOf('.')))
            .Distinct() // preserve first-occurrence order (List maintains insertion order)
            .ToList();

        var result = PathfinderService.GenerateQuery(tables, SelectedColumns.ToList());
        GeneratedSql = result.Sql;
        HasOneToMany = result.HasOneToMany;
    }

    private void ClearAll()
    {
        SelectedColumns.Clear();
        GeneratedSql = "-- Select columns on the left to generate a query.";
        HasOneToMany = false;
        StateHasChanged();
    }

    private string CopyLabel = "📋 Copy";

    private async Task CopySql()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", GeneratedSql);
        CopyLabel = "Copied! ✓";
        StateHasChanged();
        await Task.Delay(1500);
        CopyLabel = "📋 Copy";
        StateHasChanged();
    }

    public void Dispose()
    {
        SchemaService.OnSchemaLoaded -= Refresh;
    }
}
