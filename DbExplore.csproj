<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>DbExplore</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <!-- Properties for Unpackaged Exe -->
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <PublishReadyToRun>false</PublishReadyToRun>
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.7" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.7" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.7" />
        <PackageReference Include="Dapper" Version="2.1.28" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <MauiAsset Include="wwwroot\**" />
    </ItemGroup>

    <Target Name="ZipPublishOutput" AfterTargets="Publish">
        <PropertyGroup>
            <ZipDest>$(MSBuildProjectDirectory)\App\DbExplore-portable.zip</ZipDest>
        </PropertyGroup>
        <Message Text="📦 Zipping publish output to $(ZipDest)..." Importance="high" />
        <Exec Command="powershell -Command &quot;if (!(Test-Path '$(MSBuildProjectDirectory)\App')) { New-Item -ItemType Directory -Force -Path '$(MSBuildProjectDirectory)\App' | Out-Null }; if (Test-Path '$(ZipDest)') { Remove-Item '$(ZipDest)' }; Compress-Archive -Path (Get-ChildItem -Path '$(PublishDir.TrimEnd('\'))').FullName -DestinationPath '$(ZipDest)' -Force&quot;" />
        <Message Text="✅ Zip created: $(ZipDest)" Importance="high" />
    </Target>

</Project>
